# =============================================================================
# Variables d'environnement - Biscuits IA
# Copie ce fichier en .env (jamais commite) et remplis chaque variable.
# Recupere les valeurs Supabase sur https://supabase.com/dashboard
#   Project Settings -> API
# =============================================================================

# --- Supabase ---
# URL du projet Supabase (ex: https://xxxxx.supabase.co)
SUPABASE_URL=

# Cle publique anon (safe a exposer cote client, mais ne JAMAIS publier
# publiquement sans rate-limiting). Utilisee par le client navigateur et
# le middleware Astro.
SUPABASE_ANON_KEY=

# Nouvelle cle "publishable" Supabase 2024+ (remplace progressivement l'anon key).
# Prefixee PUBLIC_ pour etre exposee au bundle client. Laissez vide tant que
# la migration n'est pas faite.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cle SERVICE_ROLE (DANGEREUSE - bypass RLS). JAMAIS exposee au client.
# Utilisee uniquement cote serveur par createSupabaseAdminClient()
# (auth.ts, adherentsApi.ts, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# URL canonique du site (utilisee par le SEO, sitemap, og:url, schema.org).
SITE_URL=https://biscuits-ia.com

# URL absolue du site, exposee au client. IndexNow, sitemap, og:url.
PUBLIC_SITE_URL=https://biscuits-ia.com

# --- Google Tag Manager ---
# L'ID GTM (GTM-W2273TRX) est actuellement hardcode dans BaseHead.astro.
# Cette variable est prevue pour externaliser la config ; a activer
# progressivement (voir AUDIT.md section 3 - quick win #10).
GTM_ID=GTM-W2273TRX

# Kill-switch analytics : true desactive GTM + Vercel Web Analytics cote client.
PUBLIC_ANALYTICS_DISABLED=false

# --- Cron jobs (Vercel) ---
# Secret partage entre Vercel Cron et l'endpoint /api/appointments/cron/expire.
# Genere une valeur aleatoire : openssl rand -hex 32
CRON_SECRET=

# --- Email transactionnel (SMTP OVH ou autre) ---
# Client SMTP implemente from-scratch dans src/lib/mail.ts (zero dep).
# Supporte SMTP en clair, STARTTLS (587) et TLS direct (465).
# OVH mutualise : host ssl0.ovh.net, port 465 (SSL) ou 587 (STARTTLS).
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@biscuits-ia.com
SMTP_PASSWORD=
SMTP_FROM=noreply@biscuits-ia.com
SMTP_REPLY_TO=contact@biscuits-ia.com

# Liste d'adresses admin (separes par virgule) qui recoivent les notifications
# (nouvelle inscription, nouvelle demande d'exoneration, nouveau parrainage).
ADMIN_NOTIFICATION_EMAILS=contact@biscuits-ia.com

# --- Rate-limit distribue (Upstash Redis) ---
# Compte gratuit sur https://upstash.com (10 000 requetes/jour).
# Cree une base Redis REST, copie l'URL et le token ci-dessous.
# Si vide, le rate-limit retombe sur le cache L1 in-memory (degrade mais
# fonctionne) -- voir src/lib/rateLimit.ts pour le fallback gracieux.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- HelloAsso (paiements en ligne) ---
# API v5 (OAuth2 Client Credentials). Compte requis :
#   https://admin.helloasso.com > Mon compte > Integrations > API
# Configurer l'URL de webhook :
#   https://biscuits-ia.com/api/formations/helloasso/webhook
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORGANIZATION_SLUG=biscuits-ia
# true => sandbox (https://api.helloasso.com/v5 avec le client_id sandbox)
# false => production
HELLOASSO_SANDBOX=true

# --- IndexNow (Bing / Yandex / Seznam / Naver) ---
# Generer une cle hex 32 chars sur https://www.bing.com/indexnow
INDEXNOW_KEY=