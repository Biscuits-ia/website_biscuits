# =============================================================================
# Variables d'environnement — Biscuits IA
# Copie ce fichier en `.env` (jamais commité) et remplis chaque variable.
# Récupère les valeurs Supabase sur https://supabase.com/dashboard
# → Project Settings → API
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# URL du projet Supabase (ex: https://xxxxx.supabase.co)
SUPABASE_URL=

# Clé publique anon (safe à exposer côté client, mais ne JAMAIS publier
# publiquement sans rate-limiting). Utilisée par le client navigateur et
# le middleware Astro.
SUPABASE_ANON_KEY=

# Clé SERVICE_ROLE (DANGEREUSE — bypass RLS). JAMAIS exposée au client.
# Utilisée uniquement côté serveur par `createSupabaseAdminClient()`
# (auth.ts, adherentsApi.ts, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
# URL canonique du site (utilisée par le SEO, sitemap, og:url, schema.org).
SITE_URL=https://biscuits-ia.com

# ── Email transactionnel (SMTP OVH) ──────────────────────────────────────────
# Connexion SMTP authentifiée vers le serveur mail OVH. Utilisée pour envoyer
# les emails transactionnels (notifications, confirmations, Magic Link…).
#
# Quand `nodemailer` sera ajouté à `src/lib/mail.ts`, ces variables seront
# lues depuis `process.env` et passées à `nodemailer.createTransport()`.
#
# OVH mutualisé : host `ssl0.ovh.net`, port 465 (SSL) ou 587 (STARTTLS).
# Crée un compte mail dédié (ex: noreply@biscuits-ia.com) dans le manager
# OVH → Emails → Créer ; le mot de passe de ce compte est SMTP_PASSWORD.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@biscuits-ia.com
SMTP_PASSWORD=
# Adresse qui apparaît comme expéditeur (FROM) ; par défaut = SMTP_USER.
SMTP_FROM=noreply@biscuits-ia.com
# Adresse de reply-to (optionnel — laissée vide si pas utilisée).
SMTP_REPLY_TO=

# ── Google Tag Manager ──────────────────────────────────────────────────────
# L'ID GTM (`GTM-W2273TRX`) est actuellement hardcodé dans BaseHead.astro.
# Cette variable est prévue pour externaliser la config ; à activer
# progressivement (voir AUDIT.md §3 — quick win #10).
# GTM_ID=GTM-W2273TRX

# ── Cron jobs (Vercel) ──────────────────────────────────────────────────────
# Secret partagé entre Vercel Cron et l'endpoint /api/appointments/cron/expire.
# Génère une valeur aléatoire : `openssl rand -hex 32`.
CRON_SECRET=
