{
  "name": "biscuits-ia",
  "type": "module",
  "version": "2.0.0",
  "description": "Expert en Intelligence Artificielle pour entreprises",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:prod": "npm run optimize:images && astro build && npm run optimize:html",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --ext .js,.astro,.ts",
    "lint:fix": "eslint . --ext .js,.astro,.ts --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,astro,md,json}\"",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:html": "node scripts/optimize-html.js",
    "lighthouse": "lighthouse https://biscuits-ia.com --view --output=html --output-path=./lighthouse-report.html",
    "lighthouse:ci": "lhci autorun",
    "analyze": "astro build --analyze",
    "test:a11y": "pa11y-ci",
    "test:performance": "npm run lighthouse"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/svelte": "^7.2.5",
    "@astrojs/tailwind": "^6.0.2",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^5.17.1",
    "astro-compress": "^2.3.9",
    "astro-icon": "^1.1.5",
    "astro-robots-txt": "^1.0.0",
    "svelte": "^5.49.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "autoprefixer": "^10.4.24",
    "cssnano": "^7.1.2",
    "cssnano-preset-advanced": "^7.0.10",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "imagemin": "^9.0.1",
    "imagemin-webp": "^8.0.0",
    "lighthouse": "^13.0.1",
    "lighthouse-ci": "^1.13.1",
    "pa11y-ci": "^4.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "terser": "^5.46.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead",
    "not IE 11"
  ]
}