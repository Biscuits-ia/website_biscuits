# Headers optimisés pour Lighthouse 100 - Best Practices
# Compatible Netlify et Vercel (renommer en vercel.json si besoin)

# Headers pour toutes les pages HTML
/*
  # Security Headers (Best Practices)
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  
  # Content Security Policy (CSP) - Très important pour Best Practices
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  
  # Cross-Origin Headers
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  
  # Cache Control (Performance)
  Cache-Control: public, max-age=0, must-revalidate
  
  # Server Info (Best Practices - cacher la version du serveur)
  Server: Biscuits-IA
  
  # Feature Policy (ancienne version de Permissions-Policy, pour compatibilité)
  Feature-Policy: geolocation 'none'; microphone 'none'; camera 'none'

# Headers pour les fichiers statiques (CSS, JS)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Vary: Accept-Encoding

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Vary: Accept-Encoding

# Headers pour les images (Performance)
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Vary: Accept-Encoding

*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg
  Access-Control-Allow-Origin: *

*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg
  Access-Control-Allow-Origin: *

*.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png
  Access-Control-Allow-Origin: *

*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp
  Access-Control-Allow-Origin: *

*.avif
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/avif
  Access-Control-Allow-Origin: *

*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml
  Access-Control-Allow-Origin: *

# Headers pour les polices (Performance)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Vary: Accept-Encoding

*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2
  Access-Control-Allow-Origin: *

*.woff
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff
  Access-Control-Allow-Origin: *

*.ttf
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/ttf
  Access-Control-Allow-Origin: *

# Headers pour le manifest et service worker (PWA)
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
  Access-Control-Allow-Origin: *

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript
  Service-Worker-Allowed: /

# Headers pour le sitemap (SEO)
/sitemap*.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain

# Headers pour les API (si vous en avez)
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization

# Headers spécifiques pour la page d'accueil (Performance critique)
/
  Link: </fonts/inter-var.woff2>; rel=preload; as=font; type=font/woff2; crossorigin
  Link: </assets/logo.webp>; rel=preload; as=image; type=image/webp; fetchpriority=high
  Link: <https://www.googletagmanager.com>; rel=preconnect; crossorigin
  Cache-Control: public, max-age=0, must-revalidate

# Headers pour la page 404
/404.html
  Cache-Control: public, max-age=3600

# Compression (Performance)
*.css
  Content-Encoding: gzip
  Vary: Accept-Encoding

*.js
  Content-Encoding: gzip
  Vary: Accept-Encoding

*.html
  Content-Encoding: gzip
  Vary: Accept-Encoding
