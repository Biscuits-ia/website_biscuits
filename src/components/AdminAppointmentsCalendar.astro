---
// src/components/AdminAppointmentsCalendar.astro
//
// Vue calendrier mensuel admin des rendez-vous et créneaux.
// REMPLACE l'ancien composant React client:load qui ne s'hydratait jamais en
// production (Astro émet le bootstrap des islands en balise script inline sans
// nonce, bloqué par le CSP du middleware).
//
// Ce composant est rendu intégralement côté serveur. Les données sont passées
// par la page parente. Une petite couche de JS vanilla (nonce={nonce}) gère
// l'ajout et la suppression de créneaux sans recharger toute la page.

import type { AppointmentSlot, AppointmentStatus } from '@/types/appointments';

interface CalendarAppointment {
  id: string;
  status: AppointmentStatus;
  start_time: string;
  end_time: string;
  notes: string | null;
  candidate_email: string | null;
  user_profile: { full_name: string | null; email: string | null } | null;
}

export interface Props {
  year: number;
  month: number;
  slots: AppointmentSlot[];
  appointments: CalendarAppointment[];
  selectedDay: string | null;
  nonce?: string;
}

const { year, month, slots, appointments, selectedDay, nonce } = Astro.props;

const WEEKDAY_LABELS = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
const MONTH_LABELS = [
  'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin',
  'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre',
];

const STATUS_LABELS: Record<AppointmentStatus, string> = {
  pending:   'En attente',
  confirmed: 'Confirmé',
  cancelled: 'Annulé',
};

const STATUS_COLORS: Record<AppointmentStatus, string> = {
  pending:   '#E89A3C',
  confirmed: '#3D5A47',
  cancelled: '#9A7E5A',
};

const now = new Date();
const cursor = new Date(Date.UTC(year, month - 1, 1));
const cells: Date[] = [];
const first = new Date(Date.UTC(year, month - 1, 1));
const firstWeekday = (first.getUTCDay() + 6) % 7;
for (let i = 0; i < 42; i++) {
  const day = new Date(first);
  day.setUTCDate(first.getUTCDate() - firstWeekday + i);
  cells.push(day);
}

function toDateKey(d: Date): string {
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
}
function isSameDayUTC(a: Date, b: Date): boolean {
  return a.getUTCFullYear() === b.getUTCFullYear()
    && a.getUTCMonth() === b.getUTCMonth()
    && a.getUTCDate() === b.getUTCDate();
}
function pageUrl(params: Record<string, string | number>): string {
  const base = new URLSearchParams({ y: String(year), m: String(month) });
  for (const [k, v] of Object.entries(params)) base.set(k, String(v));
  return `/dashboard/admin/appointments?${base.toString()}`;
}

const today = new Date();
const monthLabel = `${MONTH_LABELS[cursor.getUTCMonth()]} ${cursor.getUTCFullYear()}`;

const prevDate = new Date(Date.UTC(year, month - 2, 1));
const nextDate = new Date(Date.UTC(year, month, 1));
const prevUrl = pageUrl({ y: prevDate.getUTCFullYear(), m: prevDate.getUTCMonth() + 1 });
const nextUrl = pageUrl({ y: nextDate.getUTCFullYear(), m: nextDate.getUTCMonth() + 1 });
const todayUrl = pageUrl({ y: now.getUTCFullYear(), m: now.getUTCMonth() + 1 });

const apptsByDay = new Map<string, CalendarAppointment[]>();
const slotsByDay = new Map<string, AppointmentSlot[]>();
for (const a of appointments) {
  const key = toDateKey(new Date(a.start_time));
  const list = apptsByDay.get(key);
  if (list) list.push(a);
  else apptsByDay.set(key, [a]);
}
for (const s of slots) {
  const key = toDateKey(new Date(s.start_time));
  const list = slotsByDay.get(key);
  if (list) list.push(s);
  else slotsByDay.set(key, [s]);
}
for (const list of apptsByDay.values()) {
  list.sort((x, y) => Date.parse(x.start_time) - Date.parse(y.start_time));
}
for (const list of slotsByDay.values()) {
  list.sort((x, y) => Date.parse(x.start_time) - Date.parse(y.start_time));
}

const selectedDate = selectedDay ? new Date(`${selectedDay}T00:00:00Z`) : null;

interface DayCell {
  date: Date;
  key: string;
  inMonth: boolean;
  isToday: boolean;
  isSelected: boolean;
  dayAppts: CalendarAppointment[];
  daySlots: AppointmentSlot[];
  counts: { pending: number; confirmed: number; cancelled: number };
}

const dayCells: DayCell[] = cells.map((d) => {
  const key = toDateKey(d);
  const inMonth = d.getUTCMonth() === cursor.getUTCMonth();
  const isToday = isSameDayUTC(d, today);
  const isSelected = selectedDate ? isSameDayUTC(d, selectedDate) : false;
  const dayAppts = apptsByDay.get(key) ?? [];
  const daySlots = slotsByDay.get(key) ?? [];
  const counts = { pending: 0, confirmed: 0, cancelled: 0 };
  for (const a of dayAppts) counts[a.status]++;
  return { date: d, key, inMonth, isToday, isSelected, dayAppts, daySlots, counts };
});

const ORDERED_STATUSES: AppointmentStatus[] = ['confirmed', 'pending', 'cancelled'];
const STATUS_KEYS: AppointmentStatus[] = Object.keys(STATUS_COLORS) as AppointmentStatus[];
---

<div class="appts-cal">
  <script type="application/json" is:inline data-cal-data set:html={JSON.stringify({ year, month, slots, appointments, selectedDay })}></script>
  <div class="appts-cal-toolbar">
    <div class="appts-cal-nav">
      <a href={prevUrl} class="btn btn-ghost btn-sm" aria-label="Mois précédent">‹</a>
      <h2 class="appts-cal-title">{monthLabel}</h2>
      <a href={nextUrl} class="btn btn-ghost btn-sm" aria-label="Mois suivant">›</a>
    </div>
    <div class="appts-cal-actions">
      <a href={todayUrl} class="btn btn-ghost btn-sm">Aujourd'hui</a>
      <a href={Astro.url.pathname + Astro.url.search} class="btn btn-ghost btn-sm">↻ Rafraîchir</a>
    </div>
  </div>

  {appointments.length === 0 && slots.length === 0 && !selectedDate && (
    <div class="appts-cal-welcome" role="status">
      <div class="appts-cal-welcome-icon" aria-hidden="true">📅</div>
      <div class="appts-cal-welcome-body">
        <strong>Le calendrier est vide.</strong>
        <p>Cliquez sur n'importe quel jour pour ajouter un créneau de rendez-vous disponible.</p>
      </div>
    </div>
  )}

  <div class="appts-cal-grid" role="grid" aria-label={`Calendrier ${monthLabel}`}>
    {WEEKDAY_LABELS.map((w) => (
      <div class="appts-cal-weekday" role="columnheader">{w}</div>
    ))}
    {dayCells.map((day) => (
      <button
        type="button"
        data-day={day.key}
        role="gridcell"
        aria-selected={day.isSelected}
        class:list={[
          'appts-cal-cell',
          { 'appts-cal-cell--out': !day.inMonth },
          { 'appts-cal-cell--today': day.isToday },
          { 'appts-cal-cell--selected': day.isSelected },
        ]}
      >
        <span class="appts-cal-day-num">{day.date.getUTCDate()}</span>
        {day.dayAppts.length > 0 && (
          <span class="appts-cal-dots" aria-label={`${day.dayAppts.length} rendez-vous`}>
            {ORDERED_STATUSES.map((s) =>
              day.counts[s] > 0 ? (
                <span
                  class="appts-cal-dot"
                  style={{ backgroundColor: STATUS_COLORS[s] }}
                  title={`${day.counts[s]} ${STATUS_LABELS[s]}`}
                />
              ) : null
            )}
          </span>
        )}
        {day.daySlots.length > 0 && (
          <span class="appts-cal-slots-count" title={`${day.daySlots.length} créneau(x) configuré(s)`}>
            🕒 {day.daySlots.length}
          </span>
        )}
      </button>
    ))}
  </div>

  <div class="appts-cal-detail-host"></div>

  <div class="appts-cal-legend" aria-label="Légende des statuts">
    {STATUS_KEYS.map((s) => (
      <span class="appts-cal-legend-item">
        <span class="appts-cal-dot" style={{ backgroundColor: STATUS_COLORS[s] }} />
        {STATUS_LABELS[s]}
      </span>
    ))}
  </div>
</div>

<script is:inline nonce={nonce}>
  (function () {
    const root = document.querySelector('.appts-cal');
    const dataEl = document.querySelector('script[data-cal-data]');
    if (!root || !dataEl) return;

    const data = JSON.parse(dataEl.textContent);
    const year = data.year;
    const month = data.month;
    let slots = data.slots || [];
    let appointments = data.appointments || [];
    let selectedKey = data.selectedDay || null;

    const STATUS_LABELS = { pending: 'En attente', confirmed: 'Confirmé', cancelled: 'Annulé' };
    const STATUS_COLORS = { pending: '#E89A3C', confirmed: '#3D5A47', cancelled: '#9A7E5A' };
    const ORDERED_STATUSES = ['confirmed', 'pending', 'cancelled'];

    function pad(n) { return n.toString().padStart(2, '0'); }
    function toDateKey(d) {
      return d.getUTCFullYear() + '-' + pad(d.getUTCMonth() + 1) + '-' + pad(d.getUTCDate());
    }
    function formatTimeUTC(iso) {
      const d = new Date(iso);
      return pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes());
    }

    function buildIndex() {
      const apptsByDay = {};
      const slotsByDay = {};
      for (let i = 0; i < appointments.length; i++) {
        const a = appointments[i];
        const key = toDateKey(new Date(a.start_time));
        if (!apptsByDay[key]) apptsByDay[key] = [];
        apptsByDay[key].push(a);
      }
      for (let i = 0; i < slots.length; i++) {
        const s = slots[i];
        const key = toDateKey(new Date(s.start_time));
        if (!slotsByDay[key]) slotsByDay[key] = [];
        slotsByDay[key].push(s);
      }
      for (const key in apptsByDay) {
        apptsByDay[key].sort(function (x, y) { return Date.parse(x.start_time) - Date.parse(y.start_time); });
      }
      for (const key in slotsByDay) {
        slotsByDay[key].sort(function (x, y) { return Date.parse(x.start_time) - Date.parse(y.start_time); });
      }
      return { apptsByDay: apptsByDay, slotsByDay: slotsByDay };
    }

    let index = buildIndex();

    function renderCalendarDots() {
      index = buildIndex();
      root.querySelectorAll('button[data-day]').forEach(function (btn) {
        const key = btn.getAttribute('data-day');
        const dayAppts = index.apptsByDay[key] || [];
        const daySlots = index.slotsByDay[key] || [];
        const counts = { pending: 0, confirmed: 0, cancelled: 0 };
        for (let i = 0; i < dayAppts.length; i++) counts[dayAppts[i].status]++;

        let dotsEl = btn.querySelector('.appts-cal-dots');
        if (dayAppts.length > 0) {
          if (!dotsEl) {
            dotsEl = document.createElement('span');
            dotsEl.className = 'appts-cal-dots';
            btn.appendChild(dotsEl);
          }
          dotsEl.innerHTML = '';
          for (let i = 0; i < ORDERED_STATUSES.length; i++) {
            const s = ORDERED_STATUSES[i];
            if (counts[s] > 0) {
              const span = document.createElement('span');
              span.className = 'appts-cal-dot';
              span.style.backgroundColor = STATUS_COLORS[s];
              span.title = counts[s] + ' ' + STATUS_LABELS[s];
              dotsEl.appendChild(span);
            }
          }
          dotsEl.setAttribute('aria-label', dayAppts.length + ' rendez-vous');
        } else if (dotsEl) {
          dotsEl.remove();
        }

        let slotsCountEl = btn.querySelector('.appts-cal-slots-count');
        if (daySlots.length > 0) {
          if (!slotsCountEl) {
            slotsCountEl = document.createElement('span');
            slotsCountEl.className = 'appts-cal-slots-count';
            btn.appendChild(slotsCountEl);
          }
          slotsCountEl.textContent = '🕒 ' + daySlots.length;
          slotsCountEl.title = daySlots.length + ' créneau(x) configuré(s)';
        } else if (slotsCountEl) {
          slotsCountEl.remove();
        }
      });
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function renderDetail() {
      const host = root.querySelector('.appts-cal-detail-host');
      if (!host) return;
      if (!selectedKey) {
        host.innerHTML = '';
        return;
      }

      const date = new Date(selectedKey + 'T00:00:00Z');
      const dateLabel = date.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
      const daySlots = index.slotsByDay[selectedKey] || [];
      const dayAppts = index.apptsByDay[selectedKey] || [];

      let html = '<div class="appts-cal-detail">' +
        '<div class="appts-cal-detail-header">' +
          '<h3>' + dateLabel + '</h3>' +
          '<button type="button" class="btn btn-ghost btn-sm" data-close-day>Fermer</button>' +
        '</div>' +
        '<section class="appts-cal-section">' +
          '<header class="appts-cal-section-header">' +
            '<h4>🕒 Créneaux configurés <span class="appts-cal-section-count">' + daySlots.length + '</span></h4>' +
          '</header>';

      if (daySlots.length === 0) {
        html += '<p class="appts-cal-empty">Aucun créneau configuré pour ce jour.</p>';
      } else {
        html += '<ul class="appts-cal-slots-list">';
        for (let i = 0; i < daySlots.length; i++) {
          const s = daySlots[i];
          let taken = false;
          for (let j = 0; j < dayAppts.length; j++) {
            if (dayAppts[j].start_time === s.start_time) { taken = true; break; }
          }
          let classes = 'appts-cal-slot-item';
          if (taken) classes += ' appts-cal-slot-item--taken';
          if (!s.is_available) classes += ' appts-cal-slot-item--disabled';
          html += '<li class="' + classes + '">' +
            '<span class="appts-cal-slot-time">' + escapeHtml(formatTimeUTC(s.start_time)) + ' – ' + escapeHtml(formatTimeUTC(s.end_time)) + '</span>' +
            '<span class="appts-cal-slot-flags">' +
              (taken ? '<span class="appts-cal-flag appts-cal-flag--taken">Réservé</span>' : '') +
              (!s.is_available ? '<span class="appts-cal-flag appts-cal-flag--off">Désactivé</span>' : '') +
              (!taken && s.is_available ? '<span class="appts-cal-flag appts-cal-flag--free">Libre</span>' : '') +
            '</span>' +
            '<button type="button" class="appts-cal-slot-delete" data-delete-slot="' + escapeHtml(s.id) + '" data-time="' + escapeHtml(formatTimeUTC(s.start_time)) + '" aria-label="Supprimer le créneau ' + escapeHtml(formatTimeUTC(s.start_time)) + '" title="Supprimer">🗑</button>' +
          '</li>';
        }
        html += '</ul>';
      }

      html += '<div class="appts-cal-add-actions">' +
        '<button type="button" class="btn btn-primary btn-sm" data-open-slot-modal>+ Ajouter un créneau</button>' +
      '</div>' +
      '<p class="appts-cal-add-hint">L\'anti-chevauchement est vérifié côté serveur (chevauche un créneau existant → erreur 409).</p>' +
      '</section>';

      html += '<section class="appts-cal-section">' +
        '<header class="appts-cal-section-header">' +
          '<h4>📅 Rendez-vous <span class="appts-cal-section-count">' + dayAppts.length + '</span></h4>' +
        '</header>';

      if (dayAppts.length === 0) {
        html += '<p class="appts-cal-empty">Aucun rendez-vous ce jour-là.</p>';
      } else {
        html += '<ul class="appts-cal-list">';
        for (let i = 0; i < dayAppts.length; i++) {
          const a = dayAppts[i];
          const who = a.user_profile && a.user_profile.full_name ? a.user_profile.full_name : (a.candidate_email ? a.candidate_email : 'Anonyme');
          const email = a.user_profile && a.user_profile.email ? a.user_profile.email : null;
          html += '<li class="appts-cal-list-item">' +
            '<span class="appts-cal-status" style="background-color:' + STATUS_COLORS[a.status] + '" aria-label="' + STATUS_LABELS[a.status] + '"></span>' +
            '<div class="appts-cal-list-body">' +
              '<div class="appts-cal-list-time">' + escapeHtml(formatTimeUTC(a.start_time)) + ' – ' + escapeHtml(formatTimeUTC(a.end_time)) + '</div>' +
              '<div class="appts-cal-list-who">' + escapeHtml(who) + (email ? ' <span class="appts-cal-list-email"> · ' + escapeHtml(email) + '</span>' : '') + '</div>' +
              (a.notes ? '<div class="appts-cal-list-notes">📝 ' + escapeHtml(a.notes) + '</div>' : '') +
            '</div>' +
            '<span class="appts-cal-list-status-label">' + STATUS_LABELS[a.status] + '</span>' +
          '</li>';
        }
        html += '</ul>';
      }

      html += '</section></div>';
      host.innerHTML = html;

      const closeBtn = host.querySelector('button[data-close-day]');
      if (closeBtn) closeBtn.addEventListener('click', function () { selectDay(null); });

      const openModalBtn = host.querySelector('button[data-open-slot-modal]');
      if (openModalBtn) openModalBtn.addEventListener('click', function () { openSlotModal(selectedKey); });

      host.querySelectorAll('button[data-delete-slot]').forEach(function (btn) {
        btn.addEventListener('click', onDeleteSlot);
      });
    }

    function selectDay(key) {
      selectedKey = key;
      root.querySelectorAll('button[data-day]').forEach(function (btn) {
        const isSelected = btn.getAttribute('data-day') === selectedKey;
        btn.classList.toggle('appts-cal-cell--selected', isSelected);
        btn.setAttribute('aria-selected', String(isSelected));
      });
      renderDetail();
    }

    function toast(msg, type) {
      if (typeof window.showToast === 'function') window.showToast(msg, type);
    }
    function showAddError(form, msg) {
      const el = form.querySelector('.appts-cal-add-error');
      if (!el) return;
      el.textContent = msg ? '❌ ' + msg : '';
      el.hidden = !msg;
    }

    function isoFromDateAndTime(dateKey, time) {
      return new Date(dateKey + 'T' + time + ':00.000Z').toISOString();
    }

    function formatDateLabel(dateKey) {
      const d = new Date(dateKey + 'T00:00:00Z');
      return d.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    }

    function closeSlotModal() {
      const modal = document.querySelector('.appts-cal-modal');
      if (!modal) return;
      modal.remove();
      document.removeEventListener('keydown', onModalKey);
    }

    function onModalKey(e) {
      if (e.key === 'Escape') closeSlotModal();
    }

    function openSlotModal(dayKey) {
      closeSlotModal();
      const dateLabel = formatDateLabel(dayKey);
      const modal = document.createElement('div');
      modal.className = 'appts-cal-modal';
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
      modal.setAttribute('aria-labelledby', 'appts-cal-modal-title');
      modal.innerHTML =
        '<div class="appts-cal-modal-backdrop" data-close-modal></div>' +
        '<div class="appts-cal-modal-window" role="document">' +
          '<div class="appts-cal-modal-header">' +
            '<h3 id="appts-cal-modal-title">Ajouter un créneau</h3>' +
            '<button type="button" class="appts-cal-modal-close" data-close-modal aria-label="Fermer">×</button>' +
          '</div>' +
          '<form class="appts-cal-modal-form" data-add-slot-form>' +
            '<div class="appts-cal-modal-field">' +
              '<label for="appts-cal-modal-day">Jour</label>' +
              '<input id="appts-cal-modal-day" type="text" value="' + escapeHtml(dateLabel) + '" readonly />' +
            '</div>' +
            '<div class="appts-cal-modal-row">' +
              '<div class="appts-cal-modal-field">' +
                '<label for="appts-cal-modal-start">Heure de début</label>' +
                '<input id="appts-cal-modal-start" type="time" name="start" value="09:00" required />' +
              '</div>' +
              '<div class="appts-cal-modal-field">' +
                '<label for="appts-cal-modal-end">Heure de fin</label>' +
                '<input id="appts-cal-modal-end" type="time" name="end" value="10:00" required />' +
              '</div>' +
            '</div>' +
            '<p class="appts-cal-add-error" role="alert" hidden></p>' +
            '<div class="appts-cal-modal-actions">' +
              '<button type="button" class="btn btn-ghost btn-sm" data-close-modal>Annuler</button>' +
              '<button type="submit" class="btn btn-primary btn-sm">+ Ajouter</button>' +
            '</div>' +
          '</form>' +
        '</div>';
      document.body.appendChild(modal);

      const startInput = modal.querySelector('input[name="start"]');
      if (startInput) startInput.focus();

      modal.querySelectorAll('[data-close-modal]').forEach(function (el) {
        el.addEventListener('click', function (e) { if (e.target === el) closeSlotModal(); });
      });
      modal.querySelector('form[data-add-slot-form]').addEventListener('submit', onAddSlot);
      document.addEventListener('keydown', onModalKey);
    }

    function onAddSlot(e) {
      e.preventDefault();
      const form = e.target;
      const fd = new FormData(form);
      const start = fd.get('start');
      const end = fd.get('end');
      const btn = form.querySelector('button[type="submit"]');
      if (!start || !end) return;
      if (start >= end) {
        showAddError(form, "L'heure de fin doit être après l'heure de début.");
        return;
      }
      if (btn) btn.disabled = true;
      showAddError(form, '');
      fetch('/api/appointment-slots', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          start_time: isoFromDateAndTime(selectedKey, start),
          end_time: isoFromDateAndTime(selectedKey, end),
        }),
      })
        .then(function (res) { if (!res.ok) return res.json().then(function (data) { throw new Error(data.error || 'Erreur ' + res.status); }); return res.json(); })
        .then(function () { closeSlotModal(); toast('Créneau ajouté', 'success'); return reloadData(); })
        .catch(function (err) { const msg = err instanceof Error ? err.message : 'Erreur'; showAddError(form, msg); toast(msg, 'error'); })
        .finally(function () { if (btn) btn.disabled = false; });
    }

    function reloadData() {
      const start = new Date(Date.UTC(year, month - 1, 1)).toISOString();
      const end = new Date(Date.UTC(year, month, 1)).toISOString();
      return Promise.all([
        fetch('/api/appointment-slots', { credentials: 'include' }).then(function (r) { if (!r.ok) throw new Error('Erreur ' + r.status); return r.json(); }),
        fetch('/api/admin/appointments', { credentials: 'include' }).then(function (r) { if (!r.ok) throw new Error('Erreur ' + r.status); return r.json(); })
      ]).then(function (results) {
        slots = results[0] || [];
        const rawAppts = results[1];
        const apptList = Array.isArray(rawAppts) ? rawAppts : (rawAppts && typeof rawAppts === 'object' && Array.isArray(rawAppts.data) ? rawAppts.data : []);
        appointments = apptList.map(function (a) {
          const slot = a.appointment_slots;
          return {
            id: a.id,
            status: a.status,
            start_time: slot ? slot.start_time : a.start_time,
            end_time: slot ? slot.end_time : a.end_time,
            notes: a.notes,
            candidate_email: a.candidate_email,
            user_profile: a.user_profile || null,
          };
        });
        slots = slots.filter(function (s) { return s.start_time >= start && s.start_time < end; });
        appointments = appointments.filter(function (a) { return a.start_time >= start && a.start_time < end; });
        index = buildIndex();
        renderCalendarDots();
        renderDetail();
      }).catch(function (err) {
        const msg = err instanceof Error ? err.message : 'Erreur';
        toast(msg, 'error');
      });
    }

    function onAddSlot(e) {
      e.preventDefault();
      const form = e.target;
      const fd = new FormData(form);
      const start = fd.get('start');
      const end = fd.get('end');
      const btn = form.querySelector('button[type="submit"]');
      if (!start || !end) return;
      if (start >= end) {
        showAddError(form, "L'heure de fin doit être après l'heure de début.");
        return;
      }
      if (btn) btn.disabled = true;
      showAddError(form, '');
      fetch('/api/appointment-slots', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          start_time: isoFromDateAndTime(selectedKey, start),
          end_time: isoFromDateAndTime(selectedKey, end),
        }),
      })
        .then(function (res) { if (!res.ok) return res.json().then(function (data) { throw new Error(data.error || 'Erreur ' + res.status); }); return res.json(); })
        .then(function () { toast('Créneau ajouté', 'success'); return reloadData(); })
        .catch(function (err) { const msg = err instanceof Error ? err.message : 'Erreur'; showAddError(form, msg); toast(msg, 'error'); })
        .finally(function () { if (btn) btn.disabled = false; });
    }

    function onDeleteSlot(e) {
      const btn = e.currentTarget;
      const id = btn.getAttribute('data-delete-slot');
      const time = btn.getAttribute('data-time') || 'ce créneau';
      if (!id) return;

      let okPromise;
      if (typeof window.showConfirm === 'function') {
        okPromise = window.showConfirm({
          title: 'Supprimer ce créneau',
          message: 'Cette action est définitive. Si un utilisateur a réservé ce créneau, sa réservation sera également supprimée.',
          confirmLabel: 'Supprimer',
          danger: true,
        });
      } else {
        okPromise = Promise.resolve(window.confirm('Supprimer ce créneau ?'));
      }

      okPromise.then(function (ok) {
        if (!ok) return;
        return fetch('/api/appointment-slots/' + id, { method: 'DELETE', credentials: 'include' })
          .then(function (res) { if (!res.ok) return res.json().then(function (data) { throw new Error(data.error || 'Erreur ' + res.status); }); return res.json(); })
          .then(function () { toast('Créneau ' + time + ' supprimé', 'success'); return reloadData(); })
          .catch(function (err) { const msg = err instanceof Error ? err.message : 'Erreur'; toast(msg, 'error'); });
      });
    }

    root.querySelectorAll('button[data-day]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const key = btn.getAttribute('data-day');
        if (key === selectedKey) return;
        selectDay(key);
      });
    });

    renderCalendarDots();
    renderDetail();
  })();
</script>

