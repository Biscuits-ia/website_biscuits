---
// src/components/AdminAppointmentsDashboard.astro
---

<div class="dashboard-container">
  <div class="header">
    <h1>📅 Réservations</h1>
    <p>Vue des réservations effectuées par les utilisateurs</p>
  </div>

  <div id="error-container"></div>

  <div id="content">
    <div class="loading">⏳ Chargement...</div>
  </div>
</div>

<script>
  const errorContainer = document.getElementById('error-container') as HTMLElement;
  const contentDiv = document.getElementById('content') as HTMLElement;

  function showError(msg: string, duration = 5000) {
    errorContainer.innerHTML = `<div class="error-alert">❌ ${msg}</div>`;
    if (duration) setTimeout(() => (errorContainer.innerHTML = ''), duration);
  }

  async function loadAppointments() {
    try {
      const response = await fetch('/api/admin/appointments', {
        credentials: 'include',
      });

      if (!response.ok) {
        const errText = await response.text();
        throw new Error(`Erreur ${response.status}: ${errText}`);
      }

      const data = await response.json();
      renderAppointments(data);
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Erreur inconnue';
      showError(msg, 0);
      contentDiv.innerHTML =
        '<div style="color: #dc2626; padding: 20px; text-align: center;">Erreur de chargement</div>';
    }
  }

  function renderAppointments(appointments: any[]) {
    if (appointments.length === 0) {
      contentDiv.innerHTML =
        '<div class="no-appointments">Aucune réservation pour le moment</div>';
      return;
    }

    const html = `
      <table class="appointments-table">
        <thead>
          <tr>
            <th>Utilisateur</th>
            <th>Email</th>
            <th>Créneau</th>
            <th>Statut</th>
            <th>Réservé le</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          ${appointments
            .map(
              (appt: { appointment_slots: any; status: string; user_profile: { full_name: any; email: any; }; candidate_email: any; created_at: string | number | Date; id: any; }, idx: number) => {
                const slot = appt.appointment_slots;
                const slotStart = slot ? new Date(slot.start_time) : null;
                const slotEnd = slot ? new Date(slot.end_time) : null;
                const slotLabel = slotStart && slotEnd
                  ? `${slotStart.toLocaleDateString('fr-FR')} ${slotStart.getHours().toString().padStart(2, '0')}:${slotStart.getMinutes().toString().padStart(2, '0')} - ${slotEnd.getHours().toString().padStart(2, '0')}:${slotEnd.getMinutes().toString().padStart(2, '0')}`
                  : '<em>Créneau supprimé</em>';
                const isPending = appt.status === 'pending';
                const isConfirmed = appt.status === 'confirmed';
                const userName = appt.user_profile?.full_name || appt.user_profile?.email || appt.candidate_email || '-';
                const userEmail = appt.user_profile?.email || appt.candidate_email || '-';
                return `
            <tr class="${idx % 2 === 0 ? 'even' : 'odd'} status-${appt.status}">
              <td>${userName}</td>
              <td>${userEmail}</td>
              <td class="monospace">${slotLabel}</td>
              <td>
                <span class="badge ${appt.status === 'confirmed' ? 'badge-success' : appt.status === 'cancelled' ? 'badge-danger' : 'badge-pending'}">
                  ${appt.status === 'confirmed' ? '✓ Confirmé' : appt.status === 'cancelled' ? '✗ Annulé' : '⏳ En attente'}
                </span>
              </td>
              <td>${new Date(appt.created_at).toLocaleDateString('fr-FR')}</td>
              <td class="actions">
${isPending ? `
                  <div class="actions-col">
                    <button class="btn-confirm" data-id="${appt.id}">✓ Confirmer</button>
                    <button class="btn-reject" data-id="${appt.id}">✗ Rejeter</button>
                  </div>
                ` : isConfirmed ? `
                  <div class="actions-col">
                    <a href="${buildAdminGoogleCalUrl(appt)}" target="_blank" rel="noopener noreferrer" class="btn-gcal-admin">📅 Agenda</a>
                    <button class="btn-reject" data-id="${appt.id}">✗ Annuler</button>
                  </div>
                ` : `<span class="text-muted">—</span>`}
              </td>
            </tr>
          `;
              }
            )
            .join('')}
        </tbody>
      </table>
    `;

    contentDiv.innerHTML = html;

    // Ajouter les event listeners
    document.querySelectorAll('.btn-confirm').forEach((btn) => {
      btn.addEventListener('click', () => updateAppointmentStatus((btn as HTMLElement).dataset.id, 'confirmed'));
    });

    document.querySelectorAll('.btn-reject').forEach((btn) => {
      btn.addEventListener('click', () => updateAppointmentStatus((btn as HTMLElement).dataset.id, 'cancelled'));
    });
  }

  async function updateAppointmentStatus(id: any, status: string) {
    const action = status === 'confirmed' ? 'confirmer' : 'rejeter';
    if (!confirm(`Êtes-vous sûr de vouloir ${action} cette réservation ?`)) return;

    try {
      const response = await fetch(`/api/admin/appointments/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ status }),
      });

      if (!response.ok) throw new Error(`Erreur ${response.status}`);

      showError('', 0);
      await loadAppointments();
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Erreur inconnue', 0);
    }
  }

  function buildAdminGoogleCalUrl(appt: any): string {
    const slot = appt.appointment_slots;
    if (!slot) return '#';
    const start = new Date(slot.start_time);
    const end = new Date(slot.end_time);
    const pad = (n: number) => n.toString().padStart(2, '0');
    const fmt = (d: Date) =>
      `${d.getUTCFullYear()}${pad(d.getUTCMonth() + 1)}${pad(d.getUTCDate())}T${pad(d.getUTCHours())}${pad(d.getUTCMinutes())}00Z`;
    const name = appt.user_profile?.full_name || appt.user_profile?.email || appt.candidate_email || 'Bénévole';
    const params = new URLSearchParams({
      action: 'TEMPLATE',
      text: `RDV Biscuits IA — ${name}`,
      dates: `${fmt(start)}/${fmt(end)}`,
      details: `Rendez-vous avec ${name}.`,
    });
    return `https://calendar.google.com/calendar/render?${params.toString()}`;
  }

  // Charger les rendez-vous au démarrage
  loadAppointments();
</script>

<style>
  .dashboard-container {
    padding: 30px;
    background-color: #f9fafb;
    border-radius: 10px;
  }

  .header {
    margin-bottom: 30px;
  }

  .header h1 {
    font-size: 28px;
    font-weight: bold;
    margin: 0 0 8px 0;
  }

  .header p {
    color: #6b7280;
    margin: 0;
  }

  #error-container {
    min-height: 20px;
  }

  .error-alert {
    background-color: #fee2e2;
    color: #991b1b;
    padding: 12px 16px;
    border-radius: 6px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .loading {
    padding: 40px;
    text-align: center;
    color: #6b7280;
  }

  .no-appointments {
    background-color: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 40px;
    text-align: center;
    color: #6b7280;
  }

  .appointments-table {
    width: 100%;
    background-color: white;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    border-collapse: collapse;
    overflow: hidden;
  }

  .appointments-table thead {
    background-color: #f9fafb;
  }

  .appointments-table thead tr {
    border-bottom: 2px solid #e5e7eb;
  }

  .appointments-table th {
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    font-size: 14px;
  }

  .appointments-table td {
    padding: 12px 16px;
    font-size: 14px;
    border-bottom: 1px solid #e5e7eb;
  }

  .appointments-table tbody tr.even {
    background-color: #f9fafb;
  }

  .appointments-table tbody tr.odd {
    background-color: white;
  }

  .monospace {
    font-family: monospace;
  }

  .badge {
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    display: inline-block;
    border: none;
    outline: none;
    box-shadow: none;
  }

  .badge-success {
    background-color: #d1fae5;
    color: #065f46;
  }

  .badge-pending {
    background-color: #fef3c7;
    color: #92400e;
  }

  .badge-danger {
    background-color: #fee2e2;
    color: #991b1b;
  }

  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .actions-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .text-muted {
    color: #9ca3af;
  }

  .btn-confirm,
  .btn-reject {
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .btn-confirm {
    background-color: #000;
    color: #fff;
    border: 2px solid #000;
    box-shadow: 3px 3px 0 #065f46;
  }

  .btn-confirm:hover {
    background-color: #065f46;
    border-color: #065f46;
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 #000;
  }

  .btn-reject {
    background-color: #fff;
    color: #991b1b;
    border: 2px solid #991b1b;
    box-shadow: 3px 3px 0 #991b1b;
  }

  .btn-reject:hover {
    background-color: #991b1b;
    color: #fff;
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 #000;
  }

  .btn-gcal-admin {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 14px;
    text-decoration: none;
    border: 2px solid #bbbdbf;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    color: #1a73e8;
    background: #fff;
    white-space: nowrap;
    transition: all 0.15s;
  }

  .btn-gcal-admin:hover {
    background-color: #e8f0fe;
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 #1a73e8;
  }
</style>
