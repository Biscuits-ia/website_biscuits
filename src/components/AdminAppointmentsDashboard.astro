---
// src/components/AdminAppointmentsDashboard.astro
//
// Vue admin des réservations avec toggle Tableau / Calendrier (F1).
// La vue calendrier monte <AdminAppointmentsCalendar /> côté serveur.
// La vue tableau garde la liste plate (rendu côté client via <script>).
// Modale de confirmation : window.showConfirm() (monté globalement dans DashboardLayout).
// Toast : window.showToast() (monté globalement dans DashboardLayout).

import AdminAppointmentsCalendar from './AdminAppointmentsCalendar.astro';
import type { AppointmentSlot, AppointmentStatus } from '@/types/appointments';

interface Props {
  year: number;
  month: number;
  slots?: AppointmentSlot[];
  appointments?: CalendarAppointment[];
  selectedDay?: string | null;
  initialView?: 'table' | 'calendar';
  nonce?: string;
}

interface CalendarAppointment {
  id: string;
  slot_id: string | null;
  status: AppointmentStatus;
  start_time: string;
  end_time: string;
  notes: string | null;
  candidate_email: string | null;
  user_profile: { full_name: string | null; email: string | null } | null;
}

const { year, month, slots = [], appointments = [], selectedDay = null, initialView = 'table', nonce } = Astro.props;
const calendarActive = initialView === 'calendar';
---

<div class="dashboard-container">
  <div class="header">
    <h1>📅 Réservations</h1>
    <p>Vue des réservations effectuées par les utilisateurs</p>
  </div>

  <nav class="view-toggle" role="tablist" aria-label="Mode d'affichage">
    <button type="button" class:list={['view-toggle-btn', { 'is-active': !calendarActive }]} role="tab" aria-selected={!calendarActive} data-view="table">
      📋 Tableau
    </button>
    <button type="button" class:list={['view-toggle-btn', { 'is-active': calendarActive }]} role="tab" aria-selected={calendarActive} data-view="calendar">
      🗓 Calendrier
    </button>
  </nav>

  <div id="error-container"></div>

  <!-- Vue tableau -->
  <div id="view-table" class="view-pane" hidden={calendarActive}>
    <div id="content">
      <div class="loading">⏳ Chargement...</div>
    </div>
  </div>

  <!-- Vue calendrier -->
  <div id="view-calendar" class="view-pane" hidden={!calendarActive}>
    <AdminAppointmentsCalendar year={year} month={month} slots={slots} appointments={appointments} selectedDay={selectedDay} nonce={nonce} />
  </div>
</div>

<style>
  .dashboard-container {
    padding: 30px;
    background-color: #f9fafb;
    border-radius: 10px;
  }
  .header { margin-bottom: 24px; }
  .header h1 { font-size: 28px; font-weight: bold; margin: 0 0 8px 0; }
  .header p { color: #6b7280; margin: 0; }

  .view-toggle {
    display: inline-flex;
    gap: 0;
    margin-bottom: 20px;
    background: #fff;
    border: 2px solid #000;
    border-radius: 8px;
    padding: 2px;
    box-shadow: 2px 2px 0 #000;
  }
  .view-toggle-btn {
    background: transparent;
    color: #2C2014;
    border: none;
    padding: 8px 16px;
    font-family: 'Geist', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 5px;
    transition: background 0.12s, color 0.12s;
  }
  .view-toggle-btn:hover { background: #F7F2E8; }
  .view-toggle-btn.is-active {
    background: oklch(53.958% 0.10717 58.243);
    color: #FDFAF4;
  }

  .view-pane { display: block; }
  .view-pane[hidden] { display: none; }

  #error-container { min-height: 20px; }
  .error-alert {
    background-color: #fee2e2; color: #991b1b;
    padding: 12px 16px; border-radius: 6px;
    margin-bottom: 20px; font-size: 14px;
  }
  .loading { padding: 40px; text-align: center; color: #6b7280; }
  .no-appointments {
    background-color: white; border: 1px solid #e5e7eb;
    border-radius: 8px; padding: 40px; text-align: center; color: #6b7280;
  }

  .appointments-table {
    width: 100%; background-color: white; border-radius: 8px;
    border: 1px solid #e5e7eb; border-collapse: collapse; overflow: hidden;
  }
  .appointments-table thead { background-color: #f9fafb; }
  .appointments-table thead tr { border-bottom: 2px solid #e5e7eb; }
  .appointments-table th { padding: 12px 16px; text-align: left; font-weight: 600; font-size: 14px; }
  .appointments-table td { padding: 12px 16px; font-size: 14px; border-bottom: 1px solid #e5e7eb; }
  .appointments-table tbody tr.even { background-color: #f9fafb; }
  .appointments-table tbody tr.odd  { background-color: white; }
  .monospace { font-family: monospace; }

  .badge {
    padding: 4px 12px; border-radius: 4px; font-size: 12px;
    font-weight: 600; display: inline-block;
  }
  .badge-success { background-color: #d1fae5; color: #065f46; }
  .badge-pending { background-color: #fef3c7; color: #92400e; }
  .badge-danger  { background-color: #fee2e2; color: #991b1b; }
  .badge-muted   { background-color: #e5e7eb; color: #4b5563; }
  .table-notice  { margin: 12px 0 0; font-size: 13px; color: #6b7280; }
  .temporal-badge {
    display: inline-block; margin-left: 6px; padding: 2px 8px;
    border-radius: 99px; font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em;
    font-family: 'Geist Mono', monospace; vertical-align: middle;
  }
  .temporal-upcoming    { background: #DBEAFE; color: #1E40AF; }
  .temporal-in_progress { background: #FEF3C7; color: #92400E; }
  .temporal-past        { background: #E5E7EB; color: #6B7280; opacity: 0.55; }

  .actions { display: flex; gap: 16px; align-items: center; }
  .actions-col { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .text-muted { color: #9ca3af; }

  .btn-confirm, .btn-reject {
    padding: 8px 16px; border-radius: 4px; font-size: 13px;
    font-weight: 700; cursor: pointer; transition: all 0.15s ease; white-space: nowrap;
  }
  .btn-confirm {
    background-color: #000; color: #fff; border: 2px solid #000; box-shadow: 3px 3px 0 #065f46;
  }
  .btn-confirm:hover { background-color: #065f46; border-color: #065f46; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #000; }
  .btn-reject {
    background-color: #fff; color: #991b1b; border: 2px solid #991b1b; box-shadow: 3px 3px 0 #991b1b;
  }
  .btn-reject:hover { background-color: #991b1b; color: #fff; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #000; }
  .btn-gcal-admin {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 8px 14px; text-decoration: none; border: 2px solid #bbbdbf;
    border-radius: 4px; font-size: 13px; font-weight: 700;
    color: #1a73e8; background: #fff; white-space: nowrap; transition: all 0.15s;
  }
  .btn-gcal-admin:hover { background-color: #e8f0fe; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #1a73e8; }

  /* Le tableau a 6 colonnes deborde sur mobile : on le fait defiler dans son
     propre conteneur plutot que de faire defiler toute la page. */
  #content { overflow-x: auto; }
  .appointments-table { min-width: 720px; }
  @media (max-width: 640px) {
    .dashboard-container { padding: 16px; }
    .header h1 { font-size: 22px; }
    .actions-col { flex-direction: row; flex-wrap: wrap; }
  }
</style>

<script is:inline nonce={nonce}>
  // ── Toggle de vue Tableau / Calendrier ───────────────────────────────────────
  var viewButtons = document.querySelectorAll('.view-toggle-btn');
  var viewTable   = document.getElementById('view-table');
  var viewCal     = document.getElementById('view-calendar');

  viewButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var view = btn.dataset.view;
      viewButtons.forEach(function (b) {
        var active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      if (viewTable) viewTable.hidden = view !== 'table';
      if (viewCal)   viewCal.hidden   = view !== 'calendar';
      // Memorise la vue dans l'URL : la navigation mensuelle du calendrier
      // recharge la page et retombait sinon systematiquement sur le tableau.
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('view', view);
        window.history.replaceState(null, '', url.toString());
      } catch (_) { /* history indisponible : non bloquant */ }
    });
  });

  // ── Vue tableau : chargement + actions ───────────────────────────────────────
  var errorContainer = document.getElementById('error-container');
  var contentDiv     = document.getElementById('content');

  function showError(msg) {
    if (errorContainer) errorContainer.innerHTML = msg ? '<div class="error-alert">❌ ' + msg + '</div>' : '';
  }
  function toast(msg, type) {
    if (typeof window.showToast === 'function') window.showToast(msg, type);
  }

  // L'API pagine (defaut 50, max 200). Sans limite explicite les reservations
  // au-dela de la 50e n'apparaissaient nulle part, sans aucun indicateur.
  const PAGE_SIZE = 200;

  function loadAppointments() {
    fetch('/api/admin/appointments?limit=' + PAGE_SIZE, { credentials: 'include' })
      .then(function (response) {
        if (!response.ok) return response.text().then(function (t) { throw new Error('Erreur ' + response.status + ': ' + t); });
        return response.json();
      })
      .then(function (data) {
        var list = Array.isArray(data) ? data : (data && typeof data === 'object' && Array.isArray(data.data) ? data.data : []);
        var total = (data && typeof data.total === 'number') ? data.total : list.length;
        renderAppointments(list, total);
      })
      .catch(function (err) {
        var msg = err instanceof Error ? err.message : 'Erreur inconnue';
        showError(msg);
        if (contentDiv) contentDiv.innerHTML = '<div style="color: #dc2626; padding: 20px; text-align: center;">Erreur de chargement</div>';
      });
  }

  function temporalState(startIso, endIso) {
    var now = Date.now();
    var end = Date.parse(endIso);
    if (!Number.isNaN(end) && now >= end) return 'past';
    var start = Date.parse(startIso);
    if (!Number.isNaN(start) && now >= start) return 'in_progress';
    return 'upcoming';
  }

  function pad(n) { return n.toString().padStart(2, '0'); }

  // Heure de Paris, comme la vue calendrier. Avant, ce tableau affichait
  // l'heure locale du navigateur : deux heures differentes pour le meme
  // creneau sur la meme page selon l'onglet Tableau / Calendrier.
  const SITE_TZ = 'Europe/Paris';
  const timeFmt = new Intl.DateTimeFormat('fr-FR', { timeZone: SITE_TZ, hour: '2-digit', minute: '2-digit', hour12: false });
  const dateFmt = new Intl.DateTimeFormat('fr-FR', { timeZone: SITE_TZ, day: '2-digit', month: '2-digit', year: 'numeric' });

  // 'expired' est pose par le job pg_cron sur les RDV pending perimes.
  // Sans entree ici, le tableau affichait le libelle "En attente" pour eux.
  const STATUS_BADGE = {
    confirmed: { cls: 'badge-success', label: '✓ Confirmé' },
    cancelled: { cls: 'badge-danger',  label: '✗ Annulé' },
    expired:   { cls: 'badge-muted',   label: '⌛ Expiré' },
    pending:   { cls: 'badge-pending', label: '⏳ En attente' },
  };

  function buildAdminGoogleCalUrl(appt) {
    var slot = appt.appointment_slots;
    if (!slot) return '#';
    var start = new Date(slot.start_time);
    var end   = new Date(slot.end_time);
    var fmt = function (d) {
      return d.getUTCFullYear() + pad(d.getUTCMonth() + 1) + pad(d.getUTCDate()) + 'T' + pad(d.getUTCHours()) + pad(d.getUTCMinutes()) + '00Z';
    };
    var name = (appt.user_profile && appt.user_profile.full_name) ||
               (appt.user_profile && appt.user_profile.email) ||
               appt.candidate_email ||
               'Bénévole';
    var params = new URLSearchParams({
      action: 'TEMPLATE',
      text: 'RDV Biscuits IA — ' + name,
      dates: fmt(start) + '/' + fmt(end),
      details: 'Rendez-vous avec ' + name + '.',
    });
    return 'https://calendar.google.com/calendar/render?' + params.toString();
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  // `currentStatus` sert uniquement a choisir le bon verbe : on "rejette" une
  // demande en attente, on "annule" un rendez-vous deja confirme.
  function updateAppointmentStatus(id, status, currentStatus) {
    var isReject = status === 'cancelled' && currentStatus === 'pending';
    var actionLabel = status === 'confirmed' ? 'confirmer' : isReject ? 'rejeter' : 'annuler';
    var danger = status === 'cancelled';
    var verb   = status === 'confirmed' ? 'Confirmer' : isReject ? 'Rejeter' : 'Annuler';

    if (typeof window.showConfirm !== 'function') return;

    window.showConfirm({
      title: verb + ' la réservation',
      message: 'Êtes-vous sûr de vouloir ' + actionLabel + ' cette réservation ?',
      confirmLabel: verb,
      danger: danger,
    }).then(function (ok) {
      if (!ok) return;
      return fetch('/api/admin/appointments/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ status: status }),
      });
    }).then(function (response) {
      if (!response || !response.ok) throw new Error('Erreur ' + (response ? response.status : 'inconnue'));
      showError('');
      toast(status === 'confirmed' ? '✓ Réservation confirmée' : '✓ Réservation annulée', 'success');
      loadAppointments();
    }).catch(function (err) {
      var msg = err instanceof Error ? err.message : 'Erreur inconnue';
      showError(msg);
      toast(msg, 'error');
    });
  }

  function renderAppointments(appointments, total) {
    if (!contentDiv) return;
    if (appointments.length === 0) {
      contentDiv.innerHTML = '<div class="no-appointments">Aucune réservation pour le moment</div>';
      return;
    }
    const truncatedNotice = (typeof total === 'number' && total > appointments.length)
      ? '<p class="table-notice">Affichage des ' + appointments.length + ' réservations les plus récentes sur ' + total + '.</p>'
      : '';

    var html = `
      <table class="appointments-table">
        <thead>
          <tr>
            <th>Utilisateur</th>
            <th>Email</th>
            <th>Créneau</th>
            <th>Statut</th>
            <th>Réservé le</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          ${appointments.map(function (appt, idx) {
            var slot = appt.appointment_slots;
            var slotLabel = '<em>Créneau supprimé</em>';
            var temporalBadge = '';
            if (slot) {
              slotLabel = dateFmt.format(new Date(slot.start_time)) + ' ' +
                          timeFmt.format(new Date(slot.start_time)) + ' - ' +
                          timeFmt.format(new Date(slot.end_time));
              var ts = temporalState(slot.start_time, slot.end_time);
              var tsLabel = ts === 'past' ? 'Passé' : ts === 'in_progress' ? 'En cours' : 'À venir';
              temporalBadge = '<span class="temporal-badge temporal-' + ts + '">' + tsLabel + '</span>';
            }
            var userName  = (appt.user_profile && appt.user_profile.full_name) ||
                            (appt.user_profile && appt.user_profile.email) ||
                            appt.candidate_email ||
                            '-';
            var userEmail = (appt.user_profile && appt.user_profile.email) || appt.candidate_email || '-';
            var isPending   = appt.status === 'pending';
            var isConfirmed = appt.status === 'confirmed';
            var actions = isPending
              ? '<div class="actions-col"><button class="btn-confirm" data-id="' + escapeHtml(appt.id) + '" data-status="pending">✓ Confirmer</button><button class="btn-reject" data-id="' + escapeHtml(appt.id) + '" data-status="pending">✗ Rejeter</button></div>'
              : isConfirmed
              ? '<div class="actions-col"><a href="' + escapeHtml(buildAdminGoogleCalUrl(appt)) + '" target="_blank" rel="noopener noreferrer" class="btn-gcal-admin">📅 Agenda</a><button class="btn-reject" data-id="' + escapeHtml(appt.id) + '" data-status="confirmed">✗ Annuler</button></div>'
              : '<span class="text-muted">—</span>';
            const badge = STATUS_BADGE[appt.status] || STATUS_BADGE.pending;
            return '<tr class="' + (idx % 2 === 0 ? 'even' : 'odd') + ' status-' + escapeHtml(appt.status) + '">' +
              '<td>' + escapeHtml(String(userName)) + '</td>' +
              '<td>' + escapeHtml(String(userEmail)) + '</td>' +
              '<td class="monospace">' + slotLabel + temporalBadge + '</td>' +
              '<td><span class="badge ' + badge.cls + '">' + badge.label + '</span></td>' +
              '<td>' + dateFmt.format(new Date(appt.created_at)) + '</td>' +
              '<td class="actions">' + actions + '</td>' +
            '</tr>';
          }).join('')}
        </tbody>
      </table>
    `;
    contentDiv.innerHTML = html + truncatedNotice;

    contentDiv.querySelectorAll('.btn-confirm').forEach(function (btn) {
      btn.addEventListener('click', function () { if (btn.dataset.id) updateAppointmentStatus(btn.dataset.id, 'confirmed', btn.dataset.status); });
    });
    contentDiv.querySelectorAll('.btn-reject').forEach(function (btn) {
      btn.addEventListener('click', function () { if (btn.dataset.id) updateAppointmentStatus(btn.dataset.id, 'cancelled', btn.dataset.status); });
    });
  }

  loadAppointments();
</script>
