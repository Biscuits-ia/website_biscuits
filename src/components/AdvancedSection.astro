<section class="section" data-reveal>
  <!-- Parallax background -->
  <div class="bg" data-parallax="slow">
    <div class="gradient"></div>
  </div>

  <!-- Content avec animations -->
  <div class="content" data-parallax="medium">
    <h2 data-animate-text>Titre animé</h2>
    
    <!-- Lazy loaded image -->
    <img 
      data-src="/image.webp" 
      alt="Description"
      class="lazy"
    />
    
    <!-- Magnetic button -->
    <button data-magnetic>
      Click me
    </button>
  </div>
</section>

<script>
  import { advancedReveal, animateText } from '@/animations/advanced/scroll-effects';

  advancedReveal({
    selector: '[data-reveal]',
    animation: 'slide',
    direction: 'up',
  });

  animateText('[data-animate-text]');
</script>