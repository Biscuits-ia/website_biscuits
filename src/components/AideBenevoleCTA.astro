---
// Composant formulaire "Besoin d'aide ?" ultra simplifié + CTA bénévole
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const nonce = Astro.locals.nonce;
---
<!-- Script Cloudflare Turnstile (widget HTML natif) -->
<script is:inline nonce={nonce} src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<section class="aide-section" aria-labelledby="aide-title">
  <div class="aide-inner">

    <!-- Formulaire Besoin d'aide -->
    <div class="aide-form-block">
      <h2 id="aide-title">Besoin d'aide ?</h2>
      <p>3 questions pour vous orienter vers la bonne solution.</p>
      <form class="aide-form" id="form-aide" novalidate>
        <div class="form-group">
          <label for="aide-qui">Qui êtes-vous ?</label>
          <select id="aide-qui" name="profil" required aria-required="true">
            <option value="">Choisir…</option>
            <option value="association">Une association</option>
            <option value="tpe">Une TPE / micro-entrepreneur</option>
            <option value="particulier">Un particulier</option>
            <option value="autre">Autre</option>
          </select>
        </div>
        <div class="form-group">
          <label for="aide-besoin">Quel est votre besoin principal ?</label>
          <select id="aide-besoin" name="besoin" required aria-required="true">
            <option value="">Choisir…</option>
            <option value="securite">Sécurité / arnaques</option>
            <option value="rgpd">RGPD / confidentialité</option>
            <option value="ia">Outils IA</option>
            <option value="autre">Autre</option>
          </select>
        </div>
        <div class="form-group">
          <label for="aide-email">Votre email (pour vous répondre)</label>
          <input type="email" id="aide-email" name="email" placeholder="vous@exemple.fr" required aria-required="true" />
        </div>

        <!-- Turnstile widget -->
        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto"></div>

        <div id="aide-error" class="aide-msg aide-msg--error" hidden></div>
        <div id="aide-success" class="aide-msg aide-msg--success" hidden>
          ✅ Votre demande a bien été envoyée ! Nous vous répondons sous 48h.
        </div>

        <button type="submit" class="cta-btn-dark" id="aide-submit">Envoyer ma demande</button>
      </form>
    </div>

    <!-- CTA Bénévole -->
    <div class="aide-benevole-block">
      <h2>Envie de contribuer ?</h2>
      <p>Rejoignez notre équipe de bénévoles et aidez des associations à s'emparer du numérique de façon éthique.</p>
      <div class="benevole-etapes">
        <div class="benevole-etape">
          <span class="etape-num">1</span>
          <span>Remplissez le formulaire de candidature</span>
        </div>
        <div class="benevole-etape">
          <span class="etape-num">2</span>
          <span>Échange de 20 min avec un membre de l'équipe</span>
        </div>
        <div class="benevole-etape">
          <span class="etape-num">3</span>
          <span>Intégration dans la communauté</span>
        </div>
      </div>
      <a href="/rejoignez-nous" class="cta-btn cta-btn--green">Devenir bénévole →</a>
    </div>

  </div>
</section>

<style>
.aide-section {
  background: var(--color-bg-alt);
  padding: 4rem clamp(1rem, 4vw, 2rem);
}
.aide-inner {
  max-width: 1000px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: start;
}

/* Tablette : réduire le gap avant de passer en colonne unique */
@media (max-width: 900px) {
  .aide-inner {
    gap: 2rem;
  }
}
@media (max-width: 700px) {
  .aide-inner {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
}

/* Titres : neutraliser le centrage global des h2 */
.aide-form-block h2,
.aide-benevole-block h2 {
  font-size: clamp(1.35rem, 3.5vw, 1.75rem);
  color: var(--color-primary);
  margin-bottom: 0.5rem;
  text-align: left;
  -webkit-text-fill-color: var(--color-primary);
  background: none;
}

.aide-form-block p,
.aide-benevole-block p {
  color: var(--color-text-light);
  margin-bottom: 1.5rem;
}
.aide-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.form-group label {
  font-weight: 500;
  font-size: 0.95rem;
}
.form-group select,
.form-group input {
  border: 1.5px solid var(--color-border-second);
  border-radius: var(--radius-control, 0.75rem);
  padding: 0.75rem 1rem;
  font-family: inherit;
  font-size: 1rem;
  background: var(--color-bg-elevated);
  min-height: 44px;
  width: 100%;
  transition: border-color 0.2s;
}
.form-group select:focus,
.form-group input:focus {
  border-color: var(--color-primary);
  outline: none;
}

/* Turnstile : empêcher le débordement sur mobile */
.cf-turnstile {
  max-width: 100%;
  overflow: hidden;
}

.benevole-etapes {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.benevole-etape {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-surface, 0.75rem);
  padding: 0.75rem 1rem;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border-second);
}
.etape-num {
  background: var(--color-secondary);
  color: var(--color-bg-elevated);
  font-weight: 700;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 1rem;
}
.cta-btn--green {
  background: linear-gradient(90deg, var(--color-secondary), var(--color-first));
  display: inline-block;
}
.cta-btn--green:hover {
  background: linear-gradient(90deg, var(--color-first), var(--color-secondary));
}

/* Boutons pleine largeur sur mobile */
@media (max-width: 700px) {
  .cta-btn-dark,
  .cta-btn--green {
    width: 100%;
    text-align: center;
    display: block;
  }
}

.aide-msg {
  padding: 0.75rem 1rem;
  border-radius: var(--radius-control, 0.75rem);
  font-size: 0.9375rem;
  font-weight: 500;
}
.aide-msg--error {
  background: #fee2e2;
  color: #b91c1c;
  border: 1px solid #fca5a5;
}
.aide-msg--success {
  background: #dcfce7;
  color: #166534;
  border: 1px solid #86efac;
}
.cta-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
</style>

<script>
  const PROFIL_LABELS: Record<string, string> = {
    association: 'Une association',
    tpe: 'Une TPE / micro-entrepreneur',
    particulier: 'Un particulier',
    autre: 'Autre',
  };
  const BESOIN_LABELS: Record<string, string> = {
    securite: 'Sécurité / arnaques',
    rgpd: 'RGPD / confidentialité',
    ia: 'Outils IA',
    autre: 'Autre',
  };

  const form = document.getElementById('form-aide') as HTMLFormElement | null;
  const submitBtn = document.getElementById('aide-submit') as HTMLButtonElement | null;
  const errorBox = document.getElementById('aide-error') as HTMLElement | null;
  const successBox = document.getElementById('aide-success') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !errorBox || !successBox) return;

    errorBox.hidden = true;
    successBox.hidden = true;

    const profil = (form.querySelector('#aide-qui') as HTMLSelectElement).value;
    const besoin = (form.querySelector('#aide-besoin') as HTMLSelectElement).value;
    const email = (form.querySelector('#aide-email') as HTMLInputElement).value.trim();

    // Validation basique
    if (!profil || !besoin || !email) {
      errorBox.textContent = 'Merci de remplir tous les champs.';
      errorBox.hidden = false;
      return;
    }

    // Récupérer le token Turnstile
    const turnstileInput = form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null;
    const turnstileToken = turnstileInput?.value ?? '';
    if (!turnstileToken) {
      errorBox.textContent = 'Veuillez valider le captcha avant d\'envoyer.';
      errorBox.hidden = false;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Envoi en cours…';

    const profilLabel = PROFIL_LABELS[profil] ?? profil;
    const besoinLabel = BESOIN_LABELS[besoin] ?? besoin;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          turnstileToken,
          name: profilLabel,
          email,
          subject: `Demande d'aide – ${besoinLabel}`,
          message: `Profil : ${profilLabel}\nBesoin : ${besoinLabel}\nEmail : ${email}`,
        }),
      });

      if (res.ok) {
        form.reset();
        // Reset Turnstile widget
        const widget = form.querySelector('.cf-turnstile') as HTMLElement | null;
        if (widget && (window as any).turnstile) {
          (window as any).turnstile.reset(widget);
        }
        successBox.hidden = false;
        successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        const data = await res.json().catch(() => ({}));
        errorBox.textContent = data?.message ?? 'Une erreur est survenue. Veuillez réessayer.';
        errorBox.hidden = false;
      }
    } catch {
      errorBox.textContent = 'Erreur réseau. Vérifiez votre connexion et réessayez.';
      errorBox.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Envoyer ma demande';
    }
  });
</script>
