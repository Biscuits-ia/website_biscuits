---
interface Feature {
  icon: string;
  title: string;
  description: string;
  objectif: string;
  tags: string[];
  gradient: string;
}

const features: Feature[] = [
  {
    "icon": "🎨",
    "title": "Diagnostic & orientation IA",
    "description": "Analyse pédagogique des pratiques et outils existants au sein de votre structure (association, TPE ou PME) afin d’identifier des usages de l’IA réellement utiles, éthiques et adaptés à votre réalité.",
    "objectif": "Permettre aux structures de démarrer sereinement avec l’IA, sans complexité ni logique purement marchande.",
    "tags": ["Association", "TPE ", "PME"],
    "gradient": "from-primary to-secondary"
  },
  {
    "icon": "⚡",
    "title": "Bases de connaissances & IA au service des équipes",
    "description": "Centralisation des documents, ressources et savoirs de la structure pour faciliter leur accès par les bénévoles, salariés ou collaborateurs (PDF, Notion, Drive, etc.).",
    "objectif": "Faciliter la transmission des connaissances et améliorer l’efficacité collective.",
    "tags": ["Accessibilité", "Organisation"],
    "gradient": "from-secondary to-first"
  },
  {
    "icon": "🔒",
    "title": "Automatisations simples & responsables",
    "description": "Mise en place d’automatisations légères et compréhensibles pour réduire les tâches répétitives, dans le respect des valeurs humaines, de la sobriété numérique et des contraintes des petites structures.",
    "objectif": "Soulager les équipes afin de se concentrer sur l’humain, le cœur de métier et l’impact.",
    "tags": ["Responsabilité", "Productivité"],
    "gradient": "from-first to-primary"
  },
  {
    "icon": "📊",
    "title": "Aide à la décision & lecture des données",
    "description": "Utilisation raisonnée de l’IA pour mieux comprendre les données de la structure (activités, projets, indicateurs), sans jargon technique ni outils complexes.",
    "objectif": "Aider les responsables associatifs et dirigeants de TPE/PME à prendre des décisions éclairées et transparentes.",
    "tags": ["Transparence", "Pilotage"],
    "gradient": "from-primary to-first"
  },
  {
    "icon": "🔧",
    "title": "Outils conversationnels & accessibilité numérique",
    "description": "Création d’interfaces conversationnelles simples pour rendre les outils numériques et les informations plus accessibles aux équipes, bénéficiaires ou clients.",
    "objectif": "Réduire la fracture numérique et améliorer l’accessibilité des services et informations.",
    "tags": ["Accessibilité", "Inclusion"],
    "gradient": "from-secondary to-primary"
  },
  {
    "icon": "🚀",
    "title": "Veille, sensibilisation & culture IA",
    "description": "Veille continue sur les évolutions de l’IA et actions de sensibilisation adaptées aux enjeux associatifs, entrepreneuriaux et citoyens.",
    "objectif": "Accompagner les structures dans une transition numérique responsable, éclairée et durable.",
    "tags": ["Sensibilisation", "Culture numérique"],
    "gradient": "from-first to-secondary"
  }
];
---
<section class="features-section" data-features-section>
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" data-title-reveal>
        Entrez dans l'ère de l'IA responsable
      </h2>
      <p class="section-subtitle" data-subtitle-reveal>
        Des solutions personnalisées pour automatiser vos tâches, valoriser vos equipes et rendre votre travail plus simple et efficace.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature, index) => (
        <article 
          class="feature-card" 
          data-feature-card
          data-index={index}
          data-gradient={feature.gradient}
        >
          <div class="card-glow"></div>
          <div class="card-content">
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-description">{feature.description}</p>
            <div class="feature-tags">
              {feature.tags.map((tag, i) => (
                <span class="tag" data-tag-index={i}>{tag}</span>
              ))}
            </div>
          </div>
          <div class="card-overlay"></div>
        </article>
      ))}
    </div>

    <!-- Decorative elements -->
    <div class="grid-lines" aria-hidden="true">
      <div class="line line-horizontal"></div>
      <div class="line line-vertical"></div>
    </div>
  </div>
</section>

<style>
  .features-section {
  padding: 8rem 2rem;
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
}

.features-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: 
  opacity: 0.2;
  pointer-events: none;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.section-header {
  text-align: center;
  margin-bottom: 5rem;
}

.section-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 900;
  color: var(--color-gray-100);
  margin-bottom: 1.5rem;  
  background-clip: text;
}

.feature-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-gray-100);
  margin-bottom: 0.75rem;
}

.section-subtitle {
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  color: var(--color-text-light);
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2.5rem;
  perspective: 1000px;
}

.feature-card {
  background: var(--color-bg-alt);
  border: 4px solid var(--color-border);
  border-radius: var(--radius-2xl);
  padding: 2.5rem;
  position: relative;
  overflow: hidden;
}

.card-glow {
  position: absolute;
  inset: -2px;
  background: var(--color-primary);  border-radius: var(--radius-2xl);
  opacity: 0;
  filter: blur(20px);
  transition: opacity 0.4s ease;
  z-index: -1;
}

.card-content {
  position: relative;
  z-index: 2;
}

.feature-icon {
  font-size: 1.2rem;
  background-color: var(--color-first);
  color: var(--color-gray-900);
  font-weight: 500;
  padding: 7px;
  margin-bottom: 1.5rem;
  display: inline-block;
}

.feature-description {
  color: var(--color-gray-100);
  line-height: 1.7;
  margin-bottom: 1.5rem;
  margin-top: 1.5rem;
  font-size: 1.1rem;
  font-weight: 400;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.tag {
  padding: 0.5rem 1rem;
  background: var(--glass-bg);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  color: var(--color-gray-200);
  font-weight: 700;
  transition: all 0.3s ease;
}

.card-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), 
              rgba(255, 255, 255, 0.1), 
              transparent 50%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

/* Grid lines decoration */
.grid-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.line {
  position: absolute;
  background: linear-gradient(90deg, 
    transparent, 
    var(--color-primary), 
    transparent);
  opacity: 0.1;
}

.line-horizontal {
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  animation: slideHorizontal 8s ease-in-out infinite;
}

.line-vertical {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
  animation: slideVertical 8s ease-in-out infinite;
}

@media (max-width: 768px) {
  .features-section {
    padding: 4rem 1.5rem;
  }

  .features-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .section-header {
    margin-bottom: 3rem;
  }
}
</style>