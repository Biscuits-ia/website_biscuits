---
interface Feature {
  icon: string;
  title: string;
  description: string;
  objectif: string;
  tags: string[];
  gradient: string;
}

const features: Feature[] = [
  {
    icon: "🎨",
    title: "Audit & Stratégie IA",
    description: "Analyse complète de vos workflows pour identifier les leviers d'automatisation à fort impact.",
    objectif: "Définir une roadmap claire pour réduire vos coûts opérationnels.",
    tags: ["Accompagnement"],
    gradient: "from-primary to-secondary"
  },
  {
    icon: "⚡",
    title: "IA Cognitive & Bases de Connaissances",
    description: "Centralisez votre savoir. Un assistant intelligent sécurisé qui interroge instantanément vos documents internes (PDF, Notion, Drive).",
    tags: ["ROI Immédiat"],
    objectif: "Supprimer la perte de temps liée à la recherche d'information.",
    gradient: "from-secondary to-first"
  },
  {
    icon: "🔒",
    title: "Agents Autonomes & Workflows",
    description: "Automatisation intelligente de bout en bout : de la qualification de leads à la génération de rapports complexes sans intervention humaine.",
    tags: ["Gain de Temps"],
    objectif: "Libérez vos équipes des tâches répétitives.",
    gradient: "from-first to-primary"
  },
  {
    icon: "📊",
    title: "Optimisation Prédictive",
    description: "Utilisation du Machine Learning pour anticiper les besoins clients, les stocks ou les tendances du marché en temps réel.",
    tags: ["Décisions Stratégiques"],
    objectif: "Garder une longueur d'avance sur votre stratégie.",
    gradient: "from-primary to-first"
  },
  {
    icon: "🔧",
    title: "Traitement du Langage Naturel (NLP)",
    description: "Intégrez des interfaces conversationnelles et l'analyse sémantique pour interagir plus naturellement avec vos outils et vos clients.",
    tags: ["Expérience Utilisateur"],
    objectif: "Rendre les logiciels complexes intuitifs.",
    gradient: "from-secondary to-primary"
  },
  {
    icon: "🚀",
    title: "Innovation & R&D IA",
    description: "Veille technologique et implémentation des dernières avancées IA (LLMs, Vision, Audio) adaptées à votre métier.",
    tags: ["Futur Prêt"],
    objectif: "Accompagner votre entreprise vers l'avenir de l'IA.",
    gradient: "from-first to-secondary"
  }
];
---

<section class="features-section" data-features-section>
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" data-title-reveal>
        Propulsez votre entreprise dans l'ère de l'IA
      </h2>
      <p class="section-subtitle" data-subtitle-reveal>
        Des solutions sur-mesure pour automatiser vos processus et transformer vos données en décisions stratégiques.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature, index) => (
        <article 
          class="feature-card" 
          data-feature-card
          data-index={index}
          data-gradient={feature.gradient}
        >
          <div class="card-glow"></div>
          <div class="card-content">
            <div class="feature-icon" data-tags-float>
              {feature.tags}
            </div>
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-description">{feature.description}</p>
            <div class="feature-tags">
              {feature.tags.map((tag, i) => (
                <span class="tag" data-tag-index={i}>{tag}</span>
              ))}
            </div>
          </div>
          <div class="card-overlay"></div>
        </article>
      ))}
    </div>

    <!-- Decorative elements -->
    <div class="grid-lines" aria-hidden="true">
      <div class="line line-horizontal"></div>
      <div class="line line-vertical"></div>
    </div>
  </div>
</section>

<style>
  .features-section {
  padding: 8rem 2rem;
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
}

.features-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: 
  opacity: 0.2;
  pointer-events: none;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.section-header {
  text-align: center;
  margin-bottom: 5rem;
}

.section-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 900;
  color: var(--color-gray-100);
  margin-bottom: 1.5rem;  
  background-clip: text;
}

.section-subtitle {
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  color: var(--color-text-light);
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2.5rem;
  perspective: 1000px;
}

.feature-card {
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-2xl);
  padding: 2.5rem;
  position: relative;
  overflow: hidden;
  transform-style: preserve-3d;
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  backdrop-filter: blur(10px);
}

.feature-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--color-primary);  opacity: 0;
  transition: opacity 0.4s ease;
  border-radius: var(--radius-2xl);
}

.feature-card:hover::before {
  opacity: 0.05;
}

.card-glow {
  position: absolute;
  inset: -2px;
  background: var(--color-primary);  border-radius: var(--radius-2xl);
  opacity: 0;
  filter: blur(20px);
  transition: opacity 0.4s ease;
  z-index: -1;
}

.feature-card:hover .card-glow {
  opacity: 0.4;
}

.feature-card:hover {
  transform: translateY(-8px) rotateX(2deg);
  border-color: var(--color-primary);
  box-shadow: var(--shadow-2xl), var(--shadow-glow);
}

.card-content {
  position: relative;
  z-index: 2;
}

.feature-icon {
  font-size: 1.2rem;
  background-color: var(--color-second);
  color: var(--color-gray-50);
  font-weight: 500;
  box-shadow: var(--shadow-lg);
  padding: 5px;
  margin-bottom: 1.5rem;
  display: inline-block;
  border-radius: var(--radius-full);
}

.feature-card:hover {
  transform: scale(1.1) rotateZ(5deg);
}

.feature-title {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--color-gray-50);
  margin-bottom: 1rem;
  transition: color 0.3s ease;
}

.feature-card:hover .feature-title {
  color: var(--color-gray-100);
}

.feature-description {
  color: var(--color-gray-300);
  line-height: 1.7;
  margin-bottom: 1.5rem;
  font-size: 1rem;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.tag {
  padding: 0.5rem 1rem;
  background: var(--glass-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  color: var(--color-primary);
  font-weight: 600;
  transition: all 0.3s ease;
}

.feature-card:hover .tag {
  background: var(--color-primary);
  color: var(--color-bg);
  transform: translateY(-2px);
}

.card-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), 
              rgba(255, 255, 255, 0.1), 
              transparent 50%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.feature-card:hover .card-overlay {
  opacity: 1;
}

/* Grid lines decoration */
.grid-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.line {
  position: absolute;
  background: linear-gradient(90deg, 
    transparent, 
    var(--color-primary), 
    transparent);
  opacity: 0.1;
}

.line-horizontal {
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  animation: slideHorizontal 8s ease-in-out infinite;
}

.line-vertical {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
  animation: slideVertical 8s ease-in-out infinite;
}

@keyframes slideHorizontal {
  0%, 100% { transform: translateX(-100%); }
  50% { transform: translateX(100%); }
}

@keyframes slideVertical {
  0%, 100% { transform: translateY(-100%); }
  50% { transform: translateY(100%); }
}

@media (max-width: 768px) {
  .features-section {
    padding: 4rem 1.5rem;
  }

  .features-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .section-header {
    margin-bottom: 3rem;
  }
}
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const shouldReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!shouldReduce) {
    // Title reveal
    const title = document.querySelector<HTMLElement>('[data-title-reveal]');
    if (title) {
      gsap.from(title, {
        opacity: 0,
        y: 50,
        duration: 1,
        scrollTrigger: {
          trigger: title,
          start: 'top 80%',
        },
      });
    }

    // Subtitle reveal
    const subtitle = document.querySelector<HTMLElement>('[data-subtitle-reveal]');
    if (subtitle) {
      gsap.from(subtitle, {
        opacity: 0,
        y: 30,
        duration: 0.8,
        delay: 0.2,
        scrollTrigger: {
          trigger: subtitle,
          start: 'top 80%',
        },
      });
    }

    // Feature cards animation
    const cards = document.querySelectorAll<HTMLElement>('[data-feature-card]');
    cards.forEach((card, index) => {
      // Entry animation
      gsap.from(card, {
        opacity: 0,
        y: 80,
        rotateX: -15,
        scale: 0.9,
        duration: 1,
        delay: index * 0.1,
        ease: 'back.out(1.2)',
        scrollTrigger: {
          trigger: card,
          start: 'top 85%',
        },
      });

      // 3D tilt on mouse move
      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -8;
        const rotateY = ((x - centerX) / centerX) * 8;

        // Update overlay position
        const mouseX = (x / rect.width) * 100;
        const mouseY = (y / rect.height) * 100;
        card.style.setProperty('--mouse-x', `${mouseX}%`);
        card.style.setProperty('--mouse-y', `${mouseY}%`);

        gsap.to(card, {
          rotateX,
          rotateY,
          duration: 0.3,
          ease: 'power2.out',
        });
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(card, {
          rotateX: 0,
          rotateY: 0,
          duration: 0.5,
          ease: 'power2.out',
        });
      });

      // Tags stagger animation
      const tags = card.querySelectorAll<HTMLElement>('[data-tag-index]');
      gsap.from(tags, {
        opacity: 0,
        scale: 0.8,
        stagger: 0.05,
        duration: 0.4,
        scrollTrigger: {
          trigger: card,
          start: 'top 75%',
        },
      });
    });

    // Floating icons
    const icons = document.querySelectorAll<HTMLElement>('[data-icon-float]');
    icons.forEach((icon) => {
      gsap.to(icon, {
        y: -10,
        duration: 2,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
      });
    });

    document.addEventListener('astro:before-preparation', () => {
      ScrollTrigger.getAll().forEach(t => t.kill());
    });
  }
</script>