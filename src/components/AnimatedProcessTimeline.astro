---
/**
 * Timeline de processus avec animations synchronisées au scroll
 */

interface ProcessStep {
  number: string;
  title: string;
  description: string;
  details: string[];
  duration: string;
  icon: string;
}

const steps: ProcessStep[] = [
  {
    number: "01",
    title: "Analyse & Cadrage",
    description: "Compréhension approfondie de vos besoins et définition du scope",
    details: [
      "Audit de l'existant",
      "Définition des objectifs",
      "Étude de faisabilité",
      "Proposition technique"
    ],
    duration: "2-3 jours",
    icon: "🔍"
  },
  {
    number: "02",
    title: "Design & Architecture",
    description: "Conception de l'architecture technique et des interfaces",
    details: [
      "Schéma d'architecture",
      "Design system & maquettes",
      "Choix technologiques",
      "Plan de développement"
    ],
    duration: "5-7 jours",
    icon: "🎨"
  },
  {
    number: "03",
    title: "Développement",
    description: "Implémentation avec méthodologie agile et itérations rapides",
    details: [
      "Setup environnement",
      "Développement features",
      "Tests unitaires & E2E",
      "Code review continue"
    ],
    duration: "2-6 semaines",
    icon: "⚡"
  },
  {
    number: "04",
    title: "Tests & QA",
    description: "Validation complète et optimisation des performances",
    details: [
      "Tests de performance",
      "Tests de sécurité",
      "Optimisation SEO",
      "Validation utilisateur"
    ],
    duration: "3-5 jours",
    icon: "✅"
  },
  {
    number: "05",
    title: "Déploiement",
    description: "Mise en production avec monitoring et accompagnement",
    details: [
      "Configuration serveurs",
      "Déploiement CI/CD",
      "Monitoring & alertes",
      "Formation équipe"
    ],
    duration: "1-2 jours",
    icon: "🚀"
  },
  {
    number: "06",
    title: "Suivi & Support",
    description: "Maintenance continue et évolutions",
    details: [
      "Support réactif",
      "Mises à jour régulières",
      "Optimisations",
      "Nouvelles features"
    ],
    duration: "Continu",
    icon: "🛠️"
  }
];
---

<section class="timeline-section" data-timeline-section>
  <div class="container">
    <div class="timeline-header">
      <h2 class="timeline-title" data-reveal>Notre Processus</h2>
      <p class="timeline-subtitle" data-reveal>
        Une méthodologie éprouvée pour transformer vos idées en solutions concrètes
      </p>
    </div>

    <div class="timeline-wrapper">
      <!-- Progress line -->
      <div class="timeline-line" data-timeline-line>
        <div class="timeline-progress" data-timeline-progress></div>
      </div>

      <!-- Steps -->
      <div class="timeline-steps">
        {steps.map((step, index) => (
          <article 
            class="timeline-step" 
            data-timeline-step
            data-step-index={index}
          >
            <div class="step-marker" data-step-marker>
              <span class="marker-icon">{step.icon}</span>
              <span class="marker-number">{step.number}</span>
            </div>

            <div class="step-content" data-step-content>
              <div class="step-header">
                <h3 class="step-title">{step.title}</h3>
                <span class="step-duration">{step.duration}</span>
              </div>
              
              <p class="step-description">{step.description}</p>
              
              <ul class="step-details">
                {step.details.map((detail, i) => (
                  <li data-detail-index={i}>
                    <span class="detail-bullet">→</span>
                    {detail}
                  </li>
                ))}
              </ul>

              <div class="step-connector" aria-hidden="true"></div>
            </div>
          </article>
        ))}
      </div>
    </div>

<style>
  .timeline-section {
  padding: 8rem 2rem;
  position: relative;
  overflow: hidden;
}

.timeline-section::before {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.1;
  pointer-events: none;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.timeline-header {
  text-align: center;
  margin-bottom: 6rem;
}

.timeline-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 900;
  color: var(--color-gray-100);
  margin-bottom: 1.5rem;
}

.timeline-subtitle {
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  color: var(--color-text);
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
}

.timeline-wrapper {
  position: relative;
  padding: 2rem 0;
}

/* Timeline line */
.timeline-line {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 4px;
  background: var(--color-border);
  transform: translateX(-50%);
  border-radius: var(--radius-sm); 
}

.timeline-progress {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0;
  background: linear-gradient(180deg, var(--color-primary), var(--color-secondary));
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-glow);
}

/* Steps */
.timeline-steps {
  display: flex;
  flex-direction: column;
  gap: 6rem;
  position: relative;
}

.timeline-step {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 3rem;
  align-items: center;
  position: relative;
}

.timeline-step:nth-child(even) {
  direction: rtl;
}

.timeline-step:nth-child(even) .step-content {
  direction: ltr;
}

.step-marker {
  width: 120px;
  height: 120px;
  background: var(--color-primary);  border-radius: var(--radius-full);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  box-shadow: var(--shadow-glow);
  transition: all 0.4s ease;
}

.timeline-step:hover .step-marker {
  transform: scale(1.1) rotate(5deg);
  box-shadow: var(--shadow-glow-hover);
}

.marker-icon {
  font-size: 2.5rem;
  margin-bottom: 0.25rem;
}

.marker-number {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-bg);
}

.step-content {
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 2.5rem;
  backdrop-filter: blur(10px);
  position: relative;
  transition: all 0.4s ease;
}

.step-content:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-lg);
  transform: translateY(-5px);
}

.step-content::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--color-primary);  opacity: 0;
  border-radius: var(--radius-xl);
  transition: opacity 0.3s ease;
}

.step-content:hover::before {
  opacity: 0.05;
}

.step-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.step-title {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--color-gray-100);
}

.step-duration {
  padding: 0.5rem 1rem;
  background: var(--glass-bg);
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-full);
  font-size: 0.9rem;
  color: var(--color-first);
  font-weight: 600;
}

.step-description {
  color: var(--color-gray-300);
  line-height: 1.7;
  margin-bottom: 1.5rem;
  font-size: 1.05rem;
}

.step-details {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.step-details li {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--color-text-light);
  font-size: 0.95rem;
  transition: all 0.3s ease;
}

.step-content:hover .step-details li {
  color: var(--color-text);
}

.detail-bullet {
  color: var(--color-secondary);
  font-weight: 700;
  font-size: 1.2rem;
}

.step-connector {
  position: absolute;
  width: 60px;
  height: 2px;
  background: linear-gradient(90deg, var(--color-primary), transparent);
  top: 50%;
  transform: translateY(-50%);
}

.timeline-step:nth-child(odd) .step-connector {
  right: -90px;
}

.timeline-step:nth-child(even) .step-connector {
  left: -90px;
  transform: translateY(-50%) scaleX(-1);
}

.cta-button {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem 2.5rem;
  background: var(--color-primary);  color: var(--color-bg);
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 1.1rem;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: var(--shadow-lg);
}

.cta-button:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: var(--shadow-glow-hover);
}

.cta-icon {
  font-size: 1.5rem;
  transition: transform 0.3s ease;
}

.cta-button:hover .cta-icon {
  transform: scale(1.2) rotate(10deg);
}

/* Mobile */
@media (max-width: 1024px) {
  .timeline-line {
    left: 60px;
  }

  .timeline-steps {
    gap: 4rem;
  }

  .timeline-step {
    grid-template-columns: auto 1fr;
    gap: 2rem;
  }

  .timeline-step:nth-child(even) {
    direction: ltr;
  }

  .step-marker {
    width: 100px;
    height: 100px;
  }

  .marker-icon {
    font-size: 2rem;
  }

  .step-connector {
    display: none;
  }
}

@media (max-width: 768px) {
  .timeline-section {
    padding: 4rem 1.5rem;
  }

  .timeline-header {
    margin-bottom: 4rem;
  }

  .step-marker {
    width: 80px;
    height: 80px;
  }

  .marker-icon {
    font-size: 1.75rem;
  }

  .step-content {
    padding: 1.5rem;
  }

  .step-title {
    font-size: 1.4rem;
  }
}
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const shouldReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!shouldReduce) {
    // Header animation
    const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
    reveals.forEach((el, i) => {
      gsap.from(el, {
        opacity: 0,
        y: 50,
        duration: 1,
        delay: i * 0.2,
        scrollTrigger: {
          trigger: el,
          start: 'top 80%',
        },
      });
    });

    // Timeline progress
    const progressBar = document.querySelector<HTMLElement>('[data-timeline-progress]');
    const timelineSection = document.querySelector<HTMLElement>('[data-timeline-section]');

    if (progressBar && timelineSection) {
      gsap.to(progressBar, {
        height: '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: timelineSection,
          start: 'top center',
          end: 'bottom center',
          scrub: 1,
        },
      });
    }

    // Steps animation
    const steps = document.querySelectorAll<HTMLElement>('[data-timeline-step]');
    steps.forEach((step, index) => {
      const isEven = index % 2 === 0;
      
      // Marker animation
      const marker = step.querySelector<HTMLElement>('[data-step-marker]');
      if (marker) {
        gsap.from(marker, {
          scale: 0,
          rotation: -180,
          duration: 0.8,
          ease: 'back.out(1.5)',
          scrollTrigger: {
            trigger: step,
            start: 'top 70%',
          },
        });
      }

      // Content animation
      const content = step.querySelector<HTMLElement>('[data-step-content]');
      if (content) {
        gsap.from(content, {
          opacity: 0,
          x: isEven ? -100 : 100,
          duration: 1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: step,
            start: 'top 70%',
          },
        });
      }

      // Details stagger
      const details = step.querySelectorAll<HTMLElement>('[data-detail-index]');
      gsap.from(details, {
        opacity: 0,
        x: -20,
        stagger: 0.1,
        duration: 0.5,
        scrollTrigger: {
          trigger: step,
          start: 'top 65%',
        },
      });
    });

    // CTA animation
    const cta = document.querySelector<HTMLElement>('[data-timeline-cta]');
    if (cta) {
      gsap.from(cta, {
        opacity: 0,
        y: 50,
        scale: 0.95,
        duration: 1,
        ease: 'back.out(1.2)',
        scrollTrigger: {
          trigger: cta,
          start: 'top 80%',
        },
      });
    }

    // Cleanup
    document.addEventListener('astro:before-preparation', () => {
      ScrollTrigger.getAll().forEach((st) => st.kill());
    });
  }
</script>