---
interface Service {
  icon: string;
  title: string;
  description: string;
  features: string[];
  price?: string;
  badge?: string;
}

const services: Service[] = [
  {
    icon: "🤖",
    title: "Assistants IA & RAG",
    description: "Un 'ChatGPT' privé connecté à vos documents pour une expertise interne sans faille.",
    features: [
      "Connexion à vos PDF/Notion",
      "Confidentialité totale des données",
      "Déploiement GPT-4o ou Claude 3.5",
      "Interface utilisateur sur-mesure"
    ],
    price: "2 500",
    badge: "Plus Rentable"
  },
  {
    icon: "⚙️",
    title: "Écosystème MCP & Agents",
    description: "Automatisez vos actions répétitives entre vos différents logiciels (SaaS).",
    features: [
      "Interconnexion de vos outils",
      "Agents autonomes décisionnels",
      "Maintenance & Logs temps réel",
      "Économie de 10h+/semaine"
    ],
    price: "1 200",
    badge: "Best-Seller"
  },
  {
    icon: "🚀",
    title: "SaaS IA Ready-to-Launch",
    description: "Architecture complète pour lancer votre propre service basé sur l'IA.",
    features: [
      "Gestion abonnements (Stripe)",
      "Dashboard Analytics IA",
      "Infrastructure scalable",
      "Code source 100% propriétaire"
    ],
    price: "4 500",
    badge: "Expert"
  },
  {
    icon: "🧩",
    title: "Infrastructure IA Custom",
    description: "Solutions lourdes pour entreprises avec besoins spécifiques de performance.",
    features: [
      "Fine-tuning de modèles",
      "Hébergement local / Privé",
      "Support & Évolution continue",
      "Audit de sécurité complet"
    ],
    price: "Sur Devis "
  }
];

interface Stat {
  icon: string;
  value: number;
  label: string;
  suffix?: string;
}

const stats: Stat[] = [
  { icon: "⚡", value: 95, label: "Automatisation", suffix: "%" },
  { icon: "🎯", value: 48, label: "Heures économisées/mois", suffix: "h" },
  { icon: "🚀", value: 300, label: "ROI moyen", suffix: "%" }
];
---

<section class="animated-showcase" data-showcase>
  <!-- Hero avec scroll horizontal (desktop only) -->
  <div class="horizontal-container" data-horizontal-section>
    <div class="horizontal-wrapper">
      {services.map((service, index) => (
        <div class="service-panel" data-panel={index} data-lazy-animate>
          <div class="panel-bg"></div>
          
          {service.badge && (
            <div class="service-badge">{service.badge}</div>
          )}
          
          <div class="panel-content">
            <span class="panel-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="service-icon">{service.icon}</div>
            <h2 class="service-title">{service.title}</h2>
            <p class="service-description">{service.description}</p>
            
            <div class="service-features">
              {service.features.map((feature) => (
                <div class="feature-tag">
                  <span class="tag-dot"></span>
                  {feature}
                </div>
              ))}
            </div>
            
            {service.price && (
              <div class="service-price">
                <span class="price-label">À partir de</span>
                <span class="price-value">
                  <span data-counter={service.price}>0</span>€
                </span>
                <span class="price-ht">HT</span>
              </div>
            )}
            
            <a href="/devis" class="cta-magnetic">
              <span onclick="plausible('cta_devis')" class="cta-text">Demander un devis</span>
              <span class="cta-arrow">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Section statistiques -->
  <div class="stats-section" data-lazy-animate>
    <div class="container">
      <h2 class="stats-title">Résultats Concrets</h2>
      <div class="stats-grid">
        {stats.map((stat, index) => (
          <div class="stat-card" data-index={index}>
            <div class="stat-icon">{stat.icon}</div>
            <div class="stat-number" data-counter={stat.value}>0</div>
            {stat.suffix && <div class="stat-suffix">{stat.suffix}</div>}
            <div class="stat-label">{stat.label}</div>
            <div class="stat-visual">
              <div class="stat-bar" data-progress={stat.value}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA final -->
  <div class="final-cta" data-lazy-animate>
    <div class="cta-left">
      <h2>Prêt à transformer votre activité ?</h2>
      <p>Discutons de votre projet et découvrez comment l'IA peut vous aider.</p>
      <ul class="cta-benefits">
        <li>✓ Devis gratuit sous 24-48h</li>
        <li>✓ Consultation technique offerte</li>
        <li>✓ Solutions sur mesure</li>
      </ul>
    </div>
    <div class="cta-right">
      <a href="/contact" onclick="plausible('cta_contact')" class="cta-button">
        Contactez-nous
      </a>
    </div>
  </div>
</section>

<style>
.animated-showcase {
  width: 100%;
  overflow-x: hidden;
  background: var(--color-bg);
  contain: layout style;
}

/* ===== HORIZONTAL SCROLL SECTION ===== */
.horizontal-container {
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.horizontal-wrapper {
  display: flex;
  height: 100vh;
  width: 400vw;
}

@media (max-width: 768px) {
  .horizontal-wrapper {
    width: auto;
    flex-direction: column;
    height: auto;
  }
}

.service-panel {
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 4rem;
  overflow: hidden;
  contain: layout style paint;
}

@media (max-width: 768px) {
  .service-panel {
    width: 100vw;
    height: auto;
    min-height: 100vh;
    padding: 3rem 1.5rem;
  }
}

.panel-bg {
  position: absolute;
  inset: 0;
  opacity: 0.2;
  z-index: 0;
  pointer-events: none;
}

.service-panel:nth-child(1) .panel-bg {
  background: radial-gradient(circle at 30% 50%, var(--color-primary), transparent 60%);
}

.service-panel:nth-child(2) .panel-bg {
  background: radial-gradient(circle at 70% 50%, var(--color-secondary), transparent 60%);
}

.service-panel:nth-child(3) .panel-bg {
  background: radial-gradient(circle at 50% 30%, var(--color-first), transparent 60%);
}

.service-panel:nth-child(4) .panel-bg {
  background: radial-gradient(circle at 50% 70%, var(--color-primary), transparent 60%);
}

.service-badge {
  position: absolute;
  top: 2rem;
  right: 2rem;
  background: var(--color-first);  color: var(--color-bg);
  padding: 0.5rem 1.5rem;
  border-radius: var(--radius-full);
  font-size: 0.9rem;
  font-weight: 700;
  z-index: 10;
}

.panel-content {
  max-width: 700px;
  color: var(--color-text);
  position: relative;
  z-index: 2;
  text-align: center;
}

.panel-number {
  position: absolute;
  font-size: clamp(8rem, 15vw, 12rem);
  font-weight: 900;
  color: var(--color-primary);
  opacity: 0.08;
  top: -3rem;
  left: 50%;
  transform: translateX(-50%);
  line-height: 1;
  pointer-events: none;
}

.service-icon {
  font-size: clamp(4rem, 8vw, 6rem);
  margin-bottom: 2rem;
  display: inline-block;
  filter: drop-shadow(0 0 20px var(--color-primary));
}

.service-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  margin-bottom: 1.5rem;
  color: var(--color-gray-100);
  line-height: 1.2;
}

.service-description {
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  line-height: 1.7;
  opacity: 0.9;
  margin-bottom: 2.5rem;
  color: var(--color-gray-300);
}

.service-features {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
  margin-bottom: 2.5rem;
}

.feature-tag {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: var(--glass-bg);
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-full);
  font-size: 0.95rem;
  font-weight: 600;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.feature-tag:hover {
  background: var(--color-primary);
  color: var(--color-bg);
  transform: translateY(-2px);
}

.tag-dot {
  width: 6px;
  height: 6px;
  background: var(--color-secondary);
  border-radius: var(--radius-xl);
}

.service-price {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 2rem;
}

.price-label {
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  opacity: 0.7;
}

.price-value {
  font-size: 3rem;
  font-weight: 800;
  color: var(--color-first);
  line-height: 1;
}

.price-ht {
  font-size: 1rem;
  opacity: 0.6;
}

.cta-magnetic {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem 2.5rem;
  background: var(--color-primary);  color: var(--color-bg);
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 1.1rem;
  text-decoration: none;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  box-shadow: var(--shadow-lg);
}

.cta-magnetic:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-glow-hover);
}

.cta-arrow {
  font-size: 1.5rem;
  transition: transform 0.3s ease;
}

.cta-magnetic:hover .cta-arrow {
  transform: translateX(5px);
}

/* ===== STATS SECTION ===== */
.stats-section {
  padding: 8rem 2rem;
  position: relative;
  contain: layout style;
}

@media (max-width: 768px) {
  .stats-section {
    padding: 4rem 1.5rem;
  }
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.stats-title {
  text-align: center;
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: var(--color-primary-light);
  margin-bottom: 4rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2.5rem;
}

.stat-card {
  background: var(--glass-bg);
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-xl);
  padding: 3rem 2rem;
  text-align: center;
  backdrop-filter: blur(20px);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-10px);
  box-shadow: var(--shadow-glow-hover);
}

.stat-icon {
  font-size: 3rem;
  margin-bottom: 1.5rem;
}

.stat-number {
  font-size: 4.5rem;
  font-weight: 900;
  color: var(--color-first);
  line-height: 1;
}

.stat-suffix {
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--color-first);
  opacity: 0.8;
  display: inline;
}

.stat-label {
  font-size: 1.1rem;
  color: var(--color-gray-300);
  opacity: 0.9;
  margin: 1rem 0 1.5rem;
  font-weight: 600;
}

.stat-visual {
  width: 100%;
  height: 6px;
  background: var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.stat-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
  border-radius: var(--radius-lg);
  width: 0;
  transition: width 1.5s cubic-bezier(0.65, 0, 0.35, 1);
}

/* ===== FINAL CTA ===== */
.final-cta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  padding: 8rem 4rem;
  background: var(--color-bg);
}

@media (max-width: 1024px) {
  .final-cta {
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 4rem 2rem;
    text-align: center;
  }
}

.cta-left h2 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: var(--color-gray-50);
  margin-bottom: 1.5rem;
  line-height: 1.2;
}

.cta-left p {
  font-size: 1.3rem;
  color: var(--color-gray-50);
  opacity: 0.9;
  line-height: 1.7;
  margin-bottom: 2rem;
}

.cta-benefits {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.cta-benefits li {
  font-size: 1.1rem;
  color: var(--color-primary-light);
}

.cta-right {
  display: flex;
  justify-content: center;
}

.cta-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem 3rem;
  background: var(--color-primary);  color: var(--color-bg);
  font-size: 1.3rem;
  font-weight: 700;
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  box-shadow: var(--shadow-lg);
}

.cta-button:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-glow-hover);
}
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { 
    LazyAnimationObserver,
    shouldReduceAnimations,
    rafThrottle,
  } from '@/animations/utils/performance-utils';

  gsap.registerPlugin(ScrollTrigger);

  const shouldReduce = shouldReduceAnimations();

  if (!shouldReduce) {
    const lazyObserver = new LazyAnimationObserver({ rootMargin: '100px' });

    // ===== HORIZONTAL SCROLL (Desktop only) =====
    const container = document.querySelector<HTMLElement>('[data-horizontal-section]');
    const wrapper = container?.querySelector<HTMLElement>('.horizontal-wrapper');
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.service-panel'));

    if (container && wrapper && panels.length && window.innerWidth > 768) {
      gsap.to(panels, {
        xPercent: -100 * (panels.length - 1),
        ease: 'none',
        scrollTrigger: {
          trigger: container,
          pin: true,
          scrub: 0.5, // Réduit de 1 à 0.5 pour plus de fluidité
          snap: {
            snapTo: 1 / (panels.length - 1),
            duration: { min: 0.1, max: 0.3 }
          },
          end: () => `+=${wrapper.offsetWidth - window.innerWidth}`,
          invalidateOnRefresh: true,
        },
      });
    }

    // ===== LAZY ANIMATIONS =====
    document.querySelectorAll<HTMLElement>('[data-lazy-animate]').forEach((el) => {
      lazyObserver.observe(el, () => {
        gsap.from(el, {
          opacity: 0,
          y: 50,
          duration: 0.8,
          ease: 'power2.out',
        });
      });
    });

    // ===== COUNTER ANIMATION =====
    const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
    counters.forEach((counter) => {
      const target = parseInt(counter.dataset['counter'] ?? counter.textContent ?? '0', 10);
      const obj = { value: 0 };

      lazyObserver.observe(counter, () => {
        gsap.to(obj, {
          value: target,
          duration: 1.5,
          ease: 'power2.out',
          onUpdate: () => {
            counter.textContent = Math.round(obj.value).toString();
          },
        });
      });
    });

    // ===== PROGRESS BARS =====
    const bars = document.querySelectorAll<HTMLElement>('[data-progress]');
    bars.forEach((bar) => {
      const progress = parseInt(bar.dataset['progress'] ?? '0', 10);
      
      lazyObserver.observe(bar, () => {
        bar.style.width = `${progress}%`;
      });
    });

    // ===== MAGNETIC BUTTONS (Optimized) =====
    const magneticBtns = document.querySelectorAll<HTMLElement>('.cta-magnetic, .cta-button');
    magneticBtns.forEach((btn) => {
      let mouseMoveHandler: ((e: MouseEvent) => void) | null = null;

      const handleMouseMove = rafThrottle((e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        gsap.to(btn, {
          x: x * 0.15,
          y: y * 0.15,
          duration: 0.3,
          ease: 'power2.out',
        });
      });

      btn.addEventListener('mouseenter', () => {
        mouseMoveHandler = handleMouseMove;
        btn.addEventListener('mousemove', handleMouseMove);
      });

      btn.addEventListener('mouseleave', () => {
        if (mouseMoveHandler) {
          btn.removeEventListener('mousemove', mouseMoveHandler);
          mouseMoveHandler = null;
        }
        gsap.to(btn, {
          x: 0,
          y: 0,
          duration: 0.4,
          ease: 'power2.out',
        });
      });
    });

    // Cleanup
    document.addEventListener('astro:before-preparation', () => {
      lazyObserver.disconnect();
      ScrollTrigger.getAll().forEach((st) => st.kill());
    });
  }
</script>