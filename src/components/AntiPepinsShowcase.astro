---
// src/components/AntiPepinsShowcase.astro
// Mise en avant d'Anti Pepins (pilier 4). Bloc dedie sur la home.

const arnaques = [
  'Phishing bancaire',
  'Smishing de livraison',
  'Faux support Microsoft',
  'Fausse offre d\'emploi',
  'Arnaque au president',
  'Hameconnage sentimental',
];
---

<section class="ap-section" aria-labelledby="ap-title">
  <div class="ap-inner">
    <div class="ap-content">
      <p class="ap-eyebrow">Pilier 4 - Service public</p>
      <h2 id="ap-title">Anti Pepins : votre garde-fou contre les arnaques</h2>
      <p class="ap-lead">
        Un SMS douteux, un mail suspect, un lien inconnu : <strong>collez-le dans Anti Pepins</strong>, on vous dit en quelques secondes s'il s'agit d'une arnaque. Gratuit, anonyme, sans inscription.
      </p>

      <div class="ap-types">
        <span class="ap-types-label">Anti Pepins detecte :</span>
        <ul>
          {arnaques.map((a) => <li>{a}</li>)}
        </ul>
      </div>

      <div class="ap-trust">
        <div class="ap-trust-item">
          <span class="ap-trust-num">100%</span>
          <span class="ap-trust-label">Gratuit, sans pub, sans inscription</span>
        </div>
        <div class="ap-trust-item">
          <span class="ap-trust-num">0</span>
          <span class="ap-trust-label">Donnee stockee ou revendue</span>
        </div>
        <div class="ap-trust-item">
          <span class="ap-trust-num">5s</span>
          <span class="ap-trust-label">Temps moyen d'analyse</span>
        </div>
      </div>

      <div class="ap-actions">
        <a href="https://anti-pepins.biscuits-ia.com/" class="ap-btn-primary" rel="noopener noreferrer" target="_blank">
          Ouvrir Anti Pepins
          <span class="ap-ext" aria-hidden="true">↗</span>
        </a>
        <a href="/anti-pepins" class="ap-btn-ghost">En savoir plus</a>
      </div>
    </div>
  </div>
</section>

<style>
  .ap-section {
    padding: 5rem 1.5rem;
    background: linear-gradient(135deg, var(--color-accent-caramel) 0%, var(--color-secondary) 100%);
    color: var(--color-text);
    position: relative;
    overflow: hidden;
  }

  .ap-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(255, 255, 255, 0.05) 40px, rgba(255, 255, 255, 0.05) 80px);
    pointer-events: none;
  }

  .ap-inner {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
  }

  .ap-eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-bg-alt);
    background: rgba(0, 0, 0, 0.2);
    padding: 0.3rem 0.75rem;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .ap-content h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 900;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .ap-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
    max-width: 720px;
  }

  .ap-lead strong {
    text-decoration: underline;
  }

  .ap-types {
    margin: 0 0 1.5rem;
  }

  .ap-types-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text);
    opacity: 0.8;
    margin-bottom: 0.75rem;
  }

  .ap-types ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ap-types li {
    padding: 0.4rem 0.85rem;
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .ap-trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
    gap: 1rem;
    margin: 0 0 2rem;
    max-width: 720px;
  }

  .ap-trust-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.6);
    border: 2px solid var(--color-border);
  }

  .ap-trust-num {
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--color-text);
    line-height: 1;
  }

  .ap-trust-label {
    font-size: 0.85rem;
    color: var(--color-text);
    opacity: 0.85;
  }

  .ap-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ap-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.95rem 1.75rem;
    background: var(--color-text);
    color: var(--color-bg-alt);
    font-weight: 800;
    font-size: 1rem;
    border: 2px solid var(--color-border);
    text-decoration: none;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .ap-btn-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.3);
    color: var(--color-bg-alt);
  }

  .ap-ext {
    font-size: 0.85em;
  }

  .ap-btn-ghost {
    display: inline-block;
    padding: 0.95rem 1.75rem;
    background: transparent;
    color: var(--color-text);
    font-weight: 700;
    border: 2px solid var(--color-text);
    text-decoration: none;
  }

  .ap-btn-ghost:hover {
    background: rgba(0, 0, 0, 0.05);
  }
</style>