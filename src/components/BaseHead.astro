---
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';

export interface Props {
  fullTitle: string;
  description: string;
  fullCanonical: string;
  siteUrl: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: {
    type: 'Organization' | 'Service' | 'FAQPage' | 'Article' | 'WebPage' | 'HowTo';
    data?: Record<string, any>;
  };
  isProd: boolean;
  nonce?: string;
}

const {
  fullTitle,
  description,
  fullCanonical,
  siteUrl,
  ogImage = '/og-default.webp',
  ogType = 'website',
  schema,
  isProd,
  nonce,
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

<slot />

<!--
  Preconnect GTM : ne se declenche qu'APRES consentement analytics.
  Sans opt-in, aucun prechauffage TCP/TLS vers Google n'est emis
  (RGPD / CNIL deliberation n 2020-091).
  Le handshake est ajoute dynamiquement par le loader ci-dessous.
-->
{isProd && (
  <script is:inline nonce={nonce}>
    if (window.location.hostname === 'biscuits-ia.com') {
      window.__PARTYTOWN_CONFIG = {
        skipDeprecatedAPIs: true,
      };
    }
  </script>
)}

<SEOHead
  title={fullTitle}
  description={description}
  canonical={fullCanonical}
  ogImage={ogImage}
  ogType={ogType}
/>

{schema && <SchemaOrg type={schema.type} data={schema.data} />}

{!schema && (
  <>
    <SchemaOrg type="Organization" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "url": fullCanonical,
      "name": fullTitle,
      "description": description,
      "inLanguage": "fr-FR",
      "isPartOf": {
        "@type": "WebSite",
        "url": siteUrl,
        "name": "Biscuits IA"
      }
    })} />
  </>
)}

<!-- Favicons optimises (format moderne) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<!--
  Fonts : preconnect + load asynchrone pour ne pas bloquer le render (Lighthouse).
  Le swap `media=print` + onload evite que la feuille de style Google Fonts bloque le FCP.
  font-display:swap est deja dans la query string (deja inclus).
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  id="font-zalando"
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Zalando+Sans+SemiExpanded:ital,wght@0,200..900;1,200..900&display=swap"
  media="print"
>
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zalando+Sans+SemiExpanded:ital,wght@0,200..900;1,200..900&display=swap">
</noscript>

<script is:inline nonce={nonce}>
  var fontLink = document.getElementById('font-zalando');
  if (fontLink) fontLink.addEventListener('load', function () { fontLink.media = 'all'; }, { once: true });
</script>
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zalando+Sans+SemiExpanded:ital,wght@0,200..900;1,200..900&display=swap">
</noscript>

{isProd && (
  <script is:inline nonce={nonce}>
    // Definition du dataLayer pour GTM (charge dynamiquement par CookieConsent)
    window.dataLayer = window.dataLayer || [];

    // Cooldown pour eviter le spam de tentatives si le reseau est instable
    // ou si un bloqueur de pub rejette systematiquement la requete.
    const GTM_RETRY_COOLDOWN_MS = 30000;

    // Kill-switch runtime (utile en preprod / debug).
    // Active via la variable d'env PUBLIC_ANALYTICS_DISABLED exposee par le Layout.
    if (!window.__ANALYTICS_DISABLED__) {
      // Fonction pour charger GTM (appelee par CookieConsent quand analytics accepte)
      window.loadGTMIfConsented = () => {
        if (window.gtmLoaded) return;
        const consentStr = localStorage.getItem('cookie-consent');
        if (!consentStr) return;
        let prefs;
        try {
          prefs = JSON.parse(consentStr);
        } catch (e) {
          return;
        }
        if (!prefs || !prefs.analytics) return;
        window.gtmLoaded = true;
        try { window.addGTMPreconnectIfConsented?.(); } catch (e) {}
        const script = document.createElement('script');
        script.async = true;
        script.dataset.gtmLoader = '1';
        script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-W2273TRX';
        // Erreur silencieuse : un blocage reseau / bloqueur n'est pas une
        // erreur applicative. On log uniquement en mode debug.
        script.addEventListener('error', () => {
          window.gtmLoaded = false;
          if (window.__GTM_DEBUG__ === true) {
            console.info('[GTM] load failed (likely blocked or offline)');
          }
          window.setTimeout(() => { window.gtmLoaded = false; }, GTM_RETRY_COOLDOWN_MS);
        }, { once: true });
        try {
          document.head.appendChild(script);
        } catch (e) {
          // DOM indisponible (page unload, sandbox) : on libere l'etat.
          window.gtmLoaded = false;
        }
      };

      // Ecouter les mises a jour de consentement
      window.addEventListener('cookieConsentUpdated', (e) => {
        if (e.detail.analytics) window.loadGTMIfConsented();
      });

      // Charger GTM si deja accepte au chargement
      if (typeof localStorage !== 'undefined') {
        window.loadGTMIfConsented();
      }
    }
  </script>
)}