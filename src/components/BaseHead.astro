---
// ============================================================================
// BaseHead : tout le <head> commun.
//
// NB : les commentaires `<!-- -->` sont EMIS dans le HTML final (x129 pages).
// Toute explication longue va donc ici, dans le frontmatter, jamais dans le
// template.
//
// ── Polices ─────────────────────────────────────────────────────────────────
// Inter est self-hostee via @fontsource-variable/inter, importee par global.css.
// Aucun <link>, aucun preconnect vers Google : zero requete tierce, aucune IP
// transmise avant consentement.
//
// Supprime le 2026-07-08 :
//   - 3 <link> vers "Zalando Sans SemiExpanded" : police variable (200..900,
//     roman + italique) telechargee sur chaque page, referencee par AUCUNE
//     regle `font-family` du projet ;
//   - le hack `media="print"` + onload qui l'accompagnait ;
//   - <meta http-equiv="X-Content-Type-Options"> : sans effet en HTML, seul le
//     header HTTP compte (deja pose par vercel.json) ;
//   - le bloc `window.__PARTYTOWN_CONFIG` : Partytown n'a jamais ete une
//     dependance du projet.
//
// ── GTM ─────────────────────────────────────────────────────────────────────
// Le loader ne se declenche qu'APRES consentement analytics (RGPD / CNIL
// deliberation n 2020-091). Aucun prechauffage TCP/TLS vers Google sans opt-in.
// Il teste `!window.__ANALYTICS_DISABLED__`, flag pose par Layout.astro dans le
// <slot /> ci-dessous -- donc AVANT ce script. Ne pas reordonner.
//
// L'ID vient de GTM_ID (P4 #40). S'il est absent, tout le bloc est omis : le
// consommateur (CookieConsent.astro) teste `typeof loadGTMIfConsented ===
// 'function'` avant d'appeler, donc aucun analytics == aucune erreur.
// `is:inline` emet le script verbatim -- les {expressions} n'y sont pas
// evaluees --, d'ou le passage par `define:vars`.
// ============================================================================
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';
import { jsonLd, jsonIsland } from '@/lib/jsonLd';

export interface Props {
  fullTitle: string;
  description: string;
  fullCanonical: string;
  siteUrl: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: {
    type: 'Organization' | 'NGO' | 'Service' | 'FAQPage' | 'Article' | 'WebPage' | 'HowTo' | 'Course' | 'Product' | 'ContactPage';
    data?: Record<string, any>;
  };
  isProd: boolean;
  nonce?: string;
}

const {
  fullTitle,
  description,
  fullCanonical,
  siteUrl,
  ogImage = '/og-default.webp',
  ogType = 'website',
  schema,
  isProd,
  nonce,
} = Astro.props;

const gtmId = (import.meta.env.GTM_ID ?? '').trim();
const gtmEnabled = isProd && gtmId.length > 0;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

<slot />

<SEOHead
  title={fullTitle}
  description={description}
  canonical={fullCanonical}
  ogImage={ogImage}
  ogType={ogType}
/>

{schema && <SchemaOrg type={schema.type} data={schema.data} />}

{!schema && (
  <>
    <SchemaOrg type="Organization" />
    <script is:inline type="application/ld+json" set:html={jsonLd({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "url": fullCanonical,
      "name": fullTitle,
      "description": description,
      "inLanguage": "fr-FR",
      "isPartOf": {
        "@type": "WebSite",
        "url": siteUrl,
        "name": "Biscuits IA"
      }
    })} />
  </>
)}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="alternate" type="text/markdown" href="/llms.txt" title="llms.txt" />

<meta name="referrer" content="strict-origin-when-cross-origin" />

{gtmEnabled && (
  <>
  {/* `define:vars` fait perdre l'attribut nonce au build : le script serait
      bloque par la CSP SSR. On passe donc gtmId par un data-block JSON, non
      executable, relu par le script nonce ci-dessous. Cf. lib/jsonLd.ts. */}
  <script type="application/json" id="gtm-config" is:inline set:html={jsonIsland({ gtmId })} />
  <script is:inline nonce={nonce}>
    // IIFE : `define:vars` enveloppait deja le corps, on preserve la portee.
    (() => {
    const gtmId = JSON.parse(document.getElementById('gtm-config').textContent).gtmId;

    // Definition du dataLayer pour GTM (charge dynamiquement par CookieConsent)
    window.dataLayer = window.dataLayer || [];

    // Cooldown pour eviter le spam de tentatives si le reseau est instable
    // ou si un bloqueur de pub rejette systematiquement la requete.
    const GTM_RETRY_COOLDOWN_MS = 30000;

    // Kill-switch runtime (utile en preprod / debug).
    // Active via la variable d'env PUBLIC_ANALYTICS_DISABLED exposee par le Layout.
    if (!window.__ANALYTICS_DISABLED__) {
      // Fonction pour charger GTM (appelee par CookieConsent quand analytics accepte)
      window.loadGTMIfConsented = () => {
        if (window.gtmLoaded) return;
        const consentStr = localStorage.getItem('cookie-consent');
        if (!consentStr) return;
        let prefs;
        try {
          prefs = JSON.parse(consentStr);
        } catch (e) {
          return;
        }
        if (!prefs || !prefs.analytics) return;
        window.gtmLoaded = true;
        try { window.addGTMPreconnectIfConsented?.(); } catch (e) {}
        const script = document.createElement('script');
        script.async = true;
        script.dataset.gtmLoader = '1';
        script.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
        // Erreur silencieuse : un blocage reseau / bloqueur n'est pas une
        // erreur applicative. On log uniquement en mode debug.
        script.addEventListener('error', () => {
          window.gtmLoaded = false;
          if (window.__GTM_DEBUG__ === true) {
            console.info('[GTM] load failed (likely blocked or offline)');
          }
          window.setTimeout(() => { window.gtmLoaded = false; }, GTM_RETRY_COOLDOWN_MS);
        }, { once: true });
        try {
          document.head.appendChild(script);
        } catch (e) {
          // DOM indisponible (page unload, sandbox) : on libere l'etat.
          window.gtmLoaded = false;
        }
      };

      // Ecouter les mises a jour de consentement
      window.addEventListener('cookieConsentUpdated', (e) => {
        if (e.detail.analytics) window.loadGTMIfConsented();
      });

      // Charger GTM si deja accepte au chargement
      if (typeof localStorage !== 'undefined') {
        window.loadGTMIfConsented();
      }
    }
    })();
  </script>
  </>
)}