---
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';

export interface Props {
  fullTitle: string;
  description: string;
  fullCanonical: string;
  siteUrl: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'Service' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, any>;
  };
  isProd: boolean;
  nonce?: string;
}

const {
  fullTitle,
  description,
  fullCanonical,
  siteUrl,
  ogImage = '/og-default.webp',
  ogType = 'website',
  noindex = false,
  schema,
  isProd,
  nonce,
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

<slot />

<!--
  Preconnect GTM : ne se déclenche qu'APRÆS consentement analytics.
  Sans opt-in, aucun préchauffage TCP/TLS vers Google n'est émis
  (RGPD / CNIL délibération nÂ°2020-091).
  Le handshake est ajouté dynamiquement par le loader ci-dessous.
-->
{isProd && (
  <script is:inline nonce={nonce}>
    window.addGTMPreconnectIfConsented = () => {
      if (document.querySelector('link[data-gtm-preconnect]')) return;
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = 'https://www.googletagmanager.com';
      link.crossOrigin = 'anonymous';
      link.dataset.gtmPreconnect = '1';
      document.head.appendChild(link);
    };
  </script>
)}

<SEOHead 
  title={fullTitle}
  description={description}
  canonical={fullCanonical}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
/>

{schema && <SchemaOrg type={schema.type} data={schema.data} />}

{!schema && (
  <>
    <SchemaOrg type="Organization" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "url": fullCanonical,
      "name": fullTitle,
      "description": description,
      "inLanguage": "fr-FR",
      "isPartOf": {
        "@type": "WebSite",
        "url": siteUrl,
        "name": "Biscuits IA"
      }
    })} />
  </>
)}

{isProd && (
  <script is:inline nonce={nonce}>
    if (window.location.hostname === 'biscuits-ia.com') {
      window.__PARTYTOWN_CONFIG = {
        skipDeprecatedAPIs: true,
      };
    }
  </script>
)}

<!-- Favicons optimisés (format moderne) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zalando+Sans+SemiExpanded:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">

{isProd && (
  <script is:inline nonce={nonce}>
    // Définition du dataLayer pour GTM (chargé dynamiquement par CookieConsent)
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }

    // Fonction pour charger GTM (appelée par CookieConsent quand analytics accepté)
    window.loadGTMIfConsented = () => {
      if (window.gtmLoaded) return;
      const consentStr = localStorage.getItem('cookie-consent');
      if (!consentStr) return;
      try {
        const prefs = JSON.parse(consentStr);
        if (prefs.analytics) {
          window.gtmLoaded = true;
          window.addGTMPreconnectIfConsented?.();
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-W2273TRX';
          document.head.appendChild(script);
        }
      } catch (e) {}
    };

    // →couter les mises à jour de consentement
    window.addEventListener('cookieConsentUpdated', (e) => {
      if (e.detail.analytics) window.loadGTMIfConsented();
    });

    // Charger GTM si déjà accepté au chargement
    if (typeof localStorage !== 'undefined') {
      window.loadGTMIfConsented();
    }
  </script>
)}
