---
import { jsonLd } from '@/lib/jsonLd';
// Fil d'Ariane accessible + BreadcrumbList schema (Google).
// Génère automatiquement la chaîne depuis Astro.url.pathname.
// Les libellés de segments sont surchargés via `labels` si besoin.

export interface Props {
  labels?: Record<string, string>;
  /** Affiche le fil d'Ariane en mode compact (sans `Accueil` racine). */
  compact?: boolean;
}

const { labels = {}, compact = false } = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';
const pathParts = Astro.url.pathname.split('/').filter(Boolean);

const defaultLabels: Record<string, string> = {
  blog: 'Blog',
  article: 'Articles',
  ateliers: 'Ateliers',
  formations: 'Formations',
  inscription: 'Inscription',
  combats: 'Nos combats',
  'ia-accessible': 'IA accessible',
  'ia-utile': 'IA utile',
  'plateformes-ouvertes': 'Plateformes ouvertes',
  'partage-connaissance': 'Partage des savoirs',
  'derives-numeriques': 'Défense citoyenne',
  ressources: 'Ressources',
  services: 'Services',
  contact: 'Contact',
  faq: 'FAQ',
  legal: 'Documents légaux',
  cgu: 'CGU',
  cgv: 'CGV',
  cookies: 'Politique cookies',
  exoneration: 'Places offertes',
  parrainage: 'Parrainage',
  'guide-relecture': 'Guide de relecture',
  'mentions-legales': 'Mentions légales',
  'politique-de-confidentialite': 'Politique de confidentialité',
  'a-qui-s-adresse': 'À qui ça s\'adresse',
  'cas-d-usage': 'Cas d\'usage',
  auteur: 'Auteurs',
  'nos-missions': 'Nos missions',
  'pourquoi-biscuits-ia': 'Pourquoi Biscuits IA',
  pourquoi: 'Pourquoi Biscuits IA',
  'projects-collaboratif': 'Projets collaboratifs',
  'rejoignez-nous': 'Nous rejoindre',
  trombinoscope: 'Notre équipe',
  'charte-ethique': 'Charte éthique',
  utilisateurs: 'Utilisateurs',
  ...labels,
};

const crumbs = compact ? [] : [{ label: 'Accueil', href: '/' }];
let acc = '';
for (const part of pathParts) {
  acc += `/${part}`;
  const label = defaultLabels[part] ?? part.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  crumbs.push({ label, href: acc });
}

// Retire le dernier crumb (page courante) sauf s'il y en a plus de 2.

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: `${siteUrl}${c.href}`,
  })),
};
---

{crumbs.length > 1 && (
  <>
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <ol>
        {crumbs.map((c, i) => (
          <li>
            {i < crumbs.length - 1 ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span aria-current="page">{c.label}</span>
            )}
            <span class="sep" aria-hidden="true">›</span>
          </li>
        ))}
      </ol>
    </nav>
    <script type="application/ld+json" set:html={jsonLd(schema)} is:inline />
  </>
)}

<style>
  .breadcrumb {
    max-width: var(--container-xl, 1200px);
    margin: 0 auto;
    /* Header en position fixed (cf. Header.astro) : sans cet offset, le fil
       d'Ariane se rend sous le header et devient invisible/inaccessible a la
       souris, bien qu'il reste dans le DOM (lu par les lecteurs d'ecran). */
    padding: calc(var(--header-height-desktop, 80px) + 1rem) 1rem 0;
    font-size: 0.875rem;
    color: var(--color-text-light);
  }
  @media (max-width: 768px) {
    .breadcrumb {
      padding-top: calc(var(--header-height-mobile, 70px) + 1rem);
    }
  }
  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }
  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .breadcrumb a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span[aria-current] {
    color: var(--color-text);
    font-weight: 600;
  }
  .sep {
    color: var(--color-border);
    margin-left: 0.15rem;
  }
</style>