---
import { jsonLd } from '@/lib/jsonLd';
// src/components/Citation.astro
// ----------------------------------------------------------------------------
// Composant Citation : affiche une source/expertise de maniere visible pour
// l'utilisateur ET injecte le schema Quotation + Claim correspondant pour les
// LLM. C'est un signal E-E-A-T fort (les LLM deweight fortement le contenu
// sans sources).
//
// Utilisation :
//   <Citation
//     source="CNIL - Delib. n 2020-091"
//     author="Commission Nationale Informatique et Liberte"
//     date="2020-09-17"
//     url="https://www.cnil.fr/fr/cookies-et-autres-traceurs"
//     quote="Les traceurs ne peuvent etre deposes sans consentement prealable."
//   />
// ============================================================================

export interface Props {
  /** Texte de la citation (optionnel). Si absent, on cite juste la source. */
  quote?: string;
  /** Source / document de reference (ex: "CNIL - Delib. n 2020-091"). */
  source: string;
  /** Auteur / organisation qui a emis la source. */
  author: string;
  /** Date de la source au format ISO 8601. */
  date: string;
  /** URL de la source (optionnel mais recommande pour E-E-A-T). */
  url?: string;
  /** Variante visuelle : inline (texte) ou block (encadre). */
  variant?: 'inline' | 'block';
}

const { quote, source, author, date, url, variant = 'block' } = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';

// Schema Quotation (pour le texte cite) + schema Claim (pour la source)
// Les deux ensemble = signal E-E-A-T maximal pour les LLM.
const quotationSchema = quote ? {
  '@context': 'https://schema.org',
  '@type': 'Quotation',
  'isPartOf': url ? { '@id': url } : undefined,
  'spokenByCharacter': {
    '@type': 'Organization',
    'name': author,
    'url': url,
  },
  'text': quote,
} : null;
---

{variant === 'block' ? (
  <aside class="citation-block" role="note" aria-label="Source">
    {quote && <p class="citation-quote">&laquo; {quote} &raquo;</p>}
    <p class="citation-meta">
      <span class="citation-source">Source : <strong>{source}</strong></span>
      {author && <span class="citation-author"> &mdash; {author}</span>}
      {date && <span class="citation-date"> ({date})</span>}
      {url && (
        <>
          {' '}
          <a class="citation-url" href={url} rel="noopener external" target="_blank">
            [lire en ligne]
          </a>
        </>
      )}
    </p>
  </aside>
) : (
  <span class="citation-inline">
    {quote && <q>{quote}</q>}
    {quote ? ' ' : ''}
    (<span class="citation-source-inline">{source}, {author}, {date}</span>{url ? <a class="citation-url" href={url} rel="noopener external" target="_blank"> [lien]</a> : null})
  </span>
)}

{quotationSchema && (
  <script
    is:inline
    type="application/ld+json"
    set:html={jsonLd(quotationSchema)}
  />
)}

<style>
  .citation-block {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-primary, #faca6f);
    background: var(--color-bg-elevated, #fdfaf3);
    border: 2px solid var(--color-border, #2a2424);
    border-left-width: 6px;
    box-shadow: 2px 2px 0 var(--color-border, #2a2424);
  }
  .citation-quote {
    margin: 0 0 0.5rem;
    font-style: italic;
    color: var(--color-text, #2a2424);
    line-height: 1.55;
  }
  .citation-meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-light, #5c3a1a);
  }
  .citation-source strong { color: var(--color-text, #2a2424); }
  .citation-author, .citation-date { color: var(--color-text-light, #5c3a1a); }
  .citation-url {
    color: var(--color-primary-dark, #c98a2a);
    text-decoration: underline;
    font-weight: 600;
  }
  .citation-inline {
    font-size: 0.92em;
    color: var(--color-text-light, #5c3a1a);
  }
  .citation-source-inline {
    font-style: italic;
  }
</style>
