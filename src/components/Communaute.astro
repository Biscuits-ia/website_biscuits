---
// Composant Communauté : lien Discord, FAQ collaborative, badges bénévoles
const badges = [
  { nom: "Contributeur", icon: "🌱", description: "A participé à au moins un projet ou atelier" },
  { nom: "Ambassadeur IA", icon: "🤖", description: "A partagé ses connaissances IA avec la communauté" },
  { nom: "Bénévole actif", icon: "⚡", description: "Bénévole régulier depuis plus de 3 mois" },
  { nom: "Expert RGPD", icon: "🔒", description: "A aidé au moins 5 structures à se mettre en conformité" },
];
---
<section class="communaute-section">
  <div class="communaute-inner">
    <h2>Rejoignez notre communauté</h2>
    <p class="communaute-desc">Échangez avec des bénévoles, posez vos questions, partagez vos expériences et contribuez à une IA éthique et solidaire.</p>

    <div class="communaute-links">
      <a href="/faq" class="communaute-card">
        <span class="communaute-icon">❓</span>
        <span>FAQ Collaborative</span>
      </a>
      <a href="/rejoignez-nous" class="communaute-card">
        <span class="communaute-icon">🤝</span>
        <span>Devenir bénévole</span>
      </a>
    </div>

    <h3 class="badges-title">Badges de la communauté</h3>
    <div class="badges-grid">
      {badges.map((badge) => (
        <div class="badge-card">
          <span class="badge-icon">{badge.icon}</span>
          <strong>{badge.nom}</strong>
          <p>{badge.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.communaute-section {
  background: linear-gradient(135deg, var(--color-bg-elevated), var(--color-bg-alt));
  padding: 4rem 1rem;
}
.communaute-inner {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}
.communaute-inner h2 {
  font-size: 2rem;
  color: var(--color-primary);
  margin-bottom: 0.75rem;
}
.communaute-desc {
  color: var(--color-text-light);
  max-width: 550px;
  margin: 0 auto 2rem;
}
.communaute-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;
  justify-content: center;
  margin-bottom: 3rem;
}
.communaute-card {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: var(--color-bg-elevated);
  border-radius: 1rem;
  box-shadow: var(--shadow-sm);
  border: 2px solid var(--color-border-second);
  padding: 1rem 2rem;
  font-weight: 600;
  text-decoration: none;
  color: var(--color-text);
  transition: transform 0.15s, box-shadow 0.15s;
}
.communaute-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}
.communaute-discord {
  background: var(--color-primary);
  color: var(--color-bg-elevated);
  border-color: var(--color-primary);
}
.communaute-icon { font-size: 1.5rem; }
.badges-title {
  font-size: 1.5rem;
  color: var(--color-secondary);
  margin-bottom: 1.25rem;
}
.badges-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.25rem;
}
.badge-card {
  background: var(--color-bg-elevated);
  border-radius: 1rem;
  padding: 1.5rem 1rem;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border-second);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}
.badge-icon { font-size: 2.25rem; }
.badge-card p { font-size: 0.85rem; color: var(--color-text-light); }
</style>
