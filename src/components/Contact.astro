---
import BaseLayout from '@layouts/Layout.astro';
import ContactForm from '@/components/svelte/ContactForm.svelte';
import NewsletterForm from '@/components/svelte/NewsletterForm.svelte';

import '@/styles/global.css'
---

<BaseLayout
  title="Contact | Biscuits IA"
  description="Contactez-nous pour vos besoins en IA et automatisation. Réponse garantie sous 48h."
>
  <section class="contact-hero">
    <div class="container">
      <h1>Contactez-nous</h1>
      <p class="lead">
        Une question ? Un projet ? Nous sommes là pour vous aider. 
        Réponse garantie sous 48h.
      </p>
    </div>
  </section>

  <section class="contact-content">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-section">
          <h2>Remplissez ce formulaire et nous vous répondrons dans les plus brefs délais.</h2>
          <!-- ✅ AJOUT DE client:load -->
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>

  <section class="contact-faq">
    <div class="container">
      <h2>Questions Fréquentes</h2>
      
      <div class="faq-grid">
        <details class="faq-item">
          <summary>Combien de temps pour recevoir une réponse ?</summary>
          <p>
            Nous nous engageons à vous répondre sous 48h ouvrées maximum. 
            Pour les urgences, appelez-nous directement au téléphone.
          </p>
        </details>

        <details class="faq-item">
          <summary>Le devis est-il vraiment gratuit ?</summary>
          <p>
            Oui, absolument ! Le devis et le diagnostic sont 100% gratuits et sans engagement. 
            Vous ne payez que si vous acceptez notre proposition.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="newsletter-section">
    <div class="container">
      <NewsletterForm client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero { 
    color: var(--color-bg);
    padding: var(--spacing-4xl) 0;
    text-align: center;
  }

  .contact-hero h1 {
    font-size: var(--font-size-5xl);
    margin-bottom: var(--spacing-md);
    color: var(--color-bg);
  }

  .lead {
    font-size: var(--font-size-xl);
    opacity: 0.95;
    color: var(--color-gray-50);
    max-width: 700px;
    margin: 0 auto;
  }

  .contact-content {
    padding: var(--spacing-4xl) 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-form-section h2 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    color: var(--color-text);
  }

  .contact-faq {
    padding: var(--spacing-4xl) 0;
    background: var(--color-bg-alt);
  }

  .contact-faq h2 {
    text-align: center;
    font-size: var(--font-size-3xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--spacing-2xl);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-lg);
    margin-top: var(--spacing-2xl);
  }

  .faq-item {
    background: var(--color-bg);
    padding: var(--spacing-lg);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-primary);
    transition: all var(--transition-base);
  }

  .faq-item:hover {
    transform: translateX(5px);
    box-shadow: var(--shadow-md);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    list-style: none;
    transition: color var(--transition-fast);
  }

  .faq-item summary:hover {
    color: var(--color-primary);
  }

  .faq-item summary::marker {
    display: none;
  }

  .faq-item summary::before {
    content: '▶';
    display: inline-block;
    margin-right: var(--spacing-sm);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] summary::before {
    transform: rotate(90deg);
  }

  .faq-item p {
    margin-top: var(--spacing-md);
    color: var(--color-text-light);
    line-height: 1.7;
  }

  .newsletter-section {
    padding: var(--spacing-4xl) 0;
  }

  @media (max-width: 768px) {
    .contact-hero h1 {
      font-size: var(--font-size-3xl);
    }

    .lead {
      font-size: var(--font-size-lg);
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>