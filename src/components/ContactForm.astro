---
// src/components/ContactForm.astro
import TurnstileWidget from './react/TurnstileWidget';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="contact-form-wrapper">

  <div id="cf-success" class="cf-alert cf-alert--success" role="status" aria-live="polite" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
      <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
    </svg>
    <span>Votre demande a été envoyée avec succès ! Nous vous répondrons dans les plus brefs délais.</span>
  </div>

  <div id="cf-error" class="cf-alert cf-alert--error" role="alert" aria-live="assertive" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none"/>
      <path d="M12 8v4m0 4h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <span id="cf-error-text"></span>
  </div>

  <form id="cf-form" class="cf-form" novalidate aria-label="Formulaire de contact">

    <div class="cf-row">
      <div class="cf-field" id="cf-field-name">
        <label class="cf-label" for="cf-name">Nom <span class="cf-required">*</span></label>
        <input id="cf-name" name="name" type="text" class="cf-input"
          placeholder="Nom" maxlength="100" autocomplete="name"
          aria-required="true" aria-invalid="false" />
        <span id="cf-name-error" class="cf-error" role="alert" hidden></span>
      </div>

      <div class="cf-field" id="cf-field-email">
        <label class="cf-label" for="cf-email">Email <span class="cf-required">*</span></label>
        <input id="cf-email" name="email" type="email" class="cf-input"
          placeholder="contact@exemple.fr" maxlength="255" autocomplete="email"
          aria-required="true" aria-invalid="false" />
        <span id="cf-email-error" class="cf-error" role="alert" hidden></span>
      </div>
    </div>

    <div class="cf-field" id="cf-field-sujet">
      <label class="cf-label" for="cf-sujet">Sujet <span class="cf-required">*</span></label>
      <input id="cf-sujet" name="sujet" type="text" class="cf-input"
        placeholder="Sujet de votre message" maxlength="150"
        aria-required="true" aria-invalid="false" />
      <span id="cf-sujet-error" class="cf-error" role="alert" hidden></span>
    </div>

    <div class="cf-field" id="cf-field-message">
      <label class="cf-label" for="cf-message">Votre message <span class="cf-required">*</span></label>
      <textarea id="cf-message" name="message" class="cf-input cf-textarea"
        rows="5" placeholder="Décrivez votre demande…"
        minlength="20" maxlength="2000"
        aria-required="true" aria-invalid="false"
        aria-describedby="cf-char-count"></textarea>
      <span id="cf-char-count" class="cf-char-count" aria-live="polite">0 / 2000</span>
      <span id="cf-message-error" class="cf-error" role="alert" hidden></span>
    </div>

    <input type="text" name="honey" id="cf-honey"
      tabindex="-1" autocomplete="off" class="cf-honeypot" aria-hidden="true" />

    {turnstileSiteKey && (
      <div class="cf-turnstile" id="cf-turnstile-container">
        <TurnstileWidget client:load onSuccess={() => {}} />
        <span id="cf-turnstile-error" class="cf-error" role="alert" hidden></span>
      </div>
    )}

    <div class="cf-footer">
      <p class="cf-note"><span aria-hidden="true">*</span> Champs obligatoires</p>
      <button id="cf-submit" type="submit" class="cf-btn" aria-busy="false">
        <span id="cf-btn-label">Envoyer ma demande</span>
        <span id="cf-btn-loader" class="cf-spinner" aria-hidden="true" hidden></span>
      </button>
    </div>

  </form>
</div>

<script>
  import '../scripts/contactFormInit.ts';
</script>

<style>
  .contact-form-wrapper { width: 100%; }

  .cf-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding-bottom: 2rem;
  }

  .cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .cf-row { grid-template-columns: 1fr; }
  }

  .cf-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cf-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-light);
  }

  .cf-required { color: var(--color-danger); }

  .cf-input {
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    color: var(--color-text);
    font-family: inherit;
    font-size: 1rem;
    width: 100%;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .cf-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .cf-input:disabled { opacity: 0.6; cursor: not-allowed; }

  .cf-textarea { resize: vertical; min-height: 140px; line-height: 1.6; }

  .cf-field--error .cf-input {
    border-color: var(--color-danger);
    background-color: var(--color-danger-light, #fff5f5);
  }

  .cf-error {
    font-size: 0.8rem;
    color: var(--color-danger);
    font-weight: 500;
  }

  .cf-char-count {
    font-size: 0.8rem;
    text-align: right;
    color: var(--color-text-light);
    transition: color 0.2s;
  }

  .cf-char-count--warn   { color: var(--color-warning, #f59e0b); }
  .cf-char-count--danger { color: var(--color-danger); }

  .cf-honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .cf-alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 1rem;
    animation: cfSlideDown 0.3s ease;
  }

  @keyframes cfSlideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cf-alert--success {
    background: var(--color-success-light, #f0fdf4);
    color: var(--color-success, #16a34a);
    border: 1px solid var(--color-success, #16a34a);
  }

  .cf-alert--error {
    background: var(--color-danger-light, #fff5f5);
    color: var(--color-danger);
    border: 1px solid var(--color-danger);
  }

  .cf-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cf-note {
    font-size: 0.8rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .cf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    background: var(--color-primary);
    color: var(--color-bg);
    font-weight: 700;
    font-size: 1rem;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s;
  }

  .cf-btn:hover:not(:disabled) { opacity: 0.9; transform: translateY(-1px); }
  .cf-btn:active:not(:disabled) { transform: translateY(0); }
  .cf-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .cf-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: cfSpin 0.6s linear infinite;
    display: inline-block;
  }

  @keyframes cfSpin { to { transform: rotate(360deg); } }
</style>