---
import { SERVICES_CONFIG, EUROPE_COUNTRIES } from "@/utils/formValidation";
---
<div class="contact-wrapper">
  <form class="contact-form" id="contact-form" novalidate data-contact-form>
    <h2 class="contact-title" data-reveal="title">Contactez-nous</h2>
    
    <div class="form-grid" data-reveal="fields">
      <!-- Nom -->
      <div class="field" data-field="name">
        <label for="name">Nom complet <span class="required">*</span></label>
        <input 
          id="name" 
          name="name" 
          type="text" 
          placeholder="Marie Dupont" 
          required 
          aria-required="true" 
          maxlength="100"
          autocomplete="name"
        />
        <span class="error-message" role="alert" aria-live="polite"></span>
      </div>

      <!-- Email -->
      <div class="field" data-field="email">
        <label for="email">Email <span class="required">*</span></label>
        <input 
          id="email" 
          name="email" 
          type="email" 
          placeholder="marie@exemple.fr" 
          required 
          aria-required="true" 
          maxlength="255"
          autocomplete="email"
        />
        <span class="error-message" role="alert" aria-live="polite"></span>
      </div>
    </div>

    <!-- Pays -->
    <div class="field" data-field="country" data-reveal="country">
      <label for="country">Pays <span class="required">*</span></label>
      <select id="country" name="country" required aria-required="true" autocomplete="country">
        <option value="">Sélectionnez votre pays…</option>
        {EUROPE_COUNTRIES.map((c) => (
          <option value={c}>{c}</option>
        ))}
      </select>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>

    <!-- Service -->
    <div class="field" data-field="service" data-reveal="service">
      <label for="service">Service souhaité <span class="required">*</span></label>
      <select id="service" name="service" required aria-required="true">
        <option value="">Sélectionnez un service…</option>
        <optgroup label="Starter Kits">
          {SERVICES_CONFIG["starter-kits"].map((s) => <option value={s}>{s}</option>)}
        </optgroup>
        <optgroup label="Solutions IA">
          {SERVICES_CONFIG["ia"].map((s) => <option value={s}>{s}</option>)}
        </optgroup>
        <optgroup label="Consulting & Coaching">
          {SERVICES_CONFIG["consulting"].map((s) => <option value={s}>{s}</option>)}
        </optgroup>
      </select>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>

    <!-- Message -->
    <div class="field" data-field="message" data-reveal="message">
      <label for="message">Décrivez votre besoin <span class="required">*</span></label>
      <textarea 
        id="message" 
        name="message" 
        placeholder="Expliquez votre projet en détail..." 
        rows="6" 
        minlength="20"
        maxlength="2000"
        required
        aria-required="true"
      ></textarea>
      <span class="char-count" aria-live="polite">0 / 2000</span>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>

    <!-- Honeypot (anti-spam) -->
    <input 
      type="text" 
      name="honey" 
      tabindex="-1" 
      autocomplete="off" 
      class="honeypot" 
      aria-hidden="true" 
    />

    <!-- Timestamp (anti-spam) -->
    <input 
      type="hidden" 
      name="timestamp" 
      id="form-timestamp"
    />

    <!-- Submit -->
    <button type="submit" id="submit-btn" class="submit-btn" data-reveal="submit">
      <span class="btn-text">Envoyer la demande</span>
      <span class="btn-loader" aria-hidden="true"></span>
    </button>

    <!-- Messages -->
    <div class="alert alert-success" id="success-message" role="status" aria-live="polite">
      <svg class="alert-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" fill="none"/>
      </svg>
      <span>Message envoyé avec succès ! Nous vous répondrons dans les plus bref delais.</span>
    </div>

    <div class="alert alert-error" id="error-message" role="alert" aria-live="assertive">
      <svg class="alert-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none" />
        <path d="M12 8v4m0 4h.01" stroke="currentColor" stroke-width="2" />
      </svg>
      <span id="error-text">Une erreur est survenue. Veuillez réessayer.</span>
    </div>
  </form>
</div>

<style>
  .contact-wrapper {
display: grid;
place-items: center;
padding: 4rem 1rem;
}
.contact-form {
width: min(100%, 48rem);
padding: 3rem;
background: var(--color-bg-alt);
border: 1px solid var(--color-border);
border-radius: var(--radius-2xl);
box-shadow: var(--shadow-2xl);
position: relative;
overflow: hidden;
}
.contact-form::before {
content: '';
position: absolute;
top: 0;
left: 0;
right: 0;
height: 3px;
background: linear-gradient(90deg, var(--color-primary), var(--color-first));
}
.contact-title {
text-align: center;
font-weight: 700;
color: var(--color-text);
margin-bottom: 2rem;
background: linear-gradient(135deg, var(--color-primary), var(--color-first));
-webkit-background-clip: text;
background-clip: text;
-webkit-text-fill-color: transparent;
}
.form-grid {
display: grid;
gap: 1.5rem;
margin-bottom: 1.5rem;
}
@media (width >= 768px) {
.form-grid {
grid-template-columns: repeat(2, 1fr);
}
}
.field {
display: flex;
flex-direction: column;
}
.field label {
font-size: 0.95rem;
font-weight: 600;
margin-bottom: 0.5rem;
color: var(--color-text-light);
}
.required {
color: var(--color-danger);
}
.field input,
.field select,
.field textarea {
padding: 1rem;
border-radius: var(--radius-lg);
background: var(--color-bg-elevated);
color: var(--color-text);
font-size: 1rem;
border: 1px solid var(--color-border);
transition: all var(--transition-fast);
}
.field input:focus,
.field select:focus,
.field textarea:focus {
outline: none;
border-color: var(--color-primary);
box-shadow: 0 0 0 3px oklch(72.218% 0.16534 47.931 / 0.1);
}
.field textarea {
resize: vertical;
min-height: 150px;
}
.field.error input,
.field.error textarea,
.field.error select {
border-color: var(--color-danger);
background-color: rgba(239, 68, 68, 0.05);
}
.error-message {
color: var(--color-danger);
font-size: 0.875rem;
margin-top: 0.5rem;
min-height: 1.25rem;
font-weight: 500;
}
.field:not(.error) .error-message {
visibility: hidden;
}
.char-count {
display: block;
margin-top: 0.5rem;
font-size: 0.875rem;
text-align: right;
color: var(--color-text-light);
transition: color var(--transition-fast);
}
.honeypot {
position: absolute !important;
left: -9999px !important;
width: 1px !important;
height: 1px !important;
opacity: 0 !important;
pointer-events: none !important;
}
.submit-btn {
position: relative;
width: 100%;
padding: 1.25rem;
background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
color: var(--color-bg);
border: none;
border-radius: var(--radius-lg);
font-size: 1.1rem;
font-weight: 600;
cursor: pointer;
transition: all var(--transition-base);
margin-top: 2rem;
box-shadow: var(--shadow-glow);
overflow: hidden;
}
.submit-btn::before {
content: '';
position: absolute;
top: 0;
left: -100%;
width: 100%;
height: 100%;
background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
transition: left 0.5s ease;
}
.submit-btn:hover:not(:disabled)::before {
left: 100%;
}
.submit-btn:hover:not(:disabled) {
transform: translateY(-2px);
box-shadow: var(--shadow-glow-hover);
}
.submit-btn:disabled {
opacity: 0.6;
cursor: not-allowed;
}
.submit-btn.loading .btn-text {
opacity: 0;
}
.btn-loader {
display: none;
position: absolute;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
width: 24px;
height: 24px;
border: 3px solid var(--color-border);
border-top-color: var(--color-text);
border-radius: 50%;
animation: spin 0.6s linear infinite;
}
.submit-btn.loading .btn-loader {
display: block;
}
@keyframes spin {
to { transform: translate(-50%, -50%) rotate(360deg); }
}
.alert {
display: none;
align-items: center;
gap: 1rem;
margin-top: 1.5rem;
padding: 1.25rem;
border-radius: var(--radius-lg);
font-size: 0.95rem;
font-weight: 500;
animation: slideDown 0.3s ease-out;
}
@keyframes slideDown {
from {
opacity: 0;
transform: translateY(-10px);
}
to {
opacity: 1;
transform: translateY(0);
}
}
.alert-icon {
width: 1.5rem;
height: 1.5rem;
flex-shrink: 0;
}
.alert-success {
background: oklch(69.588% 0.14907 162.508 / 0.1);
color: var(--color-success);
border: 1px solid var(--color-success);
}
.alert-error {
background: oklch(63.681% 0.20784 25.315 / 0.1);
color: var(--color-danger);
border: 1px solid var(--color-danger);
}
@media (max-width: 768px) {
.contact-form {
padding: 2rem 1.5rem;
}
}
</style>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { submitContact } from '@/utils/api'; // ✅ Utiliser la fonction centralisée

  gsap.registerPlugin(ScrollTrigger);

  const DEBOUNCE_DELAY = 300;
  
  // Elements
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const successMsg = document.getElementById("success-message") as HTMLDivElement;
  const errorMsg = document.getElementById("error-message") as HTMLDivElement;
  const errorText = document.getElementById("error-text") as HTMLSpanElement;
  const messageTextarea = document.getElementById("message") as HTMLTextAreaElement;
  const charCount = document.querySelector(".char-count") as HTMLSpanElement;
  const timestampInput = document.getElementById("form-timestamp") as HTMLInputElement;

  if (timestampInput) {
    timestampInput.value = Math.floor(Date.now() / 1000).toString();
  }

  // Animations
  function initFormAnimations(): void {
    const shouldReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (shouldReduce) {
      gsap.set('[data-reveal]', { opacity: 1, y: 0 });
      return;
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '[data-contact-form]',
        start: 'top 80%',
        once: true,
      },
      defaults: {
        ease: 'power3.out',
        duration: 0.8,
      },
    });

    tl.fromTo('[data-reveal="title"]',
      { opacity: 0, y: -20 },
      { opacity: 1, y: 0 }
    )
    .fromTo('[data-reveal="fields"] .field',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, stagger: 0.1 },
      '-=0.4'
    )
    .fromTo('[data-reveal="country"], [data-reveal="service"], [data-reveal="message"]',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, stagger: 0.1 },
      '-=0.4'
    )
    .fromTo('[data-reveal="submit"]',
      { opacity: 0, scale: 0.9 },
      { opacity: 1, scale: 1 },
      '-=0.3'
    );
  }

  // Validation
  const sanitizeInput = (value: string): string => {
    if (!value) return '';
    return value.trim().replace(/[<>]/g, '').slice(0, 5000);
  };

  const validateField = (name: string, value: string): string | null => {
    if (!value || value.trim() === '') {
      return 'Ce champ est obligatoire';
    }

    switch (name) {
      case 'name':
        if (value.length < 2) return 'Le nom doit contenir au moins 2 caractères';
        if (value.length > 100) return 'Le nom ne peut pas dépasser 100 caractères';
        if (!/^[a-zA-ZÀ-ÿ\s'-]+$/.test(value)) return 'Le nom contient des caractères invalides';
        break;

      case 'email':
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) return 'Email invalide';
        if (value.length > 255) return 'L\'email ne peut pas dépasser 255 caractères';
        break;

      case 'country':
        if (value.length < 2) return 'Veuillez sélectionner un pays';
        break;

      case 'service':
        if (value.length < 3) return 'Veuillez sélectionner un service';
        break;

      case 'message':
        if (value.length < 20) return 'Le message doit contenir au moins 20 caractères';
        if (value.length > 2000) return 'Le message ne peut pas dépasser 2000 caractères';
        break;
    }

    return null;
  };

  // UI helpers
  const showError = (fieldName: string, message: string): void => {
    const field = document.querySelector(`[data-field="${fieldName}"]`);
    if (!field) return;

    field.classList.add("error");
    const errorSpan = field.querySelector(".error-message");
    if (errorSpan) errorSpan.textContent = message;

    const input = field.querySelector("input, textarea, select") as HTMLInputElement;
    if (input) input.setAttribute("aria-invalid", "true");
  };

  const clearError = (fieldName: string): void => {
    const field = document.querySelector(`[data-field="${fieldName}"]`);
    if (!field) return;

    field.classList.remove("error");
    const errorSpan = field.querySelector(".error-message");
    if (errorSpan) errorSpan.textContent = "";

    const input = field.querySelector("input, textarea, select") as HTMLInputElement;
    if (input) input.removeAttribute("aria-invalid");
  };

  const clearAllErrors = (): void => {
    form.querySelectorAll('[data-field]').forEach((field) => {
      const fieldName = field.getAttribute('data-field');
      if (fieldName) clearError(fieldName);
    });
  };

  const updateCharCount = (): void => {
    const length = messageTextarea.value.length;
    charCount.textContent = `${length} / 2000`;
    
    if (length > 1900) {
      charCount.style.color = "var(--color-danger)";
    } else if (length > 1500) {
      charCount.style.color = "var(--color-warning)";
    } else {
      charCount.style.color = "";
    }
  };

  // Event listeners
  const setupFieldValidation = (): void => {
    const fields = form.querySelectorAll("input:not([type='hidden']):not(.honeypot), textarea, select");
    let debounceTimeout: number;

    fields.forEach((field) => {
      const input = field as HTMLInputElement;

      input.addEventListener("blur", () => {
        const sanitized = sanitizeInput(input.value);
        const error = validateField(input.name, sanitized);
        error ? showError(input.name, error) : clearError(input.name);
      });

      input.addEventListener("input", () => {
        clearTimeout(debounceTimeout);
        debounceTimeout = window.setTimeout(() => {
          clearError(input.name);
        }, DEBOUNCE_DELAY);
      });
    });
  };

  // Form submission
  form.addEventListener("submit", async (e: Event) => {
    e.preventDefault();

    successMsg.style.display = "none";
    errorMsg.style.display = "none";
    clearAllErrors();

    const formData = new FormData(form);
    
    // Construction des données
    const data = {
      name: sanitizeInput(formData.get("name") as string),
      email: sanitizeInput(formData.get("email") as string),
      country: sanitizeInput(formData.get("country") as string),
      service: sanitizeInput(formData.get("service") as string),
      message: sanitizeInput(formData.get("message") as string),
      honey: formData.get("honey") as string || '',
      timestamp: parseInt(formData.get("timestamp") as string || '0'),
    };

    // Validation côté client
    let hasErrors = false;
    const fieldsToValidate = ['name', 'email', 'country', 'service', 'message'] as const;
    
    fieldsToValidate.forEach((field) => {
      const error = validateField(field, data[field]);
      if (error) {
        showError(field, error);
        hasErrors = true;
      }
    });

    if (hasErrors) {
      const firstError = document.querySelector('.field.error input, .field.error textarea, .field.error select') as HTMLInputElement;
      firstError?.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.classList.add("loading");
    submitBtn.setAttribute("aria-busy", "true");

    try {
      // ✅ Utiliser la fonction API centralisée
      await submitContact(data);

      successMsg.style.display = "flex";
      form.reset();
      
      // Réinitialiser le timestamp
      if (timestampInput) {
        timestampInput.value = Math.floor(Date.now() / 1000).toString();
      }
      
      updateCharCount();
      successMsg.scrollIntoView({ behavior: "smooth", block: "nearest" });

      // Analytics
      if (typeof window.gtag !== 'undefined') {
        window.gtag('event', 'form_submit', {
          form_name: 'contact',
          service: data.service,
        });
      }

      setTimeout(() => {
        successMsg.style.display = "none";
      }, 10000);

    } catch (error: any) {
      console.error('❌ Erreur:', error);
      
      errorText.textContent = error?.message || 'Une erreur inattendue est survenue';
      errorMsg.style.display = "flex";
      errorMsg.scrollIntoView({ behavior: "smooth", block: "nearest" });

    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove("loading");
      submitBtn.removeAttribute("aria-busy");
    }
  });

  // Initialize
  initFormAnimations();
  setupFieldValidation();
  messageTextarea.addEventListener("input", updateCharCount);
  updateCharCount();
</script>