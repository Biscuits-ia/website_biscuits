---
import { SERVICES_CONFIG, EUROPE_COUNTRIES } from "@/utils/formValidation";
---
<div class="contact-wrapper">
  <form class="contact-form" id="contact-form" novalidate data-contact-form>
    <h2 class="contact-title" data-reveal="title">Contactez-nous</h2>
    
    <div class="form-grid" data-reveal="fields">
      <!-- Nom -->
      <div class="field" data-field="name">
        <label for="name">Nom complet <span class="required">*</span></label>
        <input 
          id="name" 
          name="name" 
          type="text" 
          placeholder="Marie Dupont" 
          required 
          aria-required="true" 
          maxlength="100"
          autocomplete="name"
        />
        <span class="error-message" role="alert" aria-live="polite"></span>
      </div>

      <!-- Email -->
      <div class="field" data-field="email">
        <label for="email">Email <span class="required">*</span></label>
        <input 
          id="email" 
          name="email" 
          type="email" 
          placeholder="marie@exemple.fr" 
          required 
          aria-required="true" 
          maxlength="255"
          autocomplete="email"
        />
        <span class="error-message" role="alert" aria-live="polite"></span>
      </div>
    </div>

    <!-- Pays -->
    <div class="field" data-field="country" data-reveal="country">
      <label for="country">Pays <span class="required">*</span></label>
      <select id="country" name="country" required aria-required="true" autocomplete="country">
        <option value="">Sélectionnez votre pays…</option>
        {EUROPE_COUNTRIES.map((c) => (
          <option value={c}>{c}</option>
        ))}
      </select>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>

    <!-- Service -->
    <div class="field" data-field="service" data-reveal="service">
      <label for="service">Service souhaité <span class="required">*</span></label>
      <select id="service" name="service" required aria-required="true">
        <option value="">Sélectionnez un service…</option>
        <optgroup label="Starter Kits">
          {SERVICES_CONFIG["starter-kits"].map((s) => <option value={s}>{s}</option>)}
        </optgroup>
        <optgroup label="Solutions IA">
          {SERVICES_CONFIG["ia"].map((s) => <option value={s}>{s}</option>)}
        </optgroup>
        <optgroup label="Consulting & Coaching">
          {SERVICES_CONFIG["consulting"].map((s) => <option value={s}>{s}</option>)}
        </optgroup>
      </select>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>

    <!-- Message -->
    <div class="field" data-field="message" data-reveal="message">
      <label for="message">Décrivez votre besoin <span class="required">*</span></label>
      <textarea 
        id="message" 
        name="message" 
        placeholder="Expliquez votre projet en détail..." 
        rows="6" 
        minlength="20"
        maxlength="2000"
        required
        aria-required="true"
      ></textarea>
      <span class="char-count" aria-live="polite">0 / 2000</span>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>

    <!-- Honeypot -->
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />

    <!-- Submit -->
    <button type="submit" id="submit-btn" class="submit-btn" data-reveal="submit">
      <span class="btn-text">Envoyer la demande</span>
      <span class="btn-loader" aria-hidden="true"></span>
    </button>

    <!-- Messages -->
    <div class="alert alert-success" id="success-message" role="status" aria-live="polite">
      <svg class="alert-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" fill="none"/>
      </svg>
      <span>Message envoyé avec succès ! Nous vous répondrons dans les 24 heures.</span>
    </div>

    <div class="alert alert-error" id="error-message" role="alert" aria-live="assertive">
      <svg class="alert-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none" />
        <path d="M12 8v4m0 4h.01" stroke="currentColor" stroke-width="2" />
      </svg>
      <span id="error-text">Une erreur est survenue. Veuillez réessayer.</span>
    </div>
  </form>
</div>

<style>
  .contact-wrapper {
    display: grid;
    place-items: center;
    padding: 4rem 1rem;
  }

  .contact-form {
    width: min(100%, 48rem);
    padding: 3rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-2xl);
    position: relative;
    overflow: hidden;
  }

  .contact-form::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-first));
  }

  .contact-title {
    text-align: center;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 2rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-first));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .form-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  @media (width >= 768px) {
    .form-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .field {
    display: flex;
    flex-direction: column;
  }

  .field label {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text-light);
  }

  .required {
    color: var(--color-danger);
  }

  .field input,
  .field select,
  .field textarea {
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--color-dark-bg); 
    font-size: 1rem;
    border: 1px solid var(--color-border);
    transition: all var(--transition-fast);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px oklch(72.218% 0.16534 47.931 / 0.1);
  }

  .field textarea {
    resize: vertical;
    min-height: 150px;
  }

  .field.error input,
  .field.error textarea,
  .field.error select {
    border-color: var(--color-danger);
    background-color: rgba(239, 68, 68, 0.05);
  }

  .error-message {
    color: var(--color-danger);
    font-size: 0.875rem;
    margin-top: 0.5rem;
    min-height: 1.25rem;
    font-weight: 500;
  }

  .field:not(.error) .error-message {
    visibility: hidden;
  }

  .char-count {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    text-align: right;
    color: var(--color-text-light);
    transition: color var(--transition-fast);
  }

  .honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .submit-btn {
    position: relative;
    width: 100%;
    padding: 1.25rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    border: none;
    border-radius: var(--radius-lg);
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
    margin-top: 2rem;
    box-shadow: var(--shadow-glow);
    overflow: hidden;
  }

  .submit-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }

  .submit-btn:hover:not(:disabled)::before {
    left: 100%;
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow-hover);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .submit-btn.loading .btn-text {
    opacity: 0;
  }

  .btn-loader {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 24px;
    height: 24px;
    border: 3px solid oklch(100% 0.00011 271.152 / 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  .submit-btn.loading .btn-loader {
    display: block;
  }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .alert {
    display: none;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    font-size: 0.95rem;
    font-weight: 500;
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .alert-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  .alert-success {
    background: oklch(69.588% 0.14907 162.508 / 0.1);
    color: var(--color-success);
    border: 1px solid var(--color-success);
  }

  .alert-error {
    background: oklch(63.681% 0.20784 25.315 / 0.1);
    color: var(--color-danger);
    border: 1px solid var(--color-danger);
  }

  @media (max-width: 768px) {
    .contact-form {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  import { submitContact } from '@/utils/api';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('success-message') as HTMLDivElement;
  const errorMsg = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLSpanElement;
  const timestampInput = document.getElementById('timestamp') as HTMLInputElement;

  timestampInput.value = Date.now().toString();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    successMsg.style.display = 'none';
    errorMsg.style.display = 'none';

    submitBtn.disabled = true;
    submitBtn.classList.add('loading');

    const formData = new FormData(form);
    const data = {
      name: formData.get('name') as string,
      email: formData.get('email') as string,
      country: formData.get('country') as string,
      service: formData.get('service') as string,
      message: formData.get('message') as string,
      honey: formData.get('honey') as string,
      timestamp: parseInt(formData.get('timestamp') as string),
    };

    try {
      const result = await submitContact(data);

      if (result.success) {
        successMsg.style.display = 'flex';
        form.reset();
        timestampInput.value = Date.now().toString();
      }
    } catch (error: any) {
      errorText.textContent = error.message || 'Erreur inconnue';
      errorMsg.style.display = 'flex';
    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
    }
  });
</script>