---
// Aucune prop nécessaire pour ce composant standalone
---

<div class="devis-wrapper">
  <form class="devis-form" id="devis-form" novalidate data-devis-form>
    <h2 class="form-title" data-reveal="title">Demander un devis</h2>
    
    <div class="form-grid" data-reveal="fields">
      <!-- Nom -->
      <div class="field" data-field="name">
        <label for="name">
          Nom complet <span class="required" aria-label="requis">*</span>
        </label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          required
          maxlength="100"
          autocomplete="name"
          placeholder="Marie Dupont"
          aria-required="true"
        />
        <span class="error-message" role="alert" aria-live="polite"></span>
      </div>
      
      <!-- Email -->
      <div class="field" data-field="email">
        <label for="email">
          Email <span class="required" aria-label="requis">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required
          maxlength="255"
          autocomplete="email"
          placeholder="marie@exemple.fr"
          aria-required="true"
        />
        <span class="error-message" role="alert" aria-live="polite"></span>
      </div>
    </div>

    <!-- Téléphone -->
    <div class="field" data-field="phone" data-reveal="phone">
      <label for="phone">Téléphone (optionnel)</label>
      <input 
        type="tel" 
        id="phone" 
        name="phone"
        maxlength="20"
        autocomplete="tel"
        placeholder="+33 6 12 34 56 78"
      />
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>
    
    <!-- Service -->
    <div class="field" data-field="service" data-reveal="service">
      <label for="service">
        Service souhaité <span class="required" aria-label="requis">*</span>
      </label>
      <select id="service" name="service" required aria-required="true">
        <option value="">Sélectionner un service…</option>
        <option value="site-vitrine">Site vitrine</option>
        <option value="e-commerce">E-commerce</option>
        <option value="application">Application web</option>
        <option value="seo">Référencement SEO</option>
        <option value="ia">Solution IA</option>
        <option value="consulting">Consulting</option>
        <option value="autre">Autre</option>
      </select>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>
    
    <!-- Budget -->
    <div class="field" data-field="budget" data-reveal="budget">
      <label for="budget">Budget estimé (optionnel)</label>
      <select id="budget" name="budget">
        <option value="">Sélectionner une fourchette…</option>
        <option value="< 1000€">Moins de 1 000€</option>
        <option value="1000-3000€">1 000€ - 3 000€</option>
        <option value="3000-5000€">3 000€ - 5 000€</option>
        <option value="5000-10000€">5 000€ - 10 000€</option>
        <option value="10000-20000€">10 000€ - 20 000€</option>
        <option value="> 20000€">Plus de 20 000€</option>
      </select>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>
    
    <!-- Message -->
    <div class="field" data-field="message" data-reveal="message">
      <label for="message">Détails du projet (optionnel)</label>
      <textarea 
        id="message" 
        name="message" 
        rows="5"
        maxlength="2000"
        placeholder="Décrivez vos besoins, contraintes, délais…"
      ></textarea>
      <span class="char-count" aria-live="polite">0 / 2000</span>
      <span class="error-message" role="alert" aria-live="polite"></span>
    </div>

    <!-- Honeypot (anti-spam) -->
    <input 
      type="text" 
      name="honey" 
      tabindex="-1" 
      autocomplete="off" 
      class="honeypot" 
      aria-hidden="true" 
    />

    <!-- Timestamp (anti-spam) -->
    <input 
      type="hidden" 
      name="timestamp" 
      id="devis-timestamp"
    />
    
    <!-- Submit button -->
    <button type="submit" class="submit-btn" id="submit-btn" data-reveal="submit">
      <span class="btn-text">Envoyer ma demande</span>
      <span class="btn-loader" aria-hidden="true"></span>
    </button>
    
    <!-- Success message -->
    <div class="alert alert-success" id="success-message" role="status" aria-live="polite">
      <svg class="alert-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" fill="none"/>
      </svg>
      <span>Demande envoyée avec succès ! Nous vous répondrons dans les 24 heures.</span>
    </div>

    <!-- Error message -->
    <div class="alert alert-error" id="error-message" role="alert" aria-live="assertive">
      <svg class="alert-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none" />
        <path d="M12 8v4m0 4h.01" stroke="currentColor" stroke-width="2" />
      </svg>
      <span id="error-text">Une erreur est survenue. Veuillez réessayer.</span>
    </div>
  </form>
</div>

<style>
  .devis-wrapper {
    display: grid;
    place-items: center;
    padding: 4rem 1rem;
  }

  .devis-form {
    width: min(100%, 48rem);
    padding: 3rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-2xl);
    position: relative;
    overflow: hidden;
  }

  .devis-form::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-first));
  }

  .form-title {
    text-align: center;
    font-weight: 700;
    font-size: 1.875rem;
    color: var(--color-text);
    margin-bottom: 2rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-first));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .form-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  @media (width >= 768px) {
    .form-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .field {
    display: flex;
    flex-direction: column;
  }
  
  .field label {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text-light);
  }

  .required {
    color: var(--color-danger);
  }
  
  .field input,
  .field select,
  .field textarea {
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--color-dark-bg);
    font-size: 1rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: inherit;
    transition: all var(--transition-fast);
  }
  
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px oklch(72.218% 0.16534 47.931 / 0.1);
  }

  .field textarea {
    resize: vertical;
    min-height: 150px;
  }

  .field.error input,
  .field.error select,
  .field.error textarea {
    border-color: var(--color-danger);
    background-color: rgba(239, 68, 68, 0.05);
  }

  .char-count {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    text-align: right;
    color: var(--color-text-light);
    transition: color var(--transition-fast);
  }

  .error-message {
    color: var(--color-danger);
    font-size: 0.875rem;
    margin-top: 0.5rem;
    min-height: 1.25rem;
    font-weight: 500;
  }

  .field:not(.error) .error-message {
    visibility: hidden;
  }

  .honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
  
  .submit-btn {
    position: relative;
    width: 100%;
    padding: 1.25rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    border: none;
    border-radius: var(--radius-lg);
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
    margin-top: 2rem;
    box-shadow: var(--shadow-glow);
    overflow: hidden;
  }

  .submit-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }

  .submit-btn:hover:not(:disabled)::before {
    left: 100%;
  }
  
  .submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow-hover);
  }
  
  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .submit-btn.loading .btn-text {
    opacity: 0;
  }

  .btn-loader {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 24px;
    height: 24px;
    border: 3px solid oklch(100% 0.00011 271.152 / 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  .submit-btn.loading .btn-loader {
    display: block;
  }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  
  .alert {
    display: none;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    font-size: 0.95rem;
    font-weight: 500;
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .alert-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }
  
  .alert-success {
    background: oklch(69.588% 0.14907 162.508 / 0.1);
    color: var(--color-success);
    border: 1px solid var(--color-success);
  }
  
  .alert-error {
    background: oklch(63.681% 0.20784 25.315 / 0.1);
    color: var(--color-danger);
    border: 1px solid var(--color-danger);
  }

  @media (max-width: 768px) {
    .devis-form {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { submitDevis } from '@/utils/api'; // ✅ Import unique depuis utils/api

  gsap.registerPlugin(ScrollTrigger);

  const DEBOUNCE_DELAY = 300;
  
  // Elements
  const form = document.getElementById('devis-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('success-message') as HTMLDivElement;
  const errorMsg = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLSpanElement;
  const messageTextarea = document.getElementById('message') as HTMLTextAreaElement;
  const charCount = document.querySelector('.char-count') as HTMLSpanElement;
  const timestampInput = document.getElementById('devis-timestamp') as HTMLInputElement;

  // ✅ Initialiser le timestamp
  if (timestampInput) {
    timestampInput.value = Math.floor(Date.now() / 1000).toString();
  }

  // Animations GSAP
  function initFormAnimations(): void {
    const shouldReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (shouldReduce) {
      gsap.set('[data-reveal]', { opacity: 1, y: 0 });
      return;
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '[data-devis-form]',
        start: 'top 80%',
        once: true,
      },
      defaults: {
        ease: 'power3.out',
        duration: 0.8,
      },
    });

    tl.fromTo('[data-reveal="title"]',
      { opacity: 0, y: -20 },
      { opacity: 1, y: 0 }
    )
    .fromTo('[data-reveal="fields"] .field',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, stagger: 0.1 },
      '-=0.4'
    )
    .fromTo('[data-reveal="phone"], [data-reveal="service"], [data-reveal="budget"], [data-reveal="message"]',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, stagger: 0.1 },
      '-=0.4'
    )
    .fromTo('[data-reveal="submit"]',
      { opacity: 0, scale: 0.9 },
      { opacity: 1, scale: 1 },
      '-=0.3'
    );
  }

  // Validation
  const sanitizeInput = (value: string): string => {
    if (!value) return '';
    return value.trim().replace(/[<>]/g, '').slice(0, 5000);
  };

  const validateField = (name: string, value: string): string | null => {
    switch (name) {
      case 'name':
        if (!value || value.trim() === '') return 'Ce champ est obligatoire';
        if (value.length < 2) return 'Le nom doit contenir au moins 2 caractères';
        if (value.length > 100) return 'Le nom ne peut pas dépasser 100 caractères';
        if (!/^[a-zA-ZÀ-ÿ\s'-]+$/.test(value)) return 'Le nom contient des caractères invalides';
        break;

      case 'email':
        if (!value || value.trim() === '') return 'Ce champ est obligatoire';
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) return 'Email invalide';
        if (value.length > 255) return 'L\'email ne peut pas dépasser 255 caractères';
        break;

      case 'phone':
        if (value && !/^[+\d\s()-]+$/.test(value)) return 'Numéro de téléphone invalide';
        break;

      case 'service':
        if (!value || value.trim() === '') return 'Veuillez sélectionner un service';
        break;

      case 'message':
        if (value && value.length > 2000) return 'Le message ne peut pas dépasser 2000 caractères';
        break;
    }
    return null;
  };

  // UI helpers
  const showError = (fieldName: string, message: string): void => {
    const field = document.querySelector(`[data-field="${fieldName}"]`);
    if (!field) return;

    field.classList.add('error');
    const errorSpan = field.querySelector('.error-message');
    if (errorSpan) errorSpan.textContent = message;

    const input = field.querySelector('input, select, textarea') as HTMLInputElement;
    if (input) input.setAttribute('aria-invalid', 'true');
  };

  const clearError = (fieldName: string): void => {
    const field = document.querySelector(`[data-field="${fieldName}"]`);
    if (!field) return;

    field.classList.remove('error');
    const errorSpan = field.querySelector('.error-message');
    if (errorSpan) errorSpan.textContent = '';

    const input = field.querySelector('input, select, textarea') as HTMLInputElement;
    if (input) input.removeAttribute('aria-invalid');
  };

  const clearAllErrors = (): void => {
    form.querySelectorAll('[data-field]').forEach((field) => {
      const fieldName = field.getAttribute('data-field');
      if (fieldName) clearError(fieldName);
    });
  };

  const updateCharCount = (): void => {
    if (!messageTextarea || !charCount) return;
    
    const length = messageTextarea.value.length;
    charCount.textContent = `${length} / 2000`;
    
    if (length > 1900) {
      charCount.style.color = 'var(--color-danger)';
    } else if (length > 1500) {
      charCount.style.color = 'var(--color-warning)';
    } else {
      charCount.style.color = '';
    }
  };

  // Field validation avec debounce
  const setupFieldValidation = (): void => {
    const fields = form.querySelectorAll('input:not([type="hidden"]):not(.honeypot), textarea, select');
    let debounceTimeout: number;

    fields.forEach((field) => {
      const input = field as HTMLInputElement;

      input.addEventListener('blur', () => {
        const sanitized = sanitizeInput(input.value);
        const error = validateField(input.name, sanitized);
        error ? showError(input.name, error) : clearError(input.name);
      });

      input.addEventListener('input', () => {
        clearTimeout(debounceTimeout);
        debounceTimeout = window.setTimeout(() => {
          clearError(input.name);
        }, DEBOUNCE_DELAY);
      });
    });
  };

  // Form submission
  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();

    successMsg.style.display = 'none';
    errorMsg.style.display = 'none';
    clearAllErrors();

    const formData = new FormData(form);
    
    // ✅ Helper pour nettoyer les champs optionnels
    const getOptionalField = (fieldName: string): string | undefined => {
      const value = sanitizeInput(formData.get(fieldName) as string);
      return value && value.trim() !== '' ? value : undefined;
    };
    
    const data = {
      name: sanitizeInput(formData.get('name') as string),
      email: sanitizeInput(formData.get('email') as string),
      phone: getOptionalField('phone'),
      service: sanitizeInput(formData.get('service') as string),
      budget: getOptionalField('budget'), // ✅ Ne pas envoyer si vide
      message: getOptionalField('message'), // ✅ Ne pas envoyer si vide
      honey: formData.get('honey') as string || '',
      timestamp: parseInt(formData.get('timestamp') as string || '0'),
    };

    // Validation côté client
    let hasErrors = false;
    const requiredFields = ['name', 'email', 'service'] as const;
    
    requiredFields.forEach((field) => {
      const error = validateField(field, data[field] as string);
      if (error) {
        showError(field, error);
        hasErrors = true;
      }
    });

    if (hasErrors) {
      const firstError = document.querySelector('.field.error input, .field.error select') as HTMLInputElement;
      firstError?.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.classList.add('loading');
    submitBtn.setAttribute('aria-busy', 'true');

    try {
      // ✅ Appel à la fonction centralisée dans utils/api
      await submitDevis(data);

      successMsg.style.display = 'flex';
      form.reset();
      
      // Réinitialiser le timestamp
      if (timestampInput) {
        timestampInput.value = Math.floor(Date.now() / 1000).toString();
      }
      
      updateCharCount();
      successMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      // Analytics
      if (typeof window.gtag !== 'undefined') {
        window.gtag('event', 'form_submit', {
          form_name: 'devis',
          service: data.service,
          budget: data.budget,
        });
      }

      setTimeout(() => {
        successMsg.style.display = 'none';
      }, 10000);

    } catch (error: any) {
      console.error('❌ Erreur:', error);
      
      errorText.textContent = error?.message || 'Une erreur inattendue est survenue';
      errorMsg.style.display = 'flex';
      errorMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
      submitBtn.removeAttribute('aria-busy');
    }
  });

  // Initialize
  initFormAnimations();
  setupFieldValidation();
  if (messageTextarea) {
    messageTextarea.addEventListener('input', updateCharCount);
    updateCharCount();
  }
</script>