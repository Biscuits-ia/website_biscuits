---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-grid">
      <!-- About -->
      <div class="footer-section">
        <h3>Biscuits Dev</h3>
        <p class="footer-description">
          Solutions IA & automatisation. Assistants IA, outils intelligents, automatisation de workflows et services techniques pour développeurs, indépendants et associations.
        </p>
      </div>

      <!-- Services -->
      <div class="footer-section">
        <h3>Nos Services</h3>
        <ul>
          <li><a href="/services">Assistants IA personnalisés</a></li>
          <li><a href="/services">Automatisation de workflows</a></li>
          <li><a href="/services">Outils IA pour développeurs</a></li>
          <li><a href="/services">Intégration IA & API</a></li>
          <li><a href="/services">Solutions SaaS</a></li>
        </ul>
      </div>

      <!-- Links -->
      <div class="footer-section">
        <h3>Liens Rapides</h3>
        <ul>
          <li><a href="/tarifs">Tarifs</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="mailto:contact@biscuits-ia.com" target="_blank">Contact</a></li>
        <li class="w-full lg:w-auto border-b border-[var(--color-border)] lg:border-b-0">
          <a href="https://forum.biscuits-ia.com/" class="block lg:inline-block py-4 lg:py-2 text-[var(--color-text-light)] font-medium relative transition-colors duration-200 hover:text-[var(--color-text)] lg:before:content-[''] lg:before:absolute lg:before:bottom-0 lg:before:left-1/2 lg:before:w-0 lg:before:h-0.5 lg:before:bg-[var(--color-primary)] lg:before:-translate-x-1/2 lg:before:transition-all lg:before:duration-300 lg:hover:before:w-full">
            Forum
          </a>
        </li>
          <li><a href="/devis">Demander un devis</a></li>
          
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="footer-bottom">
      <div class="footer-bottom-content">
        <p class="copyright">
          © {currentYear} Biscuits IA. Tous droits réservés.
        </p>
        <nav aria-label="Navigation légale">
          <ul class="legal-links">
            <li><a href="/legal/mentions-legales">Mentions légales</a></li>
            <li><a href="/legal/confidentialite">Confidentialité</a></li>
            <li><a href="/legal/cookies">Cookies</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, var(--color-dark-elevated) 0%, var(--color-dark-bg) 100%);
    color: var(--color-text-light);
    padding-block-start: var(--spacing-4xl);
    border-top: 1px solid var(--color-border);
  }

  .footer-content {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--spacing-lg);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
  }

  .footer-section h3 {
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
    font-size: var(--font-size-xl);
    background: var(--color-gray-100);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-description {
    line-height: 1.7;
    margin-bottom: var(--spacing-lg);
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
  }

  .footer-section li {
    margin-bottom: var(--spacing-sm);
  }

  .footer-section a {
    transition: all var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .footer-section a:hover {
    color: var(--color-primary);
    transform: translateX(5px);
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
  }

  .social-links a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    color: var(--color-text);
    transition: all var(--transition-base);
  }

  .social-links a:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--spacing-xl);
  }

  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .copyright {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
  }

  .legal-links {
    display: flex;
    gap: var(--spacing-lg);
    list-style: none;
  }

  .legal-links a {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
  }

  .legal-links a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom-content {
      flex-direction: column;
      text-align: center;
    }

    .legal-links {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>