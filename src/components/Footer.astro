---
import ChatClient from "../components/svelte/ChatClient.svelte";

const currentYear = new Date().getFullYear();
---

<div id="chatbot-root">
  <ChatClient client:load />
</div>

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-grid">
      <!-- About -->
      <div class="footer-section">
        <h3>Biscuits Dev</h3>
        <p class="footer-description">
          Solutions IA & automatisation. Assistants IA, outils intelligents, automatisation de workflows et services techniques pour développeurs, indépendants et entreprises.
        </p>
        <div class="social-links">
          <a href="https://linkedin.com" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a href="https://github.com" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div class="footer-section">
        <h3>Nos Services</h3>
        <ul>
          <li><a href="/services">Assistants IA personnalisés</a></li>
          <li><a href="/services">Automatisation de workflows</a></li>
          <li><a href="/services">Outils IA pour développeurs</a></li>
          <li><a href="/services">Intégration IA & API</a></li>
          <li><a href="/services">Solutions SaaS</a></li>
        </ul>
      </div>

      <!-- Links -->
      <div class="footer-section">
        <h3>Liens Rapides</h3>
        <ul>
          <li><a href="/tarifs">Tarifs</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/devis">Demander un devis</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="footer-bottom">
      <div class="footer-bottom-content">
        <p class="copyright">
          © {currentYear} Biscuits Dev. Tous droits réservés.
        </p>
        <nav aria-label="Navigation légale">
          <ul class="legal-links">
            <li><a href="/legal/mentions-legales">Mentions légales</a></li>
            <li><a href="/legal/confidentialite">Confidentialité</a></li>
            <li><a href="/legal/cookies">Cookies</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, var(--color-dark-elevated) 0%, var(--color-dark-bg) 100%);
    color: var(--color-text-light);
    padding-block-start: var(--spacing-4xl);
    border-top: 1px solid var(--color-border);
  }

  .footer-content {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--spacing-lg);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
  }

  .footer-section h3 {
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
    font-size: var(--font-size-xl);
    background: linear-gradient(135deg, var(--color-primary), var(--color-first));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-description {
    line-height: 1.7;
    margin-bottom: var(--spacing-lg);
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
  }

  .footer-section li {
    margin-bottom: var(--spacing-sm);
  }

  .footer-section a {
    transition: all var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .footer-section a:hover {
    color: var(--color-primary);
    transform: translateX(5px);
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
  }

  .social-links a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    color: var(--color-text);
    transition: all var(--transition-base);
  }

  .social-links a:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--spacing-xl);
  }

  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .copyright {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
  }

  .legal-links {
    display: flex;
    gap: var(--spacing-lg);
    list-style: none;
  }

  .legal-links a {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
  }

  .legal-links a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom-content {
      flex-direction: column;
      text-align: center;
    }

    .legal-links {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>