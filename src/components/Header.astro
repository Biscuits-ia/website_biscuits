---
---

<header class="site-header fixed top-0 left-0 right-0 z-[1000] bg-[var(--color-bg)] border-b border-[var(--color-border)] transition-all duration-300" data-header>
  <div class="header-container max-w-[var(--container-2xl)] mx-auto px-4 lg:px-6 flex items-center justify-between min-h-20 md:min-h-[70px]">
    
    <!-- Logo -->
    <div class="logo-section">
      <a 
        href="/" 
        aria-label="Retour à l'accueil Biscuits Dev"
        class="flex items-center gap-3 transition-transform duration-200 hover:scale-105"
      >
        <span class="logo-text flex flex-col leading-tight">
          <strong class="text-xl md:text-2xl font-bold bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-first)] bg-clip-text text-transparent">
            Biscuits IA
          </strong>
          <small class="text-xs md:text-sm text-[var(--color-text-light)] hidden sm:block">
            Solutions IA et Automatisation.
          </small>
        </span>
      </a>
    </div>

    <!-- Hamburger Button -->
    <button  
      class="mobile-menu-toggle lg:hidden p-3 cursor-pointer relative z-[1001]" 
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span class="hamburger block w-7 h-0.5 bg-[var(--color-text)] rounded-sm relative transition-all duration-300 before:content-[''] before:block before:w-7 before:h-0.5 before:bg-[var(--color-text)] before:rounded-sm before:absolute before:left-0 before:-top-2 before:transition-all before:duration-300 after:content-[''] after:block after:w-7 after:h-0.5 after:bg-[var(--color-text)] after:rounded-sm after:absolute after:left-0 after:-bottom-2 after:transition-all after:duration-300"></span>
    </button>

    <!-- Navigation -->
    <nav 
      id="main-navigation" 
      class="main-nav fixed lg:relative top-[70px] lg:top-0 -right-full lg:right-0 bottom-0 lg:bottom-auto w-[85vw] max-w-[320px] lg:w-auto lg:max-w-none bg-[var(--color-bg)] lg:bg-transparent p-6 lg:p-0 shadow-[var(--shadow-lg)] lg:shadow-none transition-[right] duration-300 overflow-y-auto lg:overflow-visible border-l border-[var(--color-border)] lg:border-l-0"
      aria-label="Navigation principale"
    >
      <ul class="flex flex-col lg:flex-row gap-0 lg:gap-8 items-stretch lg:items-center m-0 p-0 list-none">
        <li class="w-full lg:w-auto border-b border-[var(--color-border)] lg:border-b-0">
          <a href="/" class="block lg:inline-block py-4 lg:py-2 text-[var(--color-text-light)] font-medium relative transition-colors duration-200 hover:text-[var(--color-text)] lg:before:content-[''] lg:before:absolute lg:before:bottom-0 lg:before:left-1/2 lg:before:w-0 lg:before:h-0.5 lg:before:bg-[var(--color-primary)] lg:before:-translate-x-1/2 lg:before:transition-all lg:before:duration-300 lg:hover:before:w-full">
            Accueil
          </a>
        </li>
        <li class="w-full lg:w-auto border-b border-[var(--color-border)] lg:border-b-0">
          <a href="/pourquoi-biscuits-ia" class="block lg:inline-block py-4 lg:py-2 text-[var(--color-text-light)] font-medium relative transition-colors duration-200 hover:text-[var(--color-text)] lg:before:content-[''] lg:before:absolute lg:before:bottom-0 lg:before:left-1/2 lg:before:w-0 lg:before:h-0.5 lg:before:bg-[var(--color-primary)] lg:before:-translate-x-1/2 lg:before:transition-all lg:before:duration-300 lg:hover:before:w-full">
            Pourquoi Biscuits IA
          </a>
        </li>
        <li class="w-full lg:w-auto border-b border-[var(--color-border)] lg:border-b-0">
          <a href="/tarifs" class="block lg:inline-block py-4 lg:py-2 text-[var(--color-text-light)] font-medium relative transition-colors duration-200 hover:text-[var(--color-text)] lg:before:content-[''] lg:before:absolute lg:before:bottom-0 lg:before:left-1/2 lg:before:w-0 lg:before:h-0.5 lg:before:bg-[var(--color-primary)] lg:before:-translate-x-1/2 lg:before:transition-all lg:before:duration-300 lg:hover:before:w-full">
            Tarifs
          </a>
        </li>
        <li class="w-full lg:w-auto border-b border-[var(--color-border)] lg:border-b-0">
          <a href="/services" class="block lg:inline-block py-4 lg:py-2 text-[var(--color-text-light)] font-medium relative transition-colors duration-200 hover:text-[var(--color-text)] lg:before:content-[''] lg:before:absolute lg:before:bottom-0 lg:before:left-1/2 lg:before:w-0 lg:before:h-0.5 lg:before:bg-[var(--color-primary)] lg:before:-translate-x-1/2 lg:before:transition-all lg:before:duration-300 lg:hover:before:w-full">
            Services
          </a>
        </li>
        <li class="w-full lg:w-auto border-b border-[var(--color-border)] lg:border-b-0">
          <a href="/blog" class="block lg:inline-block py-4 lg:py-2 text-[var(--color-text-light)] font-medium relative transition-colors duration-200 hover:text-[var(--color-text)] lg:before:content-[''] lg:before:absolute lg:before:bottom-0 lg:before:left-1/2 lg:before:w-0 lg:before:h-0.5 lg:before:bg-[var(--color-primary)] lg:before:-translate-x-1/2 lg:before:transition-all lg:before:duration-300 lg:hover:before:w-full">
            Blog
          </a>
        </li>
        <li class="w-full lg:w-auto border-b border-[var(--color-border)] lg:border-b-0">
          <a href="/devis" class="block lg:inline-block py-4 lg:py-2 text-[var(--color-text-light)] font-medium relative transition-colors duration-200 hover:text-[var(--color-text)] lg:before:content-[''] lg:before:absolute lg:before:bottom-0 lg:before:left-1/2 lg:before:w-0 lg:before:h-0.5 lg:before:bg-[var(--color-primary)] lg:before:-translate-x-1/2 lg:before:transition-all lg:before:duration-300 lg:hover:before:w-full">
            Devis
          </a>
        </li>

        <!-- Auth -->
        <li class="nav-actions w-full lg:w-auto mt-6 lg:mt-0 pt-6 lg:pt-0 border-t border-[var(--color-border)] lg:border-t-0 flex items-center justify-center">
          <a href="/login" class="cta-button" aria-label="login">Connexion</a>
        </li>
        <li class="nav-actions w-full lg:w-auto mt-6 lg:mt-0 pt-6 lg:pt-0 border-t border-[var(--color-border)] lg:border-t-0 flex items-center justify-center">
          <a href="/register" class="cta-button" aria-label="login">Inscription</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Styles pour le hamburger animé (plus simple en CSS) */
  .mobile-menu-toggle[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger::after {
    bottom: 0;
    transform: rotate(-45deg);
  }

  /* Header scrolled */
  .site-header.scrolled {
    background: var(--color-bg-elevated);
    box-shadow: var(--shadow-md);
  }

  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  /* Menu actif */
  .main-nav.active {
    right: 0;
  }

  /* Overlay pour menu mobile */
  .main-nav.active::before {
    content: '';
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: -1;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Pas de hover sur tactile */
  @media (hover: none) {
    .logo-section a:hover {
      transform: none;
    }
    
    .cta-button:hover {
      transform: none;
    }
  }

  /* Réduction des mouvements */
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }

  /* Focus visible */
  .mobile-menu-toggle:focus-visible,
  .main-nav a:focus-visible,
  .cta-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Menu plein écran sur mobile < 640px */
  @media (max-width: 640px) {
    .main-nav {
      width: 100vw;
      right: -100vw;
      max-width: none;
      border-left: none;
    }
  }
</style>

<script>
  // Gestion du scroll header
  const header = document.querySelector('[data-header]') as HTMLElement | null;
  
  if (header) {
    let lastScroll = 0;
    let ticking = false;

    function updateHeader() {
      if (!header) return;
      
      const currentScroll = window.pageYOffset;

      if (currentScroll > 50) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }

      if (currentScroll > lastScroll && currentScroll > 80) {
        header.classList.add('header-hidden');
      } else {
        header.classList.remove('header-hidden');
      }

      lastScroll = currentScroll;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }, { passive: true });
  }

  // Gestion du menu mobile
  const toggle = document.querySelector('.mobile-menu-toggle') as HTMLButtonElement | null;
  const nav = document.querySelector('.main-nav') as HTMLElement | null;

  if (toggle && nav) {
    // Toggle menu
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      nav.classList.toggle('active');
      document.body.style.overflow = isExpanded ? '' : 'hidden';
    });

    // Fermer avec Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('active')) {
        toggle.click();
      }
    });

    // Fermer au clic sur un lien
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (nav.classList.contains('active')) {
          toggle.click();
        }
      });
    });

    // Fermer au clic en dehors
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (
        nav.classList.contains('active') &&
        !nav.contains(target) &&
        !toggle.contains(target)
      ) {
        toggle.click();
      }
    });
  }

  document.addEventListener('astro:before-swap', () => {
    if (nav) {
      nav.classList.remove('active');
    }
    if (toggle) {
      toggle.setAttribute('aria-expanded', 'false');
    }
    document.body.style.overflow = '';
  });
</script>