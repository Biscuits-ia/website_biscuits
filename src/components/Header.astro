---
---

<header class="site-header" data-header>
  <div class="header-container">

    <div class="logo-section">
      <a href="/" aria-label="Retour à l'accueil Biscuits IA" class="logo-link">
        <span class="logo-text">
          <span class="logo-title">Biscuits IA</span>
          <span class="logo-subtitle">solution pour les Associations et PME/TPE</span>
        </span>
      </a>
    </div>

    <!-- Hamburger Button -->
    <button class="mobile-menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-navigation">
      <span class="hamburger-icon"></span>
    </button>

    <!-- Navigation -->
    <nav id="main-navigation" class="main-nav" aria-label="Navigation principale">
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/" class="nav-link">Accueil</a>
        </li>
        <li class="nav-item">
          <a href="/pourquoi-biscuits-ia" class="nav-link">A propos</a>
        </li>
        
        <li class="nav-item has-dropdown">
          <div class="nav-link dropdown-toggle">
            <span>Associations</span>
            <svg class="dropdown-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <ul class="dropdown-menu">
            <li><a href="/projects-collaboratif" class="dropdown-link">Projets collaboratifs</a></li>
            <li><a href="/atelier-ia" class="dropdown-link">Ateliers IA</a></li>
            <li><a href="/guides-ressources" class="dropdown-link">Guides & ressources</a></li>
          </ul>
        </li>

        <li class="nav-item has-dropdown">
          <div class="nav-link dropdown-toggle">
            <span>Nos Combats</span>
            <svg class="dropdown-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <ul class="dropdown-menu">
            <li><a href="/combats/arnaques-numeriques" class="dropdown-link">Arnaques Numeriques</a></li>
            <li><a href="/combats/ia-accessible" class="dropdown-link">IA Accessible</a></li>
            <li><a href="/combats/ia-utile" class="dropdown-link">IA Utile</a></li>
            <li><a href="/combats/partage-connaissance" class="dropdown-link">Partage Connaissance</a></li>
            <li><a href="/combats/plateformes-ouvertes" class="dropdown-link">Plateformes Ouvertes</a></li>
          </ul>
        </li>

        <li class="nav-item">
          <a href="/blog" class="nav-link">Blog</a>
        </li>
        <li class="nav-item">
          <a href="/devis" class="nav-link">Contact</a>
        </li>

        <!-- Auth Buttons -->
        <li class="nav-item nav-cta">
          <a href="/login" class="btn-auth btn-login">Mon Espace</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<!-- Overlay pour menu mobile -->
<div class="nav-overlay" data-nav-overlay></div>

<style>
  /* ===== HEADER NÉO-BRUTALISME ===== */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--color-bg);
    border-bottom: 5px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .site-header.scrolled {
    background: var(--color-bg-elevated);
    box-shadow: 0 6px 0px var(--color-border);
  }

  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-container {
    max-width: var(--container-2xl);
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
  }

  /* ===== LOGO BRUTAL ===== */
  .logo-section {
    z-index: 1002;
    margin-bottom: 35px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: transform var(--transition-fast);
  }
  
  .logo-text {
    position: absolute;
    animation: none;
    display: flex;
    flex-direction: column;
    margin-top: 4vh;
    line-height: 1.2;
  }

  .logo-title {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    background: linear-gradient(to right, var(--color-primary), var(--color-first));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.2);
  }

  .logo-subtitle {
    font-size: 0.75rem;
    color: var(--color-text-light);
    font-weight: var(--font-weight-semibold);
    display: none;
  }

  @media (min-width: 640px) {
    .logo-title {
      font-size: 1.75rem;
    }
    .logo-subtitle {
      display: block;
      font-size: 0.875rem;
    }
  }

  /* ===== HAMBURGER BRUTAL ===== */
  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    background: var(--color-bg-elevated);
    border: 3px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    z-index: 1002;
    transition: all var(--transition-fast);
  }

  .mobile-menu-toggle:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-md);
  }

  .mobile-menu-toggle:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  .hamburger-icon {
    position: relative;
    width: 24px;
    height: 3px;
    background: var(--color-border);
    transition: background var(--transition-base);
  }

  .hamburger-icon::before,
  .hamburger-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 24px;
    height: 3px;
    background: var(--color-border);
    transition: all var(--transition-base);
  }

  .hamburger-icon::before {
    top: -8px;
  }

  .hamburger-icon::after {
    bottom: -8px;
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-icon {
    background: transparent;
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-icon::after {
    bottom: 0;
    transform: rotate(-45deg);
  }

  /* ===== NAVIGATION MOBILE BRUTALE ===== */
  .main-nav {
    position: fixed;
    top: 75px;
    right: -100%;
    bottom: 0;
    width: 85vw;
    max-width: 320px;
    background: var(--color-bg);
    padding: var(--spacing-xl) var(--spacing-lg);
    overflow-y: auto;
    transition: right var(--transition-base);
  }

  .main-nav.active {
    right: 0;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    border-bottom: 3px solid var(--color-border);
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--spacing-md) 0;
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link:focus {
    color: var(--color-gray-100);
    transform: translateX(3px);
  }

  /* Boutons dropdown sans style brutal */
  .dropdown-toggle {
    border: none;
    background: none;
    box-shadow: none;
    transform: none;
  }

  .dropdown-toggle span {
    color: var(--color-text);
    box-shadow: 0;
    background: 0;
    }

  
  .dropdown-toggle:hover,
  .dropdown-toggle:active {
    box-shadow: none;
    background: none;
  }

  /* ===== DROPDOWNS BRUTAUX ===== */
  .dropdown-icon {
    margin-left: var(--spacing-sm);
    transition: transform var(--transition-base);
    flex-shrink: 0;
  }

  .dropdown-toggle[aria-expanded="true"] .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    display: none;
    list-style: none;
    margin: 0;
    padding: var(--spacing-sm) 0 var(--spacing-md) var(--spacing-md);
  }

  .dropdown-menu.active {
    display: block;
  }

  .dropdown-link {
    display: block;
    padding: var(--spacing-sm) 0;
    color: var(--color-text);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    text-transform: none;
    letter-spacing: normal;
    transition: all var(--transition-fast);
  }

  .dropdown-link:hover,
  .dropdown-link:focus {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  /* ===== BOUTONS AUTH BRUTAUX ===== */
  .nav-cta {
    padding-top: var(--spacing-lg);
    border-top: 3px solid var(--color-border);
    border-bottom: none;
  }

  .nav-cta:last-child {
    padding-top: 0;
    border-top: none;
  }

  .btn-auth {
    display: block;
    width: 100%;
    padding: var(--spacing-sm) var(--spacing-lg);
    text-align: center;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: var(--brutal-border);
    transition: all var(--transition-fast);
    font-size: var(--font-size-xs);
  }

  .btn-login {
    color: var(--color-text);
    background: var(--color-bg-elevated);
  }

  .btn-login:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg);
  }
  
  /* ===== OVERLAY BRUTAL ===== */
  .nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-base);
  }

  .nav-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* ===== DESKTOP BRUTAL ===== */
  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }

    .main-nav {
      position: static;
      width: auto;
      max-width: none;
      background: transparent;
      padding: 0;
      overflow: visible;
      border-left: none;
      box-shadow: none;
    }

    .nav-list {
      flex-direction: row;
      gap: var(--spacing-lg);
      align-items: center;
    }

    .nav-item {
      border-bottom: none;
    }

    .nav-link {
      padding: var(--spacing-sm) 0;
      position: relative;
      font-size: var(--font-size-xs);
    }

    .nav-link:hover {
      transform: none;
    }

    .nav-item:not(.has-dropdown) .nav-link::after {
      content: '';
      position: absolute;
      bottom: -3px;
      left: 0;
      width: 0;
      height: 3px;
      background: var(--color-border);
      transition: width var(--transition-base);
    }

    .nav-item:not(.has-dropdown) .nav-link:hover::after {
      width: 100%;
    }

    .nav-item:not(.has-dropdown) .nav-link:hover {
      transform: translateY(-2px);
    }

    /* Dropdowns Desktop Brutaux */
    .has-dropdown {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + var(--spacing-sm));
      left: 0;
      background: var(--color-bg-elevated);
      border: var(--brutal-border);
      padding: var(--spacing-sm);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all var(--transition-base);
    }

    .has-dropdown:hover .dropdown-menu,
    .dropdown-toggle[aria-expanded="true"] + .dropdown-menu {
      display: block;
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .dropdown-link {
      padding: var(--spacing-sm) var(--spacing-md); 
    }

    .dropdown-link:last-child {
      border-bottom: none;
    }

    .dropdown-link:hover {
      background: var(--color-bg);
      transform: translateX(3px);
    }

    /* Auth buttons Desktop */
    .nav-cta {
      margin: 0;
      padding: 0;
      border: none;
    }

    .btn-auth {
      width: auto;
      padding: var(--spacing-sm) var(--spacing-lg);
    }

    .nav-overlay {
      display: none;
    }
  }

  /* ===== MOBILE PETIT ÉCRAN ===== */
  @media (max-width: 640px) {
    .main-nav {
      width: 100vw;
      right: -100vw;
      max-width: none;
      border-left: none;
    }
  }

  /* ===== ACCESSIBILITÉ BRUTALE ===== */
  .mobile-menu-toggle:focus-visible,
  .nav-link:focus-visible,
  .dropdown-link:focus-visible,
  .btn-auth:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector('[data-header]') as HTMLElement;
    const toggle = document.querySelector('.mobile-menu-toggle') as HTMLButtonElement;
    const nav = document.querySelector('.main-nav') as HTMLElement;
    const overlay = document.querySelector('[data-nav-overlay]') as HTMLElement;

    if (!header || !toggle || !nav || !overlay) return;

    // ===== SCROLL HEADER =====
    let lastScroll = 0;
    let ticking = false;

    function updateHeader() {
      const currentScroll = window.pageYOffset;

      if (currentScroll > 50) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }

      if (currentScroll > lastScroll && currentScroll > 100) {
        header.classList.add('header-hidden');
      } else {
        header.classList.remove('header-hidden');
      }

      lastScroll = currentScroll;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }, { passive: true });

    // ===== TOGGLE MENU =====
    function toggleMenu() {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      nav.classList.toggle('active');
      overlay.classList.toggle('active');
      document.body.style.overflow = isOpen ? '' : 'hidden';
    }

    function closeMenu() {
      toggle.setAttribute('aria-expanded', 'false');
      nav.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', toggleMenu);
    overlay.addEventListener('click', closeMenu);

    // Fermer avec Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('active')) {
        closeMenu();
      }
    });

    // Fermer au clic sur lien
    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // ===== DROPDOWNS =====
    const dropdowns = document.querySelectorAll('.dropdown-toggle');

    dropdowns.forEach(dropdown => {
      dropdown.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = dropdown.getAttribute('aria-expanded') === 'true';
        const menu = dropdown.nextElementSibling as HTMLElement;

        // Fermer les autres dropdowns sur mobile
        if (window.innerWidth < 1024) {
          dropdowns.forEach(other => {
            if (other !== dropdown) {
              other.setAttribute('aria-expanded', 'false');
              (other.nextElementSibling as HTMLElement)?.classList.remove('active');
            }
          });
        }

        dropdown.setAttribute('aria-expanded', String(!isOpen));
        menu?.classList.toggle('active');
      });
    });

    // Fermer dropdowns au clic extérieur (desktop)
    document.addEventListener('click', (e) => {
      if (window.innerWidth >= 1024) {
        const target = e.target as HTMLElement;
        if (!target.closest('.has-dropdown')) {
          dropdowns.forEach(dropdown => {
            dropdown.setAttribute('aria-expanded', 'false');
          });
        }
      }
    });

    // ===== ASTRO TRANSITIONS =====
    document.addEventListener('astro:before-swap', closeMenu);
  }

  // Init au chargement
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }

  // Reinit après navigation Astro
  document.addEventListener('astro:page-load', initHeader);
</script>