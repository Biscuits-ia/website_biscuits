---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Biscuits IA - Accueil">
      <span class="logo-name">Biscuits <span class="logo-accent">IA</span></span>
    </a>

    <nav id="main-navigation" class="main-nav" aria-label="Navigation principale">
      <ul class="nav-list" role="menubar">
        <li class="nav-item has-mega" role="none">
          <button
            class="nav-trigger"
            aria-expanded="false"
            aria-controls="mega-solutions"
            aria-haspopup="true"
            data-mega-toggle
            role="menuitem"
          >
            Nos piliers
            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div id="mega-solutions" class="mega-panel" role="region" aria-label="Nos produits">
            <div class="mega-grid">
              <aside class="mega-categories" aria-label="Piliers">
                <button class="mega-cat active" data-cat="ia" aria-selected="true">
                  Pilier 1 : IA
                </button>
                <button class="mega-cat" data-cat="cyber" aria-selected="false">
                  Pilier 2 : Cyber
                </button>
                <button class="mega-cat" data-cat="logiciels" aria-selected="false">
                  Pilier 3 : Logiciels
                </button>
                <button class="mega-cat" data-cat="anti" aria-selected="false">
                  Pilier 4 : Anti Pepins
                </button>
              </aside>

              <div class="mega-content" role="region" aria-label="Details">
                <section class="mega-section active" data-panel="ia">
                  <header class="mega-head">
                    <h3>Accompagnement a l'IA</h3>
                    <a href="/piliers/ia">Voir le pilier</a>
                  </header>
                  <div class="mega-items">
                    <a href="/piliers/ia" class="mega-item">
                      <strong>Pilier 1 : IA accessible</strong>
                      <span>Ateliers, diagnostics, feuilles de route pour les structures.</span>
                    </a>
                    <a href="/formations" class="mega-item">
                    <strong>Formations longues</strong>
                    <span>Tarifs conscients, parrainage, accessibles a tous.</span>
                  </a>
                  <a href="/ateliers" class="mega-item">
                    <strong>Ateliers pratiques</strong>
                      <span>Decouvrez les sessions en ligne et en presentiel.</span>
                    </a>
                    <a href="/rdv" class="mega-item">
                      <strong>Diagnostic personnalise</strong>
                      <span>Un echange de 20 minutes pour cadrer votre besoin.</span>
                    </a>
                    <a href="/ressources" class="mega-item">
                      <strong>Ressources IA</strong>
                      <span>Guides, checklists et modeles libres.</span>
                    </a>
                  </div>
                </section>

                <section class="mega-section" data-panel="cyber">
                  <header class="mega-head">
                    <h3>Lutte cyber + aide victimes</h3>
                    <a href="/piliers/cyber">Voir le pilier</a>
                  </header>
                  <div class="mega-items">
                    <a href="/piliers/cyber" class="mega-item">
                      <strong>Pilier 2 : Cyber</strong>
                      <span>Arnaques, usurpation, harponnage : on accompagne les victimes.</span>
                    </a>
                    <a href="/aide-victimes" class="mega-item">
                      <strong>Aide aux victimes</strong>
                      <span>Procedure pas-a-pas, confidentialite, gratuit.</span>
                    </a>
                    <a href="/contact?sujet=signalement" class="mega-item">
                      <strong>Signaler un contenu</strong>
                      <span>PHAROS, 3018 : on vous aide a constituer le dossier.</span>
                    </a>
                    <a href="/combats/derives-numeriques" class="mega-item">
                      <strong>Position editorial</strong>
                      <span>Notre lecture des derives numeriques.</span>
                    </a>
                  </div>
                </section>

                <section class="mega-section" data-panel="logiciels">
                  <header class="mega-head">
                    <h3>Logiciels pour associations</h3>
                    <a href="/piliers/logiciels">Voir le pilier</a>
                  </header>
                  <div class="mega-items">
                    <a href="/piliers/logiciels" class="mega-item">
                      <strong>Pilier 3 : Logiciels</strong>
                      <span>Outils libres vendus aux associations engagees.</span>
                    </a>
                    <a href="/contact?sujet=devis-logiciel" class="mega-item">
                      <strong>Devis logiciel</strong>
                      <span>Vous avez un besoin specifique ? Decrivez-le.</span>
                    </a>
                    <a href="/projects-collaboratif" class="mega-item">
                      <strong>Projets open source</strong>
                      <span>Contribuez ou reutilisez nos projets.</span>
                    </a>
                  </div>
                </section>

                <section class="mega-section" data-panel="anti">
                  <header class="mega-head">
                    <h3>Anti Pepins</h3>
                    <a href="/piliers/anti-pepins">Voir le pilier</a>
                  </header>
                  <div class="mega-items">
                    <a href="/piliers/anti-pepins" class="mega-item">
                      <strong>Pilier 4 : Anti Pepins</strong>
                      <span>Service public gratuit d'analyse de messages suspects.</span>
                    </a>
                    <a href="https://anti-pepins.biscuits-ia.com/" class="mega-item">
                      <strong>Ouvrir Anti Pepins</strong>
                      <span>Collez un SMS, mail ou lien et obtenez un avis immediat.</span>
                    </a>
                    <a href="/contact?sujet=anti-pepins-wh" class="mega-item">
                      <strong>Marque blanche</strong>
                      <span>Deployez Anti Pepins sur votre domaine d'association.</span>
                    </a>
                  </div>
                </section>
              </div>
            </div>

            <ul class="mega-mobile-menu" role="menu" aria-label="Nos piliers en mobile">
              <li role="none"><a role="menuitem" href="/piliers/ia" class="mega-mobile-link">Pilier 1 : IA</a></li>
              <li role="none"><a role="menuitem" href="/piliers/cyber" class="mega-mobile-link">Pilier 2 : Cyber + victimes</a></li>
              <li role="none"><a role="menuitem" href="/piliers/logiciels" class="mega-mobile-link">Pilier 3 : Logiciels</a></li>
              <li role="none"><a role="menuitem" href="/piliers/anti-pepins" class="mega-mobile-link">Pilier 4 : Anti Pepins</a></li>
              <li role="none"><a role="menuitem" href="/aide-victimes" class="mega-mobile-link">Aide aux victimes</a></li>
              <li role="none"><a role="menuitem" href="/ateliers" class="mega-mobile-link">Ateliers</a></li>
          <li role="none"><a role="menuitem" href="/formations" class="mega-mobile-link">Formations</a></li>
              <li role="none"><a role="menuitem" href="/rdv" class="mega-mobile-link">Prendre rendez-vous</a></li>
            </ul>
          </div>
        </li>

        <li class="nav-item has-dropdown" role="none">
          <button
            class="nav-trigger"
            aria-expanded="false"
            aria-controls="dropdown-ressources"
            aria-haspopup="true"
            data-dropdown-toggle
            role="menuitem"
          >
            Ressources
            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul id="dropdown-ressources" class="dropdown-menu" role="menu">
            <li role="none"><a role="menuitem" href="/ressources" class="dropdown-item">Ressources</a></li>
            <li role="none"><a role="menuitem" href="/faq" class="dropdown-item">FAQ</a></li>
            <li role="none"><a role="menuitem" href="/charte-ethique" class="dropdown-item">Charte ethique</a></li>
          </ul>
        </li>

        <li class="nav-item" role="none">
          <a href="/piliers" class={`nav-link ${isActive('/nos-missions') ? 'nav-link--active' : ''}`} role="menuitem">L'association</a>
        </li>
        <li class="nav-item" role="none">
          <a href="/trombinoscope" class={`nav-link ${isActive('/trombinoscope') ? 'nav-link--active' : ''}`} role="menuitem">L'equipe</a>
        </li>
        <li class="nav-item" role="none">
          <a href="/blog" class={`nav-link ${isActive('/blog') ? 'nav-link--active' : ''}`} role="menuitem">Blog</a>
        </li>
        <li class="nav-item" role="none">
          <a href="/contact" class={`nav-link ${isActive('/contact') ? 'nav-link--active' : ''}`} role="menuitem">Contact</a>

        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/rdv" class="btn-start">Prendre rendez-vous</a>
      <a href="/connexion" class="btn-login">Espace membre</a>
    </div>

    <button class="hamburger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-navigation" data-hamburger>
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="nav-backdrop" data-nav-overlay></div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border-second);
    transition: box-shadow 0.2s ease, transform 0.3s ease;
  }

  .site-header.scrolled {
    box-shadow: 0 6px 24px rgba(15, 23, 42, 0.08);
  }

  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    max-width: 1440px;
    height: 66px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
  }

  .logo-name {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .logo-accent {
    color: var(--color-primary);
  }

  .main-nav {
    flex: 1;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex-wrap: nowrap;
  }

  .nav-trigger,
  .nav-link {
    border: 0;
    background: transparent;
    color: var(--color-text-light);
    font-size: 1.1rem;
    font-weight: 500;
    padding: 0.625rem 0.875rem;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    min-height: 44px;
    white-space: nowrap;
  }

  .nav-trigger:hover,
  .nav-link:hover,
  .nav-trigger[aria-expanded="true"] {
    background: var(--color-accent-vanilla);
    color: var(--color-text);
  }

  .nav-link--active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .chevron {
    color: var(--color-text-light);
    transition: transform 0.2s ease;
  }

  .nav-trigger[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .has-dropdown,
  .has-mega {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    min-width: 0;
    inline-size: max-content;
    max-width: min(90vw, 420px);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-second);
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
    list-style: none;
    margin: 0;
    padding: 0.45rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    z-index: 1100;
  }

  .nav-trigger[aria-expanded="true"] + .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: block;
    white-space: nowrap;
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    font-size: 1.2rem;
    color: var(--color-text-light);
    text-decoration: none;
  }

  .dropdown-item:hover {
    background: var(--color-bg-alt);
    color: var(--color-text);
  }

  .mega-panel {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 0;
    right: auto;
    width: max-content;
    max-width: min(96vw, 1040px);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-second);
    border-radius: 0 0 5px 5px;
    border-top: 1px solid var(--color-border-second);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    z-index: 1050;
    max-height: min(80vh, calc(100vh - 90px));
    overflow-y: auto;
  }

  .nav-trigger[aria-expanded="true"] + .mega-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mega-grid {
    width: auto;
    max-width: 100%;
    margin: 0;
    display: grid;
    grid-template-columns: 240px minmax(560px, 760px);
    min-height: 0;
  }

  .mega-mobile-menu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mega-mobile-link {
    display: block;
    border-radius: 8px;
    padding: 0.65rem 0.75rem;
    font-size: 1.06rem;
    font-weight: 600;
    color: var(--color-text-light);
    text-decoration: none;
    min-height: 44px;
  }

  .mega-mobile-link:hover {
    background: var(--color-bg-alt);
    color: var(--color-text);
  }

  .mega-categories {
    background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-first) 100%);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mega-cat {
    border: 0;
    text-align: left;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.9rem 0.85rem;
    min-height: 44px;
    cursor: pointer;
  }

  .mega-cat:hover, .mega-cat.active {
    background-color: var(--color-primary-dark);
  }

  .mega-cat:hover {
    color: #fff;
  }

  .mega-cat.active {
    color: #fff;
  }

  .mega-content {
    padding: 1.1rem 1.25rem;
  }

  .mega-section {
    display: none;
  }

  .mega-section.active {
    display: block;
  }

  .mega-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 0.8rem;
  }

  .mega-head h3 {
    margin: 0;
    font-size: 1.75rem;
    color: var(--color-text);
    font-weight: 700;
  }

  .mega-head a {
    color: var(--color-primary);
    font-size: 1.2rem;
    margin-top: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .mega-head a:hover {
    text-decoration: underline;
  }

  .mega-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .mega-item {
    border: 1px solid var(--color-border-second);
    border-radius: 10px;
    padding: 0.85rem;
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-bg-elevated);
  }

  .mega-item:hover {
    background: var(--color-bg-alt);
    border-color: var(--color-primary);
  }

  .mega-item strong {
    display: block;
    font-size: 1.25rem;
    margin-bottom: 0.3rem;
  }

  .mega-item span {
    display: block;
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.4;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .btn-start {
    background: var(--color-primary);
    color: #fff;
    border-radius: 8px;
    padding: 0.55rem 0.9rem;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .btn-start:hover {
    background: var(--color-first);
  }

  .btn-login {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 600;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .btn-login:hover {
    background: var(--color-accent-vanilla);
  }

  .hamburger {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: var(--color-bg-alt);
    border-radius: 8px;
    padding: 0;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
  }

  .hamburger span {
    width: 20px;
    height: 2px;
    background: var(--color-text-light);
    border-radius: 999px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-backdrop {
    position: fixed;
    inset: 66px 0 0;
    background: rgba(2, 6, 23, 0.35);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    z-index: 950;
  }

  .nav-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 1023px) {
    .main-nav {
      position: fixed;
      top: 66px;
      right: -100%;
      bottom: 0;
      width: min(360px, 92vw);
      height: calc(100dvh - 66px);
      max-height: calc(100dvh - 66px);
      background: var(--color-bg-elevated);
      border-left: 1px solid var(--color-border-second);
      padding: 1rem;
      overflow-y: auto;
      transition: right 0.3s ease;
      z-index: 1001;
      flex: none;
    }

    .main-nav.active {
      right: 0;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
    }

    .nav-trigger,
    .nav-link {
      width: 100%;
      justify-content: space-between;
      font-size: 1.35rem;
    }

    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      border-left: 2px solid var(--color-border-second);
      border-radius: 0;
      margin: 0.2rem 0 0.5rem 0.75rem;
      display: none;
      inline-size: auto;
      width: calc(100% - 0.75rem);
      max-width: calc(100% - 0.75rem);
      padding: 0.3rem 0 0.3rem 0.5rem;
    }

    .nav-trigger[aria-expanded="true"] + .dropdown-menu {
      display: block;
    }

    .dropdown-item {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .mega-panel {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      margin: 0.2rem 0 0.5rem 0.75rem;
      display: none;
      width: calc(100% - 0.75rem);
      max-width: calc(100% - 0.75rem);
      max-height: none;
      overflow: visible;
    }

    .nav-trigger[aria-expanded="true"] + .mega-panel {
      display: block;
    }

    .mega-grid {
      display: none;
    }

    .mega-mobile-menu {
      display: block;
      width: 100%;
      max-width: 100%;
      border-left: 2px solid var(--color-border-second);
      padding-left: 0.5rem;
    }

    .header-actions {
      display: none;
    }

    .hamburger {
      display: inline-flex;
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding: 0 0.75rem;
    }

    .logo-name {
      font-size: 1.75rem;
    }
  }

  .nav-trigger:focus-visible,
  .nav-link:focus-visible,
  .mega-cat:focus-visible,
  .mega-item:focus-visible,
  .mega-mobile-link:focus-visible,
  .dropdown-item:focus-visible,
  .btn-start:focus-visible,
  .btn-login:focus-visible,
  .hamburger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .main-nav,
    .mega-panel,
    .dropdown-menu,
    .chevron,
    .hamburger span,
    .nav-backdrop {
      transition: none !important;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector('[data-header]') as HTMLElement | null;
    const hamburger = document.querySelector('[data-hamburger]') as HTMLButtonElement | null;
    const nav = document.getElementById('main-navigation') as HTMLElement | null;
    const overlay = document.querySelector('[data-nav-overlay]') as HTMLElement | null;
    const megaToggle = document.querySelector('[data-mega-toggle]');
    const dropdownToggle = document.querySelector('[data-dropdown-toggle]');

    if (!header || !hamburger || !nav || !overlay) return;

    const headerEl = header;
    const hamburgerEl = hamburger;
    const navEl = nav;
    const overlayEl = overlay;

    if (headerEl.dataset.initialized === 'true') {
      return;
    }
    headerEl.dataset.initialized = 'true';

    let lastScroll = 0;
    let ticking = false;

    function onScroll() {
      const y = window.scrollY;
      headerEl.classList.toggle('scrolled', y > 10);
      headerEl.classList.toggle('header-hidden', y > lastScroll && y > 90);
      lastScroll = y;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });

    function closeAllMenus() {
      document.querySelectorAll('[data-mega-toggle], [data-dropdown-toggle]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
      });
    }

    function setExpanded(el: Element | null, expanded: boolean) {
      if (!el) return;
      el.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    }

    function openMobile() {
      navEl.classList.add('active');
      hamburgerEl.setAttribute('aria-expanded', 'true');
      overlayEl.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMobile() {
      navEl.classList.remove('active');
      hamburgerEl.setAttribute('aria-expanded', 'false');
      overlayEl.classList.remove('active');
      document.body.style.overflow = '';
      closeAllMenus();
    }

    hamburgerEl.addEventListener('click', () => {
      const isOpen = navEl.classList.contains('active');
      if (isOpen) {
        closeMobile();
      } else {
        openMobile();
      }
    });

    overlayEl.addEventListener('click', closeMobile);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllMenus();
        closeMobile();
      }
    });

    navEl.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobile);
    });

    if (megaToggle) {
      megaToggle.addEventListener('click', () => {
        const isOpen = megaToggle.getAttribute('aria-expanded') === 'true';
        closeAllMenus();
        if (!isOpen) {
          megaToggle.setAttribute('aria-expanded', 'true');
        }
      });
    }

    if (dropdownToggle) {
      dropdownToggle.addEventListener('click', () => {
        const isOpen = dropdownToggle.getAttribute('aria-expanded') === 'true';
        closeAllMenus();
        if (!isOpen) {
          dropdownToggle.setAttribute('aria-expanded', 'true');
        }
      });
    }

    // Desktop hover intent: évite le clignotement/flicker du menu déroulant
    const megaItem = document.querySelector('.has-mega');
    const dropdownItem = document.querySelector('.has-dropdown');
    let closeTimer: number | undefined;

    function clearCloseTimer() {
      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }
    }

    function scheduleClose() {
      clearCloseTimer();
      closeTimer = window.setTimeout(() => {
        closeAllMenus();
      }, 120);
    }

    if (megaItem && megaToggle) {
      megaItem.addEventListener('mouseenter', () => {
        if (window.innerWidth < 1024) return;
        clearCloseTimer();
        closeAllMenus();
        setExpanded(megaToggle, true);
      });
      megaItem.addEventListener('mouseleave', () => {
        if (window.innerWidth < 1024) return;
        scheduleClose();
      });
    }

    if (dropdownItem && dropdownToggle) {
      dropdownItem.addEventListener('mouseenter', () => {
        if (window.innerWidth < 1024) return;
        clearCloseTimer();
        closeAllMenus();
        setExpanded(dropdownToggle, true);
      });
      dropdownItem.addEventListener('mouseleave', () => {
        if (window.innerWidth < 1024) return;
        scheduleClose();
      });
    }

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      if (!target.closest('.has-mega') && !target.closest('.has-dropdown')) {
        closeAllMenus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        closeMobile();
      }
    });

    const categoryButtons = document.querySelectorAll('.mega-cat') as NodeListOf<HTMLButtonElement>;

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-cat');
        if (!target) return;

        categoryButtons.forEach((other) => {
          other.classList.remove('active');
          other.setAttribute('aria-selected', 'false');
        });

        button.classList.add('active');
        button.setAttribute('aria-selected', 'true');

        document.querySelectorAll('.mega-section').forEach((panel) => {
          panel.classList.remove('active');
        });

        const targetPanel = document.querySelector(`[data-panel="${target}"]`);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });

      button.addEventListener('mouseenter', () => {
        if (window.innerWidth >= 1024) {
          button.click();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

