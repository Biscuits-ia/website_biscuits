---
import { Image } from "astro:assets";
// Source WebP lossy q=80 (154 Ko) au lieu du PNG d'origine (1.59 Mo).
// La dimension source est 1200x800 max ; Astro re-decoupe aux breakpoints
// 400/800/1200 declares ci-dessous.
import Logo from '../assets/logo.webp';
---

<section class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden bg-(--color-bg)" data-hero-section>
  
  <!-- Contenu Hero -->
  <div class="hero-content relative z-10 max-w-350 w-full grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
    
    <!-- Texte Hero -->
    <div class="hero-text flex flex-col gap-6 text-center lg:text-left items-center lg:items-start">
      <h1 class="hero-title text-4xl md:text-6xl lg:text-7xl font-extrabold leading-tight text-(--color-text) animate-fadeInUp opacity-0">
       L'intelligence artificielle au service de l'intérêt général.
      </h1>
      <p class="hero-badge animate-fadeInUp opacity-0" style="animation-delay: 0.3s;">
        Gratuit · Simple · Prêt à l'emploi
      </p>
      <p class="hero-subtitle animate-fadeInUp opacity-0" style="animation-delay: 0.5s;">
Nous aidons les associations, collectivités et professionnels à adopter une intelligence artificielle utile, responsable et accessible.      </p>

      <!-- CTA Buttons -->
      <div class="hero-cta-grid">
        <div class="hero-cta animate-fadeInUp opacity-0" style="animation-delay: 1s;">
          <a href="/nos-missions" class="btn-hero-primary">
            Découvrir nos actions
          </a>
        </div>

        <div class="hero-cta animate-fadeInUp opacity-0" style="animation-delay: 1.2s;">
          <a href="/rejoignez-nous" class="btn-hero-secondary">
            Nous rejoindre
          </a>
        </div>
      </div>
    </div>

    <!-- Visual Hero -->
    <div class="hero-visual relative hidden lg:flex lg:items-center lg:justify-end animate-fadeInRight opacity-0" style="animation-delay: 0.6s;">
      <div class="visual-card relative rounded-[20px]" style="max-width: 520px; width: 100%;">
        <Image
          src={Logo}
          alt="L’IA au service de l’intérêt général : accompagner les associations et TPE vers un numérique humain"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
          quality={80}
          class="w-full h-auto block"
        />
        <p class="visual-caption">
          Des outils IA simples, gratuits et prêts à l'emploi pour vos bénévoles
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  h1 {
    text-align: left;
  }
  .visual-caption {
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-md);
    padding: 1rem;
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-text-light);
    font-weight: 500;
    line-height: 1.5;
    margin-top: 1rem;
    background: var(--color-bg-alt);
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-light);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 0.25rem 0.875rem;
    letter-spacing: 0.02em;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.8s ease-out both;
  }

  .animate-fadeInRight {
    animation: fadeInRight 1s ease-out both;
  }

  /* Effet de brillance sur le bouton */
  .btn-shine {
    pointer-events: none;
  }

  .hero-content {
    margin-top: clamp(4rem, 10vh, 8rem);
    padding: 0 2rem;
  }

  .hero-cta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    width: 100%;
    max-width: 400px;
  }

  @media (min-width: 640px) {
    .hero-cta-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      max-width: none;
    }
  }

  .hero-cta {
    width: 100%;
  }

  /* === HERO BUTTONS === */
  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem 2rem;
    background: var(--color-primary);
    color: var(--color-bg);
    font-weight: 800;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    white-space: nowrap;
  }

  .btn-hero-primary:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-xl);
    color: var(--color-bg);
  }

  .btn-hero-primary:active {
    transform: translate(3px, 3px);
    box-shadow: var(--shadow-sm);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem 2rem;
    background: transparent;
    color: var(--color-text);
    font-weight: 800;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
    white-space: nowrap;
  }

  .btn-hero-secondary:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-xl);
    background: var(--color-bg-alt);
  }

  .btn-hero-secondary:active {
    transform: translate(3px, 3px);
    box-shadow: var(--shadow-sm);
  }

  .btn-secondary {
    background: var(--color-bg-alt);
    color: var(--color-text);
    border: var(--brutal-border);
    box-shadow: var(--shadow-md);
  }

  .btn-secondary:hover {
    box-shadow: var(--shadow-lg);
  }

 

  /* Désactiver les animations si préférence utilisateur */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    
    .hero-subtitle,
    .hero-title,
    .feature-badge,
    .hero-cta,
    .trust-indicators,
    .hero-visual {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Pas de hover sur mobile */
  @media (hover: none) {
    .feature-badge:hover {
      transform: none;
    }
    
    .btn-primary:hover {
      transform: none;
    }
  }
</style>