---
import { Image } from "astro:assets";
import Logo from '@/assets/logo.png';
---

<section class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden bg-[var(--color-bg)] px-4 py-8 md:py-16" data-hero-section>
  
  <!-- Contenu Hero -->
  <div class="hero-content relative z-10 max-w-[1400px] w-full grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
    
    <!-- Texte Hero -->
    <div class="hero-text flex flex-col gap-6 text-center lg:text-left items-center lg:items-start">
      <h1 class="hero-title text-4xl md:text-6xl lg:text-7xl font-extrabold leading-tight text-[var(--color-text)] animate-fadeInUp opacity-0">
        Une association au service des solutions tech et du développement IA
      </h1>
      
      <!-- CTA Button -->
     <div class="hero-cta mt-6 animate-fadeInUp opacity-0" style="animation-delay: 1s;">
        <a href="/devis" 
           id="hero-cta-btn"
           class="btn-primary inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] font-semibold text-lg rounded-xl shadow-[var(--shadow-glow)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-glow-hover)] relative overflow-hidden group">
          <span class="btn-text relative z-10">Demander votre devis gratuit</span>
          <span class="btn-shine absolute inset-0 -left-full w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-all duration-500 group-hover:left-full"></span>
        </a>
      </div>
      <!-- Trust indicators -->
      <div class="trust-indicators flex flex-col sm:flex-row gap-6 sm:gap-12 mt-8 animate-fadeInUp opacity-0" style="animation-delay: 1.2s;">
        <div class="trust-item flex flex-col gap-1 text-center lg:text-left">
          <strong class="counter-value text-3xl md:text-4xl font-extrabold bg-gradient-to-r from-[var(--color-first)] to-[var(--color-secondary)] bg-clip-text text-transparent">15</strong>
          <span class="text-sm text-[var(--color-text-light)]">bénévoles engagés</span>
        </div>
        <div class="trust-item flex flex-col gap-1 text-center lg:text-left">
          <strong class="counter-value text-3xl md:text-4xl font-extrabold bg-gradient-to-r from-[var(--color-first)] to-[var(--color-secondary)] bg-clip-text text-transparent">+85%</strong>
          <span class="text-sm text-[var(--color-text-light)]">structures sensibilisées</span>
        </div>
        <div class="trust-item flex flex-col gap-1 text-center lg:text-left">
          <strong class="counter-value text-3xl md:text-4xl font-extrabold bg-gradient-to-r from-[var(--color-first)] to-[var(--color-secondary)] bg-clip-text text-transparent">+135</strong>
          <span class="text-sm text-[var(--color-text-light)]">Accompagnement</span>
        </div>
      </div>
    </div>

    <!-- Visual Hero -->
    <div class="hero-visual relative hidden lg:block animate-fadeInRight opacity-0" style="animation-delay: 0.6s;">
      <div class="visual-card relative rounded-[20px]">
        <Image 
          src={Logo}
          alt="Solutions tech et développement IA - Biscuits Dev"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
          format="webp"
          loading="eager"
          quality={80}
          class="w-full h-auto block"
        />
        <h2 class="hero-title text-4xl md:text-6xl lg:text-7xl font-extrabold leading-tight text-[var(--color-text)] animate-fadeInUp opacity-0">
          Nous luttons contre les abus du numérique et rendons l'IA accessible à tous.
        </h2>
      </div>
    </div>
  </div>
</section>

<style>
  h1 {
    text-align: left;
  }
  h2 {
    border: 5px solid #000;
    box-shadow: 5px 5px 0px 0px #000;
    padding: 10px;
    text-align: center;
    font-size: 1.5rem;
    color: var(--color-text-light);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-gray-300);
    margin: 0 auto;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes floatElement {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  @keyframes float1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -30px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.8s ease-out both;
  }

  .animate-fadeInRight {
    animation: fadeInRight 1s ease-out both;
  }

  .animate-floatElement {
    animation: floatElement 3s ease-in-out infinite;
  }

  .animate-float1 {
    animation: float1 20s ease-in-out infinite;
  }

  /* Effet de brillance sur le bouton */
  .btn-shine {
    pointer-events: none;
  }

  .hero-content {
    margin-top: 10vh;
  }

 

  /* Désactiver les animations si préférence utilisateur */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    
    .hero-subtitle,
    .hero-title,
    .feature-badge,
    .hero-cta,
    .trust-indicators,
    .hero-visual {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Pas de hover sur mobile */
  @media (hover: none) {
    .feature-badge:hover {
      transform: none;
    }
    
    .btn-primary:hover {
      transform: none;
    }
  }
</style>
