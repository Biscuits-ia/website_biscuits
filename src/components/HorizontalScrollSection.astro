---
/**
 * Composant de showcase des services avec animations GSAP typées
 * Utilise le système de typage strict pour une meilleure maintenabilité
 */

interface Service {
  icon: string;
  title: string;
  description: string;
  features: string[];
  price?: string;
  badge?: string;
}

const services: Service[] = [
  {
    icon: "🤖",
    title: "Assistants IA Personnalisés",
    description: "Agents intelligents qui automatisent vos tâches et améliorent votre productivité.",
    features: ["GPT-4 & Claude", "RAG avancé", "Multi-sources", "API ready"],
    price: "900",
    badge: "Populaire"
  },
  {
    icon: "⚙️",
    title: "Automatisation Workflows",
    description: "Gagnez du temps avec des processus automatisés intelligents et fiables.",
    features: ["Workflows complexes", "Intégrations SaaS", "Monitoring", "Logs détaillés"],
    price: "600"
  },
  {
    icon: "🚀",
    title: "Starter Kits Premium",
    description: "Bases techniques prêtes à produire avec architecture scalable et code propre.",
    features: ["Auth & Paiements", "API modernes", "UI/UX optimisée", "Documentation"],
    price: "1200",
    badge: "Nouveau"
  },
  {
    icon: "🧩",
    title: "Solutions SaaS IA",
    description: "Plateformes complètes avec intelligence artificielle intégrée.",
    features: ["Backend scalable", "Multi-tenant", "Analytics IA", "Support continu"],
    price: "5000"
  }
];

interface Stat {
  icon: string;
  value: number;
  label: string;
  suffix?: string;
  color?: string;
}

const stats: Stat[] = [
  { icon: "⚡", value: 95, label: "Automatisation", suffix: "%", color: "first" },
  { icon: "🎯", value: 48, label: "Heures économisées/mois", suffix: "h", color: "secondary" },
  { icon: "🚀", value: 300, label: "ROI moyen", suffix: "%", color: "primary" }
];
---

<section class="animated-showcase" data-showcase>
  <!-- Hero avec scroll horizontal -->
  <div class="horizontal-container" data-horizontal-section>
    <div class="horizontal-wrapper">
      {services.map((service, index) => (
        <div class="service-panel" data-panel={index}>
          <div class="panel-bg" data-parallax-bg></div>
                    
          <div class="panel-content">
            <span class="panel-number" data-parallax-number>{String(index + 1).padStart(2, '0')}</span>
            <div class="service-icon" data-float>{service.icon}</div>
            <h2 class="service-title" data-split-text>{service.title}</h2>
            <p class="service-description">{service.description}</p>
                {service.badge && (
                <div class="service-badge" data-badge>{service.badge}</div>
            )}
          
            {service.price && (
              <div class="service-price">
                <span class="price-label">À partir de</span>
                <span class="price-value">
                  <span data-counter-animate>{service.price}</span>€
                </span>
                <span class="price-ht">HT</span>
              </div>
            )}
            
            <a href="/devis" class="cta-magnetic">
              <span class="cta-text">Demander un devis</span>
              <span class="cta-arrow">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Section statistiques avec parallaxe -->
  <div class="stats-section">
    <div class="container">
      <h2 class="stats-title" data-reveal>Résultats Concrets</h2>
      <div class="stats-grid">
        {stats.map((stat, index) => (
          <div class="stat-card" data-morph data-index={index}>
            <div class="stat-icon" data-float>{stat.icon}</div>
            <div class="stat-number" data-counter data-target={stat.value}>0</div>
            <div class="stat-suffix">{stat.suffix}</div>
            <div class="stat-label">{stat.label}</div>
            <div class="stat-visual">
              <div class="stat-bar" data-progress={stat.value}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA final avec effet split -->
  <div class="final-cta" data-split-reveal>
    <div class="cta-left" data-slide-left>
      <h2>Prêt à transformer<br/>votre activité ?</h2>
      <p>Discutons de votre projet et découvrez comment l'IA peut vous aider.</p>
      <ul class="cta-benefits">
        <li data-clip-reveal>✓ Devis gratuit sous 24-48h</li>
        <li data-clip-reveal>✓ Consultation technique offerte</li>
        <li data-clip-reveal>✓ Solutions sur mesure</li>
      </ul>
    </div>
    <div class="cta-right" data-slide-right>
      <a href="/contact" class="cta-button-3d">
        <span class="button-face button-front">Contactez-nous</span>
        <span class="button-face button-top">Démarrez maintenant</span>
      </a>
    </div>
  </div>
</section>

<style>
  .animated-showcase {
  width: 100%;
  overflow-x: hidden;
  background: var(--color-bg);
}

.horizontal-container {
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.horizontal-wrapper {
  display: flex;
  height: 100vh;
  width: 400vw;
}

.service-panel {
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 4rem;
  overflow: hidden;
}

.panel-bg {
  position: absolute;
  inset: 0;
  opacity: 0.3;
  z-index: 0;
}

.service-panel:nth-child(1) .panel-bg {
  background: radial-gradient(var(--color-primary-dark), transparent 70%);
}

.service-panel:nth-child(2) .panel-bg {
  background: radial-gradient(var(--color-primary), transparent 70%);
}

.service-panel:nth-child(3) .panel-bg {
  background: radial-gradient(var(--color-primary-dark), transparent 70%);
}

.service-panel:nth-child(4) .panel-bg {
  background: radial-gradient(var(--color-primary), transparent 70%);
}

.service-badge {
  position: absolute;
  top: 2rem;
  right: 2rem;
  background: linear-gradient(135deg, var(--color-first), var(--color-secondary));
  color: var(--color-bg);
  padding: 0.5rem 1.5rem;
  border-radius: var(--radius-full);
  font-size: 0.9rem;
  font-weight: 700;
  z-index: 10;
  box-shadow: var(--shadow-lg);
}

.panel-content {
  max-width: 700px;
  color: var(--color-text);
  position: relative;
  z-index: 2;
  text-align: center;
}

.panel-number {
  position: absolute;
  font-size: clamp(8rem, 15vw, 12rem);
  font-weight: 900;
  color: var(--color-primary);
  opacity: 0.1;
  top: -3rem;
  left: 50%;
  transform: translateX(-50%);
  line-height: 1;
  pointer-events: none;
}

.service-icon {
  font-size: clamp(4rem, 8vw, 6rem);
  margin-bottom: 2rem;
  display: inline-block;
  filter: drop-shadow(0 0 20px var(--color-primary));
}

.service-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  margin-bottom: 1.5rem;
  color: var(--color-primary-light);
  line-height: 1.2;
}

.service-description {
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  padding: 20px;
  line-height: 1.7;
  opacity: 0.9;
  margin-bottom: 2.5rem;
  color: var(--color-gray-300);
}

.feature-tag:hover {
  background: var(--color-primary);
  color: var(--color-bg);
  transform: translateY(-2px);
}

.tag-dot {
  width: 6px;
  height: 6px;
  background: var(--color-secondary);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

.service-price {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 2rem;
}

.price-label {
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  opacity: 0.7;
}

.price-value {
  font-size: 3rem;
  font-weight: 800;
  color: var(--color-first);
  line-height: 1;
}

.price-ht {
  font-size: 1rem;
  opacity: 0.6;
}

.cta-magnetic {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem 2.5rem;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: var(--color-bg);
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 1.1rem;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: var(--shadow-lg);
  position: relative;
  overflow: hidden;
}

.cta-magnetic::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--color-secondary), var(--color-first));
  opacity: 0;
  transition: opacity 0.3s ease;
}

.cta-magnetic:hover::before {
  opacity: 1;
}

.cta-magnetic:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-glow-hover);
}

.cta-text,
.cta-arrow {
  position: relative;
  z-index: 1;
}

.cta-arrow {
  font-size: 1.5rem;
  transition: transform 0.3s ease;
}

.cta-magnetic:hover .cta-arrow {
  transform: translateX(5px);
}

/* ===== STATS SECTION ===== */
.stats-section {
  padding: 8rem 2rem;
  position: relative;
}

.stats-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.stats-title {
  text-align: center;
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: var(--color-primary-light);
  margin-bottom: 4rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2.5rem;
}

.stat-card {
  background: var(--glass-bg);
  border: 1px solid var(--color-primary);
  border-radius: 20px;
  padding: 3rem 2rem;
  text-align: center;
  backdrop-filter: blur(20px);
  position: relative;
  overflow: hidden;
  transition: all 0.4s ease;
}

.stat-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, var(--color-primary), transparent 70%);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.stat-card:hover {
  transform: translateY(-10px) scale(1.02);
  border-color: var(--color-secondary);
  box-shadow: var(--shadow-glow-hover);
}

.stat-card:hover::before {
  opacity: 0.15;
}

.stat-icon {
  font-size: 3rem;
  margin-bottom: 1.5rem;
  filter: drop-shadow(0 0 15px var(--color-secondary));
}

.stat-number {
  font-size: 4.5rem;
  font-weight: 900;
  color: var(--color-first);
  line-height: 1;
  position: relative;
  display: inline-block;
}

.stat-suffix {
  display: inline-block;
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--color-first);
  opacity: 0.8;
  margin-left: 0.25rem;
}

.stat-label {
  font-size: 1.1rem;
  color: var(--color-gray-300);
  opacity: 0.9;
  margin: 1rem 0 1.5rem;
  font-weight: 600;
}

.stat-visual {
  width: 100%;
  height: 6px;
  background: var(--color-border);
  border-radius: 10px;
  overflow: hidden;
  position: relative;
}

.stat-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
  border-radius: 10px;
  width: 0;
  transition: width 2s cubic-bezier(0.65, 0, 0.35, 1);
  box-shadow: 0 0 10px var(--color-primary);
}

.final-cta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  padding: 8rem 4rem;
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
}

.final-cta::before {
  content: '';
  position: absolute;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, var(--color-primary), transparent);
  opacity: 0.15;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  animation: rotate 20s linear infinite;
}

@keyframes rotate {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.cta-left,
.cta-right {
  position: relative;
  z-index: 2;
}

.cta-left h2 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: var(--color-primary-light);
  margin-bottom: 1.5rem;
  line-height: 1.2;
}

.cta-left p {
  font-size: 1.3rem;
  color: var(--color-gray-300);
  opacity: 0.9;
  line-height: 1.7;
  margin-bottom: 2rem;
}

.cta-benefits {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.cta-benefits li {
  font-size: 1.1rem;
  color: var(--color-primary-light);
  padding-left: 0.5rem;
}

.cta-right {
  display: flex;
  justify-content: center;
}

.cta-button-3d {
  position: relative;
  display: inline-block;
  width: 280px;
  height: 80px;
  text-decoration: none;
  perspective: 1000px;
  transform-style: preserve-3d;
}

.button-face {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-weight: 700;
  font-size: 1.2rem;
  border-radius: 15px;
  transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.button-front {
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: var(--color-bg);
  transform: translateZ(40px);
  box-shadow: var(--shadow-lg);
}

.button-top {
  background: var(--color-first);
  color: var(--color-bg);
  transform: rotateX(90deg) translateZ(40px);
}

.cta-button-3d:hover .button-front {
  transform: translateZ(40px) rotateX(-90deg);
}

.cta-button-3d:hover .button-top {
  transform: rotateX(0deg) translateZ(40px);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .service-panel {
    padding: 2rem;
  }

  .final-cta {
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 4rem 2rem;
    text-align: center;
  }

  .cta-benefits {
    align-items: center;
  }
}

@media (max-width: 768px) {
  .horizontal-wrapper {
    width: auto;
    flex-direction: column;
    height: auto;
  }

  .service-panel {
    width: 100vw;
    height: auto;
    min-height: 100vh;
    padding: 3rem 1.5rem;
  }

  .stats-section {
    padding: 4rem 1.5rem;
  }

  .stats-grid {
    gap: 2rem;
  }

  .stat-number {
    font-size: 3.5rem;
  }
}
</style>

<script>
  import type {
    ScrollTriggerInstance,
  } from '@/animations/core/animation-types';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ===== TYPES =====
  interface CounterState {
    value: number;
  }

  interface ProgressBarElement extends HTMLElement {
    dataset: {
      progress?: string;
    };
  }

  // ===== UTILITIES =====
  function shouldReduceMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function querySelectorAll<T extends Element = Element>(
    selector: string
  ): T[] {
    return Array.from(document.querySelectorAll<T>(selector));
  }

  function getElementRect(element: HTMLElement) {
    return element.getBoundingClientRect();
  }

  // ===== ANIMATIONS =====
  if (!shouldReduceMotion()) {
    const triggers: ScrollTriggerInstance[] = [];

    // Horizontal scroll (desktop only)
    const container = document.querySelector<HTMLElement>('[data-horizontal-section]');
    const wrapper = container?.querySelector<HTMLElement>('.horizontal-wrapper');
    const panels = querySelectorAll<HTMLElement>('.service-panel');

    if (container && wrapper && panels.length && window.innerWidth > 768) {
      const animation = gsap.to(panels, {
        xPercent: -100 * (panels.length - 1),
        ease: 'none',
        scrollTrigger: {
          trigger: container,
          pin: true,
          scrub: 1,
          snap: 1 / (panels.length - 1),
          end: () => `+=${wrapper.offsetWidth - window.innerWidth}`,
        },
      });

      if (animation.scrollTrigger) {
        triggers.push(animation.scrollTrigger);
      }
    }

    // Parallax backgrounds
    querySelectorAll<HTMLElement>('[data-parallax-bg]').forEach((el) => {
      gsap.to(el, {
        y: () => window.innerHeight * 0.3,
        ease: 'none',
        scrollTrigger: {
          trigger: el,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        },
      });
    });

    // Floating icons
    querySelectorAll<HTMLElement>('[data-float]').forEach((el) => {
      gsap.to(el, {
        y: -20,
        duration: 2,
        repeat: -1,
        yoyo: true,
        ease: 'power1.inOut',
      });
    });

    // Stats animation
    const statCards = querySelectorAll<HTMLElement>('[data-morph]');
    statCards.forEach((card, i) => {
      gsap.from(card, {
        opacity: 0,
        scale: 0.8,
        rotateY: -15,
        duration: 1,
        delay: i * 0.2,
        scrollTrigger: {
          trigger: card,
          start: 'top 80%',
        },
      });
    });

    // Counter animation
    const counters = querySelectorAll<HTMLElement>('[data-counter]');
    counters.forEach((counter) => {
      const target = parseInt(counter.dataset.target ?? counter.textContent ?? '0', 10);
      const state: CounterState = { value: 0 };

      const trigger = ScrollTrigger.create({
        trigger: counter,
        start: 'top 80%',
        onEnter: () => {
          gsap.to(state, {
            value: target,
            duration: 2,
            ease: 'power2.out',
            onUpdate: () => {
              counter.textContent = Math.round(state.value).toString();
            },
          });
        },
      });

      triggers.push(trigger);
    });

    // Progress bars
    const bars = querySelectorAll<ProgressBarElement>('[data-progress]');
    bars.forEach((bar) => {
      const progress = parseInt(bar.dataset.progress ?? '0', 10);
      
      const trigger = ScrollTrigger.create({
        trigger: bar,
        start: 'top 80%',
        onEnter: () => {
          gsap.to(bar, {
            width: `${progress}%`,
            duration: 2,
            ease: 'power2.out',
          });
        },
      });

      triggers.push(trigger);
    });

    // Split reveal
    const splitSection = document.querySelector<HTMLElement>('[data-split-reveal]');
    if (splitSection) {
      const left = splitSection.querySelector<HTMLElement>('[data-slide-left]');
      const right = splitSection.querySelector<HTMLElement>('[data-slide-right]');

      if (left) {
        gsap.from(left, {
          x: -100,
          opacity: 0,
          duration: 1,
          scrollTrigger: {
            trigger: splitSection,
            start: 'top 70%',
          },
        });
      }

      if (right) {
        gsap.from(right, {
          x: 100,
          opacity: 0,
          duration: 1,
          scrollTrigger: {
            trigger: splitSection,
            start: 'top 70%',
          },
        });
      }
    }

    // Clip reveal items
    const clipItems = querySelectorAll<HTMLElement>('[data-clip-reveal]');
    clipItems.forEach((item, i) => {
      gsap.from(item, {
        opacity: 0,
        x: -20,
        duration: 0.6,
        delay: i * 0.1,
        scrollTrigger: {
          trigger: item,
          start: 'top 90%',
        },
      });
    });

    // Magnetic buttons
    const magneticBtns = querySelectorAll<HTMLElement>('.cta-magnetic, .cta-button-3d');
    magneticBtns.forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        gsap.to(btn, { scale: 1.05, duration: 0.3 });
      });

      btn.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = getElementRect(btn);
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        gsap.to(btn, {
          x: x * 0.2,
          y: y * 0.2,
          duration: 0.3,
        });
      });

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, {
          x: 0,
          y: 0,
          scale: 1,
          duration: 0.5,
          ease: 'elastic.out(1, 0.5)',
        });
      });
    });

    // Reveal title
    const revealTitle = document.querySelector<HTMLElement>('[data-reveal]');
    if (revealTitle) {
      gsap.from(revealTitle, {
        opacity: 0,
        y: 50,
        duration: 1,
        scrollTrigger: {
          trigger: revealTitle,
          start: 'top 80%',
        },
      });
    }

    // Cleanup
    document.addEventListener('astro:before-preparation', () => {
      triggers.forEach((trigger) => {
        if (trigger) trigger.kill();
      });
    });
  }
</script>