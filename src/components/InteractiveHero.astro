---
/**
 * Hero section optimisé - Particules désactivées sur mobile et devices bas de gamme
 */

const {
  title = "Créez le futur avec l'IA",
  subtitle = "Solutions intelligentes, automatisations avancées et starter kits pour développeurs modernes",
  ctaPrimary = { text: "Démarrer un projet", href: "/devis" },
  ctaSecondary = { text: "Explorer nos services", href: "/services" }
} = Astro.props;
---

<section class="interactive-hero" data-hero-section>
  <!-- Canvas for particles (hidden on mobile/low-end) -->
  <canvas id="particles-canvas" aria-hidden="true" data-particles></canvas>
  
  <!-- Simplified gradient background (fallback) -->
  <div class="gradient-bg" aria-hidden="true"></div>

  <!-- Content -->
  <div class="hero-content">
    <div class="hero-badge" data-badge>
      <span class="badge-icon">✨</span>
      <span class="badge-text">Nouveau : IA + Automation</span>
    </div>

    <h1 class="hero-title" data-title>
      {title.split(' ').map((word: string, i: number) => (
        <span class="title-word" data-word={i}>{word} </span>
      ))}
    </h1>

    <p class="hero-subtitle" data-subtitle>
      {subtitle}
    </p>

    <div class="hero-stats" data-stats>
      <div class="stat-item">
        <span class="stat-number" data-counter="50">0</span>
        <span class="stat-label">Projets livrés</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number" data-counter="95">0</span>
        <span class="stat-suffix">%</span>
        <span class="stat-label">Satisfaction client</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number" data-counter="24">0</span>
        <span class="stat-suffix">h</span>
        <span class="stat-label">Réponse moyenne</span>
      </div>
    </div>

    <div class="hero-ctas" data-ctas>
      <a href={ctaPrimary.href} class="cta-primary">
        <span class="cta-text">{ctaPrimary.text}</span>
        <span class="cta-arrow">→</span>
      </a>
      <a href={ctaSecondary.href} class="cta-secondary">
        <span class="cta-text">{ctaSecondary.text}</span>
        <span class="cta-icon">🔍</span>
      </a>
    </div>
</section>

<style>
  /* ===== InteractiveHero.astro - CSS CORRIGÉ ===== */

.interactive-hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  background: var(--color-bg);
  position: relative;
  overflow: hidden;
  contain: layout style paint;
  will-change: auto;
}

#particles-canvas {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

@media (max-width: 768px) {
  #particles-canvas {
    display: none;
  }
}

.gradient-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  opacity: 0.2;
}

.hero-content {
  max-width: 900px;
  text-align: center;
  position: relative;
  z-index: 2;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1.5rem;
  background: var(--glass-bg);
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-full);
  margin-bottom: 2.5rem;
  backdrop-filter: blur(10px);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.hero-badge:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-glow);
}

.badge-icon {
  font-size: 1.25rem;
}

.badge-text {
  color: var(--color-gray-100);
  font-weight: 600;
  font-size: 0.95rem;
}

.hero-title {
  font-size: clamp(3rem, 8vw, 6rem);
  font-weight: 900;
  color: var(--color-primary-light);
  margin-bottom: 2rem;
  line-height: 1.1;
}

.title-word {
  display: inline-block;
  background: linear-gradient(135deg, 
    var(--color-primary-light), 
    var(--color-first), 
    var(--color-secondary)
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  background-size: 200% auto;
}

.title-word.animated {
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% { background-position: 0% center; }
  50% { background-position: 100% center; }
}

.hero-subtitle {
  font-size: clamp(1.1rem, 2.5vw, 1.5rem);
  color: var(--color-text-light);
  line-height: 1.7;
  margin-bottom: 3rem;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}

/* Stats */
.hero-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  margin-bottom: 3rem;
  padding: 2rem;
  background: var(--glass-bg);
  border: 1px solid var(--color-border);
  border-radius: 20px;
  backdrop-filter: blur(10px);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.stat-number {
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--color-first);
  line-height: 1;
}

.stat-suffix {
  font-size: 1.75rem;
  font-weight: 900;
  color: var(--color-first);
  opacity: 0.8;
}

.stat-label {
  font-size: 0.9rem;
  color: var(--color-text-light);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.stat-divider {
  width: 1px;
  height: 40px;
  background: var(--color-border);
}

/* CTAs */
.hero-ctas {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 4rem;
}

.cta-primary,
.cta-secondary {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1.25rem 2.5rem;
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 1.1rem;
  text-decoration: none;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  position: relative;
  overflow: hidden;
}

.cta-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: var(--color-bg);
  box-shadow: var(--shadow-lg);
}

.cta-primary:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-glow-hover);
}

.cta-secondary {
  background: var(--glass-bg);
  border: 2px solid var(--color-primary);
  color: var(--color-gray-100);
}

.cta-secondary:hover {
  background: var(--color-bg-elevated);
  transform: translateY(-4px);
}

/* Responsive */
@media (max-width: 768px) {
  .interactive-hero {
    padding: 3rem 1.5rem;
  }

  .hero-stats {
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  .stat-divider {
    width: 80%;
    height: 1px;
  }

  .hero-ctas {
    flex-direction: column;
    width: 100%;
  }

  .cta-primary,
  .cta-secondary {
    width: 100%;
    justify-content: center;
  }
}
</style>
<script>
  import { gsap } from 'gsap';
  import { 
    rafThrottle, 
    isLowEndDevice, 
    isMobile, 
    shouldReduceAnimations,
    FPSMonitor,
    addPassiveEventListener
  } from '@/animations/utils/performance-utils';

  const shouldReduce = shouldReduceAnimations();
  const isLowEnd = isLowEndDevice();
  const mobile = isMobile();

  // ===== OPTIMIZED PARTICLES =====
  const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement;
  
  if (canvas && !shouldReduce && !mobile && !isLowEnd) {
    const ctx = canvas.getContext('2d', { 
      alpha: true,
      desynchronized: true // Performance boost
    });

    if (!ctx) {
      canvas.style.display = 'none';
    } else {

    let particles: Array<{
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      opacity: number;
    }> = [];

    let rafId: number | null = null;
    const MAX_PARTICLES = 50; // Réduit de 100 à 50
    const CONNECTION_DISTANCE = 100; // Réduit de 120 à 100

    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2); // Max 2x
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      ctx!.scale(dpr, dpr);
    }

    function createParticles() {
      particles = [];
      const particleCount = Math.min(
        Math.floor((canvas.width * canvas.height) / 20000),
        MAX_PARTICLES
      );
      
      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          vx: (Math.random() - 0.5) * 0.3, // Réduit la vitesse
          vy: (Math.random() - 0.5) * 0.3,
          size: Math.random() * 1.5 + 0.5, // Particules plus petites
          opacity: Math.random() * 0.4 + 0.1,
        });
      }
    }

    let lastFrameTime = 0;
    const TARGET_FPS = 60;
    const FRAME_DURATION = 1000 / TARGET_FPS;

    function animate(currentTime: number) {
      // Throttle to 60fps max
      if (currentTime - lastFrameTime < FRAME_DURATION) {
        rafId = requestAnimationFrame(animate);
        return;
      }
      lastFrameTime = currentTime;

      ctx!.clearRect(0, 0, window.innerWidth, window.innerHeight);

      // Update and draw particles
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        if (!p) continue;
        
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > window.innerWidth) p.vx *= -1;
        if (p.y < 0 || p.y > window.innerHeight) p.vy *= -1;

        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255, 255, 255, ${p.opacity})`;
        ctx!.fill();
      }

      // Draw connections (optimized - skip some checks)
      for (let i = 0; i < particles.length; i++) {
        const p1 = particles[i];
        if (!p1) continue;
        
        // Check only with next 3 particles instead of all
        for (let j = i + 1; j < Math.min(i + 4, particles.length); j++) {
          const p2 = particles[j];
          if (!p2) continue;
          
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const distSq = dx * dx + dy * dy; // Avoid sqrt

          if (distSq < CONNECTION_DISTANCE * CONNECTION_DISTANCE) {
            const dist = Math.sqrt(distSq);
            ctx!.beginPath();
            ctx!.moveTo(p1.x, p1.y);
            ctx!.lineTo(p2.x, p2.y);
            ctx!.strokeStyle = `rgba(255, 255, 255, ${(1 - dist / CONNECTION_DISTANCE) * 0.15})`;
            ctx!.lineWidth = 0.5;
            ctx!.stroke();
          }
        }
      }

      rafId = requestAnimationFrame(animate);
    }

    resizeCanvas();
    createParticles();
    rafId = requestAnimationFrame(animate);

    // Throttled resize
    const handleResize = rafThrottle(() => {
      resizeCanvas();
      createParticles();
    });

    addPassiveEventListener(window, 'resize', handleResize);

    // Pause when not visible
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      } else if (!document.hidden && !rafId) {
        rafId = requestAnimationFrame(animate);
      }
    });

    // Cleanup
    document.addEventListener('astro:before-preparation', () => {
      if (rafId) cancelAnimationFrame(rafId);
    });
    }
  } else if (canvas) {
    // Hide canvas if particles disabled
    canvas.style.display = 'none';
  }

  // ===== GSAP ANIMATIONS (OPTIMIZED) =====
  if (!shouldReduce) {
    const fpsMonitor = new FPSMonitor();
    fpsMonitor.start();

    // Check FPS after 2 seconds
    setTimeout(() => {
      const isPerformant = fpsMonitor.isPerformant();
      fpsMonitor.stop();

      // Enable animations only if performant
      if (isPerformant) {
        document.querySelectorAll('.title-word').forEach((word) => {
          word.classList.add('animated');
        });
      }
    }, 2000);

    const tl = gsap.timeline({ 
      delay: 0.3,
      defaults: { ease: 'power3.out' }
    });

    // Optimized animations - batch similar elements
    tl.from('[data-badge]', { opacity: 0, y: -20, duration: 0.6 })
      .from('[data-word]', { opacity: 0, y: 30, stagger: 0.08, duration: 0.5 }, '-=0.3')
      .from('[data-subtitle]', { opacity: 0, y: 20, duration: 0.5 }, '-=0.2')
      .from('[data-stats]', { opacity: 0, scale: 0.95, duration: 0.5 }, '-=0.1');

    // Counter animation
    const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
    counters.forEach((counter) => {
      const target = parseInt(counter.dataset['counter'] ?? '0', 10);
      const obj = { value: 0 };

      tl.to(obj, {
        value: target,
        duration: 1.5,
        ease: 'power2.out',
        onUpdate: () => {
          counter.textContent = Math.round(obj.value).toString();
        },
      }, '-=1');
    });

    tl.from('[data-ctas]', { opacity: 0, y: 20, duration: 0.5 }, '-=0.8')
  }
</script>