---
// Bloc "Derniers articles du blog" affiché en bas de la page d'accueil.
// Renforce le maillage interne et le PageRank entre l'accueil et le blog.
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'blog'>[];
}

const { articles } = Astro.props;
---

{articles.length > 0 && (
  <section class="latest-articles" aria-labelledby="latest-articles-title">
    <div class="container">
      <header class="latest-header">
        <h2 id="latest-articles-title">Derniers articles du blog</h2>
        <a href="/blog" class="latest-all">Voir tous les articles →</a>
      </header>
      <div class="latest-grid">
        {articles.map((article) => (
          <a href={`/blog/${article.id}`} class="latest-card">
            <span class="latest-date">
              <time datetime={article.data.pubDate.toISOString()}>
                {article.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </span>
            <h3 class="latest-title">{article.data.title}</h3>
            {article.data.description && <p class="latest-desc">{article.data.description}</p>}
            <span class="latest-cta">Lire l'article →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .latest-articles {
    padding: 4rem 1rem;
    background: var(--color-bg);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .latest-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .latest-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 900;
    margin: 0;
    color: var(--color-text);
  }
  .latest-all {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }
  .latest-all:hover {
    text-decoration: underline;
  }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .latest-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .latest-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--color-primary);
  }
  .latest-date {
    color: var(--color-text-light);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .latest-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.3;
  }
  .latest-desc {
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.55;
    font-size: 0.95rem;
  }
  .latest-cta {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: auto;
  }
</style>