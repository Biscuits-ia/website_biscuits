---
import RecruitmentFormClient from './react/RecruitmentFormClient';

interface Props {
  /**
   * Prefixe des `id` des champs. Necessaire des qu'une page monte plusieurs
   * fois le formulaire : sans lui, les ilots emettent les memes `id` et chaque
   * `<label for>` pointe vers le champ du premier formulaire.
   */
  idPrefix?: string;
  /**
   * Presence d'un compte connecte. Sert a savoir s'il y a une adresse a
   * imposer. Doit venir d'un `supabase.auth.getUser()` cote serveur.
   */
  isAuthenticated?: boolean;
  /** Email du compte connecte : impose par /api/recruitment a l'enregistrement. */
  accountEmail?: string;
}

const {
  idPrefix = 'recruitment',
  isAuthenticated = false,
  accountEmail,
} = Astro.props;
---

<RecruitmentFormClient
  client:load
  idPrefix={idPrefix}
  isAuthenticated={isAuthenticated}
  accountEmail={accountEmail}
/>
