---
// src/components/Seo/GEO.astro
// ----------------------------------------------------------------------------
// Composant GEO (Generative Engine Optimization) : meta-tags supplementaires
// qui aident les LLM crawlers (ChatGPT, Claude, Perplexity, Google AI
// Overviews...) a comprendre et citer le contenu.
//
// Specs / conventions visees :
// - Meta `robots` avec `ai-train` (proposition IETF draft)
// - Meta `citation_author` (utilise par certains LLM pour le deweighting)
// - Meta `ai-content-declaration` (declaration de nature humaine / mixte / IA)
// - `<link rel="alternate" type="text/markdown">` vers llms-full.txt
// - Sitemap des pages a forte valeur GEO (cite ci-dessous par les LLM)
//
// Utilisation :
//   <GEO
//     author="Alexis Gallard"
//     authorUrl="/auteur/alexis-gallard"
//     contentType="human-reviewed" // human | human-reviewed | ai-assisted
//     lastReviewed="2026-06-24"
//     expertise="ethique-ia"
//   />
// ============================================================================

export interface Props {
  /** Auteur principal de la page (signal E-E-A-T). */
  author?: string;
  /** URL canonique de la page auteur (ex: /auteur/alexis-gallard). */
  authorUrl?: string;
  /** Nature du contenu : human (redige par humain), human-reviewed (genere puis relu),
   *  ai-assisted (IA + humain). Defaut : human-reviewed. */
  contentType?: 'human' | 'human-reviewed' | 'ai-assisted';
  /** Date de derniere relecture (ISO 8601). Tres important pour GEO. */
  lastReviewed?: string;
  /** Domaine d'expertise (utilise pour le schema knowsAbout). */
  expertise?: string;
  /** Indique si la page doit etre exposee dans llms-full.txt. */
  exposeToLLM?: boolean;
}

const {
  author = 'Biscuits IA',
  authorUrl,
  contentType = 'human-reviewed',
  lastReviewed,
  expertise,
  exposeToLLM = true,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---

<!-- GEO : meta robots avec hint ai-train (proposition de standard emergente).
     Les LLM qui respectent ce hint peuvent choisir d'utiliser ou non le contenu
     pour l'entrainement. Ici on autorise l'entrainement (cite plus souvent)
     mais on autorise aussi l'indexation pour les reponses en direct. -->
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1, ai-train" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="Google-Extended" content="index, follow" />

<!-- GEO : declaration de nature du contenu (utilisee par Perplexity et autres
     pour le deweighting des contenus purement IA). -->
<meta name="ai-content-declaration" content={contentType} />
<meta name="content-type" content={contentType} />

<!-- GEO : auteur + relecture pour le signal E-E-A-T (Experience, Expertise,
     Authoritativeness, Trustworthiness) que les LLM utilisent massivement. -->
<meta name="author" content={author} />
{authorUrl && <link rel="author" href={authorUrl} />}
{lastReviewed && <meta name="last-reviewed" content={lastReviewed} />}
<meta name="reviewed-by" content="Association Biscuits IA - Comite editorial" />

<!-- GEO : expertise / domaine de la page (suit le schema knowsAbout). -->
{expertise && <meta name="expertise" content={expertise} />}

<!-- GEO : lien vers la version markdown complete (llms-full.txt) pour les
     LLM qui prefèrent le texte brut au HTML. -->
{exposeToLLM && (
  <link rel="alternate" type="text/markdown" href={`${siteUrl}/llms-full.txt`} title="Version markdown complete (GEO / LLM)" />
)}

<!-- GEO : lien vers la fiche d'identite de l'organisation (llms.txt). -->
<link rel="author" type="text/plain" href={`${siteUrl}/llms.txt`} title="Carte d'identite du site pour LLM" />

<!-- GEO : open graph enrichi pour le partage social (les LLM lisent aussi). -->
<meta property="og:type" content="article" />
<meta property="article:modified_time" content={lastReviewed || new Date().toISOString()} />
<meta property="article:author" content={author} />
{authorUrl && <meta property="article:author:url" content={authorUrl} />}

<!-- GEO : twitter card enrichie. -->
<meta name="twitter:label1" content="Auteur" />
<meta name="twitter:data1" content={author} />
<meta name="twitter:label2" content="Nature" />
<meta name="twitter:data2" content={contentType === 'human' ? 'Redige par humain' : contentType === 'human-reviewed' ? 'Relu par humain' : 'Assiste par IA'} />
