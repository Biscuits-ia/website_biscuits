---
// src/components/Seo/HowTo.astro
// ----------------------------------------------------------------------------
// Composant qui genere un schema HowTo (schema.org/HowTo) pour les tutoriels
// pas-a-pas. Eligible aux Google AI Overviews et aux featured snippets.
//
// Utilisation :
//   <HowTo
//     name="Comment demarrer avec l'IA generative"
//     description="Guide en 5 etapes pour les debutants."
//     totalTime="PT30M"
//     steps={[
//       { name: 'Choisir un outil', text: '...' },
//       { name: 'Formuler un prompt', text: '...' },
//     ]}
//   />
// ============================================================================

export interface HowToStep {
  name: string;
  text: string;
  image?: string;
  url?: string;
}

export interface Props {
  name: string;
  description: string;
  totalTime?: string;
  estimatedCost?: { currency: string; value: number | string };
  steps: HowToStep[];
}

const { name, description, totalTime, estimatedCost, steps } = Astro.props;
---

<ol class="howto-list" data-howto-name={name}>
  {steps.map((step, i) => (
    <li class="howto-step" id={`howto-step-${i + 1}`}>
      <strong class="howto-step-name">{step.name}</strong>
      <p class="howto-step-text">{step.text}</p>
      {step.image && <img src={step.image} alt={step.name} class="howto-step-image" loading="lazy" />}
    </li>
  ))}
</ol>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name,
    description,
    totalTime,
    estimatedCost: estimatedCost
      ? {
          '@type': 'MonetaryAmount',
          currency: estimatedCost.currency,
          value: estimatedCost.value,
        }
      : undefined,
    step: steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
      image: s.image,
      url: s.url,
    })),
  })}
/>

<style>
  .howto-list {
    counter-reset: howto;
    list-style: none;
    padding-left: 0;
    margin: 1.5rem 0;
  }
  .howto-step {
    counter-increment: howto;
    position: relative;
    padding: 1rem 1rem 1rem 3.5rem;
    margin-bottom: 0.75rem;
    border: 2px solid var(--color-border, #2a2424);
    background: var(--color-bg-elevated, #fdfaf3);
  }
  .howto-step::before {
    content: counter(howto);
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    width: 2rem;
    height: 2rem;
    background: var(--color-primary, #faca6f);
    color: var(--color-text, #2a2424);
    border: 2px solid var(--color-border, #2a2424);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
  }
  .howto-step-name {
    display: block;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
    color: var(--color-text, #2a2424);
  }
  .howto-step-text {
    margin: 0;
    color: var(--color-text-light, #5c3a1a);
    line-height: 1.55;
  }
  .howto-step-image {
    max-width: 100%;
    height: auto;
    margin-top: 0.6rem;
    border: 2px solid var(--color-border, #2a2424);
  }
</style>
