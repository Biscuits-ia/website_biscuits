---
export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.webp',
  ogType = 'website',
  noindex = false,
  author,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';
const fullOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteUrl}${ogImage}`;

// Optimisation longueur description (SEO 2026)
const seoDescription = description.length > 160
  ? description.substring(0, 157) + '...'
  : description;

// Optimisation longueur titre (SEO 2026)
const seoTitle = title.length > 65
  ? title.substring(0, 62) + '...'
  : title;
---

<!-- ============================================
     PRIMARY META TAGS (Lighthouse SEO)
     ============================================ -->
<title>{seoTitle}</title>
<meta name="title" content={seoTitle} />
<meta name="description" content={seoDescription} />


<!-- Author et Copyright -->
<meta name="author" content={author || "Biscuits IA"} />
<meta name="copyright" content="© 2026 Biscuits IA. Tous droits réservés." />

<!-- Canonical URL (crucial pour éviter duplicate content) -->
<link rel="canonical" href={canonical} />

<!-- ============================================
     OPEN GRAPH / FACEBOOK (Social SEO)
     ============================================ -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={seoDescription} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:secure_url" content={fullOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={seoTitle} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content="Biscuits IA" />

<!-- Article specific meta tags -->
{ogType === 'article' && (
  <>
    <meta property="article:publisher" content={siteUrl} />
    {author && <meta property="article:author" content={author} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta property="article:section" content="Intelligence Artificielle" />
  </>
)}

<!-- ============================================
     TWITTER CARD (Social SEO)
     ============================================ -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={seoDescription} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:image:alt" content={seoTitle} />
<meta name="twitter:site" content="@biscuitsIA" />
<meta name="twitter:creator" content="@biscuitsIA" />

<!-- ============================================
     ROBOTS & CRAWLING (Lighthouse SEO)
     ============================================ -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- ============================================
     MOBILE & PWA (Best Practices)
     ============================================ -->
<meta name="theme-color" content="#faca6f" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#2C2C2C" media="(prefers-color-scheme: dark)" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Biscuits IA" />
<meta name="application-name" content="Biscuits IA" />
<meta name="msapplication-TileColor" content="#faca6f" />

<!-- ============================================
     VERIFICATION & OWNERSHIP (Webmaster Tools)
     Renseignez ces codes après obtention sur les consoles :
     - Google Search Console : https://search.google.com/search-console
     - Bing Webmaster Tools  : https://www.bing.com/webmasters
     ============================================ -->
