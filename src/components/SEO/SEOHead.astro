    window.addGTMPreconnectIfConsented, non encore implemente). */}

<!-- ============================================
     CONTENT RATING & AUDIENCE
     ============================================ -->
<meta name="rating" content="general" />
<meta name="audience" content="all" />
<meta name="distribution" content="global" />

<!-- ============================================
     RSS Feed
     ============================================ -->
<link rel="alternate" type="application/rss+xml" title="Biscuits IA - RSS Feed" href={`${siteUrl}/rss.xml`} />