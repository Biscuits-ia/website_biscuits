---
// -------- Types discriminés par type de schéma Schema.org --------------------------------------------------------------------------------------------------------
//
// Avant : `data?: Record<string, any>` — — perdait la sécurité de type et
// laissait passer des payloads mal formés en compilation. Maintenant chaque
// type de schéma a sa propre interface typée, et l'union discriminée par
// `type` garantit que `data` correspond bien au `type` choisi.

// Types discriminés par type de schéma Schema.org.
// Avant : `data?: Record<string, any>` — — perdait la sécurité de type et
// laissait passer des payloads mal formés en compilation. Maintenant chaque
// type de schéma a sa propre interface typée, et l'union discriminée par
// `type` garantit que `data` correspond bien au `type` choisi.
//
// NOTE: les `export interface` et `export type` sont conservés pour la
// réutilisation par les pages (importables via `import type`). Astro les
// tolère dans le frontmatter ; en contrepartie on garde le frontmatter
// aussi simple que possible (pas de narrowing `as` complexe).

type ServiceData = {
  serviceType?: string;
  name?: string;
  description?: string;
};

type FAQData = {
  questions: Array<{ question: string; answer: string }>;
};

type ArticleData = {
  title?: string;
  headline?: string;
  description?: string;
  image?: string;
  datePublished: string;
  dateModified?: string;
  author?: string;
  authorSlug?: string;
  category?: string;
  keywords?: string[];
  wordCount?: number;
  rating?: number;
  reviewAuthor?: string;
};

type CourseData = {
  name: string;
  description: string;
  image?: string;
  courseMode?: 'online' | 'onsite' | 'blended';
  instructor?: string;
  price?: number | string;
  skills?: string[];
  level?: string;
};

type WebPageData = {
  name?: string;
  description?: string;
  /** Selecteur CSS des elements a rendre comme speakable pour voice/AI snippets */
  speakableSelectors?: string[];
};

type HowToStepData = {
  name: string;
  text: string;
  image?: string;
  url?: string;
};

type HowToData = {
  name: string;
  description: string;
  /** Duree totale au format ISO 8601, ex. "PT30M" pour 30 min */
  totalTime?: string;
  estimatedCost?: { currency: string; value: number | string };
  steps: HowToStepData[];
};

type ProductData = {
  // Conservé pour extension future — — non utilisé aujourd'hui
  name?: string;
};

type SchemaData =
  | ServiceData
  | FAQData
  | ArticleData
  | CourseData
  | WebPageData
  | ProductData
  | HowToData;

// Props du composant — — le `type` discrimine l'union `data`.
type Props = {
  type: 'Organization' | 'NGO' | 'Service' | 'FAQPage' | 'Article' | 'WebPage' | 'Course' | 'Product' | 'HowTo';
  data?: SchemaData;
};

const props = Astro.props;
const type: Props['type'] = props.type;
const data: SchemaData = props.data ?? {};
const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';

// Schema de base pour l'organisation (présent sur toutes les pages)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  "@id": `${siteUrl}/#organization`,
  "name": "Biscuits IA",
  "legalName": "Biscuits IA",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "@id": `${siteUrl}/#logo`,
    "url": `${siteUrl}/og-default.webp`,
    "contentUrl": `${siteUrl}/og-default.webp`,
    "caption": "Biscuits IA Logo",
    "inLanguage": "fr-FR",
    "width": "1200",
    "height": "630"
  },
  "image": {
    "@type": "ImageObject",
    "url": `${siteUrl}/og-default.webp`,
    "width": "1200",
    "height": "630"
  },
  "description": "Association Loi 1901 d'intérêt général. Nous rendons l'IA accessible à tous — — associations, collectivités et petites structures — — sans jargon et sans but lucratif.",
  "email": "contact@biscuits-ia.com",
  "telephone": "+33952587543",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2 B RUE de la Cueille Mirebalaise, Appartement 4",
    "addressLocality": "Poitiers",
    "postalCode": "86000",
    "addressCountry": "FR",
    "addressRegion": "Nouvelle-Aquitaine"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "46.5802",
    "longitude": "0.3404"
  },
  "sameAs": [
    "https://github.com/Biscuits-Dev"
  ],
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+33952587543",
      "contactType": "customer support",
      "email": "contact@biscuits-ia.com",
      "areaServed": "FR",
      "availableLanguage": ["French"]
    }
  ],
  "foundingDate": "2024",
  "founders": [
    {
      "@type": "Person",
      "name": "Alexis Gallard"
    }
  ],
  "areaServed": {
    "@type": "Place",
    "name": "France"
  },
  "knowsAbout": [
    "Intelligence Artificielle",
    "Éthique de l'IA",
    "Fracture numérique",
    "Formation numérique",
    "Autonomie numérique",
    "IA Générative",
    "Open source"
  ],
  "slogan": "L'IA accessible à tous, sans jargon et sans but lucratif",
  "identifier": [
    {
      "@type": "PropertyValue",
      "name": "RNA",
      "value": "W863012707"
    },
    {
      "@type": "PropertyValue",
      "name": "SIRET",
      "value": "10151660700013"
    }
  ]
};

// Website Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Biscuits IA",
  "description": "Association Loi 1901 — — IA accessible à tous, sans jargon et sans but lucratif.",
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "inLanguage": "fr-FR"
};

// Breadcrumb Schema (automatique basé sur l'URL)
const currentPath = Astro.url.pathname;
const pathParts = currentPath.split('/').filter(Boolean);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": siteUrl
    },
    ...pathParts.map((part: string, index: number) => ({

      "@type": "ListItem",
      "position": index + 2,
      "name": part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '),
      "item": `${siteUrl}/${pathParts.slice(0, index + 1).join('/')}`
    }))
  ]
};

// Schémas spécifiques selon le type de page
let specificSchema = {};

if (type === 'Service') {
  const serviceData = data as ServiceData;
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${Astro.url.href}#service`,
    "serviceType": serviceData.serviceType || "Intelligence Artificielle",
    "provider": {
      "@id": `${siteUrl}/#organization`
    },
    "name": serviceData.name || "Services IA",
    "description": serviceData.description || "Services d'intelligence artificielle pour entreprises",
    "areaServed": {
      "@type": "Country",
      "name": "France"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Services IA",
      "itemListElement": [
        {
          "@type": "OfferCatalog",
          "name": "Formation IA",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Formation Intelligence Artificielle"
              }
            }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "Consulting IA",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Consulting IA pour entreprises"
              }
            }
          ]
        }
      ]
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@id": `${siteUrl}/#organization`
      }
    }
  };
} else if (type === 'FAQPage') {
  const faqData = data as FAQData;
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqData.questions?.map((q) => ({
      "@type": "Question",
      "name": q.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": q.answer
      }
    })) || []
  };
} else if (type === 'Article') {
  const articleData = data as ArticleData;
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${Astro.url.href}#article`,
    "headline": articleData.headline || articleData.title,
    "description": articleData.description,
    "image": articleData.image ? {
      "@type": "ImageObject",
      "url": articleData.image,
      "width": 1200,
      "height": 630
    } : undefined,
    "datePublished": articleData.datePublished,
    "dateModified": articleData.dateModified || articleData.datePublished,
    "author": {
      "@type": "Person",
      "name": articleData.author || "Biscuits IA",
      "url": `${siteUrl}/auteur/${articleData.authorSlug || 'biscuits-ia'}`
    },
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": Astro.url.href
    },
    "articleSection": articleData.category || "Intelligence Artificielle",
    "keywords": articleData.keywords?.join(', '),
    "wordCount": articleData.wordCount,
    "inLanguage": "fr-FR"
  };
} else if (type === 'Course') {
  const courseData = data as CourseData;
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "Course",
    "@id": `${Astro.url.href}#course`,
    "name": courseData.name,
    "description": courseData.description,
    "provider": {
      "@id": `${siteUrl}/#organization`
    },
    "image": courseData.image,
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseMode": courseData.courseMode || "online",
      "instructor": {
        "@type": "Person",
        "name": courseData.instructor || "Expert Biscuits IA"
      }
    },
    "offers": courseData.price ? {
      "@type": "Offer",
      "price": courseData.price,
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock"
    } : undefined,
    "teaches": courseData.skills || [],
    "educationalLevel": courseData.level || "Débutant à Avancé",
    "inLanguage": "fr-FR"
  };
} else if (type === 'WebPage') {
  // Branche manquante avant l'audit : `WebPage` était déclaré dans Props.type
  // mais jamais géré ici — — `data` passé par `blog/[page].astro` était silencieusement
  // abandonné. Cf. AUDIT.md §3.
  const webPageData = data as WebPageData;
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": Astro.url.href,
    "url": Astro.url.href,
    "name": webPageData.name || "Biscuits IA",
    "description": webPageData.description || "Association Loi 1901 — — IA accessible à tous.",
    "isPartOf": {
      "@id": `${siteUrl}/#website`
    },
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": "fr-FR",
    "dateModified": new Date().toISOString().split('T')[0],
  };
} else if (type === 'HowTo') {
  // GEO : schema HowTo pour les tutoriels et guides pas-a-pas.
  // Eligible aux Google AI Overviews et aux featured snippets en etapes.
  const howtoData = data as HowToData;
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "@id": Astro.url.href + "#howto",
    "name": howtoData.name,
    "description": howtoData.description,
    "image": {
      "@type": "ImageObject",
      "url": siteUrl + "/og-default.webp",
      "width": 1200,
      "height": 630
    },
    "totalTime": howtoData.totalTime,
    "estimatedCost": howtoData.estimatedCost ? {
      "@type": "MonetaryAmount",
      "currency": howtoData.estimatedCost.currency,
      "value": howtoData.estimatedCost.value
    } : undefined,
    "author": {
      "@type": "Organization",
      "@id": siteUrl + "/#organization"
    },
    "publisher": {
      "@id": siteUrl + "/#organization"
    },
    "inLanguage": "fr-FR",
    "step": howtoData.steps.map((step, index) => ({
      "@type": "HowToStep",
      "position": index + 1,
      "name": step.name,
      "text": step.text,
      "image": step.image,
      "url": step.url ? step.url + "#step" + (index + 1) : undefined
    }))
  };
} else if (type === 'Product') {
  // Réservé pour usage futur (e.g. page de don ou de formation payante).
  const productData = data as ProductData;
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": productData.name || "Biscuits IA",
    "provider": {
      "@id": `${siteUrl}/#organization`
    },
  };
}

// Combinaison de tous les schémas dans un graph
const graphSchema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema,
    ...(pathParts.length >= 0 ? [breadcrumbSchema] : []),
    ...(Object.keys(specificSchema).length > 0 ? [specificSchema] : [])
  ]
};

// Pré-calcul des champs du bloc "Review" (résout le `as ArticleData` dans le template,
// qui n'est pas autorisé par le parser JSX d'Astro dans certaines positions)
const articleDataForReview = type === 'Article' ? (data as ArticleData) : null;
const reviewSchema = articleDataForReview?.rating ? {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Article",
    "name": articleDataForReview.title
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": articleDataForReview.rating,
    "bestRating": "5"
  },
  "author": {
    "@type": "Person",
    "name": articleDataForReview.reviewAuthor || "Biscuits IA"
  }
} : null;
---

<!-- Schema.org Structured Data (JSON-LD) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(graphSchema)} />

<!-- Additional Rich Snippets -->
{reviewSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
)}