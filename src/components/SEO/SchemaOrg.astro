---
export interface Props {
  type: 'Organization' | 'NGO' | 'Service' | 'FAQPage' | 'Article' | 'WebPage' | 'Course' | 'Product';
  data?: Record<string, any>;
}

const { type, data = {} } = Astro.props;
const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';

// Schema de base pour l'organisation (présent sur toutes les pages)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  "@id": `${siteUrl}/#organization`,
  "name": "Biscuits IA",
  "legalName": "Biscuits IA",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "@id": `${siteUrl}/#logo`,
    "url": `${siteUrl}/assets/logo.webp`,
    "contentUrl": `${siteUrl}/assets/logo.webp`,
    "caption": "Biscuits IA Logo",
    "inLanguage": "fr-FR",
    "width": "512",
    "height": "512"
  },
  "image": {
    "@type": "ImageObject",
    "url": `${siteUrl}/assets/logo.webp`,
    "width": "512",
    "height": "512"
  },
  "description": "Association Loi 1901 d'intérêt général. Nous rendons l'IA accessible à tous — associations, collectivités et petites structures — sans jargon et sans but lucratif.",
  "email": "contact@biscuits-ia.com",
  "telephone": "+33952587543",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2 B RUE de la Cueille Mirebalaise, Appartement 4",
    "addressLocality": "Poitiers",
    "postalCode": "86000",
    "addressCountry": "FR",
    "addressRegion": "Nouvelle-Aquitaine"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "46.5802",
    "longitude": "0.3404"
  },
  "sameAs": [
    "https://discord.gg/5CkRSWEehy",
    "https://github.com/Biscuits-Dev"
  ],
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+33952587543",
      "contactType": "customer support",
      "email": "contact@biscuits-ia.com",
      "areaServed": "FR",
      "availableLanguage": ["French"]
    }
  ],
  "foundingDate": "2024",
  "founders": [
    {
      "@type": "Person",
      "name": "Alexis Gallard"
    }
  ],
  "areaServed": {
    "@type": "Place",
    "name": "France"
  },
  "knowsAbout": [
    "Intelligence Artificielle",
    "Éthique de l'IA",
    "Fracture numérique",
    "Formation numérique",
    "Autonomie numérique",
    "IA Générative",
    "Open source"
  ],
  "slogan": "L'IA accessible à tous, sans jargon et sans but lucratif",
  "identifier": [
    {
      "@type": "PropertyValue",
      "name": "RNA",
      "value": "W863012707"
    },
    {
      "@type": "PropertyValue",
      "name": "SIRET",
      "value": "94438475800013"
    }
  ]
};

// Website Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Biscuits IA",
  "description": "Association Loi 1901 — IA accessible à tous, sans jargon et sans but lucratif.",
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "inLanguage": "fr-FR"
};

// Breadcrumb Schema (automatique basé sur l'URL)
const currentPath = Astro.url.pathname;
const pathParts = currentPath.split('/').filter(Boolean);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": siteUrl
    },
    ...pathParts.map((part: string, index: number) => ({

      "@type": "ListItem",
      "position": index + 2,
      "name": part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '),
      "item": `${siteUrl}/${pathParts.slice(0, index + 1).join('/')}`
    }))
  ]
};

// Schémas spécifiques selon le type de page
let specificSchema = {};

if (type === 'Service') {
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${Astro.url.href}#service`,
    "serviceType": data.serviceType || "Intelligence Artificielle",
    "provider": {
      "@id": `${siteUrl}/#organization`
    },
    "name": data.name || "Services IA",
    "description": data.description || "Services d'intelligence artificielle pour entreprises",
    "areaServed": {
      "@type": "Country",
      "name": "France"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Services IA",
      "itemListElement": [
        {
          "@type": "OfferCatalog",
          "name": "Formation IA",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Formation Intelligence Artificielle"
              }
            }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "Consulting IA",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Consulting IA pour entreprises"
              }
            }
          ]
        }
      ]
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@id": `${siteUrl}/#organization`
      }
    }
  };
} else if (type === 'FAQPage') {
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": data.questions?.map((q: any) => ({
      "@type": "Question",
      "name": q.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": q.answer
      }
    })) || []
  };
} else if (type === 'Article') {
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${Astro.url.href}#article`,
    "headline": data.headline || data.title,
    "description": data.description,
    "image": data.image ? {
      "@type": "ImageObject",
      "url": data.image,
      "width": 1200,
      "height": 630
    } : undefined,
    "datePublished": data.datePublished,
    "dateModified": data.dateModified || data.datePublished,
    "author": {
      "@type": "Person",
      "name": data.author || "Biscuits IA",
      "url": `${siteUrl}/auteur/${data.authorSlug || 'biscuits-ia'}`
    },
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": Astro.url.href
    },
    "articleSection": data.category || "Intelligence Artificielle",
    "keywords": data.keywords?.join(', '),
    "wordCount": data.wordCount,
    "inLanguage": "fr-FR"
  };
} else if (type === 'Course') {
  specificSchema = {
    "@context": "https://schema.org",
    "@type": "Course",
    "@id": `${Astro.url.href}#course`,
    "name": data.name,
    "description": data.description,
    "provider": {
      "@id": `${siteUrl}/#organization`
    },
    "image": data.image,
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseMode": data.courseMode || "online",
      "instructor": {
        "@type": "Person",
        "name": data.instructor || "Expert Biscuits IA"
      }
    },
    "offers": data.price ? {
      "@type": "Offer",
      "price": data.price,
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock"
    } : undefined,
    "teaches": data.skills || [],
    "educationalLevel": data.level || "Débutant à Avancé",
    "inLanguage": "fr-FR"
  };
}

// Combinaison de tous les schémas dans un graph
const graphSchema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema,
    ...(pathParts.length >= 0 ? [breadcrumbSchema] : []),
    ...(Object.keys(specificSchema).length > 0 ? [specificSchema] : [])
  ]
};
---

<!-- Schema.org Structured Data (JSON-LD) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(graphSchema)} />

<!-- Additional Rich Snippets -->
{type === 'Article' && data.rating && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": {
      "@type": "Article",
      "name": data.title
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": data.rating,
      "bestRating": "5"
    },
    "author": {
      "@type": "Person",
      "name": data.reviewAuthor || "Biscuits IA"
    }
  })} />
)}