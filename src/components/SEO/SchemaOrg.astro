---
export interface SchemaOrgProps {
  type: 'Organization' | 'ProfessionalService' | 'FAQPage' | 'Article' | 'WebPage';
  data?: Record<string, any>;
}

const { type, data = {} } = Astro.props as SchemaOrgProps;

const baseOrganization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Biscuits IA",
  "url": "https://biscuits.dev",
  "logo": "https://biscuits.dev/logo.png",
  "description": "Biscuits IA fournit des outils, kits de démarrage et automatisations pour accompagner associations et professionnels dans leurs projets. Créez efficacement avec des bases fiables et accessibles à tous.",
  "email": "contact@biscuits.dev",
  /* --------------------------------------------------------------
   * POINT DE CONTACT – informations visibles pour les moteurs de recherche
   * -------------------------------------------------------------- */
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+33-1-23-45-67-89",
      "contactType": "Customer Service",
      "email": "contact@biscuits.dev",
      "areaServed": "FR",
      "availableLanguage": ["French", "English"]
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "12 Rue de l'Innovation",
    "postalCode": "75001",
    "addressLocality": "Paris",
    "addressCountry": "FR"
  },
  "foundingDate": "2020-01-01",
  "founder": {
    "@type": "Person",
    "name": "Alexis Tak"
  },
  "sameAs": [
    "https://linkedin.com/company/biscuits-ia",
    "https://twitter.com/biscuitsIA"
  ],
  "nonprofitStatus": "NonProfit",
  "additionalType": "Association",
  /* --------------------------------------------------------------
   * INFORMATION LÉGALE SUPPLÉMENTAIRE
   * -------------------------------------------------------------- */
  "legalName": "Association Biscuits IA",
  "taxID": "FR 88 123 456 789"
};

const schemas = {
  Organization: baseOrganization,
  
  ProfessionalService: {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": data.name || "Services Biscuits IA",
    "description": data.description || "Solutions IA personnalisées",
    "provider": baseOrganization,
    "areaServed": {
      "@type": "Country",
      "name": "France"
    },
    "serviceType": data.serviceType || "Développement IA",
    ...data
  },
  
  FAQPage: {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": data.questions?.map((q: any) => ({
      "@type": "Question",
      "name": q.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": q.answer
      }
    })) || []
  },
  
  Article: {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": data.headline || data.title,
    "description": data.description,
    "datePublished": data.datePublished,
    "dateModified": data.dateModified || data.datePublished,
    "author": {
      "@type": "Person",
      "name": data.author || "Biscuits du Dev"
    },
    "publisher": baseOrganization,
    "image": data.image,
    "url": data.url
  },
  
  WebPage: {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": data.name || "Biscuits IA",
    "description": data.description,
    "url": data.url,
    "publisher": baseOrganization,
    "breadcrumb": data.breadcrumb
  }
};

const schema = schemas[type as keyof typeof schemas];
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />