---
// Typescript / frontmatter
interface Service {
  id: string;
  title: string;
  description: string;
  icon: string;
  details: string[];
  zone: 'AI intégrer' | 'Europe' | 'automatisation';
}

const services: Service[] = [
  {
    "id": "starterkits",
    "title": "Starter Kits pour structures",
    "description": "Projets et outils prêts à l’emploi, conçus pour aider les associations, collectivités et TPE à démarrer rapidement avec l’IA.",
    "icon": "🚀",
    "details": [
      "Starter Kit Next.js pour site web interne ou public",
      "Starter Kit Astro pour structure locale ou association",
      "Starter Kit SaaS Supabase adapté aux petites structures",
      "Code structuré, documenté et facilement modifiable"
    ],
    "zone": "AI intégrer"
  },
  {
    "id": "solutions-ia",
    "title": "Solutions IA personnalisées",
    "description": "Intégration de l’IA dans vos projets pour automatiser et faciliter les tâches quotidiennes, adaptée aux associations et TPE.",
    "icon": "🤖",
    "details": [
      "Automatisation de tâches répétitives",
      "IA intégrée aux outils internes",
      "Chatbots IA pour communication et accueil",
      "IA pour workflows internes ou bénévoles"
    ],
    "zone": "automatisation"
  },
  {
    "id": "consulting-ia",
    "title": "Accompagnement IA & Développement",
    "description": "Support pour optimiser vos projets techniques et accompagner la montée en compétences des équipes ou bénévoles.",
    "icon": "🧠",
    "details": [
      "Choix de stack moderne adapté aux petites structures",
      "Optimisation du code et bonnes pratiques",
      "Architecture légère, maintenable et scalable",
      "Accompagnement projet IA et formation des équipes"
    ],
    "zone": "Europe"
  },
  {
    "id": "automation",
    "title": "Automatisation & Workflows",
    "description": "Gagnez du temps grâce à des processus automatisés et des connecteurs simples, adaptés aux associations et TPE.",
    "icon": "⚙️",
    "details": [
      "API et intégrations automatisées pour outils internes",
      "Générateurs IA pour documents et communications",
      "Scripts intelligents pour tâches répétitives",
      "Connecteurs web & SaaS pour centraliser l’information"
    ],
    "zone": "automatisation"
  }
];

function getZoneBadge(zone: string) {
  switch (zone) {
    case 'AI intégrer':
      return { text: 'AI intégrer', color: 'linear-gradient(90deg, oklch(60% 0.11 58), oklch(38% 0.08 44))' };
    case 'Europe':
      return { text: 'Europe', color: 'linear-gradient(0deg, oklch(60% 0.11 58), oklch(38% 0.08 44))' };
    case 'automatisation':
      return { text: 'Automatisation', color: 'linear-gradient(190deg, oklch(60% 0.11 58), oklch(38% 0.08 44))' };
    default:
      return { text: zone, color: '#ccc' };
  }
}
---
<!-- HTML -->
<div class="services-container">
  <div class="services-grid">
    {services.map((service) => {
      const badge = getZoneBadge(service.zone);
      
      return (
        <div
          class="service-card"
          data-service-id={service.id}
          data-reveal
          role="button"
          tabindex="0"
          aria-expanded="false"
        >
          <div class="service-header">
            <span class="service-icon">{service.icon}</span>
            <h3>{service.title}</h3>
          </div>
          
          <p class="service-description">{service.description}</p>
          
          <div class="zone-badge" style={`background: ${badge.color}`}>
            {badge.text}
          </div>
          
          <div class="service-details">
            <h4>Prestations incluses :</h4>
            <ul>
              {service.details.map((detail) => (
                <li>✓ {detail}</li>
              ))}
            </ul>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
.services-container {
  width: 100%;
}
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--spacing-xl);
}
.service-card {
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base), background-color var(--transition-base);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}
.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-first));
  transform: scaleX(0);
  transition: transform var(--transition-base);
}
.service-card:hover,
.service-card:focus {
  transform: translateY(-8px);
  box-shadow: var(--shadow-xl);
  border-color: var(--color-primary);
  background: var(--color-bg-elevated);
}
.service-card:hover::before {
  transform: scaleX(1);
}
.service-card:focus {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}
.service-card.active {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-glow);
}
.service-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}
.service-icon {
  font-size: 3rem;
  filter: drop-shadow(0 0 10px var(--color-primary));
  transition: transform var(--transition-base);
}
.service-card:hover .service-icon {
  transform: scale(1.1) rotate(5deg);
}
.service-card h3 {
  font-size: var(--font-size-xl);
  color: var(--color-text);
  margin: 0;
}
.service-description {
  color: var(--color-text-light);
  margin-bottom: var(--spacing-md);
  line-height: 1.6;
}
.zone-badge {
  display: inline-block;
  padding: var(--spacing-xs) var(--spacing-md);
  border-radius: var(--radius-full);
  color: var(--color-bg);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  text-transform: uppercase;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-glow);
}
.service-details {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height var(--transition-base), opacity var(--transition-base), padding-top var(--transition-base), border-top-color var(--transition-base);
  margin-top: var(--spacing-lg);
  padding-top: 0;
  border-top: 1px solid transparent;
}
.service-card.active .service-details {
  max-height: 500px;
  opacity: 1;
  padding-top: var(--spacing-lg);
  border-top-color: var(--color-border);
}
.service-details h4 {
  font-size: var(--font-size-base);
  color: var(--color-primary);
  margin-bottom: var(--spacing-md);
}
.service-details ul {
  list-style: none;
  padding: 0;
}
.service-details li {
  padding: var(--spacing-xs) 0;
  color: var(--color-text-light);
  line-height: 1.5;
}
@media (max-width: 768px) {
  .services-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const cards = document.querySelectorAll('.service-card');
  
  cards.forEach((card) => {
    const handleToggle = () => {
      const isActive = card.classList.contains('active');
      
      // Fermer toutes les autres
      cards.forEach((c) => {
        c.classList.remove('active');
        c.setAttribute('aria-expanded', 'false');
      });
      
      // Toggle actuelle
      if (!isActive) {
        card.classList.add('active');
        card.setAttribute('aria-expanded', 'true');
      }
    };
    
    card.addEventListener('click', handleToggle);
    
    card.addEventListener('keydown', (e) => {
      const event = e as KeyboardEvent;
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        handleToggle();
      }
    });
  });
});
</script>
