---
// src/components/SupportCTA.astro
// Bloc soutien / don / adhesion. CTA clair pour les personnes qui veulent aider.

const facons = [
  {
    icon: '\u2764',
    titre: 'Faire un don',
    description:
      "Votre don finance directement la sensibilisation, les ateliers IA pour les associations, et le developpement d'Anti Pepins. HelloAsso, 100% securise, recu fiscal des 10 \u20ac.",
    href: 'https://www.helloasso.com/associations/biscuits-ia',
    externe: true,
    cta: 'Donner',
  },
  {
    icon: '\u270D',
    titre: "Adherer a l'association",
    description:
      'A partir de 10 \u20ac/an, vous soutenez la mission et vous beneficiez des ressources membres en avant-premiere.',
    href: '/rejoignez-nous',
    externe: false,
    cta: 'Adherer',
  },
  {
    icon: '\u26A1',
    titre: 'Donner du temps',
    description:
      'Benevolat technique, juridique, communication, evenementiel. Quelques heures par mois suffisent. On vous forme.',
    href: '/rejoignez-nous',
    externe: false,
    cta: 'Voir les besoins',
  },
];
---

<section class="sup-section" aria-labelledby="sup-title">
  <div class="sup-inner">
    <header class="sup-header">
      <p class="sup-eyebrow">Soutenir l'association</p>
      <h2 id="sup-title">Trois facons de nous aider</h2>
      <p class="sup-intro">
        Biscuits IA est une association Loi 1901 financee par les ventes de logiciels (pilier 3),
        les ateliers payants et la generosite de particuliers et d'entreprises. Chaque contribution
        compte, quelle que soit sa forme.
      </p>
    </header>

    <div class="sup-grid">
      {
        facons.map((f) => (
          <article class="sup-card">
            <span class="sup-icon" aria-hidden="true">
              {f.icon}
            </span>
            <h3>{f.titre}</h3>
            <p>{f.description}</p>
            <a
              href={f.href}
              class="sup-cta"
              {...(f.externe ? { rel: 'noopener noreferrer', target: '_blank' } : {})}
            >
              {f.cta}
              {f.externe && (
                <span class="sup-ext" aria-hidden="true">
                  ↗
                </span>
              )}
            </a>
          </article>
        ))
      }
    </div>

    <div class="sup-foot">
      <p>
        <strong>Vous etes une entreprise ou une collectivite ?</strong> On peut etablir un partenariat
        structure (mecennat de competences, financement d'un projet, integration a notre gouvernance).
        <a href="/contact?sujet=partenariat">Discutons-en</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .sup-section {
    padding: 5rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .sup-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .sup-header {
    text-align: center;
    margin-bottom: 2.5rem;
    max-width: 720px;
    margin-inline: auto;
  }

  .sup-eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #78532f;
    margin-bottom: 0.75rem;
  }

  .sup-header h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .sup-intro {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
  }

  .sup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .sup-card {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .sup-icon {
    font-size: 2.2rem;
    line-height: 1;
  }

  .sup-card h3 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
  }

  .sup-card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
    font-size: 0.95rem;
  }

  .sup-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.7rem 1.25rem;
    background: var(--color-primary);
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    border: 2px solid var(--color-border);
    text-decoration: none;
    margin-top: auto;
  }

  .sup-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
    color: #fff;
  }

  .sup-ext {
    font-size: 0.85em;
  }

  .sup-foot {
    text-align: center;
    padding: 1.5rem 1.75rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-secondary);
  }

  .sup-foot p {
    margin: 0;
    color: var(--color-text);
    line-height: 1.6;
  }

  .sup-foot a {
    color: var(--color-primary-dark);
    font-weight: 700;
  }
</style>
