---
// src/components/VictimHighlight.astro
// Bandeau d'aide aux victimes : urgence, numero 3018, lien vers /aide-victimes.
// Visible sur la home pour donner un acces rapide aux personnes en detresse.

interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;
---

<section class={`victim-highlight ${variant}`} aria-labelledby="victim-highlight-title">
  <div class="victim-inner">
    <div class="victim-text">
      <span class="victim-eyebrow">Vous etes victime d'une arnaque ou d'une cyberattaque ?</span>
      <h2 id="victim-highlight-title">On peut vous aider. Gratuitement, en confidence.</h2>
      <p>
        Phishing, usurpation d'identite, chantage, contenu impliquant un mineur : nous accompagnons les victimes pas a pas, signalons aux autorites (PHAROS, 3018, pre-plainte) et vous aidons a reprendre le controle.
      </p>
      <div class="victim-actions">
        <a href="/aide-victimes" class="btn-danger">Demander de l'aide</a>
        <a href="tel:3018" class="btn-ghost">Appeler le 3018 (gratuit, anonyme)</a>
      </div>
    </div>
    <aside class="victim-numbers" aria-label="Contacts d'urgence">
      <h3>Urgences immediates</h3>
      <ul>
        <li><strong>3018</strong><span>Cyberharcelement, mineurs</span></li>
        <li><strong>17 / 112</strong><span>Police / Gendarmerie</span></li>
        <li><strong>3919</strong><span>Violences conjugales</span></li>
        <li><strong>0 805 805 817</strong><span>Cybermalveillance.gouv.fr</span></li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .victim-highlight {
    padding: 4rem 1.5rem;
    background: linear-gradient(135deg, #fff5f3 0%, var(--color-bg-alt) 100%);
    border-top: 4px solid #c0392b;
    border-bottom: 4px solid #c0392b;
  }

  .victim-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .victim-eyebrow {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    background: #c0392b;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .victim-text h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .victim-text p {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0 0 1.5rem;
    max-width: 640px;
  }

  .victim-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-danger {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: #c0392b;
    color: #fff;
    font-weight: 800;
    border: 2px solid var(--color-border);
    text-decoration: none;
  }

  .btn-danger:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
    color: #fff;
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: transparent;
    color: var(--color-text);
    font-weight: 700;
    border: 2px solid var(--color-border);
    text-decoration: none;
  }

  .btn-ghost:hover {
    background: var(--color-bg-elevated);
  }

  .victim-numbers {
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
  }

  .victim-numbers h3 {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
    margin: 0 0 1rem;
  }

  .victim-numbers ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .victim-numbers li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    background: var(--color-bg);
    border-left: 3px solid #c0392b;
  }

  .victim-numbers strong {
    font-size: 1.05rem;
    color: #c0392b;
    font-weight: 800;
  }

  .victim-numbers span {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .compact .victim-inner {
    grid-template-columns: 1fr;
  }

  .compact .victim-numbers {
    display: none;
  }

  @media (max-width: 900px) {
    .victim-inner {
      grid-template-columns: 1fr;
    }
  }
</style>