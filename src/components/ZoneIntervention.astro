---
interface IAService {
  name: string;
  highlight: boolean;
}

const iaServices: IAService[] = [
  { name: "Starter Kits Premium", highlight: true },
  { name: "Automatisations IA & Workflows intelligents", highlight: false },
  { name: "Chatbots IA personnalisés", highlight: false },
  { name: "Optimisation de projets web", highlight: false },
  { name: "Consulting IA & Architecture", highlight: false },
  { name: "Intégration API OpenAI · Claude · Mistral", highlight: false }
];

const stats = [
  { number: "100%", label: "Services à distance" },
  { number: "100+", label: "Solutions IA disponibles" },
  { number: "48h", label: "Délai moyen de réponse" },
  { number: "∞", label: "Couverture européenne" }
];
---

<section class="zone-section" id="services-ia" data-zone-section>
  <div class="container">
    <div class="zone-header" data-reveal="header">
      <h2>Solutions IA disponibles partout</h2>
      <p class="zone-subtitle">
        Tous nos services sont accessibles à distance, en France et dans le monde entier.
      </p>
    </div>

    <div class="zone-info-grid">
      <!-- Carte Services -->
      <div class="zone-card primary" data-reveal="card">
        <div class="zone-card-header">
          <span class="zone-icon">🤖</span>
          <h3>Nos Services IA</h3>
        </div>

        <div class="distance-services">
          <h4>Services disponibles :</h4>
          <ul>
            {iaServices.map((item) => (
              <li class={item.highlight ? "priority" : ""}>
                {item.highlight ? <strong>{item.name}</strong> : item.name}
              </li>
            ))}
          </ul>
        </div>

        <div class="coverage-badge">
          <span class="badge-icon">🌍</span>
          <div>
            <strong>Couverture Européenne</strong>
            <small>Disponible depuis n'importe où</small>
          </div>
        </div>
      </div>

      <!-- Globe animé -->
      <div class="globe-container" data-reveal="globe">
        <div class="globe-animation">
          <div class="globe-ring ring-1"></div>
          <div class="globe-ring ring-2"></div>
          <div class="globe-ring ring-3"></div>
          <div class="globe-center">
            <span class="globe-emoji">🤖</span>
          </div>
        </div>
        <p class="illustration-text">
          Solutions IA accessibles partout en Europe
        </p>
      </div>
    </div>

    <!-- Stats -->
    <div class="zone-stats" data-reveal="stats">
      {stats.map((stat, index) => (
        <div class="stat-item" data-stat-index={index}>
          <span class="stat-number" data-counter-value={stat.number}>0</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .zone-section {
    padding-block: var(--spacing-4xl);
    background: var(--color-bg);
  }

  .zone-header {
    text-align: center;
    margin-bottom: var(--spacing-3xl);
  }

  .zone-header h2 {
    font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
    background: linear-gradient(135deg, var(--color-primary), var(--color-first));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: var(--spacing-md);
  }

  .zone-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    max-width: 700px;
    margin-inline: auto;
  }

  /* Grid */
  .zone-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
  }

  /* Card */
  .zone-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--spacing-2xl);
    position: relative;
    overflow: hidden;
    transition: all var(--transition-base);
  }

.zone-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-first));
  }

  .zone-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--color-primary);
  }

  .zone-card-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .zone-icon {
    font-size: 3rem;
    filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.5));
  }

  .zone-card h3 {
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    margin: 0;
  }

  .distance-services h4 {
    font-size: var(--font-size-base);
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  .distance-services ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--spacing-sm);
  }

  .distance-services li {
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    color: var(--color-text-light);
    transition: all var(--transition-fast);
  }

  .distance-services li:hover {
    background: var(--color-dark-elevated);
    transform: translateX(4px);
    border-color: var(--color-primary);
  }

  .distance-services li.priority {
    background: rgba(59, 130, 246, 0.1);
    border-color: var(--color-primary);
  }

  .distance-services li.priority strong {
    color: var(--color-primary);
  }

  /* Coverage badge */
  .coverage-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
    padding: var(--spacing-lg);
    background: linear-gradient(135deg, 
      rgba(59, 130, 246, 0.1), 
      rgba(139, 92, 246, 0.1)
    );
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-lg);
  }

  .badge-icon {
    font-size: 2rem;
    filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.5));
  }

  .coverage-badge strong {
    display: block;
    color: var(--color-text);
    font-size: var(--font-size-base);
  }

  .coverage-badge small {
    display: block;
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
  }

  /* Globe animation */
  .globe-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-lg);
  }

  .globe-animation {
    position: relative;
    width: 250px;
    height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .globe-ring {
    position: absolute;
    border: 2px solid;
    border-radius: 50%;
    animation: pulse-ring 3s ease-in-out infinite;
  }

  .globe-ring.ring-1 {
    width: 200px;
    height: 200px;
    border-color: var(--color-primary);
    animation-delay: 0s;
  }

  .globe-ring.ring-2 {
    width: 150px;
    height: 150px;
    border-color: var(--color-first);
    opacity: 0.6;
    animation-delay: 1s;
  }

  .globe-ring.ring-3 {
    width: 100px;
    height: 100px;
    border-color: var(--color-primary);
    opacity: 0.4;
    animation-delay: 2s;
  }

  @keyframes pulse-ring {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.3;
    }
  }

  .globe-center {
    position: relative;
    z-index: 1;
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-first));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-glow);
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .globe-emoji {
    font-size: 2.5rem;
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.5));
  }

  .illustration-text {
    text-align: center;
    color: var(--color-text-light);
    font-size: var(--font-size-base);
    max-width: 300px;
  }

  /* Stats */
  .zone-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-xl);
  }

  .stat-item {
    text-align: center;
    padding: var(--spacing-xl);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
  }

  .stat-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--color-primary);
  }

  .stat-number {
    display: block;
    font-size: clamp(var(--font-size-3xl), 5vw, var(--font-size-5xl));
    font-weight: var(--font-weight-extrabold);
    background: linear-gradient(135deg, var(--color-primary), var(--color-first));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: var(--spacing-xs);
  }

  .stat-label {
    display: block;
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  @media (max-width: 768px) {
    .zone-info-grid {
      grid-template-columns: 1fr;
    }

    .zone-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initZoneAnimations() {
    const shouldReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (shouldReduce) {
      gsap.set('[data-reveal]', { opacity: 1, y: 0 });
      return;
    }

    // Timeline principale
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '[data-zone-section]',
        start: 'top 80%',
        once: true,
      },
      defaults: {
        ease: 'power3.out',
        duration: 0.8,
      },
    });

    tl.fromTo('[data-reveal="header"]',
      { opacity: 0, y: -20 },
      { opacity: 1, y: 0 }
    )
    .fromTo('[data-reveal="card"]',
      { opacity: 0, x: -50 },
      { opacity: 1, x: 0 },
      '-=0.4'
    )
    .fromTo('[data-reveal="globe"]',
      { opacity: 0, x: 50 },
      { opacity: 1, x: 0 },
      '-=0.6'
    )
    .fromTo('[data-reveal="stats"] .stat-item',
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, stagger: 0.1 },
      '-=0.4'
    );

    // Counter animation pour les stats
    tl.call(() => {
      document.querySelectorAll('[data-counter-value]').forEach((counter) => {
        const target = counter.getAttribute('data-counter-value');
        if (!target) return;

        // Si c'est un nombre, animer
        if (!isNaN(parseInt(target))) {
          gsap.to(counter, {
            textContent: parseInt(target),
            duration: 2,
            ease: 'power2.out',
            snap: { textContent: 1 },
            onUpdate: function() {
              const value = Math.round(this.targets()[0].textContent);
              this.targets()[0].textContent = value + '+';
            },
          });
        } else {
          // Sinon juste afficher
          counter.textContent = target;
        }
      });
    }, undefined, '-=0.5');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZoneAnimations);
  } else {
    initZoneAnimations();
  }
</script>