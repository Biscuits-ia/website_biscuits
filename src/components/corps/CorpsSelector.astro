---
// src/components/corps/CorpsSelector.astro — sélecteur de corps métier
import type { CorpsType } from '@/lib/types';
import { CORPS_CONFIG } from '@/lib/constants';
interface Props { name?: string; value?: CorpsType; id?: string; }
const { name = 'corps', value = 'DEV', id = 'corps' } = Astro.props;
const corpsValues = Object.keys(CORPS_CONFIG) as CorpsType[];
---

<label for={id} class="mb-1 block text-xs font-medium text-slate-700">Corps métier</label>
<select id={id} name={name} class="w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm">
  {corpsValues.map((c) => <option value={c} selected={c === value}>{CORPS_CONFIG[c].label}</option>)}
</select>
