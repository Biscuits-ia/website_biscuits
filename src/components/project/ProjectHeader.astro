---
// En-tete du projet : titre, statut, meta, objectif, livrables, stack, liens.
import type { ProjectDetail } from '../../lib/project-detail';
import { STATUS_CLASS, STATUS_LABEL, PRIORITY_CLASS, PRIORITY_LABEL } from '../../lib/project-detail';

interface Props { detail: ProjectDetail; }
const { detail } = Astro.props;
const { project, members, leaderName, deadlineStr, canEdit } = detail;
const statusClass = STATUS_CLASS, statusLabel = STATUS_LABEL;
const priorityClass = PRIORITY_CLASS, priorityLabel = PRIORITY_LABEL;
---

  <!-- En-tête projet -->
  <div class="project-header mb-6">
    <div class="project-header-left">
      <a href="/dashboard/benevole/projects" class="back-link">← Projets</a>

      {/* Titre + objectif côte à côte */}
      <div class="project-header-info">
        <div class="project-header-identity">
          <h1 class="project-title">{project.title}</h1>
          {project.description && <p class="project-description">{project.description}</p>}
          <div class="project-meta-row">
            <span class={`badge badge-${statusClass[project.status] ?? 'neutral'}`}>{statusLabel[project.status]}</span>
            <span class={`badge badge-${priorityClass[project.priority] ?? 'neutral'}`}>{priorityLabel[project.priority]}</span>
            <span class="meta-item">👤 {leaderName}</span>
            {deadlineStr && <span class="meta-item">📅 {deadlineStr}</span>}
            <span class="meta-item">👥 {members.length} membre{members.length > 1 ? 's' : ''}</span>
            {project.estimated_hours && <span class="meta-item">⏱ {project.estimated_hours}h estimées</span>}
            {project.start_date && <span class="meta-item">🚀 Début : {new Date(project.start_date).toLocaleDateString('fr-FR')}</span>}
          </div>
        </div>
        {project.objective && (
          <div class="project-objective-panel">
            <span class="project-detail-label">Objectif</span>
            <p class="project-detail-text">{project.objective}</p>
          </div>
        )}
      </div>

      {/* Grid : Livrables attendus | Stack technique + Outils */}
      {(project.expected_deliverables || (project.tech_stack?.length ?? 0) > 0 || (project.tools?.length ?? 0) > 0) && (
        <div class="project-detail-grid">
          {project.expected_deliverables && (
            <div class="project-detail-block">
              <span class="project-detail-label">Livrables attendus</span>
              <p class="project-detail-text">{project.expected_deliverables}</p>
            </div>
          )}
          {((project.tech_stack?.length ?? 0) > 0 || (project.tools?.length ?? 0) > 0) && (
            <div class="project-stack-tools">
              {(project.tech_stack?.length ?? 0) > 0 && (
                <div class="project-detail-block" style="margin-top:0">
                  <span class="project-detail-label">Stack technique</span>
                  <div class="project-tag-list">
                    {project.tech_stack.map((t: string) => <span class="project-tag project-tag--tech">{t}</span>)}
                  </div>
                </div>
              )}
              {(project.tools?.length ?? 0) > 0 && (
                <div class="project-detail-block">
                  <span class="project-detail-label">Outils</span>
                  <div class="project-tag-list">
                    {project.tools.map((t: string) => <span class="project-tag project-tag--tool">{t}</span>)}
                  </div>
                </div>
              )}
            </div>
          )}
        </div>
      )}

    {/* Liens */}
    {(project.repository_url || project.document_url || project.communication_channel) && (
      <div class="project-links-row">
        {project.repository_url && (
          <a href={project.repository_url} target="_blank" rel="noopener noreferrer" class="project-link">🔗 Dépôt</a>
        )}
        {project.document_url && (
          <a href={project.document_url} target="_blank" rel="noopener noreferrer" class="project-link">📄 Documentation</a>
        )}
        {project.communication_channel && (
          <span class="project-link project-link--channel">💬 {project.communication_channel}</span>
        )}
      </div>
    )}
  </div>
    {canEdit && (
      <div class="project-actions">
        <button class="btn btn-ghost btn-sm" id="btn-edit-project">Modifier</button>
        <button class="btn btn-primary btn-sm" id="btn-add-task">+ Tâche</button>
      </div>
    )}
  </div>
