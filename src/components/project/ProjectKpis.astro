---
// Compteurs de taches par statut.
import type { ProjectDetail } from '../../lib/project-detail';

interface Props { counts: ProjectDetail['counts']; }
const { counts } = Astro.props;
---

  <!-- Compteurs tâches -->
  <div class="project-task-kpis">
    <div class="project-task-kpi">
      <span class="project-task-kpi__value">{counts.total}</span>
      <span class="project-task-kpi__label">Total</span>
    </div>
    <div class="project-task-kpi project-task-kpi--todo">
      <span class="project-task-kpi__value">{counts.todo}</span>
      <span class="project-task-kpi__label">À faire</span>
    </div>
    <div class="project-task-kpi project-task-kpi--progress">
      <span class="project-task-kpi__value">{counts.inProgress}</span>
      <span class="project-task-kpi__label">En cours</span>
    </div>
    <div class="project-task-kpi project-task-kpi--review">
      <span class="project-task-kpi__value">{counts.review}</span>
      <span class="project-task-kpi__label">En révision</span>
    </div>
    <div class="project-task-kpi project-task-kpi--done">
      <span class="project-task-kpi__value">{counts.done}</span>
      <span class="project-task-kpi__label">Terminées</span>
    </div>
    <div class="project-task-kpi project-task-kpi--free">
      <span class="project-task-kpi__value">{counts.free}</span>
      <span class="project-task-kpi__label">Disponibles</span>
    </div>
  </div>
