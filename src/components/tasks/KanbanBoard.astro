---
// src/components/tasks/KanbanBoard.astro — tableau kanban avec DnD HTML5
import KanbanColumn from './KanbanColumn.astro';
import type { TaskWithRelations, TaskStatus } from '@/lib/types';
interface Props {
  tasks: TaskWithRelations[];
  todoTasks?: TaskWithRelations[];
  todoPrevHref?: string | null;
  todoNextHref?: string | null;
  todoPage?: number;
  todoTotalPages?: number;
  currentUserId?: string;
}
const { tasks = [], todoTasks = [], todoPrevHref, todoNextHref, todoPage = 1, todoTotalPages = 1, currentUserId = '' } = Astro.props;

const statuses: Array<{ status: TaskStatus; label: string }> = [
  { status: 'todo', label: 'À faire' },
  { status: 'backlog', label: 'Carnet' },
  { status: 'in_progress', label: 'En cours' },
  { status: 'in_review', label: 'En revue' },
  { status: 'testing', label: 'Tests' },
  { status: 'blocked', label: 'Bloquée' },
  { status: 'done', label: 'Terminée' },
];

const visibleStatuses = statuses;
---

<div class="taskhub-board" id="kanban-board" data-current-user-id={currentUserId}>
  {visibleStatuses.map((s) => s.status === 'todo'
    ? <KanbanColumn status={s.status} label={s.label} tasks={todoTasks} prevHref={todoPrevHref} nextHref={todoNextHref} page={todoPage} totalPages={todoTotalPages} currentUserId={currentUserId} />
    : <KanbanColumn status={s.status} label={s.label} tasks={tasks.filter((t) => t.status === s.status)} currentUserId={currentUserId} />
  )}
</div>

<script is:inline>
  let draggedTaskId = null;

  document.querySelectorAll('[data-task-id]').forEach((card) => {
    card.addEventListener('dragstart', (event) => {
      draggedTaskId = card.getAttribute('data-task-id');
      event.dataTransfer?.setData('text/plain', draggedTaskId || '');
      if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
    });
    card.addEventListener('dragend', () => {
      document.querySelectorAll('[data-dropzone]').forEach((zone) => zone.classList.remove('taskhub-dropzone--active'));
      draggedTaskId = null;
    });
  });

  document.querySelectorAll('[data-dropzone]').forEach((zone) => {
    zone.addEventListener('dragenter', () => {
      zone.classList.add('taskhub-dropzone--active');
    });
    zone.addEventListener('dragleave', () => {
      zone.classList.remove('taskhub-dropzone--active');
    });
    zone.addEventListener('dragover', (e) => e.preventDefault());
    zone.addEventListener('drop', async (e) => {
      e.preventDefault();
      zone.classList.remove('taskhub-dropzone--active');
      const nextStatus = zone.getAttribute('data-dropzone');
      const taskIdFromTransfer = e.dataTransfer?.getData('text/plain') || null;
      if (taskIdFromTransfer) draggedTaskId = taskIdFromTransfer;
      if (!draggedTaskId || !nextStatus) return;

      const res = await fetch('/api/tasks/update', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: draggedTaskId, status: nextStatus }),
      });

      if (res.ok) window.location.reload();
      else {
        const json = await res.json().catch(() => ({}));
        window.showToast?.(json.error || 'Impossible de déplacer la tâche.', 'error');
      }
    });
  });

  // ── Claim task (Je prends cette tâche) ──────────────────────────────────────
  const board = document.getElementById('kanban-board');
  const currentUserId = board?.getAttribute('data-current-user-id') || '';

  board?.addEventListener('click', async (e) => {
    const btn = e.target?.closest('[data-claim-task-id]');
    if (!btn || !currentUserId) return;
    const taskId = btn.getAttribute('data-claim-task-id');
    if (!taskId) return;

    btn.disabled = true;
    btn.textContent = '…';

    const res = await fetch('/api/tasks/update', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: taskId, assignee_id: currentUserId }),
    });

    const json = await res.json().catch(() => ({}));
    if (res.ok) {
      window.showToast?.('Tâche prise en charge !', 'success');
      setTimeout(() => window.location.reload(), 600);
    } else {
      window.showToast?.(json.error || 'Impossible de prendre la tâche.', 'error');
      btn.disabled = false;
      btn.textContent = 'Je prends cette tâche';
    }
  });

  board?.addEventListener('click', async (e) => {
    const moveBtn = e.target?.closest('[data-move-task-id][data-move-status]');
    if (!moveBtn) return;

    const taskId = moveBtn.getAttribute('data-move-task-id');
    const nextStatus = moveBtn.getAttribute('data-move-status');
    if (!taskId || !nextStatus) return;

    moveBtn.setAttribute('disabled', 'true');

    const res = await fetch('/api/tasks/update', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: taskId, status: nextStatus }),
    });

    const json = await res.json().catch(() => ({}));
    if (res.ok) {
      window.showToast?.('Tâche déplacée.', 'success');
      setTimeout(() => window.location.reload(), 350);
    } else {
      window.showToast?.(json.error || 'Impossible de déplacer la tâche.', 'error');
      moveBtn.removeAttribute('disabled');
    }
  });
</script>
