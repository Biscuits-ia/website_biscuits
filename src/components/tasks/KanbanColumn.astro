---
// src/components/tasks/KanbanColumn.astro — colonne kanban
import TaskCard from './TaskCard.astro';
import type { TaskWithRelations, TaskStatus, CorpsType } from '@/lib/types';

interface Props {
  status: TaskStatus;
  label: string;
  tasks: TaskWithRelations[];
  prevHref?: string | null;
  nextHref?: string | null;
  page?: number;
  totalPages?: number;
  currentUserId?: string;
  /** Optionnel — quand la colonne todo est scindée par corps */
  corps?: CorpsType;
}

const {
  status,
  label,
  tasks,
  prevHref,
  nextHref,
  page,
  totalPages,
  currentUserId = '',
  corps,
} = Astro.props;

const todoAvailable = status === 'todo' ? tasks.filter((task) => !task.assignee_id)  : [];
const todoAssigned  = status === 'todo' ? tasks.filter((task) => !!task.assignee_id) : [];

const moveTargetsByStatus: Record<TaskStatus, TaskStatus[]> = {
  backlog:     ['todo', 'in_progress'],
  todo:        ['in_progress', 'blocked'],
  in_progress: ['in_review', 'blocked', 'todo'],
  in_review:   ['testing', 'in_progress', 'done'],
  testing:     ['done', 'in_review', 'blocked'],
  blocked:     ['todo', 'in_progress'],
  done:        ['in_review'],
};

const moveTargets = moveTargetsByStatus[status] ?? [];

/* Couleur border-top pour les colonnes todo par corps */
const CORPS_COLORS: Record<string, string> = {
  DEV:    '#264f98',
  DB:     '#4f2e8a',
  DESIGN: '#9d4f0e',
  QA:     '#256d37',
  DATA:   '#0d6d66',
  PM:     '#8c2a2f',
};

const corpsColor = corps ? (CORPS_COLORS[corps] ?? null) : null;
---

<section
  class="taskhub-column"
  data-kanban-status={status}
  data-corps={corps ?? undefined}
  style={corpsColor ? `border-top-color: ${corpsColor}` : undefined}
>
  <header class="taskhub-column-header">
    <h3
      class="taskhub-column-title"
      style={corpsColor ? `color: ${corpsColor}` : undefined}
    >
      {label}
    </h3>
    <span class="taskhub-column-count">{tasks.length}{corps ? `/${tasks.length}` : ''}</span>
  </header>

  {status === 'todo' ? (
    <div class="taskhub-todo-groups">
      <!-- Disponibles -->
      <section class="taskhub-todo-group is-available" aria-label="Tâches disponibles">
        <header class="taskhub-todo-group-header">
          <h4 class="taskhub-todo-group-title">Disponibles</h4>
          <span class="taskhub-todo-group-count">{todoAvailable.length}</span>
        </header>
        <div class="taskhub-dropzone" data-dropzone={status} data-corps={corps ?? undefined}>
          {todoAvailable.length > 0
            ? todoAvailable.map((task) => (
                <TaskCard
                  task={task}
                  showActionLink={false}
                  claimUserId={currentUserId}
                  moveTargets={moveTargets}
                />
              ))
            : <p class="taskhub-todo-empty">Aucune tâche disponible.</p>
          }
        </div>
      </section>

      <!-- Attribuées -->
      <section class="taskhub-todo-group is-assigned" aria-label="Tâches déjà attribuées">
        <header class="taskhub-todo-group-header">
          <h4 class="taskhub-todo-group-title">Attribuées</h4>
          <span class="taskhub-todo-group-count">{todoAssigned.length}</span>
        </header>
        <div class="taskhub-dropzone" data-dropzone={status} data-corps={corps ?? undefined}>
          {todoAssigned.length > 0
            ? todoAssigned.map((task) => (
                <TaskCard
                  task={task}
                  showActionLink={false}
                  claimUserId={currentUserId}
                  moveTargets={moveTargets}
                />
              ))
            : <p class="taskhub-todo-empty">Aucune tâche attribuée.</p>
          }
        </div>
      </section>
    </div>
  ) : (
    <div class="taskhub-dropzone" data-dropzone={status}>
      {tasks.length > 0
        ? tasks.map((task) => (
            <TaskCard
              task={task}
              showActionLink={false}
              claimUserId={currentUserId}
              moveTargets={moveTargets}
            />
          ))
        : <p class="taskhub-todo-empty">Aucune tâche.</p>
      }
    </div>
  )}

  {(prevHref || nextHref) && (
    <nav class="taskhub-col-pag" aria-label={`Pagination ${label}`}>
      {prevHref
        ? <a href={prevHref} class="taskhub-col-pag-btn" aria-label="Page précédente">←</a>
        : <span class="taskhub-col-pag-btn is-disabled" aria-disabled="true">←</span>
      }
      <span class="taskhub-col-pag-info">{page} / {totalPages}</span>
      {nextHref
        ? <a href={nextHref} class="taskhub-col-pag-btn" aria-label="Page suivante">→</a>
        : <span class="taskhub-col-pag-btn is-disabled" aria-disabled="true">→</span>
      }
    </nav>
  )}
</section>