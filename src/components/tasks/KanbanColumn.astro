---
// src/components/tasks/KanbanColumn.astro — colonne kanban
import TaskCard from './TaskCard.astro';
import type { TaskWithRelations, TaskStatus } from '@/lib/types';
interface Props {
  status: TaskStatus;
  label: string;
  tasks: TaskWithRelations[];
  prevHref?: string | null;
  nextHref?: string | null;
  page?: number;
  totalPages?: number;
  currentUserId?: string;
}
const { status, label, tasks, prevHref, nextHref, page, totalPages, currentUserId = '' } = Astro.props;
---

<section class="taskhub-column" data-kanban-status={status}>
  <header class="taskhub-column-header">
    <h3 class="taskhub-column-title">{label}</h3>
    <span class="taskhub-column-count">{tasks.length}</span>
  </header>
  <div class="taskhub-dropzone" data-dropzone={status}>
    {tasks.map((task) => <TaskCard task={task} showActionLink={false} claimUserId={currentUserId} />)}
  </div>
  {(prevHref || nextHref) && (
    <nav class="taskhub-col-pag" aria-label={`Pagination colonne ${label}`}>
      {prevHref
        ? <a href={prevHref} class="taskhub-col-pag-btn">←</a>
        : <span class="taskhub-col-pag-btn is-disabled" aria-disabled="true">←</span>
      }
      <span class="taskhub-col-pag-info">{page} / {totalPages}</span>
      {nextHref
        ? <a href={nextHref} class="taskhub-col-pag-btn">→</a>
        : <span class="taskhub-col-pag-btn is-disabled" aria-disabled="true">→</span>
      }
    </nav>
  )}
</section>
