---
// src/components/tasks/TaskCard.astro — carte de tâche réutilisable
import TaskStatusBadge from './TaskStatusBadge.astro';
import TaskPriorityBadge from './TaskPriorityBadge.astro';
import CorpsTag from '@/components/corps/CorpsTag.astro';
import type { TaskWithRelations } from '@/lib/types';
interface Props { task: TaskWithRelations; }
const { task } = Astro.props;
---

<article class="rounded border border-slate-300 bg-white p-3 shadow-sm" data-task-id={task.id} draggable="true" tabindex="0">
  <div class="mb-2 flex items-center justify-between gap-2">
    <span class="text-xs font-semibold text-slate-500">{task.reference}</span>
    <TaskPriorityBadge priority={task.priority} />
  </div>
  <h3 class="text-sm font-semibold text-slate-900">{task.title}</h3>
  {task.description && <p class="mt-1 line-clamp-3 text-xs text-slate-600">{task.description}</p>}
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <CorpsTag corps={task.corps} />
    <TaskStatusBadge status={task.status} />
  </div>
</article>
