---
// src/components/tasks/TaskCard.astro — carte de tâche réutilisable
import TaskStatusBadge from './TaskStatusBadge.astro';
import TaskPriorityBadge from './TaskPriorityBadge.astro';
import CorpsTag from '@/components/corps/CorpsTag.astro';
import type { TaskWithRelations } from '@/lib/types';
interface Props { task: TaskWithRelations; class?: string; style?: string; }
const { task, class: className = '', style = '' } = Astro.props;
---

<article class={`taskhub-card ${className}`} style={style} data-task-id={task.id} draggable="true" tabindex="0">
  <div class="taskhub-card-top">
    <span class="taskhub-ref">{task.reference}</span>
    <TaskPriorityBadge priority={task.priority} />
  </div>
  <h3 class="taskhub-card-title">{task.title}</h3>
  {task.description && <p class="taskhub-card-desc">{task.description}</p>}
  <div class="taskhub-chip-row">
    <CorpsTag corps={task.corps} />
    <TaskStatusBadge status={task.status} />
  </div>
</article>

<style>
  .taskhub-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .taskhub-card-desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
