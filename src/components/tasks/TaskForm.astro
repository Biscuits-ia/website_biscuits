---
// src/components/tasks/TaskForm.astro — formulaire complet de création/édition tâche
import { CORPS_CONFIG } from '@/lib/constants';
import type { CorpsType, TaskTypeEnum } from '@/lib/types';

interface MemberOption { id: string; name: string; corps?: CorpsType[]; }
interface SprintOption { id: string; name: string; }
interface Props {
  action?: string;
  method?: 'POST' | 'PATCH';
  members?: MemberOption[];
  sprints?: SprintOption[];
  showAssignee?: boolean;
}

const { action = '/api/tasks/create', method = 'POST', members = [], sprints = [], showAssignee = true } = Astro.props;
const corpsKeys = Object.keys(CORPS_CONFIG) as CorpsType[];
---

<form id="task-form" action={action} method={method} class="taskhub-form">
  <div>
    <label for="corps" class="taskhub-label">Corps métier</label>
    <select id="corps" name="corps" class="taskhub-input" required>
      {corpsKeys.map((c) => <option value={c}>{CORPS_CONFIG[c].label}</option>)}
    </select>
  </div>

  <div>
    <label for="task_type" class="taskhub-label">Type de tâche</label>
    <select id="task_type" name="task_type" class="taskhub-input" required></select>
  </div>

  <div>
    <label for="title" class="taskhub-label">Titre (min. 10 caractères)</label>
    <input id="title" name="title" class="taskhub-input" minlength="10" maxlength="200" required />
  </div>

  <div>
    <label for="description" class="taskhub-label">Description</label>
    <textarea id="description" name="description" rows="4" class="taskhub-input"></textarea>
  </div>

  <div class="taskhub-form-grid-2">
    <div>
      <label for="priority" class="taskhub-label">Priorité</label>
      <select id="priority" name="priority" class="taskhub-input">
        <option value="P0">P0</option><option value="P1">P1</option><option value="P2" selected>P2</option><option value="P3">P3</option>
      </select>
    </div>
    <div>
      <label for="status" class="taskhub-label">Statut</label>
      <select id="status" name="status" class="taskhub-input">
        <option value="backlog" selected>Backlog</option><option value="todo">To Do</option>
      </select>
    </div>
  </div>

  <div class="taskhub-form-grid-2">
    {showAssignee && (
      <div>
        <label for="assignee_id" class="taskhub-label">Assigné</label>
        <select id="assignee_id" name="assignee_id" class="taskhub-input">
          <option value="">Non assigné</option>
          {members.map((m) => <option value={m.id}>{m.name}</option>)}
        </select>
      </div>
    )}
    <div>
      <label for="sprint_id" class="taskhub-label">Sprint</label>
      <select id="sprint_id" name="sprint_id" class="taskhub-input">
        <option value="">Aucun</option>
        {sprints.map((s) => <option value={s.id}>{s.name}</option>)}
      </select>
    </div>
  </div>

  <div class="taskhub-form-grid-2">
    <input name="story_points" type="number" min="0" step="1" placeholder="Story points" class="taskhub-input" />
    <input name="time_estimate_hours" type="number" min="0" step="0.5" placeholder="Heures estimées" class="taskhub-input" />
  </div>

  <div id="dynamic-lists" class="taskhub-form-grid-3">
    <textarea name="acceptance_criteria_text" rows="3" class="taskhub-input" placeholder="Critères (1 par ligne)"></textarea>
    <textarea name="deliverables_text" rows="3" class="taskhub-input" placeholder="Livrables (1 par ligne)"></textarea>
    <textarea name="definition_of_done_text" rows="3" class="taskhub-input" placeholder="DoD (1 par ligne)"></textarea>
  </div>

  <div class="taskhub-form-grid-2">
    <input name="doc_link" type="url" placeholder="Lien documentation" class="taskhub-input" />
    <input name="figma_link" type="url" placeholder="Lien Figma (DESIGN)" class="taskhub-input" />
  </div>

  <button class="btn btn-primary taskhub-btn-lg">Enregistrer la tâche</button>
</form>

<style>
  .taskhub-btn-lg { min-height: 48px; padding: 12px 18px; }
</style>

<script define:vars={{ CORPS_CONFIG }}>
  const corpsSelect = document.getElementById('corps');
  const taskTypeSelect = document.getElementById('task_type');

  function hydrateTaskTypes() {
    if (!(corpsSelect instanceof HTMLSelectElement) || !(taskTypeSelect instanceof HTMLSelectElement)) return;
    const corps = corpsSelect.value;
    const config = CORPS_CONFIG[corps];
    if (!config) return;

    const html = config.defaultTaskTypes
      .map((tt, idx) => `<option value="${tt}" ${idx === 0 ? 'selected' : ''}>${tt}</option>`)
      .join('');
    taskTypeSelect.innerHTML = html;
  }

  corpsSelect?.addEventListener('change', hydrateTaskTypes);
  hydrateTaskTypes();
</script>
