---
// src/components/tasks/TaskPriorityBadge.astro — badge de priorité
import { PRIORITY_CONFIG } from '@/lib/constants';
import type { PriorityLevel } from '@/lib/types';
interface Props { priority: PriorityLevel; }
const { priority } = Astro.props;
const cfg = PRIORITY_CONFIG[priority];
---

<span class={`badge taskhub-badge-priority ${cfg.bgColor} ${cfg.color}`}>{cfg.label}</span>
