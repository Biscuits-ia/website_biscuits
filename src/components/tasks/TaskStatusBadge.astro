---
// src/components/tasks/TaskStatusBadge.astro — badge de statut
import { STATUS_CONFIG } from '@/lib/constants';
import type { TaskStatus } from '@/lib/types';
interface Props { status: TaskStatus; }
const { status } = Astro.props;
const cfg = STATUS_CONFIG[status];
---

<span role="status" class={`inline-flex rounded px-2 py-0.5 text-xs font-medium ${cfg.color} bg-slate-100`}>{cfg.label}</span>
