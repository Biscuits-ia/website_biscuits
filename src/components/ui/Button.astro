---
// src/components/ui/Button.astro — bouton réutilisable
interface Props {
  id?: string;
  variant?: 'primary' | 'secondary' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
}
const { id, variant = 'primary', size = 'md', type = 'button', class: className = '', disabled = false } = Astro.props;

const variantClass = {
  primary: 'btn-primary',
  secondary: 'btn-ghost',
  danger: 'btn-danger',
  ghost: 'btn-ghost',
}[variant];

const sizeClass = {
  sm: 'taskhub-btn-sm',
  md: 'taskhub-btn-md',
  lg: 'taskhub-btn-lg',
}[size];
---

<button id={id} type={type} class={`btn ${variantClass} ${sizeClass} ${className}`} disabled={disabled}>
  <slot />
</button>

<style>
  .taskhub-btn-sm { min-height: 36px; padding: 7px 12px; font-size: var(--text-xs); }
  .taskhub-btn-md { min-height: 44px; padding: 10px 16px; font-size: var(--text-sm); }
  .taskhub-btn-lg { min-height: 50px; padding: 12px 20px; font-size: var(--text-base); }
</style>
