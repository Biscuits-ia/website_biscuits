---
// src/components/ui/Button.astro — bouton réutilisable
interface Props {
  variant?: 'primary' | 'secondary' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
}
const { variant = 'primary', size = 'md', type = 'button', class: className = '', disabled = false } = Astro.props;

const variantClass = {
  primary: 'bg-blue-600 text-white hover:bg-blue-700',
  secondary: 'bg-slate-200 text-slate-900 hover:bg-slate-300',
  danger: 'bg-red-600 text-white hover:bg-red-700',
  ghost: 'bg-transparent text-slate-700 hover:bg-slate-100',
}[variant];

const sizeClass = {
  sm: 'px-2 py-1 text-xs',
  md: 'px-3 py-2 text-sm',
  lg: 'px-4 py-3 text-base',
}[size];
---

<button type={type} class={`rounded border border-slate-300 transition disabled:opacity-50 disabled:cursor-not-allowed ${variantClass} ${sizeClass} ${className}`} disabled={disabled}>
  <slot />
</button>
