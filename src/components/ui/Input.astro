---
// src/components/ui/Input.astro — champ texte réutilisable
interface Props {
  id?: string;
  name?: string;
  type?: string;
  placeholder?: string;
  value?: string;
  required?: boolean;
  class?: string;
}
const { id, name, type = 'text', placeholder = '', value = '', required = false, class: className = '' } = Astro.props;
---

<input id={id} name={name} type={type} placeholder={placeholder} value={value} required={required} class={`w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-300 ${className}`} />
