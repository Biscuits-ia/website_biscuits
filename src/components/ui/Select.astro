---
// src/components/ui/Select.astro — select réutilisable
interface Option { value: string; label: string; }
interface Props { id?: string; name?: string; options: Option[]; value?: string; class?: string; }
const { id, name, options = [], value = '', class: className = '' } = Astro.props;
---

<select id={id} name={name} class={`w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-300 ${className}`}>
  {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
</select>
