---
// dashboard.css importe Tailwind (via tailwind.css) + la charte du dashboard.
// Import ESM (et non <link href="/src/styles/...">) : un chemin source brut
// n'est pas traite par le pipeline Astro et renvoie 404 en production.
import '../styles/dashboard.css';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: {
    type: 'Organization' | 'Service' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, unknown>;
  };
}

const {
  title = 'Administration | Biscuits IA',
  description = "Interface d'administration de Biscuits IA",
  canonical,
  ogImage = '/og-default.webp',
  ogType = 'website',
  schema,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';
const fullCanonical = canonical
  ? `${siteUrl}${canonical}`
  : `${siteUrl}${Astro.url.pathname}`;
const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;
const isProd = import.meta.env.PROD;
const nonce = Astro.locals.nonce;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <BaseHead
      fullTitle={fullTitle}
      description={description}
      fullCanonical={fullCanonical}
      siteUrl={siteUrl}
      ogImage={ogImage}
      ogType={ogType}
      schema={schema}
      isProd={isProd}
      nonce={nonce}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <Header isAdmin />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
