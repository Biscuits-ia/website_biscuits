---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BaseHead from '@/components/BaseHead.astro';

import '@/styles/theme.css';
import '@/styles/global.css';


export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'WebPage';
    data?: Record<string, any>;
  };
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.webp',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';

const fullCanonical = canonical 
  ? `${siteUrl}${canonical}` 
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;

const isProd = import.meta.env.PROD;
const nonce = Astro.locals.nonce;
---

<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <BaseHead
    fullTitle={fullTitle}
    description={description}
    fullCanonical={fullCanonical}
    siteUrl={siteUrl}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
    schema={schema}
    isProd={isProd}
    nonce={nonce}
  />
</head>

<body>

  <Header />

  <slot />

    <Footer />
</body>
</html>