---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ThemeInit from '@/components/ThemeInit.astro';
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';

import '@/styles/theme.css';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'ProfessionalService' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, any>;
  };
  loadGSAP?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits.dev';
const fullCanonical = canonical 
  ? `${siteUrl}${canonical}` 
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Theme initialization (blocking minimal script) -->
  <ThemeInit />
  
  <!-- SEO Component -->
  <SEOHead 
    title={fullTitle}
    description={description}
    canonical={fullCanonical}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />
  
  <!-- Schema.org -->
  {schema && <SchemaOrg type={schema.type} data={schema.data} />}
  
  <!-- Always include Organization schema -->
  {!schema && <SchemaOrg type="Organization" />}
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />
  
  <!-- Preconnect to external domains -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
</head>

<body>
  <!-- Skip link for keyboard navigation -->
  <a href="#main-content" class="skip-link">
    Aller au contenu principal
  </a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <!-- Analytics (Vercel) -->
  {import.meta.env.PROD && (
    <>
      <script is:inline src="https://cdn.vercel-insights.com/v1/script.js" defer></script>
      <script is:inline src="https://va.vercel-scripts.com/v1/speed-insights/script.js" defer></script>
    </>
  )}

  <!-- Cookie Consent (lazy loaded) -->
  <script>
    // ✅ Load cookie consent only after page load
    if (document.readyState === 'complete') {
      import('@/components/svelte/CookieConsent.svelte');
    } else {
      window.addEventListener('load', () => {
        import('@/components/svelte/CookieConsent.svelte');
      });
    }
  </script>
</body>
</html>