---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ThemeInit from '@/components/ThemeInit.astro';
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';

import '@/styles/theme.css';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'ProfessionalService' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, any>;
  };
  loadGSAP?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits.dev';
const fullCanonical = canonical 
  ? `${siteUrl}${canonical}` 
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Theme initialization (blocking minimal script) -->
  <ThemeInit />
  
  <!-- SEO Component -->
  <SEOHead 
    title={fullTitle}
    description={description}
    canonical={fullCanonical}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />
  
  <!-- Schema.org -->
  {schema && <SchemaOrg type={schema.type} data={schema.data} />}
  
  <!-- Always include Organization schema -->
  {!schema && <SchemaOrg type="Organization" />}
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />
  
  <!-- Preconnect to external domains -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
</head>

<body>
  <!-- Skip link for keyboard navigation -->
  <a href="#main-content" class="skip-link">
    Aller au contenu principal
  </a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <!-- Analytics (Vercel) -->
  {import.meta.env.PROD && (
    <>
      <script is:inline src="https://cdn.vercel-insights.com/v1/script.js" defer></script>
      <script is:inline src="https://va.vercel-scripts.com/v1/speed-insights/script.js" defer></script>
    </>
  )}

  <!-- Cookie Consent (lazy loaded) -->
  <script>
    // ✅ Load cookie consent only after page load
    if (document.readyState === 'complete') {
      import('@/components/svelte/CookieConsent.svelte');
    } else {
      window.addEventListener('load', () => {
        import('@/components/svelte/CookieConsent.svelte');
      });
    }
  </script>
  
  <script
    defer
    data-domain="biscuits-ia.com"
    src="https://plausible.io/js/script.js">
  </script>
  
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YSNSBVWCGQ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-YSNSBVWCGQ');
  </script>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-W2273TRX');</script>

  <!-- Privacy-friendly analytics by Plausible -->
<script async src="https://plausible.io/js/pa-UAdXXk6c-CDMpIaBUkl7D.js"></script>
<script is:inline>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>

</body>
</html>