---
import Layout from './Layout.astro';
import NewsletterSocial from '@/components/NewsletterSocial.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  pubDate?: string | Date;
  author?: string;
  image?: string;
  tags?: string[];
}

const {
  title,
  description,
  pubDate,
  author,
  image,
  tags
} = Astro.props;

const publishDate = pubDate ? new Date(pubDate) : new Date();
const formattedDate = publishDate.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const content = await Astro.slots.render('default');
const wordCount = content.split(/\s+/).filter(Boolean).length;
const readingTime = Math.ceil(wordCount / 200);

const ogImage = image
  ? new URL(image, Astro.site).href
  : new URL('/og-default.webp', Astro.site).href;

const schema = {
  type: 'Article' as const,
  data: {
    headline: title,
    description: description,
    image: ogImage,
    datePublished: publishDate.toISOString(),
    dateModified: publishDate.toISOString(),
    author: author || 'Biscuits IA',
    tags: tags
  }
};
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
>
  <Breadcrumb />

  <main class="blog-container">
    <!-- En-tête de l'article -->
    <header class="article-header">
      <h1>{title}</h1>

      <div class="article-meta">
        {pubDate && (
          <>
            <time datetime={publishDate.toISOString()}>
              {formattedDate}
            </time>
            <span class="separator">·</span>
          </>
        )}
        <span class="reading-time">
          {readingTime} min de lecture
        </span>
        {author && (
          <>
            <span class="separator">·</span>
            <span class="author">Par {author}</span>
          </>
        )}
      </div>

      {tags && tags.length > 0 && (
        <div class="article-tags">
          {tags.map((tag: unknown) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Contenu de l'article -->
    <article class="prose">
      <slot />
    </article>

    <!-- Partage social en bas d'article -->
    <NewsletterSocial articleTitle={title} articleUrl={Astro.url.pathname} />

    <!-- Footer de l'article -->
    <footer class="article-footer">
      <p>
        {pubDate && (
          <>
            Publié le <time datetime={publishDate.toISOString()}>{formattedDate}</time>
          </>
        )}
        {author && pubDate && ` par ${author}`}
        {author && !pubDate && `Par ${author}`}
      </p>
    </footer>
  </main>
</Layout>

<style>
  .blog-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-lg);
    padding-top: calc(var(--header-height-desktop) + var(--spacing-2xl));
    min-height: 60vh;
  }

  .article-header {
    margin-bottom: var(--spacing-2xl);
    text-align: center;
  }

  .article-header h1 {
    font-size: clamp(var(--font-size-2xl), 5vw, var(--font-size-4xl));
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
    line-height: 1.2;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    flex-wrap: wrap;
  }

  .separator {
    color: var(--color-border);
  }

  .reading-time,
  .author {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    justify-content: center;
    margin-top: var(--spacing-lg);
  }

  .tag {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-sm);
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .prose {
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-md);
    color: var(--color-text);
  }

  .prose :global(h3) {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
  }

  .prose :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .prose :global(a:hover) {
    color: var(--color-secondary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-xl);
  }

  .prose :global(li) {
    margin-bottom: var(--spacing-xs);
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: var(--spacing-lg);
    margin: var(--spacing-lg) 0;
    font-style: italic;
    color: var(--color-text-light);
  }

  .prose :global(code) {
    background: var(--color-bg-elevated);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    border: 1px solid var(--color-border);
  }

  .prose :global(pre) {
    background: var(--color-gray-50);
    color: var(--color-gray-900);
    padding: var(--spacing-lg);
    overflow-x: auto;
    border: 2px solid var(--color-border);
    margin: var(--spacing-lg) 0;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
    border: none;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    margin: var(--spacing-xl) auto;
    border: 3px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .article-footer {
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-xl);
    border-top: 3px solid var(--color-border);
    text-align: center;
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: var(--spacing-xl) var(--spacing-md);
      padding-top: calc(var(--header-height-mobile) + var(--spacing-xl));
    }

    .article-meta {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .separator {
      display: none;
    }
  }
</style>