---
// src/layouts/DashboardLayout.astro
import '../styles/dashboard.css';
import { requireAuth } from '../lib/auth';
import type { UserRole, AuthResult } from '../lib/auth';
import BaseHead from '@/components/BaseHead.astro';
import Toast from '@/components/ui/Toast.astro';
import ConfirmDialog from '@/components/ui/ConfirmDialog.astro';

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';
const isProd = import.meta.env.PROD;

// ── Props ─────────────────────────────────────────────────────────────────────

export interface NavItem {
  id:     string;
  label:  string;
  icon:   string;
  badge?: string | null;
  href?:  string;
}

export interface Props {
  title:       string;
  activePage?: string;
  userName?:   string;
  userEmail?:  string;
  /** Pass the AuthResult from the page to avoid a second requireAuth call */
  authResult?: AuthResult;
  /** @deprecated — le rôle est désormais lu depuis la BDD, pas depuis cette prop */
  role?:       string;
}

const { title, activePage = '', userName = 'Utilisateur', authResult: passedAuth } = Astro.props;

// ── Rôle réel depuis la BDD ───────────────────────────────────────────────────
// Réutilise le résultat auth de la page parente si disponible,
// sinon fait un appel requireAuth (rétrocompatibilité).
const authResult = passedAuth ?? await requireAuth(Astro);

// Si non connecté, requireAuth redirige — on ne devrait jamais arriver ici
if (authResult instanceof Response) return authResult;

const role: UserRole    = authResult.role;
const isAdmin           = role === 'admin';
const isModerator       = role === 'moderator';
const isBenevole        = role === 'benevole';
const isAssociation     = role === 'association';

// Nom d'affichage : priorité à la prop (passée depuis la page parente),
// sinon on prend le user de authResult
const displayName = userName !== 'Utilisateur'
  ? userName
  : isAssociation
    ? authResult.user.user_metadata?.organization
      ?? authResult.user.user_metadata?.full_name
      ?? authResult.user.email?.split('@')[0]
      ?? 'Structure'
    : authResult.user.user_metadata?.full_name
      ?? authResult.user.email?.split('@')[0]
      ?? 'Utilisateur';

// ── Navigation ────────────────────────────────────────────────────────────────

const userNav: NavItem[] = [
  { id: 'overview',      label: "Vue d'ensemble", icon: 'grid'      },
  { id: 'appointments',  label: 'Rendez-vous',    icon: 'calendar'  },
  { id: 'ateliers',      label: 'Ateliers',       icon: 'calendar'  },
  { id: 'formations',    label: 'Formations',     icon: 'graduation' },
  { id: 'resources',     label: 'Ressources',     icon: 'flag'      },
  { id: 'demandes',      label: 'Mes demandes',   icon: 'inbox'     },
  { id: 'activity',      label: 'Activité',       icon: 'clock'     },
  { id: 'settings',      label: 'Paramètres',     icon: 'settings'  },
];

const adminNav: NavItem[] = [
  { id: 'users',           label: 'Utilisateurs',   icon: 'users',        badge: null  },
  { id: 'projects',        label: 'Projets',        icon: 'folder',       badge: null  },
  { id: 'demandes',        label: 'Demandes',        icon: 'inbox',        badge: null  },
  { id: 'contacts',        label: 'Contacts',        icon: 'mail',         badge: null  },
  { id: 'candidatures',    label: 'Candidatures',    icon: 'user-plus',    badge: null  },
  { id: 'appointments',    label: 'Rendez-vous',     icon: 'calendar',     badge: null  },
  { id: 'ateliers',        label: 'Ateliers',        icon: 'calendar',     badge: null  },
  { id: 'formations',        label: 'Formations',        icon: 'graduation',     badge: null  },
  { id: 'resources',       label: 'Ressources',      icon: 'flag',         badge: null  },
  { id: 'logiciels',       label: 'Logiciels',       icon: 'package',      badge: null  },
  { id: 'trombinoscope',   label: 'Équipe',          icon: 'users',        badge: null  },
  { id: 'logs',            label: 'Logs système',    icon: 'terminal',     badge: 'LIVE'},
];

const benevoleNav: NavItem[] = [
  { id: 'overview',   label: "Vue d'ensemble",  icon: 'grid'     },
  { id: 'projects',   label: 'Projets',          icon: 'folder'   },
  { id: 'tasks',      label: 'Mes tâches',       icon: 'check'    },
  { id: 'calendar',   label: 'Calendrier',       icon: 'calendar' },
  { id: 'equipe',     label: 'Équipe',           icon: 'users'    },
  { id: 'settings',   label: 'Paramètres',       icon: 'settings' },
];

const associationNav: NavItem[] = [
  { id: 'overview',   label: "Vue d'ensemble",  icon: 'grid'     },
  { id: 'projets',    label: 'Projets',          icon: 'folder'   },
  { id: 'rendez-vous',label: 'Rendez-vous',     icon: 'calendar' },
  { id: 'ressources', label: 'Ressources',       icon: 'flag'     },
  { id: 'settings',   label: 'Paramètres',       icon: 'settings' },
];

const nav = isAdmin ? adminNav : isBenevole ? benevoleNav : isAssociation ? associationNav : userNav;
const dashRole = isAdmin ? 'admin' : isBenevole ? 'benevole' : isAssociation ? 'association' : 'user';

// ── Icônes SVG ────────────────────────────────────────────────────────────────

const icons: Record<string, string> = {
  grid:         `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="1.5" width="5" height="5" rx="1"/><rect x="9.5" y="1.5" width="5" height="5" rx="1"/><rect x="1.5" y="9.5" width="5" height="5" rx="1"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/></svg>`,
  folder:       `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.5 3.5h4l1.5 2h7a1 1 0 011 1V13a1 1 0 01-1 1h-12a1 1 0 01-1-1V4.5a1 1 0 011-1z"/></svg>`,
  check:        `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="1.5" width="13" height="13" rx="1"/><polyline points="4.5,8 7,10.5 11.5,5.5"/></svg>`,
  clock:        `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><polyline points="8,4.5 8,8 10.5,9.5"/></svg>`,
  calendar:     `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="2.5" width="13" height="12" rx="1.5"/><line x1="1.5" y1="6.5" x2="14.5" y2="6.5"/><line x1="5" y1="1" x2="5" y2="4"/><line x1="11" y1="1" x2="11" y2="4"/></svg>`,
  inbox:        `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.5 10h3l1.5 2.5h4L11.5 10h3V3.5a1 1 0 00-1-1h-11a1 1 0 00-1 1V10z"/></svg>`,
  'bar-chart':  `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="8.5" width="3" height="5.5"/><rect x="6.5" y="5" width="3" height="9"/><rect x="11.5" y="2" width="3" height="12"/></svg>`,
  settings:     `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.5"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.41 1.41M11.54 11.54l1.41 1.41M3.05 12.95l1.41-1.41M11.54 4.46l1.41-1.41"/></svg>`,
  flag:         `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 1v14M3 2h8.5L9 6l2.5 4H3"/></svg>`,
  mail:         `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="3" width="13" height="10" rx="1.5"/><polyline points="1.5,3 8,9 14.5,3"/></svg>`,
  'user-plus':  `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="5" r="2.5"/><path d="M1 14c0-3 2.24-4 5-4s5 1 5 4"/><line x1="13" y1="5" x2="13" y2="9"/><line x1="11" y1="7" x2="15" y2="7"/></svg>`,
  users:        `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="5" r="2.5"/><path d="M1 14c0-3 2.24-4 5-4s5 1 5 4"/><path d="M11 7.5c1.5 0 2.5.8 2.5 2.5 0 .5-.1.9-.3 1.2M13 4a2 2 0 010 4"/></svg>`,
  'trending-up':`<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1,12 5.5,7 9,9.5 15,3"/><polyline points="11,3 15,3 15,7"/></svg>`,
  terminal:     `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="2.5" width="14" height="11" rx="1.5"/><polyline points="4,6.5 7,9 4,11.5"/><line x1="8.5" y1="11.5" x2="12" y2="11.5"/></svg>`,
  bell:         `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 1.5a4.5 4.5 0 00-4.5 4.5v3l-1.5 2h12l-1.5-2V6A4.5 4.5 0 008 1.5z"/><path d="M6.5 13a1.5 1.5 0 003 0"/></svg>`,
  package:      `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.5 4.5l6-3 6 3v7l-6 3-6-3v-7z"/><path d="M1.5 4.5L7.5 7.5 13.5 4.5"/><line x1="7.5" y1="7.5" x2="7.5" y2="14.5"/></svg>`,
};

const initials = displayName.split(' ').map((n: string) => n[0]).join('').toUpperCase().slice(0, 2);
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <BaseHead
    fullTitle={`${title} — Biscuits`}
    description={`Espace ${isAdmin ? 'administrateur' : isBenevole ? 'bénévole' : isAssociation ? 'association/TPE' : 'membre'} Biscuits IA`}
    fullCanonical={`${siteUrl}/dashboard/${dashRole}`}
    siteUrl={siteUrl}
    isProd={isProd}
    nonce={Astro.locals.nonce}
  />
</head>
<body class={isAdmin ? 'admin-layout' : ''}>
  <div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <div class="sidebar-logo-text">
          <span class="sidebar-logo-name">Biscuits</span>
          <span class="sidebar-logo-sub">{isAdmin ? 'admin' : isBenevole ? 'espace bénévole' : isAssociation ? 'espace association' : 'espace membre'}</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <span class="nav-section">Navigation</span>
        {nav.map((item: NavItem) => (
          <a
            href={item.href ?? `/dashboard/${dashRole}/${item.id === 'overview' ? '' : item.id}`}
            class={`nav-item${activePage === item.id ? ' active' : ''}`}
          >
            <span set:html={icons[item.icon]} />
            {item.label}
            {item.badge && <span class="admin-badge">{item.badge}</span>}
          </a>
        ))}

        {isAdmin && (
          <Fragment>
            <span class="nav-section" style="margin-top:12px">Accès rapide</span>
            <a href="/dashboard/user" class="nav-item nav-item--muted">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" style="width:15px;height:15px">
                <path d="M8 1a7 7 0 100 14A7 7 0 008 1zM8 6a2 2 0 110 4 2 2 0 010-4z"/>
              </svg>
              Vue utilisateur
            </a>
          </Fragment>
        )}
      </nav>

      <div class="sidebar-footer">
        <div class="user-chip">
          <div class="user-avatar">{initials}</div>
          <div class="user-info">
            <div class="user-name">{displayName}</div>
            <div class="user-role">{isAdmin ? 'admin' : isModerator ? 'modérateur' : isBenevole ? 'bénévole' : isAssociation ? 'association' : 'membre'}</div>
          </div>
        </div>
        <a href="/" class="btn btn-ghost btn-full btn-xs-text">
          Retourner à l'accueil
        </a>
        <form method="POST" action="/auth/deconnexion" style="margin:0;">
          <button type="submit" class="btn btn-ghost btn-full btn-xs-text" style="width:100%;border:none;background:none;cursor:pointer;">
            Déconnexion
          </button>
        </form>
      </div>
    </aside>

    <!-- Main -->
    <main class="main">
      <div class="topbar">
        <div class="topbar-title">
          Biscuits &nbsp;/&nbsp; <span>{title}</span>
        </div>
        <div class="topbar-right">
          {isAdmin && (
            <span class="badge badge-warn badge-admin">⚡ Mode admin</span>
          )}
          {isModerator && !isAdmin && (
            <span class="badge badge-info badge-admin">🛡 Modérateur</span>
          )}
          <!-- Cloche de notifications (tous les rôles connectés) -->
          <div class="notif-bell" id="notif-bell-wrapper" style="position:relative">
            <button class="notif-btn" id="btn-notif-bell" aria-label="Notifications" title="Notifications">
              <Fragment set:html={icons['bell']} />
              <span class="notif-badge" id="notif-badge" style="display:none">0</span>
            </button>
            <div class="notif-dropdown" id="notif-dropdown" style="display:none" role="listbox" aria-label="Notifications">
              <div class="notif-dropdown-header">
                <span>Notifications</span>
                <button class="btn btn-ghost btn-xs" id="btn-mark-all-read">Tout marquer lu</button>
              </div>
              <ul class="notif-list" id="notif-list">
                <li class="notif-empty">Chargement…</li>
              </ul>
            </div>
          </div>
          <span class="topbar-date">
            {new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
          </span>
        </div>
      </div>

      <div class="page-content">
        <slot />
      </div>
    </main>

  </div>

  <!-- Notifications + modale de confirmation (global) -->
  <Toast />
  <ConfirmDialog />
</body>

<!-- FIX P0 1.4 : handlers CSP-safe pour les attributs data-* (modal, autosubmit, reload). -->
<script is:inline nonce={Astro.locals.nonce}>
  document.addEventListener('click', (e) => {
    const t = e.target;
    if (!(t instanceof Element)) return;
    const openBtn = t.closest('[data-modal-open]');
    if (openBtn) {
      const id = openBtn.getAttribute('data-modal-open');
      const dlg = id ? document.getElementById(id) : null;
      if (dlg && typeof dlg.showModal === 'function') dlg.showModal();
      return;
    }
    const closeBtn = t.closest('[data-modal-close]');
    if (closeBtn) {
      const id = closeBtn.getAttribute('data-modal-close');
      const dlg = id ? document.getElementById(id) : null;
      if (dlg && typeof dlg.close === 'function') dlg.close();
      return;
    }
    if (t.closest('[data-reload]')) location.reload();
  });
  document.addEventListener('change', (e) => {
    const t = e.target;
    if (!(t instanceof Element)) return;
    const sel = t.closest('[data-autosubmit]');
    if (sel instanceof HTMLSelectElement) sel.form?.requestSubmit();
  });
</script>
</html>

<style>
  .nav-item--muted { font-size: 0.78rem; color: var(--text-muted); }
  .btn-full        { width: 100%; margin-top: 8px; justify-content: center; }
  .btn-xs-text     { font-size: 0.78rem; }
  .topbar-right    { display: flex; align-items: center; gap: 10px; }
  .topbar-date     { font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono); }
  .badge-admin     { font-size: 0.65rem; }

  /* Notification bell */
  .notif-btn       { background: none; border: none; cursor: pointer; padding: 4px 6px; display: flex; align-items: center; position: relative; color: var(--text-secondary); }
  .notif-btn:hover { color: var(--text-primary); }
  .notif-badge     { position: absolute; top: 0; right: 0; background: var(--err); color: #fff; border-radius: 99px; font-size: 0.6rem; font-weight: 700; padding: 1px 4px; line-height: 1; min-width: 14px; text-align: center; }
  .notif-dropdown  { position: absolute; right: 0; top: calc(100% + 6px); width: 320px; background: var(--bg); border: var(--brutal-border); box-shadow: var(--shadow-md); z-index: 200; }
  .notif-dropdown-header { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--border-mid); font-size: var(--text-xs); font-weight: 700; }
  .notif-list      { list-style: none; padding: 0; margin: 0; max-height: 300px; overflow-y: auto; }
  .notif-item      { padding: 10px 12px; border-bottom: 1px solid var(--border-mid); font-size: var(--text-xs); cursor: pointer; }
  .notif-item:hover { background: var(--surface-raised); }
  .notif-item--unread { border-left: 3px solid var(--accent); }
  .notif-item-type { font-weight: 700; color: var(--accent); text-transform: uppercase; font-size: 0.65rem; letter-spacing: .05em; }
  .notif-item-text { color: var(--text-secondary); margin-top: 2px; }
  .notif-item-date { color: var(--text-muted); margin-top: 2px; }
  .notif-empty     { padding: 12px; font-size: var(--text-xs); color: var(--text-muted); text-align: center; }
</style>

<script>
  const bellBtn     = document.getElementById('btn-notif-bell');
  const dropdown    = document.getElementById('notif-dropdown');
  const badge       = document.getElementById('notif-badge');
  const listEl      = document.getElementById('notif-list');
  const markAllBtn  = document.getElementById('btn-mark-all-read');

  let notifData: Array<{ id: string; type: string; read: boolean; created_at: string; payload?: Record<string, string> }> = [];
  let dropdownOpen = false;

  async function fetchNotifications() {
    try {
      const res = await fetch('/api/notifications?limit=15');
      if (!res.ok) return;
      const { data, unread_count } = await res.json();
      notifData = data ?? [];
      if (badge) {
        badge.textContent = String(unread_count ?? 0);
        badge.style.display = unread_count > 0 ? 'block' : 'none';
      }
      renderNotifList();
    } catch { /* silent */ }
  }

  const typeLabels = { mention: 'Mention', assignment: 'Assignation', deadline: 'Échéance', comment: 'Commentaire' };

  function renderNotifList() {
    if (!listEl) return;
    if (!notifData.length) {
      listEl.innerHTML = '<li class="notif-empty">Aucune notification.</li>';
      return;
    }
    listEl.innerHTML = notifData.map(n => {
      const date    = new Date(n.created_at).toLocaleDateString('fr-FR');
      const typeLabel = typeLabels[n.type as keyof typeof typeLabels] ?? n.type;
      const text    = n.type === 'assignment'
        ? `Vous avez été assigné à "${n.payload?.task_title ?? 'une tâche'}"`
        : n.type === 'mention'
        ? `Vous avez été mentionné dans un commentaire`
        : n.type === 'comment'
        ? `Nouveau commentaire sur une tâche que vous suivez`
        : `Notification`;
      return `<li class="notif-item${n.read ? '' : ' notif-item--unread'}" data-id="${n.id}" data-task-id="${n.payload?.task_id ?? ''}" data-project-id="${n.payload?.project_id ?? ''}">
        <div class="notif-item-type">${typeLabel}</div>
        <div class="notif-item-text">${text}</div>
        <div class="notif-item-date">${date}</div>
      </li>`;
    }).join('');

    // Click on notification: navigate + mark read
    listEl.querySelectorAll('.notif-item').forEach(item => {
      item.addEventListener('click', async () => {
        const id        = item.getAttribute('data-id');
        const taskId    = item.getAttribute('data-task-id');
        const projectId = item.getAttribute('data-project-id');
        if (id) {
          await fetch('/api/notifications', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: [id] }),
          });
        }
        if (projectId) window.location.href = `/dashboard/benevole/project/${projectId}`;
        else if (taskId) window.location.href = `/dashboard/benevole/tasks`;
        closeDropdown();
      });
    });
  }

  function openDropdown() {
    if (!dropdown) return;
    dropdown.style.display = 'block';
    dropdownOpen = true;
    fetchNotifications();
  }

  function closeDropdown() {
    if (!dropdown) return;
    dropdown.style.display = 'none';
    dropdownOpen = false;
  }

  bellBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (dropdownOpen) closeDropdown();
    else openDropdown();
  });

  markAllBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    await fetch('/api/notifications', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    await fetchNotifications();
  });

  document.addEventListener('click', (e) => {
    if (dropdownOpen && !document.getElementById('notif-bell-wrapper')?.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // Initial count fetch (silent, non-blocking)
  fetchNotifications();

  // Poll every 60s for new notifications
  setInterval(fetchNotifications, 60_000);
</script>