---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BaseHead from '@/components/BaseHead.astro';
import CookieConsent from '@/components/react/CookieConsent.tsx';

import '@/styles/theme.css';
import '@/styles/global.css';


export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'Service' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, unknown>;
  };
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.webp',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';

const fullCanonical = canonical 
  ? `${siteUrl}${canonical}` 
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;

const isProd = import.meta.env.PROD;
const nonce = Astro.locals.nonce;

const criticalCSS = `
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%;tab-size:4;scroll-behavior:smooth}
  body{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,'Helvetica Neue',Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;color:var(--color-text);background:var(--color-bg-elevated)}
  .skip-link{position:absolute;top:-100px;left:0;background:var(--color-primary);color:var(--color-bg-elevated);padding:0.75rem 1.5rem;z-index:9999;font-weight:600;text-decoration:none;border-radius:0 0 0.5rem 0;transition:top 0.2s ease-in-out;font-size:1rem}
  .skip-link:focus{top:0;outline:3px solid var(--color-text);outline-offset:2px}
  main{min-height:60vh;display:block}
  img{max-width:100%;height:auto;display:block}
  a{color:inherit;text-decoration:underline}
  button{cursor:pointer;font:inherit}
`;
---

<!DOCTYPE html>
<html lang="fr-FR" dir="ltr">
<head>
  <BaseHead
    fullTitle={fullTitle}
    description={description}
    fullCanonical={fullCanonical}
    siteUrl={siteUrl}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
    schema={schema}
    isProd={isProd}
    nonce={nonce}
  >
    <!-- Critical CSS inline pour FCP optimal (Lighthouse Performance) -->
    <style set:html={criticalCSS}></style>
  </BaseHead>
</head>

<body>
  <Header />

  <main id="main-content" role="main">
    <slot />
  </main>

  <Footer />

  <!-- Service Worker (PWA, activé uniquement après opt-in analytics + consentement cookies) -->
  <script is:inline defer src="/sw-register.js"></script>

  <!-- Composants non-critiques chargés après le contenu (améliore TBT) -->
  <CookieConsent client:idle />
</body>

<style is:global>
  /* Styles non-critiques pour éviter le FOUC */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--color-primary);
    color: var(--color-bg-elevated);
    padding: var(--spacing-sm, 0.75rem) var(--spacing-md, 1.5rem);
    z-index: var(--z-tooltip, 9999);
    font-weight: var(--font-weight-semibold, 600);
    text-decoration: none;
    border-radius: 0 0 var(--radius-md, 0.5rem) 0;
    transition: top var(--transition-fast, 0.2s) ease-in-out;
    font-size: 1rem;
  }

  .skip-link:focus {
    top: 0;
    outline: 3px solid var(--color-text);
    outline-offset: 2px;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--color-text);
    outline-offset: 2px;
  }

  main {
    min-height: 60vh;
  }
    
  /* Prévention du CLS pour les images */
  img:not([width]):not([height]) {
    aspect-ratio: attr(width) / attr(height);
  }
  
  /* Amélioration du contraste pour l'accessibilité */
  ::selection {
    background-color: var(--color-primary);
    color: var(--color-bg-elevated);
  }
  
  /* Focus visible amélioré (Accessibility) */
  :focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
  
  /* Réduction du mouvement pour accessibilité */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
  
  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
    }
  }
</style>
</html>