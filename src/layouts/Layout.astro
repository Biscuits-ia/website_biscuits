---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';
import CookieConsent from '@/components/svelte/CookieConsent.svelte';
import SpeedInsights from '@vercel/speed-insights/astro';

import '@/styles/theme.css';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'Service' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, any>;
  };
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.webp',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';

const fullCanonical = canonical 
  ? `${siteUrl}${canonical}` 
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;

const isProd = import.meta.env.PROD;

// Critical CSS inline pour améliorer le FCP (First Contentful Paint)
// Optimisé pour un chargement < 1.36s selon les standards Lighthouse 2026
const criticalCSS = `
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%;tab-size:4;scroll-behavior:smooth}
  body{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,'Helvetica Neue',Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;color:#2C2C2C;background:#fff}
  .skip-link{position:absolute;top:-100px;left:0;background:#faca6f;color:#2C2C2C;padding:0.75rem 1.25rem;z-index:9999;font-weight:600;text-decoration:none;border-radius:0 0 0.5rem 0;transition:top 0.2s ease-in-out}
  .skip-link:focus{top:0;outline:3px solid #2C2C2C;outline-offset:3px}
  main{min-height:60vh;display:block}
  img{max-width:100%;height:auto;display:block}
  a{color:#2C2C2C;text-decoration-skip-ink:auto}
  button{font:inherit;cursor:pointer}
`;
---

<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  
  <!-- Critical CSS inline pour FCP optimal < 1.36s -->
  <style set:html={criticalCSS}></style>
  
  <!-- Preconnect aux domaines critiques pour réduire DNS/TLS time -->
  {isProd && (
    <>
      <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
      <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    </>
  )}
  
  <!-- Preload des ressources critiques pour améliorer LCP -->
  <link rel="preload" href="/fonts/main.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/favicon.webp" as="image" type="image/webp" fetchpriority="low" />
  
  <SEOHead 
    title={fullTitle}
    description={description}
    canonical={fullCanonical}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />
  
  {schema && <SchemaOrg type={schema.type} data={schema.data} />}
  
  {!schema && (
    <>
      <SchemaOrg type="Organization" />
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        "url": fullCanonical,
        "name": fullTitle,
        "description": description,
        "inLanguage": "fr-FR",
        "isPartOf": {
          "@type": "WebSite",
          "url": siteUrl,
          "name": "Biscuits IA"
        }
      })} />
    </>
  )}
  
  <!-- Favicons optimisés -->
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="sitemap" href="/sitemap.xml" />
  
  <!-- Theme color pour PWA -->
  <meta name="theme-color" content="#faca6f" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#2C2C2C" media="(prefers-color-scheme: dark)" />
  
  <!-- GTM avec chargement différé après interaction utilisateur (améliore TTI) -->
  {isProd && (
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      // Chargement différé avec requestIdleCallback pour ne pas bloquer TTI
      const loadGTM = () => {
        if (window.gtmLoaded) return;
        window.gtmLoaded = true;
        
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-W2273TRX');
      };
      
      // Charge GTM après que la page soit interactive
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGTM, { timeout: 2000 });
      } else {
        setTimeout(loadGTM, 2000);
      }
      
      // Charge aussi sur première interaction utilisateur
      ['mousedown', 'touchstart', 'keydown', 'scroll'].forEach(event => {
        document.addEventListener(event, loadGTM, { once: true, passive: true });
      });
    </script>
  )}
</head>

<body>
  {isProd && (
    <noscript>
      <iframe 
        src="https://www.googletagmanager.com/ns.html?id=GTM-W2273TRX"
        height="0" 
        width="0" 
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
        loading="lazy"
      ></iframe>
    </noscript>
  )}

  <!-- Skip link pour accessibilité (WCAG 2.1 Level AA) -->
  <a href="#main-content" class="skip-link">
    Aller au contenu principal
  </a>

  <Header />

  <main id="main-content" role="main">
    <slot />
  </main>

  <Footer />

  <!-- Composants non-critiques chargés après le contenu avec client:idle -->
  <CookieConsent client:idle />
  <SpeedInsights />
</body>

<style is:global>
  /* Fallback styles - le critical CSS inline assure un rendu rapide */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--color-primary, #faca6f);
    color: var(--color-text, #2C2C2C);
    padding: var(--spacing-sm, 0.75rem) var(--spacing-md, 1.25rem);
    z-index: var(--z-tooltip, 9999);
    font-weight: var(--font-weight-semibold, 600);
    text-decoration: none;
    border-radius: 0 0 var(--radius-md, 0.5rem) 0;
    transition: top var(--transition-fast, 0.2s) ease-in-out;
  }

  .skip-link:focus {
    top: 0;
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  .skip-link:focus-visible {
    outline-color: var(--color-text, #2C2C2C);
  }

  main {
    min-height: 60vh;
  }
  
  /* Optimisations pour Core Web Vitals */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
</html>