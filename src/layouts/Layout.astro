---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';
import CookieConsent from '@/components/svelte/CookieConsent.svelte';
import SpeedInsights from '@vercel/speed-insights/astro';

import '@/styles/theme.css';
import '@/styles/global.css';


const isProduction = import.meta.env.PROD;

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'Service' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, any>;
  };
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.webp',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';

const fullCanonical = canonical 
  ? `${siteUrl}${canonical}` 
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;

const isProd = import.meta.env.PROD;

const criticalCSS = `
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%;tab-size:4;scroll-behavior:smooth}
  body{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,'Helvetica Neue',Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;color:#2C2C2C;background:#fff}
  .skip-link{position:absolute;top:-100px;left:0;background:#faca6f;color:#2C2C2C;padding:0.75rem 1.5rem;z-index:9999;font-weight:600;text-decoration:none;border-radius:0 0 0.5rem 0;transition:top 0.2s ease-in-out;font-size:1rem}
  .skip-link:focus{top:0;outline:3px solid #2C2C2C;outline-offset:2px}
  main{min-height:60vh;display:block}
  img{max-width:100%;height:auto;display:block}
  a{color:inherit;text-decoration:underline}
  button{cursor:pointer;font:inherit}
`;
---

<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  
  <!-- Critical CSS inline pour FCP optimal (Lighthouse Performance) -->
  <style set:html={criticalCSS}></style>
  
  <!-- Preconnect aux domaines critiques (améliore LCP) -->
  {isProd && (
    <>
      <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
      <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
      <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    </>
  )}
    
  <SEOHead 
    title={fullTitle}
    description={description}
    canonical={fullCanonical}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />
  
  {schema && <SchemaOrg type={schema.type} data={schema.data} />}
  
  {!schema && (
    <>
      <SchemaOrg type="Organization" />
      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        "url": fullCanonical,
        "name": fullTitle,
        "description": description,
        "inLanguage": "fr-FR",
        "isPartOf": {
          "@type": "WebSite",
          "url": siteUrl,
          "name": "Biscuits IA"
        }
      })} />
    </>
  )}

  {isProduction && (
  <script is:inline>
    if (window.location.hostname === 'biscuits-ia.com') {
      window.__PARTYTOWN_CONFIG = {
        disableSandbox: true,
        skipDeprecatedAPIs: true,
      };
    }
  </script>
  )}
  
  <!-- Favicons optimisés (format moderne) -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  
  {isProd && (
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'GTM-W2273TRX', {
        'anonymize_ip': true,
        'cookie_flags': 'SameSite=None;Secure'
      });
      
      const loadGTM = () => {
        if (window.gtmLoaded) return;
        window.gtmLoaded = true;
        
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-W2273TRX';
        document.head.appendChild(script);
      };
      
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGTM, { timeout: 3000 });
      } else {
        setTimeout(loadGTM, 3000);
      }
      
      ['mousedown', 'touchstart', 'keydown', 'wheel'].forEach(event => {
        document.addEventListener(event, loadGTM, { once: true, passive: true });
      });
    </script>
  )}
</head>

<body>
  {isProd && (
    <noscript>
      <iframe 
        src="https://www.googletagmanager.com/ns.html?id=GTM-W2273TRX"
        height="0" 
        width="0" 
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
        aria-hidden="true"
      ></iframe>
    </noscript>
  )}

  <Header />

  <main id="main-content" role="main">
    <slot />
  </main>

  <Footer />

  <!-- Composants non-critiques chargés après le contenu (améliore TBT) -->
  <CookieConsent client:idle />
  
  {isProd && <SpeedInsights />}
</body>

<style is:global>
  /* Styles non-critiques pour éviter le FOUC */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--color-primary, #faca6f);
    color: var(--color-text, #2C2C2C);
    padding: var(--spacing-sm, 0.75rem) var(--spacing-md, 1.5rem);
    z-index: var(--z-tooltip, 9999);
    font-weight: var(--font-weight-semibold, 600);
    text-decoration: none;
    border-radius: 0 0 var(--radius-md, 0.5rem) 0;
    transition: top var(--transition-fast, 0.2s) ease-in-out;
    font-size: 1rem;
  }

  .skip-link:focus {
    top: 0;
    outline: 3px solid var(--color-text, #2C2C2C);
    outline-offset: 2px;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--color-text, #2C2C2C);
    outline-offset: 2px;
  }

  main {
    min-height: 60vh;
  }
  
  /* Optimisation des polices (réduit CLS) */
  @font-face {
    font-family: 'Inter var';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
  }
  
  /* Prévention du CLS pour les images */
  img:not([width]):not([height]) {
    aspect-ratio: attr(width) / attr(height);
  }
  
  /* Amélioration du contraste pour l'accessibilité */
  ::selection {
    background-color: #faca6f;
    color: #2C2C2C;
  }
  
  /* Focus visible amélioré (Accessibility) */
  :focus-visible {
    outline: 3px solid #faca6f;
    outline-offset: 2px;
  }
  
  /* Réduction du mouvement pour accessibilité */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
  
  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
    }
  }
</style>
</html>