---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BaseHead from '@/components/BaseHead.astro';
import CookieConsent from '@/components/CookieConsent.astro';

// global.css importe deja theme.css (via son propre @import) : inutile de le
// dupliquer ici.
import '@/styles/global.css';


export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'Service' | 'FAQPage' | 'Article' | 'WebPage' | 'HowTo';
    data?: Record<string, unknown>;
  };
  /** Champs GEO (optionnels). Voir composants/Seo/GEO.astro */
  geo?: {
    author?: string;
    authorUrl?: string;
    contentType?: 'human' | 'human-reviewed' | 'ai-assisted';
    lastReviewed?: string;
    expertise?: string;
  };
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.webp',
  ogType = 'website',
  noindex = false,
  schema,
  geo,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';

const fullCanonical = canonical
  ? `${siteUrl}${canonical}`
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;

const isProd = import.meta.env.PROD;
// PUBLIC_ANALYTICS_DISABLED : kill-switch global (preprod, local, incident).
// Expose au client via window.__ANALYTICS_DISABLED__ ; BaseHead le consulte.
//
// Le frontmatter Astro s'execute UNIQUEMENT cote serveur : `typeof window` y vaut
// toujours 'undefined'. L'ancienne version testait `typeof window !== "undefined"`
// avant d'affecter le flag -> branche morte, le kill-switch n'a jamais fonctionne.
// La valeur doit etre serialisee vers le client via define:vars (cf. <head> ci-dessous).
const analyticsDisabled = import.meta.env.PUBLIC_ANALYTICS_DISABLED === 'true';
const nonce = Astro.locals.nonce;

const criticalCSS = `
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%;tab-size:4;scroll-behavior:smooth}
  body{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,'Helvetica Neue',Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;color:var(--color-text);background:var(--color-bg-elevated)}
  .skip-link{position:absolute;top:-100px;left:0;background:var(--color-primary);color:var(--color-bg-elevated);padding:0.75rem 1.5rem;z-index:9999;font-weight:600;text-decoration:none;border-radius:0 0 0.5rem 0;transition:top 0.2s ease-in-out;font-size:1rem}
  .skip-link:focus{top:0;outline:3px solid var(--color-text);outline-offset:2px}
  main{min-height:60vh;display:block}
  img{max-width:100%;height:auto;display:block}
  a{color:inherit;text-decoration:underline}
  button{cursor:pointer;font:inherit}
`;
---

<!DOCTYPE html>
<html lang="fr-FR" dir="ltr">
<head>
  <BaseHead
    fullTitle={fullTitle}
    description={description}
    fullCanonical={fullCanonical}
    siteUrl={siteUrl}
    ogImage={ogImage}
    ogType={ogType}
    schema={schema}
    isProd={isProd}
    nonce={nonce}
  >
    <script is:inline nonce={nonce} define:vars={{ analyticsDisabled }}>
      window.__ANALYTICS_DISABLED__ = analyticsDisabled;
    </script>
    <style set:html={criticalCSS}></style>
  </BaseHead>
</head>

<body>
  <Header />

  <main id="main-content" role="main">
    <slot />
  </main>

  <Footer />

  <!-- Service Worker (PWA, activé uniquement après opt-in analytics + consentement cookies) -->
  <script is:inline nonce={nonce}>
    if (typeof window !== "undefined" && "serviceWorker" in navigator) {
      const reg = function() { navigator.serviceWorker.register("/sw.js").catch(function() {}); };
      if ("requestIdleCallback" in window) window.requestIdleCallback(reg, { timeout: 5000 });
      else window.addEventListener("load", reg);
    }
  </script>

  <!-- Bandeau cookies : composant Astro vanilla (zéro runtime React). -->
  <CookieConsent />
</body>

<style is:global>
  /* Styles non-critiques pour éviter le FOUC */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--color-primary);
    color: var(--color-bg-elevated);
    padding: var(--spacing-sm, 0.75rem) var(--spacing-md, 1.5rem);
    z-index: var(--z-tooltip, 9999);
    font-weight: var(--font-weight-semibold, 600);
    text-decoration: none;
    border-radius: 0 0 var(--radius-md, 0.5rem) 0;
    transition: top var(--transition-fast, 0.2s) ease-in-out;
    font-size: 1rem;
  }

  .skip-link:focus {
    top: 0;
    outline: 3px solid var(--color-text);
    outline-offset: 2px;
  }

  .skip-link:focus-visible {
    outline: 3px solid var(--color-text);
    outline-offset: 2px;
  }

  main {
    min-height: 60vh;
  }

  /* Amélioration du contraste pour l'accessibilité */
  ::selection {
    background-color: var(--color-primary);
    color: var(--color-bg-elevated);
  }

  /* Focus visible amélioré (Accessibility) */
  :focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Réduction du mouvement pour accessibilité */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
    }
  }
</style>
</html>
