---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ThemeInit from '@/components/ThemeInit.astro';
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';
import CookieConsent from '@/components/svelte/CookieConsent.svelte';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import '@/styles/theme.css';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'ProfessionalService' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, any>;
  };
  loadGSAP?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  schema,
  loadGSAP = false
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits.dev';

const fullCanonical = canonical 
  ? `${siteUrl}${canonical}` 
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Biscuits IA",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.webp`,
  "description": "Solutions IA et automatisation pour développeurs et startups tech",
  "email": "contact@biscuits.dev",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "FR"
  },
  "sameAs": [
    "https://linkedin.com/company/biscuits-ia",
    "https://twitter.com/biscuitsIA"
  ]
};

const isProd = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <ThemeInit />
  
  <!-- SEO Component -->
  <SEOHead 
    title={fullTitle}
    description={description}
    canonical={fullCanonical}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />
  
  {schema && <SchemaOrg type={schema.type} data={schema.data} />}
  
  {!schema && (
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  )}
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  
  <!-- Preconnect to external domains (performance) -->
  {isProd && (
    <>
      <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
      <link rel="preconnect" href="https://plausible.io" crossorigin />
    </>
  )}
  
  {isProd && (
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-W2273TRX');
    </script>
  )}
</head>

<body>
  {isProd && (
    <noscript>
      <iframe 
        src="https://www.googletagmanager.com/ns.html?id=GTM-W2273TRX"
        height="0" 
        width="0" 
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
  )}

  <a href="#main-content" class="skip-link">
    Aller au contenu principal
  </a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <CookieConsent client:idle />

  {isProd && (
    <>
      <Analytics />
      <SpeedInsights />
    </>
  )}
  
  {loadGSAP && (
    <script>
      import { initGSAP, killAllAnimations } from '@/animations/core/gsap-config';

      initGSAP();
      
      document.addEventListener('astro:before-swap', () => {
        killAllAnimations();
      });
      
      document.addEventListener('astro:after-swap', () => {
        initGSAP();
      });
    </script>
  )}
  
  {isProd && (
    <>
      <script 
        defer 
        data-domain="biscuits-ia.com" 
        src="https://plausible.io/js/script.js"
      ></script>
      
      <script is:inline>
        window.plausible = window.plausible || function() {
          (plausible.q = plausible.q || []).push(arguments)
        };
      </script>
    </>
  )}
  
  <script is:inline>
    (function() {
      const STORAGE_KEY = 'theme-preference';
      
      function getThemePreference() {
        if (typeof localStorage !== 'undefined' && localStorage.getItem(STORAGE_KEY)) {
          return localStorage.getItem(STORAGE_KEY);
        }
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }

      const theme = getThemePreference();
      document.documentElement.setAttribute('data-theme', theme);
      
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</body>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--color-primary);
    color: white;
    padding: var(--spacing-sm) var(--spacing-md);
    z-index: var(--z-tooltip);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border-radius: 0 0 var(--radius-md) 0;
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: 0;
  }

  main {
    min-height: 60vh;
  }
</style>
</html>