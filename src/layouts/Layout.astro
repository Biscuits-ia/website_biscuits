---
import Header from '@/components/Header.astro';

import ThemeInit from '@/components/ThemeInit.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '../components/svelte/CookieConsent.svelte';
import Analytics from '@vercel/analytics/astro'
import  SpeedInsights  from "@vercel/speed-insights/astro"

import '@/styles/theme.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  structuredData?: object;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.jpg',
  type = 'website',
  structuredData
} = Astro.props;

const siteUrl = 'https://biscuits.dev';
const finalCanonical = canonical || Astro.url.origin + Astro.url.pathname;

const fullTitle = `${title} | ${description}`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Biscuits IA",
  "url": "https://biscuits.dev",
  "logo": "https://biscuits.dev/logo.png",
  "description": "Solutions IA et Automatisation.",
  "email": "contact@biscuits.dev",
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <ThemeInit />
  <!-- SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={finalCanonical} />

  <!-- Theme + UI -->
  <meta name="theme-color" content="#b16f36" />
  <meta name="color-scheme" content="dark light" />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={finalCanonical} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Biscuits IA" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />


  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
  <!-- Robots -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W2273TRX"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <main id="main-content">
    <Header />
    <slot />
    <CookieConsent client:load />
  </main>
  <Footer />
  <Analytics/>
  <SpeedInsights/>
</body>

<script is:inline>
  window.addEventListener('cookieConsentUpdated', (event) => {
    const preferences = event.detail;
    console.log('Préférences mises à jour:', preferences);
  });

  (function() {
      const STORAGE_KEY = 'theme-preference';
      
      function getThemePreference() {
        if (typeof localStorage !== 'undefined' && localStorage.getItem(STORAGE_KEY)) {
          return localStorage.getItem(STORAGE_KEY);
        }
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
      }

      const theme = getThemePreference();
      
      document.documentElement.setAttribute('data-theme', theme);
      
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    })();
</script>

<script>
import { initGSAP, killAllAnimations } from '@/animations/core/gsap-config';

  initGSAP();
  
  document.addEventListener('astro:before-swap', () => {
    killAllAnimations();
  });
  
  document.addEventListener('astro:after-swap', () => {
    initGSAP();
  });

</script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YSNSBVWCGQ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-YSNSBVWCGQ');
  </script>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-W2273TRX');</script>

</html>