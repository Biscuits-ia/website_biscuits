---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEOHead from '@/components/SEO/SEOHead.astro';
import SchemaOrg from '@/components/SEO/SchemaOrg.astro';
import CookieConsent from '@/components/svelte/CookieConsent.svelte';
import SpeedInsights from '@vercel/speed-insights/astro';

import '@/styles/theme.css';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: {
    type: 'Organization' | 'Service' | 'FAQPage' | 'Article' | 'WebPage';
    data?: Record<string, any>;
  };
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://biscuits.dev';

const fullCanonical = canonical 
  ? `${siteUrl}${canonical}` 
  : `${siteUrl}${Astro.url.pathname}`;

const fullTitle = title.includes('|') ? title : `${title} | Biscuits IA`;

const isProd = import.meta.env.PROD;

// Critical CSS inline pour améliorer le FCP
const criticalCSS = `
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%;tab-size:4}
  body{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
  .skip-link{position:absolute;top:-100px;left:0;background:#F5E6D3;color:#2C2C2C;padding:0.5rem 1rem;z-index:9999;font-weight:600;text-decoration:none;border-radius:0 0 0.5rem 0;transition:top 0.2s}
  .skip-link:focus{top:0;outline:2px solid currentColor;outline-offset:2px}
  main{min-height:60vh}
`;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  
  <!-- Critical CSS inline pour FCP optimal -->
  <style set:html={criticalCSS}></style>
  
  <!-- Preconnect aux domaines critiques -->
  {isProd && (
    <>
      <link rel="preconnect" href="https://www.googletagmanager.com" />
      <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    </>
  )}
  
  <!-- Preload des ressources critiques -->
  <link rel="preload" href="/favicon.webp" as="image" type="image/webp" />
  
  <SEOHead 
    title={fullTitle}
    description={description}
    canonical={fullCanonical}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />
  
  {schema && <SchemaOrg type={schema.type} data={schema.data} />}
  
  {!schema && (
    <>
      <SchemaOrg type="Organization" />
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        "url": fullCanonical,
        "name": fullTitle,
        "description": description
      })} />
    </>
  )}
  
  <link rel="icon" type="image/svg+xml" href="/favicon.webp" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap.xml" />
  
  <!-- GTM avec chargement optimisé -->
  {isProd && (
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      // Defer GTM loading after page interactive
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() {
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','GTM-W2273TRX');
        });
      } else {
        setTimeout(function() {
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','GTM-W2273TRX');
        }, 2000);
      }
    </script>
  )}
</head>

<body>
  {isProd && (
    <noscript>
      <iframe 
        src="https://www.googletagmanager.com/ns.html?id=GTM-W2273TRX"
        height="0" 
        width="0" 
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>
  )}

  <a href="#main-content" class="skip-link">
    Aller au contenu principal
  </a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <!-- Composants non-critiques chargés après le contenu -->
  <CookieConsent client:idle />
  <SpeedInsights />
</body>

<style is:global>
  /* Ces styles sont déjà dans le critical CSS inline, 
     mais gardés ici pour le dev et comme fallback */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--color-primary);
    color: white;
    padding: var(--spacing-sm) var(--spacing-md);
    z-index: var(--z-tooltip);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border-radius: 0 0 var(--radius-md) 0;
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: 0;
  }

  main {
    min-height: 60vh;
  }
</style>
</html>