---
import BaseLayout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import erreur404 from '@/assets/404.webp';
---

<BaseLayout title="Erreur 404" description="La page n'existe pas.">
  <section class="wrapper">
    <div class="img-container">
      <Image
        src={erreur404}
        alt="Page introuvable"
        widths={[500]}
        sizes="100vw"
        format="webp"
        quality={80}
        loading="lazy"
      />
    </div>

    <h1>Oups… Page introuvable 🍪</h1>
    <p>
      Impossible de trouver cette page. Peut-être que quelqu'un la mangée. ?
    </p>

    <a href="/" class="btn">Retour à l’accueil</a>
  </section>

  <style>
    .wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 1.5rem;
      padding: 3rem 1rem;
      width: 100%;
    }

    /* LE FIX IMPORTANT */
    .img-container {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Comme astro:assets met l'image dans un <picture> → on le centre */
    .img-container picture {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .img-container img {
      max-width: 530px;
      width: 100%;
      height: auto;
      display: block;
      margin: 0 auto;
    }

    h1 {
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      font-weight: 800;
      color: oklch(37.619% 0.07877 44.64);
    }

    p {
      max-width: 600px;
      line-height: 1.6;
      color: hsl(0, 0%, 33%);
    }

    .btn {
      background: #ffb94a;
      color: #000;
      padding: 0.8rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s ease-in-out;
    }

    .btn:hover {
      background: #ff9d00;
      transform: translateY(-2px);
    }
  </style>
</BaseLayout>
