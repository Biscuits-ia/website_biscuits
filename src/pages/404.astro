---
import BaseLayout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import erreur404 from '@/assets/404.webp';
export const prerender = true;
---

<BaseLayout 
  title="Page introuvable - 404 | Biscuits IA" 
  description="La page que vous recherchez n'existe pas. Retournez à l'accueil ou consultez nos services."
>
  <section class="error-wrapper">
    <div class="error-content">
      <div class="error-image">
        <Image
          src={erreur404}
          alt="Illustration page 404 - Biscuits manquants"
          width={530}
          height={400}
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <h1>Page introuvable</h1>
      
      <p>
        La page que vous cherchez n'existe pas ou a été déplacée.
        Peut-être qu'un biscuit l'a mangée ? Retrouvez nos ressources pour le grand public et les associations, dans une démarche d'intérêt général, solidaire et d'entraide.
      </p>

      <nav class="error-actions" aria-label="Navigation erreur 404">
        <a href="/" class="btn btn-primary">
          Retour à l'accueil
        </a>
        <a href="/services" class="btn btn-secondary">
          Nos services
        </a>
      </nav>

      <div class="error-help">
        <p>Besoin d'aide ?</p>
        <a href="mailto:contact@biscuits-ia.com" class="btn btn-outline">Contactez-nous</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: var(--spacing-3xl) var(--spacing-lg);
  }

  .error-content {
    max-width: 600px;
    text-align: center;
  }

  .error-image {
    margin-bottom: var(--spacing-2xl);
  }

  .error-image img {
    width: 100%;
    height: auto;
    max-width: 530px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
  }

  p {
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-2xl);
  }

  .error-actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-2xl);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: var(--radius-lg);
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base), background-color var(--transition-base);
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .btn-secondary {
    background: var(--color-bg-alt);
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-bg-alt);
    border-color: var(--color-primary);
  }

  .btn:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .error-help {
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-border);
  }

  .error-help p {
    margin-bottom: var(--spacing-sm);
    font-size: 0.95rem;
  }

  .error-help a {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 600;
  }

  .error-help a:hover {
    color: var(--color-primary-dark);
  }

  @media (max-width: 640px) {
    .error-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>