---
export const prerender = true;

import BaseLayout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

// Publics cibles
const publics = [
  {
    id: 'associations',
    title: 'Associations et ONG',
    subtitle: '150.000 associations en France',
    image: '🤝',
    description: 'Associations locales, nationales, humanitaires, environnementales... Nous aidons les structures à mission à utiliser l\'IA pour leur mission, pas pour faire de la technologie pour la technologie.',
    features: [
      'Bénévoles avec compétences numériques limitées',
      'Budgets restreints pour le numérique',
      'Besoin de gagner du temps sur l\'administratif',
      'Envie d\'expérimenter l\'IA sans risque'
    ],
    cta: 'Voir nos services pour associations',
    href: '/public/associations',
  },
  {
    id: 'collectivites',
    title: 'Collectivités et Mairies',
    subtitle: 'Communes, CCAS, EPCI',
    image: '🏛️',
    description: 'Nous accompagnons les collectivités dans leur transformation numérique. Sans dépendance à un éditeur, avec des outils auditable et adaptés au service public.',
    features: [
      'Agents publics en besoin de support',
      'Démarches administratives complexes',
      'Sensibilisation des élus à l\'IA',
      'Service citoyen amélioré'
    ],
    cta: 'Voir nos services pour collectivités',
    href: '/public/collectivites'
  },
  {
    id: 'seniors',
    title: 'Seniors et publics fragiles',
    subtitle: 'Accompagnement individuel',
    image: '👴',
    description: 'Notre service Anti Pepins et nos bénévoles sont à disposition pour accompagner les publics les plus vulnérables face aux arnaques numériques.',
    features: [
      'Sensibilisation aux arnaques IA',
      'Aide à la détection de faux sites',
      'Accompagnement personnalisé',
      'Rien à dépenser'
    ],
    cta: 'Découvrir Anti Pepins',
    href: '/anti-pepins'
  },
  {
    id: 'recherche',
    title: 'Recherche et terrain',
    subtitle: 'Universités, instituts, acteurs locaux',
    image: '🔬',
    description: 'Nous menons des recherches participatives et concevons des modèles ouverts en agronomie, nutrition et santé, co-construits avec celles et ceux qui les utiliseront.',
    features: [
      'Recherche-action en agroécologie et santé communautaire',
      'Modèles ouverts documentés, en libre accès',
      'Partenariats avec universités et instituts',
      'Diffusion en français et en langues locales'
    ],
    cta: 'Découvrir le pilier Recherche',
    href: '/piliers/recherche'
  }
];

// Ce qu'on ne fait PAS
const notWhatWeDo = [
  "Pas de prestations pour les entreprises, quelle que soit leur taille",
  "Pas de contrats d'engagement longs et verrouillants",
  "Pas de solution boîte noire sans explication",
  "Pas de dépendance à un éditeur",
  "Pas de service client standardisé"
];
---

<BaseLayout
  title="À qui s'adresse Biscuits IA ? | Publics cibles"
  description="Biscuits IA s'adresse aux associations, aux collectivités et au grand public. Pas d'entreprises, pas de solutions commerciales — seulement du service d'intérêt général."
  schema={{
    type: 'WebPage',
    data: {
      name: 'À qui s\'adresse Biscuits IA',
      description: 'Publics cibles : associations, collectivités, grand public et partenaires de recherche. Notre mission d\'intérêt général.',
    },
  }}
>
  <Breadcrumb />
  <section class="hero">
    <div class="container">
      <h1>À qui s'adresse Biscuits IA ?</h1>
      <p class="subtitle">Notre mission d'intérêt général s'écrit pour des structures qui n'ont pas les moyens de se payer des prestations coûteuses — mais qui ont un besoin urgent d'outils numériques utiles.</p>
    </div>
  </section>

  <section class="intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-text">
          <p class="lead">
            Biscuits IA n'est pas fait pour tout le monde — et c'est voulu.
          </p>
          <p>
            Nous nous concentrons sur celles et ceux qui en ont le plus besoin et qui ont le moins de moyens : associations, collectivités et grand public.
          </p>
          <p class="lead">
            C'est notre mission d'intérêt général. Pas une stratégie commerciale.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="publics-section">
    <div class="container">
      <h2>Nos publics cibles</h2>
      <div class="publics-grid">
        {publics.map((p) => (
          <article class="public-card">
            <div class="public-icon">{p.image}</div>
            <div class="public-header">
              <h3>{p.title}</h3>
              <span class="public-subtitle">{p.subtitle}</span>
            </div>
            <p class="public-desc">{p.description}</p>
            <ul class="public-features">
              {p.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <a href={p.href} class="public-cta">{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="not-what-we-do-section">
    <div class="container">
      <div class="not-what-we-do-card">
        <h2>À qui on ne s'adresse pas ?</h2>
        <p class="subtitle">Notre approche n'est pas adaptée à :</p>
        <ul class="not-features">
          {notWhatWeDo.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
        <p class="note">
          Ce n'est pas une valeur négative — c'est simplement une question de mission d'intérêt général. Si vous êtes une entreprise, il y a des acteurs dont c'est le métier et qui seront mieux adaptés à vos besoins.
        </p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-box">
        <h2>Vous pensez que vous faites partie de nos publics ?</h2>
        <p>Parlez-nous de votre situation. On vous répondra honnêtement — qu'on puisse vous aider ou pas.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn-primary">Discuter de mon projet</a>
          <a href="/services" class="btn-secondary">Voir nos services</a>
        </div>
      </div>
    </div>
  </section>

  <section class="publics-details-section">
    <div class="container">
      <h2>Des publics, des besoins spécifiques</h2>
      <div class="publics-details-grid">
        <div class="public-detail">
          <h3>Associations</h3>
          <p>Des bénévoles motivés mais souvent débordés, des ressources limitées, une mission à portée humaine. Chez Biscuits IA, on comprend que la technologie doit servir la mission — pas l'inverse.</p>
          <a href="/public/associations" class="detail-link">En savoir plus</a>
        </div>
        <div class="public-detail">
          <h3>Collectivités</h3>
          <p>Des agents publics au service des citoyens, des contraintes budgétaires fortes, et une obligation de service public. On accompagne sans imposer, avec des outils auditable par tous.</p>
          <a href="/public/collectivites" class="detail-link">En savoir plus</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1100px, 92vw);
    margin: 0 auto;
  }

  /* Hero */
  .hero {
    padding: 6rem 0 4rem;
    text-align: center;
    background: var(--color-bg);
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 900;
    margin: 0 0 1.5rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-light);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.65;
  }

  /* Intro */
  .intro-section {
    padding: 4rem 0;
    background: var(--color-bg-alt);
  }

  .intro-grid {
    max-width: 700px;
    margin: 0 auto;
  }

  .intro-text {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-text-light);
  }

  .intro-text .lead {
    margin-bottom: 1.25rem;
  }

  .intro-text .lead.highlight {
    color: var(--color-primary);
    font-weight: 600;
    background: rgba(0, 0, 0, 0.03);
    padding: 1.25rem;
    border-radius: 12px;
    border-left: 4px solid var(--color-primary);
  }

  /* Publics */
  .publics-section {
    padding: 5rem 0;
    background: var(--color-bg);
  }

  .publics-section h2 {
    text-align: center;
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 900;
    margin: 0 0 3rem;
    color: var(--color-text);
  }

  .publics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .public-card {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: 16px;
    padding: 2rem;
    transition: all 0.2s ease;
  }

  .public-card.highlight {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
    background: var(--color-bg-alt);
  }

  .public-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .public-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .public-header {
    margin-bottom: 1rem;
  }

  .public-header h3 {
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
    color: var(--color-text);
  }

  .public-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .public-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-light);
    margin: 0 0 1.5rem;
  }

  .public-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .public-features li {
    padding: 0.5rem 0 0.5rem 1.25rem;
    position: relative;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .public-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .public-cta {
    display: block;
    text-align: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg);
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .public-cta:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Not What We Do */
  .not-what-we-do-section {
    padding: 5rem 0;
    background: var(--color-bg-alt);
  }

  .not-what-we-do-card {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: 16px;
    padding: 3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .not-what-we-do-card h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .not-what-we-do-card .subtitle {
    font-size: 1rem;
    color: var(--color-text-light);
    margin: 0 0 1.5rem;
  }

  .not-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .not-features li {
    padding: 0.6rem 0;
    color: var(--color-text-light);
    font-size: 0.95rem;
  }

  .not-features li::before {
    content: '×';
    color: #c0392b;
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .note {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.6;
    background: rgba(0, 0, 0, 0.03);
    padding: 1rem;
    border-radius: 8px;
  }

  /* CTA */
  .cta-section {
    padding: 5rem 0 6rem;
    background: var(--color-bg);
  }

  .cta-box {
    background: var(--color-primary);
    color: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-box h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: inherit;
  }

  .cta-box p {
    font-size: 1.05rem;
    line-height: 1.65;
    opacity: 0.9;
    margin: 0 0 2rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.8rem;
    background: var(--color-bg);
    color: var(--color-primary);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 10px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.8rem;
    background: transparent;
    color: var(--color-bg);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 10px;
    transition: all 0.15s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-bg);
  }

  /* Publics Details */
  .publics-details-section {
    padding: 5rem 0;
    background: var(--color-bg-alt);
  }

  .publics-details-section h2 {
    text-align: center;
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 900;
    margin: 0 0 3rem;
    color: var(--color-text);
  }

  .publics-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .public-detail {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: 16px;
    padding: 2rem;
    transition: all 0.2s ease;
  }

  .public-detail:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
  }

  .public-detail h3 {
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .public-detail p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-light);
    margin: 0 0 1rem;
  }

  .detail-link {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .detail-link:hover {
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .publics-grid {
      grid-template-columns: 1fr;
    }

    .publics-details-grid {
      grid-template-columns: 1fr;
    }

    .not-what-we-do-card {
      padding: 2rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 2rem;
    }

    .cta-box {
      padding: 2rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .public-card, .public-detail, .not-what-we-do-card {
      transition: none;
    }
    .public-card:hover, .public-detail:hover {
      transform: none;
    }
  }
</style>
