---
// src/pages/aide-victimes.astro
// Annuaire d'orientation pour les victimes de cybercriminalite, harcelement en
// ligne et arnaques. Biscuits IA n'accompagne plus directement les victimes :
// on refere vers les associations et services publics specialises.
// Pilier 2 (lutte contre la cybercriminalite).

export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const schema = {
  type: 'WebPage' as const,
  data: {
    name: "Annuaire d'associations d'aide aux victimes | Biscuits IA",
    description:
      "Annuaire d'associations specialisees dans l'aide aux victimes de cybercriminalite, harcelement en ligne et arnaques. Biscuits IA n'accompagne plus directement les victimes, mais refere les structures competentes.",
  },
};

interface Assoc {
  name: string;
  short: string;
  desc: string;
  phone?: string;
  url?: string;
}

const assosGeneralistes: Assoc[] = [
  {
    name: 'France Victimes',
    short: '116 006',
    phone: '116006',
    url: 'https://www.france-victimes.fr/',
    desc: "Numero gratuit d'aide aux victimes, ouvert 7j/7. Accueil, ecoute, accompagnement juridique et orientation vers le bureau d'aide aux victimes le plus proche (130 associations locales en France).",
  },
  {
    name: 'INAVEM',
    short: 'Federation',
    url: 'https://www.inavem.org/',
    desc: "Federation nationale des associations d'aide aux victimes. Represente 130 structures locales, forme les professionnels, publie des guides.",
  },
  {
    name: 'AVEC',
    short: 'Aide aux Victimes d\'Escroqueries',
    url: 'https://www.avecfrance.fr/',
    desc: "Association specialisee dans l'aide aux victimes d'escroqueries bancaires, d'usurpation d'identite et de cybermalveillance. Accompagnement administratif, juridique et psychologique.",
  },
  {
    name: 'Cybermalveillance.gouv.fr',
    short: '0 805 805 817',
    phone: '0805805817',
    url: 'https://www.cybermalveillance.gouv.fr/',
    desc: "Dispositif national d'assistance aux victimes de cybermalveillance : diagnostic en ligne, mise en relation avec des prestataires agrees, guides de securite.",
  },
];

const assosMineurs: Assoc[] = [
  {
    name: 'e-Enfance / 3018',
    short: '3018',
    phone: '3018',
    url: 'https://www.e-enfance.org/',
    desc: "Numero national contre le cyberharcelement et les violences numeriques touchant les mineurs. Gratuit, anonyme, 7j/7 de 9h a 23h.",
  },
  {
    name: '119 - Allo Enfance en Danger',
    short: '119',
    phone: '119',
    url: 'https://www.allo119.gouv.fr/',
    desc: "Service public gratuit, joignable 24h/24, pour signaler une situation d'enfant en danger ou en risque de l'etre.",
  },
  {
    name: 'Action Innocence',
    short: 'ONG',
    url: 'https://www.actioninnocence.org/',
    desc: "ONG dediee a la protection de l'enfance sur internet. Sensibilisation en milieu scolaire, ressources educatives, accompagnement des familles.",
  },
  {
    name: 'Point de Contact',
    short: 'Signalement',
    url: 'https://www.pointdecontact.net/',
    desc: "Plateforme de signalement de contenus illicites en ligne (pedopornographie, haine, incitation a la violence). Les signalements sont transmis aux services de police.",
  },
];

const assosParents: Assoc[] = [
  {
    name: 'Internet Sans Crainte (CNIL)',
    short: 'Programme national',
    url: 'https://www.internetsanscrainte.fr/',
    desc: "Programme national d'education numerique des jeunes pilote par la CNIL. Kits pedagogiques, videos, serious games pour les ecoles et les familles.",
  },
  {
    name: 'CNIL Junior',
    short: '7-12 ans',
    url: 'https://www.cnil.fr/fr/junior',
    desc: "Espace dedie aux 7-12 ans : videos, BD interactives et quizzes pour comprendre la vie privee, les traces numeriques et le droit a l'image.",
  },
  {
    name: 'e-Enfance - Guides Parents',
    short: 'Guides',
    url: 'https://www.e-enfance.org/parents',
    desc: "Guides pratiques pour les parents sur les ecrans, les reseaux sociaux, les regles de partage et la reaction en cas de cyberharcelement.",
  },
  {
    name: 'Action Innocence - Sensibilisation',
    short: 'Scolaire',
    url: 'https://www.actioninnocence.org/',
    desc: "Interventions en milieu scolaire, formations pour les enseignants et outils pour ouvrir le dialogue avec les enfants sur leur vie numerique.",
  },
];
---

<Layout
  title="Annuaire d'aide aux victimes | Biscuits IA"
  description="Vous etes victime d'arnaque, d'usurpation d'identite ou de harcelement en ligne ? Consultez notre annuaire d'associations specialisees (France Victimes 116 006, e-Enfance 3018, etc.) et les numeros d'urgence."
  schema={schema}
>
  <Breadcrumb />

  <section class="victim-hero">
    <div class="container">
      <p class="eyebrow">Pilier 2 - Lutte contre la cybercriminalite</p>
      <h1>Vous etes victime, voici qui peut vous aider.</h1>
      <p class="lead">
        Biscuits IA n'accompagne plus directement les victimes. En revanche, on a
        repertorie pour vous les numeros d'urgence, les associations specialisees
        et les services publics capables de prendre le relais, gratuitement et
        sans jugement.
      </p>
    </div>
  </section>

  <section id="contacts-urgence" class="urgence">
    <div class="container">
      <h2>Numeros d'urgence</h2>
      <p class="urgence-intro">
        Si vous etes en danger immediat ou si l'argent a deja commence a bouger,
        appelez en priorite. Ce sont des services publics, pas une aide interne.
      </p>
      <div class="urgence-grid">
        <a class="urgence-card" href="tel:3018">
          <span class="urgence-num">3018</span>
          <strong>Cyberharcelement et mineurs</strong>
          <span class="urgence-meta">Gratuit, anonyme, 7j/7 - 9h-23h</span>
        </a>
        <a class="urgence-card" href="tel:17">
          <span class="urgence-num">17</span>
          <strong>Police / Gendarmerie</strong>
          <span class="urgence-meta">Urgences en cours - appel direct</span>
        </a>
        <a class="urgence-card" href="tel:3919">
          <span class="urgence-num">3919</span>
          <strong>Violences conjugales</strong>
          <span class="urgence-meta">Gratuit, anonyme - appel direct</span>
        </a>
        <a class="urgence-card" href="tel:0805805817">
          <span class="urgence-num">0 805 805 817</span>
          <strong>Cybermalveillance.gouv.fr</strong>
          <span class="urgence-meta">Diagnostic et assistance - gratuit</span>
        </a>
        <a class="urgence-card" href="https://www.internet-signalement.gouv.fr" rel="noopener noreferrer" target="_blank">
          <strong>PHAROS</strong>
          <span class="urgence-meta">Signalement en ligne (arnaques, contenus illicites)</span>
        </a>
        <a class="urgence-card" href="https://www.service-public.fr/particuliers/vosdroits/F1435" rel="noopener noreferrer" target="_blank">
          <strong>Pre-plainte en ligne</strong>
          <span class="urgence-meta">Pour les infractions dont l'auteur est inconnu</span>
        </a>
      </div>
    </div>
  </section>

  <section class="annuaire">
    <div class="container">
      <h2>Associations generalistes cyber / arnaques</h2>
      <p class="annuaire-intro">
        Structures specialisees dans l'aide aux victimes de cybercriminalite,
        d'escroqueries bancaires ou d'usurpation d'identite.
      </p>
      <div class="annuaire-grid">
        {assosGeneralistes.map((a) => (
          <article class="annuaire-card">
            <h3>{a.name}</h3>
            <p class="annuaire-short">{a.short}</p>
            <p class="annuaire-desc">{a.desc}</p>
            <div class="annuaire-actions">
              {a.phone && <a class="btn-ghost btn-phone" href={`tel:${a.phone}`}>{a.short}</a>}
              {a.url && <a class="btn-ghost btn-site" href={a.url} rel="noopener noreferrer" target="_blank">Site officiel</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="annuaire annuaire-alt">
    <div class="container">
      <h2>Specialisees mineurs / harcelement</h2>
      <p class="annuaire-intro">
        Pour les situations impliquant un enfant ou un adolescent : harcelement
        scolaire, cyberharcelement, exposition a des contenus choquants.
      </p>
      <div class="annuaire-grid">
        {assosMineurs.map((a) => (
          <article class="annuaire-card">
            <h3>{a.name}</h3>
            <p class="annuaire-short">{a.short}</p>
            <p class="annuaire-desc">{a.desc}</p>
            <div class="annuaire-actions">
              {a.phone && <a class="btn-ghost btn-phone" href={`tel:${a.phone}`}>{a.short}</a>}
              {a.url && <a class="btn-ghost btn-site" href={a.url} rel="noopener noreferrer" target="_blank">Site officiel</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="annuaire">
    <div class="container">
      <h2>Parents / education numerique</h2>
      <p class="annuaire-intro">
        Pour prevenir, dialoguer et accompagner les plus jeunes dans leur vie
        numerique, en dehors de toute situation d'urgence.
      </p>
      <div class="annuaire-grid">
        {assosParents.map((a) => (
          <article class="annuaire-card">
            <h3>{a.name}</h3>
            <p class="annuaire-short">{a.short}</p>
            <p class="annuaire-desc">{a.desc}</p>
            <div class="annuaire-actions">
              {a.phone && <a class="btn-ghost btn-phone" href={`tel:${a.phone}`}>{a.short}</a>}
              {a.url && <a class="btn-ghost btn-site" href={a.url} rel="noopener noreferrer" target="_blank">Site officiel</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="biscuits-role">
    <div class="container">
      <h2>Ce que Biscuits IA peut encore faire pour vous</h2>
      <p class="biscuits-intro">
        On n'accompagne plus les victimes en direct, mais on garde quelques
        outils gratuits qui peuvent servir immediatement.
      </p>
      <ul class="biscuits-list">
        <li>
          <a href="https://anti-pepins.biscuits-ia.com/" rel="noopener noreferrer">Anti Pepins</a>
          - analysez tout de suite un SMS, un mail ou un lien suspect. Verdict en moins d'une minute, sans transmettre le contenu a un humain.
        </li>
        <li>
          <a href="/ressources">Ressources et guides pratiques</a>
          - fiches telechargeables sur le phishing, la protection des comptes, les demarches de signalement et le RGPD.
        </li>
        <li>
          <a href="/blog">Blog</a>
          - articles sur les arnaques recentes (deepfakes, arnaque au president, fausses annonces de location) pour apprendre a les reperer.
        </li>
        <li>
          <a href="/contact?sujet=orientation-victime">Contact general</a>
          - une question non-urgente ? Notre formulaire de contact standard vous repond. Ce n'est pas un service d'urgence, comptez quelques jours ouvres.
        </li>
      </ul>
    </div>
  </section>

  <section class="rgpd">
    <div class="container">
      <h2>Confidentialite et RGPD</h2>
      <p>
        Cette page ne collecte aucune donnee. Les liens vers des services tiers
        (PHAROS, pre-plainte en ligne, associations) renvoient vers des sites
        qui appliquent leur propre politique de confidentialite. Biscuits IA ne
        revend aucun de vos renseignements et n'a aucun acces aux echanges que
        vous pouvez avoir avec ces structures.
      </p>
      <p>
        Pour en savoir plus, consultez notre
        <a href="/legal/politique-de-confidentialite">politique de confidentialite</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .victim-hero {
    padding: 5rem 1.5rem 3rem;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    text-align: center;
  }

  .victim-hero .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #c0392b;
    margin-bottom: 0.75rem;
  }

  .victim-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .lead {
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }

  .urgence {
    padding: 4rem 1.5rem;
    background: #fff5f3;
    border-top: 4px solid #c0392b;
    border-bottom: 4px solid #c0392b;
  }

  .urgence .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .urgence h2 {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .urgence-intro,
  .annuaire-intro,
  .biscuits-intro {
    text-align: center;
    color: var(--color-text-light);
    max-width: 720px;
    margin: 0 auto 2rem;
    line-height: 1.55;
  }

  .urgence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1rem;
  }

  .urgence-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .urgence-card:hover,
  .urgence-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 4px 4px 0 var(--color-border);
  }

  .urgence-num {
    font-size: 2rem;
    font-weight: 900;
    color: #c0392b;
    line-height: 1;
  }

  .urgence-card strong {
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .urgence-meta {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .annuaire {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .annuaire-alt {
    background: var(--color-bg-alt);
  }

  .annuaire .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .annuaire h2 {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .annuaire-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1.25rem;
  }

  .annuaire-card {
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .annuaire-card h3 {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0;
    color: var(--color-text);
  }

  .annuaire-short {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #c0392b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .annuaire-desc {
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.55;
  }

  .annuaire-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-border);
    background: transparent;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 700;
    font-size: 0.9rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .btn-ghost:hover,
  .btn-ghost:focus-visible {
    background: var(--color-bg);
    transform: translateY(-2px);
    box-shadow: 3px 3px 0 var(--color-border);
  }

  .btn-phone {
    background: #c0392b;
    color: #fff;
    border-color: #c0392b;
  }

  .btn-phone:hover,
  .btn-phone:focus-visible {
    background: #a3311f;
    color: #fff;
  }

  .biscuits-role {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .biscuits-role .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .biscuits-role h2 {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .biscuits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .biscuits-list li {
    padding: 1rem 1.25rem;
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    color: var(--color-text);
    line-height: 1.55;
  }

  .biscuits-list a {
    color: var(--color-primary);
    font-weight: 700;
  }

  .rgpd {
    padding: 3rem 1.5rem 4rem;
    background: var(--color-bg-alt);
  }

  .rgpd .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .rgpd h2 {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .rgpd p {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .rgpd a {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
