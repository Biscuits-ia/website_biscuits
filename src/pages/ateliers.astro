---
import BaseLayout from '@/layouts/Layout.astro';
import { createSupabaseClient } from '@/lib/supabase';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { jsonLd } from '@/lib/jsonLd';

export const prerender = true;

// Page statique (prerender = true) : on utilise le client standard (clé anon).
// Le service_role n'est PAS exposé au build Vercel, et la RLS sur workshops
// autorise de toute façon la lecture anon des lignes publiées.
//
// try/catch : createSupabaseClient() lance une exception SYNCHRONE si
// PUBLIC_SUPABASE_URL manque (cf. src/lib/supabase.ts) -- ca arrive avant
// meme le .from(), donc le destructuring { data, error } habituel ne
// l'attrape pas et ca fait planter tout le build Vercel. On retombe sur la
// meme forme { data: null, error } que le fallback RLS existant, pour
// reutiliser l'empty-state deja present plus bas.
// eslint-disable-next-line @typescript-eslint/no-explicit-any -- meme forme que le retour non-type de supabase-js ici
let workshops: any[] | null = null;
let error: { message: string } | null = null;
try {
  const result = await createSupabaseClient(Astro)
    .from('workshops')
    .select('id, title, description, category, level, price_cents, price_label, is_free')
    // RLS policies sur workshops permettent la lecture anon des lignes publies.
    // Si la policy choue, fallback gracieux : on affiche un empty-state.
    .order('price_cents', { ascending: true });
  workshops = result.data;
  error = result.error;
} catch (e) {
  error = { message: e instanceof Error ? e.message : 'Connexion a la base de donnees indisponible' };
}

// Map level label → CSS class suffix and emoji icon
function levelClass(level: string | null): string {
  if (!level) return 'level-beginner';
  const l = level.toLowerCase();
  if (l.includes('inter')) return 'level-intermediate';
  if (l.includes('avan') || l.includes('colla')) return 'level-advanced';
  return 'level-beginner';
}

function levelIcon(level: string | null, _category: string | null): string {
  if (!level) return '📥';
  const l = level.toLowerCase();
  if (l.includes('inter')) return '🧠';
  if (l.includes('colla')) return '🌐';
  if (l.includes('avan')) return '🚀';
  return '📥';
}

// ItemList JSON-LD : enumere les ateliers publies dans le graphe structure.
// Pas de page detail par atelier -> items sans `url`, juste name/description.
const workshopsItemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": (workshops ?? []).map((w, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Service",
      "name": w.title,
      "description": w.description,
    },
  })),
};
---

<BaseLayout
  title="Ateliers IA | Biscuits IA"
  description="Découvrez nos ateliers pour apprendre à utiliser l'intelligence artificielle dans vos projets associatifs ou TPE."
  schema={{ type: 'Service', data: { serviceType: 'Formation IA', name: 'Ateliers Biscuits IA', description: 'Ateliers pratiques pour apprendre l\u2019IA accessible aux associations et TPE.' } }}
>
  <Breadcrumb />
  <section class="hero-workshops">
    <div class="container">
      <div class="hero-content">
        <h1>Apprendre ensemble, sans prise de tete</h1>
        <p class="hero-subtitle">
          Des ateliers ouverts a toutes et tous — benevoles, equipes, curieux — pour apprivoiser l'IA a votre rythme, dans la bonne humeur.
        </p>
      </div>
    </div>
  </section>

  <section class="workshops-section">
    <div class="container">
      <div class="section-header">
        <h2>Nos Ateliers</h2>
        <p>Des moments d'echange pour apprendre et experimenter ensemble — a son rythme, sans jugement</p>
      </div>
      
      {error && (
        <p class="workshops-error" role="alert">
          Impossible de charger les ateliers pour le moment. Reessayez plus tard.
        </p>
      )}

      <div class="workshops-grid">
        {(workshops ?? []).map((w, i) => (
          <article class={`workshop-card ${levelClass(w.level)}${i === 1 ? ' featured' : ''}`}>
            {i === 1 && <div class="featured-badge">⭐ Populaire</div>}
            <div class="card-header">
              <div class="level-badge">
                <span class="level-dot"></span>
                {w.level ?? 'Tous niveaux'}
              </div>
              {w.category && <div class="duration">{w.category}</div>}
            </div>

            <div class="card-icon">
              <span class="icon-wrapper">{levelIcon(w.level, w.category)}</span>
            </div>

            <div class="card-content">
              <h3>{w.title}</h3>
              {w.description && <p>{w.description}</p>}
            </div>

            <div class="card-footer">
              <div class="price">
                {w.is_free ? 'Gratuit' : (w.price_label ?? `${(w.price_cents / 100).toFixed(0)} €`)}
              </div>
              <a href="/ateliers/inscription" class="btn-workshop">S'inscrire</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  
  <section class="benefits-section">
    <div class="container">
      <h2>Pourquoi nos ateliers ?</h2>
      <div class="benefits-grid">
        <div class="benefit-item">
          <div class="benefit-icon">💡</div>
          <h3>Pratique avant tout</h3>
          <p>Des exercices concrets adaptes aux besoins des structures associatives et TPE</p>
        </div>
        <div class="benefit-item">
          <div class="benefit-icon">👥</div>
          <h3>En petit groupe</h3>
          <p>15 participants max par sessions pour un accompagnement personnalise</p>
        </div>
        <div class="benefit-item">
          <div class="benefit-icon">🎯</div>
          <h3>Sans prerequis</h3>
          <p>Accessible a tous les benevoles et professionnels, quel que soit votre niveau technique</p>
        </div>
        <div class="benefit-item">
          <div class="benefit-icon">🎭</div>
          <h3>Souverainete Numerique</h3>
          <p>Prenez le contrôle de vos donnees et ne dependez pas de services coûteux et inefficace</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-modern">
    <div class="container">
      <div class="cta-content">
        <h2>Rejoindre un atelier</h2>
        <p>Les places sont limitees a 15 participants pour que chacun puisse poser ses questions et avancer a son rythme.</p>
        <div class="cta-buttons">
          <a href="/ateliers/inscription" class="btn-primary">
            Je m'inscris
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/contact" class="btn-secondary">Poser une question</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json" set:html={jsonLd(workshopsItemListSchema)} />

