---
export const prerender = true;

import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Layout from '@/layouts/BlogLayout.astro';
import ReadingTime from '@/components/ReadingTime.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

// prerender = true exige getStaticPaths().
export const getStaticPaths = (async () => {
  const all = await getCollection('blog');
  const visible = import.meta.env.PROD
    ? all.filter((a) => !a.data.draft)
    : all;
  return visible.map((entry) => ({
    params: { slug: entry.id },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

const entry = await getEntry('blog', slug);
if (!entry) {
  return Astro.redirect('/blog');
}

const articles = await getCollection('blog');
const publishedArticles = import.meta.env.PROD
  ? articles.filter((article: CollectionEntry<'blog'>) => !article.data.draft)
  : articles;

const sortedArticles = publishedArticles.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const isFeatured = sortedArticles.length > 0 && sortedArticles[0] && entry.id === sortedArticles[0].id;

const { Content, headings } = await render(entry);
const body = entry.body ?? '';

// Related posts : 3 articles partageant au moins un tag, hors article courant.
const relatedArticles = publishedArticles
  .filter((a: CollectionEntry<'blog'>) => a.id !== entry.id)
  .map((a: CollectionEntry<'blog'>) => {
    const entryTags = ((entry.data.tags as string[]) || []) as string[];
    const candidateTags = ((a.data.tags as string[]) || []) as string[];
    const shared = candidateTags.filter((t) => entryTags.includes(t)).length;
    return { entry: a, shared };
  })
  .filter((x) => x.shared > 0)
  .sort((a, b) => b.shared - a.shared || b.entry.data.pubDate.getTime() - a.entry.data.pubDate.getTime())
  .slice(0, 3)
  .map((x) => x.entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description || entry.data.title}
>
  <div class="article-wrapper">
    <article class="article-content">
      <header class="article-header">
        <a href="/blog" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Retour au blog
        </a>

        {isFeatured && (
          <div class="featured-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            Article en vedette
          </div>
        )}

        <h1 class="article-title">{entry.data.title}</h1>

        {entry.data.description && (
          <p class="article-description">{entry.data.description}</p>
        )}

        <div class="article-meta">
          <div class="meta-item">
            <time datetime={entry.data.pubDate.toISOString()}>
              {entry.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>

          {entry.data.author && (
            <div class="meta-item">
              <span>{entry.data.author}</span>
            </div>
          )}

          <div class="meta-item">
            <ReadingTime content={body} />
          </div>
        </div>

        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="tags">
            {entry.data.tags.map((tag: string) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      {entry.data.thumbnail && (
        <div class="article-thumbnail">
          <Image
            src={entry.data.thumbnail}
            alt={entry.data.title}
            width={800}
            height={450}
            loading="lazy"
            format="webp"
          />
        </div>
      )}

      <TableOfContents headings={headings} />

      <div class="prose">
        <Content />
      </div>

      {relatedArticles.length > 0 && (
        <section class="related-posts" aria-labelledby="related-title">
          <h2 id="related-title" class="related-title"> À lire aussi</h2>
          <div class="related-grid">
            {relatedArticles.map((rel: CollectionEntry<'blog'>) => (
              <a href={/blog/} class="related-card">
                <h3 class="related-card-title">{rel.data.title}</h3>
                {rel.data.description && <p class="related-card-desc">{rel.data.description}</p>}
                {rel.data.tags && rel.data.tags.length > 0 && (
                  <div class="related-card-tags">
                    {((rel.data.tags as string[]).slice(0, 2)).map((tag: string) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
                <span class="related-card-cta">Lire l'article â†’</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <footer class="article-footer">
        <a href="/blog" class="back-button">
          Retour au blog
        </a>
      </footer>
    </article>
  </div>
</Layout>

<style>
.article-wrapper * {
  animation: none !important;
  transition: none !important;
}

.article-wrapper a,
.article-wrapper button,
.article-wrapper .tag,
.article-wrapper .share-btn,
.article-wrapper .back-button,
.article-wrapper .back-link {
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast) !important;
}

.article-wrapper { min-height: 100vh; background: var(--color-bg); }
.article-content { max-width: 800px; margin: 0 auto; padding: 2rem 1rem 4rem; }

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 2rem;
  color: var(--color-text-light);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 600;
  padding: 0.5rem 0;
}

.back-link:hover { color: var(--color-primary); transform: translateX(-4px); }

.featured-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--color-first);
  color: var(--color-gray-900);
  padding: 0.5rem 1rem;
  border-radius: var(--radius-full);
  border: 2px solid var(--color-border);
  font-size: 0.875rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  box-shadow: var(--shadow-glow);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.article-header { margin-top: 4.5rem; margin-bottom: 3rem; }

.article-title {
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 900;
  margin-bottom: 1rem;
  line-height: 1.2;
  color: var(--color-text);
  letter-spacing: -0.02em;
}

.article-description {
  font-size: 1.25rem;
  color: var(--color-text-light);
  margin: 1.5rem 0;
  line-height: 1.7;
  font-weight: 500;
}

.article-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin: 2rem 0;
  padding: 1rem 0;
  border-top: 2px solid var(--color-border);
  border-bottom: 2px solid var(--color-border);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--color-text-light);
  font-size: 0.875rem;
  font-weight: 600;
}

.tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }

.tag {
  padding: 0.375rem 0.875rem;
  background: var(--glass-bg);
  color: var(--color-text-light);
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 600;
  border: 1px solid var(--glass-border);
}

.article-thumbnail {
  margin: 3rem 0;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-2xl);
  border: 2px solid var(--color-border);
}

.prose { font-size: 1.125rem; line-height: 1.8; color: var(--color-text); }

.prose :global(h2) {
  font-size: 1.875rem;
  margin: 2.5rem 0 1.25rem;
  color: var(--color-text);
  letter-spacing: -0.01em;
  padding-left: 1rem;
  font-weight: 900;
}

.prose :global(h3) {
  font-size: 1.5rem;
  font-weight: 800;
  margin: 2rem 0 1rem;
  color: var(--color-text);
}

.prose :global(p) { margin: 1.5rem 0; line-height: 1.8; color: var(--color-text); }

.prose :global(a) {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 600;
  background-size: 0% 2px;
  background-position: 0 100%;
  background-repeat: no-repeat;
  transition: background-size var(--transition-base);
}

.prose :global(ul), .prose :global(ol) {
  margin: 1.5rem 0;
  padding-left: 1.75rem;
}

.prose :global(blockquote) {
  margin: 2rem 0;
  padding: 1.5rem;
  border-left: 4px solid var(--color-primary);
  background: var(--glass-bg);
  border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  font-style: italic;
  color: var(--color-text);
}

.prose :global(pre) {
  background: var(--color-bg-elevated);
  color: var(--color-text);
  padding: 1.5rem;
  border-radius: var(--radius-lg);
  overflow-x: auto;
  margin: 2rem 0;
  border: 2px solid var(--color-border);
}

.prose :global(code) {
  background: var(--glass-bg);
  color: var(--color-first);
  border-radius: var(--radius-sm);
  font-size: 0.9em;
  font-family: monospace;
  font-weight: 600;
  border: 1px solid var(--color-border);
  padding: 0.2em 0.4em;
}

.prose :global(img) {
  max-width: 100%;
  height: auto;
  border-radius: var(--radius-lg);
  margin: 2.5rem 0;
  box-shadow: var(--shadow-xl);
  border: 2px solid var(--color-border);
}

.related-posts {
  margin: 4rem auto 0;
  padding-top: 2.5rem;
  border-top: 2px solid var(--color-border);
  max-width: 800px;
}

.related-title {
  font-size: 1.5rem;
  font-weight: 800;
  margin: 0 0 1.25rem;
  color: var(--color-text);
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
}

.related-card {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1rem 1.25rem;
  background: var(--color-bg-alt);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  color: inherit;
  transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
}

.related-card:hover {
  transform: translateY(-3px);
  border-color: var(--color-primary);
  box-shadow: var(--shadow-md);
}

.related-card-title {
  margin: 0;
  font-size: 1rem;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.3;
}

.related-card-desc {
  margin: 0;
  font-size: 0.875rem;
  color: var(--color-text-light);
  line-height: 1.5;
}

.related-card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
.related-card .tag { font-size: 0.65rem; padding: 0.1rem 0.4rem; }
.related-card-cta {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 0.85rem;
  margin-top: auto;
}

.article-footer {
  margin-top: 5rem;
  padding-top: 3rem;
  border-top: 2px solid var(--color-border);
}

.back-button {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--color-text-light);
  text-decoration: none;
  font-weight: 700;
  font-size: 1rem;
  padding: 1rem 1.5rem;
  border: 2px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--glass-bg);
  box-shadow: var(--shadow-md);
}

.back-button:hover {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: var(--color-bg-elevated);
  box-shadow: var(--shadow-glow);
}

@media (max-width: 768px) {
  .article-content { padding: 1.5rem 1rem 3rem; }
  .article-title { font-size: 2rem; }
  .prose { font-size: 1rem; }
  .prose :global(h2) { font-size: 1.5rem; padding-left: 0.75rem; }
  .prose :global(h3) { font-size: 1.25rem; }
  .back-button { display: flex; width: 100%; justify-content: center; }
}

@media (prefers-reduced-motion: reduce) {
  .article-wrapper *, .back-link, .tag, .back-button {
    transition: none !important;
    animation: none !important;
  }
}
</style>