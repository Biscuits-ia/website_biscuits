---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/layouts/BlogLayout.astro';
import ReadingTime from '@/components/ReadingTime.astro';
import TableOfContents from '@/components/TableOfContents.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog');

  const publishedArticles = import.meta.env.PROD
    ? articles.filter((article: CollectionEntry<'blog'>) => !article.data.draft)
    : articles;

  if (!publishedArticles || publishedArticles.length === 0) {
    return [];
  }

  return publishedArticles.map((article: CollectionEntry<'blog'>) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

const entry = await getEntry('blog', slug);
if (!entry) {
  return Astro.redirect('/blog');
}

const articles = await getCollection('blog');
const publishedArticles = import.meta.env.PROD
  ? articles.filter((article: CollectionEntry<'blog'>) => !article.data.draft)
  : articles;

const sortedArticles = publishedArticles.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const isFeatured = sortedArticles.length > 0 && sortedArticles[0] && entry.id === sortedArticles[0].id;

const { Content, headings } = await entry.render();
const { body } = entry;
---

<Layout
  title={entry.data.title}
  description={entry.data.description || entry.data.title}
>
  <div class="article-wrapper">
    <article class="article-content">
      <header class="article-header">
        <a href="/blog" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Retour au blog
        </a>
        
        {isFeatured && (
          <div class="featured-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            Article en vedette
          </div>
        )}
                
        <h1 class="article-title">{entry.data.title}</h1>
        
        {entry.data.description && (
          <p class="article-description">{entry.data.description}</p>
        )}
        
        <div class="article-meta">
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <time datetime={entry.data.pubDate.toISOString()}>
              {entry.data.pubDate.toLocaleDateString('fr-FR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>
          
          {entry.data.author && (
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              {entry.data.author}
            </div>
          )}
          
          <div class="meta-item">
            <ReadingTime content={body} />
          </div>
        </div>
        
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="tags">
            {entry.data.tags.map((tag: string) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </header>
      
      {entry.data.thumbnail && (
        <div class="article-thumbnail">
          <Image
            src={entry.data.thumbnail}
            alt={entry.data.title}
            width={800}
            height={450}
            loading="lazy"
            format="webp"
          />
        </div>
      )}
      
      <TableOfContents headings={headings} />
      
        <div class="prose">
        <Content />
      </div>
      
      <footer class="article-footer">
        <a href="/blog" class="back-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Retour au blog
        </a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  /* Article Wrapper - Base adaptative */
.article-wrapper * {
  animation: none !important;
  transition: none !important;
}

.article-wrapper a,
.article-wrapper button,
.article-wrapper .tag,
.article-wrapper .share-btn,
.article-wrapper .back-button,
.article-wrapper .back-link {
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast) !important;
}

.article-wrapper {
  min-height: 100vh;
  background: var(--color-bg);
}

.article-content {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem 1rem 4rem;
}

/* Header */
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 2rem;
  color: var(--color-text-light);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 600;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  padding: 0.5rem 0;
}

.back-link:hover {
  color: var(--color-primary);
  transform: translateX(-4px);
}

.featured-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--color-first);  
  color: var(--color-gray-900);
  padding: 0.5rem 1rem;
  border-radius: var(--radius-full);
  border: 2px solid var(--color-border);
  font-size: 0.875rem;
  margin-left: 1.5rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  box-shadow: var(--shadow-glow);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.article-header {
  margin-top: 4.5rem;
  margin-bottom: 3rem;
}

.article-title {
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 900;
  margin-bottom: 1rem;
  line-height: 1.2;
  color: var(--color-text);
  letter-spacing: -0.02em;
}

.article-description {
  font-size: 1.25rem;
  color: var(--color-text-light);
  margin: 1.5rem 0;
  line-height: 1.7;
  font-weight: 500;
}

.article-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin: 2rem 0;
  padding: 1rem 0;
  border-top: 2px solid var(--color-border);
  border-bottom: 2px solid var(--color-border);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--color-text-light);
  font-size: 0.875rem;
  font-weight: 600;
}

.meta-item svg {
  flex-shrink: 0;
  color: var(--color-primary);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1.5rem;
}

.tag {
  padding: 0.375rem 0.875rem;
  background: var(--glass-bg);
  color: var(--color-text-light);
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 600;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  border: 1px solid var(--glass-border);
  backdrop-filter: var(--glass-blur);
  box-shadow: var(--shadow-sm);
}

.tag:hover {
  background: var(--color-primary);
  color: var(--color-gray-900);
  transform: translateY(-2px);
  box-shadow: var(--shadow-glow);
}

.article-thumbnail {
  margin: 3rem 0;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-2xl);
  border: 2px solid var(--color-border);
}

.article-thumbnail img {
  width: 100%;
  height: auto;
  display: block;
}

/* Prose - Contenu principal */
.prose {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--color-text);
}

.prose :global(h1),
.prose :global(h2),
.prose :global(h3),
.prose :global(h4) {
  scroll-margin-top: 2rem;
  position: relative;
  font-weight: 900;
}

.prose :global(h1) {
  font-size: 2.25rem;
  margin: 3rem 0 1.5rem;
  color: var(--color-text);
  letter-spacing: -0.02em;
  padding-bottom: 0.5rem;
  border-bottom: 3px solid var(--color-border);
}

.prose :global(h2) {
  font-size: 1.875rem;
  margin: 2.5rem 0 1.25rem;
  color: var(--color-text);
  letter-spacing: -0.01em;
  padding-left: 1rem;
}

.prose :global(h2::before) {
  content: "";
  position: absolute;
  left: 0;
  top: 0.5rem;
  width: 4px;
  height: 1.5rem;
  background: linear-gradient(to bottom, var(--color-primary), var(--color-primary-dark));
  border-radius: var(--radius-sm);
}

.prose :global(h3) {
  font-size: 1.5rem;
  font-weight: 800;
  margin: 2rem 0 1rem;
  color: var(--color-text);
}

.prose :global(h4) {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 1.5rem 0 0.75rem;
  color: var(--color-text);
}

.prose :global(p) {
  margin: 1.5rem 0;
  line-height: 1.8;
  color: var(--color-text);
}

.prose :global(p:first-of-type) {
  font-size: 1.2em;
  color: var(--color-text);
  font-weight: 500;
}

/* Listes */
.prose :global(ul),
.prose :global(ol) {
  margin: 1.5rem 0;
  padding-left: 1.75rem;
}

.prose :global(li) {
  margin: 0.75rem 0;
  padding-left: 0.5rem;
  color: var(--color-text);
  font-weight: 500;
}

.prose :global(ul > li::marker),
.prose :global(ol > li::marker) {
  color: var(--color-primary);
  font-weight: 800;
}

/* Blockquotes */
.prose :global(blockquote) {
  margin: 2rem 0;
  padding: 1.5rem;
  border-left: 4px solid var(--color-primary);
  background: var(--glass-bg);
  border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  font-style: italic;
  color: var(--color-text);
  position: relative;
  box-shadow: var(--shadow-lg);
  backdrop-filter: var(--glass-blur);
  border: 2px solid var(--color-border);
  border-left: 4px solid var(--color-primary);
}

.prose :global(blockquote::before) {
  content: "";
  position: absolute;
  top: -0.5rem;
  left: 1rem;
  font-size: 4rem;
  color: var(--color-primary);
  opacity: 0.2;
  font-family: Georgia, serif;
  line-height: 1;
}

.prose :global(blockquote p) {
  margin: 0;
  color: inherit;
}

/* Code inline */
.prose :global(code) {
  background: var(--glass-bg);
  color: var(--color-first);
  border-radius: var(--radius-sm);
  font-size: 0.9em;
  font-family: 'Courier New', Consolas, Monaco, monospace;
  font-weight: 600;
  border: 1px solid var(--color-border);
  padding: 0.2em 0.4em;
}

/* Code blocks */
.prose :global(pre) {
  background: var(--color-bg-elevated) !important;
  color: var(--color-text);
  padding: 1.5rem;
  border-radius: var(--radius-lg);
  overflow-x: auto;
  margin: 2rem 0;
  border: 2px solid var(--color-border);
  box-shadow: var(--shadow-xl);
  position: relative;
}

.prose :global(pre code) {
  background: transparent;
  padding: 0;
  color: inherit;
  font-size: 0.9rem;
  line-height: 1.7;
  border: none;
  font-weight: normal;
}

/* Liens */
.prose :global(a) {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 600;
  background: linear-gradient(to right, var(--color-primary), var(--color-primary-dark));
  background-size: 0% 2px;
  background-position: 0 100%;
  background-repeat: no-repeat;
  transition: background-size var(--transition-base);
  position: relative;
}

.prose :global(a:hover) {
  background-size: 100% 2px;
  color: var(--color-primary-dark);
}

/* Séparateurs */
.prose :global(hr) {
  margin: 3rem 0;
  border: none;
  height: 2px;
  background: linear-gradient(to right, transparent, var(--color-border), transparent);
}

/* Images */
.prose :global(img) {
  max-width: 100%;
  height: auto;
  border-radius: var(--radius-lg);
  margin: 2.5rem 0;
  box-shadow: var(--shadow-xl);
  border: 2px solid var(--color-border);
  transition: transform var(--transition-base);
}

.prose :global(img:hover) {
  transform: scale(1.02);
}

.prose :global(strong) {
  font-weight: 800;
  color: var(--color-text);
}

.prose :global(em) {
  font-style: italic;
  color: var(--color-text-light);
}

/* Tables */
.prose :global(table) {
  width: 100%;
  margin: 2rem 0;
  border-collapse: collapse;
  background: var(--color-bg-alt);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  border: 2px solid var(--color-border);
}

.prose :global(thead) {
  background: var(--color-bg-elevated);
}

.prose :global(th) {
  padding: 1rem;
  text-align: left;
  font-weight: 800;
  color: var(--color-text);
  border-bottom: 2px solid var(--color-primary);
}

.prose :global(td) {
  padding: 1rem;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text);
  font-weight: 500;
}

.prose :global(tr:hover) {
  background: var(--color-bg-elevated);
}

/* Footer */
.article-footer {
  margin-top: 5rem;
  padding-top: 3rem;
  border-top: 2px solid var(--color-border);
}

.back-button {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--color-text-light);
  text-decoration: none;
  font-weight: 700;
  font-size: 1rem;
  transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base), background-color var(--transition-base) !important;
  padding: 1rem 1.5rem;
  border: 2px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  box-shadow: var(--shadow-md);
}

.back-button svg {
  flex-shrink: 0;
  transition: transform var(--transition-base);
}

.back-button:hover {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: var(--color-bg-elevated);
  box-shadow: var(--shadow-glow);
}

.back-button:hover svg {
  transform: translateX(-4px);
}

/* Responsive */
@media (max-width: 768px) {
  .article-content {
    padding: 1.5rem 1rem 3rem;
  }

  .article-title {
    font-size: 2rem;
  }

  .article-description {
    font-size: 1.125rem;
  }

  .prose {
    font-size: 1rem;
  }

  .prose :global(h1) {
    font-size: 1.875rem;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    padding-left: 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
  }

  .back-button {
    display: flex;
    width: 100%;
    justify-content: center;
  }
}

/* Réduction des mouvements */
@media (prefers-reduced-motion: reduce) {
  .article-wrapper *,
  .back-link,
  .tag,
  .back-button {
    transition: none !important;
    animation: none !important;
  }
}
</style> 