---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ReadingTime from '@/components/ReadingTime.astro';
import TableOfContents from '@/components/TableOfContents.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  
  const publishedArticles = import.meta.env.PROD 
    ? articles.filter((article: CollectionEntry<'blog'>) => !article.data.draft)
    : articles;
  
  return publishedArticles.map((article: CollectionEntry<'blog'>) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const entry = await getEntry('blog', slug);

if (!entry) {
  return Astro.redirect('/blog');
}

const { Content, headings } = await entry.render();
const { body } = entry;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description || entry.data.title,
  "datePublished": entry.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": entry.data.author || "Biscuits du Dev"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Biscuits du Dev",
    "url": "https://biscuits.dev"
  },
  "url": `https://biscuits.dev/blog/${entry.slug}`,
  ...(entry.data.thumbnail && {
    "image": `https://biscuits.dev${entry.data.thumbnail}`
  })
};
---

<Layout
  title={entry.data.title}
  description={entry.data.description || entry.data.title}
  structuredData={structuredData}
>
  <div class="article-wrapper">
    <article class="article-content">
      <header class="article-header">
        <a href="/blog" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Retour au blog
        </a>
        
        {entry.data.featured && (
          <div class="featured-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            Article en vedette
          </div>
        )}
        
        <h1 class="article-title">{entry.data.title}</h1>
        
        {entry.data.description && (
          <p class="article-description">{entry.data.description}</p>
        )}
        
        <div class="article-meta">
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <time datetime={entry.data.pubDate.toISOString()}>
              {entry.data.pubDate.toLocaleDateString('fr-FR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>
          
          {entry.data.author && (
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              {entry.data.author}
            </div>
          )}
          
          <div class="meta-item">
            <ReadingTime content={body} />
          </div>
        </div>
        
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="tags">
            {entry.data.tags.map((tag: string) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </header>
      
      {entry.data.thumbnail && (
        <div class="article-thumbnail">
          <img src={entry.data.thumbnail} alt={entry.data.title} />
        </div>
      )}
      
      <TableOfContents headings={headings} />
      
      <div class="prose">
        <Content />
      </div>
      
      <footer class="article-footer">
        <div class="footer-content">
          <div class="footer-section">
            <h3>Cet article vous a plu ?</h3>
            <p>Partagez-le avec votre réseau !</p>
          </div>
          
          <div class="share-buttons">
            <a 
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(`https://biscuits.dev/blog/${entry.slug}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn twitter"
              aria-label="Partager sur Twitter"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"></path>
              </svg>
              Twitter
            </a>
            <a 
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://biscuits.dev/blog/${entry.slug}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn linkedin"
              aria-label="Partager sur LinkedIn"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"></path>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              LinkedIn
            </a>
          </div>
        </div>
        
        <a href="/blog" class="back-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Retour au blog
        </a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .article-wrapper {
    min-height: 100vh;
    background: linear-gradient(to bottom, #f9fafb 0%, #ffffff 50%);
  }

  .article-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }
  
  /* Header */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    color: #6b7280;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
    padding: 0.5rem 0;
  }

  .back-link:hover {
    color: #2563eb;
    transform: translateX(-4px);
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #ffd700, #ffed4e);
    color: #7c2d12;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 6px -1px rgba(251, 191, 36, 0.3);
  }

  .article-header {
    margin-bottom: 3rem;
  }
  
  .article-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.2;
    color: #111827;
    letter-spacing: -0.02em;
  }

  .article-description {
    font-size: 1.25rem;
    color: #6b7280;
    margin: 1.5rem 0;
    line-height: 1.7;
    font-weight: 400;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 2rem 0;
    padding: 1rem 0;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #6b7280;
    font-size: 0.875rem;
  }

  .meta-item svg {
    flex-shrink: 0;
    color: #9ca3af;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .tag {
    padding: 0.375rem 0.875rem;
    background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
    color: #4b5563;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
    border: 1px solid #e5e7eb;
  }

  .tag:hover {
    background: linear-gradient(135deg, #e5e7eb, #d1d5db);
    transform: translateY(-2px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .article-thumbnail {
    margin: 3rem 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .article-thumbnail img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Prose - Contenu principal */
  .prose {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #1f2937;
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    scroll-margin-top: 2rem;
    position: relative;
  }

  .prose :global(pre [data-line]) {
    padding: 5% 0 0 14px;
}


  .prose :global(h1) {
    font-size: 2.25rem;
    font-weight: 700;
    margin: 3rem 0 1.5rem;
    color: #111827;
    letter-spacing: -0.02em;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid #e5e7eb;
  }

  .prose :global(h2) {
    font-size: 1.875rem;
    font-weight: 700;
    margin: 2.5rem 0 1.25rem;
    color: #111827;
    letter-spacing: -0.01em;
  }

  .prose :global(h2::before) {
    content: "";
    position: absolute;
    left: -1rem;
    top: 0.5rem;
    width: 4px;
    height: 1.5rem;
    background: linear-gradient(to bottom, #3b82f6, #2563eb);
    border-radius: 2px;
  }

  .prose :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2rem 0 1rem;
    color: #1f2937;
  }

  .prose :global(h4) {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
    color: #374151;
  }

  .prose :global(p) {
    margin: 1.5rem 0;
    line-height: 1.8;
  }

  .prose :global(p:first-of-type) {
    font-size: 1.2em;
    color: #374151;
  }

  /* Listes */
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.75rem;
  }

  .prose :global(li) {
    margin: 0.75rem 0;
    padding-left: 0.5rem;
  }

  .prose :global(ul > li) {
    position: relative;
  }

  .prose :global(ul > li::marker) {
    color: #3b82f6;
    font-weight: 700;
  }

  .prose :global(ol > li::marker) {
    color: #3b82f6;
    font-weight: 700;
  }

  /* Blockquotes */
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1.5rem;
    border-left: 4px solid #3b82f6;
    background: linear-gradient(to right, #eff6ff, #f0f9ff);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #1e40af;
    position: relative;
    box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.1);
  }

  .prose :global(blockquote::before) {
    content: """;
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    font-size: 4rem;
    color: #3b82f6;
    opacity: 0.2;
    font-family: Georgia, serif;
    line-height: 1;
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  /* Code inline */
  .prose :global(code) {
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    color: #92400e;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'Courier New', Consolas, Monaco, monospace;
    font-weight: 600;
    border: 1px solid #fbbf24;
  }

  /* Code blocks */
  .prose :global(pre) {
    background: linear-gradient(135deg, #1e293b, #0f172a) !important;
    color: #e2e8f0;
    padding: 1.5rem;
    border-radius: 12px;
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid #334155;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
    position: relative;
  }

  .prose :global(pre::before) {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2rem;
    background: #0f172a;
    border-bottom: 1px solid #334155;
    border-radius: 12px 12px 0 0;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: 0.9rem;
    line-height: 1.7;
    border: none;
    font-weight: normal;
  }

  /* Liens */
  .prose :global(a) {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
    background: linear-gradient(to right, #3b82f6, #2563eb);
    background-size: 0% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s ease;
  }

  .prose :global(a:hover) {
    background-size: 100% 2px;
    color: #1d4ed8;
  }

  /* Séparateurs */
  .prose :global(hr) {
    margin: 3rem 0;
    border: none;
    height: 2px;
    background: linear-gradient(to right, transparent, #e5e7eb, transparent);
  }

  /* Images */
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2.5rem 0;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s ease;
  }

  .prose :global(img:hover) {
    transform: scale(1.02);
  }

  .prose :global(strong) {
    font-weight: 700;
    color: #111827;
  }

  .prose :global(em) {
    font-style: italic;
    color: #4b5563;
  }

  /* Tables */
  

  /* Footer */
  .article-footer {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 2px solid #e5e7eb;
  }

  .footer-content {
    background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.1);
  }

  .footer-section h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .footer-section p {
    color: #6b7280;
    margin-bottom: 1.5rem;
  }

  .share-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.2s;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .share-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
  }

  .share-btn.twitter {
    background: linear-gradient(135deg, #1da1f2, #1a8cd8);
    color: white;
  }

  .share-btn.linkedin {
    background: linear-gradient(135deg, #0077b5, #00669c);
    color: white;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #6b7280;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
    padding: 0.75rem 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
  }

  .back-button:hover {
    color: #2563eb;
    border-color: #2563eb;
    transform: translateX(-4px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .article-content {
      padding: 1.5rem 1rem 3rem;
    }

    .article-title {
      font-size: 2rem;
    }

    .article-description {
      font-size: 1.125rem;
    }

    .prose {
      font-size: 1rem;
    }

    .prose :global(h1) {
      font-size: 1.875rem;
    }

    .prose :global(h2) {
      font-size: 1.5rem;
    }

    .prose :global(h3) {
      font-size: 1.25rem;
    }

    .prose :global(h2::before) {
      left: -0.75rem;
    }

    .footer-content {
      padding: 1.5rem;
    }

    .share-buttons {
      flex-direction: column;
    }

    .share-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>  