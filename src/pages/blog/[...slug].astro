---
// Page d'un article de blog : OG image specifique, maillage interne renforce, related articles.
// URL : /blog/[slug]
// SEO : Open Graph complet (og:type=article), Twitter Cards, Schema.org Article, canonical unique.

export const prerender = true;

import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import ReadingTime from '@/components/ReadingTime.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BlogClusterNav from '@/components/BlogClusterNav.astro';
import { getBlogClusterForArticle, getClusterArticleIds } from '@/lib/blogClusters';

// prerender = true exige getStaticPaths().
export const getStaticPaths = (async () => {
  const all = await getCollection('blog');
  const visible = import.meta.env.PROD ? all.filter((a) => !a.data.draft) : all;
  return visible.map((entry) => ({
    params: { slug: entry.id },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

const entry = await getEntry('blog', slug);
if (!entry) {
  return Astro.redirect('/blog');
}

const allArticles = await getCollection('blog');
const publishedArticles = import.meta.env.PROD
  ? allArticles.filter((article: CollectionEntry<'blog'>) => !article.data.draft)
  : allArticles;

const sortedArticles = publishedArticles.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const isFeatured =
  sortedArticles.length > 0 && sortedArticles[0] && entry.id === sortedArticles[0].id;

const { Content, headings } = await render(entry);
const body = entry.body ?? '';

// GEO : wordCount + estimated reading time (signal E-E-A-T et eligible aux AI Overviews).
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readingTimeMin = Math.max(1, Math.ceil(wordCount / 220));
// Date de derniere relecture. Le comite editorial relit avant publication.
const modifiedDate = entry.data.updatedDate || entry.data.pubDate;
const lastReviewedDate = entry.data.reviewedDate || entry.data.updatedDate || entry.data.pubDate;
// GEO : slug auteur (Alexis -> alexis-gallard, sinon collectif).
const authorSlug = (entry.data.author || 'Biscuits IA').toLowerCase().includes('alexis')
  ? 'alexis-gallard'
  : 'biscuits-ia';

// Normalisation des tags en slug.
const slugifyTag = (tag: string): string =>
  tag
    .toString()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const globalTagCounts = new Map<string, number>();
for (const article of publishedArticles) {
  for (const tag of ((article.data.tags as string[]) || []) as string[]) {
    const tagSlug = slugifyTag(tag);
    globalTagCounts.set(tagSlug, (globalTagCounts.get(tagSlug) ?? 0) + 1);
  }
}
const isIndexableTag = (tag: string): boolean => (globalTagCounts.get(slugifyTag(tag)) ?? 0) >= 3;

// Articles relies : 3 articles partageant au moins un tag, hors article courant.
const entryTags = ((entry.data.tags as string[]) || []) as string[];
const relatedArticles = publishedArticles
  .filter((a: CollectionEntry<'blog'>) => a.id !== entry.id)
  .map((a: CollectionEntry<'blog'>) => {
    const candidateTags = ((a.data.tags as string[]) || []) as string[];
    const shared = candidateTags.filter((t) => entryTags.includes(t)).length;
    return { entry: a, shared };
  })
  .filter((x) => x.shared > 0)
  .sort(
    (a, b) => b.shared - a.shared || b.entry.data.pubDate.getTime() - a.entry.data.pubDate.getTime()
  )
  .slice(0, 3)
  .map((x) => x.entry);

// Article precedent / suivant dans la liste chronologique.
const currentIndex = sortedArticles.findIndex((a) => a.id === entry.id);
const prevArticle =
  currentIndex < sortedArticles.length - 1 ? sortedArticles[currentIndex + 1] : null;
const nextArticle = currentIndex > 0 ? sortedArticles[currentIndex - 1] : null;

// "Autres articles sur le meme theme" : fallback si pas de related ou en complement.
const sameTagArticles = publishedArticles
  .filter((a: CollectionEntry<'blog'>) => a.id !== entry.id)
  .filter((a: CollectionEntry<'blog'>) => {
    const tags = ((a.data.tags as string[]) || []) as string[];
    return tags.some((t) => entryTags.includes(t));
  })
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  )
  .slice(0, 6);

const cluster = getBlogClusterForArticle(entry.id);
const clusterArticleIds = getClusterArticleIds(entry.id);
const clusterArticles = clusterArticleIds
  .map((id) => publishedArticles.find((article) => article.id === id))
  .filter((article): article is CollectionEntry<'blog'> => Boolean(article));

// SEO : Open Graph specifique a l'article. `ogImage` (prioritaire) ou
// `thumbnail` du frontmatter si presents, sinon repli sur l'image par defaut.
const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';
const articleImage = entry.data.ogImage || entry.data.thumbnail;
const ogImage = articleImage
  ? articleImage.startsWith('http')
    ? articleImage
    : `${siteUrl}${articleImage}`
  : `${siteUrl}/og-default.webp`;
const seoTitle = entry.data.title;
const seoDescription = entry.data.description || entry.data.title;

const articleSchema = {
  type: 'Article' as const,
  data: {
    title: seoTitle,
    headline: seoTitle,
    description: seoDescription,
    image: ogImage,
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: modifiedDate.toISOString(),
    author: entry.data.author || 'Biscuits IA',
    authorSlug,
    category: 'Intelligence Artificielle',
    keywords: entryTags,
    wordCount,
    readingTimeMin,
    ...(cluster
      ? {
          isPartOf: {
            name: cluster.title,
            url: `${siteUrl}/guides/${cluster.slug}`,
          },
          citations: cluster.sources.map((source) => source.url),
        }
      : {}),
  },
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={`/blog/${entry.id}`}
  ogType="article"
  ogImage={ogImage}
  author={entry.data.author || 'Biscuits IA'}
  publishedTime={entry.data.pubDate.toISOString()}
  modifiedTime={modifiedDate.toISOString()}
  tags={entryTags}
  schema={articleSchema}
  geo={{
    author: entry.data.author || 'Biscuits IA',
    authorUrl: `/auteur/${authorSlug}`,
    contentType: 'human-reviewed',
    lastReviewed: lastReviewedDate.toISOString(),
    expertise: entryTags[0] || 'intelligence-artificielle',
  }}
>
  <Breadcrumb />

  <div class="article-wrapper">
    <article class="article-content">
      <header class="article-header">
        <a href="/blog" class="back-link">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Retour au blog
        </a>

        {
          isFeatured && (
            <div class="featured-badge">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              Article en vedette
            </div>
          )
        }

        <h1 class="article-title">{entry.data.title}</h1>

        {entry.data.description && <p class="article-description">{entry.data.description}</p>}

        <div class="article-meta">
          <div class="meta-item">
            <time datetime={entry.data.pubDate.toISOString()}>
              {
                entry.data.pubDate.toLocaleDateString('fr-FR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
          </div>

          {
            entry.data.author && (
              <div class="meta-item">
                <span>{entry.data.author}</span>
              </div>
            )
          }

          <div class="meta-item">
            <ReadingTime content={body} />
          </div>
          {
            entry.data.updatedDate && (
              <div class="meta-item">
                Mis à jour le{' '}
                <time datetime={entry.data.updatedDate.toISOString()}>
                  {entry.data.updatedDate.toLocaleDateString('fr-FR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>
            )
          }
        </div>
      </header>

      {cluster && <BlogClusterNav cluster={cluster} articles={clusterArticles} />}

      <TableOfContents headings={headings} />

      <div class="prose">
        <Content />
      </div>

      {
        cluster && (
          <section class="article-sources" aria-labelledby="article-sources-title">
            <h2 id="article-sources-title">Sources de référence</h2>
            <p>
              Ce contenu s'appuie notamment sur les ressources institutionnelles et documentations
              officielles suivantes.
            </p>
            <ul>
              {cluster.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    {source.name} — {source.publisher}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        relatedArticles.length > 0 && (
          <section class="related-posts" aria-labelledby="related-title">
            <h2 id="related-title" class="related-title">
              Articles sur le meme theme
            </h2>
            <div class="related-grid">
              {relatedArticles.map((rel: CollectionEntry<'blog'>) => (
                <a href={`/blog/${rel.id}`} class="related-card">
                  <span class="related-card-meta">
                    <time datetime={rel.data.pubDate.toISOString()}>
                      {rel.data.pubDate.toLocaleDateString('fr-FR', {
                        day: 'numeric',
                        month: 'short',
                      })}
                    </time>
                  </span>
                  <h3 class="related-card-title">{rel.data.title}</h3>
                  {rel.data.description && <p class="related-card-desc">{rel.data.description}</p>}
                  <span class="related-card-cta">Lire →</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        (prevArticle || nextArticle) && (
          <nav class="article-nav" aria-label="Navigation entre articles">
            {prevArticle && (
              <a href={`/blog/${prevArticle.id}`} class="article-nav-link article-nav-prev">
                <span class="article-nav-eyebrow">Article plus ancien</span>
                <span class="article-nav-title">{prevArticle.data.title}</span>
              </a>
            )}
            {nextArticle && (
              <a
                href={`/blog/${nextArticle.id}`}
                class={`article-nav-link article-nav-next${!prevArticle ? ' article-nav-only' : ''}`}
              >
                <span class="article-nav-eyebrow">Article plus recent</span>
                <span class="article-nav-title">{nextArticle.data.title}</span>
              </a>
            )}
          </nav>
        )
      }

      {
        sameTagArticles.length > 0 && (
          <section class="same-tag-section" aria-labelledby="same-tag-title">
            <h2 id="same-tag-title" class="related-title">
              Continuer la decouverte
            </h2>
            <div class="same-tag-grid">
              {sameTagArticles.slice(0, 4).map((rel: CollectionEntry<'blog'>) => (
                <a href={`/blog/${rel.id}`} class="same-tag-card">
                  <span class="related-card-meta">
                    <time datetime={rel.data.pubDate.toISOString()}>
                      {rel.data.pubDate.toLocaleDateString('fr-FR', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                    </time>
                  </span>
                  <h3 class="related-card-title">{rel.data.title}</h3>
                  <span class="related-card-cta">Lire →</span>
                </a>
              ))}
            </div>
            <div class="same-tag-cta">
              <a href="/blog" class="same-tag-back">
                Voir tous les articles
              </a>
            </div>
          </section>
        )
      }

      <footer class="article-footer">
        {
          entry.data.tags && entry.data.tags.length > 0 && (
            <nav class="article-tags" aria-label="Tags de l'article">
              <span class="article-tags-label">Tags</span>
              {entry.data.tags.map((tag: string) =>
                isIndexableTag(tag) ? (
                  <a href={`/blog/tag/${slugifyTag(tag)}`} class="tag tag-link">
                    #{tag}
                  </a>
                ) : (
                  <span class="tag">#{tag}</span>
                )
              )}
            </nav>
          )
        }
        <p>
          {entry.data.author || 'Biscuits IA'} &middot;
          <time datetime={entry.data.pubDate.toISOString()}>
            {
              entry.data.pubDate.toLocaleDateString('fr-FR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </time>
        </p>
        <div class="article-footer-actions">
          <a href="/blog" class="footer-link">← Tous les articles du blog</a>
          <a href="/rejoignez-nous" class="footer-link footer-link-primary">Nous rejoindre</a>
        </div>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .article-wrapper {
    background: var(--color-bg);
  }

  .article-content {
    max-width: 800px;
    margin: 0 auto;
    padding: calc(var(--header-height-desktop) + 2rem) 1rem 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-light);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 2rem;
    padding: 0.4rem 0.8rem;
    border: 2px solid transparent;
    border-radius: var(--radius-button, 0.875rem);
    transition: all var(--transition-fast, 0.2s);
  }

  .back-link:hover {
    color: var(--color-primary);
    transform: translateX(-4px);
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-first);
    color: var(--color-gray-900);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full, 9999px);
    border: 2px solid var(--color-border);
    font-size: 0.75rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-glow, 5px 5px 0 var(--color-border));
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 900;
    margin: 0 0 1.25rem;
    line-height: 1.2;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .article-description {
    font-size: 1.2rem;
    color: var(--color-text-light);
    margin: 0 0 2rem;
    line-height: 1.65;
    font-weight: 500;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-light);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .tag {
    padding: 0.3rem 0.75rem;
    background: var(--glass-bg, var(--color-bg-alt));
    color: var(--color-text-light);
    border-radius: var(--radius-full, 9999px);
    font-size: 0.8rem;
    font-weight: 700;
    border: 1.5px solid var(--color-border);
    text-decoration: none;
    transition: all var(--transition-fast, 0.2s);
  }

  .tag-link:hover {
    color: var(--color-bg-alt);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* === PROSE === */
  .prose {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: 1.875rem;
    font-weight: 800;
    margin: 2.75rem 0 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
    padding-left: 1rem;
    border-left: 4px solid var(--color-primary);
  }

  .prose :global(h3) {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 2rem 0 0.85rem;
    color: var(--color-text);
  }

  .prose :global(p) {
    margin: 1.25rem 0;
    line-height: 1.8;
  }
  .prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 600;
  }
  .prose :global(a:hover) {
    color: var(--color-secondary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.25rem 0;
    padding-left: 1.75rem;
  }
  .prose :global(li) {
    margin: 0.4rem 0;
  }

  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-primary);
    background: var(--color-bg-alt);
    border-radius: 0 var(--radius-lg, 0) var(--radius-lg, 0) 0;
    font-style: italic;
    color: var(--color-text);
  }

  .prose :global(pre) {
    background: var(--color-bg-elevated);
    color: var(--color-text);
    padding: 1.5rem;
    border-radius: var(--radius-lg, 0);
    overflow-x: auto;
    margin: 1.75rem 0;
    border: 2px solid var(--color-border);
  }

  .prose :global(code) {
    background: var(--color-bg-elevated);
    color: var(--color-primary-dark);
    border-radius: var(--radius-sm, 0);
    font-size: 0.9em;
    font-family: monospace;
    font-weight: 600;
    border: 1px solid var(--color-border);
    padding: 0.15em 0.4em;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
    border: none;
  }

  .prose :global(figure) {
    margin: 2rem auto;
  }

  .prose :global(figure img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 0);
    margin: 0 auto;
    display: block;
    box-shadow: var(--shadow-md, 5px 5px 0 var(--color-border));
    border: 2px solid var(--color-border);
  }

  .prose :global(figcaption) {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-light);
    font-style: italic;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 0);
    margin: 2rem auto;
    box-shadow: var(--shadow-md, 5px 5px 0 var(--color-border));
    border: 2px solid var(--color-border);
  }

  .article-sources {
    margin: 3rem 0 0;
    padding: 1.25rem 1.5rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--color-bg-alt);
  }

  .article-sources h2 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
  }

  .article-sources p {
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.55;
  }

  .article-sources ul {
    margin: 0.85rem 0 0;
    padding-left: 1.2rem;
  }

  .article-sources li + li {
    margin-top: 0.4rem;
  }

  .article-sources a {
    color: var(--color-primary);
    font-weight: 650;
  }

  /* === RELATED POSTS === */
  .related-posts {
    margin: 4rem 0 0;
    padding-top: 2.5rem;
    border-top: 2px solid var(--color-border);
  }

  .related-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0 0 1.5rem;
    color: var(--color-text);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg, 0);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition-base, 0.3s),
      border-color var(--transition-base, 0.3s),
      box-shadow var(--transition-base, 0.3s);
  }

  .related-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md, 5px 5px 0 var(--color-border));
  }

  .related-card-meta {
    color: var(--color-text-light);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .related-card-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.3;
  }

  .related-card-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-light);
    line-height: 1.5;
  }

  .related-card-cta {
    color: var(--color-primary-dark);
    font-weight: 700;
    font-size: 0.85rem;
    margin-top: auto;
  }

  /* === ARTICLE NAV (prev/next) === */
  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 3rem 0 0;
    padding-top: 2rem;
    border-top: 2px solid var(--color-border);
  }

  .article-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg, 0);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast, 0.2s);
  }

  .article-nav-only {
    grid-column: 2;
  }

  .article-nav-prev {
    text-align: left;
  }
  .article-nav-next {
    text-align: right;
  }

  .article-nav-link:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm, 3px 3px 0 var(--color-border));
  }

  .article-nav-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
