---
// Pagination du blog (page 2+). Page 1 = `/blog` (voir `index.astro`).
// Routes : `/blog/2`, `/blog/3`, … avec `<h1>` et `WebPage` schema explicites.

export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

const PAGE_SIZE = 6;

// `prerender = true` exige `getStaticPaths()`. On génère ici toutes les pages
// 2..lastPage au build-time. La page 1 reste gérée par `index.astro`.
export const getStaticPaths = (async () => {
  const PAGE_SIZE = 6;
  const all = await getCollection('blog');
  const visible = import.meta.env.PROD
    ? all.filter((a) => !a.data.draft)
    : all;
  const lastPage = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
  // Page 1 = index.astro. On génère ici les pages 2..lastPage.
  return Array.from({ length: lastPage - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}) satisfies GetStaticPaths;

const { page: pageParam } = Astro.params;
const currentPage = parseInt(pageParam ?? '1', 10);

if (isNaN(currentPage) || currentPage < 1) {
  return Astro.redirect('/blog/1');
}

const allArticles = await getCollection('blog');
const sorted = allArticles
  .filter((a: CollectionEntry<'blog'>) => import.meta.env.PROD ? !a.data.draft : true)
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const total = sorted.length;
const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE));

if (currentPage > lastPage) {
  return Astro.redirect(`/blog/${lastPage}`);
}

const start = (currentPage - 1) * PAGE_SIZE;
const end = Math.min(start + PAGE_SIZE - 1, total - 1);

const articles: CollectionEntry<'blog'>[] = sorted.slice(start, start + PAGE_SIZE);

const page = {
  currentPage,
  lastPage,
  total,
  start,
  end,
  url: {
    prev: currentPage > 1 ? (currentPage === 2 ? '/blog' : `/blog/${currentPage - 1}`) : undefined,
    next: currentPage < lastPage ? `/blog/${currentPage + 1}` : undefined,
  },
};
---

<Layout
  title={`Blog - Page ${page.currentPage} | Biscuits IA`}
  description={`Articles techniques sur le DevOps, l'Intelligence Artificielle et les bonnes pratiques de développement. Page ${page.currentPage} sur ${page.lastPage}.`}
  schema={{
    type: 'WebPage',
    data: {
      name: `Biscuits du Dev - Blog - Page ${page.currentPage}`,
      description: `Articles, guides et tutoriels pour associations et TPE. Page ${page.currentPage} sur ${page.lastPage}.`,
    }
  }}
>
  <div class="blog-wrapper">
    <div class="blog-container">

      <header class="page-header">
        <h1 class="page-title">Blog - Page {page.currentPage} sur {page.lastPage}</h1>
        <p class="page-subtitle">
          {page.start + 1}-{Math.min(page.end + 1, page.total)} sur {page.total} article{page.total > 1 ? 's' : ''}
        </p>
      </header>

      <div class="articles-grid">
        {articles.map((article: CollectionEntry<'blog'>, index: number) => (
          <article class="article-card" style={`animation-delay: ${index * 0.05}s`}>
            <a href={`/blog/${article.id}`} class="card-link">
              <div class="card-content">
                <div class="card-meta">
                  <time datetime={article.data.pubDate.toISOString()}>
                    {article.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {article.data.author && (
                    <span class="author">{article.data.author}</span>
                  )}
                </div>
                <h2 class="card-title">{article.data.title}</h2>
                {article.data.description && (
                  <p class="card-description">{article.data.description}</p>
                )}
                {article.data.tags && article.data.tags.length > 0 && (
                  <div class="card-tags">
                    {(article.data.tags as string[]).slice(0, 3).map((tag: string) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>

      {page.lastPage > 1 && (
        <nav class="pagination" aria-label="Navigation des pages">
          <a
            href={page.url.prev ?? '#'}
            class={`pagination-btn${!page.url.prev ? ' disabled' : ''}`}
            aria-disabled={!page.url.prev}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Précédent
          </a>

          <div class="pagination-pages">
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => (
              <a
                href={pageNum === 1 ? '/blog' : `/blog/${pageNum}`}
                class={`pagination-page${pageNum === page.currentPage ? ' active' : ''}`}
                aria-current={pageNum === page.currentPage ? 'page' : undefined}
              >
                {pageNum}
              </a>
            ))}
          </div>

          <a
            href={page.url.next ?? '#'}
            class={`pagination-btn${!page.url.next ? ' disabled' : ''}`}
            aria-disabled={!page.url.next}
          >
            Suivant
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </nav>
      )}
    </div>
  </div>
</Layout>

<style>
  .blog-wrapper { min-height: 100vh; background: var(--color-bg); }
  .blog-container { max-width: 1200px; margin: 0 auto; padding: 0 1rem 4rem; }

  .page-header {
    margin: 3rem 0 2rem;
    text-align: center;
  }
  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .page-subtitle {
    color: var(--color-text-light);
    font-weight: 600;
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .article-card {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--color-primary);
  }

  .card-link { color: inherit; text-decoration: none; display: block; }
  .card-content { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .card-meta { display: flex; gap: 1rem; color: var(--color-text-light); font-size: 0.85rem; font-weight: 600; }
  .card-title { font-size: 1.25rem; font-weight: 800; margin: 0; color: var(--color-text); line-height: 1.3; }
  .card-description { margin: 0; color: var(--color-text-light); line-height: 1.55; }

  .card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background: var(--color-bg-elevated);
    border: 1.5px solid var(--color-border);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .pagination-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1rem;
    background: var(--color-bg-alt);
    color: var(--color-text);
    font-weight: 700;
    border: 2px solid var(--color-border);
    text-decoration: none;
  }
  .pagination-btn.disabled { opacity: 0.4; pointer-events: none; }
  .pagination-btn:hover:not(.disabled) { border-color: var(--color-primary); color: var(--color-primary); }

  .pagination-pages { display: flex; gap: 0.25rem; }
  .pagination-page {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    background: var(--color-bg-alt);
    color: var(--color-text);
    border: 2px solid var(--color-border);
    font-weight: 700;
    text-decoration: none;
  }
  .pagination-page:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .pagination-page.active { background: var(--color-primary); color: var(--color-bg); border-color: var(--color-primary); }
</style>