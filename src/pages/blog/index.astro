---
// Page d'index du blog : hero + recherche + filtres par tag + grille paginee de tous les articles.
// Pagination 100% cote client (5 articles par page).
// Les pages dediees par tag sont generees par /blog/tag/[tag].astro.

export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

// Normalisation des tags en slug (coherent avec /blog/tag/[tag].astro).
const slugifyTag = (tag: string): string =>
  tag
    .toString()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const PAGE_SIZE = 5; // Nombre d'articles affiches par page (pagination client)

const allArticles = await getCollection('blog');
const sorted = allArticles
  .filter((a: CollectionEntry<'blog'>) => (import.meta.env.PROD ? !a.data.draft : true))
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const total = sorted.length;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

// Comptage des tags pour l'affichage des filtres.
const tagCounts = new Map<string, { display: string; count: number }>();
for (const a of sorted) {
  const tags = ((a.data.tags as string[]) || []) as string[];
  for (const t of tags) {
    const slug = slugifyTag(t);
    const existing = tagCounts.get(slug);
    if (existing) existing.count += 1;
    else tagCounts.set(slug, { display: t, count: 1 });
  }
}
const allTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1].count - a[1].count || a[0].localeCompare(b[0]))
  .map(([slug, meta]) => ({ slug, display: meta.display, count: meta.count }));

// Articles en vedette : on prend les 3 plus recents marques featured:true,
// sinon on complete avec les plus recents.
const featuredArticles = sorted
  .filter((a) => a.data.featured)
  .slice(0, 3)
  .concat(
    sorted
      .filter((a) => !a.data.featured)
      .slice(0, Math.max(0, 3 - sorted.filter((a) => a.data.featured).length))
  )
  .slice(0, 3);

// Donnees serialisees pour la recherche/filtre/pagination cote client.
const allArticlesForSearch = sorted.map((a: CollectionEntry<'blog'>) => ({
  id: a.id,
  title: a.data.title,
  description: (a.data.description ?? '') as string,
  pubDate: a.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }),
  pubDateISO: a.data.pubDate.toISOString(),
  author: a.data.author ?? 'Biscuits IA',
  tags: ((a.data.tags ?? []) as string[]),
  tagsSlug: ((a.data.tags ?? []) as string[]).map((t) => slugifyTag(t)),
  url: `/blog/${a.id}`,
  featured: a.data.featured ?? false,
}));

// SEO : titre et description uniques.
const pageTitle = 'Blog IA pour associations et collectivites | Biscuits IA';
const pageDescription = `${total} articles sur l'IA generative, la cybersecurite, les arnaques en ligne et l'automatisation, pour le grand public, les associations et les collectivites. Guides pratiques, tutoriels et outils libres.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/blog"
  schema={{
    type: 'WebPage',
    data: {
      name: pageTitle,
      description: pageDescription,
    }
  }}
>
  <Breadcrumb />

  <div class="blog-wrapper">
    <header class="blog-hero">
      <div class="hero-content">
        <span class="hero-eyebrow">Le blog de Biscuits IA</span>
      </div>
    </header>

    <div class="blog-container">

      <section class="featured-section" aria-labelledby="featured-title">
        <h2 id="featured-title" class="section-title">
          <span aria-hidden="true">★</span> Articles en vedette
        </h2>
        <div class="featured-grid">
          {featuredArticles.map((article) => (
            <a href={`/blog/${article.id}`} class="featured-card">
              <span class="featured-eyebrow">A la une</span>
              <h3 class="featured-title">{article.data.title}</h3>
              {article.data.description && (
                <p class="featured-description">{article.data.description}</p>
              )}
              <span class="featured-cta">Lire l'article →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="filter-section" aria-label="Filtrer les articles">
        <div class="search-wrapper">
          <div class="search-box">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="blog-search"
              placeholder="Rechercher..."
              autocomplete="off"
              aria-label="Rechercher un article"
            />
            <button type="button" id="search-clear" class="search-clear" aria-label="Effacer la recherche" hidden>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        <nav class="tag-filters" aria-label="Filtrer par theme">
          <button type="button" class="tag-pill active" data-tag="all">
            Tous <span class="tag-count">{total}</span>
          </button>
          {allTags.slice(0, 6).map((tag) => (
            <a
              href={`/blog/tag/${tag.slug}`}
              class="tag-pill"
              data-tag={tag.slug}
            >
              #{tag.display} <span class="tag-count">{tag.count}</span>
            </a>
          ))}
          {allTags.length > 6 && (
            <div class="tag-overflow" id="tag-overflow" hidden>
              {allTags.slice(6).map((tag) => (
                <a
                  href={`/blog/tag/${tag.slug}`}
                  class="tag-pill"
                  data-tag={tag.slug}
                >
                  #{tag.display} <span class="tag-count">{tag.count}</span>
                </a>
              ))}
            </div>
          )}
          {allTags.length > 6 && (
            <button
              type="button"
              class="tag-pill tag-pill-toggle"
              id="tag-toggle"
              aria-expanded="false"
              aria-controls="tag-overflow"
            >
              <span class="tag-toggle-label-show">Voir plus ({allTags.length - 6})</span>
              <span class="tag-toggle-label-hide">Voir moins</span>
              <svg class="tag-toggle-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
          )}
        </nav>
      </section>

      <section id="search-results" aria-live="polite" hidden>
        <p id="search-count" class="search-count"></p>
        <div id="search-grid" class="articles-grid"></div>
        <p id="search-empty" class="search-empty" hidden>
          Aucun article ne correspond a votre recherche. Essayez d'autres mots-cles ou <a href="/blog">reinitialisez le filtre</a>.
        </p>
      </section>

      <section id="blog-main-content">
        <div class="section-head-row">
          <h2 class="section-title">Tous nos articles</h2>
          <p id="pagination-status" class="pagination-status">
            Page 1 sur {totalPages}
          </p>
        </div>
        <div class="articles-grid" id="all-articles-grid">
          {sorted.map((article: CollectionEntry<'blog'>, index: number) => (
            <article class="article-card" style={`--card-index: ${index}`} data-article-id={article.id} data-page={Math.floor(index / PAGE_SIZE) + 1}>
              <div class="card-content">
                <div class="card-meta">
                  <time datetime={article.data.pubDate.toISOString()}>
                    {article.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {article.data.author && <span class="meta-sep">&middot;</span>}
                  {article.data.author && <span>{article.data.author}</span>}
                </div>
                <h3 class="card-title">
                  <a href={`/blog/${article.id}`} class="card-title-link">{article.data.title}</a>
                </h3>
                {article.data.description && (
                  <p class="card-description">{article.data.description}</p>
                )}
                <div class="card-footer">
                  {article.data.tags && article.data.tags.length > 0 && (
                    <div class="card-tags">
                      {(article.data.tags as string[]).slice(0, 3).map((tag: string) => (
                        <a href={`/blog/tag/${slugifyTag(tag)}`} class="tag" data-tag-slug={slugifyTag(tag)}>#{tag}</a>
                      ))}
                    </div>
                  )}
                  <span class="read-more">
                    Lire l'article
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <nav id="pagination" class="pagination" aria-label="Pagination des articles">
          <button type="button" class="pagination-btn" id="pagination-prev" aria-label="Page precedente" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Precedent</span>
          </button>

          <ol class="pagination-pages" id="pagination-pages"></ol>

          <button type="button" class="pagination-btn" id="pagination-next" aria-label="Page suivante">
            <span>Suivant</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </nav>
      </section>

    </div>
  </div>
</Layout>

<script is:inline define:vars={{ allArticlesForSearch, totalPages, total, PAGE_SIZE }}>
  // Moteur de recherche + filtre tag + pagination cote client.
  (function () {
    const searchInput = document.getElementById('blog-search');
    const searchClear = document.getElementById('search-clear');
    const searchResults = document.getElementById('search-results');
    const searchGrid = document.getElementById('search-grid');
    const searchCount = document.getElementById('search-count');
    const searchEmpty = document.getElementById('search-empty');
    const mainContent = document.getElementById('blog-main-content');
    const allArticlesGrid = document.getElementById('all-articles-grid');
    const tagButtons = document.querySelectorAll('.tag-pill[data-tag]');
    const paginationEl = document.getElementById('pagination');
    const paginationPages = document.getElementById('pagination-pages');
    const paginationPrev = document.getElementById('pagination-prev');
    const paginationNext = document.getElementById('pagination-next');
    const paginationStatus = document.getElementById('pagination-status');

    if (!searchInput || !searchResults || !searchGrid || !searchCount || !searchEmpty || !mainContent || !allArticlesGrid || !paginationEl || !paginationPages || !paginationPrev || !paginationNext || !paginationStatus) {
      return;
    }

    // Normalise le texte (lowercase + retrait des accents).
    const normalize = (s) =>
      (s || '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    let activeTag = 'all';
    let currentPage = 1;
    let currentMatches = allArticlesForSearch.slice();

    function escapeHtml(s) {
      return (s || '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])
      );
    }

    function renderCard(article) {
      const tagsHtml = (article.tags || [])
        .slice(0, 3)
        .map((t) => `<a href="/blog/tag/${slugify(t)}" class="tag">#${escapeHtml(t)}</a>`)
        .join('');
      return `
        <article class="article-card" data-article-id="${article.id}">
          <div class="card-content">
            <div class="card-meta">
              <time datetime="${article.pubDateISO}">${article.pubDate}</time>
              <span class="meta-sep">&middot;</span>
              <span>${escapeHtml(article.author)}</span>
            </div>
            <h3 class="card-title"><a href="${article.url}" class="card-title-link">${escapeHtml(article.title)}</a></h3>
            ${article.description ? `<p class="card-description">${escapeHtml(article.description)}</p>` : ''}
            <div class="card-footer">
              ${tagsHtml ? `<div class="card-tags">${tagsHtml}</div>` : ''}
              <span class="read-more">Lire l'article <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            </div>
          </div>
        </article>
      `;
    }

    function slugify(s) {
      return (s || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    }

    function buildPageList(current, last) {
      // Genere une liste de pages avec ellipses : 1 ... 4 5 6 ... 12
      const pages = new Set([1, last]);
      for (let i = Math.max(1, current - 1); i <= Math.min(last, current + 1); i++) {
        pages.add(i);
      }
      const sorted = Array.from(pages).sort((a, b) => a - b);
      const out = [];
      let prev = 0;
      for (const p of sorted) {
        if (prev && p - prev > 1) {
          out.push({ kind: 'ellipsis', key: 'ellipsis-' + prev + '-' + p });
        }
        out.push({ kind: 'page', num: p, key: 'p-' + p });
        prev = p;
      }
      return out;
    }

    function renderPagination(lastPage) {
      if (lastPage <= 1) {
        paginationEl.hidden = true;
        return;
      }
      paginationEl.hidden = false;
      paginationPrev.disabled = currentPage <= 1;
      paginationNext.disabled = currentPage >= lastPage;

      const items = buildPageList(currentPage, lastPage);
      paginationPages.innerHTML = items
        .map((it) => {
          if (it.kind === 'ellipsis') {
            return `<li class="pagination-ellipsis" aria-hidden="true">&hellip;</li>`;
          }
          const isActive = it.num === currentPage;
          return `<li><button type="button" class="pagination-page${isActive ? ' active' : ''}" data-page="${it.num}" aria-current="${isActive ? 'page' : 'false'}" aria-label="Aller a la page ${it.num}">${it.num}</button></li>`;
        })
        .join('');
    }

    function applyFilter() {
      const query = normalize(searchInput.value.trim());
      const tag = activeTag;
      const isFiltering = !!query || tag !== 'all';

      if (isFiltering) {
        currentMatches = allArticlesForSearch.filter((a) => {
          if (tag !== 'all' && !(a.tagsSlug || []).includes(tag)) return false;
          if (query) {
            const haystack = normalize(a.title + ' ' + a.description + ' ' + (a.tags || []).join(' '));
            if (!haystack.includes(query)) return false;
          }
          return true;
        });
        // En mode recherche : pas de pagination, on affiche tout
        mainContent.hidden = true;
        paginationEl.hidden = true;
        searchResults.hidden = false;
        searchGrid.innerHTML = currentMatches.map(renderCard).join('');
        const n = currentMatches.length;
        searchCount.textContent = n + ' article' + (n > 1 ? 's' : '') + ' trouve' + (n > 1 ? 's' : '');
        searchEmpty.hidden = n > 0;
      } else {
        // Mode normal : pagination
        mainContent.hidden = false;
        searchResults.hidden = true;
        currentMatches = allArticlesForSearch;
        // Si on a change de filtre, on reset la page
        if (currentPage > totalPages) currentPage = 1;
        renderMainPagination();
      }
    }

    function renderMainPagination() {
      const lastPage = Math.max(1, Math.ceil(currentMatches.length / PAGE_SIZE));
      if (currentPage > lastPage) currentPage = lastPage;
      if (currentPage < 1) currentPage = 1;

      // Cache les cartes hors page
      const cards = allArticlesGrid.querySelectorAll('.article-card');
      cards.forEach((card) => {
        const p = parseInt(card.getAttribute('data-page') || '1', 10);
        card.hidden = p !== currentPage;
      });

      renderPagination(lastPage);
      paginationStatus.textContent = 'Page ' + currentPage + ' sur ' + lastPage + ' (' + currentMatches.length + ' article' + (currentMatches.length > 1 ? 's' : '') + ')';
    }

    function goToPage(p) {
      currentPage = p;
      renderMainPagination();
      // Scroll vers la grille (pas tout en haut de page)
      const top = allArticlesGrid.getBoundingClientRect().top + window.scrollY - 120;
      window.scrollTo({ top, behavior: 'smooth' });
    }

    // Bouton "Voir plus" pour les tags.
    const tagToggle = document.getElementById('tag-toggle');
    const tagOverflow = document.getElementById('tag-overflow');
    if (tagToggle && tagOverflow) {
      tagToggle.addEventListener('click', () => {
        const expanded = tagToggle.getAttribute('aria-expanded') === 'true';
        const next = !expanded;
        tagToggle.setAttribute('aria-expanded', String(next));
        tagOverflow.hidden = !next;
      });
    }

    // Filtre par tag (pill).
    tagButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        // Liens : on laisse la navigation se faire naturellement (vers /blog/tag/...).
        if (btn.tagName === 'A') return;
        e.preventDefault();
        tagButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeTag = btn.getAttribute('data-tag') || 'all';
        currentPage = 1;
        applyFilter();
        if (activeTag !== 'all') {
          document.getElementById('search-results')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Recherche live (debounced).
    let searchTimer = null;
    searchInput.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        if (searchInput.value.trim()) {
          searchClear.hidden = false;
        } else {
          searchClear.hidden = true;
        }
        applyFilter();
      }, 120);
    });

    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      searchClear.hidden = true;
      applyFilter();
      searchInput.focus();
    });

    // Boutons de pagination.
    paginationPrev.addEventListener('click', () => {
      if (currentPage > 1) goToPage(currentPage - 1);
    });
    paginationNext.addEventListener('click', () => {
      const lastPage = Math.max(1, Math.ceil(currentMatches.length / PAGE_SIZE));
      if (currentPage < lastPage) goToPage(currentPage + 1);
    });
    paginationPages.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      if (t.tagName !== 'BUTTON') return;
      const p = parseInt(t.getAttribute('data-page') || '1', 10);
      if (!isNaN(p)) goToPage(p);
    });

    // Raccourci "/" pour focaliser la recherche.
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
      if (e.key === 'Escape' && document.activeElement === searchInput) {
        searchInput.value = '';
        searchClear.hidden = true;
        applyFilter();
        searchInput.blur();
      }
    });

    // Initialisation : afficher la page 1
    renderMainPagination();
  })();
</script>

<style>
  .blog-wrapper { min-height: 100vh; background: var(--color-bg); }

  /* === HERO === */
  .blog-hero {
    padding: calc(var(--header-height-desktop) + 2rem) 1rem 3rem;
    background: var(--color-bg);
    text-align: center;
  }

  .hero-content { max-width: 800px; margin: 0 auto; }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full, 9999px);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    margin: 0 0 1.25rem;
    color: var(--color-text);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  /* === CONTAINER === */
  .blog-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem 4rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 2.5rem 0 1.5rem;
  }

  .section-head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 5rem;
    padding-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-top: 2px solid var(--color-border);
  }

  .section-head-row .section-title { margin: 0; }

  .pagination-status {
    color: var(--color-text-light);
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0;
  }

  /* === FEATURED === */
  .featured-section { margin-bottom: 3rem; }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl, 1rem);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-md, 5px 5px 0 var(--color-border));
    transition: transform var(--transition-base, 0.3s), box-shadow var(--transition-base, 0.3s), border-color var(--transition-base, 0.3s);
  }

  .featured-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-xl, 10px 10px 0 var(--color-border));
    border-color: var(--color-primary);
  }

  .featured-eyebrow {
