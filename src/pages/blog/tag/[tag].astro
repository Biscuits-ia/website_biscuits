---
// Page dediee a un tag du blog.
// URL : /blog/tag/[tag] (slug normalise du tag).

export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { jsonLd } from '@/lib/jsonLd';

// slugifyTag est defini dans getStaticPaths pour eviter les problemes de hoisting
// avec le compilateur Astro. On declare ici une version pour le rendu HTML.

function slugifyTag(tag: string): string {
  return tag
    .toString()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

export const getStaticPaths = (async () => {
  // Re-declaration locale pour eviter les soucis de scope Astro.
  function slugifyTag2(tag: string): string {
    return tag
      .toString()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }
  const all = await getCollection('blog');
  const visible = import.meta.env.PROD ? all.filter((a) => !a.data.draft) : all;
  const tagMap = new Map<string, { display: string; count: number }>();
  for (const article of visible) {
    const tags = ((article.data.tags as string[]) || []) as string[];
    for (const t of tags) {
      const slug = slugifyTag2(t);
      const existing = tagMap.get(slug);
      if (existing) {
        existing.count += 1;
      } else {
        tagMap.set(slug, { display: t, count: 1 });
      }
    }
  }
  return Array.from(tagMap.entries()).map(([slug, meta]) => ({
    params: { tag: slug },
    props: { tagDisplay: meta.display, tagSlug: slug, totalCount: meta.count },
  }));
}) satisfies GetStaticPaths;

const { tag: tagParam } = Astro.params;
const {
  tagDisplay,
  tagSlug,
  totalCount: _totalCount,
} = Astro.props as { tagDisplay: string; tagSlug: string; totalCount: number };

if (!tagParam) {
  return Astro.redirect('/blog');
}

const allArticles = await getCollection('blog');
const visible = import.meta.env.PROD
  ? allArticles.filter((a: CollectionEntry<'blog'>) => !a.data.draft)
  : allArticles;

const globalTagCounts = new Map<string, number>();
for (const article of visible) {
  for (const tag of ((article.data.tags as string[]) || []) as string[]) {
    const slug = slugifyTag(tag);
    globalTagCounts.set(slug, (globalTagCounts.get(slug) ?? 0) + 1);
  }
}

const articles = visible
  .filter((a: CollectionEntry<'blog'>) => {
    const tags = ((a.data.tags as string[]) || []) as string[];
    return tags.some((t) => slugifyTag(t) === tagSlug);
  })
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const coOccurrence = new Map<string, number>();
for (const a of articles) {
  const tags = ((a.data.tags as string[]) || []) as string[];
  for (const t of tags) {
    if (slugifyTag(t) !== tagSlug) {
      coOccurrence.set(t, (coOccurrence.get(t) ?? 0) + 1);
    }
  }
}
const relatedTags = Array.from(coOccurrence.entries())
  .filter(([name]) => (globalTagCounts.get(slugifyTag(name)) ?? 0) >= 3)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([name, count]) => ({ name, count }));

const pageTitle = `Articles sur ${tagDisplay} - Blog Biscuits IA`;
const pageDescription = `Tous nos articles sur le theme ${tagDisplay} : tutoriels, guides pratiques et retours d'experience pour associations, collectivites et petites structures. ${articles.length} article${articles.length > 1 ? 's' : ''} disponible${articles.length > 1 ? 's' : ''}.`;
const pageUrl = `/blog/tag/${tagSlug}`;

// ItemList JSON-LD : enumere les articles de ce tag dans le graphe structure
// (comme /ateliers et /formations). Contrairement a ces pages, chaque article
// a sa propre URL -> on la fournit sur le ListItem pour un lien direct.
const siteUrl = import.meta.env.SITE || 'https://biscuits-ia.com';
const tagItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: articles.map((article: CollectionEntry<'blog'>, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/blog/${article.id}`,
    item: {
      '@type': 'Article',
      name: article.data.title,
      description: article.data.description ?? '',
      url: `${siteUrl}/blog/${article.id}`,
    },
  })),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  noindex={articles.length < 3}
  schema={{
    type: 'WebPage',
    data: {
      name: pageTitle,
      description: pageDescription,
    },
  }}
>
  <Breadcrumb />

  <div class="blog-wrapper">
    <div class="blog-container">
      <header class="tag-header">
        <span class="tag-eyebrow">Theme du blog</span>
        <h1 class="tag-title">
          <span class="tag-prefix">#</span>{tagDisplay}
        </h1>
        <p class="tag-subtitle">
          {articles.length} article{articles.length > 1 ? 's' : ''} sur ce theme &middot; mis a jour regulierement
        </p>
        <a href="/blog" class="tag-back">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Tous les articles
        </a>
      </header>

      {
        relatedTags.length > 0 && (
          <nav class="related-tags" aria-label="Themes associes">
            <span class="related-tags-label">Voir aussi :</span>
            {relatedTags.map((rt) => (
              <a href={`/blog/tag/${slugifyTag(rt.name)}`} class="related-tag-pill">
                #{rt.name} <small>({rt.count})</small>
              </a>
            ))}
          </nav>
        )
      }

      <section class="articles-grid" aria-label={`Articles sur ${tagDisplay}`}>
        {
          articles.map((article, index) => (
            <article class="article-card" style={`--card-index: ${index}`}>
              <a href={`/blog/${article.id}`} class="card-link">
                <div class="card-content">
                  <div class="card-meta">
                    <time datetime={article.data.pubDate.toISOString()}>
                      {article.data.pubDate.toLocaleDateString('fr-FR', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    {article.data.author && <span class="meta-sep">&middot;</span>}
                    {article.data.author && <span>{article.data.author}</span>}
                  </div>
                  <h2 class="card-title">{article.data.title}</h2>
                  {article.data.description && (
                    <p class="card-description">{article.data.description}</p>
                  )}
                  {article.data.tags && article.data.tags.length > 0 && (
                    <div class="card-tags">
                      {(article.data.tags as string[]).slice(0, 3).map((tag: string) => (
                        <span class={`tag${slugifyTag(tag) === tagSlug ? ' tag-active' : ''}`}>
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <span class="read-more">
                    Lire l'article
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </section>

      {
        articles.length === 0 && (
          <div class="empty-state">
            <p>Aucun article disponible pour ce theme pour le moment.</p>
            <a href="/blog" class="empty-state-link">
              Retour au blog
            </a>
          </div>
        )
      }
    </div>
  </div>
</Layout>

{
  articles.length > 0 && (
    <script is:inline type="application/ld+json" set:html={jsonLd(tagItemListSchema)} />
  )
}

<style>
  .blog-wrapper {
    min-height: 60vh;
    background: var(--color-bg);
  }

  .blog-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: calc(var(--header-height-desktop) + 2rem) 1rem 4rem;
  }

  .tag-header {
    text-align: center;
    padding: 2rem 1rem 3rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .tag-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full, 9999px);
    margin-bottom: 1rem;
  }

  .tag-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tag-prefix {
    color: var(--color-primary);
    margin-right: 0.1em;
  }

  .tag-subtitle {
    color: var(--color-text-light);
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0 0 1.5rem;
  }

  .tag-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-button, 0.875rem);
    background: var(--color-bg-alt);
    transition: all var(--transition-fast, 0.2s);
  }

  .tag-back:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
  }

  .related-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 auto 2.5rem;
    padding: 1.25rem 1.5rem;
    max-width: 1100px;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl, 1rem);
  }

  .related-tags-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    margin-right: 0.5rem;
  }

  .related-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.85rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-button, 0.875rem);
    transition: all var(--transition-fast, 0.2s);
  }

  .related-tag-pill:hover {
    color: var(--color-bg-alt);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .related-tag-pill small {
    opacity: 0.7;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .article-card {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl, 1rem);
    overflow: hidden;
    transition:
      transform var(--transition-base, 0.3s),
      box-shadow var(--transition-base, 0.3s),
      border-color var(--transition-base, 0.3s);
    animation: fadeInUp 0.4s ease-out backwards;
    animation-delay: calc(var(--card-index, 0) * 0.05s);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg, 7px 7px 0 var(--color-border));
    border-color: var(--color-primary);
  }

  .card-link {
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-meta {
    display: flex;
    gap: 0.5rem;
    color: var(--color-text-light);
    font-size: 0.85rem;
    font-weight: 600;
    flex-wrap: wrap;
    align-items: center;
  }

  .meta-sep {
    color: var(--color-border);
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0;
    color: var(--color-text);
    line-height: 1.3;
  }
  .card-description {
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.55;
    font-size: 0.95rem;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: var(--color-bg-alt);
    border: 1.5px solid var(--color-border);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
  }

  .tag-active {
    background: var(--color-primary);
    color: var(--color-bg-alt);
    border-color: var(--color-primary);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-text-light);
  }
  .empty-state p {
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
  }
  .empty-state-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg-elevated);
    text-decoration: none;
    font-weight: 700;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-button, 0.875rem);
    box-shadow: var(--shadow-md, 5px 5px 0 var(--color-border));
  }

  @media (max-width: 640px) {
    .blog-container {
      padding-top: calc(var(--header-height-mobile) + 1rem);
    }
    .related-tags {
      padding: 1rem;
    }
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
