---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';

const engagements = [
  { icon: "🔓", titre: "Open Source", description: "Tous nos outils sont open source. Le code est public, auditable par toute personne souhaitant vérifier nos pratiques." },
  { icon: "🚫", titre: "Zéro revente de données", description: "Nous ne vendons ni ne louons les données de nos utilisateurs. Jamais. Vos données vous appartiennent." },
  { icon: "🔍", titre: "Auditabilité totale", description: "Nos algorithmes sont documentés et nos décisions explicables. Pas de boîte noire." },
  { icon: "🌍", titre: "Intérêt général", description: "Biscuits IA est une association loi 1901. Notre mission est d'ordre public, sans actionnaires à satisfaire." },
  { icon: "♿", titre: "Accessibilité", description: "Nous visons la conformité WCAG 2.1 niveau AA pour garantir l'accès à tous, quelles que soient les situations de handicap." },
  { icon: "🤝", titre: "Solidarité numérique", description: "Nos outils sont gratuits pour les associations, TPE et petites structures. La fracture numérique, c'est notre combat." },
];
---

<Layout
  title="Charte Éthique | Biscuits IA"
  description="Découvrez nos engagements éthiques : open source, zéro revente de données, accessibilité et intérêt général."
>
  <section class="charte-hero">
    <div class="charte-hero__inner">
      <h1>Notre Charte Éthique</h1>
      <p>Transparence, solidarité et responsabilité sont au cœur de chacune de nos décisions. Voici nos engagements concrets.</p>
    </div>
  </section>

  <section class="charte-engagements">
    <div class="charte-container">
      <h2>Nos Engagements</h2>
      <div class="engagements-grid">
        {engagements.map((eng) => (
          <div class="engagement-card">
            <span class="engagement-icon">{eng.icon}</span>
            <h3>{eng.titre}</h3>
            <p>{eng.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
.charte-hero {
  background: linear-gradient(135deg, var(--color-secondary), var(--color-primary));
  color: var(--color-bg-elevated);
  padding: 4rem 1rem 3rem;
  text-align: center;
}
.charte-hero__inner { max-width: 700px; margin: 0 auto; }
.charte-hero h1 { font-size: 2.5rem; margin-bottom: 1rem; }
.charte-engagements {
  padding: 3rem 1rem;
}
.charte-container { max-width: 1000px; margin: 0 auto; }
.charte-container h2 {
  font-size: 2rem;
  color: var(--color-primary);
  margin-bottom: 1.5rem;
  text-align: center;
}
.engagements-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}
.engagement-card {
  background: var(--color-bg-elevated);
  border-radius: 1.25rem;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border-second);
  padding: 1.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.engagement-icon { font-size: 2rem; }
.engagement-card h3 { color: var(--color-secondary); font-size: 1.15rem; }
</style>
