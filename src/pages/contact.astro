---
export const prerender = true;

import BaseLayout from '@/layouts/Layout.astro';
import ContactForm from '@/components/ContactForm.astro';
---

<BaseLayout
  title="Nous contacter ou demander un accompagnement | Biscuits IA"
  description="Une question, un projet, besoin d'un coup de main avec l'IA ? On est là — écrivez-nous."
>
  <section class="quote-hero">
    <div class="container">
      <h1>On est là 👋</h1>
      <p class="w-1/3">Une question, un projet, une idée à partager ? Écrivez-nous, on vous répond.</p>
    </div>
  </section>

  <section class="quote-form-section">
    <div class="container">
      <h2>Parlez-nous de votre projet et de vos besoins</h2>

      <div class="contact-actions">
        <a href="/rdv" class="btn-rdv">
          📅 Prendre rendez-vous
        </a>
        <span class="or-separator">ou remplissez le formulaire ci-dessous</span>
      </div>

      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .quote-hero {
    padding: 6rem var(--spacing-lg);
    text-align: center;
    background: var(--color-bg);
  }

  .quote-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }

  .quote-hero p {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--color-text-light);
    max-width: 700px;
    margin: 0 auto;
  }

  .quote-form-section h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--spacing-2xl);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .btn-rdv {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    font-size: 1rem;
    font-weight: 800;
    font-family: var(--font-sans);
    background: var(--color-primary, #000);
    color: var(--color-primary-contrast, #fff);
    border: 2px solid #000;
    text-decoration: none;
    box-shadow: 4px 4px 0 #000;
    transition: transform 0.1s, box-shadow 0.1s;
  }

  .btn-rdv:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #000;
  }

  .or-separator {
    font-size: 0.9rem;
    color: var(--color-text-light);
  }
</style>