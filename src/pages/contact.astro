---
import BaseLayout from '@/layouts/Layout.astro';
import ContactForm from '@/components/ContactForm.astro';
---

<BaseLayout
  title="Demande de devis | Biscuits IA"
  description="Obtenez un devis personnalisé pour vos besoins en IA et automatisation professionnels."
>
  <section class="quote-hero">
    <div class="container">
      <h1>Contactez-nous</h1>
      <p class="w-1/3">Vous avez des questions ou besoin d'un accompagnement ? Contactez-nous via le formulaire ci-dessous.</p>
    </div>
  </section>

  <section class="quote-form-section">
    <div class="container">
      <h2>Informations nécessaires</h2>
      <!-- ContactForm gère lui-même l'import de son script côté client -->
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .quote-hero {
    padding: 6rem var(--spacing-lg);
    text-align: center;
    background: var(--color-bg);
  }

  .quote-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }

  .quote-hero p {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--color-text-light);
    max-width: 700px;
    margin: 0 auto;
  }

  .quote-form-section h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--spacing-2xl);
  }
</style>