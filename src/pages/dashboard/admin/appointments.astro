---
import AdminAppointmentsDashboard from '@/components/AdminAppointmentsDashboard.astro';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdmin } from '@/lib/auth';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';
---

<DashboardLayout title="Gestion des rendez-vous" activePage="appointments" userName={userName} authResult={result}>
  <AdminAppointmentsDashboard />
</DashboardLayout>
