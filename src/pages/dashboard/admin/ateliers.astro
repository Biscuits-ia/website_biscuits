---
// src/pages/dashboard/admin/ateliers.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin }  from '../../../lib/auth';
import type { Workshop, WorkshopSession } from '../../../types/ateliers';
import {
  getRegistrationCount,
  formatDate,
  formatTimeRange,
  formatPrice,
} from '../../../types/ateliers';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error') ?? '';

// Tous les ateliers avec leurs sessions
const { data: workshopsRaw } = await supabase
  .from('workshops')
  .select(`
    id, title, description, category, level, price_cents, price_label, is_free, created_at,
    workshop_sessions (
      id, starts_at, ends_at, location, online, max_seats, is_published,
      price_cents, price_label,
      workshop_registrations (count)
    )
  `)
  .order('created_at', { ascending: false });

// Cast strict après récupération Supabase
const workshops  = (workshopsRaw ?? []) as Workshop[];
const count      = workshops.length;
// Pré-calculé ici pour éviter l'opérateur > dans le template
const countLabel = count > 1 ? `${count} ateliers` : `${count} atelier`;

// ── Pré-calcul des valeurs dérivées ────────────────────────────────────────
//
// RÈGLE ASTRO : les opérateurs < et > dans un template JSX sont interprétés
// comme des balises Fragment <> et provoquent l'erreur :
//   "Unable to assign attributes when using <> Fragment shorthand syntax"
//
// Solution : toute logique conditionnelle avec < / > est résolue ici,
// dans le frontmatter (---), et transmise au template via des propriétés
// de type string ou number déjà calculées.

interface SessionRow {
  session:    WorkshopSession;
  registered: number;
  seatBadge:  string;  // classe CSS : badge-err | badge-warn | badge-ok
  seatLabel:  string;  // texte affiché : "Complet" | "N restante(s)"
  dateStr:    string;  // date formatée fr-FR
  timeRange:  string;  // "HH:MM → HH:MM"
  toggleVal:  string;  // String(!s.is_published) — évite l'opérateur ! dans le template
  priceStr:   string;  // prix affiché
}

interface WorkshopRow {
  workshop: Workshop;
  sessions: SessionRow[];
  hasSessions: boolean; // length !== 0 — évite > dans le template
}

function seatBadgeClass(left: number): string {
  if (left <= 0) return 'badge-err';
  if (left <= 3) return 'badge-warn';
  return 'badge-ok';
}

function seatText(left: number): string {
  if (left <= 0) return 'Complet';
  if (left === 1) return '1 restante';
  return `${left} restantes`;
}

const workshopRows: WorkshopRow[] = workshops.map((w: Workshop) => {
  const sessions: SessionRow[] = (w.workshop_sessions ?? []).map(
    (s: WorkshopSession): SessionRow => {
      const registered = getRegistrationCount(s);
      const left       = s.max_seats - registered;
      // Prix de la session : override ou hérité de l'atelier
      const sessionPrice = s.price_cents ?? w.price_cents;
      const sessionPriceLabel = s.price_label ?? w.price_label;
      return {
        session:    s,
        registered,
        seatBadge:  seatBadgeClass(left),
        seatLabel:  seatText(left),
        dateStr:    formatDate(s.starts_at),
        timeRange:  formatTimeRange(s.starts_at, s.ends_at),
        toggleVal:  String(!s.is_published),
        priceStr:   formatPrice(sessionPrice, sessionPriceLabel),
      };
    },
  );
  return { workshop: w, sessions, hasSessions: sessions.length !== 0 };
});
---

<DashboardLayout title="Gestion ateliers" activePage="ateliers" userName={userName} authResult={result}>

  <div class="header-row">
    <div>
      <h1>Gestion des ateliers</h1>
      <p class="subtitle">{countLabel} au total.</p>
    </div>
    <button class="btn btn-primary" data-modal-open="modal-atelier">
      + Nouvel atelier
    </button>
  </div>

  {saved && <div class="flash flash-ok" role="alert">✓ Modifications sauvegardées.</div>}
  {error  && <div class="flash flash-err" role="alert">✗ {decodeURIComponent(error)}</div>}

  <div class="workshops-list">
    {workshopRows.map(({ workshop: w, sessions, hasSessions }) => (
      <div class="card">

        <!-- En-tête de l'atelier -->
        <div class="workshop-header">
          <div>
            <div class="workshop-title">{w.title}</div>
            {w.category    && <span class="badge badge-info badge-mt">{w.category}</span>}
            {w.level       && <span class="badge badge-neutral badge-mt">{w.level}</span>}
            <span class="badge badge-price badge-mt">{formatPrice(w.price_cents, w.price_label)}</span>
            {w.description && <p class="workshop-desc">{w.description}</p>}
          </div>
          <div class="workshop-actions">
            <button
              class="btn btn-ghost btn-sm"
              data-modal-open={`modal-session-${w.id}`}
            >+ Session</button>
            <button
              class="btn btn-ghost btn-sm"
              data-modal-open={`modal-edit-${w.id}`}
            >Modifier</button>
            <form method="POST" action="/api/admin/ateliers/supprimer" style="display:inline;">
              <input type="hidden" name="workshop_id" value={w.id} />
              <button
                type="submit"
                class="btn btn-danger btn-sm"
                data-confirm="Supprimer cet atelier et toutes ses sessions ?"
              >Supprimer</button>
            </form>
          </div>
        </div>

        <!-- Sessions — hasSessions pré-calculé dans le frontmatter (évite length > 0) -->
        {hasSessions ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Date &amp; heure</th>
                  <th>Lieu</th>
                  <th>Prix</th>
                  <th>Inscrits</th>
                  <th>Places</th>
                  <th>Statut</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {sessions.map(({ session: s, registered, seatBadge, seatLabel, dateStr, timeRange, toggleVal, priceStr }) => (
                  <tr>
                    <td>
                      <strong>{dateStr}</strong><br />
                      <span class="time-range">{timeRange}</span>
                    </td>
                    <td>{s.online ? '🌐 En ligne' : (s.location ?? '—')}</td>
                    <td class="mono">{priceStr}</td>
                    <td class="mono bold">{registered}</td>
                    <td><span class={`badge ${seatBadge}`}>{seatLabel}</span></td>
                    <td>
                      <span class={`badge ${s.is_published ? 'badge-ok' : 'badge-neutral'}`}>
                        {s.is_published ? 'Publié' : 'Brouillon'}
                      </span>
                    </td>
                    <td>
                      <div class="row-actions">
                        <form method="POST" action="/api/admin/sessions/toggle">
                          <input type="hidden" name="session_id"  value={s.id} />
                          <input type="hidden" name="is_published" value={toggleVal} />
                          <button type="submit" class="btn btn-ghost btn-xs">
                            {s.is_published ? 'Dépublier' : 'Publier'}
                          </button>
                        </form>
                        <form method="POST" action="/api/admin/sessions/supprimer">
                          <input type="hidden" name="session_id" value={s.id} />
                          <button
                            type="submit"
                            class="btn btn-danger btn-xs"
                            data-confirm="Supprimer cette session ?"
                          >✕</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="empty-note">Aucune session pour cet atelier.</p>
        )}

        <!-- Modal : nouvelle session -->
        <dialog id={`modal-session-${w.id}`} class="modal">
          <div class="modal-box">
            <div class="modal-header">
              <span class="card-title">Nouvelle session — {w.title}</span>
              <button
                class="btn btn-ghost modal-close"
                data-modal-close={`modal-session-${w.id}`}
              >✕</button>
            </div>
            <form method="POST" action="/api/admin/sessions/creer" class="modal-form">
              <input type="hidden" name="workshop_id" value={w.id} />
              <div class="field">
                <label>Date et heure de début *</label>
                <input type="datetime-local" name="starts_at" required />
              </div>
              <div class="field">
                <label>Date et heure de fin *</label>
                <input type="datetime-local" name="ends_at" required />
              </div>
              <div class="field">
                <label>Lieu</label>
                <input type="text" name="location" placeholder="Ex : 12 rue de la Paix, Paris" />
              </div>
              <div class="checkbox-row">
                <input type="checkbox" id={`online-${w.id}`} name="online" value="true" />
                <label for={`online-${w.id}`} class="label-sm">Session en ligne</label>
              </div>
              <div class="field">
                <label>Places max</label>
                <input type="number" name="max_seats" value="15" min="1" max="100" />
              </div>
              <div class="checkbox-row">
                <input type="checkbox" id={`pub-${w.id}`} name="is_published" value="true" />
                <label for={`pub-${w.id}`} class="label-sm">Publier immédiatement</label>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn btn-primary">Créer la session</button>
                <button
                  type="button"
                  class="btn btn-ghost"
                  data-modal-close={`modal-session-${w.id}`}
                >Annuler</button>
              </div>
            </form>
          </div>
        </dialog>

        <!-- Modal : modifier atelier -->
        <dialog id={`modal-edit-${w.id}`} class="modal">
          <div class="modal-box">
            <div class="modal-header">
              <span class="card-title">Modifier l'atelier</span>
              <button
                class="btn btn-ghost modal-close"
                data-modal-close={`modal-edit-${w.id}`}
              >✕</button>
            </div>
            <form method="POST" action="/api/admin/ateliers/modifier" class="modal-form">
              <input type="hidden" name="workshop_id" value={w.id} />
              <div class="field">
                <label>Titre *</label>
                <input type="text" name="title" value={w.title} required />
              </div>
              <div class="field">
                <label>Description</label>
                <textarea name="description" rows={3}>{w.description ?? ''}</textarea>
              </div>
              <div class="field-group">
                <div class="field">
                  <label>Catégorie</label>
                  <input type="text" name="category" value={w.category ?? ''} placeholder="Ex : IA générative" />
                </div>
                <div class="field">
                  <label>Niveau</label>
                  <select name="level">
                    <option value="" selected={!w.level}>— Non défini —</option>
                    <option value="Débutant" selected={w.level === 'Débutant'}>Débutant</option>
                    <option value="Intermédiaire" selected={w.level === 'Intermédiaire'}>Intermédiaire</option>
                    <option value="Avancé" selected={w.level === 'Avancé'}>Avancé</option>
                  </select>
                </div>
              </div>
              <div class="field-group">
                <div class="field">
                  <label>Prix par défaut (centimes, 0 = gratuit)</label>
                  <input type="number" name="price_cents" value={w.price_cents} min="0" step="1" />
                  <span class="field-hint">Ex : 3500 = 35,00 €</span>
                </div>
                <div class="field">
                  <label>Libellé affiché (optionnel)</label>
                  <input type="text" name="price_label" value={w.price_label ?? ''} placeholder='Ex: "35 €", "Gratuit", "Sur devis"' />
                </div>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn btn-primary">Sauvegarder</button>
                <button
                  type="button"
                  class="btn btn-ghost"
                  data-modal-close={`modal-edit-${w.id}`}
                >Annuler</button>
              </div>
            </form>
          </div>
        </dialog>

      </div>
    ))}
  </div>

  <!-- Modal : créer atelier -->
  <dialog id="modal-atelier" class="modal">
    <div class="modal-box">
      <div class="modal-header">
        <span class="card-title">Nouvel atelier</span>
        <button class="btn btn-ghost" data-modal-close="modal-atelier">✕</button>
      </div>
      <form method="POST" action="/api/admin/ateliers/creer" class="modal-form">
        <div class="field">
          <label>Titre *</label>
          <input type="text" name="title" required placeholder="Titre de l'atelier" />
        </div>
        <div class="field">
          <label>Description</label>
          <textarea name="description" rows={3} placeholder="Description courte…"></textarea>
        </div>
        <div class="field-group">
          <div class="field">
            <label>Catégorie</label>
            <input type="text" name="category" placeholder="Ex : IA générative" />
          </div>
          <div class="field">
            <label>Niveau</label>
            <select name="level">
              <option value="">— Non défini —</option>
              <option value="Débutant">Débutant</option>
              <option value="Intermédiaire">Intermédiaire</option>
              <option value="Avancé">Avancé</option>
            </select>
          </div>
        </div>
        <div class="field-group">
          <div class="field">
            <label>Prix (centimes, 0 = gratuit)</label>
            <input type="number" name="price_cents" value="0" min="0" step="1" />
            <span class="field-hint">Ex : 3500 = 35,00 €</span>
          </div>
          <div class="field">
            <label>Libellé affiché (optionnel)</label>
            <input type="text" name="price_label" placeholder='Ex: "35 €", "Sur devis"' />
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Créer l'atelier</button>
          <button type="button" class="btn btn-ghost" data-modal-close="modal-atelier">Annuler</button>
        </div>
      </form>
    </div>
  </dialog>

</DashboardLayout>

<style>
  /* ── Layout ── */
  .header-row     { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .subtitle       { margin-top: 6px; }
  .workshops-list { display: flex; flex-direction: column; gap: 20px; }

  /* ── Atelier card ── */
  .workshop-header  { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
  .workshop-title   { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); }
  .workshop-desc    { font-size: var(--text-sm); color: var(--text-secondary); margin-top: 8px; max-width: 600px; }
  .workshop-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .badge-mt         { margin-top: 6px; display: inline-block; }

  /* ── Table ── */
  .time-range  { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); }
  .mono        { font-family: var(--font-mono); }
  .bold        { font-weight: 700; }
  .row-actions { display: flex; gap: 6px; flex-wrap: wrap; }
  .empty-note  { font-size: var(--text-sm); color: var(--text-muted); font-style: italic; }

  /* ── Tailles boutons ── */
  .btn-sm { font-size: 0.82rem; }
  .btn-xs { font-size: 0.75rem; padding: 5px 10px; min-height: unset; }

  /* ── Modals ── */
  .modal           { border: var(--brutal-border); box-shadow: var(--shadow-xl); padding: 0; background: var(--surface); max-width: 520px; width: 90vw; }
  .modal::backdrop { background: rgba(0,0,0,0.5); }
  .modal-box       { padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .modal-header    { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: var(--brutal-border-thin); }
  .modal-form      { display: flex; flex-direction: column; gap: 14px; }

  /* ── Champs ── */
  .field          { display: flex; flex-direction: column; gap: 6px; }
  .field label    { font-size: var(--text-xs); font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }
  .field input,
  .field textarea,
  .field select   { padding: 10px 13px; font-size: var(--text-base); width: 100%; font-family: var(--font-sans); }
  .field textarea  { resize: vertical; }
  .field-hint      { font-size: var(--text-xs); color: var(--text-muted); }
  .field-group     { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .checkbox-row    { display: flex; align-items: center; gap: 10px; }
  .label-sm        { font-size: var(--text-sm); }
  .form-actions    { display: flex; gap: 10px; margin-top: 4px; }

  /* ── Badge prix ── */
  .badge-price { background: #fef3c7; color: #92400e; font-weight: 700; }

  /* ── Flash ── */
  .flash     { padding: 12px 18px; margin-bottom: 20px; font-size: var(--text-sm); font-weight: 600; border: var(--brutal-border-thin); box-shadow: var(--shadow-sm); }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }
</style>

<script>
  // Ouvre les modals via data-modal-open="id"
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-modal-open]');
    if (btn) {
      const id = btn.getAttribute('data-modal-open');
      const dialog = id ? (document.getElementById(id) as HTMLDialogElement | null) : null;
      dialog?.showModal();
    }
  });

  // Ferme les modals via data-modal-close="id"
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-modal-close]');
    if (btn) {
      const id = btn.getAttribute('data-modal-close');
      const dialog = id ? (document.getElementById(id) as HTMLDialogElement | null) : null;
      dialog?.close();
    }
  });

  // Confirmation avant submit via data-confirm="message"
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-confirm]');
    if (btn) {
      const msg = btn.getAttribute('data-confirm') ?? 'Confirmer ?';
      if (!window.confirm(msg)) e.preventDefault();
    }
  });
</script>