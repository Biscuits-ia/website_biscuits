---
// src/pages/dashboard/admin/candidatures.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved  = Astro.url.searchParams.get('saved')  === '1';
const error  = Astro.url.searchParams.get('error')  ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';

let query = supabase
  .from('recruitment_submissions')
  .select('*')
  .order('created_at', { ascending: false });

if (filter) query = query.eq('status', filter);

const { data: submissions } = await query;

const { data: openSessionsRaw } = await supabase
  .from('recruitment_sessions')
  .select('*')
  .eq('status', 'open')
  .gt('scheduled_at', new Date().toISOString())
  .order('scheduled_at', { ascending: true });

const openSessions = (openSessionsRaw ?? []) as { id: string; title: string; scheduled_at: string; max_candidates: number }[];

const { count: newCount }       = await supabase.from('recruitment_submissions').select('*', { count: 'exact', head: true }).eq('status', 'new');
const { count: reviewingCount } = await supabase.from('recruitment_submissions').select('*', { count: 'exact', head: true }).eq('status', 'reviewing');
const { count: acceptedCount }  = await supabase.from('recruitment_submissions').select('*', { count: 'exact', head: true }).eq('status', 'accepted');
const { count: declinedCount }  = await supabase.from('recruitment_submissions').select('*', { count: 'exact', head: true }).eq('status', 'declined');

const statusLabel: Record<string, string> = {
  new:       'Nouvelle',
  reviewing: 'En examen',
  accepted:  'Acceptée',
  declined:  'Refusée',
};

const statusBadge: Record<string, string> = {
  new:       'badge-warn',
  reviewing: 'badge-info',
  accepted:  'badge-ok',
  declined:  'badge-danger',
};

const availabilityLabel: Record<string, string> = {
  immediat: 'Immédiate',
  '1mois':  'Dans 1 mois',
  '3mois':  'Dans 3 mois',
  '6mois':  'Dans 6 mois',
  autre:    '€ discuter',
};
---

<DashboardLayout title="Candidatures" activePage="candidatures" userName={userName} authResult={result}>

  <div class="page-head">
    <div>
      <h1>Candidatures bénévoles</h1>
      <p class="page-head-sub">Gérez les candidatures reçues via le formulaire de recrutement.</p>
    </div>
    <a href="/dashboard/admin/candidatures/sessions" class="btn btn-primary">Gérer les sessions</a>
  </div>

  {saved && <div class="flash flash-ok" role="alert">✓ Modifications sauvegardées.</div>}
  {error  && <div class="flash flash-err" role="alert">✗ {decodeURIComponent(error)}</div>}

  <!-- Stats rapides -->
  <div class="stats-grid mb-6">
    <div class="stat-card">
      <div class="stat-label">Nouvelles</div>
      <div class="stat-value stat-value--warn">{newCount ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">En examen</div>
      <div class="stat-value stat-value--info">{reviewingCount ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Acceptées</div>
      <div class="stat-value stat-value--ok">{acceptedCount ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Refusées</div>
      <div class="stat-value stat-value--err">{declinedCount ?? 0}</div>
    </div>
  </div>

  <!-- Filtres statut -->
  <div class="filters-bar">
    {['', 'new', 'reviewing', 'accepted', 'declined'].map((s) => (
      <a
        href={s ? `?status=${s}` : '?'}
        class={`btn filter-link ${filter === s ? 'btn-primary' : 'btn-ghost'}`}
      >
        {s === '' ? 'Toutes' : statusLabel[s]}
        {s === 'new'       && newCount       ? ` (${newCount})`       : ''}
        {s === 'reviewing' && reviewingCount ? ` (${reviewingCount})` : ''}
        {s === 'accepted'  && acceptedCount  ? ` (${acceptedCount})`  : ''}
        {s === 'declined'  && declinedCount  ? ` (${declinedCount})`  : ''}
      </a>
    ))}
  </div>

  <!-- Liste des candidatures -->
  <div class="admin-list">
    {submissions && submissions.length > 0 ? submissions.map((s: any) => {
      const date       = new Date(s.created_at);
      const badgeClass = statusBadge[s.status] ?? 'badge-neutral';
      const label      = statusLabel[s.status] ?? s.status;
      const fullName   = `${s.first_name} ${s.last_name}`;

      return (
        <div class="card recruit-card">

          <div class="recruit-header">
            <div class="admin-detail-id">
              <div class="admin-detail-title">{fullName}</div>
              <div class="admin-detail-meta">
                <a href={`mailto:${s.email}`} class="recruit-email">{s.email}</a>
                · {date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                {s.availability && ` · Dispo : ${availabilityLabel[s.availability] ?? s.availability}`}
              </div>
            </div>
            <span class={`badge ${badgeClass}`}>{label}</span>
          </div>

          {s.skills && (
            <div class="recruit-section">
              <div class="recruit-section-label">Compétences</div>
              <div class="recruit-section-body">{s.skills}</div>
            </div>
          )}

          {s.motivation && (
            <div class="recruit-section">
              <div class="recruit-section-label">Motivation</div>
              <div class="recruit-section-body">{s.motivation}</div>
            </div>
          )}

          {s.admin_notes && (
            <div class="admin-notes">
              <div class="admin-notes-header">📝 Notes admin</div>
              <div class="admin-notes-body">{s.admin_notes}</div>
            </div>
          )}

          <!-- Formulaire de gestion -->
          <form method="POST" action="/api/admin/candidatures/update" class="admin-form">
            <input type="hidden" name="submission_id" value={s.id} />

            <div class="admin-form-row">
              <label class="admin-form-label">
                Statut :
              </label>
              <select name="status" class="filter-input admin-select">
                <option value="new"       selected={s.status === 'new'}>Nouvelle</option>
                <option value="reviewing" selected={s.status === 'reviewing'}>En examen</option>
                <option value="accepted"  selected={s.status === 'accepted'}>Acceptée</option>
                <option value="declined"  selected={s.status === 'declined'}>Refusée</option>
              </select>
            </div>

            <div class="field">
              <label>Notes internes</label>
              <textarea
                name="admin_notes"
                rows="2"
                placeholder="Notes internes sur le candidat…"
                class="admin-textarea"
              >{s.admin_notes ?? ''}</textarea>
            </div>

            <div class="admin-actions">
              <button type="submit" class="btn btn-primary btn-sm-text">
                Sauvegarder
              </button>
            </div>
          </form>

          {openSessions.length > 0 && !s.session_id && (
            <form class="admin-form assign-form" data-submission-id={s.id}>
              <div class="admin-form-row">
                <label class="admin-form-label">Affecter à une session :</label>
                <select name="session_id" class="filter-input admin-select" required>
                  <option value="">Choisir une session…</option>
                  {openSessions.map((session) => (
                    <option value={session.id}>
                      {session.title} · {new Date(session.scheduled_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                    </option>
                  ))}
                </select>
                <button type="submit" class="btn btn-primary btn-sm-text">Affecter</button>
              </div>
            </form>
          )}

          {s.session_id && (
            <div class="assigned-badge">
              ✅ Affecté à une session
              <button type="button" class="btn btn-ghost btn-xs js-unassign" data-submission-id={s.id}>Désaffecter</button>
            </div>
          )}

          <!-- Boutons d'action (hors du formulaire) -->
          <div class="admin-actions admin-actions--spaced">
            <a
              href={`mailto:${s.email}?subject=${encodeURIComponent(`Votre candidature chez Biscuits IA`)}`}
              class="btn btn-ghost btn-sm-text"
            >
              ✉ Contacter
            </a>
            <form method="POST" action="/api/admin/candidatures/delete" class="form-inline">
              <input type="hidden" name="submission_id" value={s.id} />
              <button
                type="submit"
                class="btn btn-danger btn-sm-text"
                data-confirm="'Supprimer définitivement cette candidature ?'"
              >
                Supprimer
              </button>
            </form>
          </div>

        </div>
      );
    }) : (
      <div class="card empty-state">
        <p class="empty-icon">📋</p>
        <p>{filter ? `Aucune candidature avec le statut "${statusLabel[filter] ?? filter}".` : 'Aucune candidature pour le moment.'}</p>
      </div>
    )}
  </div>

</DashboardLayout>

<style>
  /* Classes partagees promues dans dashboard.css : .admin-list, .admin-detail-*,
   * .admin-form*, .admin-select, .admin-textarea, .admin-actions*, .filter-link,
   * .stat-value--*. Ne restent ici que les elements propres a cette page. */
  .recruit-email { color: var(--accent); }

  .recruit-card { display: flex; flex-direction: column; gap: 14px; }
  .recruit-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

  .recruit-section { display: flex; flex-direction: column; gap: 4px; }
  .recruit-section-label { font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }
  .recruit-section-body { font-size: var(--text-base); color: var(--text-secondary); line-height: 1.6; white-space: pre-wrap; }

  .admin-notes { background: var(--accent-light); border: var(--brutal-border-thin); border-left: 4px solid var(--accent); padding: 12px 16px; display: flex; flex-direction: column; gap: 6px; }
  .admin-notes-header { font-size: var(--text-sm); font-weight: 700; color: var(--accent-dark); }
  .admin-notes-body { font-size: var(--text-base); color: var(--text-primary); line-height: 1.6; }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: var(--text-xs); font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }
  .field textarea { padding: 10px 13px; font-size: var(--text-base); width: 100%; }

  .flash { padding: 12px 18px; margin-bottom: 20px; font-size: var(--text-sm); font-weight: 600; border: var(--brutal-border-thin); box-shadow: var(--shadow-sm); }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }

  .assign-form { margin-top: 8px; padding-top: 12px; border-top: var(--brutal-border-thin); }
  .assigned-badge { display: inline-flex; align-items: center; gap: 10px; margin-top: 8px; padding: 8px 12px; background: var(--ok-bg); color: var(--ok-fg); border: 1px solid var(--ok); font-size: var(--text-sm); }
</style>

<script>
  document.querySelectorAll('.assign-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;

      const submissionId = form.getAttribute('data-submission-id');
      const fd = new FormData(form);
      const sessionId = String(fd.get('session_id') ?? '');
      if (!submissionId || !sessionId) return;

      const res = await fetch(`/api/admin/recruitment-sessions/${sessionId}/assign`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ submission_id: submissionId }),
      });

      if (!res.ok) {
        const out = await res.json().catch(() => ({ error: 'Erreur' }));
        alert(out.error ?? 'Erreur lors de l\'affectation');
        return;
      }

      window.location.reload();
    });
  });

  document.querySelectorAll('.js-unassign').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const submissionId = btn.getAttribute('data-submission-id');
      if (!submissionId) return;
      if (!confirm('Retirer ce candidat de sa session ?')) return;

      // On n'a pas l'ID de session ici : l'API assign DELETE le retrouve via eq session_id.
      // On utilise une route dédiée de désaffectation.
      const res = await fetch('/api/admin/candidatures/unassign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ submission_id: submissionId }),
      });

      if (!res.ok) {
        alert('Erreur lors de la désaffectation.');
        return;
      }

      window.location.reload();
    });
  });
</script>
