---
// src/pages/dashboard/admin/candidatures.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved  = Astro.url.searchParams.get('saved')  === '1';
const error  = Astro.url.searchParams.get('error')  ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';

let query = supabase
  .from('recruitment_submissions')
  .select('*')
  .order('created_at', { ascending: false });

if (filter) query = query.eq('status', filter);

const { data: submissions } = await query;

const { count: newCount }       = await supabase.from('recruitment_submissions').select('*', { count: 'exact', head: true }).eq('status', 'new');
const { count: reviewingCount } = await supabase.from('recruitment_submissions').select('*', { count: 'exact', head: true }).eq('status', 'reviewing');
const { count: acceptedCount }  = await supabase.from('recruitment_submissions').select('*', { count: 'exact', head: true }).eq('status', 'accepted');
const { count: declinedCount }  = await supabase.from('recruitment_submissions').select('*', { count: 'exact', head: true }).eq('status', 'declined');

const statusLabel: Record<string, string> = {
  new:       'Nouvelle',
  reviewing: 'En examen',
  accepted:  'Acceptée',
  declined:  'Refusée',
};

const statusBadge: Record<string, string> = {
  new:       'badge-warn',
  reviewing: 'badge-info',
  accepted:  'badge-ok',
  declined:  'badge-danger',
};

const availabilityLabel: Record<string, string> = {
  immediat: 'Immédiate',
  '1mois':  'Dans 1 mois',
  '3mois':  'Dans 3 mois',
  '6mois':  'Dans 6 mois',
  autre:    'À discuter',
};
---

<DashboardLayout title="Candidatures" role="admin" activePage="candidatures" userName={userName} authResult={result}>

  <div style="margin-bottom: 28px;">
    <h1>Candidatures bénévoles</h1>
    <p style="margin-top: 6px;">Gérez les candidatures reçues via le formulaire de recrutement.</p>
  </div>

  {saved && <div class="flash flash-ok" role="alert">✓ Modifications sauvegardées.</div>}
  {error  && <div class="flash flash-err" role="alert">✗ {decodeURIComponent(error)}</div>}

  <!-- Stats rapides -->
  <div class="stats-grid mb-6">
    <div class="stat-card">
      <div class="stat-label">Nouvelles</div>
      <div class="stat-value" style="color: var(--warn);">{newCount ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">En examen</div>
      <div class="stat-value" style="color: var(--info);">{reviewingCount ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Acceptées</div>
      <div class="stat-value" style="color: var(--ok);">{acceptedCount ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Refusées</div>
      <div class="stat-value" style="color: var(--err, #e53935);">{declinedCount ?? 0}</div>
    </div>
  </div>

  <!-- Filtres statut -->
  <div class="filters-bar">
    {['', 'new', 'reviewing', 'accepted', 'declined'].map((s) => (
      <a
        href={s ? `?status=${s}` : '?'}
        class={`btn ${filter === s ? 'btn-primary' : 'btn-ghost'}`}
        style="font-size: 0.82rem;"
      >
        {s === '' ? 'Toutes' : statusLabel[s]}
        {s === 'new'       && newCount       ? ` (${newCount})`       : ''}
        {s === 'reviewing' && reviewingCount ? ` (${reviewingCount})` : ''}
        {s === 'accepted'  && acceptedCount  ? ` (${acceptedCount})`  : ''}
        {s === 'declined'  && declinedCount  ? ` (${declinedCount})`  : ''}
      </a>
    ))}
  </div>

  <!-- Liste des candidatures -->
  <div style="display: flex; flex-direction: column; gap: 16px;">
    {submissions && submissions.length > 0 ? submissions.map((s: any) => {
      const date       = new Date(s.created_at);
      const badgeClass = statusBadge[s.status] ?? 'badge-neutral';
      const label      = statusLabel[s.status] ?? s.status;
      const fullName   = `${s.first_name} ${s.last_name}`;

      return (
        <div class="card recruit-card">

          <div class="recruit-header">
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary);">{fullName}</div>
              <div style="font-size: var(--text-xs); font-family: var(--font-mono); color: var(--text-muted); margin-top: 3px;">
                <a href={`mailto:${s.email}`} style="color: var(--accent);">{s.email}</a>
                · {date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                {s.availability && ` · Dispo : ${availabilityLabel[s.availability] ?? s.availability}`}
              </div>
            </div>
            <span class={`badge ${badgeClass}`}>{label}</span>
          </div>

          {s.skills && (
            <div class="recruit-section">
              <div class="recruit-section-label">Compétences</div>
              <div class="recruit-section-body">{s.skills}</div>
            </div>
          )}

          {s.motivation && (
            <div class="recruit-section">
              <div class="recruit-section-label">Motivation</div>
              <div class="recruit-section-body">{s.motivation}</div>
            </div>
          )}

          {s.admin_notes && (
            <div class="admin-notes">
              <div class="admin-notes-header">📝 Notes admin</div>
              <div class="admin-notes-body">{s.admin_notes}</div>
            </div>
          )}

          <!-- Formulaire de gestion -->
          <form method="POST" action="/api/admin/candidatures/update" style="display: flex; flex-direction: column; gap: 12px; padding-top: 14px; border-top: var(--brutal-border-thin);">
            <input type="hidden" name="submission_id" value={s.id} />

            <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
              <label style="font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); font-family: var(--font-mono); text-transform: uppercase;">
                Statut :
              </label>
              <select name="status" class="filter-input" style="min-height: unset; padding: 6px 10px;">
                <option value="new"       selected={s.status === 'new'}>Nouvelle</option>
                <option value="reviewing" selected={s.status === 'reviewing'}>En examen</option>
                <option value="accepted"  selected={s.status === 'accepted'}>Acceptée</option>
                <option value="declined"  selected={s.status === 'declined'}>Refusée</option>
              </select>
            </div>

            <div class="field">
              <label>Notes internes</label>
              <textarea
                name="admin_notes"
                rows="2"
                placeholder="Notes internes sur le candidat…"
                style="resize: vertical; font-family: var(--font-sans);"
              >{s.admin_notes ?? ''}</textarea>
            </div>

            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button type="submit" class="btn btn-primary" style="font-size: 0.85rem;">
                Sauvegarder
              </button>
              <a
                href={`mailto:${s.email}?subject=${encodeURIComponent(`Votre candidature chez Biscuits IA`)}`}
                class="btn btn-ghost"
                style="font-size: 0.85rem;"
              >
                ✉ Contacter
              </a>
              <form method="POST" action="/api/admin/candidatures/delete" style="display: inline;">
                <input type="hidden" name="submission_id" value={s.id} />
                <button
                  type="submit"
                  class="btn btn-danger"
                  style="font-size: 0.85rem;"
                  onclick="return confirm('Supprimer définitivement cette candidature ?')"
                >
                  Supprimer
                </button>
              </form>
            </div>
          </form>

        </div>
      );
    }) : (
      <div class="card" style="text-align: center; padding: 48px 24px;">
        <p style="font-size: 1.5rem; margin-bottom: 8px;">📋</p>
        <p>{filter ? `Aucune candidature avec le statut "${statusLabel[filter] ?? filter}".` : 'Aucune candidature pour le moment.'}</p>
      </div>
    )}
  </div>

</DashboardLayout>

<style>
  .recruit-card { display: flex; flex-direction: column; gap: 14px; }
  .recruit-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

  .recruit-section { display: flex; flex-direction: column; gap: 4px; }
  .recruit-section-label { font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }
  .recruit-section-body { font-size: var(--text-base); color: var(--text-secondary); line-height: 1.6; white-space: pre-wrap; }

  .admin-notes { background: var(--accent-light); border: var(--brutal-border-thin); border-left: 4px solid var(--accent); padding: 12px 16px; display: flex; flex-direction: column; gap: 6px; }
  .admin-notes-header { font-size: var(--text-sm); font-weight: 700; color: var(--accent-dark); }
  .admin-notes-body { font-size: var(--text-base); color: var(--text-primary); line-height: 1.6; }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: var(--text-xs); font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }
  .field textarea { padding: 10px 13px; font-size: var(--text-base); width: 100%; }

  .flash { padding: 12px 18px; margin-bottom: 20px; font-size: var(--text-sm); font-weight: 600; border: var(--brutal-border-thin); box-shadow: var(--shadow-sm); }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }
</style>
