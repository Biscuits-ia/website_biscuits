---
// src/pages/dashboard/admin/candidatures/sessions/[id].astro
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdmin } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';
import { formatDateTimeLong } from '@/lib/dateHelpers';
import type { RecruitmentSession, RecruitmentSubmission } from '@/types/recruitment';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user } = result;
const adminSupabase = createSupabaseAdminClient();
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const sessionId = Astro.params.id ?? '';
if (!sessionId) return Astro.redirect('/dashboard/admin/candidatures/sessions');

const [
  { data: sessionRaw, error: sessionError },
  { data: candidatesRaw },
  { data: availableCandidatesRaw },
] = await Promise.all([
  adminSupabase.from('recruitment_sessions').select('*').eq('id', sessionId).single(),
  adminSupabase
    .from('recruitment_submissions')
    .select('*')
    .eq('session_id', sessionId)
    .order('created_at', { ascending: false }),
  adminSupabase
    .from('recruitment_submissions')
    .select('*')
    .is('session_id', null)
    .in('status', ['new', 'reviewing'])
    .order('created_at', { ascending: false })
    .limit(100),
]);

if (sessionError || !sessionRaw) {
  return Astro.redirect('/dashboard/admin/candidatures/sessions');
}

const session = sessionRaw as unknown as RecruitmentSession;
const candidates = (candidatesRaw ?? []) as unknown as RecruitmentSubmission[];
const availableCandidates = (availableCandidatesRaw ?? []) as unknown as RecruitmentSubmission[];

const activeCount = candidates.filter((c) => c.status !== 'declined').length;
const placesRemaining = Math.max(0, session.max_candidates - activeCount);

const statusLabel: Record<string, string> = {
  new: 'Nouvelle',
  reviewing: 'En examen',
  accepted: 'Acceptée',
  declined: 'Refusée',
};

const statusBadge: Record<string, string> = {
  new: 'badge-warn',
  reviewing: 'badge-info',
  accepted: 'badge-ok',
  declined: 'badge-danger',
};

const sessionStatusLabel: Record<string, string> = {
  open: 'Ouverte',
  closed: 'Fermée',
  cancelled: 'Annulée',
  done: 'Terminée',
};

// Heure de Paris (page SSR, serveur Vercel en UTC).
const formatSessionDate = formatDateTimeLong;
---

<DashboardLayout title={`Session : ${session.title}`} activePage="candidatures" userName={userName} authResult={result}>
  <div class="top mb-6">
    <a href="/dashboard/admin/candidatures/sessions" class="back-link">← Retour aux sessions</a>
    <h1 class="page-title">{session.title}</h1>
    <p class="description">{formatSessionDate(session.scheduled_at)} · {session.duration_minutes} min · {sessionStatusLabel[session.status] ?? session.status}</p>
  </div>

  <div class="grid">
    <section class="card">
      <h2 class="card-title">Détails de la session</h2>
      <div class="brief-list">
        <div><strong>Statut :</strong> {sessionStatusLabel[session.status] ?? session.status}</div>
        <div><strong>Date :</strong> {formatSessionDate(session.scheduled_at)}</div>
        <div><strong>Durée :</strong> {session.duration_minutes} minutes</div>
        <div><strong>Places :</strong> {activeCount} / {session.max_candidates} ({placesRemaining} restante{placesRemaining > 1 ? 's' : ''})</div>
        <div><strong>Lieu/Lien :</strong> {session.location ?? '—'}</div>
      </div>
      {session.description && <p class="brief-text mt-4">{session.description}</p>}
    </section>

    <section class="card">
      <h2 class="card-title">Affecter un candidat</h2>
      {availableCandidates.length === 0 ? (
        <p class="muted">Aucun candidat disponible à affecter.</p>
      ) : (
        <form id="form-add-candidate" class="row-form">
          <select name="submission_id" class="input" required>
            <option value="">Choisir une candidature…</option>
            {availableCandidates.map((c) => (
              <option value={c.id}>{c.first_name} {c.last_name} ({c.email})</option>
            ))}
          </select>
          <button type="submit" class="btn btn-primary btn-sm" disabled={placesRemaining === 0}>
            {placesRemaining === 0 ? 'Session pleine' : 'Affecter'}
          </button>
        </form>
      )}
    </section>
  </div>

  <section class="card mt-6">
    <h2 class="card-title">Candidats inscrits ({candidates.length})</h2>
    {candidates.length === 0 ? (
      <p class="empty-state">Aucun candidat n’est affecté à cette session.</p>
    ) : (
      <ul class="candidate-list">
        {candidates.map((c) => (
          <li class="candidate-item" data-id={c.id}>
            <div class="candidate-main">
              <div class="candidate-name">
                {c.first_name} {c.last_name}
                <span class={`badge ${statusBadge[c.status] ?? 'badge-neutral'}`}>{statusLabel[c.status] ?? c.status}</span>
              </div>
              <div class="candidate-meta">
                <a href={`mailto:${c.email}`} class="candidate-email">{c.email}</a>
                · {new Date(c.created_at).toLocaleDateString('fr-FR')}
              </div>
              {c.skills && <div class="candidate-skills">🛠 {c.skills}</div>}
              {c.motivation && <div class="candidate-motivation">💬 {c.motivation}</div>}
              {c.admin_notes && <div class="candidate-notes">📝 {c.admin_notes}</div>}
            </div>
            <div class="candidate-actions">
              <a href={`mailto:${c.email}?subject=${encodeURIComponent(`Votre session de recrutement Biscuits IA`)}`} class="btn btn-ghost btn-xs">Contacter</a>
              <button type="button" class="btn btn-ghost btn-xs js-remove" data-id={c.id}>Retirer</button>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</DashboardLayout>

<style>
  .top { display: flex; flex-direction: column; gap: 8px; }
  .back-link { color: var(--accent); text-decoration: none; font-size: var(--text-xs); }
  .back-link:hover { text-decoration: underline; }
  .page-title { font-size: var(--text-xl); font-weight: 700; }

  .grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-lg); }
  .card { border: var(--brutal-border-thin); background: var(--surface-raised); padding: var(--space-md); }
  .card-title { margin: 0 0 var(--space-sm); font-size: var(--text-base); font-weight: 700; }

  .brief-list { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; font-size: var(--text-xs); }
  .brief-text { margin: 0; color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.6; white-space: pre-wrap; }
  .mt-4 { margin-top: var(--space-sm); }

  .row-form { display: flex; gap: 8px; align-items: center; }
  .input { border: var(--brutal-border-thin); background: var(--surface); padding: 6px 8px; font-size: var(--text-xs); }

  .candidate-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
  .candidate-item { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-md); padding: var(--space-sm); border: var(--brutal-border-thin); }
  .candidate-main { display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .candidate-name { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: var(--text-sm); }
  .candidate-meta { font-size: var(--text-xs); color: var(--text-muted); }
  .candidate-email { color: var(--accent); text-decoration: none; }
  .candidate-email:hover { text-decoration: underline; }
  .candidate-skills, .candidate-motivation, .candidate-notes { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.5; white-space: pre-wrap; }
  .candidate-notes { background: var(--accent-light); padding: 6px 8px; border-left: 3px solid var(--accent); }
  .candidate-actions { display: flex; flex-direction: column; gap: 6px; }

  .empty-state { color: var(--text-muted); font-size: var(--text-sm); }
  .muted { color: var(--text-muted); font-size: var(--text-xs); }
  .mt-6 { margin-top: var(--space-xl); }
  .mb-6 { margin-bottom: var(--space-xl); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .candidate-item { flex-direction: column; }
    .candidate-actions { flex-direction: row; }
    .row-form { flex-direction: column; align-items: stretch; }
    .brief-list { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ sessionId }} nonce={Astro.locals.nonce}>
  // Toast / modale montes globalement par DashboardLayout ; repli sur les
  // primitives natives si la page est rendue sans ce layout.
  function toast(msg, type) {
    if (typeof window.showToast === 'function') window.showToast(msg, type);
    else alert(msg);
  }

  function confirmAction(options) {
    if (typeof window.showConfirm === 'function') return window.showConfirm(options);
    return Promise.resolve(window.confirm(options.message));
  }

  const addForm = document.getElementById('form-add-candidate');

  addForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(addForm instanceof HTMLFormElement)) return;

    const fd = new FormData(addForm);
    const submissionId = String(fd.get('submission_id') ?? '');
    if (!submissionId) return;

    const submitBtn = addForm.querySelector('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    try {
      const res = await fetch(`/api/admin/recruitment-sessions/${sessionId}/assign`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ submission_id: submissionId }),
      });

      if (!res.ok) {
        const out = await res.json().catch(() => ({ error: 'Erreur' }));
        toast(out.error ?? 'Erreur lors de l\'affectation', 'error');
        return;
      }

      window.location.reload();
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  document.querySelectorAll('.js-remove').forEach((el) => {
    el.addEventListener('click', async () => {
      const submissionId = el.getAttribute('data-id');
      if (!submissionId) return;

      const ok = await confirmAction({
        title: 'Retirer ce candidat',
        message: 'Le candidat sera retiré de cette session et recevra un email l\'en informant. Sa candidature reste enregistrée.',
        confirmLabel: 'Retirer',
        danger: true,
      });
      if (!ok) return;

      const res = await fetch(`/api/admin/recruitment-sessions/${sessionId}/assign`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ submission_id: submissionId }),
      });

      if (!res.ok) {
        const out = await res.json().catch(() => ({ error: 'Erreur lors du retrait.' }));
        toast(out.error ?? 'Erreur lors du retrait.', 'error');
        return;
      }

      window.location.reload();
    });
  });
</script>
