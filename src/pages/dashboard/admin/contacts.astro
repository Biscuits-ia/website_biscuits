---
// src/pages/dashboard/admin/contacts.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved  = Astro.url.searchParams.get('saved')  === '1';
const error  = Astro.url.searchParams.get('error')  ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';

// Borne de securite : contact_submissions grossit sans plafond (formulaire
// public). Sans limite, cette page SSR se degrade lineairement avec le volume,
// sans aucun signal avant la panne. LIST_CAP + 1 lignes sont demandees pour
// savoir si la liste est tronquee et le dire a l'admin, plutot que de perdre
// des messages en silence. La vraie correction reste la pagination : le
// gabarit existe deja dans logs.astro, users.astro et user/activity.astro.
const LIST_CAP = 200;

let query = supabase
  .from('contact_submissions')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(LIST_CAP + 1);

if (filter) query = query.eq('status', filter);

const { data: contactsRaw } = await query;
const isTruncated = (contactsRaw?.length ?? 0) > LIST_CAP;
const contacts = (contactsRaw ?? []).slice(0, LIST_CAP);

const { count: newCount }      = await supabase.from('contact_submissions').select('*', { count: 'exact', head: true }).eq('status', 'new');
const { count: readCount }     = await supabase.from('contact_submissions').select('*', { count: 'exact', head: true }).eq('status', 'read');
const { count: repliedCount }  = await supabase.from('contact_submissions').select('*', { count: 'exact', head: true }).eq('status', 'replied');
const { count: archivedCount } = await supabase.from('contact_submissions').select('*', { count: 'exact', head: true }).eq('status', 'archived');

const statusLabel: Record<string, string> = {
  new:      'Nouveau',
  read:     'Lu',
  replied:  'Répondu',
  archived: 'Archivé',
};

const statusBadge: Record<string, string> = {
  new:      'badge-warn',
  read:     'badge-info',
  replied:  'badge-ok',
  archived: 'badge-neutral',
};

type Contact = {
  id: string;
  subject: string;
  name: string;
  email: string;
  message: string;
  status: string;
  admin_notes: string | null;
  created_at: string;
};

const typedContacts: Contact[] = (contacts ?? []) as Contact[];
---

<DashboardLayout title="Contacts" activePage="contacts" userName={userName} authResult={result}>

  <!-- En-tête -->
  <div class="page-header">
    <div>
      <h1 class="page-title">Messages de contact</h1>
      <p class="page-subtitle">Gérez les messages reçus via le formulaire de contact.</p>
    </div>
  </div>

  {saved && <div class="flash flash-ok" role="alert">✓ Modifications sauvegardées.</div>}
  {error  && <div class="flash flash-err" role="alert">✗ {decodeURIComponent(error)}</div>}
  {isTruncated && (
    <div class="flash flash-warn" role="status">
      Liste tronquée aux {LIST_CAP} messages les plus récents. Filtrez par statut pour voir les autres.
    </div>
  )}

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card stat-warn">
      <div class="stat-value">{newCount ?? 0}</div>
      <div class="stat-label">Nouveaux</div>
    </div>
    <div class="stat-card stat-info">
      <div class="stat-value">{readCount ?? 0}</div>
      <div class="stat-label">Lus</div>
    </div>
    <div class="stat-card stat-ok">
      <div class="stat-value">{repliedCount ?? 0}</div>
      <div class="stat-label">Répondus</div>
    </div>
    <div class="stat-card stat-neutral">
      <div class="stat-value">{archivedCount ?? 0}</div>
      <div class="stat-label">Archivés</div>
    </div>
  </div>

  <!-- Filtres -->
  <div class="filters-bar">
    {['', 'new', 'read', 'replied', 'archived'].map((s) => (
      <a
        href={s ? `?status=${s}` : '?'}
        class={`filter-btn ${filter === s ? 'filter-active' : ''}`}
      >
        {s === '' ? 'Tous' : statusLabel[s]}
        {s === 'new'      && newCount      ? <span class="filter-count">{newCount}</span>      : ''}
        {s === 'read'     && readCount     ? <span class="filter-count">{readCount}</span>     : ''}
        {s === 'replied'  && repliedCount  ? <span class="filter-count">{repliedCount}</span>  : ''}
        {s === 'archived' && archivedCount ? <span class="filter-count">{archivedCount}</span> : ''}
      </a>
    ))}
  </div>

  <!-- Liste des contacts -->
  <div class="contacts-list">
    {typedContacts.length > 0 ? typedContacts.map((c) => {
      const date       = new Date(c.created_at);
      const status     = c.status;
      const badgeClass = statusBadge[status] ?? 'badge-neutral';
      const label      = statusLabel[status] ?? status;
      const subject    = c.subject;
      const name       = c.name;
      const email      = c.email;
      const message    = c.message;
      const adminNotes = c.admin_notes;
      const id         = c.id;

      return (
        <div class="contact-card">

          <!-- Bandeau supérieur : sujet + badge -->
          <div class="card-top">
            <div class="card-subject-wrap">
              <span class={`status-dot dot-${status}`}></span>
              <span class="card-subject">{subject}</span>
            </div>
            <span class={`badge ${badgeClass}`}>{label}</span>
          </div>

          <!-- Meta : nom · email · date -->
          <div class="card-meta">
            <span class="meta-name">👤 {name}</span>
            <span class="meta-sep">·</span>
            <a href={`mailto:${email}`} class="meta-email">{email}</a>
            <span class="meta-sep">·</span>
            <span class="meta-date">
              {date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          </div>

          <!-- Corps du message -->
          <div class="card-message">{message}</div>

          {adminNotes && (
            <div class="admin-notes">
              <div class="admin-notes-header">📝 Notes admin</div>
              <div class="admin-notes-body">{adminNotes}</div>
            </div>
          )}

          <!-- Zone d'action -->
          <div class="action-form">
            <form method="POST" action="/api/admin/contacts/update">
              <input type="hidden" name="contact_id" value={id} />

              <div class="action-row">
                <!-- Statut -->
                <div class="select-wrap">
                  <label class="select-label">Statut</label>
                  <select name="status" class="status-select">
                    <option value="new"      selected={status === 'new'}>🔵 Nouveau</option>
                    <option value="read"     selected={status === 'read'}>👁 Lu</option>
                    <option value="replied"  selected={status === 'replied'}>✅ Répondu</option>
                    <option value="archived" selected={status === 'archived'}>📦 Archivé</option>
                  </select>
                </div>

                <!-- Notes internes -->
                <div class="notes-wrap">
                  <label class="select-label">Notes internes</label>
                  <textarea
                    name="admin_notes"
                    rows="2"
                    placeholder="Notes internes (non visibles par l'expéditeur)…"
                    class="notes-textarea"
                  >{adminNotes ?? ''}</textarea>
                </div>
              </div>

              <!-- Boutons d'action -->
              <div class="action-btns">
                <button type="submit" class="action-btn btn-save">
                  💾 Sauvegarder
                </button>
                <a
                  href={`mailto:${email}?subject=Re: ${encodeURIComponent(subject)}`}
                  class="action-btn btn-reply"
                >
                  ✉ Répondre
                </a>
              </div>
            </form>

            {/* Suppression : form indépendant (HTML n'autorise pas les forms imbriqués) */}
            <form method="POST" action="/api/admin/contacts/delete" class="delete-form">
              <input type="hidden" name="contact_id" value={id} />
              <button
                type="submit"
                class="action-btn btn-delete"
                data-confirm="'Supprimer définitivement ce message ?'"
              >
                🗑 Supprimer
              </button>
            </form>
          </div>

        </div>
      );
    }) : (
      <div class="empty-state">
        <p class="empty-icon">📭</p>
        <p class="empty-text">
          {filter ? `Aucun message avec le statut "${statusLabel[filter] ?? filter}".` : 'Aucun message de contact pour le moment.'}
        </p>
      </div>
    )}
  </div>

</DashboardLayout>

<style>
  /* ── Page header ── */
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 16px;
  }
  .page-title   { font-size: 1.75rem; font-weight: 900; margin: 0; }
  .page-subtitle { color: var(--text-muted); margin: 6px 0 0; font-size: var(--text-sm); }

  /* ── Flash ── */
  .flash { padding: 14px 20px; margin-bottom: 22px; font-size: var(--text-sm); font-weight: 700; border: 2px solid; box-shadow: 3px 3px 0 currentColor; }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }
  .flash-warn { background: var(--warn-bg); color: var(--warn-fg); border-color: var(--warn); }

  /* ── Stats ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 28px;
  }
  .stat-card {
    padding: 18px 20px;
    border: 2px solid var(--color-border);
    box-shadow: 4px 4px 0 var(--color-border);
    background: #fff;
    text-align: center;
  }
  .stat-value { font-size: 2rem; font-weight: 900; line-height: 1; }
  .stat-label { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); margin-top: 6px; }
  .stat-warn   .stat-value { color: #d97706; }
  .stat-info   .stat-value { color: #2563eb; }
  .stat-ok     .stat-value { color: #16a34a; }
  .stat-neutral .stat-value { color: var(--text-muted); }

  /* ── Filtres ── */
  .filters-bar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    font-size: var(--text-sm);
    font-weight: 700;
    border: 2px solid var(--color-border);
    box-shadow: 3px 3px 0 var(--color-border);
    background: #fff;
    text-decoration: none;
    color: var(--text-primary);
    transition: transform .1s, box-shadow .1s;
  }
  .filter-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--color-border);
  }
  .filter-active {
    background: var(--color-primary, #000);
    color: #fff;
    border-color: var(--color-primary, #000);
    box-shadow: 3px 3px 0 #555;
  }
  .filter-count {
    background: rgba(255,255,255,.25);
    color: inherit;
    border-radius: 99px;
    padding: 1px 7px;
    font-size: .75rem;
    font-weight: 800;
  }
  .filter-active .filter-count { background: rgba(255,255,255,.3); }

  /* ── Liste ── */
  .contacts-list { display: flex; flex-direction: column; gap: 20px; }

  /* ── Carte ── */
  .contact-card {
    background: #fff;
    border: 2px solid var(--color-border);
    box-shadow: 5px 5px 0 var(--color-border);
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .card-subject-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid currentColor;
  }
  .dot-new      { background: #fde68a; color: #d97706; }
  .dot-read     { background: #bfdbfe; color: #2563eb; }
  .dot-replied  { background: #bbf7d0; color: #16a34a; }
  .dot-archived { background: #e5e7eb; color: #6b7280; }

  .card-subject { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
  .meta-name   { font-weight: 600; }
  .meta-sep    { opacity: .4; }
  .meta-email  { color: var(--accent, #2563eb); text-decoration: none; font-weight: 600; }
  .meta-email:hover { text-decoration: underline; }

  .card-message {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.65;
    white-space: pre-wrap;
    background: #fafafa;
    border: 1px solid #e5e7eb;
    padding: 14px 16px;
  }

  .admin-notes {
    background: var(--accent-light, #eff6ff);
    border: 2px solid var(--accent, #2563eb);
    border-left: 5px solid var(--accent, #2563eb);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .admin-notes-header { font-size: var(--text-xs); font-weight: 800; color: var(--accent-dark, #1e40af); text-transform: uppercase; letter-spacing: .06em; }
  .admin-notes-body   { font-size: var(--text-base); color: var(--text-primary); line-height: 1.6; }

  /* ── Formulaire d'action ── */
  .action-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 18px;
    border-top: 2px solid #e5e7eb;
  }

  .action-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px;
    align-items: start;
  }

  .select-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 6px;
  }

  .status-select {
    width: 100%;
    padding: 10px 12px;
    font-size: var(--text-sm);
    font-weight: 600;
    border: 2px solid var(--color-border);
    box-shadow: 3px 3px 0 var(--color-border);
    background: #fff;
    cursor: pointer;
    appearance: auto;
  }
  .status-select:focus {
    outline: none;
    border-color: var(--color-primary, #000);
  }

  .notes-wrap { display: flex; flex-direction: column; }
  .notes-textarea {
    width: 100%;
    padding: 10px 13px;
    font-size: var(--text-base);
    font-family: var(--font-sans);
    border: 2px solid var(--color-border);
    box-shadow: 3px 3px 0 var(--color-border);
    resize: vertical;
    background: #fff;
  }
  .notes-textarea:focus {
    outline: none;
    border-color: var(--color-primary, #000);
  }

  /* ── Boutons d'action ── */
  .action-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 13px 24px;
    font-size: 0.95rem;
    font-weight: 800;
    border: 2px solid;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: transform .1s, box-shadow .1s;
    min-width: 148px;
    justify-content: center;
  }
  .action-btn:hover {
    transform: translate(-2px, -2px);
  }

  .btn-save {
    background: #000;
    color: #fff;
    border-color: #000;
    box-shadow: 4px 4px 0 #333;
  }
  .btn-save:hover { box-shadow: 6px 6px 0 #333; }

  .btn-reply {
    background: #fff;
    color: #2563eb;
    border-color: #2563eb;
    box-shadow: 4px 4px 0 #2563eb;
  }
  .btn-reply:hover { box-shadow: 6px 6px 0 #2563eb; }

  .btn-delete {
    background: #fff;
    color: #dc2626;
    border-color: #dc2626;
    box-shadow: 4px 4px 0 #dc2626;
  }
  .btn-delete:hover { box-shadow: 6px 6px 0 #dc2626; }

  /* ── Empty state ── */
  .empty-state {
    background: #fff;
    border: 2px dashed var(--color-border);
    padding: 56px 24px;
    text-align: center;
  }
  .empty-icon { font-size: 2.5rem; margin: 0 0 12px; }
  .empty-text { color: var(--text-muted); font-size: var(--text-base); }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .action-row { grid-template-columns: 1fr; }
    .action-btn { min-width: unset; width: 100%; }
    .contact-card { padding: 18px 16px; }
  }
</style>
