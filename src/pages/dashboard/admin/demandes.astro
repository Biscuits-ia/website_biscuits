---
// src/pages/dashboard/admin/demandes.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved  = Astro.url.searchParams.get('saved')  === '1';
const error  = Astro.url.searchParams.get('error')  ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';

let query = supabase
  .from('requests')
  .select('id, user_id, subject, description, status, admin_reply, created_at, updated_at')
  .order('created_at', { ascending: false });

if (filter) query = query.eq('status', filter);

// PostgREST ne peut pas joindre `auth.users` — on enrichit via `profiles` côté serveur
const { data: requestsRaw } = await query;
const requests = requestsRaw ?? [];

// Lookup profiles des users concernés
const adminSupabase = createSupabaseAdminClient();
const userIds = [...new Set(requests.map((r: { user_id: string }) => r.user_id).filter(Boolean))];
const profileMap: Record<string, { full_name: string | null; email: string | null }> = {};
if (userIds.length > 0) {
  const { data: profilesRaw } = await adminSupabase
    .from('profiles')
    .select('id, full_name, email')
    .in('id', userIds);
  for (const p of profilesRaw ?? []) profileMap[p.id] = p;
}

const { count: pending }     = await supabase.from('requests').select('*', { count: 'exact', head: true }).eq('status', 'pending');
const { count: in_progress } = await supabase.from('requests').select('*', { count: 'exact', head: true }).eq('status', 'in_progress');
const { count: resolved }    = await supabase.from('requests').select('*', { count: 'exact', head: true }).eq('status', 'resolved');

const statusLabel: Record<string, string> = {
  pending:     'En attente',
  in_progress: 'En cours',
  resolved:    'Résolu',
};

const statusBadge: Record<string, string> = {
  pending:     'badge-warn',
  in_progress: 'badge-info',
  resolved:    'badge-ok',
};
---

<DashboardLayout title="Demandes" activePage="demandes" userName={userName} authResult={result}>

  <div class="page-head">
    <h1>Gestion des demandes</h1>
    <p class="page-head-sub">Répondez aux demandes d'accompagnement des membres.</p>
  </div>

  {saved && <div class="flash flash-ok" role="alert">✓ Modifications sauvegardées.</div>}
  {error  && <div class="flash flash-err" role="alert">✗ {decodeURIComponent(error)}</div>}

  <!-- Stats rapides -->
  <div class="stats-grid mb-6">
    <div class="stat-card">
      <div class="stat-label">En attente</div>
      <div class="stat-value stat-value--warn">{pending ?? 0}</div>
      <div class="stat-delta">€ traiter</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">En cours</div>
      <div class="stat-value stat-value--info">{in_progress ?? 0}</div>
      <div class="stat-delta">En traitement</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Résolues</div>
      <div class="stat-value stat-value--ok">{resolved ?? 0}</div>
      <div class="stat-delta">Terminées</div>
    </div>
  </div>

  <!-- Filtres statut -->
  <div class="filters-bar">
    {['', 'pending', 'in_progress', 'resolved'].map((s) => (
      <a
        href={s ? `?status=${s}` : '?'}
        class={`btn filter-link ${filter === s ? 'btn-primary' : 'btn-ghost'}`}
      >
        {s === ''           ? 'Toutes'      : statusLabel[s]}
        {s === 'pending'    && pending     ? ` (${pending})`     : ''}
        {s === 'in_progress'&& in_progress ? ` (${in_progress})` : ''}
        {s === 'resolved'   && resolved    ? ` (${resolved})`    : ''}
      </a>
    ))}
  </div>

  <!-- Liste des demandes -->
  <div class="admin-list">
    {requests.length > 0 ? requests.map((req: any) => {
      const date      = new Date(req.created_at);
      const badgeClass = statusBadge[req.status] ?? 'badge-neutral';
      const label      = statusLabel[req.status] ?? req.status;
      const profile    = profileMap[req.user_id];
      const requester  = profile?.full_name ?? profile?.email ?? `Utilisateur ${req.user_id.slice(0, 8)}…`;

      return (
        <div class="card request-admin-card">

          <div class="request-header">
            <div class="admin-detail-id">
              <div class="admin-detail-title">{req.subject}</div>
              <div class="admin-detail-meta">
                {date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                · par <span class="request-by">{requester}</span>
              </div>
            </div>
            <span class={`badge ${badgeClass}`}>{label}</span>
          </div>

          <div class="request-body">{req.description}</div>

          {req.admin_reply && (
            <div class="admin-reply">
              <div class="admin-reply-header">💬 Réponse envoyée</div>
              <div class="admin-reply-body">{req.admin_reply}</div>
            </div>
          )}

          {/* Formulaire de réponse / changement statut */}
          <form method="POST" action="/api/admin/demandes/repondre" class="admin-form">
            <input type="hidden" name="request_id" value={req.id} />

            <div class="admin-form-row">
              <label class="admin-form-label">
                Changer le statut :
              </label>
              <select name="status" class="filter-input admin-select">
                <option value="pending"     selected={req.status === 'pending'}>En attente</option>
                <option value="in_progress" selected={req.status === 'in_progress'}>En cours</option>
                <option value="resolved"    selected={req.status === 'resolved'}>Résolu</option>
              </select>
            </div>

            <div class="field">
              <label>Réponse à l'utilisateur</label>
              <textarea
                name="admin_reply"
                rows="3"
                placeholder="Votre réponse visible par l'utilisateur…"
                class="admin-textarea"
              >{req.admin_reply ?? ''}</textarea>
            </div>

            <div class="admin-actions admin-actions--between">
              <button type="submit" class="btn btn-primary btn-sm-text">
                Sauvegarder
              </button>
            </div>
          </form>

          {/* Bouton supprimer — form indépendant (HTML n'autorise pas les forms imbriqués) */}
          <form method="POST" action="/api/admin/demandes/supprimer" class="admin-actions admin-actions--end">
            <input type="hidden" name="request_id" value={req.id} />
            <button
              type="submit"
              class="btn btn-danger btn-sm btn-xs-text"
              data-confirm="'Supprimer définitivement cette demande ?'"
            >
              Supprimer
            </button>
          </form>
        </div>
      );
    }) : (
      <div class="card empty-state">
        <p class="empty-icon">✅</p>
        <p>{filter ? `Aucune demande avec le statut "${statusLabel[filter] ?? filter}".` : 'Aucune demande pour le moment.'}</p>
      </div>
    )}
  </div>

</DashboardLayout>

<style>
  /* Classes partagees dans dashboard.css : .admin-list, .admin-detail-*,
   * .admin-form*, .admin-select, .admin-textarea, .admin-actions*, .filter-link,
   * .stat-value--*, .btn-sm-text, .btn-xs-text. Ici : specifiques a la page. */
  .request-by { color: var(--text-secondary); }

  .request-admin-card { display: flex; flex-direction: column; gap: 14px; }

  .request-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

  .request-body { font-size: var(--text-base); color: var(--text-secondary); line-height: 1.6; white-space: pre-wrap; }

  .admin-reply { background: var(--accent-light); border: var(--brutal-border-thin); border-left: 4px solid var(--accent); padding: 12px 16px; display: flex; flex-direction: column; gap: 6px; }
  .admin-reply-header { font-size: var(--text-sm); font-weight: 700; color: var(--accent-dark); }
  .admin-reply-body { font-size: var(--text-base); color: var(--text-primary); line-height: 1.6; }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: var(--text-xs); font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }
  .field textarea { padding: 10px 13px; font-size: var(--text-base); width: 100%; }

  .flash { padding: 12px 18px; margin-bottom: 20px; font-size: var(--text-sm); font-weight: 600; border: var(--brutal-border-thin); box-shadow: var(--shadow-sm); }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }
</style>