---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';

type QuestionKind = 'text' | 'textarea' | 'select' | 'checkbox' | 'number';

type StudyQuestion = {
  id: string;
  label: string;
  kind: QuestionKind;
  is_required: boolean;
  position: number;
};

type StudyForm = {
  id: string;
  title: string;
  description: string | null;
  status: 'draft' | 'published';
  created_at: string;
  study_form_questions: StudyQuestion[];
};

type StudySubmission = {
  form_id: string;
};

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error') ?? '';

const { data: formsRaw } = await supabase
  .from('study_forms')
  .select('id, title, description, status, created_at, study_form_questions(id, label, kind, is_required, position)')
  .order('created_at', { ascending: false });

const { data: submissionsRaw } = await supabase
  .from('study_form_submissions')
  .select('form_id');

const submissionCounts = new Map<string, number>();
for (const row of (submissionsRaw ?? []) as StudySubmission[]) {
  const previous = submissionCounts.get(row.form_id) ?? 0;
  submissionCounts.set(row.form_id, previous + 1);
}

const forms = ((formsRaw ?? []) as StudyForm[]).map((form) => {
  const questions = (form.study_form_questions ?? [])
    .slice()
    .sort((a, b) => a.position - b.position);

  return {
    ...form,
    study_form_questions: questions,
    submissionsCount: submissionCounts.get(form.id) ?? 0,
  };
});

const publishedCount = forms.filter((f) => f.status === 'published').length;
const draftCount = forms.filter((f) => f.status === 'draft').length;
const totalResponses = forms.reduce((s, f) => s + f.submissionsCount, 0);

const KIND_LABELS: Record<string, string> = {
  text: 'Texte',
  textarea: 'Paragraphe',
  number: 'Nombre',
  checkbox: 'Checkbox',
  select: 'Liste',
};
---

<DashboardLayout title="Études" role="admin" activePage="etudes" userName={userName} authResult={result}>

  <div class="page-header">
    <div class="page-title-block">
      <h1>Études &amp; questionnaires</h1>
      <p>Créez des formulaires pour recenser les besoins des associations.</p>
    </div>
  </div>

  {saved && (
    <div class="flash flash-ok" role="alert">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Formulaire créé et sauvegardé.
    </div>
  )}
  {error && (
    <div class="flash flash-err" role="alert">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      {decodeURIComponent(error)}
    </div>
  )}

  <!-- Stats -->
  <div class="kpi-row">
    <div class="kpi-card">
      <div class="kpi-icon kpi-icon-total">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="0"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Total</span>
        <span class="kpi-value">{forms.length}</span>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon kpi-icon-ok">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="9 12 11 14 15 10"/></svg>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Publiés</span>
        <span class="kpi-value kpi-ok">{publishedCount}</span>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon kpi-icon-warn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 19h20L12 2z"/><line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="16.5" r="0.5" fill="currentColor"/></svg>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Brouillons</span>
        <span class="kpi-value kpi-warn">{draftCount}</span>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon kpi-icon-info">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Réponses</span>
        <span class="kpi-value kpi-info">{totalResponses}</span>
      </div>
    </div>
  </div>

  <!-- Create form -->
  <section class="card creator-card">
    <div class="creator-head">
      <div>
        <h2>Nouveau formulaire</h2>
        <p class="creator-sub">Renseignez les informations, puis construisez vos questions.</p>
      </div>
    </div>

    <form method="POST" action="/api/admin/etudes/creer" class="creator-form" id="study-create-form">
      <div class="form-meta-grid">
        <div class="field">
          <label>Titre <span class="req">*</span></label>
          <input type="text" name="title" required maxlength="200"
            placeholder="Ex : Besoins numériques des associations locales" />
        </div>
        <div class="field">
          <label>Statut initial</label>
          <div class="status-toggle" id="status-toggle">
            <input type="hidden" name="status" id="status-hidden" value="draft" />
            <button type="button" class="stoggle-btn stoggle-active" data-value="draft" id="stoggle-draft">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
              Brouillon
            </button>
            <button type="button" class="stoggle-btn" data-value="published" id="stoggle-published">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="9"/><polyline points="9 12 11 14 15 10"/></svg>
              Publié
            </button>
          </div>
        </div>
        <div class="field field-full">
          <label>Description <span class="req-opt">(optionnel)</span></label>
          <textarea name="description" rows="2" maxlength="2000"
            placeholder="Contexte, objectif, durée estimée…"></textarea>
        </div>
      </div>

      <input type="hidden" name="q_count" id="q_count" value="0" />

      <div class="qb-section">
        <div class="qb-section-head">
          <div class="qb-section-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17" stroke-width="3" stroke-linecap="round"/></svg>
            Questions
            <span class="qb-count-badge" id="qb-count-badge">0</span>
          </div>
          <button type="button" class="btn-add-q" id="btn-add-question">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Ajouter une question
          </button>
        </div>

        <div id="questions-list" class="questions-list"></div>

        <div class="qb-empty-state" id="qb-empty">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.35"><rect x="3" y="3" width="18" height="18"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="14" y2="13"/></svg>
          <span>Aucune question pour l'instant.<br/>Cliquez sur « Ajouter une question ».</span>
        </div>
      </div>

      <div class="creator-footer">
        <button type="submit" class="btn btn-primary btn-create">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Créer le formulaire
        </button>
      </div>
    </form>
  </section>

  <!-- Forms list -->
  <section class="forms-section">
    <h2 class="forms-section-title">Formulaires existants</h2>

    {forms.length === 0 ? (
      <div class="card empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.3"><rect x="3" y="3" width="18" height="18"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        <p>Aucun formulaire d'étude pour le moment.</p>
      </div>
    ) : (
      <div class="forms-grid">
        {forms.map((form) => {
          const nextStatus = form.status === 'published' ? 'draft' : 'published';

          return (
            <article class={`form-card ${form.status === 'published' ? 'form-card-published' : ''}`}>
              <div class="fc-top">
                <span class={`fc-status-dot ${form.status === 'published' ? 'dot-ok' : 'dot-neutral'}`}></span>
                <h3 class="fc-title">{form.title}</h3>
                <span class={`badge ${form.status === 'published' ? 'badge-ok' : 'badge-neutral'}`}>
                  {form.status === 'published' ? 'Publié' : 'Brouillon'}
                </span>
              </div>

              {form.description && <p class="fc-desc">{form.description}</p>}

              <div class="fc-kpi-row">
                <div class="fc-kpi">
                  <span class="fc-kpi-val">{form.study_form_questions.length}</span>
                  <span class="fc-kpi-lbl">question{form.study_form_questions.length > 1 ? 's' : ''}</span>
                </div>
                <div class="fc-kpi-sep"></div>
                <div class="fc-kpi">
                  <span class="fc-kpi-val">{form.submissionsCount}</span>
                  <span class="fc-kpi-lbl">réponse{form.submissionsCount > 1 ? 's' : ''}</span>
                </div>
              </div>

              {form.study_form_questions.length > 0 && (
                <ol class="fc-questions">
                  {form.study_form_questions.map((q) => (
                    <li class="fc-question-item">
                      <span class="fc-q-text">{q.label}</span>
                      <span class="fc-q-kind">{KIND_LABELS[q.kind] ?? q.kind}{q.is_required ? ' · requis' : ''}</span>
                    </li>
                  ))}
                </ol>
              )}

              <div class="fc-actions">
                <form method="POST" action="/api/admin/etudes/toggle" class="fc-action-form">
                  <input type="hidden" name="form_id" value={form.id} />
                  <input type="hidden" name="status" value={nextStatus} />
                  <button type="submit" class="btn btn-ghost btn-sm fc-btn-toggle">
                    {form.status === 'published' ? (
                      <>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                        Repasser en brouillon
                      </>
                    ) : (
                      <>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="9"/><polyline points="9 12 11 14 15 10"/></svg>
                        Publier
                      </>
                    )}
                  </button>
                </form>

                <form method="POST" action="/api/admin/etudes/supprimer" class="fc-action-form">
                  <input type="hidden" name="form_id" value={form.id} />
                  <button
                    type="submit"
                    class="btn btn-danger btn-sm"
                    onclick="return confirm('Supprimer ce formulaire et toutes ses réponses définitivement ?')"
                  >
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                    Supprimer
                  </button>
                </form>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>

</DashboardLayout>

<style>
  /* ── Page header ── */
  .page-header { margin-bottom: var(--space-lg); }
  .page-title-block h1 { margin: 0; font-size: var(--text-2xl); font-weight: 900; letter-spacing: -0.02em; }
  .page-title-block p  { margin-top: 4px; color: var(--text-muted); font-size: var(--text-sm); }

  /* ── Flash ── */
  .flash {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 16px; margin-bottom: var(--space-md);
    border: var(--brutal-border-thin); font-weight: 700; font-size: var(--text-sm);
  }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }

  /* ── KPI row ── */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: var(--space-lg);
  }

  .kpi-card {
    background: var(--surface);
    border: var(--brutal-border);
    box-shadow: var(--shadow-sm);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .kpi-card:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-md); }

  .kpi-icon {
    width: 40px; height: 40px; flex-shrink: 0;
    border: var(--brutal-border-thin);
    display: flex; align-items: center; justify-content: center;
  }
  .kpi-icon-total { background: var(--bg); color: var(--text-secondary); }
  .kpi-icon-ok    { background: var(--ok-bg);   color: var(--ok-fg); }
  .kpi-icon-warn  { background: var(--warn-bg);  color: var(--warn-fg); }
  .kpi-icon-info  { background: var(--info-bg);  color: var(--info-fg); }

  .kpi-body { display: flex; flex-direction: column; gap: 2px; }
  .kpi-label { font-size: var(--text-xs); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); font-weight: 600; }
  .kpi-value { font-size: 1.75rem; font-weight: 900; line-height: 1; letter-spacing: -0.03em; }
  .kpi-ok   { color: var(--ok); }
  .kpi-warn { color: var(--warn); }
  .kpi-info { color: var(--info); }

  /* ── Creator card ── */
  .creator-card { margin-top: 0; }
  .creator-card .card:hover { transform: none; }

  .creator-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    padding-bottom: var(--space-md);
    border-bottom: var(--brutal-border-thin);
    margin-bottom: var(--space-md);
  }
  .creator-head h2 { margin: 0; font-size: var(--text-xl); font-weight: 800; }
  .creator-sub { margin-top: 4px; color: var(--text-muted); font-size: var(--text-sm); }

  .creator-form { display: flex; flex-direction: column; gap: var(--space-lg); }

  .form-meta-grid {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 14px;
  }
  .field-full { grid-column: 1 / -1; }

  .field { 
    display: flex; flex-direction: column; gap: 7px;
  }
  .field label {
    font-size: var(--text-xs); font-family: var(--font-mono);
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-muted); font-weight: 700;
    display: flex; align-items: center; gap: 4px;
  }
  .req { color: var(--err); font-size: 0.9em; }
  .req-opt { font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 0.85em; color: var(--text-muted); }

  .field input,
  .field textarea,
  .field select {
    width: 100%;
    border: var(--brutal-border-thin);
    background: var(--surface-raised);
    padding: 10px 12px;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .field textarea {
    resize: vertical;
    min-height: 80px;
    font-family: var(--font-sans);
  }
  .field textarea {
    resize: vertical;
    min-height: 80px;
    font-family: var(--font-sans);
  }

  /* ── Status toggle ── */
  .status-toggle {
    display: flex;
    border: var(--brutal-border-thin);
    overflow: hidden;
  }
  .stoggle-btn {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 5px;
    padding: 9px 10px; font-size: var(--text-xs); font-weight: 700;
    font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.04em;
    background: var(--surface-raised); color: var(--text-muted);
    border: none; border-right: var(--brutal-border-thin); cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .stoggle-btn:last-child { border-right: none; }
  .stoggle-btn.stoggle-active.draft-active {
    background: var(--warn-bg); color: var(--warn-fg);
  }
  .stoggle-btn.stoggle-active.pub-active {
    background: var(--ok-bg); color: var(--ok-fg);
  }
  .stoggle-btn.stoggle-active { background: var(--warn-bg); color: var(--warn-fg); }

  /* ── Question builder section ── */
  .qb-section {
    border: var(--brutal-border-thin);
    background: var(--bg);
  }

  .qb-section-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px;
    background: var(--surface);
    border-bottom: var(--brutal-border-thin);
  }

  .qb-section-title {
    display: flex; align-items: center; gap: 10px;
    font-size: var(--text-xs); font-family: var(--font-mono);
    text-transform: uppercase; letter-spacing: 0.07em;
    font-weight: 800; color: var(--text-secondary);
  }

  .qb-count-badge {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 24px; height: 24px; padding: 0 6px;
    background: var(--accent); color: var(--accent-fg);
    border: 2px solid var(--border); font-size: 0.75rem; font-weight: 900;
    line-height: 1;
  }

  .btn-add-q {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 15px; font-size: var(--text-xs); font-weight: 800;
    font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em;
    background: var(--accent); color: var(--accent-fg);
    border: var(--brutal-border-thin); box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .btn-add-q:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-md); }

  .questions-list { display: flex; flex-direction: column; gap: 10px; padding: 12px; }

  .qb-empty-state {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 12px; padding: 50px 30px;
    color: var(--text-muted); font-size: var(--text-sm); text-align: center;
    line-height: 1.6;
  }

  /* ── Question row ── */
  .question-row {
    border: var(--brutal-border-thin);
    background: linear-gradient(135deg, var(--surface-raised) 0%, var(--surface) 100%);
    padding: 0;
    transition: box-shadow var(--transition-fast), background var(--transition-fast);
    position: relative;
  }
  .question-row:hover { box-shadow: var(--shadow-md); }

  .qrow-main {
    display: grid;
    grid-template-columns: 50px 1fr 160px 110px;
    align-items: center;
    gap: 0;
    padding: 0;
  }

  .qrow-num {
    display: flex; align-items: center; justify-content: center;
    min-height: 54px; padding: 12px 8px;
    font-size: 0.85rem; font-family: var(--font-mono); font-weight: 900;
    color: var(--accent); border-right: 2px solid var(--border-mid);
    background: var(--bg);
  }

  .qrow-label {
    padding: 12px 14px;
    border-right: 1px dashed var(--border-mid);
  }
  .qrow-label input {
    width: 100%; border: var(--brutal-border-thin); background: var(--surface-raised);
    font-size: var(--text-sm); font-weight: 600; color: var(--text-primary);
    outline: none; padding: 9px 10px;
    font-family: var(--font-sans);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .qrow-label input::placeholder { color: var(--text-muted); font-weight: 400; font-size: var(--text-sm); }
  .qrow-label input:focus { outline: none; border-color: var(--accent); background: var(--bg); }

  .qrow-kind {
    padding: 12px 10px;
    border-right: 1px dashed var(--border-mid);
  }
  .qrow-kind select {
    width: 100%; border: var(--brutal-border-thin); background: var(--surface-raised);
    font-size: var(--text-xs); font-family: var(--font-mono);
    color: var(--text-secondary); font-weight: 700; outline: none;
    text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer;
    padding: 8px 10px;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .qrow-kind select:focus { outline: none; border-color: var(--accent); background: var(--bg); }

  .qrow-required {
    display: flex; align-items: center; justify-content: center;
    padding: 12px 10px; gap: 7px;
    font-size: var(--text-xs); font-family: var(--font-mono);
    color: var(--text-secondary); font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
    cursor: pointer; white-space: nowrap;
  }
  .qrow-required input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--accent); }

  .qrow-del {
    position: absolute;
    top: 8px; right: 8px;
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px;
    background: transparent; border: var(--brutal-border-thin); cursor: pointer;
    color: var(--text-muted);
    transition: all var(--transition-fast);
    border-radius: 2px;
  }
  .qrow-del:hover { color: white; background: var(--err); border-color: var(--err); }

  .qrow-extra {
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 2px dashed var(--border-mid);
    background: var(--bg);
  }
  .qrow-extra.visible { display: grid; }

  .qrow-extra-field {
    padding: 12px 14px;
    display: flex; flex-direction: column; gap: 6px;
    border-right: 1px dashed var(--border-mid);
  }
  .qrow-extra-field:last-child { border-right: none; }
  
  .qrow-extra-label {
    font-size: 0.7rem; font-family: var(--font-mono);
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-muted); font-weight: 800;
  }
  .qrow-extra-field input {
    width: 100%; border: var(--brutal-border-thin); background: var(--surface-raised);
    padding: 9px 10px; font-size: var(--text-sm);
    font-family: var(--font-sans);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .qrow-extra-field input:focus { outline: none; border-color: var(--accent); background: var(--bg); }

  /* ── Creator footer ── */
  .creator-footer {
    display: flex; justify-content: flex-end;
    padding-top: var(--space-sm);
    border-top: var(--brutal-border-thin);
  }
  .btn-create { gap: 8px; }

  /* ── Forms section ── */
  .forms-section { margin-top: var(--space-xl); }
  .forms-section-title {
    font-size: var(--text-sm); font-family: var(--font-mono);
    text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--text-muted); font-weight: 700;
    margin-bottom: var(--space-md);
    padding-bottom: 8px; border-bottom: var(--brutal-border-thin);
  }

  .forms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 16px;
  }

  .form-card {
    background: var(--surface);
    border: var(--brutal-border);
    box-shadow: var(--shadow-md);
    display: flex; flex-direction: column; gap: 0;
    overflow: hidden;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .form-card:hover { transform: translate(-3px, -3px); box-shadow: var(--shadow-lg); }
  .form-card-published { border-left: 4px solid var(--ok); }

  .fc-top {
    display: flex; align-items: flex-start; gap: 8px;
    padding: 14px 16px 10px;
  }
  .fc-status-dot {
    width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; margin-top: 5px;
    border: 2px solid var(--border);
  }
  .dot-ok      { background: var(--ok); border-color: var(--ok); }
  .dot-neutral { background: var(--border-mid); }

  .fc-title {
    flex: 1; margin: 0; font-size: var(--text-base); font-weight: 800; line-height: 1.3;
  }

  .fc-desc {
    padding: 0 16px 10px; color: var(--text-muted); font-size: var(--text-sm); line-height: 1.5;
    margin: 0;
  }

  .fc-kpi-row {
    display: flex; align-items: center; gap: 0;
    padding: 10px 16px;
    border-top: var(--brutal-border-thin); border-bottom: var(--brutal-border-thin);
    background: var(--bg);
  }
  .fc-kpi { display: flex; align-items: baseline; gap: 4px; }
  .fc-kpi-val { font-size: 1.3rem; font-weight: 900; line-height: 1; }
  .fc-kpi-lbl { font-size: var(--text-xs); font-family: var(--font-mono); color: var(--text-muted); text-transform: uppercase; }
  .fc-kpi-sep { width: 1px; height: 24px; background: var(--border-mid); margin: 0 16px; }

  .fc-questions {
    list-style: none; padding: 0; margin: 0;
    border-bottom: var(--brutal-border-thin);
    max-height: 180px; overflow-y: auto;
  }
  .fc-question-item {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 7px 16px;
    border-bottom: 1px dashed var(--border-mid);
    font-size: var(--text-sm);
  }
  .fc-question-item:last-child { border-bottom: none; }
  .fc-q-text { font-weight: 600; color: var(--text-primary); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fc-q-kind { font-size: var(--text-xs); font-family: var(--font-mono); color: var(--text-muted); white-space: nowrap; flex-shrink: 0; }

  .fc-actions {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px;
    background: var(--surface);
    border-top: var(--brutal-border-thin);
    margin-top: auto;
  }
  .fc-action-form { display: contents; }
  .fc-btn-toggle { margin-right: auto; }

  /* ── Empty state ── */
  .empty-state {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 12px; padding: 48px; text-align: center;
    color: var(--text-muted); font-size: var(--text-sm);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
    .form-meta-grid { grid-template-columns: 1fr; }
    .forms-grid { grid-template-columns: 1fr; }
    .qrow-main { grid-template-columns: 40px 1fr 140px 90px; }
  }

  @media (max-width: 600px) {
    .kpi-row { grid-template-columns: 1fr 1fr; }
    .qrow-main { grid-template-columns: 35px 1fr auto; }
    .qrow-kind { display: none; }
    .qrow-required { display: none; }
    .qrow-extra { grid-template-columns: 1fr; }
    .qrow-extra-field:first-child { border-right: none; border-bottom: 1px dashed var(--border-mid); }
  }
</style>

<script>
  const list        = document.getElementById('questions-list') as HTMLElement;
  const emptyState  = document.getElementById('qb-empty') as HTMLElement;
  const countInput  = document.getElementById('q_count') as HTMLInputElement;
  const countBadge  = document.getElementById('qb-count-badge') as HTMLElement;
  const addBtn      = document.getElementById('btn-add-question') as HTMLButtonElement;

  // Status toggle
  const statusHidden    = document.getElementById('status-hidden') as HTMLInputElement;
  const stoggleDraft    = document.getElementById('stoggle-draft') as HTMLButtonElement;
  const stogglePublished = document.getElementById('stoggle-published') as HTMLButtonElement;

  function setStatus(val: string) {
    statusHidden.value = val;
    stoggleDraft.classList.toggle('stoggle-active', val === 'draft');
    stoggleDraft.classList.toggle('draft-active', val === 'draft');
    stogglePublished.classList.toggle('stoggle-active', val === 'published');
    stogglePublished.classList.toggle('pub-active', val === 'published');
  }
  stoggleDraft.addEventListener('click',     () => setStatus('draft'));
  stogglePublished.addEventListener('click', () => setStatus('published'));
  setStatus('draft');

  // Question builder
  let questionCount = 0;

  function sync() {
    const rows = list.querySelectorAll<HTMLElement>('.question-row');
    const n = rows.length;
    countInput.value = String(n);
    countBadge.textContent = String(n);
    emptyState.style.display = n === 0 ? '' : 'none';
    rows.forEach((row, i) => {
      const num = row.querySelector<HTMLElement>('.qrow-num');
      if (num) num.textContent = `${i + 1}`;
      // rename all inputs to match new index
      row.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-qfield]').forEach((el) => {
        const field = el.dataset.qfield ?? '';
        el.name = `q_${field}_${i}`;
      });
    });
    questionCount = n;
  }

  const KIND_LABELS: Record<string, string> = {
    text: 'Texte court', textarea: 'Paragraphe', number: 'Nombre',
    checkbox: 'Checkbox', select: 'Liste déroulante',
  };

  function createRow(index: number): HTMLElement {
    const div = document.createElement('div');
    div.className = 'question-row';

    const kindOptions = Object.entries(KIND_LABELS)
      .map(([v, l]) => `<option value="${v}">${l}</option>`)
      .join('');

    div.innerHTML = `
      <div class="qrow-main">
        <span class="qrow-num">${index + 1}</span>

        <div class="qrow-label">
          <input
            type="text"
            name="q_label_${index}"
            data-qfield="label"
            placeholder="Libellé de la question…"
            required
            maxlength="500"
          />
        </div>

        <div class="qrow-kind">
          <select name="q_kind_${index}" data-qfield="kind">
            ${kindOptions}
          </select>
        </div>

        <label class="qrow-required" title="Marquer comme obligatoire">
          <input type="checkbox" name="q_required_${index}" data-qfield="required" value="1" />
          Requis
        </label>

        <button type="button" class="qrow-del" aria-label="Supprimer la question" title="Supprimer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14H6L5 6"/>
            <path d="M10 11v6"/><path d="M14 11v6"/>
          </svg>
        </button>
      </div>

      <div class="qrow-extra" data-extra>
        <div class="qrow-extra-field" data-options-wrap style="display:none">
          <span class="qrow-extra-label">Options (virgule séparées) *</span>
          <input type="text" name="q_options_${index}" data-qfield="options"
            placeholder="Ex : Oui, Non, Peut-être" maxlength="1000" />
        </div>
        <div class="qrow-extra-field">
          <span class="qrow-extra-label">Placeholder (optionnel)</span>
          <input type="text" name="q_placeholder_${index}" data-qfield="placeholder"
            placeholder="Texte d'aide affiché dans le champ…" maxlength="200" />
        </div>
      </div>
    `;

    const kindSelect   = div.querySelector<HTMLSelectElement>('[data-qfield="kind"]')!;
    const optionsWrap  = div.querySelector<HTMLElement>('[data-options-wrap]')!;
    const extraSection = div.querySelector<HTMLElement>('[data-extra]')!;

    function toggleExtra() {
      const isSelect = kindSelect.value === 'select';
      const isCheckbox = kindSelect.value === 'checkbox';
      optionsWrap.style.display = isSelect ? '' : 'none';
      // hide placeholder for checkbox
      const phWrap = extraSection.querySelectorAll<HTMLElement>('.qrow-extra-field')[1];
      if (phWrap) phWrap.style.display = isCheckbox ? 'none' : '';
      extraSection.classList.toggle('visible',
        isSelect || kindSelect.value === 'text' || kindSelect.value === 'textarea' || kindSelect.value === 'number'
      );
    }

    kindSelect.addEventListener('change', toggleExtra);
    toggleExtra();

    div.querySelector<HTMLButtonElement>('.qrow-del')!.addEventListener('click', () => {
      div.remove();
      sync();
    });

    return div;
  }

  addBtn.addEventListener('click', () => {
    if (questionCount >= 25) { alert('Maximum 25 questions par formulaire.'); return; }
    const row = createRow(questionCount);
    list.appendChild(row);
    sync();
    row.querySelector<HTMLInputElement>('[data-qfield="label"]')?.focus();
  });

  sync();
</script>
