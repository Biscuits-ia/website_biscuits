---
// src/pages/dashboard/admin/logiciels.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error') ?? '';

interface SoftwareRow {
  id: string;
  name: string;
  description: string | null;
  category: string | null;
  website_url: string | null;
  download_url: string | null;
  install: string | null;
  logo_url: string | null;
  is_free: boolean;
  is_visible: boolean;
}

const { data: softwares } = await supabase
  .from('software')
  .select('id, name, description, category, website_url, download_url, install, logo_url, is_free, is_visible')
  .order('name', { ascending: true });
---

<DashboardLayout title="Logiciels" activePage="logiciels" userName={userName} authResult={result}>
  <div class="page-head-row">
    <div>
      <h1>Gestion des logiciels</h1>
      <p class="page-head-sub">
        {softwares?.length ?? 0} logiciel{(softwares?.length ?? 0) > 1 ? 's' : ''} au total.
      </p>
    </div>
    <button class="btn btn-primary" data-modal-open="modal-logiciel">
      + Ajouter un logiciel
    </button>
  </div>

  {
    saved && (
      <div class="flash flash-ok" role="alert">
        ✓ Modifications sauvegardées.
      </div>
    )
  }
  {
    error && (
      <div class="flash flash-err" role="alert">
        ✗ {decodeURIComponent(error)}
      </div>
    )
  }

  <!-- Tableau -->
  <div class="card card-flush">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Nom</th>
            <th>Catégorie</th>
            <th>Gratuit</th>
            <th>Visible</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {
            softwares &&
              (softwares as SoftwareRow[]).map((sw) => (
                <tr>
                  <td>
                    <div class="cell-strong">{sw.name}</div>
                    {sw.description && (
                      <div class="cell-desc">
                        {sw.description.slice(0, 80)}
                        {sw.description.length > 80 ? '…' : ''}
                      </div>
                    )}
                  </td>
                  <td>{sw.category ?? '—'}</td>
                  <td>
                    <span class={`badge ${sw.is_free ? 'badge-ok' : 'badge-neutral'}`}>
                      {sw.is_free ? 'Oui' : 'Non'}
                    </span>
                  </td>
                  <td>
                    <form method="POST" action="/api/admin/logiciels/toggle-visibilite">
                      <input type="hidden" name="software_id" value={sw.id} />
                      <input type="hidden" name="is_visible" value={String(!sw.is_visible)} />
                      <button
                        type="submit"
                        class={`badge badge-btn ${sw.is_visible ? 'badge-ok' : 'badge-err'}`}
                      >
                        {sw.is_visible ? 'Visible' : 'Masqué'}
                      </button>
                    </form>
                  </td>
                  <td>
                    <div class="table-actions">
                      <button
                        class="btn btn-ghost btn-table"
                        data-modal-open={`modal-edit-${sw.id}`}
                      >
                        Modifier
                      </button>
                      <form method="POST" action="/api/admin/logiciels/supprimer">
                        <input type="hidden" name="software_id" value={sw.id} />
                        <button
                          type="submit"
                          class="btn btn-danger btn-table"
                          data-confirm="'Supprimer ce logiciel ?'"
                        >
                          ✕
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
          }
        </tbody>
      </table>
    </div>
  </div>

  {
    softwares &&
      (softwares as SoftwareRow[]).map((sw) => (
        <dialog id={`modal-edit-${sw.id}`} class="modal">
          <div class="modal-box">
            <div class="modal-header">
              <span class="card-title">Modifier — {sw.name}</span>
              <button class="btn btn-ghost" data-modal-close={`modal-edit-${sw.id}`}>
                ✕
              </button>
            </div>
            <form method="POST" action="/api/admin/logiciels/modifier" class="modal-form">
              <input type="hidden" name="software_id" value={sw.id} />
              <div class="field">
                <label>Nom *</label>
                <input type="text" name="name" value={sw.name} required />
              </div>
              <div class="field">
                <label>Description</label>
                <textarea name="description" rows="3" class="resize-v">
                  {sw.description ?? ''}
                </textarea>
              </div>
              <div class="field">
                <label>Catégorie</label>
                <input
                  type="text"
                  name="category"
                  value={sw.category ?? ''}
                  placeholder="Ex : Bureautique"
                />
              </div>
              <div class="field">
                <label>URL du logo</label>
                <input
                  type="url"
                  name="logo_url"
                  value={sw.logo_url ?? ''}
                  placeholder="https://…"
                />
              </div>
              <div class="field">
                <label>URL de téléchargement</label>
                <input
                  type="url"
                  name="download_url"
                  value={sw.download_url ?? ''}
                  placeholder="https://…"
                />
              </div>
              <div class="field">
                <label>Site web</label>
                <input
                  type="url"
                  name="website_url"
                  value={sw.website_url ?? ''}
                  placeholder="https://…"
                />
              </div>
              <div class="check-row">
                <label class="check-label">
                  <input type="checkbox" name="is_free" value="true" checked={sw.is_free} />
                  Gratuit
                </label>
                <label class="check-label">
                  <input type="checkbox" name="is_visible" value="true" checked={sw.is_visible} />
                  Visible
                </label>
              </div>
              <div class="modal-actions">
                <button type="submit" class="btn btn-primary">
                  Sauvegarder
                </button>
                <button
                  type="button"
                  class="btn btn-ghost"
                  data-modal-close={`modal-edit-${sw.id}`}
                >
                  Annuler
                </button>
              </div>
            </form>
          </div>
        </dialog>
      ))
  }

  <!-- Modal : nouveau logiciel -->
  <dialog id="modal-logiciel" class="modal">
    <div class="modal-box">
      <div class="modal-header">
        <span class="card-title">Nouveau logiciel</span>
        <button class="btn btn-ghost" data-modal-close="modal-logiciel">✕</button>
      </div>
      <form method="POST" action="/api/admin/logiciels/creer" class="modal-form">
        <div class="field">
          <label>Nom *</label>
          <input type="text" name="name" required placeholder="LibreOffice" />
        </div>
        <div class="field">
          <label>Description</label>
          <textarea name="description" rows="3" class="resize-v" placeholder="Courte description…"
          ></textarea>
        </div>
        <div class="field">
          <label>Catégorie</label>
          <input type="text" name="category" placeholder="Ex : Bureautique" />
        </div>
        <div class="field">
          <label>URL du logo</label>
          <input type="url" name="logo_url" placeholder="https://…" />
        </div>
        <div class="field">
          <label>URL de téléchargement</label>
          <input type="url" name="download_url" placeholder="https://…" />
        </div>
        <div class="field">
          <label>Site web</label>
          <input type="url" name="website_url" placeholder="https://…" />
        </div>
        <div class="check-row">
          <label class="check-label">
            <input type="checkbox" name="is_free" value="true" checked /> Gratuit
          </label>
          <label class="check-label">
            <input type="checkbox" name="is_visible" value="true" checked /> Visible immédiatement
          </label>
        </div>
        <div class="modal-actions">
          <button type="submit" class="btn btn-primary">Ajouter le logiciel</button>
          <button type="button" class="btn btn-ghost" data-modal-close="modal-logiciel"
            >Annuler</button
          >
        </div>
      </form>
    </div>
  </dialog>
</DashboardLayout>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }
  .field input,
  .field textarea {
    padding: 10px 13px;
    font-size: var(--text-base);
    width: 100%;
    font-family: var(--font-sans);
  }

  .modal {
    border: var(--brutal-border);
    box-shadow: var(--shadow-xl);
    padding: 0;
    background: var(--surface);
    max-width: 560px;
    width: 90vw;
  }
  .modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }
  .modal-box {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: 85vh;
    overflow-y: auto;
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: var(--brutal-border-thin);
  }

  .flash {
    padding: 12px 18px;
    margin-bottom: 20px;
    font-size: var(--text-sm);
    font-weight: 600;
    border: var(--brutal-border-thin);
    box-shadow: var(--shadow-sm);
  }
  .flash-ok {
    background: var(--ok-bg);
    color: var(--ok-fg);
    border-color: var(--ok);
  }
  .flash-err {
    background: var(--err-bg);
    color: var(--err-fg);
    border-color: var(--err);
  }
</style>
