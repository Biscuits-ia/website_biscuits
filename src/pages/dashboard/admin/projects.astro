---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdmin } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user } = result;
const adminSupabase = createSupabaseAdminClient();
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const statusFilter = Astro.url.searchParams.get('status') ?? '';
const search = (Astro.url.searchParams.get('q') ?? '').trim();

let query = adminSupabase
  .from('projects')
  .select('id, title, description, status, priority, deadline, created_at, leader_id, objective, tech_stack, estimated_hours')
  .order('created_at', { ascending: false });

if (statusFilter) query = query.eq('status', statusFilter);
if (search) query = query.ilike('title', `%${search}%`);

const { data: projectsRaw, error: projectsError } = await query;

if (projectsError) {
  console.error('[admin/projects] query error:', projectsError.message, projectsError.code);
}

interface ProjectRow {
  id: string;
  title: string;
  description: string | null;
  status: string;
  priority: string;
  deadline: string | null;
  created_at: string;
  leader_id: string | null;
  objective: string | null;
  tech_stack: string[];
  estimated_hours: number | null;
}

const projects = (projectsRaw ?? []) as unknown as ProjectRow[];

// Fetch leader profiles separately (avoid fragile embedded join)
const leaderIds = [...new Set(projects.map((p) => p.leader_id).filter(Boolean))] as string[];
const leaderMap: Record<string, string> = {};
if (leaderIds.length > 0) {
  const { data: leaderProfiles } = await adminSupabase
    .from('profiles')
    .select('id, full_name, email')
    .in('id', leaderIds);
  for (const lp of leaderProfiles ?? []) {
    leaderMap[lp.id] = lp.full_name ?? lp.email ?? lp.id;
  }
}

const statusLabel: Record<string, string> = {
  active: 'Actif',
  on_hold: 'En pause',
  completed: 'Terminé',
  archived: 'Archivé',
};

const statusClass: Record<string, string> = {
  active: 'ok',
  on_hold: 'warn',
  completed: 'info',
  archived: 'neutral',
};

const priorityLabel: Record<string, string> = {
  low: 'Faible',
  medium: 'Moyenne',
  high: 'Haute',
};

const priorityClass: Record<string, string> = {
  low: 'neutral',
  medium: 'info',
  high: 'err',
};
---

<DashboardLayout title="Gestion des projets" activePage="projects" userName={userName} authResult={result}>
  <div class="page-header mb-6">
    <div>
      <h1 class="page-title">Projets</h1>
      <p class="description">{projects.length} projet{projects.length > 1 ? 's' : ''}</p>
    </div>
    <button class="btn btn-primary" id="btn-open-create">Nouveau projet</button>
  </div>

  <form method="GET" class="filters mb-5">
    <input name="q" value={search} placeholder="Rechercher un projet..." class="input input-sm" />
    <select name="status" class="input input-sm" onchange="this.form.submit()">
      <option value="">Tous les statuts</option>
      <option value="active" selected={statusFilter === 'active'}>Actif</option>
      <option value="on_hold" selected={statusFilter === 'on_hold'}>En pause</option>
      <option value="completed" selected={statusFilter === 'completed'}>Terminé</option>
      <option value="archived" selected={statusFilter === 'archived'}>Archivé</option>
    </select>
    <button type="submit" class="btn btn-ghost btn-sm">Filtrer</button>
    {(search || statusFilter) && (
      <a href="/dashboard/admin/projects" class="btn btn-ghost btn-sm">Réinitialiser</a>
    )}
  </form>

  <div class="card card-flush">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Projet</th>
            <th>Responsable</th>
            <th>Statut</th>
            <th>Priorité</th>
            <th>Échéance</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {projects.length > 0 ? projects.map((p) => {
            const leader = (p.leader_id ? leaderMap[p.leader_id] : null) ?? '—';
            return (
              <tr>
                <td>
                  <div class="project-cell">
                    <a href={`/dashboard/admin/projects/${p.id}`} class="project-title-link">{p.title}</a>
                    {p.description && <span class="project-desc">{p.description}</span>}
                    {p.tech_stack.length > 0 && (
                      <span class="project-tags">{p.tech_stack.slice(0, 4).join(' · ')}</span>
                    )}
                  </div>
                </td>
                <td class="mono xs">{leader}</td>
                <td>
                  <span class={`badge badge-${statusClass[p.status] ?? 'neutral'}`}>{statusLabel[p.status] ?? p.status}</span>
                </td>
                <td>
                  <span class={`badge badge-${priorityClass[p.priority] ?? 'neutral'}`}>{priorityLabel[p.priority] ?? p.priority}</span>
                </td>
                <td class="mono xs muted">{p.deadline ? new Date(p.deadline).toLocaleDateString('fr-FR') : '—'}</td>
                <td>
                  <div class="row-actions">
                    <a class="btn btn-ghost btn-xs" href={`/dashboard/admin/projects/${p.id}`}>Gérer</a>
                    <select class="input input-xs js-status" data-id={p.id}>
                      <option value="active" selected={p.status === 'active'}>Actif</option>
                      <option value="on_hold" selected={p.status === 'on_hold'}>En pause</option>
                      <option value="completed" selected={p.status === 'completed'}>Terminé</option>
                      <option value="archived" selected={p.status === 'archived'}>Archivé</option>
                    </select>
                    <button type="button" class="btn btn-ghost btn-xs js-delete" data-id={p.id}>Suppr.</button>
                  </div>
                </td>
              </tr>
            );
          }) : (
            <tr>
              <td colspan="6" class="empty-row">Aucun projet trouvé.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <dialog id="create-project-modal" class="modal">
    <form method="dialog" class="modal-card" id="create-project-form">
      <h2 class="modal-title">Nouveau projet</h2>
      <div class="form-grid">
        <label>
          <span>Titre</span>
          <input type="text" name="title" required class="input" maxlength="120" />
        </label>
        <label>
          <span>Description</span>
          <textarea name="description" class="input" maxlength="800" rows="4"></textarea>
        </label>
        <label>
          <span>Objectif du projet</span>
          <textarea name="objective" class="input" maxlength="2000" rows="3" placeholder="Quel impact doit avoir ce projet ?"></textarea>
        </label>
        <label>
          <span>Livrables attendus</span>
          <textarea name="expected_deliverables" class="input" maxlength="2000" rows="3" placeholder="Ex: maquette, documentation, version bêta..."></textarea>
        </label>
        <div class="grid-2">
          <label>
            <span>Stack technique (séparée par des virgules)</span>
            <input type="text" name="tech_stack" class="input" placeholder="Astro, Supabase, TypeScript" />
          </label>
          <label>
            <span>Outils (séparés par des virgules)</span>
            <input type="text" name="tools" class="input" placeholder="Figma, Notion, Discord" />
          </label>
        </div>
        <div class="grid-2">
          <label>
            <span>Priorité</span>
            <select name="priority" class="input">
              <option value="medium">Moyenne</option>
              <option value="high">Haute</option>
              <option value="low">Faible</option>
            </select>
          </label>
          <label>
            <span>Échéance</span>
            <input type="date" name="deadline" class="input" />
          </label>
        </div>
        <div class="grid-2">
          <label>
            <span>Date de démarrage</span>
            <input type="date" name="start_date" class="input" />
          </label>
          <label>
            <span>Charge estimée (heures)</span>
            <input type="number" name="estimated_hours" min="0" step="1" class="input" />
          </label>
        </div>
        <div class="grid-2">
          <label>
            <span>Dépôt code (URL)</span>
            <input type="url" name="repository_url" class="input" placeholder="https://github.com/..." />
          </label>
          <label>
            <span>Documentation (URL)</span>
            <input type="url" name="document_url" class="input" placeholder="https://..." />
          </label>
        </div>
        <label>
          <span>Canal de communication</span>
          <input type="text" name="communication_channel" maxlength="200" class="input" placeholder="Discord #projet-xyz" />
        </label>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" id="btn-close-create">Annuler</button>
        <button type="submit" class="btn btn-primary">Créer</button>
      </div>
    </form>
  </dialog>
</DashboardLayout>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .page-title { font-size: var(--text-xl); font-weight: 700; }
  .filters { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .input { border: var(--brutal-border-thin); background: var(--surface-raised); padding: 6px 10px; font-family: var(--font-sans); font-size: var(--text-sm); outline: none; }
  .input:focus { box-shadow: var(--shadow-sm); }
  .input-sm { padding: 4px 8px; font-size: var(--text-xs); }
  .input-xs { padding: 2px 6px; font-size: 0.72rem; }

  .project-cell { display: flex; flex-direction: column; gap: 4px; }
  .project-title-link { color: var(--accent); text-decoration: none; font-weight: 600; }
  .project-title-link:hover { text-decoration: underline; }
  .project-desc { font-size: var(--text-xs); color: var(--text-muted); }
  .project-tags { font-size: 0.68rem; color: var(--accent-dark); }
  .row-actions { display: flex; align-items: center; gap: 6px; }
  .mono { font-family: var(--font-mono); }
  .xs { font-size: 0.75rem; }
  .muted { color: var(--text-muted); }
  .empty-row { text-align: center; color: var(--text-muted); padding: 24px; }

  .modal { border: none; padding: 0; background: transparent; }
  .modal::backdrop { background: rgba(15, 23, 42, 0.35); }
  .modal-card { width: min(560px, 94vw); border: var(--brutal-border); background: var(--surface-raised); box-shadow: var(--shadow-lg); padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-md); }
  .modal-title { font-size: var(--text-lg); font-weight: 700; margin: 0; }
  .form-grid { display: flex; flex-direction: column; gap: 10px; }
  .form-grid label { display: flex; flex-direction: column; gap: 4px; font-size: var(--text-xs); color: var(--text-muted); }
  .grid-2 { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 8px; }

  .mb-5 { margin-bottom: var(--space-lg); }
  .mb-6 { margin-bottom: var(--space-xl); }

  @media (max-width: 760px) {
    .grid-2 { grid-template-columns: 1fr; }
  }
</style>

<script>
  const parseTagInput = (value: FormDataEntryValue | null): string[] => {
    return String(value ?? '')
      .split(',')
      .map((item) => item.trim())
      .filter(Boolean)
      .slice(0, 20);
  };

  const createModal = document.getElementById('create-project-modal');
  const btnOpenCreate = document.getElementById('btn-open-create');
  const btnCloseCreate = document.getElementById('btn-close-create');
  const createForm = document.getElementById('create-project-form');

  btnOpenCreate?.addEventListener('click', () => {
    if (createModal instanceof HTMLDialogElement) createModal.showModal();
  });

  btnCloseCreate?.addEventListener('click', () => {
    if (createModal instanceof HTMLDialogElement) createModal.close();
  });

  createForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(createForm instanceof HTMLFormElement)) return;

    const fd = new FormData(createForm);
    const payload = {
      title: String(fd.get('title') ?? '').trim(),
      description: String(fd.get('description') ?? '').trim() || null,
      objective: String(fd.get('objective') ?? '').trim() || null,
      expected_deliverables: String(fd.get('expected_deliverables') ?? '').trim() || null,
      tech_stack: parseTagInput(fd.get('tech_stack')),
      tools: parseTagInput(fd.get('tools')),
      priority: String(fd.get('priority') ?? 'medium'),
      deadline: String(fd.get('deadline') ?? '') || null,
      start_date: String(fd.get('start_date') ?? '') || null,
      estimated_hours: Number(fd.get('estimated_hours') || 0) || null,
      repository_url: String(fd.get('repository_url') ?? '').trim() || null,
      document_url: String(fd.get('document_url') ?? '').trim() || null,
      communication_channel: String(fd.get('communication_channel') ?? '').trim() || null,
    };

    const res = await fetch('/api/admin/projects', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      const out = await res.json().catch(() => ({ error: 'Erreur inconnue' }));
      alert(out.error ?? 'Erreur lors de la création');
      return;
    }

    window.location.reload();
  });

  document.querySelectorAll('.js-status').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const sel = el;
      const id = sel.getAttribute('data-id');
      const status = sel.value;
      if (!id) return;

      const res = await fetch(`/api/admin/projects?id=${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
      });

      if (!res.ok) {
        alert('Erreur lors de la mise à jour.');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-delete').forEach((el) => {
    el.addEventListener('click', async () => {
      const id = el.getAttribute('data-id');
      if (!id) return;
      if (!confirm('Supprimer ce projet ?')) return;

      const res = await fetch(`/api/admin/projects?id=${id}`, {
        method: 'DELETE',
      });

      if (!res.ok) {
        alert('Erreur lors de la suppression.');
        return;
      }

      window.location.reload();
    });
  });
</script>
