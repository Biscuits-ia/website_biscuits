---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdmin } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user } = result;
const adminSupabase = createSupabaseAdminClient();
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const projectId = Astro.params.id ?? '';
if (!projectId) return Astro.redirect('/dashboard/admin/projects');

const [
  { data: projectRaw, error: projectError },
  { data: tasksRaw },
  { data: membersRaw },
  { data: volunteersRaw },
] = await Promise.all([
  adminSupabase
    .from('projects')
    .select(`
      id, title, description, status, priority, deadline, created_at, updated_at,
      leader_id, objective, expected_deliverables, tech_stack, tools,
      repository_url, document_url, communication_channel, estimated_hours, start_date
    `)
    .eq('id', projectId)
    .single(),
  adminSupabase
    .from('project_tasks')
    .select('id, title, description, task_type, status, priority, assignee_id, deadline, position, created_at')
    .eq('project_id', projectId)
    .order('status')
    .order('position'),
  adminSupabase
    .from('project_members')
    .select('user_id, joined_at')
    .eq('project_id', projectId)
    .order('joined_at', { ascending: true }),
  adminSupabase
    .from('profiles')
    .select('id, full_name, email, role')
    .eq('role', 'benevole')
    .order('full_name', { ascending: true }),
]);

if (projectError || !projectRaw) return Astro.redirect('/dashboard/admin/projects');

interface Project {
  id: string;
  title: string;
  description: string | null;
  status: string;
  priority: string;
  deadline: string | null;
  created_at: string;
  updated_at: string;
  leader_id: string | null;
  objective: string | null;
  expected_deliverables: string | null;
  tech_stack: string[];
  tools: string[];
  repository_url: string | null;
  document_url: string | null;
  communication_channel: string | null;
  estimated_hours: number | null;
  start_date: string | null;
}

interface Task {
  id: string;
  title: string;
  description: string | null;
  task_type: string;
  status: string;
  priority: string;
  assignee_id: string | null;
  deadline: string | null;
  position: number;
  created_at: string;
}

interface Member {
  user_id: string;
  joined_at: string;
}

interface Volunteer {
  id: string;
  full_name: string | null;
  email: string;
  role: string;
}

const project = projectRaw as unknown as Project;
const tasks = (tasksRaw ?? []) as unknown as Task[];
const members = (membersRaw ?? []) as unknown as Member[];
const volunteers = (volunteersRaw ?? []) as unknown as Volunteer[];

// Fetch profiles separately (avoid fragile embedded joins)
const profileIds = [
  ...(project.leader_id ? [project.leader_id] : []),
  ...members.map((m) => m.user_id),
  ...[...new Set(tasks.map((t) => t.assignee_id).filter(Boolean))] as string[],
];
const uniqueProfileIds = [...new Set(profileIds)];
const profileMap: Record<string, { full_name: string | null; email: string }> = {};
if (uniqueProfileIds.length > 0) {
  const { data: profilesData } = await adminSupabase
    .from('profiles')
    .select('id, full_name, email')
    .in('id', uniqueProfileIds);
  for (const p of profilesData ?? []) {
    profileMap[p.id] = { full_name: p.full_name, email: p.email };
  }
}

const memberIds = new Set(members.map((m) => m.user_id));
const assignableVolunteers = volunteers.filter((v) => !memberIds.has(v.id));

// Index des bénévoles par id (source de vérité pour les noms dans la liste)
const volunteerById: Record<string, Volunteer> = {};
for (const v of volunteers) volunteerById[v.id] = v;

function getMemberName(userId: string): string {
  return (
    profileMap[userId]?.full_name?.trim()
    || volunteerById[userId]?.full_name?.trim()
    || profileMap[userId]?.email?.trim()
    || volunteerById[userId]?.email?.trim()
    || userId
  );
}

const memberOptions = members.map((m) => ({
  id: m.user_id,
  name: getMemberName(m.user_id),
}));

const statusLabel: Record<string, string> = { active: 'Actif', on_hold: 'En pause', completed: 'Terminé', archived: 'Archivé' };
const priorityLabel: Record<string, string> = { low: 'Faible', medium: 'Moyenne', high: 'Haute' };
const taskTypeLabel: Record<string, string> = {
  general: 'Général',
  dev: 'Dev',
  db: 'DB',
  design: 'Design',
  qa: 'QA/Test',
  ops: 'Ops',
  doc: 'Documentation',
};

const leaderName = project.leader_id
  ? (profileMap[project.leader_id]?.full_name ?? profileMap[project.leader_id]?.email ?? '—')
  : '—';
const stackText = project.tech_stack.join(', ');
const toolsText = project.tools.join(', ');
---

<DashboardLayout title={`Projet admin: ${project.title}`} activePage="projects" userName={userName} authResult={result}>
  <div class="top mb-6">
    <a href="/dashboard/admin/projects" class="back-link">← Retour aux projets</a>
    <h1 class="page-title">{project.title}</h1>
    <p class="description">Pilotage admin: tâches, affectations, et brief projet</p>
  </div>

  <div class="grid">
    <section class="card">
      <h2 class="card-title">Brief projet</h2>
      <div class="brief-meta">
        <span class="meta-chip">Statut: {statusLabel[project.status] ?? project.status}</span>
        <span class="meta-chip">Priorité: {priorityLabel[project.priority] ?? project.priority}</span>
        <span class="meta-chip">Responsable: {leaderName}</span>
      </div>
      {project.description && <p class="brief-text">{project.description}</p>}
      {project.objective && <p class="brief-text"><strong>Objectif:</strong> {project.objective}</p>}
      {project.expected_deliverables && <p class="brief-text"><strong>Livrables:</strong> {project.expected_deliverables}</p>}
      <div class="brief-list">
        <div><strong>Stack:</strong> {stackText || '—'}</div>
        <div><strong>Outils:</strong> {toolsText || '—'}</div>
        <div><strong>Canal:</strong> {project.communication_channel ?? '—'}</div>
        <div><strong>Charge:</strong> {project.estimated_hours != null ? `${project.estimated_hours}h` : '—'}</div>
        <div><strong>Démarrage:</strong> {project.start_date ? new Date(project.start_date).toLocaleDateString('fr-FR') : '—'}</div>
        <div><strong>Échéance:</strong> {project.deadline ? new Date(project.deadline).toLocaleDateString('fr-FR') : '—'}</div>
      </div>
      <div class="links-row">
        {project.repository_url && <a href={project.repository_url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-xs">Repo</a>}
        {project.document_url && <a href={project.document_url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-xs">Documentation</a>}
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Affectation des bénévoles</h2>
      <form id="form-add-member" class="row-form">
        <input type="hidden" name="project_id" value={projectId} />
        <select name="user_id" class="input" required>
          <option value="">Ajouter un bénévole...</option>
          {assignableVolunteers.map((v) => (
            <option value={v.id}>{v.full_name ?? v.email} ({v.email})</option>
          ))}
        </select>
        <button type="submit" class="btn btn-primary btn-sm">Affecter</button>
      </form>

      <div class="members-list">
        {members.length > 0 ? members.map((m) => {
          const name = getMemberName(m.user_id);
          return (
            <div class="member-item">
              <span>{name}</span>
              <button class="btn btn-ghost btn-xs js-remove-member" data-user-id={m.user_id}>Retirer</button>
            </div>
          );
        }) : <p class="muted">Aucun membre affecté.</p>}
      </div>
    </section>
  </div>

  <section class="card mt-6">
    <h2 class="card-title">Gestion des tâches</h2>

    <form id="form-add-task" class="task-form mb-5">
      <input type="hidden" name="project_id" value={projectId} />
      <input type="text" name="title" class="input" placeholder="Titre de la tâche" required maxlength="200" />
      <textarea name="description" class="input task-form-description" placeholder="Description de la tâche" rows="2" maxlength="1000"></textarea>
      <select name="task_type" class="input">
        <option value="general" selected>Type: Général</option>
        <option value="dev">Type: Dev</option>
        <option value="db">Type: DB</option>
        <option value="design">Type: Design</option>
        <option value="qa">Type: QA/Test</option>
        <option value="ops">Type: Ops</option>
        <option value="doc">Type: Documentation</option>
      </select>
      <select name="status" class="input">
        <option value="todo">À faire</option>
        <option value="in_progress">En cours</option>
        <option value="review">Révision</option>
        <option value="done">Terminé</option>
      </select>
      <select name="priority" class="input">
        <option value="medium">Priorité moyenne</option>
        <option value="high">Priorité haute</option>
        <option value="low">Priorité faible</option>
      </select>
      <select name="assignee_id" class="input">
        <option value="">Non assigné</option>
        {memberOptions.map((m) => <option value={m.id}>{m.name}</option>)}
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Créer tâche</button>
    </form>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Titre</th>
            <th>Description</th>
            <th>Type</th>
            <th>Statut</th>
            <th>Priorité</th>
            <th>Assigné</th>
            <th>Échéance</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="tasks-tbody">
          {tasks.length > 0 ? tasks.map((t) => {
            return (
              <tr data-task-row="1">
                <td>{t.title}</td>
                <td class="task-desc-cell">{t.description || '—'}</td>
                <td>
                  <select class="input input-xs js-task-type" data-id={t.id}>
                    <option value="general" selected={t.task_type === 'general'}>{taskTypeLabel.general}</option>
                    <option value="dev" selected={t.task_type === 'dev'}>{taskTypeLabel.dev}</option>
                    <option value="db" selected={t.task_type === 'db'}>{taskTypeLabel.db}</option>
                    <option value="design" selected={t.task_type === 'design'}>{taskTypeLabel.design}</option>
                    <option value="qa" selected={t.task_type === 'qa'}>{taskTypeLabel.qa}</option>
                    <option value="ops" selected={t.task_type === 'ops'}>{taskTypeLabel.ops}</option>
                    <option value="doc" selected={t.task_type === 'doc'}>{taskTypeLabel.doc}</option>
                  </select>
                </td>
                <td>
                  <select class="input input-xs js-task-status" data-id={t.id}>
                    <option value="todo" selected={t.status === 'todo'}>À faire</option>
                    <option value="in_progress" selected={t.status === 'in_progress'}>En cours</option>
                    <option value="review" selected={t.status === 'review'}>Révision</option>
                    <option value="done" selected={t.status === 'done'}>Terminé</option>
                  </select>
                </td>
                <td>
                  <select class="input input-xs js-task-priority" data-id={t.id}>
                    <option value="low" selected={t.priority === 'low'}>Faible</option>
                    <option value="medium" selected={t.priority === 'medium'}>Moyenne</option>
                    <option value="high" selected={t.priority === 'high'}>Haute</option>
                  </select>
                </td>
                <td>
                  <select class="input input-xs js-task-assignee" data-id={t.id}>
                    <option value="">Non assigné</option>
                    {memberOptions.map((m) => <option value={m.id} selected={t.assignee_id === m.id}>{m.name}</option>)}
                  </select>
                </td>
                <td class="muted">{t.deadline ? new Date(t.deadline).toLocaleDateString('fr-FR') : '—'}</td>
                <td>
                  <button class="btn btn-ghost btn-xs js-delete-task" data-id={t.id}>Suppr.</button>
                </td>
              </tr>
            );
          }) : (
            <tr class="js-empty-row">
              <td colspan="8" class="empty-row">Aucune tâche.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
    <div class="task-pagination" id="task-pagination">
      <div class="task-pagination-left">
        <button type="button" class="btn btn-ghost btn-xs" id="tasks-prev">← Précédent</button>
        <button type="button" class="btn btn-ghost btn-xs" id="tasks-next">Suivant →</button>
        <span class="task-pagination-info" id="tasks-page-info">Page 1 / 1</span>
      </div>
      <div class="task-pagination-right">
        <label for="tasks-per-page" class="muted">Lignes / page</label>
        <select id="tasks-per-page" class="input input-xs">
          <option value="5">5</option>
          <option value="10" selected>10</option>
          <option value="20">20</option>
          <option value="50">50</option>
        </select>
      </div>
    </div>
  </section>

  <section class="card mt-6 chat-section" id="admin-project-chat" data-user-id={user.id} data-user-name={userName}>
    <div class="chat-header">
      <h2 class="card-title">Chat du projet</h2>
      <span class="chat-subtitle">Visible uniquement par les bénévoles</span>
    </div>
    <div class="chat-messages" id="chat-messages" aria-live="polite">
      <p class="chat-placeholder">Chargement…</p>
    </div>
    <form id="chat-form" class="chat-input-row" autocomplete="off">
      <input
        type="text"
        id="chat-input"
        class="input chat-input"
        placeholder="Écrire un message…"
        maxlength="2000"
      />
      <button type="submit" class="btn btn-primary btn-sm">Envoyer</button>
    </form>
  </section>
</DashboardLayout>

<style>
  .top { display: flex; flex-direction: column; gap: 8px; }
  .back-link { color: var(--accent); text-decoration: none; font-size: var(--text-xs); }
  .back-link:hover { text-decoration: underline; }
  .page-title { font-size: var(--text-xl); font-weight: 700; }

  .grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-lg); }
  .card { border: var(--brutal-border-thin); background: var(--surface-raised); padding: var(--space-md); }
  .card-title { margin: 0 0 var(--space-sm); font-size: var(--text-base); font-weight: 700; }

  .brief-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
  .meta-chip { border: 1px solid var(--border-mid); padding: 2px 8px; font-size: 0.7rem; background: var(--surface); }
  .brief-text { margin: 0 0 8px; color: var(--text-secondary); font-size: var(--text-sm); }
  .brief-list { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; font-size: var(--text-xs); }
  .links-row { display: flex; gap: 8px; margin-top: 10px; }

  .row-form { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
  .members-list { display: flex; flex-direction: column; gap: 6px; }
  .member-item { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border-mid); padding: 6px 8px; font-size: var(--text-xs); }

  .task-form { display: grid; grid-template-columns: 1.8fr 1fr 1fr 1fr 1.3fr auto; gap: 8px; align-items: center; }
  .task-form-description { grid-column: 1 / -1; resize: vertical; min-height: 70px; }
  .task-desc-cell { max-width: 360px; white-space: normal; font-size: var(--text-xs); color: var(--text-secondary); }
  .task-pagination { margin-top: 10px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .task-pagination-left, .task-pagination-right { display: flex; align-items: center; gap: 8px; }
  .task-pagination-info { font-size: var(--text-xs); color: var(--text-muted); }

  .input { border: var(--brutal-border-thin); background: var(--surface); padding: 6px 8px; font-size: var(--text-xs); }
  .input-xs { padding: 4px 6px; font-size: 0.72rem; }

  .muted { color: var(--text-muted); font-size: var(--text-xs); }
  .empty-row { text-align: center; color: var(--text-muted); padding: 20px; }

  .mb-5 { margin-bottom: var(--space-lg); }
  .mb-6 { margin-bottom: var(--space-xl); }
  .mt-6 { margin-top: var(--space-xl); }

  .chat-section { padding: 0; }
  .chat-header { display: flex; justify-content: space-between; align-items: center; padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--border-mid); }
  .chat-header .card-title { margin: 0; }
  .chat-subtitle { font-size: 0.68rem; color: var(--text-muted); }
  .chat-messages { display: flex; flex-direction: column; gap: 6px; height: 340px; overflow-y: auto; padding: var(--space-sm) var(--space-md); }
  .chat-placeholder { font-size: var(--text-xs); color: var(--text-muted); margin: auto; }
  .chat-msg { display: flex; flex-direction: column; gap: 2px; padding: 6px 10px; max-width: 78%; }
  .chat-msg--own { align-self: flex-end; background: color-mix(in srgb, var(--accent) 12%, var(--surface-raised)); border-left: 3px solid var(--accent); }
  .chat-msg--other { align-self: flex-start; background: var(--surface); border: var(--brutal-border-thin); }
  .chat-msg-header { display: flex; gap: 8px; align-items: center; }
  .chat-msg-author { font-size: 0.68rem; font-weight: 700; color: var(--text-secondary); }
  .chat-msg-time { font-size: 0.64rem; color: var(--text-muted); }
  .chat-msg-body { font-size: var(--text-sm); word-break: break-word; white-space: pre-wrap; }
  .chat-input-row { display: flex; gap: 8px; padding: var(--space-sm) var(--space-md); border-top: 1px solid var(--border-mid); }
  .chat-input { flex: 1; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .task-form { grid-template-columns: 1fr; }
    .row-form { flex-direction: column; align-items: stretch; }
    .brief-list { grid-template-columns: 1fr; }
  }
</style>

<script>
  const projectId = new URL(window.location.href).pathname.split('/').pop();

  const addMemberForm = document.getElementById('form-add-member');
  const addTaskForm = document.getElementById('form-add-task');

  const apiPatchTask = async (id: string, payload: Record<string, unknown>): Promise<void> => {
    const res = await fetch(`/api/admin/project-tasks?id=${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('update failed');
  };

  addMemberForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(addMemberForm instanceof HTMLFormElement)) return;

    const fd = new FormData(addMemberForm);
    const userId = String(fd.get('user_id') ?? '');
    if (!userId) return;

    const res = await fetch('/api/admin/project-members', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ project_id: projectId, user_id: userId }),
    });

    if (!res.ok) {
      const out = await res.json().catch(() => ({ error: 'Erreur' }));
      alert(out.error ?? 'Erreur lors de l\'affectation');
      return;
    }

    window.location.reload();
  });

  document.querySelectorAll('.js-remove-member').forEach((el) => {
    el.addEventListener('click', async () => {
      const userId = el.getAttribute('data-user-id');
      if (!userId || !projectId) return;
      if (!confirm('Retirer ce bénévole du projet ?')) return;

      const res = await fetch(`/api/admin/project-members?project_id=${projectId}&user_id=${userId}`, {
        method: 'DELETE',
      });

      if (!res.ok) {
        alert('Erreur lors du retrait.');
        return;
      }

      window.location.reload();
    });
  });

  addTaskForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(addTaskForm instanceof HTMLFormElement)) return;

    const fd = new FormData(addTaskForm);
    const payload = {
      project_id: projectId,
      title: String(fd.get('title') ?? '').trim(),
      description: String(fd.get('description') ?? '').trim() || null,
      task_type: String(fd.get('task_type') ?? 'general'),
      status: String(fd.get('status') ?? 'todo'),
      priority: String(fd.get('priority') ?? 'medium'),
      assignee_id: String(fd.get('assignee_id') ?? '') || null,
    };

    const res = await fetch('/api/admin/project-tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      const out = await res.json().catch(() => ({ error: 'Erreur' }));
      alert(out.error ?? 'Erreur lors de la création de tâche');
      return;
    }

    window.location.reload();
  });

  document.querySelectorAll('.js-task-status').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const id = el.getAttribute('data-id');
      if (!id) return;
      try {
        await apiPatchTask(id, { status: el.value });
      } catch {
        alert('Erreur mise à jour statut');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-task-priority').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const id = el.getAttribute('data-id');
      if (!id) return;
      try {
        await apiPatchTask(id, { priority: el.value });
      } catch {
        alert('Erreur mise à jour priorité');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-task-type').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const id = el.getAttribute('data-id');
      if (!id) return;
      try {
        await apiPatchTask(id, { task_type: el.value });
      } catch {
        alert('Erreur mise à jour type de tâche');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-task-assignee').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const id = el.getAttribute('data-id');
      if (!id) return;
      try {
        await apiPatchTask(id, { assignee_id: el.value || null });
      } catch {
        alert('Erreur mise à jour affectation');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-delete-task').forEach((el) => {
    el.addEventListener('click', async () => {
      const id = el.getAttribute('data-id');
      if (!id) return;
      if (!confirm('Supprimer cette tâche ?')) return;

      const res = await fetch(`/api/admin/project-tasks?id=${id}`, { method: 'DELETE' });
      if (!res.ok) {
        alert('Erreur lors de la suppression.');
        return;
      }

      window.location.reload();
    });
  });

  function initTaskPagination() {
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#tasks-tbody tr[data-task-row="1"]'));
    const emptyRow = document.querySelector<HTMLTableRowElement>('#tasks-tbody .js-empty-row');
    const pager = document.getElementById('task-pagination');
    const prevBtn = document.getElementById('tasks-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('tasks-next') as HTMLButtonElement | null;
    const info = document.getElementById('tasks-page-info');
    const perPageSelect = document.getElementById('tasks-per-page') as HTMLSelectElement | null;

    if (rows.length === 0) {
      if (pager) pager.style.display = 'none';
      if (emptyRow) emptyRow.style.display = '';
      return;
    }

    if (!prevBtn || !nextBtn || !info || !perPageSelect) return;

    let currentPage = 1;
    let perPage = Number(perPageSelect.value) || 10;

    const render = () => {
      const totalPages = Math.max(1, Math.ceil(rows.length / perPage));
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * perPage;
      const end = start + perPage;

      rows.forEach((row, index) => {
        row.style.display = index >= start && index < end ? '' : 'none';
      });

      info.textContent = `Page ${currentPage} / ${totalPages} (${rows.length} tâches)`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
      if (emptyRow) emptyRow.style.display = 'none';
    };

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage -= 1;
        render();
      }
    });

    nextBtn.addEventListener('click', () => {
      const totalPages = Math.max(1, Math.ceil(rows.length / perPage));
      if (currentPage < totalPages) {
        currentPage += 1;
        render();
      }
    });

    perPageSelect.addEventListener('change', () => {
      perPage = Number(perPageSelect.value) || 10;
      currentPage = 1;
      render();
    });

    render();
  }

  initTaskPagination();

  const chatRoot = document.getElementById('admin-project-chat');

  function esc(str: unknown): string {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  if (chatRoot) {
    const currentUserId = chatRoot.getAttribute('data-user-id') ?? '';
    const currentUserName = chatRoot.getAttribute('data-user-name') ?? 'Admin';
    const chatMessages = document.getElementById('chat-messages');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    let lastMsgTime = '';

    function renderChatMsg(msg: Record<string, unknown>): string {
      const authorId = String(msg.author_id ?? '');
      const isOwn = authorId === currentUserId;
      const time = new Date(String(msg.created_at ?? '')).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
      return `<div class="chat-msg ${isOwn ? 'chat-msg--own' : 'chat-msg--other'}" data-msg-id="${esc(msg.id)}">
        <div class="chat-msg-header">
          <span class="chat-msg-author">${esc(isOwn ? 'Moi' : msg.author_name)}</span>
          <span class="chat-msg-time">${time}</span>
        </div>
        <div class="chat-msg-body">${esc(msg.content)}</div>
      </div>`;
    }

    async function fetchMessages(since = ''): Promise<Array<Record<string, unknown>>> {
      let url = `/api/benevole/project-messages?project_id=${encodeURIComponent(projectId ?? '')}`;
      if (since) url += `&since=${encodeURIComponent(since)}`;
      const res = await fetch(url);
      if (!res.ok) return [];
      const { data } = await res.json();
      return Array.isArray(data) ? data : [];
    }

    async function initChat() {
      if (!chatMessages) return;
      const messages = await fetchMessages();
      if (messages.length === 0) {
        chatMessages.innerHTML = '<p class="chat-placeholder">Aucun message pour le moment.</p>';
      } else {
        chatMessages.innerHTML = messages.map(renderChatMsg).join('');
        lastMsgTime = String(messages[messages.length - 1]?.created_at ?? '');
      }
      chatMessages.scrollTop = chatMessages.scrollHeight;

      setInterval(async () => {
        if (!chatMessages) return;
        const newMessages = await fetchMessages(lastMsgTime);
        if (newMessages.length === 0) return;
        const placeholder = chatMessages.querySelector('.chat-placeholder');
        if (placeholder) placeholder.remove();
        chatMessages.insertAdjacentHTML('beforeend', newMessages.map(renderChatMsg).join(''));
        lastMsgTime = String(newMessages[newMessages.length - 1]?.created_at ?? '');
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 4000);
    }

    chatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!(chatInput instanceof HTMLInputElement)) return;
      const content = chatInput.value.trim();
      if (!content) return;

      const submitBtn = chatForm.querySelector('button[type="submit"]');
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
      chatInput.disabled = true;

      const res = await fetch('/api/benevole/project-messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project_id: projectId, content }),
      });

      if (res.ok) {
        const { data: msg } = await res.json();
        if (chatMessages && msg) {
          const placeholder = chatMessages.querySelector('.chat-placeholder');
          if (placeholder) placeholder.remove();
          chatMessages.insertAdjacentHTML('beforeend', renderChatMsg({ ...msg, author_name: currentUserName, author_id: currentUserId }));
          lastMsgTime = String(msg.created_at ?? lastMsgTime);
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }
        chatInput.value = '';
      } else {
        const err = await res.json().catch(() => ({}));
        alert((err as { error?: string }).error ?? 'Impossible d\'envoyer le message.');
      }

      chatInput.disabled = false;
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
      chatInput.focus();
    });

    chatInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        chatForm?.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
      }
    });

    initChat();
  }
</script>
