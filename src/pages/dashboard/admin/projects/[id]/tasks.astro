---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAdmin } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const projectId = Astro.params.id ?? '';
if (!projectId) return Astro.redirect('/dashboard/admin/projects');

const adminSupabase = createSupabaseAdminClient();

const [
  { data: project, error: projectError },
  { data: tasksRaw },
  { data: membersRaw },
  { data: profilesRaw },
] = await Promise.all([
  adminSupabase
    .from('projects')
    .select('id, title, status, priority')
    .eq('id', projectId)
    .single(),
  adminSupabase
    .from('project_tasks')
    .select('id, title, description, task_type, status, priority, assignee_id, deadline, position, created_at')
    .eq('project_id', projectId)
    .order('created_at', { ascending: false }),
  adminSupabase
    .from('project_members')
    .select('user_id')
    .eq('project_id', projectId),
  adminSupabase
    .from('profiles')
    .select('id, full_name, email'),
]);

if (projectError || !project) return Astro.redirect('/dashboard/admin/projects');

interface Task {
  id: string;
  title: string;
  description: string | null;
  task_type: string;
  status: string;
  priority: string;
  assignee_id: string | null;
  deadline: string | null;
  position: number;
  created_at: string;
}

const tasks = (tasksRaw ?? []) as Task[];
const members = membersRaw ?? [];

const profileMap: Record<string, { full_name: string | null; email: string }> = {};
for (const p of profilesRaw ?? []) {
  profileMap[p.id] = { full_name: p.full_name, email: p.email };
}

const memberOptions = members.map((m) => {
  const p = profileMap[m.user_id];
  return {
    id: m.user_id,
    name: p?.full_name?.trim() || p?.email || m.user_id,
  };
});

const stats = {
  total: tasks.length,
  todo: tasks.filter((t) => t.status === 'todo').length,
  progress: tasks.filter((t) => t.status === 'in_progress').length,
  done: tasks.filter((t) => t.status === 'done').length,
};

const taskTypeLabel: Record<string, string> = {
  general: 'Général',
  dev: 'Dev',
  db: 'DB',
  design: 'Design',
  qa: 'QA/Test',
  ops: 'Ops',
  doc: 'Documentation',
};
---

<DashboardLayout title={`Tâches: ${project.title}`} activePage="projects" userName={userName} authResult={result}>
  <div class="tasks-page-header mb-6">
    <div>
      <a href={`/dashboard/admin/projects/${projectId}`} class="back-link">← Retour au projet</a>
      <h1 class="page-title">Gestion des tâches</h1>
      <p class="muted">Espace dédié pour créer, filtrer et piloter les tâches du projet.</p>
    </div>
    <div class="header-actions">
      <a href={`/dashboard/admin/projects/${projectId}`} class="btn btn-ghost btn-sm">Voir le projet</a>
    </div>
  </div>

  <section class="task-stats mb-6">
    <article class="stat-card"><span>Total</span><strong>{stats.total}</strong></article>
    <article class="stat-card"><span>À faire</span><strong>{stats.todo}</strong></article>
    <article class="stat-card"><span>En cours</span><strong>{stats.progress}</strong></article>
    <article class="stat-card"><span>Terminées</span><strong>{stats.done}</strong></article>
  </section>

  <section class="task-workspace">
    <div class="task-panel card">
      <h2 class="card-title">Ajouter une tâche</h2>
      <form id="form-add-task" class="create-form">
        <input type="hidden" name="project_id" value={projectId} />

        <label class="label" for="title">Nom de la tâche *</label>
        <input id="title" type="text" name="title" class="input" required maxlength="200" placeholder="Ex: Intégration API notifications" />

        <label class="label" for="description">Description</label>
        <textarea id="description" name="description" class="input" rows="5" maxlength="1000" placeholder="Détails, critères d'acceptation, points techniques..."></textarea>

        <label class="label" for="task_type">Type de tâche</label>
        <select id="task_type" name="task_type" class="input">
          <option value="general" selected>Général</option>
          <option value="dev">Dev</option>
          <option value="db">DB</option>
          <option value="design">Design</option>
          <option value="qa">QA/Test</option>
          <option value="ops">Ops</option>
          <option value="doc">Documentation</option>
        </select>

        <div class="create-row">
          <div>
            <label class="label" for="status">Statut</label>
            <select id="status" name="status" class="input">
              <option value="todo" selected>À faire</option>
              <option value="in_progress">En cours</option>
              <option value="review">Révision</option>
              <option value="done">Terminé</option>
            </select>
          </div>
          <div>
            <label class="label" for="priority">Priorité</label>
            <select id="priority" name="priority" class="input">
              <option value="low">Faible</option>
              <option value="medium" selected>Moyenne</option>
              <option value="high">Haute</option>
            </select>
          </div>
        </div>

        <label class="label" for="assignee">Assigné à</label>
        <select id="assignee" name="assignee_id" class="input">
          <option value="">Non assigné</option>
          {memberOptions.map((m) => <option value={m.id}>{m.name}</option>)}
        </select>

        <button type="submit" class="btn btn-primary btn-sm">Créer la tâche</button>
      </form>
    </div>

    <div class="task-panel card">
      <h2 class="card-title">Pilotage des tâches</h2>

      <div class="task-filters">
        <input id="filter-search" class="input" type="search" placeholder="Rechercher une tâche..." />
        <select id="filter-status" class="input">
          <option value="">Tous les statuts</option>
          <option value="todo">À faire</option>
          <option value="in_progress">En cours</option>
          <option value="review">Révision</option>
          <option value="done">Terminé</option>
        </select>
        <select id="filter-type" class="input">
          <option value="">Tous les types</option>
          <option value="general">Général</option>
          <option value="dev">Dev</option>
          <option value="db">DB</option>
          <option value="design">Design</option>
          <option value="qa">QA/Test</option>
          <option value="ops">Ops</option>
          <option value="doc">Documentation</option>
        </select>
        <select id="filter-assignee" class="input">
          <option value="">Tous les assignés</option>
          <option value="">Non assigné (dans la table)</option>
          {memberOptions.map((m) => <option value={m.id}>{m.name}</option>)}
        </select>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Tâche</th>
              <th>Type</th>
              <th>Statut</th>
              <th>Priorité</th>
              <th>Assigné</th>
              <th>Échéance</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="tasks-tbody">
            {tasks.length > 0 ? tasks.map((t) => {
              const assignee = t.assignee_id ? (profileMap[t.assignee_id]?.full_name ?? profileMap[t.assignee_id]?.email ?? t.assignee_id) : 'Non assigné';
              return (
                <tr
                  data-task-row="1"
                  data-title={t.title.toLowerCase()}
                  data-description={(t.description ?? '').toLowerCase()}
                  data-status={t.status}
                  data-type={t.task_type ?? 'general'}
                  data-assignee={t.assignee_id ?? ''}
                >
                  <td>
                    <div class="task-name">{t.title}</div>
                    <div class="task-desc">{t.description || '—'}</div>
                  </td>
                  <td>
                    <select class="input input-xs js-task-type" data-id={t.id}>
                      <option value="general" selected={t.task_type === 'general'}>{taskTypeLabel.general}</option>
                      <option value="dev" selected={t.task_type === 'dev'}>{taskTypeLabel.dev}</option>
                      <option value="db" selected={t.task_type === 'db'}>{taskTypeLabel.db}</option>
                      <option value="design" selected={t.task_type === 'design'}>{taskTypeLabel.design}</option>
                      <option value="qa" selected={t.task_type === 'qa'}>{taskTypeLabel.qa}</option>
                      <option value="ops" selected={t.task_type === 'ops'}>{taskTypeLabel.ops}</option>
                      <option value="doc" selected={t.task_type === 'doc'}>{taskTypeLabel.doc}</option>
                    </select>
                  </td>
                  <td>
                    <select class="input input-xs js-task-status" data-id={t.id}>
                      <option value="todo" selected={t.status === 'todo'}>À faire</option>
                      <option value="in_progress" selected={t.status === 'in_progress'}>En cours</option>
                      <option value="review" selected={t.status === 'review'}>Révision</option>
                      <option value="done" selected={t.status === 'done'}>Terminé</option>
                    </select>
                  </td>
                  <td>
                    <select class="input input-xs js-task-priority" data-id={t.id}>
                      <option value="low" selected={t.priority === 'low'}>Faible</option>
                      <option value="medium" selected={t.priority === 'medium'}>Moyenne</option>
                      <option value="high" selected={t.priority === 'high'}>Haute</option>
                    </select>
                  </td>
                  <td>
                    <select class="input input-xs js-task-assignee" data-id={t.id}>
                      <option value="">Non assigné</option>
                      {memberOptions.map((m) => <option value={m.id} selected={t.assignee_id === m.id}>{m.name}</option>)}
                    </select>
                    <div class="muted tiny">{assignee}</div>
                  </td>
                  <td class="muted">{t.deadline ? new Date(t.deadline).toLocaleDateString('fr-FR') : '—'}</td>
                  <td>
                    <button class="btn btn-ghost btn-xs js-delete-task" data-id={t.id}>Suppr.</button>
                  </td>
                </tr>
              );
            }) : (
              <tr class="js-empty-row">
                <td colspan="7" class="empty-row">Aucune tâche.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <div class="task-pagination" id="task-pagination">
        <div class="task-pagination-left">
          <button type="button" class="btn btn-ghost btn-xs" id="tasks-prev">← Précédent</button>
          <button type="button" class="btn btn-ghost btn-xs" id="tasks-next">Suivant →</button>
          <span class="task-pagination-info" id="tasks-page-info">Page 1 / 1</span>
        </div>
        <div class="task-pagination-right">
          <label class="muted" for="tasks-per-page">Lignes / page</label>
          <select id="tasks-per-page" class="input input-xs">
            <option value="5">5</option>
            <option value="10" selected>10</option>
            <option value="20">20</option>
            <option value="50">50</option>
          </select>
        </div>
      </div>
    </div>
  </section>
</DashboardLayout>

<style>
  .tasks-page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .back-link { color: var(--accent); text-decoration: none; font-size: var(--text-xs); }
  .back-link:hover { text-decoration: underline; }
  .page-title { font-size: var(--text-xl); margin: 0; }
  .header-actions { display: flex; gap: 8px; }

  .task-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .stat-card { border: var(--brutal-border-thin); background: var(--surface-raised); padding: 10px; display: flex; flex-direction: column; gap: 4px; }
  .stat-card span { font-size: var(--text-xs); color: var(--text-muted); }
  .stat-card strong { font-size: var(--text-lg); }

  .task-workspace { display: grid; grid-template-columns: 360px 1fr; gap: var(--space-lg); align-items: start; }
  .task-panel { border: var(--brutal-border-thin); background: var(--surface-raised); padding: var(--space-md); }
  .card-title { margin: 0 0 var(--space-sm); }

  .create-form { display: flex; flex-direction: column; gap: 8px; }
  .create-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .label { font-size: var(--text-xs); color: var(--text-secondary); font-weight: 600; }

  .task-filters { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 8px; margin-bottom: 10px; }
  .task-name { font-weight: 700; font-size: var(--text-xs); margin-bottom: 4px; }
  .task-desc { font-size: var(--text-xs); color: var(--text-secondary); white-space: normal; max-width: 420px; }
  .tiny { font-size: 0.68rem; margin-top: 4px; }

  .input { border: var(--brutal-border-thin); background: var(--surface); padding: 6px 8px; font-size: var(--text-xs); }
  .input-xs { padding: 4px 6px; font-size: 0.72rem; }

  .task-pagination { margin-top: 10px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .task-pagination-left, .task-pagination-right { display: flex; align-items: center; gap: 8px; }
  .task-pagination-info { font-size: var(--text-xs); color: var(--text-muted); }

  .muted { color: var(--text-muted); font-size: var(--text-xs); }
  .empty-row { text-align: center; color: var(--text-muted); padding: 20px; }
  .mb-6 { margin-bottom: var(--space-xl); }

  @media (max-width: 1100px) {
    .task-workspace { grid-template-columns: 1fr; }
  }

  @media (max-width: 800px) {
    .task-stats { grid-template-columns: repeat(2, 1fr); }
    .task-filters { grid-template-columns: 1fr; }
    .create-row { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ projectId }}>
  const addTaskForm = document.getElementById('form-add-task');

  const apiPatchTask = async (id, payload) => {
    const res = await fetch(`/api/admin/project-tasks?id=${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('update failed');
  };

  addTaskForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(addTaskForm instanceof HTMLFormElement)) return;

    const fd = new FormData(addTaskForm);
    const payload = {
      project_id: projectId,
      title: String(fd.get('title') ?? '').trim(),
      description: String(fd.get('description') ?? '').trim() || null,
      task_type: String(fd.get('task_type') ?? 'general'),
      status: String(fd.get('status') ?? 'todo'),
      priority: String(fd.get('priority') ?? 'medium'),
      assignee_id: String(fd.get('assignee_id') ?? '') || null,
    };

    const res = await fetch('/api/admin/project-tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      const out = await res.json().catch(() => ({ error: 'Erreur' }));
      alert(out.error ?? 'Erreur lors de la création de tâche');
      return;
    }

    window.location.reload();
  });

  document.querySelectorAll('.js-task-status').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const id = el.getAttribute('data-id');
      if (!id) return;
      try {
        await apiPatchTask(id, { status: el.value });
      } catch {
        alert('Erreur mise à jour statut');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-task-priority').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const id = el.getAttribute('data-id');
      if (!id) return;
      try {
        await apiPatchTask(id, { priority: el.value });
      } catch {
        alert('Erreur mise à jour priorité');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-task-type').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const id = el.getAttribute('data-id');
      if (!id) return;
      try {
        await apiPatchTask(id, { task_type: el.value });
      } catch {
        alert('Erreur mise à jour type de tâche');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-task-assignee').forEach((el) => {
    el.addEventListener('change', async () => {
      if (!(el instanceof HTMLSelectElement)) return;
      const id = el.getAttribute('data-id');
      if (!id) return;
      try {
        await apiPatchTask(id, { assignee_id: el.value || null });
      } catch {
        alert('Erreur mise à jour affectation');
        window.location.reload();
      }
    });
  });

  document.querySelectorAll('.js-delete-task').forEach((el) => {
    el.addEventListener('click', async () => {
      const id = el.getAttribute('data-id');
      if (!id) return;
      if (!confirm('Supprimer cette tâche ?')) return;

      const res = await fetch(`/api/admin/project-tasks?id=${id}`, { method: 'DELETE' });
      if (!res.ok) {
        alert('Erreur lors de la suppression.');
        return;
      }

      window.location.reload();
    });
  });

  function initTasksFilterAndPagination() {
    const rows = Array.from(document.querySelectorAll('#tasks-tbody tr[data-task-row="1"]'));
    const emptyRow = document.querySelector('#tasks-tbody .js-empty-row');
    const pager = document.getElementById('task-pagination');
    const prevBtn = document.getElementById('tasks-prev');
    const nextBtn = document.getElementById('tasks-next');
    const pageInfo = document.getElementById('tasks-page-info');
    const perPageSelect = document.getElementById('tasks-per-page');

    const searchInput = document.getElementById('filter-search');
    const statusFilter = document.getElementById('filter-status');
    const typeFilter = document.getElementById('filter-type');
    const assigneeFilter = document.getElementById('filter-assignee');

    if (!prevBtn || !nextBtn || !pageInfo || !perPageSelect || !searchInput || !statusFilter || !typeFilter || !assigneeFilter) {
      return;
    }

    if (rows.length === 0) {
      if (pager) pager.style.display = 'none';
      if (emptyRow) emptyRow.style.display = '';
      return;
    }

    let filteredRows = rows.slice();
    let currentPage = 1;
    let perPage = Number(perPageSelect.value) || 10;

    const applyFilters = () => {
      const q = searchInput.value.trim().toLowerCase();
      const status = statusFilter.value;
      const type = typeFilter.value;
      const assignee = assigneeFilter.value;

      filteredRows = rows.filter((row) => {
        const rowTitle = row.getAttribute('data-title') || '';
        const rowDesc = row.getAttribute('data-description') || '';
        const rowStatus = row.getAttribute('data-status') || '';
        const rowType = row.getAttribute('data-type') || '';
        const rowAssignee = row.getAttribute('data-assignee') || '';

        const matchQuery = !q || rowTitle.includes(q) || rowDesc.includes(q);
        const matchStatus = !status || rowStatus === status;
        const matchType = !type || rowType === type;
        const matchAssignee = !assignee || rowAssignee === assignee;
        return matchQuery && matchStatus && matchType && matchAssignee;
      });
      currentPage = 1;
      render();
    };

    const render = () => {
      const total = filteredRows.length;
      const totalPages = Math.max(1, Math.ceil(total / perPage));
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * perPage;
      const end = start + perPage;
      const visibleSet = new Set(filteredRows.slice(start, end));

      rows.forEach((row) => {
        row.style.display = visibleSet.has(row) ? '' : 'none';
      });

      pageInfo.textContent = `Page ${currentPage} / ${totalPages} (${total} résultat${total > 1 ? 's' : ''})`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;

      if (emptyRow) emptyRow.style.display = total === 0 ? '' : 'none';
      if (pager) pager.style.display = total === 0 ? 'none' : 'flex';
    };

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage -= 1;
        render();
      }
    });

    nextBtn.addEventListener('click', () => {
      const totalPages = Math.max(1, Math.ceil(filteredRows.length / perPage));
      if (currentPage < totalPages) {
        currentPage += 1;
        render();
      }
    });

    perPageSelect.addEventListener('change', () => {
      perPage = Number(perPageSelect.value) || 10;
      currentPage = 1;
      render();
    });

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    typeFilter.addEventListener('change', applyFilters);
    assigneeFilter.addEventListener('change', applyFilters);

    render();
  }

  initTasksFilterAndPagination();
</script>
