---
// src/pages/dashboard/admin/reports.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { session, supabase } = result;
const userName = session.user.user_metadata?.full_name ?? session.user.email?.split('@')[0] ?? 'Admin';

const page       = Number(Astro.url.searchParams.get('page') ?? 1);
const perPage    = 20;
const from       = (page - 1) * perPage;
const filterStatus = Astro.url.searchParams.get('status') ?? '';
const search     = Astro.url.searchParams.get('q') ?? '';

let query = supabase
  .from('reports')
  .select(`
    id, title, status, created_at, ai_score,
    profiles ( email, full_name )
  `, { count: 'exact' })
  .order('created_at', { ascending: false })
  .range(from, from + perPage - 1);

if (filterStatus) query = query.eq('status', filterStatus);
if (search) query = query.ilike('title', `%${search}%`);

const { data: reports, count } = await query;
const totalPages = Math.ceil((count ?? 0) / perPage);

function statusCls(s: string) {
  return s === 'analyzed' ? 'ok' : s === 'pending' ? 'warn' : s === 'rejected' ? 'err' : 'info';
}
---

<DashboardLayout title="Signalements" role="admin" activePage="reports" userName={userName}>

  <div style="margin-bottom: 24px; display:flex; align-items:center; justify-content:space-between;">
    <div>
      <h1 style="font-size: 1.2rem; font-weight: 400; letter-spacing: -0.02em;">Tous les signalements</h1>
      <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 3px;">{count ?? 0} au total</p>
    </div>
  </div>

  <!-- Filtres -->
  <form method="get" class="filters-bar">
    <input
      type="search"
      name="q"
      placeholder="Rechercher..."
      value={search}
      class="filter-input"
      style="min-width: 200px;"
    />
    <select name="status" class="filter-input" onchange="this.form.submit()">
      <option value="">Tous les statuts</option>
      <option value="pending"  selected={filterStatus === 'pending'}>En attente</option>
      <option value="analyzed" selected={filterStatus === 'analyzed'}>Analysé</option>
      <option value="rejected" selected={filterStatus === 'rejected'}>Rejeté</option>
    </select>
    <button type="submit" class="btn btn-primary" style="font-size:0.8rem;">Filtrer</button>
    {(filterStatus || search) && (
      <a href="/dashboard/admin/reports" class="btn btn-ghost" style="font-size:0.78rem;">× Réinitialiser</a>
    )}
  </form>

  <!-- Tableau -->
  <div class="card" style="padding: 0; overflow:hidden;">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Titre</th>
            <th>Utilisateur</th>
            <th>Statut</th>
            <th>Score IA</th>
            <th>Date</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {reports && reports.length > 0 ? reports.map((r: any) => {
            const d = new Date(r.created_at);
            const sc = statusCls(r.status);
            const score = r.ai_score;
            const user = r.profiles;
            return (
              <tr>
                <td>
                  <span style="font-family:var(--font-mono); font-size:0.72rem; color:var(--text-muted);">
                    #{r.id?.slice(0, 8)}
                  </span>
                </td>
                <td style="max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                  {r.title ?? '—'}
                </td>
                <td style="font-size:0.78rem; color:var(--text-secondary);">
                  {user?.email ?? user?.full_name ?? '—'}
                </td>
                <td>
                  <span class={`badge badge-${sc}`}>{r.status}</span>
                </td>
                <td style="font-family:var(--font-mono); font-size:0.78rem;">
                  {score !== null && score !== undefined ? `${score}/100` : '—'}
                </td>
                <td style="font-size:0.75rem; font-family:var(--font-mono); color:var(--text-muted);">
                  {d.toLocaleDateString('fr-FR')}
                </td>
                <td>
                  <a
                    href={`/dashboard/admin/reports/${r.id}`}
                    class="btn btn-ghost"
                    style="font-size:0.72rem; padding:4px 8px;"
                  >Voir</a>
                </td>
              </tr>
            );
          }) : (
            <tr>
              <td colspan="7" style="text-align:center; color:var(--text-muted); padding:32px 12px; font-size:0.83rem;">
                Aucun signalement trouvé.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  {totalPages > 1 && (
    <div style="display:flex; gap:8px; justify-content:center; margin-top:20px;">
      {page > 1 && (
        <a href={`?page=${page - 1}&status=${filterStatus}&q=${search}`} class="btn btn-ghost">← Précédent</a>
      )}
      <span style="padding: 7px 14px; font-size:0.82rem; color: var(--text-muted);">
        {page} / {totalPages}
      </span>
      {page < totalPages && (
        <a href={`?page=${page + 1}&status=${filterStatus}&q=${search}`} class="btn btn-ghost">Suivant →</a>
      )}
    </div>
  )}

</DashboardLayout>