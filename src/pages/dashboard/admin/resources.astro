---
// src/pages/dashboard/admin/resources.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin }  from '../../../lib/auth';
import type { Resource } from '../../../types/resources';
import {
  formatFileSize,
  fileIcon,
  fileTypeLabel,
  RESOURCE_CATEGORIES,
} from '../../../types/resources';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved  = Astro.url.searchParams.get('saved') === '1';
const error  = Astro.url.searchParams.get('error') ?? '';

// Filtre par catégorie
const filterCat = Astro.url.searchParams.get('category') ?? '';

let query = supabase
  .from('resources')
  .select('*')
  .order('created_at', { ascending: false });

if (filterCat) query = query.eq('category', filterCat);

const { data: resourcesRaw } = await query;
const resources = (resourcesRaw ?? []) as Resource[];

// ── Pré-calcul (aucun < > dans le template) ───────────────────────────────

interface ResourceRow {
  r:            Resource;
  icon:         string;
  typeLabel:    string;
  sizeLabel:    string;
  dateLabel:    string;
  toggleVal:    string;
  publishBadge: string;
  publishLabel: string;
}

const rows: ResourceRow[] = resources.map((r: Resource): ResourceRow => ({
  r,
  icon:         fileIcon(r.file_type),
  typeLabel:    fileTypeLabel(r.file_type),
  sizeLabel:    formatFileSize(r.file_size),
  dateLabel:    new Date(r.created_at).toLocaleDateString('fr-FR'),
  toggleVal:    String(!r.is_published),
  publishBadge: r.is_published ? 'badge-ok' : 'badge-neutral',
  publishLabel: r.is_published ? 'Publié' : 'Brouillon',
}));

const hasResources   = rows.length !== 0;
const hasFilter      = filterCat !== '';
const totalLabel     = `${resources.length} ressource${resources.length !== 1 ? 's' : ''}`;
---

<DashboardLayout title="Ressources" activePage="resources" userName={userName} authResult={result}>

  <div class="header-row">
    <div>
      <h1>Ressources</h1>
      <p class="subtitle">{totalLabel} au total.</p>
    </div>
    <button class="btn btn-primary" data-modal-open="modal-add">
      + Ajouter une ressource
    </button>
  </div>

  {saved && <div class="flash flash-ok" role="alert">✓ Opération réussie.</div>}
  {error  && <div class="flash flash-err" role="alert">✗ {decodeURIComponent(error)}</div>}

  <!-- Filtre par catégorie -->
  <form method="get" class="filters-bar">
    <select name="category" class="filter-input" data-autosubmit="1">
      <option value="">Toutes les catégories</option>
      {RESOURCE_CATEGORIES.map((cat) => (
        <option value={cat} selected={filterCat === cat}>{cat}</option>
      ))}
    </select>
    {hasFilter && (
      <a href="/dashboard/admin/resources" class="btn btn-ghost btn-sm">× Réinitialiser</a>
    )}
  </form>

  <!-- Table des ressources -->
  <div class="card card-flush">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Fichier</th>
            <th>Catégorie</th>
            <th>Taille</th>
            <th>Téléchargements</th>
            <th>Statut</th>
            <th>Ajouté le</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {hasResources ? rows.map(({ r, icon, typeLabel, sizeLabel, dateLabel, toggleVal, publishBadge, publishLabel }) => (
            <tr>
              <td>
                <div class="file-cell">
                  <span class="file-icon">{icon}</span>
                  <div>
                    <div class="file-name">{r.title}</div>
                    <div class="file-meta">{r.file_name} · {typeLabel}</div>
                  </div>
                </div>
              </td>
              <td><span class="badge badge-info">{r.category}</span></td>
              <td class="mono sm">{sizeLabel}</td>
              <td class="mono sm">{r.downloads}</td>
              <td><span class={`badge ${publishBadge}`}>{publishLabel}</span></td>
              <td class="mono xs muted">{dateLabel}</td>
              <td>
                <div class="row-actions">
                  <form method="POST" action="/api/admin/resources/toggle">
                    <input type="hidden" name="resource_id"  value={r.id} />
                    <input type="hidden" name="is_published"  value={toggleVal} />
                    <button type="submit" class="btn btn-ghost btn-xs">
                      {r.is_published ? 'Dépublier' : 'Publier'}
                    </button>
                  </form>
                  <form method="POST" action="/api/admin/resources/supprimer">
                    <input type="hidden" name="resource_id" value={r.id} />
                    <button
                      type="submit"
                      class="btn btn-danger btn-xs"
                      data-confirm="'Supprimer cette ressource définitivement ?'"
                    >✕</button>
                  </form>
                </div>
              </td>
            </tr>
          )) : (
            <tr>
              <td colspan="7" class="empty-row">
                {hasFilter ? 'Aucune ressource dans cette catégorie.' : 'Aucune ressource pour le moment.'}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal : ajouter une ressource -->
  <dialog id="modal-add" class="modal">
    <div class="modal-box">
      <div class="modal-header">
        <span class="card-title">Nouvelle ressource</span>
        <button class="btn btn-ghost" data-modal-close="modal-add">✕</button>
      </div>
      <form
        method="POST"
        action="/api/admin/resources/upload"
        enctype="multipart/form-data"
        class="modal-form"
      >
        <div class="field">
          <label>Titre *</label>
          <input type="text" name="title" required placeholder="Ex : Guide du prompt engineering" />
        </div>
        <div class="field">
          <label>Description</label>
          <textarea name="description" rows={3} placeholder="Courte description de la ressource…"></textarea>
        </div>
        <div class="field">
          <label>Catégorie *</label>
          <select name="category" required>
            <option value="">Choisir une catégorie…</option>
            {RESOURCE_CATEGORIES.map((cat) => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label>Fichier * <span class="field-hint">(PDF, image, zip, vidéo — max 50 Mo)</span></label>
          <input type="file" name="file" required accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.svg,.zip,.docx,.xlsx,.pptx,.txt,.md,.csv,.mp4,.webm" />
        </div>
        <div class="checkbox-row">
          <input type="checkbox" id="pub-resource" name="is_published" value="true" />
          <label for="pub-resource" class="label-sm">Publier immédiatement</label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Uploader</button>
          <button type="button" class="btn btn-ghost" data-modal-close="modal-add">Annuler</button>
        </div>
      </form>
    </div>
  </dialog>

</DashboardLayout>

<style>
  .header-row  { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .subtitle    { margin-top: 6px; }
  .filters-bar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
  .filter-input { padding: 7px 10px; font-size: 0.82rem; border: var(--brutal-border-thin); background: var(--surface); }
  .card-flush  { padding: 0; overflow: hidden; }

  /* Cellule fichier */
  .file-cell   { display: flex; align-items: center; gap: 10px; }
  .file-icon   { font-size: 1.4rem; flex-shrink: 0; }
  .file-name   { font-weight: 600; font-size: 0.88rem; }
  .file-meta   { font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 2px; }

  /* Table utils */
  .mono        { font-family: var(--font-mono); }
  .sm          { font-size: 0.82rem; }
  .xs          { font-size: 0.75rem; }
  .muted       { color: var(--text-muted); }
  .empty-row   { text-align: center; color: var(--text-muted); padding: 40px 12px; font-size: 0.85rem; }
  .row-actions { display: flex; gap: 6px; }

  /* Boutons */
  .btn-sm { font-size: 0.82rem; }
  .btn-xs { font-size: 0.75rem; padding: 4px 8px; min-height: unset; }

  /* Modal */
  .modal           { border: var(--brutal-border); box-shadow: var(--shadow-xl); padding: 0; background: var(--surface); max-width: 540px; width: 90vw; }
  .modal::backdrop { background: rgba(0,0,0,0.5); }
  .modal-box       { padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .modal-header    { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: var(--brutal-border-thin); }
  .modal-form      { display: flex; flex-direction: column; gap: 14px; }

  /* Champs */
  .field           { display: flex; flex-direction: column; gap: 6px; }
  .field label     { font-size: var(--text-xs); font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }
  .field input,
  .field textarea,
  .field select    { padding: 10px 13px; font-size: var(--text-base); width: 100%; font-family: var(--font-sans); border: var(--brutal-border-thin); background: var(--surface); }
  .field textarea  { resize: vertical; }
  .field-hint      { font-size: 0.75rem; color: var(--text-muted); font-weight: 400; text-transform: none; letter-spacing: 0; }
  .checkbox-row    { display: flex; align-items: center; gap: 10px; }
  .label-sm        { font-size: var(--text-sm); }
  .form-actions    { display: flex; gap: 10px; margin-top: 4px; }

  /* Flash */
  .flash     { padding: 12px 18px; margin-bottom: 20px; font-size: var(--text-sm); font-weight: 600; border: var(--brutal-border-thin); box-shadow: var(--shadow-sm); }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }
</style>