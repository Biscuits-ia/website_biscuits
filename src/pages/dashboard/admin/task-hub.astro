---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';

const auth = await requireAdmin(Astro as any);
if (auth instanceof Response) return auth;

const userName = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Admin';
---

<DashboardLayout title="Task Hub Seed" activePage="task-hub" authResult={auth} userName={userName}>
  <section class="space-y-4">
    <h1 class="text-xl font-bold text-slate-900">Seed de démonstration Task Hub</h1>
    <p class="text-sm text-slate-700">
      Cette action crée (ou complète) les données de démonstration: sprint, tâches multi-corps, dépendances,
      commentaire et snapshots KPI. L'opération est idempotente.
    </p>

    <div class="rounded border border-slate-300 bg-white p-4">
      <button id="run-seed" type="button" class="rounded border border-blue-700 bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
        Lancer le seed Task Hub
      </button>
      <pre id="seed-result" class="mt-3 rounded bg-slate-900 p-3 text-xs text-slate-100">En attente...</pre>
    </div>
  </section>
</DashboardLayout>

<script is:inline>
  const btn = document.getElementById('run-seed');
  const out = document.getElementById('seed-result');

  btn?.addEventListener('click', async () => {
    if (out) out.textContent = 'Exécution en cours...';
    const res = await fetch('/api/admin/task-hub-seed', { method: 'POST' });
    const json = await res.json().catch(() => ({}));

    if (!res.ok) {
      if (out) out.textContent = `Erreur (${res.status})\\n${JSON.stringify(json, null, 2)}`;
      return;
    }

    if (out) out.textContent = `Succès\\n${JSON.stringify(json, null, 2)}`;
  });
</script>
