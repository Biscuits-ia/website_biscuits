---
// src/pages/dashboard/admin/trombinoscope.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../../lib/auth';
import { createSupabaseAdminClient } from '../../../lib/supabase';

const result = await requireAdmin(Astro);
if (result instanceof Response) return result;

const { user } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Admin';

const saved  = Astro.url.searchParams.get('saved') === '1';
const error  = Astro.url.searchParams.get('error') ?? '';
const filter = Astro.url.searchParams.get('role') ?? '';

const adminDb = createSupabaseAdminClient();

let query = adminDb
  .from('benevoles')
  .select('*')
  .order('ordre', { ascending: true });

if (filter) query = query.eq('role', filter);

const { data: membresRaw } = await query;

type BenevolRole = 'benevole' | 'membre_ca' | 'membre_bureau';

interface Membre {
  id:          string;
  prenom:      string;
  nom:         string;
  role:        BenevolRole;
  competences: string[];
  photo_url:   string | null;
  bio:         string | null;
  lien:        string | null;
  ordre:       number;
  actif:       boolean;
  created_at:  string;
}

const membres = (membresRaw ?? []) as Membre[];

interface MembreRow {
  m:          Membre;
  roleLabel:  string;
  roleBadge:  string;
  dateLabel:  string;
  fullName:   string;
  comptStr:   string;
}

const ROLE_LABELS: Record<BenevolRole, string> = {
  benevole:      'Bénévole',
  membre_ca:     'Membre CA',
  membre_bureau: 'Bureau',
};
const ROLE_BADGES: Record<BenevolRole, string> = {
  benevole:      'badge-neutral',
  membre_ca:     'badge-info',
  membre_bureau: 'badge-ok',
};

const rows: MembreRow[] = membres.map((m: Membre): MembreRow => ({
  m,
  roleLabel:  ROLE_LABELS[m.role] ?? m.role,
  roleBadge:  ROLE_BADGES[m.role] ?? 'badge-neutral',
  dateLabel:  new Date(m.created_at).toLocaleDateString('fr-FR'),
  fullName:   `${m.prenom} ${m.nom}`,
  comptStr:   m.competences.join(', ') || 'â€”',
}));

const totalLabel = `${membres.length} membre${membres.length !== 1 ? 's' : ''}`;
const hasFilter  = filter !== '';
---

<DashboardLayout title="Trombinoscope" activePage="trombinoscope" userName={userName} authResult={result}>

  <div class="header-row">
    <div>
      <h1>Trombinoscope</h1>
      <p class="subtitle">{totalLabel} au total.</p>
    </div>
    <button class="btn btn-primary" data-open-modal="modal-add">
      + Ajouter un membre
    </button>
  </div>

  {saved && <div class="flash flash-ok" role="alert">âœ“ Opération réussie.</div>}
  {error  && <div class="flash flash-err" role="alert">âœ— {decodeURIComponent(error)}</div>}

  <!-- Filtres -->
  <form method="get" class="filters-bar">
    <select name="role" id="role-filter" class="filter-input">
      <option value="">Tous les rôles</option>
      <option value="benevole"      selected={filter === 'benevole'}>Bénévoles</option>
      <option value="membre_ca"     selected={filter === 'membre_ca'}>Membres CA</option>
      <option value="membre_bureau" selected={filter === 'membre_bureau'}>Bureau</option>
    </select>
    {hasFilter && <a href="/dashboard/admin/trombinoscope" class="btn btn-ghost btn-sm">Ã— Réinitialiser</a>}
  </form>

  <!-- Table -->
  <div class="card card-flush">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Membre</th>
            <th>Rôle</th>
            <th>Compétences</th>
            <th>Ordre</th>
            <th>Statut</th>
            <th>Ajouté le</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {rows.length > 0 ? rows.map(({ m, roleLabel, roleBadge, dateLabel, fullName, comptStr }) => (
            <tr class={m.actif ? '' : 'row-inactive'}>
              <td>
                <div class="member-cell">
                  <div class="member-avatar" style={m.photo_url ? `background-image:url('${m.photo_url}')` : ''}>
                    {!m.photo_url && fullName.split(' ').map((n: string) => n[0]).join('').toUpperCase().slice(0,2)}
                  </div>
                  <div>
                    <div class="member-name">{fullName}</div>
                    {m.bio && <div class="member-bio">{m.bio.slice(0, 60)}{m.bio.length > 60 ? 'â€¦' : ''}</div>}
                  </div>
                </div>
              </td>
              <td><span class={`badge ${roleBadge}`}>{roleLabel}</span></td>
              <td class="comp-cell">{comptStr}</td>
              <td class="mono sm">{m.ordre}</td>
              <td>
                <span class={`badge ${m.actif ? 'badge-ok' : 'badge-neutral'}`}>
                  {m.actif ? 'Actif' : 'Inactif'}
                </span>
              </td>
              <td class="mono xs muted">{dateLabel}</td>
              <td>
                <div class="row-actions">
                  <button
                    type="button"
                    class="btn btn-ghost btn-xs"
                    data-edit={JSON.stringify({
                      id:          m.id,
                      prenom:      m.prenom,
                      nom:         m.nom,
                      role:        m.role,
                      competences: m.competences.join(', '),
                      bio:         m.bio ?? '',
                      lien:        m.lien ?? '',
                      ordre:       m.ordre,
                      photo_url:   m.photo_url ?? '',
                    })}
                  >Modifier</button>
                  <form method="POST" action="/api/admin/benevoles/toggle">
                    <input type="hidden" name="id"    value={m.id} />
                    <input type="hidden" name="actif" value={String(!m.actif)} />
                    <button type="submit" class="btn btn-ghost btn-xs">
                      {m.actif ? 'Désactiver' : 'Activer'}
                    </button>
                  </form>
                  <form method="POST" action="/api/admin/benevoles/supprimer">
                    <input type="hidden" name="id" value={m.id} />
                    <button
                      type="submit"
                      class="btn btn-danger btn-xs"
                      data-confirm="Supprimer ce membre définitivement ?"
                    >âœ•</button>
                  </form>
                </div>
              </td>
            </tr>
          )) : (
            <tr>
              <td colspan="7" class="empty-row">
                {hasFilter ? 'Aucun membre pour ce rôle.' : 'Aucun membre pour le moment.'}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- â”€â”€ Modal : ajouter â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <dialog id="modal-add" class="modal">
    <div class="modal-box">
      <div class="modal-header">
        <span class="card-title">Nouveau membre</span>
        <button class="btn btn-ghost" type="button" data-close-modal="modal-add">âœ•</button>
      </div>
      <form method="POST" action="/api/admin/benevoles/create" enctype="multipart/form-data" class="modal-form">
        <div class="field-row">
          <div class="field">
            <label>Prénom *</label>
            <input type="text" name="prenom" required maxlength="100" placeholder="Marie" />
          </div>
          <div class="field">
            <label>Nom *</label>
            <input type="text" name="nom" required maxlength="100" placeholder="Dupont" />
          </div>
        </div>
        <div class="field">
          <label>Rôle *</label>
          <select name="role" required>
            <option value="benevole">Bénévole</option>
            <option value="membre_ca">Membre CA</option>
            <option value="membre_bureau">Bureau</option>
          </select>
        </div>
        <div class="field">
          <label>Compétences <span class="field-hint">(séparées par des virgules)</span></label>
          <input type="text" name="competences" placeholder="Python, Rédaction, Animation" />
        </div>
        <div class="field">
          <label>Bio <span class="field-hint">(facultatif, max 300 caractères)</span></label>
          <textarea name="bio" rows={3} maxlength="300" placeholder="Courte présentationâ€¦"></textarea>
        </div>
        <div class="field">
          <label>Lien <span class="field-hint">(portfolio, LinkedIn, site persoâ€¦)</span></label>
          <input type="url" name="lien" placeholder="https://" />
        </div>
        <div class="field-row">
          <div class="field">
            <label>Ordre d'affichage</label>
            <input type="number" name="ordre" value="0" min="0" max="9999" />
          </div>
          <div class="field">
            <label>Photo <span class="field-hint">(JPEG/PNG/WebP â€” max 2 Mo)</span></label>
            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/avif" />
          </div>
        </div>
        <div class="checkbox-row">
          <input type="checkbox" id="actif-add" name="actif" value="true" checked />
          <label for="actif-add" class="label-sm">Membre actif (visible sur le trombinoscope)</label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Créer</button>
          <button type="button" class="btn btn-ghost" data-close-modal="modal-add">Annuler</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- â”€â”€ Modal : modifier â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <dialog id="modal-edit" class="modal">
    <div class="modal-box">
      <div class="modal-header">
        <span class="card-title">Modifier le membre</span>
        <button class="btn btn-ghost" type="button" data-close-modal="modal-edit">âœ•</button>
      </div>
      <form method="POST" action="/api/admin/benevoles/update" enctype="multipart/form-data" class="modal-form">
        <input type="hidden" id="edit-id" name="id" />
        <div class="field-row">
          <div class="field">
            <label>Prénom *</label>
            <input type="text" id="edit-prenom" name="prenom" required maxlength="100" />
          </div>
          <div class="field">
            <label>Nom *</label>
            <input type="text" id="edit-nom" name="nom" required maxlength="100" />
          </div>
        </div>
        <div class="field">
          <label>Rôle *</label>
          <select id="edit-role" name="role" required>
            <option value="benevole">Bénévole</option>
            <option value="membre_ca">Membre CA</option>
            <option value="membre_bureau">Bureau</option>
          </select>
        </div>
        <div class="field">
          <label>Compétences <span class="field-hint">(séparées par des virgules)</span></label>
          <input type="text" id="edit-competences" name="competences" />
        </div>
        <div class="field">
          <label>Bio <span class="field-hint">(facultatif, max 300 caractères)</span></label>
          <textarea id="edit-bio" name="bio" rows={3} maxlength="300"></textarea>
        </div>
        <div class="field">
          <label>Lien <span class="field-hint">(portfolio, LinkedIn, site persoâ€¦)</span></label>
          <input type="url" id="edit-lien" name="lien" placeholder="https://" />
        </div>
        <div class="field-row">
          <div class="field">
            <label>Ordre d'affichage</label>
            <input type="number" id="edit-ordre" name="ordre" min="0" max="9999" />
          </div>
          <div class="field">
            <label>Nouvelle photo <span class="field-hint">(laissez vide pour conserver)</span></label>
            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/avif" />
          </div>
        </div>
        <div class="field" id="edit-current-photo-wrap" hidden>
          <label>Photo actuelle</label>
          <img id="edit-current-photo" src="" alt="Photo actuelle" class="current-photo-preview" />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Enregistrer</button>
          <button type="button" class="btn btn-ghost" data-close-modal="modal-edit">Annuler</button>
        </div>
      </form>
    </div>
  </dialog>

</DashboardLayout>

<style>
  .header-row   { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .subtitle     { margin-top: 6px; }
  .filters-bar  { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
  .filter-input { padding: 7px 10px; font-size: 0.82rem; border: var(--brutal-border-thin); background: var(--surface); }
  .card-flush   { padding: 0; overflow: hidden; }

  /* Cellule membre */
  .member-cell  { display: flex; align-items: center; gap: 10px; }
  .member-avatar {
    width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
    background: var(--color-primary); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem; font-weight: 700;
    background-size: cover; background-position: center;
  }
  .member-name  { font-weight: 600; font-size: 0.88rem; }
  .member-bio   { font-size: 0.72rem; color: var(--text-muted); margin-top: 2px; }

  .comp-cell    { font-size: 0.78rem; color: var(--text-secondary); max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row-inactive td { opacity: 0.55; }

  /* Table utils */
  .mono  { font-family: var(--font-mono); }
  .sm    { font-size: 0.82rem; }
  .xs    { font-size: 0.75rem; }
  .muted { color: var(--text-muted); }
  .empty-row  { text-align: center; color: var(--text-muted); padding: 40px 12px; font-size: 0.85rem; }
  .row-actions { display: flex; gap: 6px; flex-wrap: wrap; }

  /* Boutons */
  .btn-sm { font-size: 0.82rem; }
  .btn-xs { font-size: 0.75rem; padding: 4px 8px; min-height: unset; }

  /* Modal */
  .modal           { border: var(--brutal-border); box-shadow: var(--shadow-xl); padding: 0; background: var(--surface); max-width: 560px; width: 92vw; }
  .modal::backdrop { background: rgba(0,0,0,0.5); }
  .modal-box       { padding: 24px; display: flex; flex-direction: column; gap: 16px; max-height: 90vh; overflow-y: auto; }
  .modal-header    { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: var(--brutal-border-thin); }
  .modal-form      { display: flex; flex-direction: column; gap: 14px; }

  /* Champs */
  .field-row    { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .field        { display: flex; flex-direction: column; gap: 6px; }
  .field label  { font-size: var(--text-xs); font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono); }
  .field input,
  .field textarea,
  .field select { padding: 10px 13px; font-size: var(--text-base); width: 100%; font-family: var(--font-sans); border: var(--brutal-border-thin); background: var(--surface); }
  .field textarea { resize: vertical; }
  .field-hint   { font-size: 0.75rem; color: var(--text-muted); font-weight: 400; text-transform: none; letter-spacing: 0; }
  .checkbox-row { display: flex; align-items: center; gap: 10px; }
  .label-sm     { font-size: var(--text-sm); }
  .form-actions { display: flex; gap: 10px; margin-top: 4px; }

  .current-photo-preview { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: var(--brutal-border-thin); }

  /* Flash */
  .flash     { padding: 12px 18px; margin-bottom: 20px; font-size: var(--text-sm); font-weight: 600; border: var(--brutal-border-thin); box-shadow: var(--shadow-sm); }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }

  @media (max-width: 480px) {
    .field-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  interface EditData {
    id: string; prenom: string; nom: string; role: string;
    competences: string; bio: string; lien: string; ordre: number; photo_url: string;
  }

  function openEdit(data: EditData) {
    (document.getElementById('edit-id')          as HTMLInputElement).value    = data.id;
    (document.getElementById('edit-prenom')      as HTMLInputElement).value    = data.prenom;
    (document.getElementById('edit-nom')         as HTMLInputElement).value    = data.nom;
    (document.getElementById('edit-role')        as HTMLSelectElement).value   = data.role;
    (document.getElementById('edit-competences') as HTMLInputElement).value    = data.competences;
    (document.getElementById('edit-bio')         as HTMLTextAreaElement).value = data.bio;
    (document.getElementById('edit-lien')         as HTMLInputElement).value    = data.lien;
    (document.getElementById('edit-ordre')        as HTMLInputElement).value    = String(data.ordre);

    const wrap = document.getElementById('edit-current-photo-wrap') as HTMLElement;
    const img  = document.getElementById('edit-current-photo') as HTMLImageElement;
    if (data.photo_url) {
      img.src      = data.photo_url;
      wrap.hidden  = false;
    } else {
      wrap.hidden  = true;
    }

    (document.getElementById('modal-edit') as HTMLDialogElement).showModal();
  }

  // â”€â”€ Event delegation (CSP-safe: no inline event attributes) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.addEventListener('click', async (e) => {
    const el = e.target as Element;

    // Confirm before delete
      // FIX P0 1.4 : confirmation via modale globale (CSP-safe)
      const confirmBtn = el.closest<HTMLElement>('[data-confirm]');
      if (confirmBtn) {
        e.preventDefault();
        const form = confirmBtn.closest('form');
        const ok = await (window as any).showConfirm({
          title: 'Confirmation requise',
          message: confirmBtn.dataset.confirm ?? 'Confirmer ?',
          confirmLabel: 'Confirmer',
          cancelLabel: 'Annuler',
          danger: true,
        });
        if (ok && form) form.submit();
        return;
      }

    // Open modal
    const openBtn = el.closest<HTMLElement>('[data-open-modal]');
    if (openBtn) {
      const id = openBtn.dataset.openModal!;
      (document.getElementById(id) as HTMLDialogElement).showModal();
      return;
    }

    // Close modal
    const closeBtn = el.closest<HTMLElement>('[data-close-modal]');
    if (closeBtn) {
      const id = closeBtn.dataset.closeModal!;
      (document.getElementById(id) as HTMLDialogElement).close();
      return;
    }

    // Open edit modal
    const editBtn = el.closest<HTMLElement>('[data-edit]');
    if (editBtn) {
      openEdit(JSON.parse(editBtn.dataset.edit!) as EditData);
      return;
    }
  });

  // Filter select auto-submit
  document.getElementById('role-filter')?.addEventListener('change', function () {
    (this as HTMLSelectElement).form?.submit();
  });

  // Close modals on backdrop click
  document.querySelectorAll<HTMLDialogElement>('.modal').forEach(dialog => {
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  });
</script>
