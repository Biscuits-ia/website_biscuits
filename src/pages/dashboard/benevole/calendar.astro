---
// src/pages/dashboard/benevole/calendar.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireBenevole } from '../../../lib/auth';

const result = await requireBenevole(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Bénévole';

// Période affichée : mois depuis le param URL, sinon mois courant
const viewParam  = Astro.url.searchParams.get('view') ?? 'month'; // 'month' | 'week'
const yearParam  = parseInt(Astro.url.searchParams.get('y') ?? String(new Date().getFullYear()), 10);
const monthParam = parseInt(Astro.url.searchParams.get('m') ?? String(new Date().getMonth() + 1), 10);
const weekParam  = parseInt(Astro.url.searchParams.get('w') ?? '0', 10); // week offset from today

// Calcul des dates de la période
const now        = new Date();
const viewYear   = isNaN(yearParam)  ? now.getFullYear()  : yearParam;
const viewMonth  = isNaN(monthParam) ? now.getMonth() + 1 : Math.max(1, Math.min(12, monthParam));

// Calcul du début de semaine
function getMondayOfWeek(offsetWeeks: number): Date {
  const d = new Date(now);
  const day = d.getDay();
  const diff = day === 0 ? -6 : 1 - day; // Lundi
  d.setDate(d.getDate() + diff + offsetWeeks * 7);
  d.setHours(0, 0, 0, 0);
  return d;
}

const weekStart = getMondayOfWeek(weekParam);
const weekEnd   = new Date(weekStart);
weekEnd.setDate(weekEnd.getDate() + 6);

// Plage de dates à charger selon la vue
let rangeStart: Date, rangeEnd: Date;
if (viewParam === 'week') {
  rangeStart = weekStart;
  rangeEnd   = weekEnd;
} else {
  rangeStart = new Date(viewYear, viewMonth - 1, 1);
  rangeEnd   = new Date(viewYear, viewMonth, 0); // dernier jour du mois
}

// Cle jour calendaire a partir des composantes locales de la Date.
// `toISOString()` convertit en UTC : pour une Date construite a minuit local,
// tout fuseau positif (France = UTC+1/+2) renvoie le jour PRECEDENT. Les taches
// tombaient alors sur la mauvaise case et celles du dernier jour du mois
// sortaient de la plage interrogee.
function dateKey(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

const rangeStartStr = dateKey(rangeStart);
const rangeEndStr   = dateKey(rangeEnd);

// Tâches avec deadline dans la période (assignées à l'utilisateur ou qu'il crée)
const { data: tasksRaw } = await supabase
  .from('project_tasks')
  .select(`
    id, title, status, priority, deadline, project_id,
    projects!project_tasks_project_id_fkey(title)
  `)
  .or(`assignee_id.eq.${user.id},created_by.eq.${user.id}`)
  .gte('deadline', rangeStartStr)
  .lte('deadline', rangeEndStr)
  .neq('status', 'done')
  .order('deadline');

interface TaskCal {
  id: string;
  title: string;
  status: string;
  priority: string;
  deadline: string;
  project_id: string;
  projects: Array<{ title: string }> | null;
}

const tasks = (tasksRaw ?? []) as unknown as TaskCal[];

// Regrouper les tâches par date (YYYY-MM-DD)
const tasksByDate: Record<string, TaskCal[]> = {};
for (const t of tasks) {
  const key = t.deadline.slice(0, 10);
  if (!tasksByDate[key]) tasksByDate[key] = [];
  tasksByDate[key].push(t);
}

// Construire le calendrier mensuel
function buildMonthGrid(year: number, month: number): Array<Date | null> {
  const firstDay = new Date(year, month - 1, 1);
  const lastDay  = new Date(year, month, 0);
  const startDow = (firstDay.getDay() + 6) % 7; // Lundi = 0
  const grid: Array<Date | null> = [];
  for (let i = 0; i < startDow; i++) grid.push(null);
  for (let d = 1; d <= lastDay.getDate(); d++) grid.push(new Date(year, month - 1, d));
  while (grid.length % 7 !== 0) grid.push(null);
  return grid;
}

const monthGrid = buildMonthGrid(viewYear, viewMonth);
const weekDayLabels = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];

// Jours de la semaine (vue semaine)
const weekDays: Date[] = [];
for (let i = 0; i < 7; i++) {
  const d = new Date(weekStart);
  d.setDate(d.getDate() + i);
  weekDays.push(d);
}

// Helpers
const todayStr = dateKey(now);
const monthName = rangeStart.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
const priorityClass: Record<string, string> = { low: 'neutral', medium: 'info', high: 'err' };

// Navigation URLs
function navUrl(params: Record<string, string | number>) {
  const base = new URLSearchParams({ view: viewParam, y: String(viewYear), m: String(viewMonth), w: String(weekParam) });
  for (const [k, v] of Object.entries(params)) base.set(k, String(v));
  return `/dashboard/benevole/calendar?${base.toString()}`;
}

const prevMonthDate = new Date(viewYear, viewMonth - 2, 1);
const nextMonthDate = new Date(viewYear, viewMonth, 1);
const prevMonthUrl  = navUrl({ y: prevMonthDate.getFullYear(), m: prevMonthDate.getMonth() + 1 });
const nextMonthUrl  = navUrl({ y: nextMonthDate.getFullYear(), m: nextMonthDate.getMonth() + 1 });
const prevWeekUrl   = navUrl({ view: 'week', w: weekParam - 1 });
const nextWeekUrl   = navUrl({ view: 'week', w: weekParam + 1 });
const todayUrl      = navUrl({ view: viewParam, y: now.getFullYear(), m: now.getMonth() + 1, w: 0 });
const monthViewUrl  = navUrl({ view: 'month' });
const weekViewUrl   = navUrl({ view: 'week' });
---

<DashboardLayout title="Calendrier" activePage="calendar" userName={userName} userEmail={user.email ?? ''} authResult={result}>
  <!-- En-tête -->
  <div class="cal-header">
    <div class="cal-title-row">
      <h1 class="cal-title">
        {viewParam === 'week'
          ? `Semaine du ${weekStart.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })} au ${weekEnd.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}`
          : monthName.charAt(0).toUpperCase() + monthName.slice(1)
        }
      </h1>
      <div class="cal-controls">
        <a href={todayUrl}     class="btn btn-ghost btn-sm">Aujourd'hui</a>
        <a href={viewParam === 'week' ? prevWeekUrl : prevMonthUrl}  class="btn btn-ghost btn-sm">‹</a>
        <a href={viewParam === 'week' ? nextWeekUrl : nextMonthUrl}  class="btn btn-ghost btn-sm">›</a>
        <div class="view-toggle">
          <a href={monthViewUrl} class={`btn btn-sm ${viewParam === 'month' ? 'btn-primary' : 'btn-ghost'}`}>Mois</a>
          <a href={weekViewUrl}  class={`btn btn-sm ${viewParam === 'week'  ? 'btn-primary' : 'btn-ghost'}`}>Semaine</a>
        </div>
      </div>
    </div>
    <p class="cal-subtitle">{tasks.length} tâche{tasks.length > 1 ? 's' : ''} avec échéance sur cette période</p>
  </div>

  {viewParam === 'month' ? (
    <div class="cal-month-scroll">
    <div class="cal-month">
      {/* En-têtes jours */ }
      {weekDayLabels.map(d => (
        <div class="cal-dow-header">{d}</div>
      ))}
      {/* Cellules */ }
      {monthGrid.map(date => {
        if (!date) return <div class="cal-cell cal-cell--empty" />;
        const key     = dateKey(date);
        const dayTasks = tasksByDate[key] ?? [];
        const isToday  = key === todayStr;
        const isPast   = key < todayStr;
        // La cellule n'affiche que 2 taches : le "+N autres" comptait un
        // debordement qui n'existait pas, toutes les taches etant rendues.
        const shownTasks = dayTasks.slice(0, 2);
        const hiddenCount = dayTasks.length - shownTasks.length;
        return (
          <div class={`cal-cell${isToday ? ' cal-cell--today' : ''}${isPast && dayTasks.length > 0 ? ' cal-cell--overdue' : ''}`}>
            <span class="cal-day-num">{date.getDate()}</span>
            {shownTasks.map(t => (
              <a
                href={`/dashboard/benevole/project/${t.project_id}`}
                class={`cal-task cal-task--${priorityClass[t.priority] ?? 'neutral'}`}
                title={`${t.title} — ${(t.projects?.[0]?.title ?? '?')}`}
              >
                <span class="cal-task-dot" />
                <span class="cal-task-label">{t.title}</span>
              </a>
            ))}
            {hiddenCount > 0 && (
              <span class="cal-more">+{hiddenCount} autre{hiddenCount > 1 ? 's' : ''}</span>
            )}
          </div>
        );
      })}
    </div>
    </div>
  ) : (
    <div class="cal-week">
      {weekDays.map(date => {
        const key      = dateKey(date);
        const dayTasks = tasksByDate[key] ?? [];
        const isToday  = key === todayStr;
        const isPast   = key < todayStr;
        const dow      = date.toLocaleDateString('fr-FR', { weekday: 'short' });
        return (
          <div class={`cal-week-col${isToday ? ' cal-week-col--today' : ''}`}>
            <div class="cal-week-header">
              <span class="cal-week-dow">{dow.charAt(0).toUpperCase() + dow.slice(1)}</span>
              <span class={`cal-week-day${isToday ? ' cal-week-day--today' : ''}`}>{date.getDate()}</span>
            </div>
            <div class="cal-week-tasks">
              {dayTasks.length === 0
                ? <p class="cal-no-task">—</p>
                : dayTasks.map(t => (
                    <a
                      href={`/dashboard/benevole/project/${t.project_id}`}
                      class={`cal-task-week cal-task--${priorityClass[t.priority] ?? 'neutral'}`}
                    >
                      <span class="cal-task-week-title">{t.title}</span>
                      <span class="cal-task-week-project">{t.projects?.[0]?.title ?? '?'}</span>
                    </a>
                  ))
              }
              {isPast && dayTasks.some(t => t.status !== 'done') && (
                <span class="cal-overdue-badge">En retard</span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- Légende -->
  <div class="cal-legend">
    <span class="legend-item"><span class="legend-dot legend-dot--neutral" />Faible priorité</span>
    <span class="legend-item"><span class="legend-dot legend-dot--info" />Priorité moyenne</span>
    <span class="legend-item"><span class="legend-dot legend-dot--err" />Haute priorité</span>
  </div>
</DashboardLayout>

<style>
  .cal-header        { display: flex; flex-direction: column; gap: 6px; margin-bottom: var(--space-lg); }
  .cal-title-row     { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .cal-title         { font-size: var(--text-xl); font-weight: 700; }
  .cal-subtitle      { font-size: var(--text-sm); color: var(--text-muted); }
  .cal-controls      { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .view-toggle       { display: flex; border: var(--brutal-border-thin); overflow: hidden; }
  .view-toggle .btn  { border: none; border-radius: 0; }

  /* Month grid */
  .cal-month         { display: grid; grid-template-columns: repeat(7, 1fr); border-top: var(--brutal-border-thin); border-left: var(--brutal-border-thin); }
  .cal-dow-header    { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); text-align: center; padding: 6px 0; background: var(--surface); border-right: var(--brutal-border-thin); border-bottom: var(--brutal-border-thin); }
  .cal-cell          { min-height: 90px; padding: 4px 6px; border-right: var(--brutal-border-thin); border-bottom: var(--brutal-border-thin); display: flex; flex-direction: column; gap: 2px; overflow: hidden; }
  .cal-cell--empty   { background: color-mix(in srgb, var(--surface) 40%, transparent); }
  .cal-cell--today   { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .cal-cell--overdue { background: color-mix(in srgb, var(--err) 5%, transparent); }
  .cal-day-num       { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); margin-bottom: 2px; }
  .cal-cell--today .cal-day-num { color: var(--accent); }

  .cal-task          { display: flex; align-items: center; gap: 4px; text-decoration: none; padding: 1px 4px; font-size: 0.68rem; line-height: 1.3; background: var(--surface-raised); border-left: 3px solid; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .cal-task:hover    { filter: brightness(.95); }
  .cal-task--neutral { border-color: var(--border-mid); }
  .cal-task--info    { border-color: var(--info); background: var(--info-bg); color: var(--info-fg); }
  .cal-task--err     { border-color: var(--err);  background: var(--err-bg);  color: var(--err-fg);  }
  .cal-task-dot      { width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .cal-task-label    { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cal-more          { font-size: 0.65rem; color: var(--text-muted); padding: 0 4px; }

  /* Week grid */
  .cal-week          { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0; border: var(--brutal-border-thin); }
  @media (max-width: 700px) { .cal-week { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 480px) { .cal-week { grid-template-columns: 1fr; } }
  .cal-week-col      { display: flex; flex-direction: column; border-right: var(--brutal-border-thin); min-height: 200px; }
  .cal-week-col:last-child { border-right: none; }
  .cal-week-col--today { background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .cal-week-header   { padding: 8px 10px; border-bottom: var(--brutal-border-thin); background: var(--surface); text-align: center; }
  .cal-week-dow      { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); display: block; }
  .cal-week-day      { font-size: var(--text-lg); font-weight: 700; display: block; }
  .cal-week-day--today { color: var(--accent); }
  .cal-week-tasks    { padding: 6px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .cal-no-task       { font-size: 0.7rem; color: var(--text-muted); text-align: center; padding-top: 8px; }
  .cal-task-week     { display: flex; flex-direction: column; gap: 2px; padding: 4px 6px; border-left: 3px solid; text-decoration: none; background: var(--surface-raised); }
  .cal-task-week:hover { filter: brightness(.95); }
  .cal-task-week-title   { font-size: var(--text-xs); font-weight: 600; }
  .cal-task-week-project { font-size: 0.68rem; color: var(--text-muted); }
  .cal-overdue-badge { font-size: 0.65rem; color: var(--err-fg); background: var(--err-bg); border: 1px solid var(--err); padding: 1px 5px; text-align: center; margin-top: auto; }

  /* Légende */
  .cal-legend        { display: flex; gap: 16px; margin-top: var(--space-md); padding-top: var(--space-sm); border-top: 1px solid var(--border-mid); flex-wrap: wrap; }
  .legend-item       { display: flex; align-items: center; gap: 6px; font-size: var(--text-xs); color: var(--text-muted); }
  .legend-dot        { width: 10px; height: 10px; border-radius: 2px; }
  .legend-dot--neutral { background: var(--border-mid); }
  .legend-dot--info   { background: var(--info); }
  .legend-dot--err    { background: var(--err); }

  /* Mobile : on conserve les 7 colonnes. Passer a 3 colonnes desalignait les
     jours de leur en-tete de semaine (le 1er du mois ne tombait plus sous le
     bon jour) et masquait 4 en-tetes sur 7. On fait defiler a la place. */
  @media (max-width: 700px) {
    .cal-month {
      grid-template-columns: repeat(7, minmax(46px, 1fr));
      min-width: 322px;
    }
    .cal-month-scroll { overflow-x: auto; }
    .cal-cell { min-height: 62px; }
  }
</style>
