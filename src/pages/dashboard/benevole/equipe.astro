---
// src/pages/dashboard/benevole/equipe.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireBenevole } from '../../../lib/auth';

const result = await requireBenevole(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Bénévole';

// Bénévoles actifs depuis la table benevoles (trombinoscope)
const { data: benevolesRaw } = await supabase
  .from('benevoles')
  .select('id, prenom, nom, role, competences, photo_url, bio, lien, ordre')
  .eq('actif', true)
  .order('ordre');

interface Benevole {
  id: string; prenom: string; nom: string; role: string;
  competences: string[]; photo_url: string | null; bio: string | null;
  lien: string | null; ordre: number;
}

const benevoles = (benevolesRaw ?? []) as Benevole[];

const roleLabel: Record<string, string> = {
  benevole:       'Bénévole',
  membre_ca:      "Membre CA",
  membre_bureau:  'Bureau',
};
const roleClass: Record<string, string> = {
  benevole:       'neutral',
  membre_ca:      'info',
  membre_bureau:  'ok',
};

// Grouper par rôle
const groups = [
  { key: 'membre_bureau', label: 'Bureau' },
  { key: 'membre_ca',     label: "Conseil d'administration" },
  { key: 'benevole',      label: 'Bénévoles' },
];
---

<DashboardLayout title="Équipe" role="benevole" activePage="equipe" userName={userName} userEmail={user.email ?? ''} authResult={result}>
  <div class="mb-6">
    <h1 class="page-title">Notre équipe</h1>
    <p class="description">{benevoles.length} membre{benevoles.length > 1 ? 's' : ''} actif{benevoles.length > 1 ? 's' : ''}</p>
  </div>

  {benevoles.length === 0 ? (
    <div class="card">
      <p class="empty-state">Aucun membre pour le moment.</p>
    </div>
  ) : (
    groups.map(({ key, label }) => {
      const group = benevoles.filter((b: Benevole) => b.role === key);
      if (group.length === 0) return null;
      return (
        <section class="team-section mb-8">
          <h2 class="team-section-title">{label} <span class="section-count">{group.length}</span></h2>
          <div class="team-grid">
            {group.map((b: Benevole) => {
              const initials = (b.prenom[0] ?? '') + (b.nom[0] ?? '');
              return (
                <div class="team-card">
                  <div class="team-avatar">
                    {b.photo_url
                      ? <img src={b.photo_url} alt={`${b.prenom} ${b.nom}`} class="avatar-img" loading="lazy" />
                      : <span class="avatar-initials">{initials.toUpperCase()}</span>
                    }
                  </div>
                  <div class="team-info">
                    <div class="team-name">{b.prenom} {b.nom}</div>
                    <span class={`badge badge-${roleClass[b.role] ?? 'neutral'}`}>{roleLabel[b.role] ?? b.role}</span>
                    {b.bio && <p class="team-bio">{b.bio}</p>}
                    {b.competences.length > 0 && (
                      <div class="team-skills">
                        {b.competences.map((c: string) => (
                          <span class="skill-tag">{c}</span>
                        ))}
                      </div>
                    )}
                    {b.lien && (
                      <a href={b.lien} target="_blank" rel="noopener noreferrer" class="team-link">
                        Profil →
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      );
    })
  )}
</DashboardLayout>

<style>
  .page-title          { font-size: var(--text-xl); font-weight: 700; }
  .team-section-title  { font-size: var(--text-base); font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); margin-bottom: var(--space-md); display: flex; align-items: center; gap: 8px; }
  .section-count       { font-size: var(--text-xs); font-weight: 400; background: var(--surface-raised); border: 1px solid var(--border-mid); border-radius: 99px; padding: 1px 8px; }

  .team-grid           { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-md); }

  .team-card           { border: var(--brutal-border-thin); background: var(--surface-raised); padding: var(--space-md); display: flex; gap: var(--space-md); align-items: flex-start; }
  .team-avatar         { flex-shrink: 0; width: 52px; height: 52px; border: var(--brutal-border-thin); overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--surface); }
  .avatar-img          { width: 100%; height: 100%; object-fit: cover; }
  .avatar-initials     { font-size: var(--text-base); font-weight: 700; color: var(--accent); }

  .team-info           { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .team-name           { font-size: var(--text-sm); font-weight: 700; }
  .team-bio            { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.4; }
  .team-skills         { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 2px; }
  .skill-tag           { font-size: 0.7rem; padding: 2px 7px; background: var(--accent-light); color: var(--accent-dark); border: 1px solid var(--accent); font-family: var(--font-mono); }
  .team-link           { font-size: var(--text-xs); color: var(--accent); text-decoration: none; margin-top: 2px; }
  .team-link:hover     { text-decoration: underline; }

  .badge               { font-size: 0.72rem; padding: 2px 7px; border: 1px solid; font-family: var(--font-mono); }
  .badge-ok            { color: var(--ok-fg);   background: var(--ok-bg);   border-color: var(--ok); }
  .badge-info          { color: var(--info-fg); background: var(--info-bg); border-color: var(--info); }
  .badge-neutral       { color: var(--text-muted); background: var(--surface); border-color: var(--border-mid); }

  .empty-state         { font-size: var(--text-sm); color: var(--text-muted); padding: var(--space-md) 0; }
  .mb-6                { margin-bottom: var(--space-lg); }
  .mb-8                { margin-bottom: var(--space-2xl); }
</style>
