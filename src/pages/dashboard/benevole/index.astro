---
// src/pages/dashboard/benevole/index.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireBenevole } from '../../../lib/auth';
import { createSupabaseAdminClient } from '../../../lib/supabase';

const result = await requireBenevole(Astro);
if (result instanceof Response) return result;

const { user } = result;
const userId   = user.id;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Bénévole';
const adminSupabase = createSupabaseAdminClient();

// ── Données ──────────────────────────────────────────────────────────────────
const [
  { data: projectsRaw },
  { data: myTasksRaw },
  { data: announcementsRaw },
] = await Promise.all([
  adminSupabase
    .from('projects')
    .select('id, title, status, priority, deadline')
    .in('status', ['active', 'on_hold'])
    .order('deadline', { ascending: true })
    .limit(5),
  adminSupabase
    .from('project_tasks')
    .select('id, title, status, priority, deadline, project_id, projects(title)')
    .eq('assignee_id', userId)
    .neq('status', 'done')
    .order('deadline', { ascending: true, nullsFirst: false })
    .limit(8),
  adminSupabase
    .from('announcements')
    .select('id, title, content, pinned, created_at, author_id, profiles(full_name, email)')
    .order('pinned', { ascending: false })
    .order('created_at', { ascending: false })
    .limit(5),
]);

// ── Typage strict ─────────────────────────────────────────────────────────────
interface ProjectRow { id: string; title: string; status: string; priority: string; deadline: string | null; }
interface TaskRow    { id: string; title: string; status: string; priority: string; deadline: string | null; project_id: string; projects: { title: string }[] | null; }
interface AuthorRow  { full_name: string | null; email: string; }
interface AnnouncementRow { id: string; title: string; content: string; pinned: boolean; created_at: string; profiles: AuthorRow[] | null; }

const projects      = (projectsRaw      ?? []) as unknown as ProjectRow[];
const myTasks       = (myTasksRaw       ?? []) as unknown as TaskRow[];
const announcements = (announcementsRaw ?? []) as unknown as AnnouncementRow[];

const statusLabel: Record<string, string> = {
  active: 'Actif', on_hold: 'En pause', completed: 'Terminé', archived: 'Archivé',
};
const statusClass: Record<string, string> = {
  active: 'ok', on_hold: 'warn', completed: 'info', archived: 'neutral',
};
const taskStatusClass: Record<string, string> = {
  todo: 'neutral', in_progress: 'info', review: 'warn', done: 'ok',
};
const priorityClass: Record<string, string> = {
  low: 'neutral', medium: 'info', high: 'err',
};
const priorityLabel: Record<string, string> = {
  low: 'Faible', medium: 'Moyenne', high: 'Haute',
};
---

<DashboardLayout title="Vue d'ensemble" activePage="overview" userName={userName} userEmail={user.email ?? ''} authResult={result}>
  <!-- Bienvenue -->
  <div class="mb-7">
    <h1 class="text-lg font-normal tracking-tight text-primary">
      Bonjour, {userName.split(' ')[0]} 👋
    </h1>
    <p class="description">Bienvenue dans votre espace bénévole Biscuits IA.</p>
  </div>

  <!-- Stats rapides -->
  <div class="stats-grid mb-6">
    <div class="stat-card">
      <div class="stat-label">Projets actifs</div>
      <div class="stat-value">{projects.filter(p => p.status === 'active').length}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Mes tâches</div>
      <div class="stat-value">{myTasks.length}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Annonces</div>
      <div class="stat-value">{announcements.length}</div>
    </div>
  </div>

  <div class="two-col-grid">

    <!-- Mes tâches en cours -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">Mes tâches</span>
        <a href="/dashboard/benevole/tasks" class="btn btn-ghost btn-sm">Tout voir →</a>
      </div>
      {myTasks.length === 0 ? (
        <p class="empty-state">Aucune tâche assignée pour le moment.</p>
      ) : (
        <ul class="task-list">
          {myTasks.map((t: TaskRow) => (
            <li class="task-item">
              <div class="task-meta">
                <span class={`dot dot--${taskStatusClass[t.status] ?? 'neutral'}`}></span>
                <span class="task-title">{t.title}</span>
              </div>
              <div class="task-badges">
                <span class={`badge badge-${priorityClass[t.priority] ?? 'neutral'}`}>{priorityLabel[t.priority]}</span>
                {t.deadline && (
                  <span class="task-deadline">{new Date(t.deadline).toLocaleDateString('fr-FR')}</span>
                )}
              </div>
              {t.projects && <span class="task-project">{Array.isArray(t.projects) ? t.projects[0]?.title : (t.projects as { title: string } | null)?.title}</span>}
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Projets en cours -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">Projets</span>
        <a href="/dashboard/benevole/projects" class="btn btn-ghost btn-sm">Tout voir →</a>
      </div>
      {projects.length === 0 ? (
        <p class="empty-state">Aucun projet en cours.</p>
      ) : (
        <ul class="project-list">
          {projects.map((p: ProjectRow) => (
            <li class="project-item">
              <a href={`/dashboard/benevole/project/${p.id}`} class="project-link">
                <span class={`dot dot--${statusClass[p.status] ?? 'neutral'}`}></span>
                <span class="project-title">{p.title}</span>
              </a>
              <div class="project-badges">
                <span class={`badge badge-${statusClass[p.status] ?? 'neutral'}`}>{statusLabel[p.status]}</span>
                <span class={`badge badge-${priorityClass[p.priority] ?? 'neutral'}`}>{priorityLabel[p.priority]}</span>
                {p.deadline && (
                  <span class="task-deadline">{new Date(p.deadline).toLocaleDateString('fr-FR')}</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>

  </div>

  <!-- Annonces -->
  {announcements.length > 0 && (
    <div class="card mt-6">
      <div class="card-header">
        <span class="card-title">Annonces</span>
      </div>
      <ul class="announcement-list">
        {announcements.map((a: AnnouncementRow) => {
          const author = a.profiles?.[0]?.full_name ?? a.profiles?.[0]?.email ?? 'Équipe';
          return (
            <li class={`announcement-item${a.pinned ? ' pinned' : ''}`}>
              <div class="announcement-header">
                <strong class="announcement-title">{a.pinned ? '📌 ' : ''}{a.title}</strong>
                <span class="announcement-meta">{author} · {new Date(a.created_at).toLocaleDateString('fr-FR')}</span>
              </div>
              <p class="announcement-content">{a.content}</p>
            </li>
          );
        })}
      </ul>
    </div>
  )}
</DashboardLayout>

<style>
  .two-col-grid     { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
  @media (max-width: 768px) { .two-col-grid { grid-template-columns: 1fr; } }

  .task-list        { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
  .task-item        { display: flex; flex-direction: column; gap: 4px; padding: var(--space-sm); border: var(--brutal-border-thin); }
  .task-meta        { display: flex; align-items: center; gap: 8px; }
  .task-title       { font-size: var(--text-sm); font-weight: 500; }
  .task-badges      { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .task-project     { font-size: var(--text-xs); color: var(--text-muted); }
  .task-deadline    { font-size: var(--text-xs); color: var(--text-muted); font-family: var(--font-mono); }

  .project-list     { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
  .project-item     { display: flex; flex-direction: column; gap: 4px; padding: var(--space-sm); border: var(--brutal-border-thin); }
  .project-link     { display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text-primary); font-weight: 500; font-size: var(--text-sm); }
  .project-link:hover .project-title { text-decoration: underline; }
  .project-badges   { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .project-title    { flex: 1; }

  .dot              { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .dot--ok          { background: var(--ok); }
  .dot--warn        { background: var(--warn); }
  .dot--info        { background: var(--info); }
  .dot--neutral     { background: var(--text-muted); }
  .dot--err         { background: var(--err); }

  .badge            { font-size: 0.72rem; padding: 2px 7px; border: 1px solid; font-family: var(--font-mono); }
  .badge-ok         { color: var(--ok-fg);   background: var(--ok-bg);   border-color: var(--ok); }
  .badge-warn       { color: var(--warn-fg); background: var(--warn-bg); border-color: var(--warn); }
  .badge-info       { color: var(--info-fg); background: var(--info-bg); border-color: var(--info); }
  .badge-err        { color: var(--err-fg);  background: var(--err-bg);  border-color: var(--err); }
  .badge-neutral    { color: var(--text-muted); background: var(--surface); border-color: var(--border-mid); }

  .empty-state      { font-size: var(--text-sm); color: var(--text-muted); padding: var(--space-md) 0; }

  .announcement-list   { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
  .announcement-item   { padding: var(--space-sm) var(--space-md); border: var(--brutal-border-thin); }
  .announcement-item.pinned { border-color: var(--accent); background: var(--accent-light); }
  .announcement-header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 4px; }
  .announcement-title  { font-size: var(--text-sm); font-weight: 600; }
  .announcement-meta   { font-size: var(--text-xs); color: var(--text-muted); }
  .announcement-content { font-size: var(--text-sm); color: var(--text-secondary); white-space: pre-wrap; }
</style>
