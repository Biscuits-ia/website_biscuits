---
// src/pages/dashboard/benevole/project/[id].astro
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { requireBenevole } from '../../../../lib/auth';

const result = await requireBenevole(Astro);
if (result instanceof Response) return result;

const { user, supabase, role } = result;
const userId   = user.id;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Bénévole';
const isStaff  = role === 'admin' || role === 'moderator';

const projectId = Astro.params.id ?? '';
if (!projectId) return Astro.redirect('/dashboard/benevole/projects');

// ── Chargement projet + membres + tâches ─────────────────────────────────────
const [
  { data: projectRaw, error: projErr },
  { data: tasksRaw },
  { data: membersRaw },
] = await Promise.all([
  supabase
    .from('projects')
    .select(`
      id, title, description, status, priority, deadline, created_at, leader_id,
      profiles!projects_leader_id_fkey(full_name, email)
    `)
    .eq('id', projectId)
    .single(),
  supabase
    .from('project_tasks')
    .select(`
      id, title, description, status, priority, deadline, position, created_by, assignee_id,
      profiles!project_tasks_assignee_id_fkey(full_name, email)
    `)
    .eq('project_id', projectId)
    .order('status')
    .order('position'),
  supabase
    .from('project_members')
    .select('user_id, profiles(full_name, email)')
    .eq('project_id', projectId),
]);

if (projErr || !projectRaw) return Astro.redirect('/dashboard/benevole/projects');

// ── Types ─────────────────────────────────────────────────────────────────────
interface ProfileRef { full_name: string | null; email: string; }
interface Project {
  id: string; title: string; description: string | null;
  status: string; priority: string; deadline: string | null;
  created_at: string; leader_id: string | null;
  profiles: ProfileRef[] | null;
}
interface Task {
  id: string; title: string; description: string | null;
  status: string; priority: string; deadline: string | null;
  position: number; created_by: string; assignee_id: string | null;
  profiles: ProfileRef[] | null;
}
interface Member { user_id: string; profiles: ProfileRef[] | null; }

const project = projectRaw as unknown as Project;
const tasks   = (tasksRaw ?? []) as unknown as Task[];
const members = (membersRaw ?? []) as unknown as Member[];

// Kolonnes kanban
const columns = [
  { key: 'todo',        label: 'À faire',   cls: 'neutral' },
  { key: 'in_progress', label: 'En cours',  cls: 'info'    },
  { key: 'review',      label: 'Révision',  cls: 'warn'    },
  { key: 'done',        label: 'Terminé',   cls: 'ok'      },
];

const tasksByStatus: Record<string, Task[]> = {};
for (const col of columns) tasksByStatus[col.key] = [];
for (const t of tasks) {
  if (tasksByStatus[t.status]) tasksByStatus[t.status].push(t);
}

const priorityClass: Record<string, string> = { low: 'neutral', medium: 'info', high: 'err' };
const priorityLabel: Record<string, string> = { low: 'Faible', medium: 'Moyenne', high: 'Haute' };
const statusLabel:   Record<string, string> = {
  active: 'Actif', on_hold: 'En pause', completed: 'Terminé', archived: 'Archivé',
};
const statusClass:   Record<string, string> = {
  active: 'ok', on_hold: 'warn', completed: 'info', archived: 'neutral',
};

const isLeader = project.leader_id === userId;
const canEdit  = isLeader || isStaff;

const leaderName = project.profiles?.[0]?.full_name ?? project.profiles?.[0]?.email ?? '—';
const deadlineStr = project.deadline ? new Date(project.deadline).toLocaleDateString('fr-FR') : null;

// Membres pour assignation
const memberOptions = members.map((m: Member) => ({
  id: m.user_id,
  name: m.profiles?.[0]?.full_name ?? m.profiles?.[0]?.email ?? m.user_id,
}));
---

<DashboardLayout title={project.title} role="benevole" activePage="projects" userName={userName} userEmail={user.email ?? ''} authResult={result}>
  <!-- En-tête projet -->
  <div class="project-header mb-6">
    <div class="project-header-left">
      <a href="/dashboard/benevole/projects" class="back-link">← Projets</a>
      <h1 class="project-title">{project.title}</h1>
      {project.description && <p class="project-description">{project.description}</p>}
      <div class="project-meta-row">
        <span class={`badge badge-${statusClass[project.status] ?? 'neutral'}`}>{statusLabel[project.status]}</span>
        <span class={`badge badge-${priorityClass[project.priority] ?? 'neutral'}`}>{priorityLabel[project.priority]}</span>
        <span class="meta-item">👤 {leaderName}</span>
        {deadlineStr && <span class="meta-item">📅 {deadlineStr}</span>}
        <span class="meta-item">👥 {members.length} membre{members.length > 1 ? 's' : ''}</span>
      </div>
    </div>
    {canEdit && (
      <div class="project-actions">
        <button class="btn btn-ghost btn-sm" id="btn-edit-project">Modifier</button>
        <button class="btn btn-primary btn-sm" id="btn-add-task">+ Tâche</button>
      </div>
    )}
  </div>

  <!-- Kanban -->
  <div class="kanban" id="kanban-board" data-project-id={projectId}>
    {columns.map(col => (
      <div class={`kanban-col kanban-col--${col.cls}`} data-status={col.key}>
        <div class="kanban-col-header">
          <span class="kanban-col-label">{col.label}</span>
          <span class="kanban-col-count">{tasksByStatus[col.key].length}</span>
        </div>
        <div class="kanban-cards" id={`col-${col.key}`}>
          {tasksByStatus[col.key].map((t: Task) => {
            const assigneeName = t.profiles?.[0]?.full_name ?? t.profiles?.[0]?.email ?? null;
            const taskDeadline = t.deadline ? new Date(t.deadline).toLocaleDateString('fr-FR') : null;
            const isMyTask     = t.assignee_id === userId;
            return (
              <div
                class={`task-card${isMyTask ? ' task-card--mine' : ''}`}
                data-task-id={t.id}
                data-status={t.status}
              >
                <div class="task-card-title">{t.title}</div>
                {t.description && <p class="task-card-desc">{t.description}</p>}
                <div class="task-card-footer">
                  <span class={`badge badge-${priorityClass[t.priority] ?? 'neutral'}`}>{priorityLabel[t.priority]}</span>
                  {taskDeadline && <span class="task-deadline">📅 {taskDeadline}</span>}
                  {assigneeName && <span class="task-assignee">👤 {assigneeName}</span>}
                </div>
                {(t.created_by === userId || isStaff) && (
                  <div class="task-card-actions">
                    <button class="btn-icon btn-edit-task" data-id={t.id} title="Modifier">✏️</button>
                    <button class="btn-icon btn-delete-task" data-id={t.id} title="Supprimer">🗑</button>
                  </div>
                )}
              </div>
            );
          })}
        </div>
        {canEdit && (
          <button class="btn-add-col-task" data-status={col.key}>+ Ajouter une tâche</button>
        )}
      </div>
    ))}
  </div>

  <!-- Modal : Nouvelle tâche -->
  <dialog id="modal-add-task" class="modal">
    <div class="modal-box">
      <h2 class="modal-title">Nouvelle tâche</h2>
      <form id="form-add-task" class="form-stack">
        <input type="hidden" id="task-status-input" name="status" value="todo" />
        <div class="field">
          <label class="label" for="t-title">Titre *</label>
          <input type="text" id="t-title" name="title" required class="input" maxlength="120" />
        </div>
        <div class="field">
          <label class="label" for="t-desc">Description</label>
          <textarea id="t-desc" name="description" class="input" rows="3" maxlength="800"></textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label class="label" for="t-priority">Priorité</label>
            <select id="t-priority" name="priority" class="input">
              <option value="low">Faible</option>
              <option value="medium" selected>Moyenne</option>
              <option value="high">Haute</option>
            </select>
          </div>
          <div class="field">
            <label class="label" for="t-deadline">Échéance</label>
            <input type="date" id="t-deadline" name="deadline" class="input" />
          </div>
        </div>
        {memberOptions.length > 0 && (
          <div class="field">
            <label class="label" for="t-assignee">Assigner à</label>
            <select id="t-assignee" name="assignee_id" class="input">
              <option value="">— Non assigné —</option>
              {memberOptions.map(m => (
                <option value={m.id}>{m.name}</option>
              ))}
            </select>
          </div>
        )}
        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" id="btn-close-task-modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Créer</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal : Modifier projet -->
  {canEdit && (
    <dialog id="modal-edit-project" class="modal">
      <div class="modal-box">
        <h2 class="modal-title">Modifier le projet</h2>
        <form id="form-edit-project" class="form-stack">
          <div class="field">
            <label class="label" for="ep-title">Titre *</label>
            <input type="text" id="ep-title" name="title" required class="input" value={project.title} maxlength="120" />
          </div>
          <div class="field">
            <label class="label" for="ep-desc">Description</label>
            <textarea id="ep-desc" name="description" class="input" rows="3" maxlength="800">{project.description ?? ''}</textarea>
          </div>
          <div class="field-row">
            <div class="field">
              <label class="label" for="ep-status">Statut</label>
              <select id="ep-status" name="status" class="input">
                <option value="active"    selected={project.status === 'active'}>Actif</option>
                <option value="on_hold"   selected={project.status === 'on_hold'}>En pause</option>
                <option value="completed" selected={project.status === 'completed'}>Terminé</option>
                <option value="archived"  selected={project.status === 'archived'}>Archivé</option>
              </select>
            </div>
            <div class="field">
              <label class="label" for="ep-priority">Priorité</label>
              <select id="ep-priority" name="priority" class="input">
                <option value="low"    selected={project.priority === 'low'}>Faible</option>
                <option value="medium" selected={project.priority === 'medium'}>Moyenne</option>
                <option value="high"   selected={project.priority === 'high'}>Haute</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label class="label" for="ep-deadline">Échéance</label>
            <input type="date" id="ep-deadline" name="deadline" class="input" value={project.deadline ?? ''} />
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-ghost" id="btn-close-edit-modal">Annuler</button>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
          </div>
        </form>
      </div>
    </dialog>
  )}
</DashboardLayout>

<style>
  .project-header      { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .project-header-left { display: flex; flex-direction: column; gap: 6px; }
  .back-link           { font-size: var(--text-xs); color: var(--text-muted); text-decoration: none; }
  .back-link:hover     { text-decoration: underline; }
  .project-title       { font-size: var(--text-xl); font-weight: 700; }
  .project-description { font-size: var(--text-sm); color: var(--text-secondary); max-width: 600px; }
  .project-meta-row    { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .meta-item           { font-size: var(--text-xs); color: var(--text-muted); }
  .project-actions     { display: flex; gap: 8px; align-items: flex-start; flex-shrink: 0; }

  /* Kanban */
  .kanban             { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); align-items: start; }
  @media (max-width: 900px) { .kanban { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .kanban { grid-template-columns: 1fr; } }

  .kanban-col         { display: flex; flex-direction: column; gap: 8px; background: var(--surface); border: var(--brutal-border-thin); padding: var(--space-sm); min-height: 200px; }
  .kanban-col--ok     { border-top: 4px solid var(--ok); }
  .kanban-col--info   { border-top: 4px solid var(--info); }
  .kanban-col--warn   { border-top: 4px solid var(--warn); }
  .kanban-col--neutral{ border-top: 4px solid var(--border-mid); }

  .kanban-col-header  { display: flex; justify-content: space-between; align-items: center; padding-bottom: 6px; border-bottom: 1px solid var(--border-mid); }
  .kanban-col-label   { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .kanban-col-count   { font-size: var(--text-xs); color: var(--text-muted); background: var(--surface-raised); border: 1px solid var(--border-mid); border-radius: 99px; padding: 1px 7px; }
  .kanban-cards       { display: flex; flex-direction: column; gap: 8px; min-height: 60px; }

  .task-card          { background: var(--surface-raised); border: var(--brutal-border-thin); padding: var(--space-sm); display: flex; flex-direction: column; gap: 6px; cursor: default; transition: box-shadow var(--transition-fast); position: relative; }
  .task-card:hover    { box-shadow: var(--shadow-sm); }
  .task-card--mine    { border-left: 4px solid var(--accent); }
  .task-card-title    { font-size: var(--text-sm); font-weight: 600; line-height: 1.3; }
  .task-card-desc     { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.4; }
  .task-card-footer   { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .task-card-actions  { display: flex; gap: 4px; justify-content: flex-end; }
  .task-deadline      { font-size: var(--text-xs); color: var(--text-muted); }
  .task-assignee      { font-size: var(--text-xs); color: var(--text-muted); }
  .btn-icon           { background: none; border: none; cursor: pointer; font-size: 0.85rem; padding: 2px 4px; opacity: .6; }
  .btn-icon:hover     { opacity: 1; }

  .btn-add-col-task   { background: none; border: 1px dashed var(--border-mid); color: var(--text-muted); font-size: var(--text-xs); padding: 6px; cursor: pointer; width: 100%; text-align: left; }
  .btn-add-col-task:hover { border-color: var(--accent); color: var(--accent); }

  /* Badge */
  .badge         { font-size: 0.72rem; padding: 2px 7px; border: 1px solid; font-family: var(--font-mono); }
  .badge-ok      { color: var(--ok-fg);   background: var(--ok-bg);   border-color: var(--ok); }
  .badge-warn    { color: var(--warn-fg); background: var(--warn-bg); border-color: var(--warn); }
  .badge-info    { color: var(--info-fg); background: var(--info-bg); border-color: var(--info); }
  .badge-err     { color: var(--err-fg);  background: var(--err-bg);  border-color: var(--err); }
  .badge-neutral { color: var(--text-muted); background: var(--surface); border-color: var(--border-mid); }

  /* Modal */
  .modal         { border: var(--brutal-border); background: var(--bg); padding: 0; max-width: 500px; width: 90%; }
  .modal::backdrop { background: rgba(0,0,0,.45); }
  .modal-box     { padding: var(--space-xl); }
  .modal-title   { font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-lg); }
  .form-stack    { display: flex; flex-direction: column; gap: var(--space-md); }
  .field         { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .field-row     { display: flex; gap: var(--space-md); }
  .label         { font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .input         { border: var(--brutal-border-thin); background: var(--surface-raised); padding: 6px 10px; font-family: var(--font-sans); font-size: var(--text-sm); outline: none; }
  .input:focus   { box-shadow: var(--shadow-sm); }
  textarea.input { resize: vertical; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 4px; }
</style>

<script define:vars={{ projectId }}>
  // ── Modals ─────────────────────────────────────────────────────────────────
  const modalTask    = document.getElementById('modal-add-task');
  const modalEdit    = document.getElementById('modal-edit-project');
  const statusInput  = document.getElementById('task-status-input');

  document.getElementById('btn-add-task')?.addEventListener('click', () => {
    if (statusInput) statusInput.value = 'todo';
    modalTask?.showModal?.();
  });
  document.getElementById('btn-close-task-modal')?.addEventListener('click', () => modalTask?.close());

  document.getElementById('btn-edit-project')?.addEventListener('click', () => modalEdit?.showModal?.());
  document.getElementById('btn-close-edit-modal')?.addEventListener('click', () => modalEdit?.close());

  // Boutons "+ Ajouter une tâche" dans chaque colonne
  document.querySelectorAll('.btn-add-col-task').forEach(btn => {
    btn.addEventListener('click', () => {
      const status = btn.getAttribute('data-status') ?? 'todo';
      if (statusInput) statusInput.value = status;
      modalTask?.showModal?.();
    });
  });

  // ── Créer tâche ────────────────────────────────────────────────────────────
  document.getElementById('form-add-task')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = Object.fromEntries(new FormData(form));
    data.project_id = projectId;

    const res = await fetch('/api/benevole/tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const err = await res.json().catch(() => ({}));
      alert('Erreur : ' + (err.error ?? 'Impossible de créer la tâche.'));
    }
  });

  // ── Modifier projet ────────────────────────────────────────────────────────
  document.getElementById('form-edit-project')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = Object.fromEntries(new FormData(form));

    const res = await fetch(`/api/benevole/projects?id=${projectId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const err = await res.json().catch(() => ({}));
      alert('Erreur : ' + (err.error ?? 'Impossible de modifier le projet.'));
    }
  });

  // ── Changer statut d'une tâche (drag simplifié via select) ────────────────
  document.querySelectorAll('.btn-delete-task').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      if (!id || !confirm('Supprimer cette tâche ?')) return;
      const res = await fetch(`/api/benevole/tasks?id=${id}`, { method: 'DELETE' });
      if (res.ok) window.location.reload();
      else alert('Erreur lors de la suppression.');
    });
  });

  // ── Déplacer tâche entre colonnes (clic sur colonne header) ───────────────
  document.querySelectorAll('.task-card').forEach(card => {
    card.addEventListener('dblclick', () => {
      const id      = card.getAttribute('data-task-id');
      const current = card.getAttribute('data-status');
      if (!id) return;

      const order = ['todo', 'in_progress', 'review', 'done'];
      const idx   = order.indexOf(current ?? '');
      if (idx === -1 || idx === order.length - 1) return;

      const next = order[idx + 1];
      fetch(`/api/benevole/tasks?id=${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: next }),
      }).then(r => r.ok ? window.location.reload() : alert('Erreur lors du déplacement.'));
    });
  });
</script>
