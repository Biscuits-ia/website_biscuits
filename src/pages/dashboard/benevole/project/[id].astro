---
// src/pages/dashboard/benevole/project/[id].astro
//
// Page de detail d'un projet benevole : kanban, chat, commentaires.
// Le chargement des donnees vit dans lib/project-detail.ts, le comportement
// client dans scripts/project-detail.js, les styles dans
// styles/project-detail.css. Audit P4 #31.
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import ProjectHeader from '../../../../components/project/ProjectHeader.astro';
import ProjectKpis from '../../../../components/project/ProjectKpis.astro';
import ProjectKanban from '../../../../components/project/ProjectKanban.astro';
import ProjectModals from '../../../../components/project/ProjectModals.astro';
import ProjectChat from '../../../../components/project/ProjectChat.astro';
import { requireBenevole } from '../../../../lib/auth';
import { createSupabaseAdminClient } from '../../../../lib/supabase';
import { loadProjectDetail } from '../../../../lib/project-detail';
import { jsonIsland } from '../../../../lib/jsonLd';
import '../../../../styles/project-detail.css';
// `?raw` : le script est injecte tel quel dans un <script is:inline nonce={...}>.
// Un module bundle serait bloque par 'strict-dynamic'. Cf. l'en-tete du fichier.
import projectDetailJs from '../../../../scripts/project-detail.js?raw';

const result = await requireBenevole(Astro);
if (result instanceof Response) return result;

const { user, role } = result;
const userId   = user.id;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Bénévole';
const isStaff  = role === 'admin' || role === 'moderator';

const projectId = Astro.params.id ?? '';
if (!projectId) return Astro.redirect('/dashboard/benevole/projects');

const detail = await loadProjectDetail(createSupabaseAdminClient(), projectId, userId, isStaff);
if (!detail) return Astro.redirect('/dashboard/benevole/projects');

const { project, memberOptions } = detail;
---

<DashboardLayout title={project.title} role="benevole" activePage="projects" userName={userName} userEmail={user.email ?? ''} authResult={result}>
  <div class="project-detail">
    <ProjectHeader detail={detail} />
    <ProjectKpis counts={detail.counts} />
    <ProjectKanban detail={detail} userId={userId} isStaff={isStaff} />
    <ProjectModals detail={detail} projectId={projectId} />
    <ProjectChat />
  </div>
</DashboardLayout>

{/* Donnees serveur -> client. `define:vars` faisait perdre l'attribut nonce au
    build : toute cette page (kanban, chat, commentaires) etait bloquee par la
    CSP en production. Un data-block JSON n'est pas execute, donc hors
    script-src ; le script qui le lit porte le nonce. Cf. lib/jsonLd.ts. */}
<script
  type="application/json"
  id="project-data"
  is:inline
  set:html={jsonIsland({ projectId, memberOptions, userId, userName })}
/>
<script is:inline nonce={Astro.locals.nonce} set:html={projectDetailJs} />
