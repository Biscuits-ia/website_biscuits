---
// src/pages/dashboard/benevole/project/[id].astro
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { requireBenevole } from '../../../../lib/auth';
import { createSupabaseAdminClient } from '../../../../lib/supabase';

const result = await requireBenevole(Astro);
if (result instanceof Response) return result;

const { user, role } = result;
const userId   = user.id;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Bénévole';
const isStaff  = role === 'admin' || role === 'moderator';
const adminSupabase = createSupabaseAdminClient();

const projectId = Astro.params.id ?? '';
if (!projectId) return Astro.redirect('/dashboard/benevole/projects');

// ── Chargement projet + membres + tâches ─────────────────────────────────────
const [
  { data: projectRaw, error: projErr },
  { data: tasksRaw },
  { data: membersRaw },
] = await Promise.all([
  adminSupabase
    .from('projects')
    .select(`
      id, title, description, status, priority, deadline, created_at, leader_id
    `)
    .eq('id', projectId)
    .single(),
  adminSupabase
    .from('project_tasks')
    .select('id, title, description, status, priority, deadline, position, created_by, assignee_id')
    .eq('project_id', projectId)
    .order('status')
    .order('position'),
  adminSupabase
    .from('project_members')
    .select('user_id')
    .eq('project_id', projectId),
]);

if (projErr || !projectRaw) return Astro.redirect('/dashboard/benevole/projects');

// ── Types ─────────────────────────────────────────────────────────────────────
interface Project {
  id: string; title: string; description: string | null;
  status: string; priority: string; deadline: string | null;
  created_at: string; leader_id: string | null;
}
interface Task {
  id: string; title: string; description: string | null;
  status: string; priority: string; deadline: string | null;
  position: number; created_by: string; assignee_id: string | null;
}
interface Member { user_id: string; }

const project = projectRaw as unknown as Project;
const tasks   = (tasksRaw ?? []) as unknown as Task[];
const members = (membersRaw ?? []) as unknown as Member[];

// ── Récupération des profils (sans embedded join) ─────────────────────────────
const allProfileIds = [...new Set([
  ...(project.leader_id ? [project.leader_id] : []),
  ...tasks.map((t: Task) => t.assignee_id).filter((id): id is string => !!id),
  ...members.map((m: Member) => m.user_id),
])];

const profileMap: Record<string, { full_name: string | null; email: string }> = {};
if (allProfileIds.length > 0) {
  const { data: profilesRaw } = await adminSupabase
    .from('profiles')
    .select('id, full_name, email')
    .in('id', allProfileIds);
  for (const p of profilesRaw ?? []) profileMap[p.id] = p;
}

const leaderProfile = project.leader_id ? (profileMap[project.leader_id] ?? null) : null;

// Kolonnes kanban
const columns = [
  { key: 'todo',        label: 'À faire',   cls: 'neutral' },
  { key: 'in_progress', label: 'En cours',  cls: 'info'    },
  { key: 'review',      label: 'Révision',  cls: 'warn'    },
  { key: 'done',        label: 'Terminé',   cls: 'ok'      },
];

const tasksByStatus: Record<string, Task[]> = {};
for (const col of columns) tasksByStatus[col.key] = [];
for (const t of tasks) {
  if (tasksByStatus[t.status]) tasksByStatus[t.status].push(t);
}

const priorityClass: Record<string, string> = { low: 'neutral', medium: 'info', high: 'err' };
const priorityLabel: Record<string, string> = { low: 'Faible', medium: 'Moyenne', high: 'Haute' };
const statusLabel:   Record<string, string> = {
  active: 'Actif', on_hold: 'En pause', completed: 'Terminé', archived: 'Archivé',
};
const statusClass:   Record<string, string> = {
  active: 'ok', on_hold: 'warn', completed: 'info', archived: 'neutral',
};

const isLeader = project.leader_id === userId;
const canEdit  = isLeader || isStaff;

const leaderName = leaderProfile?.full_name ?? leaderProfile?.email ?? '—';
const deadlineStr = project.deadline ? new Date(project.deadline).toLocaleDateString('fr-FR') : null;

// Membres pour assignation
const isMember = members.some((m: Member) => m.user_id === userId);

const memberOptions = members.map((m: Member) => ({
  id: m.user_id,
  name: profileMap[m.user_id]?.full_name ?? profileMap[m.user_id]?.email ?? m.user_id,
}));

// Sérialisation pour le script client (mentions @)
const memberOptionsJson = JSON.stringify(memberOptions);
---

<DashboardLayout title={project.title} role="benevole" activePage="projects" userName={userName} userEmail={user.email ?? ''} authResult={result}>
  <!-- En-tête projet -->
  <div class="project-header mb-6">
    <div class="project-header-left">
      <a href="/dashboard/benevole/projects" class="back-link">← Projets</a>
      <h1 class="project-title">{project.title}</h1>
      {project.description && <p class="project-description">{project.description}</p>}
      <div class="project-meta-row">
        <span class={`badge badge-${statusClass[project.status] ?? 'neutral'}`}>{statusLabel[project.status]}</span>
        <span class={`badge badge-${priorityClass[project.priority] ?? 'neutral'}`}>{priorityLabel[project.priority]}</span>
        <span class="meta-item">👤 {leaderName}</span>
        {deadlineStr && <span class="meta-item">📅 {deadlineStr}</span>}
        <span class="meta-item">👥 {members.length} membre{members.length > 1 ? 's' : ''}</span>
      </div>
    </div>
    {canEdit && (
      <div class="project-actions">
        <button class="btn btn-ghost btn-sm" id="btn-edit-project">Modifier</button>
        <button class="btn btn-primary btn-sm" id="btn-add-task">+ Tâche</button>
      </div>
    )}
  </div>

  <!-- Kanban -->
  <div class="kanban" id="kanban-board" data-project-id={projectId}>
    {columns.map(col => (
      <div class={`kanban-col kanban-col--${col.cls}`} data-status={col.key}>
        <div class="kanban-col-header">
          <span class="kanban-col-label">{col.label}</span>
          <span class="kanban-col-count">{tasksByStatus[col.key].length}</span>
        </div>
        <div class="kanban-cards" id={`col-${col.key}`}>
          {tasksByStatus[col.key].map((t: Task) => {
            const assigneeName = t.assignee_id ? (profileMap[t.assignee_id]?.full_name ?? profileMap[t.assignee_id]?.email ?? null) : null;
            const taskDeadline = t.deadline ? new Date(t.deadline).toLocaleDateString('fr-FR') : null;
            const isMyTask     = t.assignee_id === userId;
            const isUnclaimed  = !t.assignee_id;
            return (
              <div
                class={`task-card${isMyTask ? ' task-card--mine' : ''}`}
                data-task-id={t.id}
                data-status={t.status}
                data-title={t.title}
                data-priority={t.priority}
                data-deadline={t.deadline ?? ''}
                data-assignee-id={t.assignee_id ?? ''}
                data-assignee-name={assigneeName ?? ''}
                data-can-edit={(t.created_by === userId || isStaff) ? 'true' : 'false'}
                draggable="true"
                role="button"
                tabindex="0"
              >
                <div class="task-card-title">{t.title}</div>
                {t.description && <p class="task-card-desc">{t.description}</p>}
                <div class="task-card-footer">
                  <span class={`badge badge-${priorityClass[t.priority] ?? 'neutral'}`}>{priorityLabel[t.priority]}</span>
                  {taskDeadline && <span class="task-deadline">📅 {taskDeadline}</span>}
                  {assigneeName
                    ? <span class="task-assignee">{isMyTask ? '✋ Moi' : `👤 ${assigneeName}`}</span>
                    : <span class="task-assignee task-assignee--free">Disponible</span>
                  }
                  <span class="task-comments-count" data-task-id={t.id}>💬 …</span>
                </div>
                {/* Bouton claim pour tâches libres (membres seulement) */}
                {isUnclaimed && (isMember || isStaff) && (
                  <button
                    class="btn-claim-task"
                    data-id={t.id}
                    title="Prendre cette tâche"
                    onclick="event.stopPropagation()"
                  >✋ Je prends cette tâche</button>
                )}
                {/* Bouton libérer pour le porteur actuel */}
                {isMyTask && (
                  <button
                    class="btn-unclaim-task"
                    data-id={t.id}
                    title="Libérer la tâche"
                    onclick="event.stopPropagation()"
                  >↩ Libérer</button>
                )}
                {(t.created_by === userId || isStaff) && (
                  <div class="task-card-actions">
                    <button class="btn-icon btn-edit-task" data-id={t.id} title="Modifier">✏️</button>
                    <button class="btn-icon btn-delete-task" data-id={t.id} title="Supprimer">🗑</button>
                  </div>
                )}
              </div>
            );
          })}
        </div>
        {canEdit && (
          <button class="btn-add-col-task" data-status={col.key}>+ Ajouter une tâche</button>
        )}
      </div>
    ))}
  </div>

  <!-- Modal : Nouvelle tâche -->
  <dialog id="modal-add-task" class="modal">
    <div class="modal-box">
      <h2 class="modal-title">Nouvelle tâche</h2>
      <form id="form-add-task" class="form-stack">
        <input type="hidden" id="task-status-input" name="status" value="todo" />
        <div class="field">
          <label class="label" for="t-title">Titre *</label>
          <input type="text" id="t-title" name="title" required class="input" maxlength="120" />
        </div>
        <div class="field">
          <label class="label" for="t-desc">Description</label>
          <textarea id="t-desc" name="description" class="input" rows="3" maxlength="800"></textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label class="label" for="t-priority">Priorité</label>
            <select id="t-priority" name="priority" class="input">
              <option value="low">Faible</option>
              <option value="medium" selected>Moyenne</option>
              <option value="high">Haute</option>
            </select>
          </div>
          <div class="field">
            <label class="label" for="t-deadline">Échéance</label>
            <input type="date" id="t-deadline" name="deadline" class="input" />
          </div>
        </div>
        <div class="field">
            <label class="label" for="t-assignee">Assigner à</label>
            <select id="t-assignee" name="assignee_id" class="input">
              <option value="">— Laisser non assigné (claim libre) —</option>
              {memberOptions.map(m => (
                <option value={m.id}>{m.name}</option>
              ))}
            </select>
          </div>
        {/* watchers */}
        <div class="field">
          <label class="label" for="t-watchers">Watchers</label>
          <select id="t-watchers" name="watcher_ids" class="input" multiple style="height:80px">
            {memberOptions.map(m => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
          <span class="field-hint">Ctrl+clic pour sélectionner plusieurs</span>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" id="btn-close-task-modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Créer</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Modal : Modifier projet -->
  {canEdit && (
    <dialog id="modal-edit-project" class="modal">
      <div class="modal-box">
        <h2 class="modal-title">Modifier le projet</h2>
        <form id="form-edit-project" class="form-stack">
          <div class="field">
            <label class="label" for="ep-title">Titre *</label>
            <input type="text" id="ep-title" name="title" required class="input" value={project.title} maxlength="120" />
          </div>
          <div class="field">
            <label class="label" for="ep-desc">Description</label>
            <textarea id="ep-desc" name="description" class="input" rows="3" maxlength="800">{project.description ?? ''}</textarea>
          </div>
          <div class="field-row">
            <div class="field">
              <label class="label" for="ep-status">Statut</label>
              <select id="ep-status" name="status" class="input">
                <option value="active"    selected={project.status === 'active'}>Actif</option>
                <option value="on_hold"   selected={project.status === 'on_hold'}>En pause</option>
                <option value="completed" selected={project.status === 'completed'}>Terminé</option>
                <option value="archived"  selected={project.status === 'archived'}>Archivé</option>
              </select>
            </div>
            <div class="field">
              <label class="label" for="ep-priority">Priorité</label>
              <select id="ep-priority" name="priority" class="input">
                <option value="low"    selected={project.priority === 'low'}>Faible</option>
                <option value="medium" selected={project.priority === 'medium'}>Moyenne</option>
                <option value="high"   selected={project.priority === 'high'}>Haute</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label class="label" for="ep-deadline">Échéance</label>
            <input type="date" id="ep-deadline" name="deadline" class="input" value={project.deadline ?? ''} />
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-ghost" id="btn-close-edit-modal">Annuler</button>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
          </div>
        </form>
      </div>
    </dialog>
  )}

  <!-- Modal : Détail tâche + commentaires + watchers -->
  <dialog id="modal-task-detail" class="modal modal--wide">
    <div class="modal-box">
      <div class="detail-header">
        <h2 class="modal-title" id="detail-title">Tâche</h2>
        <button class="btn btn-ghost btn-sm" id="btn-close-detail">✕</button>
      </div>
      <input type="hidden" id="detail-task-id" />

      <div class="detail-meta" id="detail-meta"></div>

      <div class="detail-body">
        <!-- Colonne principale : description + commentaires -->
        <div class="detail-main">
          <p class="detail-description" id="detail-description"></p>

          <div class="comments-section">
            <h3 class="comments-title">Commentaires</h3>
            <div id="comments-container" class="comments-list">
              <p class="loading-text">Chargement…</p>
            </div>

            <!-- Formulaire commentaire -->
            <form id="form-add-comment" class="comment-form" autocomplete="off">
              <div id="reply-indicator" class="reply-indicator" style="display:none">
                <span>↩ Réponse à <strong id="reply-to-name"></strong></span>
                <button type="button" id="btn-cancel-reply" class="btn-cancel-reply">✕</button>
              </div>
              <input type="hidden" id="comment-parent-id" value="" />
              <div class="comment-input-row">
                <textarea
                  id="comment-input"
                  class="input comment-textarea"
                  rows="2"
                  maxlength="2000"
                  placeholder="Écrire un commentaire… Utilisez @nom pour mentionner"
                ></textarea>
                <button type="submit" class="btn btn-primary btn-sm">Envoyer</button>
              </div>
              <!-- Autocomplete mentions -->
              <ul id="mention-dropdown" class="mention-dropdown" style="display:none"></ul>
            </form>
          </div>
        </div>

        <!-- Colonne latérale : watchers -->
        <div class="detail-sidebar">
          <div class="sidebar-section">
            <h4 class="sidebar-section-title">Watchers</h4>
            <div id="watchers-container" class="watchers-list">
              <p class="loading-text">Chargement…</p>
            </div>
            <button class="btn btn-ghost btn-xs" id="btn-toggle-watch">S'abonner</button>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Chat du projet -->
  <section class="chat-section mt-6" aria-label="Chat du projet">
    <div class="chat-header">
      <h2 class="chat-title">💬 Chat du projet</h2>
      <span class="chat-subtitle">Messages en temps réel • membres uniquement</span>
    </div>
    <div class="chat-messages" id="chat-messages" aria-live="polite">
      <p class="chat-placeholder">Chargement…</p>
    </div>
    <form id="chat-form" class="chat-input-row" autocomplete="off">
      <input
        type="text"
        id="chat-input"
        class="input chat-input"
        placeholder="Écrire un message… (Entrée pour envoyer)"
        maxlength="2000"
      />
      <button type="submit" class="btn btn-primary btn-sm">Envoyer</button>
    </form>
  </section>
</DashboardLayout>

<style>
  .project-header      { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .project-header-left { display: flex; flex-direction: column; gap: 6px; }
  .back-link           { font-size: var(--text-xs); color: var(--text-muted); text-decoration: none; }
  .back-link:hover     { text-decoration: underline; }
  .project-title       { font-size: var(--text-xl); font-weight: 700; }
  .project-description { font-size: var(--text-sm); color: var(--text-secondary); max-width: 600px; }
  .project-meta-row    { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .meta-item           { font-size: var(--text-xs); color: var(--text-muted); }
  .project-actions     { display: flex; gap: 8px; align-items: flex-start; flex-shrink: 0; }

  /* Kanban */
  .kanban             { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); align-items: start; }
  @media (max-width: 900px) { .kanban { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .kanban { grid-template-columns: 1fr; } }

  .kanban-col         { display: flex; flex-direction: column; gap: 8px; background: var(--surface); border: var(--brutal-border-thin); padding: var(--space-sm); min-height: 200px; }
  .kanban-col--ok     { border-top: 4px solid var(--ok); }
  .kanban-col--info   { border-top: 4px solid var(--info); }
  .kanban-col--warn   { border-top: 4px solid var(--warn); }
  .kanban-col--neutral{ border-top: 4px solid var(--border-mid); }

  .kanban-col-header  { display: flex; justify-content: space-between; align-items: center; padding-bottom: 6px; border-bottom: 1px solid var(--border-mid); }
  .kanban-col-label   { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .kanban-col-count   { font-size: var(--text-xs); color: var(--text-muted); background: var(--surface-raised); border: 1px solid var(--border-mid); border-radius: 99px; padding: 1px 7px; }
  .kanban-cards       { display: flex; flex-direction: column; gap: 8px; min-height: 60px; }

  .task-card          { background: var(--surface-raised); border: var(--brutal-border-thin); padding: var(--space-sm); display: flex; flex-direction: column; gap: 6px; cursor: default; transition: box-shadow var(--transition-fast); position: relative; }
  .task-card:hover    { box-shadow: var(--shadow-sm); }
  .task-card--mine    { border-left: 4px solid var(--accent); }
  .task-card-title    { font-size: var(--text-sm); font-weight: 600; line-height: 1.3; }
  .task-card-desc     { font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.4; }
  .task-card-footer   { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .task-card-actions  { display: flex; gap: 4px; justify-content: flex-end; }
  .task-deadline      { font-size: var(--text-xs); color: var(--text-muted); }
  .task-assignee      { font-size: var(--text-xs); color: var(--text-muted); }
  .task-assignee--free { color: var(--ok); font-style: italic; }
  .btn-claim-task     { display: block; width: 100%; margin-top: 4px; padding: 4px 8px; font-size: 0.72rem; font-weight: 600; background: var(--accent); color: var(--accent-fg, #fff); border: var(--brutal-border-thin); cursor: pointer; text-align: center; }
  .btn-claim-task:hover { opacity: .85; }
  .btn-unclaim-task   { display: block; width: 100%; margin-top: 2px; padding: 2px 8px; font-size: 0.68rem; background: none; color: var(--text-muted); border: 1px dashed var(--border-mid); cursor: pointer; text-align: center; }
  .btn-unclaim-task:hover { color: var(--err); border-color: var(--err); }
  .btn-icon           { background: none; border: none; cursor: pointer; font-size: 0.85rem; padding: 2px 4px; opacity: .6; }
  .btn-icon:hover     { opacity: 1; }

  .btn-add-col-task   { background: none; border: 1px dashed var(--border-mid); color: var(--text-muted); font-size: var(--text-xs); padding: 6px; cursor: pointer; width: 100%; text-align: left; }
  .btn-add-col-task:hover { border-color: var(--accent); color: var(--accent); }

  /* Badge */
  .badge         { font-size: 0.72rem; padding: 2px 7px; border: 1px solid; font-family: var(--font-mono); }
  .badge-ok      { color: var(--ok-fg);   background: var(--ok-bg);   border-color: var(--ok); }
  .badge-warn    { color: var(--warn-fg); background: var(--warn-bg); border-color: var(--warn); }
  .badge-info    { color: var(--info-fg); background: var(--info-bg); border-color: var(--info); }
  .badge-err     { color: var(--err-fg);  background: var(--err-bg);  border-color: var(--err); }
  .badge-neutral { color: var(--text-muted); background: var(--surface); border-color: var(--border-mid); }

  /* Modal */
  .modal         { border: var(--brutal-border); background: var(--bg); padding: 0; max-width: 500px; width: 90%; }
  .modal::backdrop { background: rgba(0,0,0,.45); }
  .modal-box     { padding: var(--space-xl); }
  .modal-title   { font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-lg); }
  .form-stack    { display: flex; flex-direction: column; gap: var(--space-md); }
  .field         { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .field-row     { display: flex; gap: var(--space-md); }
  .label         { font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .input         { border: var(--brutal-border-thin); background: var(--surface-raised); padding: 6px 10px; font-family: var(--font-sans); font-size: var(--text-sm); outline: none; }
  .input:focus   { box-shadow: var(--shadow-sm); }
  textarea.input { resize: vertical; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 4px; }

  /* Drag & drop */
  .task-card[draggable="true"]  { cursor: grab; }
  .task-card.is-dragging        { opacity: .4; transform: rotate(1deg); }
  .kanban-cards.drop-target     { background: color-mix(in srgb, var(--accent) 8%, transparent); border: 2px dashed var(--accent); border-radius: 2px; }

  /* Task detail modal */
  .modal--wide         { max-width: 860px; }
  .detail-header       { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-md); }
  .detail-meta         { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: var(--space-md); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--border-mid); }
  .detail-body         { display: grid; grid-template-columns: 1fr 200px; gap: var(--space-lg); }
  @media (max-width: 600px) { .detail-body { grid-template-columns: 1fr; } }
  .detail-main         { display: flex; flex-direction: column; gap: var(--space-md); min-width: 0; }
  .detail-description  { font-size: var(--text-sm); color: var(--text-secondary); white-space: pre-wrap; }
  .detail-sidebar      { display: flex; flex-direction: column; gap: var(--space-md); }
  .sidebar-section     { display: flex; flex-direction: column; gap: 8px; }
  .sidebar-section-title { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }

  /* Comments */
  .comments-section    { display: flex; flex-direction: column; gap: var(--space-sm); }
  .comments-title      { font-size: var(--text-sm); font-weight: 700; margin-bottom: 4px; }
  .comments-list       { display: flex; flex-direction: column; gap: 8px; max-height: 320px; overflow-y: auto; padding-right: 4px; }
  .comment             { background: var(--surface); border: var(--brutal-border-thin); padding: var(--space-sm); display: flex; flex-direction: column; gap: 4px; }
  .comment--reply      { margin-left: 20px; border-left: 3px solid var(--accent); }
  .comment-header      { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .comment-author      { font-size: var(--text-xs); font-weight: 700; }
  .comment-date        { font-size: var(--text-xs); color: var(--text-muted); }
  .comment-body        { font-size: var(--text-sm); white-space: pre-wrap; word-break: break-word; }
  .comment-body .mention { color: var(--accent); font-weight: 600; }
  .btn-reply           { margin-left: auto; font-size: 0.7rem; padding: 2px 6px; }
  .comment-form        { display: flex; flex-direction: column; gap: 6px; margin-top: var(--space-sm); }
  .comment-input-row   { display: flex; gap: 8px; align-items: flex-end; }
  .comment-textarea    { flex: 1; resize: none; min-height: 50px; }
  .reply-indicator     { display: flex; align-items: center; gap: 8px; font-size: var(--text-xs); color: var(--text-muted); background: var(--surface-raised); padding: 4px 8px; border-left: 3px solid var(--accent); }
  .btn-cancel-reply    { background: none; border: none; cursor: pointer; color: var(--text-muted); font-size: 0.7rem; }
  .no-comments, .loading-text, .error-text { font-size: var(--text-xs); color: var(--text-muted); text-align: center; padding: var(--space-sm) 0; }

  /* Mention autocomplete */
  .mention-dropdown    { position: absolute; z-index: 100; background: var(--bg); border: var(--brutal-border); list-style: none; padding: 0; margin: 0; max-height: 150px; overflow-y: auto; min-width: 180px; }
  .mention-dropdown li { padding: 6px 12px; font-size: var(--text-sm); cursor: pointer; }
  .mention-dropdown li:hover, .mention-dropdown li[aria-selected="true"] { background: var(--surface-raised); }

  /* Watchers */
  .watchers-list      { display: flex; flex-direction: column; gap: 4px; }
  .watcher-item       { font-size: var(--text-xs); display: flex; align-items: center; gap: 4px; }
  .watcher-avatar     { width: 20px; height: 20px; border-radius: 50%; background: var(--surface-raised); border: 1px solid var(--border-mid); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; font-weight: 700; flex-shrink: 0; }
  .task-comments-count { font-size: var(--text-xs); color: var(--text-muted); }
  .field-hint          { font-size: 0.7rem; color: var(--text-muted); margin-top: 2px; }
  /* ── Chat ─────────────────────────────────────────────────────────────── */
  .chat-section       { border: var(--brutal-border-thin); background: var(--surface); }
  .chat-header        { display: flex; justify-content: space-between; align-items: center; padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--border-mid); }
  .chat-title         { font-size: var(--text-sm); font-weight: 700; margin: 0; }
  .chat-subtitle      { font-size: 0.68rem; color: var(--text-muted); }
  .chat-messages      { display: flex; flex-direction: column; gap: 2px; height: 340px; overflow-y: auto; padding: var(--space-sm) var(--space-md); scroll-behavior: smooth; }
  .chat-placeholder   { font-size: var(--text-xs); color: var(--text-muted); text-align: center; margin: auto; }
  .chat-msg           { display: flex; flex-direction: column; gap: 2px; padding: 6px 10px; max-width: 75%; }
  .chat-msg--own      { align-self: flex-end; background: color-mix(in srgb, var(--accent) 12%, var(--surface-raised)); border-left: 3px solid var(--accent); }
  .chat-msg--other    { align-self: flex-start; background: var(--surface-raised); border: var(--brutal-border-thin); }
  .chat-msg-header    { display: flex; gap: 8px; align-items: center; }
  .chat-msg-author    { font-size: 0.68rem; font-weight: 700; color: var(--text-secondary); }
  .chat-msg-time      { font-size: 0.64rem; color: var(--text-muted); }
  .chat-msg-body      { font-size: var(--text-sm); word-break: break-word; white-space: pre-wrap; }
  .btn-delete-msg     { background: none; border: none; cursor: pointer; color: var(--text-muted); font-size: 0.65rem; padding: 0 2px; opacity: 0; transition: opacity .15s; }
  .chat-msg:hover .btn-delete-msg { opacity: 1; }
  .chat-input-row     { display: flex; gap: 8px; padding: var(--space-sm) var(--space-md); border-top: 1px solid var(--border-mid); }
  .chat-input         { flex: 1; }
  .mt-6               { margin-top: var(--space-xl); }
</style>

<script define:vars={{ projectId, memberOptionsJson, userId, isMember, isStaff, userName }}>
  /* ── Helpers ──────────────────────────────────────────────────────────────── */
  const memberOptions = JSON.parse(memberOptionsJson);

  function esc(str) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── Modals ─────────────────────────────────────────────────────────────────*/
  const modalTask    = document.getElementById('modal-add-task');
  const modalEdit    = document.getElementById('modal-edit-project');
  const modalDetail  = document.getElementById('modal-task-detail');
  const statusInput  = document.getElementById('task-status-input');

  document.getElementById('btn-add-task')?.addEventListener('click', () => {
    if (statusInput) statusInput.value = 'todo';
    if (modalTask instanceof HTMLDialogElement) modalTask.showModal();
  });
  document.getElementById('btn-close-task-modal')?.addEventListener('click', () => {
    if (modalTask instanceof HTMLDialogElement) modalTask.close();
  });
  document.getElementById('btn-edit-project')?.addEventListener('click', () => {
    if (modalEdit instanceof HTMLDialogElement) modalEdit.showModal();
  });
  document.getElementById('btn-close-edit-modal')?.addEventListener('click', () => {
    if (modalEdit instanceof HTMLDialogElement) modalEdit.close();
  });
  document.getElementById('btn-close-detail')?.addEventListener('click', () => {
    if (modalDetail instanceof HTMLDialogElement) modalDetail.close();
  });

  document.querySelectorAll('.btn-add-col-task').forEach(btn => {
    btn.addEventListener('click', () => {
      const status = btn.getAttribute('data-status') ?? 'todo';
      if (statusInput) statusInput.value = status;
      if (modalTask instanceof HTMLDialogElement) modalTask.showModal();
    });
  });

  /* ── Drag & Drop ─────────────────────────────────────────────────────────── */
  let draggedTaskId = null;
  let draggedEl = null;

  document.querySelectorAll('.task-card').forEach(card => {
    card.addEventListener('dragstart', (e) => {
      draggedTaskId = card.getAttribute('data-task-id');
      draggedEl = card;
      card.classList.add('is-dragging');
      if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
    });
    card.addEventListener('dragend', () => {
      card.classList.remove('is-dragging');
      draggedTaskId = null;
      draggedEl = null;
      document.querySelectorAll('.kanban-cards').forEach(c => c.classList.remove('drop-target'));
    });
  });

  document.querySelectorAll('.kanban-cards').forEach(col => {
    col.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      col.classList.add('drop-target');
    });
    col.addEventListener('dragleave', (e) => {
      if (!col.contains(e.relatedTarget)) col.classList.remove('drop-target');
    });
    col.addEventListener('drop', async (e) => {
      e.preventDefault();
      col.classList.remove('drop-target');
      if (!draggedTaskId || !draggedEl) return;

      const colEl    = col.closest('.kanban-col');
      const newStatus = colEl?.getAttribute('data-status');
      const oldStatus = draggedEl.getAttribute('data-status');
      if (!newStatus || oldStatus === newStatus) return;

      // Optimistic update in DOM
      col.appendChild(draggedEl);
      draggedEl.setAttribute('data-status', newStatus);
      // Update column counts
      updateColCounts();

      try {
        const res = await fetch(`/api/benevole/tasks?id=${draggedTaskId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });
        if (!res.ok) window.location.reload();
      } catch { window.location.reload(); }
    });
  });

  function updateColCounts() {
    document.querySelectorAll('.kanban-col').forEach(col => {
      const status = col.getAttribute('data-status');
      const count  = col.querySelectorAll('.task-card').length;
      const badge  = col.querySelector('.kanban-col-count');
      if (badge) badge.textContent = String(count);
    });
  }

  /* ── Créer tâche ──────────────────────────────────────────────────────────── */
  document.getElementById('form-add-task')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    const data = Object.fromEntries(new FormData(form));
    data.project_id = projectId;

    // Handle watcher_ids (multi-select)
    const watcherSelect = form.querySelector('#t-watchers');
    const watcherIds = watcherSelect instanceof HTMLSelectElement
      ? Array.from(watcherSelect.selectedOptions).map(o => o.value).filter(Boolean)
      : [];

    const res = await fetch('/api/benevole/tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });

    if (res.ok) {
      const { data: task } = await res.json();
      // Add watchers after task creation
      if (watcherIds.length > 0 && task?.id) {
        await Promise.all(watcherIds.map(wId =>
          fetch('/api/benevole/task-watchers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ task_id: task.id, user_id: wId }),
          })
        ));
      }
      window.location.reload();
    } else {
      const err = await res.json().catch(() => ({}));
      alert('Erreur : ' + (err.error ?? 'Impossible de créer la tâche.'));
    }
  });

  /* ── Modifier projet ──────────────────────────────────────────────────────── */
  document.getElementById('form-edit-project')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    const data = Object.fromEntries(new FormData(form));

    const res = await fetch(`/api/benevole/projects?id=${projectId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const err = await res.json().catch(() => ({}));
      alert('Erreur : ' + (err.error ?? 'Impossible de modifier le projet.'));
    }
  });

  /* ── Claim tâche ─────────────────────────────────────────────────────────── */
  document.querySelectorAll('.btn-claim-task').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      if (!id) return;
      btn.disabled = true;
      btn.textContent = '…';
      try {
        const res = await fetch(`/api/benevole/tasks?id=${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'claim' }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json().catch(() => ({}));
          alert(err.error ?? 'Impossible de prendre cette tâche.');
          btn.disabled = false;
          btn.textContent = '✋ Je prends cette tâche';
        }
      } catch {
        btn.disabled = false;
        btn.textContent = '✋ Je prends cette tâche';
      }
    });
  });

  /* ── Unclaim tâche ────────────────────────────────────────────────────────── */
  document.querySelectorAll('.btn-unclaim-task').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      if (!id || !confirm('Libérer cette tâche ?')) return;
      const res = await fetch(`/api/benevole/tasks?id=${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'unclaim' }),
      });
      if (res.ok) window.location.reload();
      else alert('Erreur lors de la libération.');
    });
  });

  /* ── Supprimer tâche ──────────────────────────────────────────────────────── */
  document.querySelectorAll('.btn-delete-task').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      if (!id || !confirm('Supprimer cette tâche ?')) return;
      const res = await fetch(`/api/benevole/tasks?id=${id}`, { method: 'DELETE' });
      if (res.ok) window.location.reload();
      else alert('Erreur lors de la suppression.');
    });
  });

  /* ── Avancement double-clic (fallback sans D&D) ───────────────────────────── */
  document.querySelectorAll('.task-card').forEach(card => {
    card.addEventListener('dblclick', (e) => {
      if (e.target.closest('.task-card-actions')) return;
      const id      = card.getAttribute('data-task-id');
      const current = card.getAttribute('data-status');
      if (!id) return;
      const order = ['todo', 'in_progress', 'review', 'done'];
      const idx   = order.indexOf(current ?? '');
      if (idx === -1 || idx === order.length - 1) return;
      const next = order[idx + 1];
      card.setAttribute('data-status', next);
      updateColCounts();
      fetch(`/api/benevole/tasks?id=${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: next }),
      }).then(r => { if (!r.ok) window.location.reload(); });
    });
  });

  /* ── Task Detail Modal ───────────────────────────────────────────────────── */
  document.querySelectorAll('.task-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('.task-card-actions')) return;
      if (e.detail === 2) return; // ignore dblclick
      const taskId = card.getAttribute('data-task-id');
      if (!taskId) return;
      openTaskDetail(taskId, card);
    });
    // Keyboard accessibility
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const taskId = card.getAttribute('data-task-id');
        if (taskId) openTaskDetail(taskId, card);
      }
    });
  });

  async function openTaskDetail(taskId, card) {
    const detailTaskIdEl = document.getElementById('detail-task-id');
    const detailTitle    = document.getElementById('detail-title');
    const detailDesc     = document.getElementById('detail-description');
    const detailMeta     = document.getElementById('detail-meta');
    if (!detailTaskIdEl || !detailTitle || !detailDesc || !detailMeta) return;

    detailTaskIdEl.value = taskId;

    // Populate from card data attributes
    const title       = card.getAttribute('data-title')         ?? '';
    const desc        = card.getAttribute('data-description')   ?? '';
    const priority    = card.getAttribute('data-priority')      ?? '';
    const deadline    = card.getAttribute('data-deadline')      ?? '';
    const assigneeName = card.getAttribute('data-assignee-name') ?? '';

    detailTitle.textContent = title;
    detailDesc.textContent  = desc || '(Pas de description)';

    const priorityLabels = { low: 'Faible', medium: 'Moyenne', high: 'Haute' };
    const priorityClasses = { low: 'neutral', medium: 'info', high: 'err' };
    let metaHtml = `<span class="badge badge-${priorityClasses[priority] ?? 'neutral'}">${esc(priorityLabels[priority] ?? priority)}</span>`;
    if (deadline) metaHtml += `<span class="meta-item">📅 ${new Date(deadline).toLocaleDateString('fr-FR')}</span>`;
    if (assigneeName) metaHtml += `<span class="meta-item">👤 ${esc(assigneeName)}</span>`;
    detailMeta.innerHTML = metaHtml;

    // Reset comment form
    const commentInput = document.getElementById('comment-input');
    const commentParentId = document.getElementById('comment-parent-id');
    const replyIndicator = document.getElementById('reply-indicator');
    if (commentInput instanceof HTMLTextAreaElement) commentInput.value = '';
    if (commentParentId instanceof HTMLInputElement) commentParentId.value = '';
    if (replyIndicator) replyIndicator.style.display = 'none';

    // Update watch button
    await loadWatchers(taskId);
    // Load comments
    await loadComments(taskId);

    if (modalDetail instanceof HTMLDialogElement) modalDetail.showModal();
  }

  /* ── Comments ────────────────────────────────────────────────────────────── */
  async function loadComments(taskId) {
    const container = document.getElementById('comments-container');
    if (!container) return;
    container.innerHTML = '<p class="loading-text">Chargement…</p>';
    try {
      const res = await fetch(`/api/benevole/task-comments?task_id=${taskId}`);
      if (!res.ok) throw new Error();
      const { data } = await res.json();
      renderComments(container, data ?? [], taskId);
    } catch {
      container.innerHTML = '<p class="error-text">Erreur de chargement.</p>';
    }
  }

  function renderComments(container, comments, taskId) {
    if (!comments.length) {
      container.innerHTML = '<p class="no-comments">Aucun commentaire.</p>';
      return;
    }
    const roots   = comments.filter(c => !c.parent_id);
    const replies = comments.filter(c =>  c.parent_id);
    container.innerHTML = roots.map(c => {
      const children = replies.filter(r => r.parent_id === c.id);
      return renderOneComment(c, false) + children.map(r => renderOneComment(r, true)).join('');
    }).join('');

    container.querySelectorAll('.btn-reply').forEach(btn => {
      btn.addEventListener('click', () => {
        const parentId   = btn.getAttribute('data-parent-id');
        const authorName = btn.getAttribute('data-author-name');
        const commentParentId = document.getElementById('comment-parent-id');
        const replyIndicator  = document.getElementById('reply-indicator');
        const replyToName     = document.getElementById('reply-to-name');
        const commentInput    = document.getElementById('comment-input');
        if (commentParentId instanceof HTMLInputElement) commentParentId.value = parentId ?? '';
        if (replyToName) replyToName.textContent = authorName ?? '';
        if (replyIndicator) replyIndicator.style.display = 'flex';
        if (commentInput) commentInput.focus();
      });
    });

    container.querySelectorAll('.btn-delete-comment').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!id || !confirm('Supprimer ce commentaire ?')) return;
        const res = await fetch(`/api/benevole/task-comments?id=${id}`, { method: 'DELETE' });
        if (res.ok) await loadComments(taskId);
        else alert('Erreur lors de la suppression.');
      });
    });
  }

  function renderOneComment(c, isReply) {
    const date       = new Date(c.created_at).toLocaleDateString('fr-FR');
    const profileArr = c.profiles;
    const profile    = Array.isArray(profileArr) ? profileArr[0] : profileArr;
    const authorName = profile?.full_name ?? profile?.email ?? 'Inconnu';
    const isOwn      = c.author_id === userId;
    const body       = esc(c.content).replace(/@([a-zA-Z0-9_\-\.]+)/g, '<span class="mention">@$1</span>');
    return `
      <div class="comment${isReply ? ' comment--reply' : ''}" data-comment-id="${esc(c.id)}">
        <div class="comment-header">
          <span class="comment-author">${esc(authorName)}</span>
          <span class="comment-date">${date}</span>
          ${!isReply ? `<button class="btn btn-ghost btn-xs btn-reply" data-parent-id="${esc(c.id)}" data-author-name="${esc(authorName)}">↩ Répondre</button>` : ''}
          ${isOwn ? `<button class="btn btn-ghost btn-xs btn-delete-comment" data-id="${esc(c.id)}" style="color:var(--err)">🗑</button>` : ''}
        </div>
        <div class="comment-body">${body}</div>
      </div>`;
  }

  document.getElementById('btn-cancel-reply')?.addEventListener('click', () => {
    const commentParentId = document.getElementById('comment-parent-id');
    const replyIndicator  = document.getElementById('reply-indicator');
    if (commentParentId instanceof HTMLInputElement) commentParentId.value = '';
    if (replyIndicator) replyIndicator.style.display = 'none';
  });

  document.getElementById('form-add-comment')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const taskId    = document.getElementById('detail-task-id')?.value;
    const content   = document.getElementById('comment-input')?.value?.trim();
    const parentId  = document.getElementById('comment-parent-id')?.value || null;
    if (!taskId || !content) return;

    const res = await fetch('/api/benevole/task-comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ task_id: taskId, content, parent_id: parentId }),
    });

    if (res.ok) {
      const commentInput    = document.getElementById('comment-input');
      const commentParentId = document.getElementById('comment-parent-id');
      const replyIndicator  = document.getElementById('reply-indicator');
      if (commentInput instanceof HTMLTextAreaElement) commentInput.value = '';
      if (commentParentId instanceof HTMLInputElement) commentParentId.value = '';
      if (replyIndicator) replyIndicator.style.display = 'none';
      await loadComments(taskId);
    } else {
      const err = await res.json().catch(() => ({}));
      alert('Erreur : ' + (err.error ?? 'Impossible d\'ajouter le commentaire.'));
    }
  });

  /* ── @Mention Autocomplete ───────────────────────────────────────────────── */
  const commentInput     = document.getElementById('comment-input');
  const mentionDropdown  = document.getElementById('mention-dropdown');

  if (commentInput instanceof HTMLTextAreaElement && mentionDropdown) {
    commentInput.addEventListener('input', () => {
      const value  = commentInput.value;
      const cursor = commentInput.selectionStart ?? 0;
      const textBefore = value.slice(0, cursor);
      const mentionMatch = textBefore.match(/@([a-zA-Z0-9_\-\.]*)$/);

      if (!mentionMatch) {
        mentionDropdown.style.display = 'none';
        return;
      }

      const query = mentionMatch[1].toLowerCase();
      const filtered = memberOptions.filter(m =>
        m.name.toLowerCase().includes(query)
      ).slice(0, 5);

      if (!filtered.length) {
        mentionDropdown.style.display = 'none';
        return;
      }

      mentionDropdown.innerHTML = filtered.map(m =>
        `<li data-name="${esc(m.name)}">${esc(m.name)}</li>`
      ).join('');
      mentionDropdown.style.display = 'block';
    });

    mentionDropdown.addEventListener('mousedown', (e) => {
      const li = e.target.closest('li');
      if (!li) return;
      e.preventDefault();
      const name   = li.getAttribute('data-name') ?? '';
      const value  = commentInput.value;
      const cursor = commentInput.selectionStart ?? 0;
      const before = value.slice(0, cursor).replace(/@[a-zA-Z0-9_\-\.]*$/, `@${name} `);
      commentInput.value = before + value.slice(cursor);
      commentInput.focus();
      mentionDropdown.style.display = 'none';
    });

    document.addEventListener('click', (e) => {
      if (!commentInput.contains(e.target) && !mentionDropdown.contains(e.target)) {
        mentionDropdown.style.display = 'none';
      }
    });
  }

  /* ── Watchers ────────────────────────────────────────────────────────────── */
  let currentUserIsWatcher = false;

  async function loadWatchers(taskId) {
    const container = document.getElementById('watchers-container');
    const btn       = document.getElementById('btn-toggle-watch');
    if (!container) return;
    container.innerHTML = '<p class="loading-text">Chargement…</p>';
    try {
      const res = await fetch(`/api/benevole/task-watchers?task_id=${taskId}`);
      if (!res.ok) throw new Error();
      const { data } = await res.json();
      const watchers = data ?? [];
      currentUserIsWatcher = watchers.some(w => w.user_id === userId);

      if (!watchers.length) {
        container.innerHTML = '<p class="no-comments">Aucun watcher.</p>';
      } else {
        container.innerHTML = watchers.map(w => {
          const profileArr = w.profiles;
          const profile    = Array.isArray(profileArr) ? profileArr[0] : profileArr;
          const name       = profile?.full_name ?? profile?.email ?? w.user_id;
          const initials   = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
          return `<div class="watcher-item"><div class="watcher-avatar">${esc(initials)}</div>${esc(name)}</div>`;
        }).join('');
      }

      if (btn) btn.textContent = currentUserIsWatcher ? 'Se désabonner' : 'S\'abonner';
    } catch {
      container.innerHTML = '<p class="error-text">Erreur.</p>';
    }
  }

  document.getElementById('btn-toggle-watch')?.addEventListener('click', async () => {
    const taskId = document.getElementById('detail-task-id')?.value;
    if (!taskId) return;

    if (currentUserIsWatcher) {
      await fetch(`/api/benevole/task-watchers?task_id=${taskId}`, { method: 'DELETE' });
    } else {
      await fetch('/api/benevole/task-watchers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ task_id: taskId }),
      });
    }
    await loadWatchers(taskId);
  });

  /* ── Chargement du nombre de commentaires par carte ──────────────────────── */
  async function loadCommentCounts() {
    const spans = document.querySelectorAll('.task-comments-count[data-task-id]');
    // Batch: fetch all in parallel
    await Promise.all(Array.from(spans).map(async span => {
      const tId = span.getAttribute('data-task-id');
      if (!tId) return;
      try {
        const res = await fetch(`/api/benevole/task-comments?task_id=${tId}`);
        if (!res.ok) return;
        const { data } = await res.json();
        span.textContent = `💬 ${(data ?? []).length}`;
      } catch { /* silent */ }
    }));
  }
  // Load counts in background without blocking
  loadCommentCounts();

    /* ── Chat ────────────────────────────────────────────────────────────────── */
    let lastMsgTime = '';

    function renderChatMsg(msg) {
      const isOwn = msg.is_own ?? msg.author_id === userId;
      const t = new Date(msg.created_at);
      const now = new Date();
      const sameDay = t.toDateString() === now.toDateString();
      const timeStr = sameDay
        ? t.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })
        : t.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' }) + ' ' + t.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
      const cls = isOwn ? 'chat-msg chat-msg--own' : 'chat-msg chat-msg--other';
      return `<div class="${cls}" data-msg-id="${esc(msg.id)}">
        <div class="chat-msg-header">
          <span class="chat-msg-author">${esc(isOwn ? 'Moi' : msg.author_name)}</span>
          <span class="chat-msg-time">${timeStr}</span>
          ${isOwn ? `<button class="btn-delete-msg" data-id="${esc(msg.id)}" title="Supprimer">🗑</button>` : ''}
        </div>
        <div class="chat-msg-body">${esc(msg.content)}</div>
      </div>`;
    }

    function attachChatDeleteHandlers() {
      document.querySelectorAll('.btn-delete-msg:not([data-bound])').forEach(btn => {
        btn.setAttribute('data-bound', '1');
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (!id || !confirm('Supprimer ce message ?')) return;
          const res = await fetch(`/api/benevole/project-messages?id=${id}`, { method: 'DELETE' });
          if (res.ok) btn.closest('.chat-msg')?.remove();
          else alert('Erreur lors de la suppression.');
        });
      });
    }

    async function loadChatMessages(since = '') {
      let url = `/api/benevole/project-messages?project_id=${projectId}`;
      if (since) url += `&since=${encodeURIComponent(since)}`;
      const res = await fetch(url);
      if (!res.ok) return [];
      const { data } = await res.json();
      return data ?? [];
    }

    async function initChat() {
      const container = document.getElementById('chat-messages');
      if (!container) return;
      const messages = await loadChatMessages();
      if (messages.length === 0) {
        container.innerHTML = "<p class=\"chat-placeholder\">Aucun message pour l'instant. Soyez le premier !</p>";
      } else {
        container.innerHTML = messages.map(renderChatMsg).join('');
        lastMsgTime = messages[messages.length - 1].created_at;
        attachChatDeleteHandlers();
      }
      container.scrollTop = container.scrollHeight;
      setInterval(async () => {
        const newMsgs = await loadChatMessages(lastMsgTime);
        if (!newMsgs.length) return;
        const wasAtBottom = container.scrollHeight - container.scrollTop - container.clientHeight < 60;
        const placeholder = container.querySelector('.chat-placeholder');
        if (placeholder) placeholder.remove();
        container.insertAdjacentHTML('beforeend', newMsgs.map(renderChatMsg).join(''));
        lastMsgTime = newMsgs[newMsgs.length - 1].created_at;
        attachChatDeleteHandlers();
        if (wasAtBottom) container.scrollTop = container.scrollHeight;
      }, 4000);
    }

    document.getElementById('chat-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('chat-input');
      if (!(input instanceof HTMLInputElement)) return;
      const content = input.value.trim();
      if (!content) return;
      const submitBtn = document.querySelector('#chat-form button[type="submit"]');
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
      input.disabled = true;
      const res = await fetch('/api/benevole/project-messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project_id: projectId, content }),
      });
      if (res.ok) {
        const { data: msg } = await res.json();
        const container = document.getElementById('chat-messages');
        if (container && msg) {
          const placeholder = container.querySelector('.chat-placeholder');
          if (placeholder) placeholder.remove();
          container.insertAdjacentHTML('beforeend', renderChatMsg({ ...msg, author_name: userName, is_own: true }));
          lastMsgTime = msg.created_at;
          attachChatDeleteHandlers();
          container.scrollTop = container.scrollHeight;
        }
        input.value = '';
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.error ?? "Impossible d'envoyer le message.");
      }
      input.disabled = false;
      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
      input.focus();
    });

    document.getElementById('chat-input')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        document.getElementById('chat-form')?.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
      }
    });

    initChat();
</script>
