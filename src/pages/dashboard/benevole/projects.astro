---
// src/pages/dashboard/benevole/projects.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireBenevole } from '../../../lib/auth';
import { createSupabaseAdminClient } from '../../../lib/supabase';

const result = await requireBenevole(Astro);
if (result instanceof Response) return result;

const { user, role, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Bénévole';
const isStaff  = role === 'admin' || role === 'moderator';
let adminSupabase: ReturnType<typeof createSupabaseAdminClient> | null = null;
let adminClientInitError: string | null = null;
try {
  adminSupabase = createSupabaseAdminClient();
} catch (e) {
  adminClientInitError = e instanceof Error ? e.message : 'Unknown admin client init error';
  console.error('[dashboard/benevole/projects] admin client init failed:', adminClientInitError);
}

const statusFilter = Astro.url.searchParams.get('status') ?? '';
const search       = (Astro.url.searchParams.get('q') ?? '').replace(/[,()[\]]/g, '');

const projectSelect = `
  id, title, description, status, priority, deadline, created_at,
  leader_id
`;

type ProjectDbRow = {
  id: string;
  title: string;
  description: string | null;
  status: string;
  priority: string;
  deadline: string | null;
  created_at: string;
  leader_id: string | null;
};

let projectsRaw: ProjectDbRow[] = [];
let projectsError: { message: string } | null = null;
let source: 'service_role' | 'user_client' = 'service_role';

if (adminSupabase) {
  let query = adminSupabase
    .from('projects')
    .select(projectSelect)
    .order('status')
    .order('deadline', { ascending: true, nullsFirst: false });

  if (statusFilter) query = query.eq('status', statusFilter);
  if (search)       query = query.ilike('title', `%${search}%`);

  const { data, error } = await query;
  projectsRaw = (data ?? []) as unknown as ProjectDbRow[];
  projectsError = error ? { message: error.message } : null;
}

// Fallback: if service_role cannot read, try user-bound client to detect env mismatch.
if (projectsError || projectsRaw.length === 0) {
  source = 'user_client';
  let fallbackQuery = supabase
    .from('projects')
    .select(projectSelect)
    .order('status')
    .order('deadline', { ascending: true, nullsFirst: false });

  if (statusFilter) fallbackQuery = fallbackQuery.eq('status', statusFilter);
  if (search)       fallbackQuery = fallbackQuery.ilike('title', `%${search}%`);

  const { data: fallbackData, error: fallbackError } = await fallbackQuery;
  if (fallbackData && fallbackData.length > 0) {
    projectsRaw = fallbackData as unknown as ProjectDbRow[];
    projectsError = null;
  } else if (projectsRaw.length === 0) {
    projectsError = fallbackError ? { message: fallbackError.message } : projectsError;
  }
}

if (projectsError) {
  console.error('[dashboard/benevole/projects] load error:', projectsError.message);
}

const loadError = projectsError
  ? `Impossible de charger les projets pour le moment. (${projectsError.message})`
  : null;

const debugMode = Astro.url.searchParams.get('debug') === '1';

const leaderIds = [...new Set(((projectsRaw ?? []) as Array<{ leader_id: string | null }>)
  .map((p) => p.leader_id)
  .filter((id): id is string => Boolean(id)))];

let leadersById: Record<string, { full_name: string | null; email: string }> = {};
if (leaderIds.length > 0 && adminSupabase) {
  const { data: leadersRaw } = await adminSupabase
    .from('profiles')
    .select('id, full_name, email')
    .in('id', leaderIds);

  leadersById = Object.fromEntries(
    (leadersRaw ?? []).map((row) => [row.id, { full_name: row.full_name, email: row.email }]),
  );
} else if (leaderIds.length > 0) {
  const { data: leadersRaw } = await supabase
    .from('profiles')
    .select('id, full_name, email')
    .in('id', leaderIds);

  leadersById = Object.fromEntries(
    (leadersRaw ?? []).map((row) => [row.id, { full_name: row.full_name, email: row.email }]),
  );
}

interface ProjectRow {
  id: string; title: string; description: string | null;
  status: string; priority: string; deadline: string | null;
  created_at: string; leader_id: string | null;
}

const projects = (projectsRaw ?? []) as unknown as ProjectRow[];

const statusLabel: Record<string, string> = {
  active: 'Actif', on_hold: 'En pause', completed: 'Terminé', archived: 'Archivé',
};
const statusClass: Record<string, string> = {
  active: 'ok', on_hold: 'warn', completed: 'info', archived: 'neutral',
};
const priorityClass: Record<string, string> = {
  low: 'neutral', medium: 'info', high: 'err',
};
const priorityLabel: Record<string, string> = {
  low: 'Faible', medium: 'Moyenne', high: 'Haute',
};
---

<DashboardLayout title="Projets" activePage="projects" userName={userName} userEmail={user.email ?? ''} authResult={result}>
  {loadError && (
    <div class="card mb-4">
      <p class="empty-state" style="color: var(--err-fg)">{loadError}</p>
    </div>
  )}

  {debugMode && (
    <div class="card mb-4">
      <p class="empty-state" style="margin-bottom:6px;"><strong>Debug Projets</strong></p>
      <p class="empty-state">source={source} | count={projectsRaw.length} | role={role}</p>
      <p class="empty-state">userId={user.id}</p>
      <p class="empty-state">adminClientInitError={adminClientInitError ?? 'none'}</p>
      <p class="empty-state">supabaseHost={(() => { try { return new URL(import.meta.env.SUPABASE_URL).host; } catch { return 'invalid-supabase-url'; } })()}</p>
      <p class="empty-state">projectsError={projectsError?.message ?? 'none'}</p>
      <p class="empty-state">ids={projectsRaw.slice(0, 10).map(p => p.id).join(', ') || 'none'}</p>
    </div>
  )}

  <div class="page-header mb-6">
    <div>
      <h1 class="page-title">Projets</h1>
      <p class="description">Tous les projets de l'association.</p>
    </div>
    {isStaff && (
      <button class="btn btn-primary" id="btn-new-project">+ Nouveau projet</button>
    )}
  </div>

  <!-- Filtres -->
  <form method="GET" class="filters mb-5">
    <input
      type="text"
      name="q"
      placeholder="Rechercher un projet…"
      value={search}
      class="input input-sm"
    />
    <select name="status" class="input input-sm" data-autosubmit="1">
      <option value="">Tous les statuts</option>
      <option value="active"    selected={statusFilter === 'active'}>Actif</option>
      <option value="on_hold"   selected={statusFilter === 'on_hold'}>En pause</option>
      <option value="completed" selected={statusFilter === 'completed'}>Terminé</option>
      <option value="archived"  selected={statusFilter === 'archived'}>Archivé</option>
    </select>
    <button type="submit" class="btn btn-ghost btn-sm">Filtrer</button>
  </form>

  <!-- Liste projets -->
  {projects.length === 0 ? (
    <div class="card">
      <p class="empty-state">Aucun projet trouvé.</p>
    </div>
  ) : (
    <div class="projects-grid">
      {projects.map((p: ProjectRow) => {
        const leaderProfile = p.leader_id ? leadersById[p.leader_id] : null;
        const leader = leaderProfile?.full_name ?? leaderProfile?.email ?? '—';
        const deadlineStr = p.deadline ? new Date(p.deadline).toLocaleDateString('fr-FR') : null;
        return (
          <a href={`/dashboard/benevole/project/${p.id}`} class="project-card">
            <div class="project-card-header">
              <span class="project-card-title">{p.title}</span>
              <div class="project-card-badges">
                <span class={`badge badge-${statusClass[p.status] ?? 'neutral'}`}>{statusLabel[p.status]}</span>
                <span class={`badge badge-${priorityClass[p.priority] ?? 'neutral'}`}>{priorityLabel[p.priority]}</span>
              </div>
            </div>
            {p.description && <p class="project-card-desc">{p.description}</p>}
            <div class="project-card-footer">
              <span class="project-card-meta">👤 {leader}</span>
              {deadlineStr && <span class="project-card-meta">📅 {deadlineStr}</span>}
            </div>
          </a>
        );
      })}
    </div>
  )}

  <!-- Modal nouveau projet (staff only) -->
  {isStaff && (
    <dialog id="modal-new-project" class="modal">
      <div class="modal-box">
        <h2 class="modal-title">Nouveau projet</h2>
        <form method="POST" action="/api/benevole/projects" class="form-stack" id="form-new-project">
          <div class="field">
            <label class="label" for="np-title">Titre *</label>
            <input type="text" id="np-title" name="title" required class="input" maxlength="120" />
          </div>
          <div class="field">
            <label class="label" for="np-desc">Description</label>
            <textarea id="np-desc" name="description" class="input" rows="3" maxlength="800"></textarea>
          </div>
          <div class="field-row">
            <div class="field">
              <label class="label" for="np-priority">Priorité</label>
              <select id="np-priority" name="priority" class="input">
                <option value="low">Faible</option>
                <option value="medium" selected>Moyenne</option>
                <option value="high">Haute</option>
              </select>
            </div>
            <div class="field">
              <label class="label" for="np-deadline">Échéance</label>
              <input type="date" id="np-deadline" name="deadline" class="input" />
            </div>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn btn-ghost" id="btn-close-modal">Annuler</button>
            <button type="submit" class="btn btn-primary">Créer</button>
          </div>
        </form>
      </div>
    </dialog>
  )}
</DashboardLayout>

<style>
  .page-header   { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .page-title    { font-size: var(--text-xl); font-weight: 700; }

  .filters       { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .input         { border: var(--brutal-border-thin); background: var(--surface-raised); padding: 6px 10px; font-family: var(--font-sans); font-size: var(--text-sm); outline: none; }
  .input:focus   { box-shadow: var(--shadow-sm); }
  .input-sm      { padding: 4px 8px; font-size: var(--text-xs); }

  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-md); }

  .project-card  {
    display: flex; flex-direction: column; gap: 8px;
    border: var(--brutal-border-thin); background: var(--surface-raised);
    padding: var(--space-md); text-decoration: none; color: var(--text-primary);
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .project-card:hover { box-shadow: var(--shadow-md); transform: translate(-2px, -2px); }

  .project-card-header  { display: flex; flex-direction: column; gap: 6px; }
  .project-card-title   { font-size: var(--text-base); font-weight: 600; line-height: 1.3; }
  .project-card-badges  { display: flex; gap: 6px; flex-wrap: wrap; }
  .project-card-desc    { font-size: var(--text-sm); color: var(--text-secondary); line-height: 1.5; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .project-card-footer  { display: flex; gap: 12px; flex-wrap: wrap; margin-top: auto; }
  .project-card-meta    { font-size: var(--text-xs); color: var(--text-muted); }

  .badge         { font-size: 0.72rem; padding: 2px 7px; border: 1px solid; font-family: var(--font-mono); }
  .badge-ok      { color: var(--ok-fg);   background: var(--ok-bg);   border-color: var(--ok); }
  .badge-warn    { color: var(--warn-fg); background: var(--warn-bg); border-color: var(--warn); }
  .badge-info    { color: var(--info-fg); background: var(--info-bg); border-color: var(--info); }
  .badge-err     { color: var(--err-fg);  background: var(--err-bg);  border-color: var(--err); }
  .badge-neutral { color: var(--text-muted); background: var(--surface); border-color: var(--border-mid); }

  .empty-state   { font-size: var(--text-sm); color: var(--text-muted); padding: var(--space-md) 0; }

  /* Modal */
  .modal         { border: var(--brutal-border); background: var(--bg); padding: 0; max-width: 500px; width: 90%; }
  .modal::backdrop { background: rgba(0,0,0,.45); }
  .modal-box     { padding: var(--space-xl); }
  .modal-title   { font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-lg); }
  .form-stack    { display: flex; flex-direction: column; gap: var(--space-md); }
  .field         { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .field-row     { display: flex; gap: var(--space-md); }
  .label         { font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  textarea.input { resize: vertical; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 4px; }
</style>

<script>
  const btnNew   = document.getElementById('btn-new-project');
  const modal    = document.getElementById('modal-new-project') as HTMLDialogElement | null;
  const btnClose = document.getElementById('btn-close-modal');

  btnNew?.addEventListener('click',  () => modal?.showModal());
  btnClose?.addEventListener('click', () => modal?.close());

  // Soumission AJAX
  document.getElementById('form-new-project')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = Object.fromEntries(new FormData(form));

    const res = await fetch('/api/benevole/projects', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });

    if (res.ok) {
      const created = await res.json().catch(() => ({}));
      if (created?.id) {
        window.location.href = `/dashboard/benevole/project/${created.id}`;
      } else {
        window.location.reload();
      }
    } else {
      const err = await res.json().catch(() => ({}));
      alert('Erreur : ' + (err.error ?? 'Impossible de créer le projet.'));
    }
  });
</script>
