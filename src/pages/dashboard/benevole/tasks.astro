---
// src/pages/dashboard/benevole/tasks.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireBenevole } from '../../../lib/auth';

const result = await requireBenevole(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userId   = user.id;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Bénévole';

const statusFilter   = Astro.url.searchParams.get('status') ?? '';
const priorityFilter = Astro.url.searchParams.get('priority') ?? '';

let query = supabase
  .from('project_tasks')
  .select(`
    id, title, description, status, priority, deadline, position, created_by, assignee_id,
    project_id,
    projects(id, title),
    profiles!project_tasks_assignee_id_fkey(full_name, email)
  `)
  .eq('assignee_id', userId)
  .order('deadline', { ascending: true, nullsFirst: false })
  .order('priority');

if (statusFilter)   query = query.eq('status', statusFilter);
if (priorityFilter) query = query.eq('priority', priorityFilter);

const { data: tasksRaw } = await query;

interface ProjectRef { id: string; title: string; }
interface ProfileRef { full_name: string | null; email: string; }
interface Task {
  id: string; title: string; description: string | null;
  status: string; priority: string; deadline: string | null;
  project_id: string;
  projects: ProjectRef[] | ProjectRef | null;
  profiles: ProfileRef[] | ProfileRef | null;
}

const tasks = (tasksRaw ?? []) as unknown as Task[];

const statusLabel: Record<string, string> = {
  todo: 'À faire', in_progress: 'En cours', review: 'Révision', done: 'Terminé',
};
const statusClass: Record<string, string> = {
  todo: 'neutral', in_progress: 'info', review: 'warn', done: 'ok',
};
const priorityClass: Record<string, string> = { low: 'neutral', medium: 'info', high: 'err' };
const priorityLabel: Record<string, string> = { low: 'Faible', medium: 'Moyenne', high: 'Haute' };

// Groupe par statut pour affichage
const grouped: Record<string, Task[]> = { todo: [], in_progress: [], review: [], done: [] };
for (const t of tasks) {
  if (grouped[t.status]) grouped[t.status].push(t);
  else grouped['todo'].push(t);
}
---

<DashboardLayout title="Mes tâches" activePage="tasks" userName={userName} userEmail={user.email ?? ''} authResult={result}>
  <div class="page-header mb-6">
    <div>
      <h1 class="page-title">Mes tâches</h1>
      <p class="description">{tasks.length} tâche{tasks.length > 1 ? 's' : ''} assignée{tasks.length > 1 ? 's' : ''}</p>
    </div>
  </div>

  <!-- Filtres -->
  <form method="GET" class="filters mb-5">
    <select name="status" class="input input-sm" data-autosubmit="1">
      <option value="">Tous les statuts</option>
      <option value="todo"        selected={statusFilter === 'todo'}>À faire</option>
      <option value="in_progress" selected={statusFilter === 'in_progress'}>En cours</option>
      <option value="review"      selected={statusFilter === 'review'}>Révision</option>
      <option value="done"        selected={statusFilter === 'done'}>Terminé</option>
    </select>
    <select name="priority" class="input input-sm" data-autosubmit="1">
      <option value="">Toutes priorités</option>
      <option value="high"   selected={priorityFilter === 'high'}>Haute</option>
      <option value="medium" selected={priorityFilter === 'medium'}>Moyenne</option>
      <option value="low"    selected={priorityFilter === 'low'}>Faible</option>
    </select>
    {(statusFilter || priorityFilter) && (
      <a href="/dashboard/benevole/tasks" class="btn btn-ghost btn-sm">Réinitialiser</a>
    )}
  </form>

  {tasks.length === 0 ? (
    <div class="card">
      <p class="empty-state">Aucune tâche trouvée pour ces filtres.</p>
    </div>
  ) : (
    <div class="tasks-sections">
      {Object.entries(grouped).map(([status, group]) => {
        if (group.length === 0) return null;
        return (
          <section class="task-section">
            <h2 class={`section-title section-title--${statusClass[status] ?? 'neutral'}`}>
              {statusLabel[status]} <span class="section-count">{group.length}</span>
            </h2>
            <div class="task-table">
              <div class="task-table-head">
                <span>Tâche</span>
                <span>Projet</span>
                <span>Priorité</span>
                <span>Échéance</span>
                <span>Actions</span>
              </div>
              {group.map((t: Task) => {
                const deadlineStr = t.deadline ? new Date(t.deadline).toLocaleDateString('fr-FR') : '—';
                const isOverdue   = t.deadline && new Date(t.deadline) < new Date() && t.status !== 'done';
                return (
                  <div class="task-row">
                    <div class="task-row-title">
                      <span class={`dot dot--${statusClass[t.status] ?? 'neutral'}`}></span>
                      <span class="task-name">{t.title}</span>
                    </div>
                    <a href={`/dashboard/benevole/project/${t.project_id}`} class="task-project-link">
                      {(Array.isArray(t.projects) ? t.projects[0]?.title : (t.projects as ProjectRef | null)?.title) ?? '—'}
                    </a>
                    <span class={`badge badge-${priorityClass[t.priority] ?? 'neutral'}`}>{priorityLabel[t.priority]}</span>
                    <span class={`task-deadline-cell${isOverdue ? ' overdue' : ''}`}>{deadlineStr}</span>
                    <div class="task-row-actions">
                      <select
                        class="input input-xs status-select"
                        data-task-id={t.id}
                        value={t.status}
                      >
                        <option value="todo"        selected={t.status === 'todo'}>À faire</option>
                        <option value="in_progress" selected={t.status === 'in_progress'}>En cours</option>
                        <option value="review"      selected={t.status === 'review'}>Révision</option>
                        <option value="done"        selected={t.status === 'done'}>Terminé</option>
                      </select>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  )}
</DashboardLayout>

<style>
  .page-header     { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .page-title      { font-size: var(--text-xl); font-weight: 700; }
  .filters         { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .input           { border: var(--brutal-border-thin); background: var(--surface-raised); padding: 6px 10px; font-family: var(--font-sans); font-size: var(--text-sm); outline: none; }
  .input:focus     { box-shadow: var(--shadow-sm); }
  .input-sm        { padding: 4px 8px; font-size: var(--text-xs); }
  .input-xs        { padding: 2px 6px; font-size: 0.72rem; }

  .tasks-sections  { display: flex; flex-direction: column; gap: var(--space-xl); }

  .task-section    {}
  .section-title   { font-size: var(--text-base); font-weight: 700; margin-bottom: var(--space-sm); display: flex; align-items: center; gap: 8px; padding-bottom: 6px; border-bottom: 2px solid; }
  .section-title--ok      { border-color: var(--ok); color: var(--ok-fg); }
  .section-title--info    { border-color: var(--info); color: var(--info-fg); }
  .section-title--warn    { border-color: var(--warn); color: var(--warn-fg); }
  .section-title--neutral { border-color: var(--border-mid); color: var(--text-secondary); }
  .section-count   { font-size: var(--text-xs); font-weight: 400; background: var(--surface-raised); border: 1px solid var(--border-mid); border-radius: 99px; padding: 1px 8px; color: var(--text-muted); }

  .task-table      { display: flex; flex-direction: column; border: var(--brutal-border-thin); }
  .task-table-head { display: grid; grid-template-columns: 1fr 160px 90px 90px 120px; gap: 12px; padding: 6px 12px; background: var(--surface); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); border-bottom: 1px solid var(--border-mid); }
  .task-row        { display: grid; grid-template-columns: 1fr 160px 90px 90px 120px; gap: 12px; padding: 10px 12px; align-items: center; border-bottom: 1px solid var(--border-mid); }
  .task-row:last-child { border-bottom: none; }
  .task-row:hover  { background: var(--surface); }

  .task-row-title  { display: flex; align-items: center; gap: 8px; }
  .task-name       { font-size: var(--text-sm); font-weight: 500; }
  .task-project-link { font-size: var(--text-xs); color: var(--accent); text-decoration: none; }
  .task-project-link:hover { text-decoration: underline; }
  .task-deadline-cell { font-size: var(--text-xs); font-family: var(--font-mono); color: var(--text-muted); }
  .task-deadline-cell.overdue { color: var(--err); font-weight: 700; }
  .task-row-actions { display: flex; align-items: center; gap: 6px; }

  .dot             { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .dot--ok         { background: var(--ok); }
  .dot--warn       { background: var(--warn); }
  .dot--info       { background: var(--info); }
  .dot--neutral    { background: var(--text-muted); }

  .badge           { font-size: 0.72rem; padding: 2px 7px; border: 1px solid; font-family: var(--font-mono); }
  .badge-ok        { color: var(--ok-fg);   background: var(--ok-bg);   border-color: var(--ok); }
  .badge-warn      { color: var(--warn-fg); background: var(--warn-bg); border-color: var(--warn); }
  .badge-info      { color: var(--info-fg); background: var(--info-bg); border-color: var(--info); }
  .badge-err       { color: var(--err-fg);  background: var(--err-bg);  border-color: var(--err); }
  .badge-neutral   { color: var(--text-muted); background: var(--surface); border-color: var(--border-mid); }

  .empty-state     { font-size: var(--text-sm); color: var(--text-muted); padding: var(--space-md) 0; }

  @media (max-width: 700px) {
    .task-table-head { display: none; }
    .task-row        { grid-template-columns: 1fr; gap: 6px; }
  }
</style>

<script>
  // Mise à jour du statut via le select
  document.querySelectorAll('.status-select').forEach(el => {
    el.addEventListener('change', async () => {
      const sel    = el as HTMLSelectElement;
      const id     = sel.getAttribute('data-task-id');
      const status = sel.value;
      if (!id) return;

      const res = await fetch(`/api/benevole/tasks?id=${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        alert('Erreur lors de la mise à jour du statut.');
        window.location.reload(); // reset to real value
      }
    });
  });
</script>
