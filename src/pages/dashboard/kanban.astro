---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import KanbanBoard from '@/components/tasks/KanbanBoard.astro';
import Toast from '@/components/ui/Toast.astro';
import { requireAuth } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';
import type { TaskWithRelations } from '@/lib/types';
import '@/styles/task-hub.css';

const auth = await requireAuth(Astro);
if (auth instanceof Response) return auth;

const admin = createSupabaseAdminClient();
const { data, error } = await admin
  .from('tasks')
  .select('id, reference, title, description, corps, task_type, priority, status, assignee_id, reporter_id, sprint_id, story_points, time_estimate_hours, time_spent_hours, due_date, acceptance_criteria, deliverables, definition_of_done, dod_completed, tags, blocked_reason, parent_task_id, doc_link, figma_link, created_at, updated_at')
  .order('updated_at', { ascending: false })
  .limit(300);
if (error) console.warn('[dashboard/kanban] tasks query warning:', error.message);

const tasks = (data ?? []) as unknown as TaskWithRelations[];
const userName = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Utilisateur';
const openTasksCount = tasks.filter((task) => task.status !== 'done').length;
const blockedTasksCount = tasks.filter((task) => task.status === 'blocked').length;
---

<DashboardLayout title="Kanban" activePage="kanban" authResult={auth} userName={userName}>
  <section class="taskhub-shell">
    <div class="taskhub-header">
      <div>
        <h1 class="taskhub-title">Kanban multi-corps</h1>
        <p class="taskhub-subtitle">Glisser-déposer les cartes avec plus d'espace, une lecture plus calme et des colonnes mieux séparées.</p>
      </div>
    </div>

    <div class="taskhub-kanban-summary">
      <p class="taskhub-note" style="margin:0; flex:1 1 320px;">
        Faites défiler horizontalement pour parcourir les colonnes. Les cartes sont plus aérées pour mieux lire le titre, le corps métier et le statut en un coup d'oeil.
      </p>
      <div class="taskhub-kanban-meta">
        <span class="taskhub-kanban-pill">{tasks.length} tâches</span>
        <span class="taskhub-kanban-pill">{openTasksCount} ouvertes</span>
        <span class="taskhub-kanban-pill">{blockedTasksCount} bloquées</span>
      </div>
    </div>

    <KanbanBoard tasks={tasks} />
  </section>
  <Toast />
</DashboardLayout>
