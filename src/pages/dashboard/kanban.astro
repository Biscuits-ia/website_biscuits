---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import KanbanBoard from '@/components/tasks/KanbanBoard.astro';
import Toast from '@/components/ui/Toast.astro';
import { requireAuth } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';
import type { CorpsType, PriorityLevel, TaskStatus, TaskWithRelations } from '@/lib/types';
import '@/styles/task-hub.css';

const validCorps: CorpsType[]          = ['DEV', 'DB', 'DESIGN', 'QA', 'DATA', 'PM'];
const validPriorities: PriorityLevel[] = ['P0', 'P1', 'P2', 'P3'];
const validStatuses: TaskStatus[]      = ['backlog', 'todo', 'in_progress', 'in_review', 'testing', 'blocked', 'done'];

const auth = await requireAuth(Astro);
if (auth instanceof Response) return auth;

/* ── Paramètres URL ─────────────────────────────────────────── */
const rawSearch      = (Astro.url.searchParams.get('q') ?? '').trim();
const search         = rawSearch.replace(/[,%()[\]]/g, '');
const corpsFilter    = validCorps.includes(Astro.url.searchParams.get('corps') as CorpsType)
  ? (Astro.url.searchParams.get('corps') as CorpsType) : '';
const priorityFilter = validPriorities.includes(Astro.url.searchParams.get('priority') as PriorityLevel)
  ? (Astro.url.searchParams.get('priority') as PriorityLevel) : '';
const statusFilter   = validStatuses.includes(Astro.url.searchParams.get('status') as TaskStatus)
  ? (Astro.url.searchParams.get('status') as TaskStatus) : '';

/* Pagination colonne principale (non-todo) */
const page      = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1'));
const pageSize  = 21;
const rangeFrom = (page - 1) * pageSize;
const rangeTo   = rangeFrom + pageSize - 1;

const TODO_PAGE_SIZE = 10;

/* ── Supabase ───────────────────────────────────────────────── */
const admin       = createSupabaseAdminClient();
const TASK_SELECT = [
  'id', 'reference', 'title', 'description', 'corps', 'task_type',
  'priority', 'status', 'assignee_id', 'reporter_id', 'sprint_id',
  'story_points', 'time_estimate_hours', 'time_spent_hours', 'due_date',
  'acceptance_criteria', 'deliverables', 'definition_of_done',
  'dod_completed', 'tags', 'blocked_reason', 'parent_task_id',
  'doc_link', 'figma_link', 'created_at', 'updated_at',
].join(', ');

/* ── Requête principale (tous statuts sauf todo) ────────────── */
let tasksQuery = admin.from('tasks').select(TASK_SELECT).neq('status', 'todo');
let countQuery = admin.from('tasks').select('id', { count: 'exact', head: true }).neq('status', 'todo');

if (search)         { tasksQuery = tasksQuery.or(`title.ilike.%${search}%,reference.ilike.%${search}%`); countQuery = countQuery.or(`title.ilike.%${search}%,reference.ilike.%${search}%`); }
if (corpsFilter)    { tasksQuery = tasksQuery.eq('corps', corpsFilter);    countQuery = countQuery.eq('corps', corpsFilter); }
if (priorityFilter) { tasksQuery = tasksQuery.eq('priority', priorityFilter); countQuery = countQuery.eq('priority', priorityFilter); }
if (statusFilter && statusFilter !== 'todo') {
  tasksQuery = tasksQuery.eq('status', statusFilter);
  countQuery = countQuery.eq('status', statusFilter);
}

/* ── Colonnes todo : une par corps ─────────────────────────── */
// Si un filtre corps est actif, on n'affiche que ce corps
const targetCorps: CorpsType[] = corpsFilter ? [corpsFilter as CorpsType] : validCorps;

// Page actuelle par corps (lue depuis ?todo_page_DEV=2 etc.)
const corpsPagesMap: Record<string, number> = {};
for (const c of targetCorps) {
  corpsPagesMap[c] = Math.max(1, Number(Astro.url.searchParams.get(`todo_page_${c}`) ?? '1'));
}

// Requêtes parallèles : données + count pour chaque corps
const todoQueries = targetCorps.map((corps) => {
  const p    = corpsPagesMap[corps];
  const from = (p - 1) * TODO_PAGE_SIZE;
  const to   = from + TODO_PAGE_SIZE - 1;

  let q = admin.from('tasks').select(TASK_SELECT)
    .eq('status', 'todo')
    .eq('corps', corps);
  if (search)         q = q.or(`title.ilike.%${search}%,reference.ilike.%${search}%`);
  if (priorityFilter) q = q.eq('priority', priorityFilter);

  let cq = admin.from('tasks').select('id', { count: 'exact', head: true })
    .eq('status', 'todo')
    .eq('corps', corps);
  if (search)         cq = cq.or(`title.ilike.%${search}%,reference.ilike.%${search}%`);
  if (priorityFilter) cq = cq.eq('priority', priorityFilter);

  return Promise.all([
    q.order('priority', { ascending: true }).order('updated_at', { ascending: false }).range(from, to),
    cq,
  ]).then(([{ data }, { count }]) => ({
    corps,
    tasks:      (data ?? []) as unknown as TaskWithRelations[],
    total:      count ?? 0,
    page:       p,
    totalPages: Math.max(1, Math.ceil((count ?? 0) / TODO_PAGE_SIZE)),
  }));
});

/* ── Exécution parallèle globale ────────────────────────────── */
const [
  { data, error: mainError },
  { count: totalTasksCount },
  ...todoResults
] = await Promise.all([
  tasksQuery.order('updated_at', { ascending: false }).range(rangeFrom, rangeTo),
  countQuery,
  ...todoQueries,
]);

if (mainError) console.warn('[dashboard/kanban] main query warning:', mainError.message);

/* ── Dérivés ────────────────────────────────────────────────── */
const tasks          = (data ?? []) as unknown as TaskWithRelations[];
const mainTotal      = totalTasksCount ?? tasks.length;
const totalPages     = Math.max(1, Math.ceil(mainTotal / pageSize));
const todoGrandTotal = todoResults.reduce((acc, r) => acc + r.total, 0);
const openTasksCount = tasks.filter((t) => t.status !== 'done').length + todoGrandTotal;
const blockedCount   = tasks.filter((t) => t.status === 'blocked').length;
const isFiltered     = !!(search || corpsFilter || priorityFilter || statusFilter);
const hasSecondary   = !!(corpsFilter || priorityFilter || statusFilter);
const userName       = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Utilisateur';

/* ── Helpers pagination todo par corps ──────────────────────── */
const baseParams = new URLSearchParams();
if (search)         baseParams.set('q',        search);
if (corpsFilter)    baseParams.set('corps',    corpsFilter);
if (priorityFilter) baseParams.set('priority', priorityFilter);
if (statusFilter)   baseParams.set('status',   statusFilter);
if (page > 1)       baseParams.set('page',     String(page));

const todoPaginationByCorps = todoResults.map((r) => {
  const makeHref = (p: number) => {
    const params = new URLSearchParams(baseParams);
    for (const c of targetCorps) {
      const cp = corpsPagesMap[c];
      if (c === r.corps) { if (p > 1) params.set(`todo_page_${c}`, String(p)); }
      else               { if (cp > 1) params.set(`todo_page_${c}`, String(cp)); }
    }
    return `?${params.toString()}`;
  };
  return {
    corps:      r.corps,
    total:      r.total,
    tasks:      r.tasks,
    page:       r.page,
    totalPages: r.totalPages,
    prevHref:   r.page > 1            ? makeHref(r.page - 1) : null,
    nextHref:   r.page < r.totalPages ? makeHref(r.page + 1) : null,
  };
});

const activeFilterLabels: string[] = [];
if (corpsFilter)    activeFilterLabels.push(corpsFilter);
if (priorityFilter) activeFilterLabels.push(priorityFilter);
if (statusFilter)   activeFilterLabels.push(statusFilter);

const resetHref = '/dashboard/kanban';

const CORPS_COLORS: Record<string, string> = {
  DEV: '#264f98', DB: '#4f2e8a', DESIGN: '#9d4f0e',
  QA:  '#256d37', DATA: '#0d6d66', PM: '#8c2a2f',
};
---

<DashboardLayout title="Kanban" activePage="kanban" authResult={auth} userName={userName}>
  <section class="taskhub-shell">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <div class="taskhub-header">
      <div>
        <h1 class="taskhub-title">
          Kanban
          <span class="taskhub-title-stats">
            <span class="taskhub-title-pill">{mainTotal + todoGrandTotal} tâches</span>
            <span class="taskhub-title-pill">{openTasksCount} ouvertes</span>
            {blockedCount > 0 && (
              <span class="taskhub-title-pill taskhub-title-pill--blocked">{blockedCount} bloquées</span>
            )}
            {todoGrandTotal > 0 && (
              <span class="taskhub-title-pill">{todoGrandTotal} à faire</span>
            )}
            {isFiltered && (
              <span class="taskhub-title-pill taskhub-title-pill--filtered">
                Filtré{activeFilterLabels.length > 0 ? ` — ${activeFilterLabels.join(', ')}` : ''}
              </span>
            )}
          </span>
        </h1>
        <p class="taskhub-subtitle">
          Scroll horizontal · À faire groupé par corps · 10 tâches par groupe
        </p>
      </div>
    </div>

    <!-- ── Filtres ─────────────────────────────────────────────── -->
    <form class="taskhub-panel" method="get" id="kanban-filter-form">
      <div class="taskhub-filters-primary">
        <input
          name="q"
          type="search"
          class="taskhub-input"
          placeholder="Rechercher titre ou référence…"
          value={search}
          autocomplete="off"
        />
        <button
          type="button"
          class="taskhub-more-btn"
          id="kanban-more-filters-btn"
          aria-expanded={hasSecondary ? 'true' : 'false'}
          aria-controls="kanban-filters-secondary"
        >
          Filtres{hasSecondary ? ` (${activeFilterLabels.length})` : ''}
          <i class="taskhub-more-btn-arrow" aria-hidden="true">▾</i>
        </button>
        <div class="taskhub-filter-actions">
          <button type="submit" class="btn btn-primary">Filtrer</button>
          <a href={resetHref} class="btn btn-ghost">Réinitialiser</a>
        </div>
      </div>

      <div
        class="taskhub-filters-secondary"
        id="kanban-filters-secondary"
        hidden={!hasSecondary || undefined}
      >
        <div>
          <label class="taskhub-label" for="filter-corps">Corps</label>
          <select name="corps" id="filter-corps" class="taskhub-input">
            <option value="">Tous les corps</option>
            {validCorps.map((c) => <option value={c} selected={corpsFilter === c}>{c}</option>)}
          </select>
        </div>
        <div>
          <label class="taskhub-label" for="filter-priority">Priorité</label>
          <select name="priority" id="filter-priority" class="taskhub-input">
            <option value="">Toutes priorités</option>
            {validPriorities.map((p) => <option value={p} selected={priorityFilter === p}>{p}</option>)}
          </select>
        </div>
        <div>
          <label class="taskhub-label" for="filter-status">Statut</label>
          <select name="status" id="filter-status" class="taskhub-input">
            <option value="">Tous statuts</option>
            <option value="backlog"     selected={statusFilter === 'backlog'}>Carnet</option>
            <option value="todo"        selected={statusFilter === 'todo'}>À faire</option>
            <option value="in_progress" selected={statusFilter === 'in_progress'}>En cours</option>
            <option value="in_review"   selected={statusFilter === 'in_review'}>En revue</option>
            <option value="testing"     selected={statusFilter === 'testing'}>Tests</option>
            <option value="blocked"     selected={statusFilter === 'blocked'}>Bloquée</option>
            <option value="done"        selected={statusFilter === 'done'}>Terminée</option>
          </select>
        </div>
      </div>
    </form>

    <!-- ── Toolbar ─────────────────────────────────────────────── -->
    <div class="taskhub-toolbar">
      <!-- Résumé par corps avec badge coloré -->
      <div class="taskhub-board-meta">
        {totalPages > 1 && <span class="taskhub-board-pill">Page {page}/{totalPages}</span>}
        {todoPaginationByCorps.filter((g) => g.total > 0).map((g) => (
          <span
            class="taskhub-board-pill taskhub-board-pill--corps"
            style={`border-left: 3px solid ${CORPS_COLORS[g.corps] ?? 'var(--border-mid)'}`}
          >
            {g.corps} <strong>{g.total}</strong>
            {g.totalPages > 1 && <em> · {g.page}/{g.totalPages}</em>}
          </span>
        ))}
      </div>

      <div class="taskhub-density-controls" role="group" aria-label="Densité des cartes">
        <span class="taskhub-density-label">Densité</span>
        <button type="button" class="btn taskhub-density-btn" data-density="compact" aria-pressed="false">Compact</button>
        <button type="button" class="btn taskhub-density-btn is-active" data-density="normal" aria-pressed="true">Normal</button>
        <button type="button" class="btn taskhub-density-btn" data-density="expanded" aria-pressed="false">Étendu</button>
      </div>
    </div>

    <!-- ── Board kanban ────────────────────────────────────────── -->
    <!--
      On passe todoByCorps au KanbanBoard.
      Si ton KanbanBoard ne supporte pas encore cette prop,
      utilise le fallback en commentaire ci-dessous à la place.
    -->
    <KanbanBoard
      tasks={tasks}
      todoByCorps={todoPaginationByCorps}
      currentUserId={auth.user.id}
    />

    <!--
    ╔══════════════════════════════════════════════════════╗
    ║  FALLBACK — Rendu des colonnes todo directement ici  ║
    ║  À utiliser si KanbanBoard ne supporte pas todoByCorps ║
    ╚══════════════════════════════════════════════════════╝
    Décommenter ce bloc ET commenter le <KanbanBoard> ci-dessus.

    <div class="taskhub-board" id="kanban-board">
      { todoPaginationByCorps.map((group) => group.total > 0 && (
        <div class="taskhub-column" data-kanban-status="todo" data-corps={group.corps}>
          <div class="taskhub-column-header">
            <span
              class="taskhub-column-title"
              style={`color:${CORPS_COLORS[group.corps] ?? 'var(--text-muted)'}`}
            >
              À faire · {group.corps}
            </span>
            <span class="taskhub-column-count">{group.total}</span>
          </div>

          <div class="taskhub-dropzone" data-status="todo" data-corps={group.corps}>
            { group.tasks.length === 0
              ? <p class="taskhub-todo-empty">Aucune tâche.</p>
              : group.tasks.map((task, i) => (
                  <div
                    class="taskhub-card taskhub-card-animate"
                    style={`--stagger:${i}`}
                    draggable="true"
                    data-task-id={task.id}
                    data-task-status="todo"
                    data-task-corps={task.corps}
                  >
                    <div class="taskhub-ref">{task.reference}</div>
                    <div class="taskhub-card-title">{task.title}</div>
                    {task.description && (
                      <div class="taskhub-card-desc">{task.description}</div>
                    )}
                    <div class="taskhub-chip-row">
                      <span class="chip corps-badge" data-corps={task.corps}>{task.corps}</span>
                      <span class="chip taskhub-badge-priority">{task.priority}</span>
                    </div>
                  </div>
                ))
            }
          </div>

          { group.totalPages > 1 && (
            <div class="taskhub-col-pag">
              <a
                href={group.prevHref ?? '#'}
                class={`taskhub-col-pag-btn${!group.prevHref ? ' is-disabled' : ''}`}
                aria-disabled={!group.prevHref}
                aria-label={`Page précédente — ${group.corps}`}
              >‹</a>
              <span class="taskhub-col-pag-info">{group.page} / {group.totalPages}</span>
              <a
                href={group.nextHref ?? '#'}
                class={`taskhub-col-pag-btn${!group.nextHref ? ' is-disabled' : ''}`}
                aria-disabled={!group.nextHref}
                aria-label={`Page suivante — ${group.corps}`}
              >›</a>
            </div>
          )}
        </div>
      ))}
    </div>
    -->

  </section>
  <Toast />
</DashboardLayout>

<script>
  /* ── Toggle filtres secondaires ─────────────────────────── */
  const moreBtn   = document.getElementById('kanban-more-filters-btn');
  const secondary = document.getElementById('kanban-filters-secondary');

  moreBtn?.addEventListener('click', () => {
    const isOpen = moreBtn.getAttribute('aria-expanded') === 'true';
    moreBtn.setAttribute('aria-expanded', String(!isOpen));
    if (isOpen) {
      secondary?.setAttribute('hidden', '');
    } else {
      secondary?.removeAttribute('hidden');
      secondary?.querySelector('select')?.focus();
    }
  });

  /* ── Densité des cartes ──────────────────────────────────── */
  const board       = document.querySelector('.taskhub-board') as HTMLElement | null;
  const densityBtns = document.querySelectorAll<HTMLButtonElement>('[data-density]');

  const applyDensity = (density: string) => {
    if (board) board.dataset.density = density;
    densityBtns.forEach((b) => {
      const active = b.dataset.density === density;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    try { sessionStorage.setItem('kanban-density', density); } catch {}
  };

  densityBtns.forEach((btn) => {
    btn.addEventListener('click', () => applyDensity(btn.dataset.density ?? 'normal'));
  });

  try {
    const saved = sessionStorage.getItem('kanban-density');
    if (saved) applyDensity(saved);
  } catch {}

  /* ── Navigation clavier ← → sur le board ────────────────── */
  board?.setAttribute('tabindex', '0');
  board?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') board.scrollBy({ left: 288, behavior: 'smooth' });
    if (e.key === 'ArrowLeft')  board.scrollBy({ left: -288, behavior: 'smooth' });
  });
</script>