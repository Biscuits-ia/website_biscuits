---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import KanbanBoard from '@/components/tasks/KanbanBoard.astro';
import Toast from '@/components/ui/Toast.astro';
import { requireAuth } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';
import type { CorpsType, PriorityLevel, TaskStatus, TaskWithRelations } from '@/lib/types';
import '@/styles/task-hub.css';

const validCorps: CorpsType[] = ['DEV', 'DB', 'DESIGN', 'QA', 'DATA', 'PM'];
const validPriorities: PriorityLevel[] = ['P0', 'P1', 'P2', 'P3'];
const validStatuses: TaskStatus[] = ['backlog', 'todo', 'in_progress', 'in_review', 'testing', 'blocked', 'done'];

const auth = await requireAuth(Astro);
if (auth instanceof Response) return auth;

const rawSearch = (Astro.url.searchParams.get('q') ?? '').trim();
const search = rawSearch.replace(/[,%()[\]]/g, '');
const corpsFilter = validCorps.includes(Astro.url.searchParams.get('corps') as CorpsType)
  ? (Astro.url.searchParams.get('corps') as CorpsType)
  : '';
const priorityFilter = validPriorities.includes(Astro.url.searchParams.get('priority') as PriorityLevel)
  ? (Astro.url.searchParams.get('priority') as PriorityLevel)
  : '';
const statusFilter = validStatuses.includes(Astro.url.searchParams.get('status') as TaskStatus)
  ? (Astro.url.searchParams.get('status') as TaskStatus)
  : '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1'));
const pageSize = 21;
const rangeFrom = (page - 1) * pageSize;
const rangeTo = rangeFrom + pageSize - 1;

const todoPage = Math.max(1, Number(Astro.url.searchParams.get('todo_page') ?? '1'));
const todoPageSize = 4;
const todoRangeFrom = (todoPage - 1) * todoPageSize;
const todoRangeTo = todoRangeFrom + todoPageSize - 1;

const admin = createSupabaseAdminClient();
const TASK_SELECT = 'id, reference, title, description, corps, task_type, priority, status, assignee_id, reporter_id, sprint_id, story_points, time_estimate_hours, time_spent_hours, due_date, acceptance_criteria, deliverables, definition_of_done, dod_completed, tags, blocked_reason, parent_task_id, doc_link, figma_link, created_at, updated_at';
let tasksQuery = admin.from('tasks').select(TASK_SELECT).neq('status', 'todo');
let countQuery = admin.from('tasks').select('id', { count: 'exact', head: true }).neq('status', 'todo');
let todoQuery = admin.from('tasks').select(TASK_SELECT).eq('status', 'todo');
let todoCountQuery = admin.from('tasks').select('id', { count: 'exact', head: true }).eq('status', 'todo');

if (search) {
  const searchExpr = `title.ilike.%${search}%,reference.ilike.%${search}%`;
  tasksQuery = tasksQuery.or(searchExpr);
  countQuery = countQuery.or(searchExpr);
  todoQuery = todoQuery.or(searchExpr);
  todoCountQuery = todoCountQuery.or(searchExpr);
}

if (corpsFilter) {
  tasksQuery = tasksQuery.eq('corps', corpsFilter);
  countQuery = countQuery.eq('corps', corpsFilter);
  todoQuery = todoQuery.eq('corps', corpsFilter);
  todoCountQuery = todoCountQuery.eq('corps', corpsFilter);
}

if (priorityFilter) {
  tasksQuery = tasksQuery.eq('priority', priorityFilter);
  countQuery = countQuery.eq('priority', priorityFilter);
  todoQuery = todoQuery.eq('priority', priorityFilter);
  todoCountQuery = todoCountQuery.eq('priority', priorityFilter);
}

if (statusFilter && statusFilter !== 'todo') {
  tasksQuery = tasksQuery.eq('status', statusFilter);
  countQuery = countQuery.eq('status', statusFilter);
}

const [{ data, error }, { count: totalTasksCount }, { data: todoData }, { count: todoCount }] = await Promise.all([
  tasksQuery.order('updated_at', { ascending: false }).range(rangeFrom, rangeTo),
  countQuery,
  todoQuery.order('updated_at', { ascending: false }).range(todoRangeFrom, todoRangeTo),
  todoCountQuery,
]);
if (error) console.warn('[dashboard/kanban] tasks query warning:', error.message);

const tasks = (data ?? []) as unknown as TaskWithRelations[];
const todoTasks = (todoData ?? []) as unknown as TaskWithRelations[];
const mainTotal = totalTasksCount ?? tasks.length;
const todoTotal = todoCount ?? 0;
const totalTasks = mainTotal + todoTotal;
const totalPages = Math.max(1, Math.ceil(mainTotal / pageSize));
const todoTotalPages = Math.max(1, Math.ceil(todoTotal / todoPageSize));
const userName = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Utilisateur';
const openTasksCount = [...tasks, ...todoTasks].filter((task) => task.status !== 'done').length;
const blockedTasksCount = [...tasks, ...todoTasks].filter((task) => task.status === 'blocked').length;
const queryParams = new URLSearchParams();
if (search) queryParams.set('q', search);
if (corpsFilter) queryParams.set('corps', corpsFilter);
if (priorityFilter) queryParams.set('priority', priorityFilter);
if (statusFilter) queryParams.set('status', statusFilter);

const hrefWithTodoPage = (p: number) => {
  const params = new URLSearchParams(queryParams);
  if (page > 1) params.set('page', String(page));
  params.set('todo_page', String(p));
  return `?${params.toString()}`;
};

const todoPrevHref = todoPage > 1 ? hrefWithTodoPage(todoPage - 1) : null;
const todoNextHref = todoPage < todoTotalPages ? hrefWithTodoPage(todoPage + 1) : null;
const resetHref = '/dashboard/kanban';
---

<DashboardLayout title="Kanban" activePage="kanban" authResult={auth} userName={userName}>
  <section class="taskhub-shell">
    <div class="taskhub-header">
      <div>
        <h1 class="taskhub-title">Kanban multi-corps</h1>
        <p class="taskhub-subtitle">Glisser-déposer les cartes avec plus d'espace, une lecture plus calme et des colonnes mieux séparées.</p>
      </div>
    </div>

    <form class="taskhub-panel" method="get">
      <div class="taskhub-filters">
        <input name="q" type="search" class="taskhub-input" placeholder="Rechercher titre/référence" value={search} />
        <select name="corps" class="taskhub-input">
          <option value="">Tous corps</option>
          {validCorps.map((corps) => <option value={corps} selected={corpsFilter === corps}>{corps}</option>)}
        </select>
        <select name="priority" class="taskhub-input">
          <option value="">Toutes priorités</option>
          {validPriorities.map((priority) => <option value={priority} selected={priorityFilter === priority}>{priority}</option>)}
        </select>
        <select name="status" class="taskhub-input">
          <option value="">Tous statuts</option>
          <option value="backlog" selected={statusFilter === 'backlog'}>Carnet</option>
          <option value="todo" selected={statusFilter === 'todo'}>À faire</option>
          <option value="in_progress" selected={statusFilter === 'in_progress'}>En cours</option>
          <option value="in_review" selected={statusFilter === 'in_review'}>En revue</option>
          <option value="testing" selected={statusFilter === 'testing'}>Tests</option>
          <option value="blocked" selected={statusFilter === 'blocked'}>Bloquée</option>
          <option value="done" selected={statusFilter === 'done'}>Terminée</option>
        </select>
        <div class="taskhub-filter-actions">
          <button type="submit" class="btn btn-primary">Filtrer</button>
          <a href={resetHref} class="btn btn-ghost">Réinitialiser</a>
        </div>
      </div>
    </form>

    <div class="taskhub-kanban-summary">
      <div class="taskhub-kanban-meta">
        <span class="taskhub-kanban-pill">{totalTasks} tâches</span>
        <span class="taskhub-kanban-pill">{openTasksCount} ouvertes</span>
        <span class="taskhub-kanban-pill">{blockedTasksCount} bloquées</span>
        <span class="taskhub-kanban-pill">Page {page} / {totalPages}</span>
        {(search || corpsFilter || priorityFilter || statusFilter) && <span class="taskhub-kanban-pill">Vue filtrée</span>}
      </div>
    </div>

    <KanbanBoard tasks={tasks} todoTasks={todoTasks} todoPrevHref={todoPrevHref} todoNextHref={todoNextHref} todoPage={todoPage} todoTotalPages={todoTotalPages} currentUserId={auth.user.id} />

  </section>
  <Toast />
</DashboardLayout>
