---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireDataAnalyst } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';
import type { CorpsType, PriorityLevel, TaskStatus, TaskTypeEnum } from '@/lib/types';
import '@/styles/task-hub.css';

interface AnalyticsOverviewRow {
  corps: CorpsType;
  task_total: number;
  open_tasks: number;
  done_tasks: number;
  blocked_tasks: number;
  critical_open_tasks: number;
  overdue_tasks: number;
  avg_estimate_hours: number;
  avg_spent_hours: number;
  completion_rate: number;
  last_task_update_at: string | null;
}

interface AnalyticsLatestKpiRow {
  corps: CorpsType;
  metric_name: string;
  metric_value: number;
  target_value: number | null;
  recorded_at: string;
  attainment_pct: number | null;
}

interface AnalyticsDailyActivityRow {
  day: string;
  corps: CorpsType | null;
  created_count: number;
  completed_count: number;
  snapshot_count: number;
}

interface TaskStateRow {
  corps: CorpsType;
  status: TaskStatus;
  priority: PriorityLevel;
  task_type: TaskTypeEnum;
  created_at: string;
  updated_at: string;
  due_date: string | null;
  time_estimate_hours: number | null;
  time_spent_hours: number | null;
}

interface SnapshotRow {
  corps: CorpsType;
  metric_name: string;
  metric_value: number;
  target_value: number | null;
  recorded_at: string;
}

const validCorps: CorpsType[] = ['DEV', 'DB', 'DESIGN', 'QA', 'DATA', 'PM'];
const validWindows = [7, 30, 90] as const;

const auth = await requireDataAnalyst(Astro);
if (auth instanceof Response) return auth;

const corpsFilter = validCorps.includes(Astro.url.searchParams.get('corps') as CorpsType)
  ? (Astro.url.searchParams.get('corps') as CorpsType)
  : '';
const rawWindow = Number(Astro.url.searchParams.get('days') ?? '30');
const windowDays = validWindows.includes(rawWindow as (typeof validWindows)[number]) ? rawWindow as (typeof validWindows)[number] : 30;

const sinceDate = new Date();
sinceDate.setHours(0, 0, 0, 0);
sinceDate.setDate(sinceDate.getDate() - (windowDays - 1));
const sinceDay = sinceDate.toISOString().slice(0, 10);
const sinceIso = `${sinceDay}T00:00:00.000Z`;

const admin = createSupabaseAdminClient();

let overviewQuery = admin.from('analytics_task_overview').select('*').order('corps');
let latestKpisQuery = admin.from('analytics_kpi_latest').select('*').order('corps').order('metric_name');
let activityQuery = admin.from('analytics_daily_activity').select('day, corps, created_count, completed_count, snapshot_count').gte('day', sinceDay).order('day', { ascending: true });
let tasksQuery = admin.from('tasks').select('corps, status, priority, task_type, created_at, updated_at, due_date, time_estimate_hours, time_spent_hours');
let snapshotsQuery = admin.from('kpi_snapshots').select('corps, metric_name, metric_value, target_value, recorded_at').gte('recorded_at', sinceIso).order('recorded_at', { ascending: false });

if (corpsFilter) {
  overviewQuery = overviewQuery.eq('corps', corpsFilter);
  latestKpisQuery = latestKpisQuery.eq('corps', corpsFilter);
  activityQuery = activityQuery.eq('corps', corpsFilter);
  tasksQuery = tasksQuery.eq('corps', corpsFilter);
  snapshotsQuery = snapshotsQuery.eq('corps', corpsFilter);
} else {
  activityQuery = activityQuery.is('corps', null);
}

const [overviewRes, latestKpisRes, activityRes, tasksRes, snapshotsRes] = await Promise.all([
  overviewQuery,
  latestKpisQuery,
  activityQuery,
  tasksQuery,
  snapshotsQuery,
]);

if (overviewRes.error) console.warn('[dashboard/kpis] overview warning:', overviewRes.error.message);
if (latestKpisRes.error) console.warn('[dashboard/kpis] latest kpis warning:', latestKpisRes.error.message);
if (activityRes.error) console.warn('[dashboard/kpis] activity warning:', activityRes.error.message);
if (tasksRes.error) console.warn('[dashboard/kpis] tasks warning:', tasksRes.error.message);
if (snapshotsRes.error) console.warn('[dashboard/kpis] snapshots warning:', snapshotsRes.error.message);

const overviewRows = (overviewRes.data ?? []) as AnalyticsOverviewRow[];
const latestKpiRows = (latestKpisRes.data ?? []) as AnalyticsLatestKpiRow[];
const activityRows = (activityRes.data ?? []) as AnalyticsDailyActivityRow[];
const taskRows = (tasksRes.data ?? []) as TaskStateRow[];
const snapshotRows = (snapshotsRes.data ?? []) as SnapshotRow[];

const sum = (values: number[]) => values.reduce((acc, value) => acc + value, 0);
const totalTasks = sum(overviewRows.map((row) => row.task_total));
const openTasks = sum(overviewRows.map((row) => row.open_tasks));
const doneTasks = sum(overviewRows.map((row) => row.done_tasks));
const blockedTasks = sum(overviewRows.map((row) => row.blocked_tasks));
const criticalOpenTasks = sum(overviewRows.map((row) => row.critical_open_tasks));
const overdueTasks = sum(overviewRows.map((row) => row.overdue_tasks));
const totalEstimateHours = sum(taskRows.map((row) => row.time_estimate_hours ?? 0));
const totalSpentHours = sum(taskRows.map((row) => row.time_spent_hours ?? 0));
const completionRate = totalTasks ? Number(((doneTasks / totalTasks) * 100).toFixed(1)) : 0;
const blockedRate = openTasks ? Number(((blockedTasks / openTasks) * 100).toFixed(1)) : 0;
const effortDelta = totalEstimateHours ? Number((((totalSpentHours - totalEstimateHours) / totalEstimateHours) * 100).toFixed(1)) : 0;
const healthyKpis = latestKpiRows.filter((row) => row.attainment_pct === null || row.attainment_pct >= 100).length;
const kpiCoverage = corpsFilter
  ? (snapshotRows.length > 0 ? 100 : 0)
  : Number(((new Set(snapshotRows.map((row) => row.corps)).size / validCorps.length) * 100).toFixed(1));
const lastSnapshotAt = latestKpiRows[0]?.recorded_at ?? null;
const freshnessHours = lastSnapshotAt
  ? Number((((Date.now() - new Date(lastSnapshotAt).getTime()) / 36e5)).toFixed(1))
  : null;

const dataQualityScore = Math.max(0, Math.min(100,
  Math.round(
    (freshnessHours === null ? 0 : freshnessHours <= 24 ? 35 : freshnessHours <= 72 ? 22 : 10)
    + Math.min(35, Math.round(kpiCoverage * 0.35))
    + Math.max(0, 30 - Math.round(blockedRate))
  )
));

const statusCounts = taskRows.reduce<Record<TaskStatus, number>>((acc, row) => {
  acc[row.status] = (acc[row.status] ?? 0) + 1;
  return acc;
}, {
  backlog: 0,
  todo: 0,
  in_progress: 0,
  in_review: 0,
  testing: 0,
  blocked: 0,
  done: 0,
});

const recentTaskRows = taskRows.filter((row) => new Date(row.updated_at).getTime() >= new Date(sinceIso).getTime());
const taskTypeCounts = recentTaskRows.reduce<Record<string, number>>((acc, row) => {
  acc[row.task_type] = (acc[row.task_type] ?? 0) + 1;
  return acc;
}, {});

const topTaskTypes = Object.entries(taskTypeCounts)
  .sort((left, right) => right[1] - left[1])
  .slice(0, 5);

const underTargetKpis = latestKpiRows
  .filter((row) => row.attainment_pct !== null && row.attainment_pct < 100)
  .sort((left, right) => (left.attainment_pct ?? 0) - (right.attainment_pct ?? 0));

const corpsInsights = [...overviewRows].sort((left, right) => {
  if (right.blocked_tasks !== left.blocked_tasks) return right.blocked_tasks - left.blocked_tasks;
  return left.completion_rate - right.completion_rate;
});

const activitySeries = activityRows.map((row) => ({
  label: new Date(row.day).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' }),
  created: row.created_count,
  completed: row.completed_count,
  snapshots: row.snapshot_count,
}));

const sparkMax = Math.max(1, ...activitySeries.flatMap((row) => [row.created, row.completed, row.snapshots]));
const buildSparkPath = (values: number[]) => {
  if (values.length === 0) return '';
  const width = 100;
  const height = 34;
  const xStep = values.length === 1 ? 0 : width / (values.length - 1);
  return values.map((value, index) => {
    const x = Number((index * xStep).toFixed(2));
    const y = Number((height - ((value / sparkMax) * height)).toFixed(2));
    return `${index === 0 ? 'M' : 'L'} ${x} ${y}`;
  }).join(' ');
};

const createdSpark = buildSparkPath(activitySeries.map((row) => row.created));
const completedSpark = buildSparkPath(activitySeries.map((row) => row.completed));
const snapshotsSpark = buildSparkPath(activitySeries.map((row) => row.snapshots));

const statusLabels: Record<TaskStatus, string> = {
  backlog: 'Carnet',
  todo: 'À faire',
  in_progress: 'En cours',
  in_review: 'En revue',
  testing: 'Tests',
  blocked: 'Bloquées',
  done: 'Terminées',
};

const queryParams = new URLSearchParams();
if (corpsFilter) queryParams.set('corps', corpsFilter);
queryParams.set('days', String(windowDays));
const hrefFor = (patch: Record<string, string>) => {
  const params = new URLSearchParams(queryParams);
  Object.entries(patch).forEach(([key, value]) => {
    if (value) params.set(key, value);
    else params.delete(key);
  });
  return `/dashboard/kpis?${params.toString()}`;
};

const exportBase = new URLSearchParams(queryParams);
const exportHref = (scope: 'overview' | 'kpis' | 'activity') => {
  const params = new URLSearchParams(exportBase);
  params.set('scope', scope);
  return `/api/admin/analytics-export?${params.toString()}`;
};

const blockedTasksHref = `/dashboard/tasks?${new URLSearchParams({ ...(corpsFilter ? { corps: corpsFilter } : {}), status: 'blocked' }).toString()}`;
const criticalTasksHref = `/dashboard/tasks?${new URLSearchParams({ ...(corpsFilter ? { corps: corpsFilter } : {}), priority: 'P0' }).toString()}`;
const unassignedDataHref = `/dashboard/tasks?${new URLSearchParams({ corps: corpsFilter || 'DATA', assignment: 'unassigned' }).toString()}`;

const alerts = [
  overdueTasks > 0 ? { tone: 'danger', label: 'Retards', value: `${overdueTasks} tâche${overdueTasks > 1 ? 's' : ''} hors délai` } : null,
  blockedTasks > 0 ? { tone: 'warn', label: 'Blocages', value: `${blockedTasks} carte${blockedTasks > 1 ? 's' : ''} bloquée${blockedTasks > 1 ? 's' : ''}` } : null,
  freshnessHours !== null && freshnessHours > 72 ? { tone: 'warn', label: 'Fraîcheur', value: `Dernier snapshot il y a ${freshnessHours} h` } : null,
  latestKpiRows.length === 0 ? { tone: 'danger', label: 'Couverture KPI', value: 'Aucune mesure KPI dans la fenêtre active' } : null,
].filter(Boolean) as Array<{ tone: 'danger' | 'warn'; label: string; value: string }>;

const userName = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Utilisateur';
---

<DashboardLayout title="Analytics" activePage="kpis" authResult={auth} userName={userName}>
  <section class="taskhub-shell analytics-shell">
    <div class="taskhub-header analytics-header">
      <div>
        <p class="analytics-kicker">Data analyse</p>
        <h1 class="taskhub-title">Cockpit d'analyse opérationnelle</h1>
        <p class="taskhub-subtitle">Conçu pour lire les signaux, repérer les dérives et sortir rapidement une synthèse exploitable par l'équipe DATA ou le pilotage.</p>
      </div>
      <div class="analytics-actions">
        <a href={exportHref('overview')} class="btn btn-ghost">Exporter synthèse</a>
        <a href={exportHref('kpis')} class="btn btn-ghost">Exporter KPI</a>
        <a href={exportHref('activity')} class="btn btn-primary">Exporter activité</a>
      </div>
    </div>

    <form class="taskhub-panel analytics-toolbar" method="get">
      <div class="taskhub-filters">
        <select name="corps" class="taskhub-input">
          <option value="">Tous corps</option>
          {validCorps.map((corps) => <option value={corps} selected={corpsFilter === corps}>{corps}</option>)}
        </select>
        <select name="days" class="taskhub-input">
          {validWindows.map((days) => <option value={days} selected={windowDays === days}>Fenêtre {days} jours</option>)}
        </select>
        <div class="taskhub-filter-actions">
          <button type="submit" class="btn btn-primary">Actualiser</button>
          <a href="/dashboard/kpis" class="btn btn-ghost">Réinitialiser</a>
        </div>
      </div>
      <div class="analytics-quick-links">
        <a href={blockedTasksHref} class="analytics-tool-link">Voir les blocages</a>
        <a href={criticalTasksHref} class="analytics-tool-link">Voir les priorités P0</a>
        <a href={unassignedDataHref} class="analytics-tool-link">Repérer les tâches DATA non attribuées</a>
      </div>
    </form>

    <div class="taskhub-kpi-grid analytics-kpi-grid">
      <article class="taskhub-kpi-card analytics-kpi-card analytics-kpi-card--dark">
        <p class="taskhub-kpi-label">Score qualité</p>
        <p class="taskhub-kpi-value">{dataQualityScore}<span class="analytics-kpi-suffix">/100</span></p>
        <p class="analytics-kpi-meta">Fraîcheur, couverture KPI et tension opérationnelle.</p>
      </article>
      <article class="taskhub-kpi-card analytics-kpi-card">
        <p class="taskhub-kpi-label">Taux de complétion</p>
        <p class="taskhub-kpi-value taskhub-kpi-value-accent">{completionRate}%</p>
        <p class="analytics-kpi-meta">{doneTasks} terminées sur {totalTasks} tâches.</p>
      </article>
      <article class="taskhub-kpi-card analytics-kpi-card">
        <p class="taskhub-kpi-label">KPI sous cible</p>
        <p class="taskhub-kpi-value taskhub-kpi-value-danger">{underTargetKpis.length}</p>
        <p class="analytics-kpi-meta">{healthyKpis} KPI au vert dans la lecture instantanée.</p>
      </article>
      <article class="taskhub-kpi-card analytics-kpi-card">
        <p class="taskhub-kpi-label">Fraîcheur données</p>
        <p class="taskhub-kpi-value">{freshnessHours === null ? 'n/a' : `${freshnessHours} h`}</p>
        <p class="analytics-kpi-meta">Couverture active {kpiCoverage}% sur la fenêtre de {windowDays} jours.</p>
      </article>
    </div>

    <div class="analytics-layout analytics-layout--primary">
      <section class="taskhub-panel analytics-panel analytics-panel--trend">
        <div class="analytics-panel-head">
          <div>
            <h2 class="card-title">Tendance d'activité</h2>
            <p class="taskhub-note">Création, complétion et production KPI sur {windowDays} jours.</p>
          </div>
          <div class="analytics-legend">
            <span><i class="analytics-dot analytics-dot--created"></i>Créées</span>
            <span><i class="analytics-dot analytics-dot--completed"></i>Terminées</span>
            <span><i class="analytics-dot analytics-dot--snapshots"></i>Snapshots KPI</span>
          </div>
        </div>

        {activitySeries.length > 0 ? (
          <Fragment>
            <svg class="analytics-sparkline" viewBox="0 0 100 34" preserveAspectRatio="none" aria-label="Courbe d'activité">
              <path d={createdSpark} class="analytics-line analytics-line--created"></path>
              <path d={completedSpark} class="analytics-line analytics-line--completed"></path>
              <path d={snapshotsSpark} class="analytics-line analytics-line--snapshots"></path>
            </svg>
            <div class="analytics-activity-grid">
              {activitySeries.slice(-10).reverse().map((row) => (
                <div class="analytics-activity-row">
                  <span class="analytics-activity-date">{row.label}</span>
                  <div class="analytics-activity-bars">
                    <span class="analytics-mini-bar analytics-mini-bar--created" style={`width:${(row.created / sparkMax) * 100}%`}></span>
                    <span class="analytics-mini-bar analytics-mini-bar--completed" style={`width:${(row.completed / sparkMax) * 100}%`}></span>
                    <span class="analytics-mini-bar analytics-mini-bar--snapshots" style={`width:${(row.snapshots / sparkMax) * 100}%`}></span>
                  </div>
                  <span class="analytics-activity-values">{row.created}/{row.completed}/{row.snapshots}</span>
                </div>
              ))}
            </div>
          </Fragment>
        ) : <p class="taskhub-note">Aucune activité observée sur la fenêtre active.</p>}
      </section>

      <section class="taskhub-panel analytics-panel">
        <div class="analytics-panel-head">
          <div>
            <h2 class="card-title">Outils de base</h2>
            <p class="taskhub-note">Les raccourcis utiles pour passer de la lecture à l'action.</p>
          </div>
        </div>
        <div class="analytics-tools-grid">
          <a href={exportHref('overview')} class="analytics-tool-card">
            <strong>CSV synthèse</strong>
            <span>Vue corps, charge, blocages et complétion.</span>
          </a>
          <a href={exportHref('kpis')} class="analytics-tool-card">
            <strong>CSV KPI latest</strong>
            <span>Dernière mesure, cible et taux d'atteinte.</span>
          </a>
          <a href={blockedTasksHref} class="analytics-tool-card">
            <strong>Drill-down blocages</strong>
            <span>Basculer vers le Task Hub sur les cartes bloquées.</span>
          </a>
          <a href={criticalTasksHref} class="analytics-tool-card">
            <strong>Drill-down critique</strong>
            <span>Priorités P0 à inspecter sans délai.</span>
          </a>
        </div>
        <div class="analytics-alerts">
          <h3 class="analytics-subtitle">Alertes</h3>
          {alerts.length > 0 ? alerts.map((alert) => (
            <div class={`analytics-alert analytics-alert--${alert.tone}`}>
              <strong>{alert.label}</strong>
              <span>{alert.value}</span>
            </div>
          )) : <p class="taskhub-note">Aucune alerte majeure détectée dans la fenêtre active.</p>}
        </div>
      </section>
    </div>

    <div class="analytics-layout analytics-layout--secondary">
      <section class="taskhub-panel analytics-panel">
        <div class="analytics-panel-head">
          <div>
            <h2 class="card-title">Distribution des statuts</h2>
            <p class="taskhub-note">Mesure instantanée du flux et des congestions.</p>
          </div>
        </div>
        <div class="analytics-stack-list">
          {Object.entries(statusCounts).map(([status, count]) => (
            <div class="analytics-stack-row">
              <span>{statusLabels[status as TaskStatus]}</span>
              <div class="analytics-stack-bar-wrap">
                <span class="analytics-stack-bar" style={`width:${totalTasks ? (count / totalTasks) * 100 : 0}%`}></span>
              </div>
              <strong>{count}</strong>
            </div>
          ))}
        </div>
      </section>

      <section class="taskhub-panel analytics-panel">
        <div class="analytics-panel-head">
          <div>
            <h2 class="card-title">KPI sous cible</h2>
            <p class="taskhub-note">Lecture priorisée des métriques en dessous du seuil métier.</p>
          </div>
        </div>
        <div class="analytics-kpi-list">
          {underTargetKpis.slice(0, 8).map((row) => (
            <div class="analytics-kpi-row">
              <div>
                <strong>{row.metric_name}</strong>
                <p>{row.corps} · valeur {row.metric_value}{row.target_value !== null ? ` / cible ${row.target_value}` : ''}</p>
              </div>
              <div class="analytics-progress-wrap">
                <span class="analytics-progress" style={`width:${Math.max(8, Math.min(100, row.attainment_pct ?? 0))}%`}></span>
              </div>
              <strong>{row.attainment_pct?.toFixed(1) ?? 'n/a'}%</strong>
            </div>
          ))}
          {underTargetKpis.length === 0 && <p class="taskhub-note">Toutes les métriques avec cible sont au niveau attendu.</p>}
        </div>
      </section>
    </div>

    <div class="analytics-layout analytics-layout--secondary">
      <section class="taskhub-panel analytics-panel">
        <div class="analytics-panel-head">
          <div>
            <h2 class="card-title">Lecture par corps</h2>
            <p class="taskhub-note">Les zones qui cumulent faible complétion et blocages remontent en tête.</p>
          </div>
        </div>
        <div class="analytics-corps-grid">
          {corpsInsights.map((row) => (
            <a href={hrefFor({ corps: row.corps })} class="analytics-corps-card">
              <div class="analytics-corps-card-top">
                <strong>{row.corps}</strong>
                <span>{row.task_total} tâches</span>
              </div>
              <div class="analytics-corps-card-metrics">
                <span>{row.completion_rate}% complétées</span>
                <span>{row.blocked_tasks} bloquées</span>
                <span>{row.overdue_tasks} en retard</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="taskhub-panel analytics-panel">
        <div class="analytics-panel-head">
          <div>
            <h2 class="card-title">Mix récent des travaux</h2>
            <p class="taskhub-note">Types de tâches les plus présents parmi les éléments mis à jour dans la fenêtre active.</p>
          </div>
        </div>
        <div class="analytics-stack-list">
          {topTaskTypes.map(([taskType, count]) => (
            <div class="analytics-stack-row">
              <span>{taskType}</span>
              <div class="analytics-stack-bar-wrap">
                <span class="analytics-stack-bar analytics-stack-bar--muted" style={`width:${recentTaskRows.length ? (count / recentTaskRows.length) * 100 : 0}%`}></span>
              </div>
              <strong>{count}</strong>
            </div>
          ))}
          {topTaskTypes.length === 0 && <p class="taskhub-note">Aucune mise à jour récente sur la fenêtre sélectionnée.</p>}
        </div>
      </section>
    </div>

    <div class="analytics-footer-grid">
      <article class="taskhub-panel analytics-panel">
        <h2 class="card-title">Lecture de charge</h2>
        <div class="analytics-summary-pairs">
          <div><span>Ouvertes</span><strong>{openTasks}</strong></div>
          <div><span>Bloquées</span><strong>{blockedRate}% des ouvertes</strong></div>
          <div><span>Critiques</span><strong>{criticalOpenTasks}</strong></div>
          <div><span>Effort estimé</span><strong>{totalEstimateHours.toFixed(1)} h</strong></div>
          <div><span>Effort consommé</span><strong>{totalSpentHours.toFixed(1)} h</strong></div>
          <div><span>Dérive effort</span><strong class={effortDelta > 0 ? 'analytics-text-danger' : ''}>{effortDelta}%</strong></div>
        </div>
      </article>
      <article class="taskhub-panel analytics-panel">
        <h2 class="card-title">Contexte de lecture</h2>
        <div class="analytics-summary-pairs">
          <div><span>Fenêtre</span><strong>{windowDays} jours</strong></div>
          <div><span>Périmètre</span><strong>{corpsFilter || 'Tous corps'}</strong></div>
          <div><span>Snapshots récents</span><strong>{snapshotRows.length}</strong></div>
          <div><span>Dernière mesure</span><strong>{lastSnapshotAt ? new Date(lastSnapshotAt).toLocaleString('fr-FR') : 'n/a'}</strong></div>
          <div><span>Retards</span><strong>{overdueTasks}</strong></div>
          <div><span>Drill-down</span><strong>Task Hub prêt</strong></div>
        </div>
      </article>
    </div>
  </section>
</DashboardLayout>

<style>
  .analytics-shell {
    gap: 1rem;
  }

  .analytics-header {
    align-items: flex-start;
    gap: 1rem;
  }

  .analytics-kicker {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .analytics-actions {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .analytics-toolbar {
    display: grid;
    gap: 0.85rem;
  }

  .analytics-quick-links {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .analytics-tool-link {
    font-family: var(--font-mono);
