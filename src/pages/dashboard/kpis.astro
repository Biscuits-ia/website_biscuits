---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAuth } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';
import '@/styles/task-hub.css';

interface KpiRow {
  corps: string;
  metric_name: string;
  metric_value: number;
  target_value: number | null;
  recorded_at: string;
}

interface TaskRow {
  corps: string;
  status: string;
  priority: 'P0' | 'P1' | 'P2' | 'P3';
}

const auth = await requireAuth(Astro as any);
if (auth instanceof Response) return auth;

const admin = createSupabaseAdminClient();
const [{ data: snapshots }, { data: tasks }] = await Promise.all([
  admin.from('kpi_snapshots').select('corps, metric_name, metric_value, target_value, recorded_at').order('recorded_at', { ascending: false }).limit(100),
  admin.from('tasks').select('corps, status, priority').limit(500),
]);

const taskRows = (tasks ?? []) as TaskRow[];
const snapshotRows = (snapshots ?? []) as KpiRow[];

const tasksByStatus = taskRows.reduce<Record<string, number>>((acc, t) => {
  const k = t.status || 'unknown';
  acc[k] = (acc[k] ?? 0) + 1;
  return acc;
}, {});

const criticalOpen = taskRows.filter((t) => (t.priority === 'P0' || t.priority === 'P1') && t.status !== 'done').length;
const userName = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Utilisateur';
---

<DashboardLayout title="KPIs" activePage="kpis" authResult={auth} userName={userName}>
  <section class="taskhub-shell">
    <div>
      <h1 class="taskhub-title">Tableau KPI</h1>
      <p class="taskhub-subtitle">Indicateurs sprint et charge opérationnelle en un coup d'oeil.</p>
    </div>

    <div class="taskhub-kpi-grid">
      <article class="taskhub-kpi-card">
        <p class="taskhub-kpi-label">Tâches ouvertes critiques</p>
        <p class="taskhub-kpi-value taskhub-kpi-value-danger">{criticalOpen}</p>
      </article>
      <article class="taskhub-kpi-card">
        <p class="taskhub-kpi-label">Total tâches</p>
        <p class="taskhub-kpi-value">{taskRows.length}</p>
      </article>
      <article class="taskhub-kpi-card">
        <p class="taskhub-kpi-label">Snapshots KPI</p>
        <p class="taskhub-kpi-value taskhub-kpi-value-accent">{snapshotRows.length}</p>
      </article>
    </div>

    <div class="taskhub-layout-2">
      <section class="taskhub-panel">
        <h2 class="card-title">Répartition statuts</h2>
        <ul class="taskhub-list">
          {Object.entries(tasksByStatus).map(([status, count]) => (
            <li class="taskhub-list-item"><span>{status}</span> <strong style="float:right">{count}</strong></li>
          ))}
        </ul>
      </section>

      <section class="taskhub-panel">
        <h2 class="card-title">Dernières mesures</h2>
        <ul class="taskhub-list">
          {snapshotRows.slice(0, 10).map((s) => (
            <li class="taskhub-list-item">
              <strong>{s.corps}</strong> · {s.metric_name} : {s.metric_value}
              {s.target_value !== null && <span class="text-slate-500"> / cible {s.target_value}</span>}
            </li>
          ))}
          {snapshotRows.length === 0 && <li class="taskhub-note">Aucune mesure disponible.</li>}
        </ul>
      </section>
    </div>
  </section>
</DashboardLayout>
