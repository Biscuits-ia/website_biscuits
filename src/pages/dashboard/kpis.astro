---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { requireAuth } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';

interface KpiRow {
  corps: string;
  metric_name: string;
  metric_value: number;
  target_value: number | null;
  recorded_at: string;
}

interface TaskRow {
  corps: string;
  status: string;
  priority: 'P0' | 'P1' | 'P2' | 'P3';
}

const auth = await requireAuth(Astro as any);
if (auth instanceof Response) return auth;

const admin = createSupabaseAdminClient();
const [{ data: snapshots }, { data: tasks }] = await Promise.all([
  admin.from('kpi_snapshots').select('corps, metric_name, metric_value, target_value, recorded_at').order('recorded_at', { ascending: false }).limit(100),
  admin.from('tasks').select('corps, status, priority').limit(500),
]);

const taskRows = (tasks ?? []) as TaskRow[];
const snapshotRows = (snapshots ?? []) as KpiRow[];

const tasksByStatus = taskRows.reduce<Record<string, number>>((acc, t) => {
  const k = t.status || 'unknown';
  acc[k] = (acc[k] ?? 0) + 1;
  return acc;
}, {});

const criticalOpen = taskRows.filter((t) => (t.priority === 'P0' || t.priority === 'P1') && t.status !== 'done').length;
const userName = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Utilisateur';
---

<DashboardLayout title="KPIs" activePage="overview" authResult={auth} userName={userName}>
  <section class="space-y-4">
    <h1 class="text-xl font-bold text-slate-900">Tableau KPI</h1>

    <div class="grid gap-3 md:grid-cols-3">
      <article class="rounded border border-slate-300 bg-white p-4">
        <p class="text-xs uppercase text-slate-500">Tâches ouvertes critiques</p>
        <p class="mt-1 text-3xl font-bold text-red-700">{criticalOpen}</p>
      </article>
      <article class="rounded border border-slate-300 bg-white p-4">
        <p class="text-xs uppercase text-slate-500">Total tâches</p>
        <p class="mt-1 text-3xl font-bold text-slate-900">{taskRows.length}</p>
      </article>
      <article class="rounded border border-slate-300 bg-white p-4">
        <p class="text-xs uppercase text-slate-500">Snapshots KPI</p>
        <p class="mt-1 text-3xl font-bold text-indigo-700">{snapshotRows.length}</p>
      </article>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <section class="rounded border border-slate-300 bg-white p-4">
        <h2 class="mb-2 text-sm font-semibold">Répartition statuts</h2>
        <ul class="space-y-1 text-sm">
          {Object.entries(tasksByStatus).map(([status, count]) => (
            <li class="flex justify-between"><span>{status}</span><strong>{count}</strong></li>
          ))}
        </ul>
      </section>

      <section class="rounded border border-slate-300 bg-white p-4">
        <h2 class="mb-2 text-sm font-semibold">Dernières mesures</h2>
        <ul class="space-y-2 text-sm">
          {snapshotRows.slice(0, 10).map((s) => (
            <li class="rounded bg-slate-50 p-2">
              <strong>{s.corps}</strong> · {s.metric_name} : {s.metric_value}
              {s.target_value !== null && <span class="text-slate-500"> / cible {s.target_value}</span>}
            </li>
          ))}
          {snapshotRows.length === 0 && <li class="text-slate-500">Aucune mesure disponible.</li>}
        </ul>
      </section>
    </div>
  </section>
</DashboardLayout>
