---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import TaskStatusBadge from '@/components/tasks/TaskStatusBadge.astro';
import TaskPriorityBadge from '@/components/tasks/TaskPriorityBadge.astro';
import CorpsTag from '@/components/corps/CorpsTag.astro';
import Button from '@/components/ui/Button.astro';
import Toast from '@/components/ui/Toast.astro';
import { requireAuth } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';
import type { TaskWithRelations } from '@/lib/types';

const auth = await requireAuth(Astro as any);
if (auth instanceof Response) return auth;

const taskId = Astro.params.id ?? '';
if (!taskId) return Astro.redirect('/dashboard/tasks');

const admin = createSupabaseAdminClient();
const [{ data: taskRaw, error }, { data: comments }, { data: history }] = await Promise.all([
  admin.from('tasks').select('*').eq('id', taskId).single(),
  admin.from('task_comments').select('id, content, created_at, author_id').eq('task_id', taskId).order('created_at', { ascending: false }).limit(50),
  admin.from('task_history').select('id, field_name, old_value, new_value, changed_at').eq('task_id', taskId).order('changed_at', { ascending: false }).limit(50),
]);

if (error || !taskRaw) return Astro.redirect('/dashboard/tasks');

const task = taskRaw as unknown as TaskWithRelations;
const userName = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Utilisateur';
---

<DashboardLayout title={`Tâche ${task.reference}`} activePage="tasks" authResult={auth} userName={userName}>
  <section class="space-y-4">
    <a href="/dashboard/tasks" class="text-sm text-blue-700 hover:underline">← Retour aux tâches</a>

    <article class="rounded border border-slate-300 bg-white p-4">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <CorpsTag corps={task.corps} />
        <TaskStatusBadge status={task.status} />
        <TaskPriorityBadge priority={task.priority} />
        <span class="text-xs font-semibold text-slate-500">{task.reference}</span>
      </div>
      <h1 class="text-xl font-bold text-slate-900">{task.title}</h1>
      <p class="mt-2 whitespace-pre-wrap text-sm text-slate-700">{task.description || 'Aucune description'}</p>

      <form id="task-update-form" class="mt-4 grid gap-3 rounded bg-slate-50 p-3 md:grid-cols-4">
        <input type="hidden" name="id" value={task.id} />
        <select name="status" class="rounded border border-slate-300 px-3 py-2 text-sm">
          {['backlog','todo','in_progress','in_review','testing','blocked','done'].map((s) => (
            <option value={s} selected={task.status === s}>{s}</option>
          ))}
        </select>
        <select name="priority" class="rounded border border-slate-300 px-3 py-2 text-sm">
          {['P0','P1','P2','P3'].map((p) => (
            <option value={p} selected={task.priority === p}>{p}</option>
          ))}
        </select>
        <input type="number" name="time_spent_hours" min="0" step="0.5" value={task.time_spent_hours ?? 0} class="rounded border border-slate-300 px-3 py-2 text-sm" />
        <Button type="submit" variant="primary">Mettre à jour</Button>
      </form>
    </article>

    <div class="grid gap-4 lg:grid-cols-2">
      <section class="rounded border border-slate-300 bg-white p-4">
        <h2 class="mb-2 text-sm font-semibold">Commentaires</h2>
        <ul class="space-y-2">
          {(comments ?? []).map((c) => <li class="rounded bg-slate-50 p-2 text-sm">{c.content}</li>)}
          {(!comments || comments.length === 0) && <li class="text-sm text-slate-500">Aucun commentaire.</li>}
        </ul>
      </section>

      <section class="rounded border border-slate-300 bg-white p-4">
        <h2 class="mb-2 text-sm font-semibold">Historique</h2>
        <ul class="space-y-2">
          {(history ?? []).map((h) => (
            <li class="rounded bg-slate-50 p-2 text-xs text-slate-700">
              <strong>{h.field_name}</strong> : {h.old_value || '∅'} → {h.new_value || '∅'}
            </li>
          ))}
          {(!history || history.length === 0) && <li class="text-sm text-slate-500">Aucun historique.</li>}
        </ul>
      </section>
    </div>
  </section>
  <Toast />
</DashboardLayout>

<script is:inline>
  document.getElementById('task-update-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const fd = new FormData(form);

    const payload = {
      id: fd.get('id'),
      status: fd.get('status'),
      priority: fd.get('priority'),
      time_spent_hours: fd.get('time_spent_hours') ? Number(fd.get('time_spent_hours')) : null,
    };

    const res = await fetch('/api/tasks/update', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    const json = await res.json().catch(() => ({}));
    if (!res.ok) {
      window.showToast?.(json.error || 'Erreur de mise à jour', 'error');
      return;
    }

    window.showToast?.('Tâche mise à jour', 'success');
    setTimeout(() => window.location.reload(), 350);
  });
</script>
