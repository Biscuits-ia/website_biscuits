---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import TaskStatusBadge from '@/components/tasks/TaskStatusBadge.astro';
import TaskPriorityBadge from '@/components/tasks/TaskPriorityBadge.astro';
import CorpsTag from '@/components/corps/CorpsTag.astro';
import Button from '@/components/ui/Button.astro';
import Toast from '@/components/ui/Toast.astro';
import { requireAuth } from '@/lib/auth';
import { createSupabaseAdminClient } from '@/lib/supabase';
import type { TaskWithRelations } from '@/lib/types';

const auth = await requireAuth(Astro as any);
if (auth instanceof Response) return auth;

const taskId = Astro.params.id ?? '';
if (!taskId) return Astro.redirect('/dashboard/tasks');

const admin = createSupabaseAdminClient();
const [{ data: taskRaw, error }, { data: comments }, { data: history }] = await Promise.all([
  admin.from('tasks').select('*').eq('id', taskId).single(),
  admin.from('task_comments').select('id, content, created_at, author_id').eq('task_id', taskId).order('created_at', { ascending: false }).limit(50),
  admin.from('task_history').select('id, field_name, old_value, new_value, changed_at').eq('task_id', taskId).order('changed_at', { ascending: false }).limit(50),
]);

if (error || !taskRaw) return Astro.redirect('/dashboard/tasks');

const task = taskRaw as unknown as TaskWithRelations;
const userName = auth.user.user_metadata?.full_name ?? auth.user.email?.split('@')[0] ?? 'Utilisateur';
const canDelete = auth.role === 'admin';
---

<DashboardLayout title={`Tâche ${task.reference}`} activePage="tasks" authResult={auth} userName={userName}>
  <section class="space-y-4">
    <a href="/dashboard/tasks" class="text-sm text-blue-700 hover:underline">← Retour aux tâches</a>

    <article class="rounded border border-slate-300 bg-white p-4">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <CorpsTag corps={task.corps} />
        <TaskStatusBadge status={task.status} />
        <TaskPriorityBadge priority={task.priority} />
        <span class="text-xs font-semibold text-slate-500">{task.reference}</span>
      </div>
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h1 id="task-title" class="text-xl font-bold text-slate-900">{task.title}</h1>
        {canDelete && <button id="task-delete-btn" type="button" class="rounded border border-red-700 bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-700">Supprimer</button>}
      </div>
      <p id="task-description" class="mt-2 whitespace-pre-wrap text-sm text-slate-700">{task.description || 'Aucune description'}</p>

      <form id="task-update-form" class="mt-4 grid gap-3 rounded bg-slate-50 p-3 md:grid-cols-4">
        <input type="hidden" name="id" value={task.id} />
        <select name="status" class="rounded border border-slate-300 px-3 py-2 text-sm">
          {['backlog','todo','in_progress','in_review','testing','blocked','done'].map((s) => (
            <option value={s} selected={task.status === s}>{s}</option>
          ))}
        </select>
        <select name="priority" class="rounded border border-slate-300 px-3 py-2 text-sm">
          {['P0','P1','P2','P3'].map((p) => (
            <option value={p} selected={task.priority === p}>{p}</option>
          ))}
        </select>
        <input type="number" name="time_spent_hours" min="0" step="0.5" value={task.time_spent_hours ?? 0} class="rounded border border-slate-300 px-3 py-2 text-sm" />
        <Button type="submit" variant="primary">Mettre à jour</Button>
      </form>

      <div class="mt-3 flex justify-end">
        <button id="task-refresh-btn" type="button" class="rounded border border-slate-400 bg-white px-3 py-2 text-sm font-medium text-slate-800 hover:bg-slate-100">Rafraîchir</button>
      </div>
    </article>

    <div class="grid gap-4 lg:grid-cols-2">
      <section class="rounded border border-slate-300 bg-white p-4">
        <h2 class="mb-2 text-sm font-semibold">Commentaires</h2>
        <form id="task-comment-form" class="mb-3 space-y-2">
          <textarea id="task-comment-content" rows="3" maxlength="1500" class="w-full rounded border border-slate-300 px-3 py-2 text-sm" placeholder="Ajouter un commentaire..."></textarea>
          <div class="flex justify-end">
            <button type="submit" class="rounded border border-blue-700 bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700">Publier</button>
          </div>
        </form>
        <ul id="task-comments" class="space-y-2">
          {(comments ?? []).map((c) => <li class="rounded bg-slate-50 p-2 text-sm">{c.content}</li>)}
          {(!comments || comments.length === 0) && <li class="text-sm text-slate-500">Aucun commentaire.</li>}
        </ul>
      </section>

      <section class="rounded border border-slate-300 bg-white p-4">
        <h2 class="mb-2 text-sm font-semibold">Historique</h2>
        <ul id="task-history" class="space-y-2">
          {(history ?? []).map((h) => (
            <li class="rounded bg-slate-50 p-2 text-xs text-slate-700">
              <strong>{h.field_name}</strong> : {h.old_value || '∅'} → {h.new_value || '∅'}
            </li>
          ))}
          {(!history || history.length === 0) && <li class="text-sm text-slate-500">Aucun historique.</li>}
        </ul>
      </section>
    </div>
  </section>
  <Toast />
</DashboardLayout>

<script define:vars={{ taskId }} is:inline>
  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  async function refreshTaskFromApi() {
    const res = await fetch(`/api/tasks/${taskId}`);
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json?.task) {
      window.showToast?.(json.error || 'Impossible de recharger la tâche.', 'error');
      return;
    }

    const titleEl = document.getElementById('task-title');
    const descEl = document.getElementById('task-description');
    if (titleEl) titleEl.textContent = json.task.title || 'Sans titre';
    if (descEl) descEl.textContent = json.task.description || 'Aucune description';

    const commentsEl = document.getElementById('task-comments');
    if (commentsEl) {
      const comments = Array.isArray(json.comments) ? json.comments : [];
      commentsEl.innerHTML = comments.length
        ? comments
            .map((c) => `<li class=\"rounded bg-slate-50 p-2 text-sm\">${escapeHtml(c.content || '')}</li>`)
            .join('')
        : '<li class="text-sm text-slate-500">Aucun commentaire.</li>';
    }

    const historyEl = document.getElementById('task-history');
    if (historyEl) {
      const rows = Array.isArray(json.history) ? json.history : [];
      historyEl.innerHTML = rows.length
        ? rows
            .map((h) => `<li class=\"rounded bg-slate-50 p-2 text-xs text-slate-700\"><strong>${escapeHtml(h.field_name || '')}</strong> : ${escapeHtml(h.old_value || '∅')} → ${escapeHtml(h.new_value || '∅')}</li>`)
            .join('')
        : '<li class="text-sm text-slate-500">Aucun historique.</li>';
    }
  }

  document.getElementById('task-update-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const fd = new FormData(form);

    const payload = {
      id: fd.get('id'),
      status: fd.get('status'),
      priority: fd.get('priority'),
      time_spent_hours: fd.get('time_spent_hours') ? Number(fd.get('time_spent_hours')) : null,
    };

    const res = await fetch('/api/tasks/update', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    const json = await res.json().catch(() => ({}));
    if (!res.ok) {
      window.showToast?.(json.error || 'Erreur de mise à jour', 'error');
      return;
    }

    window.showToast?.('Tâche mise à jour', 'success');
    await refreshTaskFromApi();
  });

  document.getElementById('task-refresh-btn')?.addEventListener('click', async () => {
    await refreshTaskFromApi();
    window.showToast?.('Données rafraîchies', 'success');
  });

  document.getElementById('task-comment-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const textarea = document.getElementById('task-comment-content');
    if (!(textarea instanceof HTMLTextAreaElement)) return;
    const content = textarea.value.trim();
    if (!content) {
      window.showToast?.('Le commentaire est vide.', 'error');
      return;
    }

    const res = await fetch(`/api/tasks/${taskId}/comments`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content }),
    });

    const json = await res.json().catch(() => ({}));
    if (!res.ok) {
      window.showToast?.(json.error || 'Erreur lors de la publication.', 'error');
      return;
    }

    textarea.value = '';
    window.showToast?.('Commentaire ajouté', 'success');
    await refreshTaskFromApi();
  });

  document.getElementById('task-delete-btn')?.addEventListener('click', async () => {
    const ok = window.confirm('Supprimer définitivement cette tâche ?');
    if (!ok) return;

    const res = await fetch(`/api/tasks/${taskId}`, { method: 'DELETE' });
    const json = await res.json().catch(() => ({}));
    if (!res.ok) {
      window.showToast?.(json.error || 'Erreur de suppression', 'error');
      return;
    }

    window.showToast?.('Tâche supprimée', 'success');
    setTimeout(() => {
      window.location.href = '/dashboard/tasks';
    }, 350);
  });
</script>
