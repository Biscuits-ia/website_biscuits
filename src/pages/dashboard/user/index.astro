---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAuth } from '../../../lib/auth';

const result = await requireAuth(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userId    = user.id;
const userEmail = user.email ?? '';
const userName  = user.user_metadata?.full_name ?? userEmail.split('@')[0];

// ── Statistiques personnelles ─────────────────────────────────────
const [
  { count: totalDemandes },
  { count: totalAteliers },
  { count: totalAppointments },
  { data: recentDemandesRaw },
] = await Promise.all([
  supabase.from('requests').select('*', { count: 'exact', head: true }).eq('user_id', userId),
  supabase.from('workshop_registrations').select('*', { count: 'exact', head: true }).eq('user_id', userId),
  supabase.from('volunteer_appointments').select('*', { count: 'exact', head: true }).eq('user_id', userId),
  supabase.from('requests').select('subject, status, created_at').eq('user_id', userId).order('created_at', { ascending: false }).limit(5),
]);

// Pré-calcul pour éviter les TypeScript generics dans le template
const statusDotClass: Record<string, string> = {
  pending:     'warn',
  in_progress: 'info',
  resolved:    'ok',
};

interface DemandeRow {
  subject:    string;
  status:     string;
  created_at: string;
  dateLabel:  string;
  dotClass:   string;
}

const recentDemandes: DemandeRow[] = (recentDemandesRaw ?? []).map((d: any): DemandeRow => ({
  subject:    d.subject,
  status:     d.status,
  created_at: d.created_at,
  dateLabel:  new Date(d.created_at).toLocaleDateString('fr-FR'),
  dotClass:   statusDotClass[d.status] ?? 'warn',
}));
---

<DashboardLayout title="Vue d'ensemble" role="user" activePage="overview" userName={userName} userEmail={userEmail} authResult={result}>
  <!-- Bienvenue -->
  <div class="mb-7">
    <h1 class="text-lg font-normal tracking-tight text-primary">
      Bonjour, {userName.split(' ')[0]} 👋
    </h1>
    <p class="description">
      Voici un aperçu de votre activité sur Biscuits IA.
    </p>
  </div>

  <!-- Stats cards -->
  <div class="stats-grid mb-6">
    <div class="stat-card">
      <div class="stat-label">Mes demandes</div>
      <div class="stat-value">{totalDemandes ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Ateliers inscrits</div>
      <div class="stat-value">{totalAteliers ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Rendez-vous</div>
      <div class="stat-value">{totalAppointments ?? 0}</div>
    </div>
  </div>

  <!-- Activité récente -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">Dernières demandes</span>
      <a href="/dashboard/user/demandes" class="btn btn-ghost text-xs px-2.5 py-1.5">
        Tout voir →
      </a>
    </div>

    {recentDemandes.length > 0 ? (
      <div class="timeline">
        {recentDemandes.map((item) => (
          <div class="timeline-item">
            <div class={`timeline-dot ${item.dotClass}`} />
            <div class="timeline-body">
              <div class="timeline-event">{item.subject}</div>
              <div class="timeline-meta">{item.dateLabel}</div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-muted text-xl py-4">
        Aucune demande pour le moment.
      </p>
    )}
  </div>

</DashboardLayout>