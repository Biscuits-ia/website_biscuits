---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAuth } from '../../../lib/auth';

const result = await requireAuth(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userId    = user.id;
const userEmail = user.email ?? '';
const userName  = user.user_metadata?.full_name ?? userEmail.split('@')[0];

// ── Statistiques personnelles ─────────────────────────────────────
const [
  { count: totalReports },
  { count: analyzedReports },
  { count: pendingReports },
  { data: recentActivity },
  { data: monthlyStats },
] = await Promise.all([
  supabase.from('reports').select('*', { count: 'exact', head: true }).eq('user_id', userId),
  supabase.from('reports').select('*', { count: 'exact', head: true }).eq('user_id', userId).eq('status', 'analyzed'),
  supabase.from('reports').select('*', { count: 'exact', head: true }).eq('user_id', userId).eq('status', 'pending'),
  supabase.from('activity_logs').select('event, created_at, metadata').eq('user_id', userId).order('created_at', { ascending: false }).limit(10),
  supabase.from('reports').select('created_at').eq('user_id', userId).gte('created_at', new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString()),
]);

const successRate = totalReports ? Math.round(((analyzedReports ?? 0) / (totalReports ?? 1)) * 100) : 0;
const thisMonth = monthlyStats?.length ?? 0;
---

<DashboardLayout title="Vue d'ensemble" role="user" activePage="overview" userName={userName} userEmail={userEmail}>
  <!-- Bienvenue -->
  <div class="mb-7">
    <h1 class="text-lg font-normal tracking-tight text-primary">
      Bonjour, {userName.split(' ')[0]} 👋
    </h1>
    <p class="description">
      Voici un aperçu de votre activité sur Biscuits IA.
    </p>
  </div>

  <!-- Stats cards -->
  <div class="stats-grid mb-6">
    <div class="stat-card">
      <div class="stat-label">Vos demandes</div>
      <div class="stat-value">{totalReports ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Ressource Disponible</div>
      <div class="stat-value">{analyzedReports ?? 0}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Ateliers disponibles</div>
      <div class="stat-value">{pendingReports ?? 0}</div>
      </div>
    </div>
  </div>

  <!-- Activité récente -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">Activité récente</span>
      <a href="/dashboard/user/activity" class="btn btn-ghost text-xs px-2.5 py-1.5">
        Tout voir →
      </a>
    </div>

    {recentActivity && recentActivity.length > 0 ? (
      <div class="timeline">
        {recentActivity.map((item: any) => {
          const date = new Date(item.created_at);
          const evtType = item.event?.toLowerCase() ?? '';
          const dotClass = evtType.includes('error') ? 'err'
            : evtType.includes('analyz') ? 'ok'
            : evtType.includes('submit') ? 'info'
            : 'warn';
          return (
            <div class="timeline-item">
              <div class={`timeline-dot ${dotClass}`} />
              <div class="timeline-body">
                <div class="timeline-event">{item.event}</div>
                <div class="timeline-meta">
                  {date.toLocaleDateString('fr-FR')} à {date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}
                  {item.metadata?.ip ? ` · ${item.metadata.ip}` : ''}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="text-muted text-xl py-4">
        Aucune
      </p>
    )}
  </div>

</DashboardLayout>