---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAuth, deleteUserFromSupabase, stopBeingBenevole } from '../../../lib/auth';
import { Astro } from 'astro';

let actionMessage = '';
const authResult = await requireAuth(Astro);
if (authResult instanceof Response) {
  return authResult;
}
const { user, role } = authResult;
const isBenevole = role === 'benevole';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (formData.get('action') === 'stop-benevole') {
    await stopBeingBenevole(user.id);
    actionMessage = 'Vous n’êtes plus bénévole.';
  } else if (formData.get('action') === 'delete-account') {
    await deleteUserFromSupabase(user.id);
    actionMessage = 'Votre compte a été supprimé.';
  }
}
---
<DashboardLayout title="Paramètres du compte">
  <h1>Paramètres du compte</h1>
  {actionMessage && <p style="color: green">{actionMessage}</p>}
  <section>
    <h2>Actions sur le compte</h2>
    <form method="POST">
      {isBenevole ? (
        <button type="submit" name="action" value="stop-benevole">
          Arrêter d’être bénévole
        </button>
      ) : (
        <button type="submit" name="action" value="delete-account" style="color: red">
          Supprimer mon compte
        </button>
      )}
    </form>
  </section>
</DashboardLayout>
