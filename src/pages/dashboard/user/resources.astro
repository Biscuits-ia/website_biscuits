---
// src/pages/dashboard/user/resources.astro
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAuth }  from '../../../lib/auth';
import type { Resource } from '../../../types/resources';
import {
  formatFileSize,
  fileIcon,
  fileTypeLabel,
  RESOURCE_CATEGORIES,
} from '../../../types/resources';

const result = await requireAuth(Astro);
if (result instanceof Response) return result;

const { user, supabase } = result;
const userName = user.user_metadata?.full_name ?? user.email?.split('@')[0] ?? 'Utilisateur';

// Filtre par catégorie
const filterCat = Astro.url.searchParams.get('category') ?? '';

let query = supabase
  .from('resources')
  .select('id, title, description, category, file_name, file_size, file_type, downloads, created_at')
  .eq('is_published', true)
  .order('created_at', { ascending: false });

if (filterCat) query = query.eq('category', filterCat);

const { data: resourcesRaw } = await query;
const resources = (resourcesRaw ?? []) as Resource[];

// ── Groupement par catégorie ──────────────────────────────────────────────────

interface ResourceRow {
  r:         Resource;
  icon:      string;
  typeLabel: string;
  sizeLabel: string;
  href:      string;         // lien de téléchargement via API
}

interface CategoryGroup {
  category: string;
  rows:     ResourceRow[];
}

// Construit les rows
const allRows: ResourceRow[] = resources.map((r: Resource): ResourceRow => ({
  r,
  icon:      fileIcon(r.file_type),
  typeLabel: fileTypeLabel(r.file_type),
  sizeLabel: formatFileSize(r.file_size),
  href:      `/api/resources/telecharger?id=${r.id}`,
}));

// Groupe par catégorie en respectant l'ordre de RESOURCE_CATEGORIES
const grouped: CategoryGroup[] = filterCat
  ? [{ category: filterCat, rows: allRows }]
  : RESOURCE_CATEGORIES
      .map((cat) => ({
        category: cat,
        rows: allRows.filter((row) => row.r.category === cat),
      }))
      .filter((g) => g.rows.length !== 0);

const hasResources = allRows.length !== 0;
const hasFilter    = filterCat !== '';
const totalLabel   = `${resources.length} ressource${resources.length !== 1 ? 's' : ''} disponible${resources.length !== 1 ? 's' : ''}`;
---

<DashboardLayout title="Ressources" activePage="resources" userName={userName}>

  <div class="page-header">
    <div>
      <h1>Ressources</h1>
      <p class="subtitle">Guides, fiches et outils pour mieux comprendre et utiliser l'IA.</p>
    </div>
    <p class="total-label">{totalLabel}</p>
  </div>

  <!-- Filtre par catégorie -->
  <div class="category-tabs">
    <a
      href="/dashboard/user/resources"
      class={`tab${hasFilter ? '' : ' tab--active'}`}
    >Tout</a>
    {RESOURCE_CATEGORIES.map((cat) => (
      <a
        href={`/dashboard/user/resources?category=${encodeURIComponent(cat)}`}
        class={`tab${filterCat === cat ? ' tab--active' : ''}`}
      >{cat}</a>
    ))}
  </div>

  {hasResources ? (
    <div class="groups">
      {grouped.map(({ category, rows }) => (
        <div class="group">
          {!hasFilter && <h2 class="group-title">{category}</h2>}
          <div class="resource-grid">
            {rows.map(({ r, icon, typeLabel, sizeLabel, href }) => (
              <div class="resource-card card">
                <div class="resource-top">
                  <span class="resource-icon">{icon}</span>
                  <span class="badge badge-info">{r.category}</span>
                </div>
                <div class="resource-title">{r.title}</div>
                {r.description && (
                  <p class="resource-desc">{r.description}</p>
                )}
                <div class="resource-meta">
                  <span class="meta-chip">{typeLabel}</span>
                  <span class="meta-chip">{sizeLabel}</span>
                  <span class="meta-chip">⬇ {r.downloads}</span>
                </div>
                <a
                  href={href}
                  class="btn btn-primary resource-dl"
                  download
                >
                  ⬇ Télécharger
                </a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="card empty-state">
      <p class="empty-icon">📭</p>
      <p>
        {hasFilter
          ? `Aucune ressource dans la catégorie « ${filterCat} » pour le moment.`
          : 'Aucune ressource disponible pour le moment. Revenez bientôt !'}
      </p>
    </div>
  )}

</DashboardLayout>

<style>
  /* ── En-tête ── */
  .page-header  { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
  .subtitle     { margin-top: 6px; color: var(--text-secondary); }
  .total-label  { font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono); align-self: flex-end; }

  /* ── Tabs catégories ── */
  .category-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 24px; }
  .tab           { padding: 6px 14px; font-size: 0.82rem; font-weight: 600; border: var(--brutal-border-thin); background: var(--surface); color: var(--text-secondary); cursor: pointer; text-decoration: none; transition: background 0.1s; }
  .tab:hover     { background: var(--surface-hover, #f5f5f5); }
  .tab--active   { background: var(--text-primary); color: var(--surface); border-color: var(--text-primary); }

  /* ── Groupes ── */
  .groups      { display: flex; flex-direction: column; gap: 32px; }
  .group-title { font-size: 0.95rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); margin-bottom: 12px; font-family: var(--font-mono); }

  /* ── Grille ressources ── */
  .resource-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }

  /* ── Carte ressource ── */
  .resource-card { display: flex; flex-direction: column; gap: 10px; }
  .resource-top  { display: flex; align-items: center; justify-content: space-between; }
  .resource-icon { font-size: 1.6rem; }
  .resource-title { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); line-height: 1.3; }
  .resource-desc  {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Meta chips ── */
  .resource-meta { display: flex; gap: 6px; flex-wrap: wrap; }
  .meta-chip     { font-size: 0.72rem; font-family: var(--font-mono); padding: 2px 8px; background: var(--surface-alt, #f0f0f0); color: var(--text-muted); border: var(--brutal-border-thin); }

  /* ── Bouton téléchargement ── */
  .resource-dl { margin-top: auto; text-align: center; justify-content: center; width: 100%; }

  /* ── État vide ── */
  .empty-state { text-align: center; padding: 48px 24px; }
  .empty-icon  { font-size: 1.5rem; margin-bottom: 8px; }
</style>