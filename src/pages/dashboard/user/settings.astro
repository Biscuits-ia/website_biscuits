---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAuth } from '../../../lib/auth';

const result = await requireAuth(Astro);
if (result instanceof Response) return result;

const { user } = result;
const userEmail    = user.email ?? '';
const userName     = user.user_metadata?.full_name ?? userEmail.split('@')[0];
const userPhone    = user.user_metadata?.phone ?? '';
const userOrg      = user.user_metadata?.organization ?? '';
const emailConfirmed = !!user.email_confirmed_at;

// Gestion des messages flash via query param
const saved  = Astro.url.searchParams.get('saved')  === '1';
const pwSaved = Astro.url.searchParams.get('pw')    === '1';
const error  = Astro.url.searchParams.get('error')  ?? '';
---

<DashboardLayout title="Paramètres" role="user" activePage="settings" userName={userName} userEmail={userEmail} authResult={result}>

  <div class="container w-full mb-6 text-center">
    <h1 class="text-xl font-bold tracking-tight text-primary">
      Paramètres du compte
    </h1>
    <p class="text-muted text-lg mt-1">
      Gérez vos informations personnelles et la sécurité de votre compte.
    </p>
  </div>

  {saved  && <div class="flash flash-ok"  role="alert">✓ Profil mis à jour avec succès.</div>}
  {pwSaved && <div class="flash flash-ok" role="alert">✓ Mot de passe mis à jour.</div>}
  {error   && <div class="flash flash-err" role="alert">✗ {decodeURIComponent(error)}</div>}

  <div class="flex flex-row gap-5 flex-wrap justify-between">

    <!-- Profil -->
    <div class="card flex-1">
      <div class="card-header">
        <span class="card-title">Informations personnelles</span>
        <span class={`badge ${emailConfirmed ? 'badge-ok' : 'badge-warn'}`}>
          {emailConfirmed ? '✓ Email vérifié' : '⚠ Email non vérifié'}
        </span>
      </div>

      <form method="POST" action="/auth/update-profile" class="flex flex-col gap-4">

        <div class="field">
          <label for="full_name">Nom complet</label>
          <input
            type="text"
            id="full_name"
            name="full_name"
            value={userName}
            placeholder="Votre nom complet"
            autocomplete="name"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="email">Adresse email</label>
          <input
            type="email"
            id="email"
            name="email"
            value={userEmail}
            placeholder="vous@exemple.com"
            autocomplete="email"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          {!emailConfirmed && (
            <span class="text-xs text-warn mt-1 font-mono">
              ⚠ Vérifiez votre boîte mail pour confirmer cette adresse.
            </span>
          )}
        </div>

        <div class="field">
          <label for="phone">Téléphone <span class="text-muted font-normal">(optionnel)</span></label>
          <input
            type="tel"
            id="phone"
            name="phone"
            value={userPhone}
            placeholder="+33 6 00 00 00 00"
            autocomplete="tel"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="organization">Organisation <span class="text-muted font-normal">(optionnel)</span></label>
          <input
            type="text"
            id="organization"
            name="organization"
            value={userOrg}
            placeholder="Nom de votre association / structure"
            autocomplete="organization"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div>
          <button type="submit" class="btn btn-primary">Sauvegarder</button>
        </div>

      </form>
    </div>

    <!-- Association/TPE -->
    <div class="card flex-1">
      <div class="card-header">
        <span class="card-title">Association/TPE</span>
      </div>
      <p class="text-muted text-sm mb-4">
        Configurez votre profil association ou TPE pour accéder aux fonctionnalités dédiées.
      </p>

      <form method="POST" action="/auth/create-association" class="flex flex-col gap-4">
        <div class="field">
          <label for="assoc_structure_name">Nom de la structure</label>
          <input
            type="text"
            id="assoc_structure_name"
            name="structure_name"
            placeholder="Nom de votre association ou TPE"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_siret">Numéro SIRET <span class="text-muted font-normal">(optionnel)</span></label>
          <input
            type="text"
            id="assoc_siret"
            name="siret"
            placeholder="14 chiffres"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_rna">Numéro RNA <span class="text-muted font-normal">(optionnel)</span></label>
          <input
            type="text"
            id="assoc_rna"
            name="rna_number"
            placeholder="W123456789"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_address">Adresse postale</label>
          <input
            type="text"
            id="assoc_address"
            name="address"
            placeholder="123 rue Exemple, 75000 Paris"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_phone">Numéro de téléphone</label>
          <input
            type="tel"
            id="assoc_phone"
            name="phone_number"
            placeholder="+33 6 00 00 00 00"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_email">Email de contact</label>
          <input
            type="email"
            id="assoc_email"
            name="contact_email"
            placeholder="contact@votre-structure.fr"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_description">Description <span class="text-muted font-normal">(optionnel)</span></label>
          <textarea
            id="assoc_description"
            name="description"
            placeholder="Présentez brièvement votre structure..."
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            style="min-height: 80px; resize: vertical;"
          ></textarea>
        </div>

        <div>
          <button type="submit" class="btn btn-primary">Créer mon profil association</button>
        </div>
      </form>
    </div>

    <!-- Mot de passe -->
    <div class="card flex-1">
      <div class="card-header">
        <span class="card-title">Sécurité</span>
      </div>

      <form method="POST" action="/auth/update-password" class="flex flex-col gap-4">

        <div class="field">
          <label for="current_password">Mot de passe actuel</label>
          <input
            type="password"
            id="current_password"
            name="current_password"
            placeholder="••••••••"
            autocomplete="current-password"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="new_password">Nouveau mot de passe</label>
          <input
            type="password"
            id="new_password"
            name="new_password"
            placeholder="••••••••"
            autocomplete="new-password"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <span class="text-sm text-muted mt-1 font-mono">
            Minimum 8 caractères.
          </span>
        </div>

        <div class="field">
          <label for="confirm_password">Confirmer le nouveau mot de passe</label>
          <input
            type="password"
            id="confirm_password"
            name="confirm_password"
            placeholder="••••••••"
            autocomplete="new-password"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div>
          <button type="submit" class="btn btn-primary">Mettre à jour le mot de passe</button>
        </div>

      </form>
    </div>

  </div>

  <!-- Danger zone -->
  <div class="card border-err mt-5">
    <div class="card-header">
      <span class="card-title text-err">Zone de danger</span>
    </div>
    <p class="text-lg text-secondary mb-4">
      La suppression de votre compte est irréversible. Toutes vos données seront effacées définitivement.
    </p>
    <button
      type="button"
      class="btn btn-danger"
      onclick="if(confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.')) window.location.href='/auth/delete-account'"
    >
      Supprimer mon compte
    </button>
  </div>

  <script>
    // Gestion du formulaire de mise à jour de profil
    const profileForm = document.querySelector('form[action="/auth/update-profile"]');
    console.log('Profile form found:', !!profileForm);
    console.log('Profile form action:', profileForm?.action);
    if (profileForm instanceof HTMLFormElement) {
      profileForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(profileForm);
        const btn = profileForm.querySelector('button[type="submit"]');
        console.log('Button found:', !!btn);
        if (!btn || btn instanceof HTMLButtonElement === false) return;
        
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Enregistrement...';
        
        try {
          console.log('Sending request to /auth/update-profile');
          const response = await fetch('/auth/update-profile', {
            method: 'POST',
            body: formData,
          });
          console.log('Response status:', response.status);
          
          const data = await response.json();
          console.log('Response data:', data);
          
          if (!response.ok) {
            throw new Error(data.error || 'Erreur lors de la mise à jour');
          }
          
          // Rediriger avec le paramètre de succès
          window.location.href = '/dashboard/user/settings?saved=1';
        } catch (error: any) {
          console.error('Error during update:', error);
          // Rediriger avec le paramètre d'erreur
          const errorMsg = encodeURIComponent(error.message || 'Erreur inconnue');
          window.location.href = `/dashboard/user/settings?error=${errorMsg}`;
        }
      });
    }
    
    // Gestion du formulaire de mise à jour de mot de passe
    const passwordForm = document.querySelector('form[action="/auth/update-password"]');
    console.log('Password form found:', !!passwordForm);
    console.log('Password form action:', passwordForm?.action);
    if (passwordForm instanceof HTMLFormElement) {
      passwordForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(passwordForm);
        const btn = passwordForm.querySelector('button[type="submit"]');
        console.log('Button found:', !!btn);
        if (!btn || btn instanceof HTMLButtonElement === false) return;
        
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Mise à jour...';
        
        try {
          console.log('Sending request to /auth/update-password');
          const response = await fetch('/auth/update-password', {
            method: 'POST',
            body: formData,
          });
          console.log('Response status:', response.status);
          
          const data = await response.json();
          console.log('Response data:', data);
          
          if (!response.ok) {
            throw new Error(data.error || 'Erreur lors de la mise à jour du mot de passe');
          }
          
          // Rediriger avec le paramètre de succès
          window.location.href = '/dashboard/user/settings?pw=1';
        } catch (error: any) {
          console.error('Error during password update:', error);
          // Rediriger avec le paramètre d'erreur
          const errorMsg = encodeURIComponent(error.message || 'Erreur inconnue');
          window.location.href = `/dashboard/user/settings?error=${errorMsg}`;
        }
      });
    }
  </script>
</DashboardLayout>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }
  .flash {
    padding: 10px 16px;
    margin-bottom: 16px;
    font-size: 0.83rem;
    font-weight: 600;
    border: var(--brutal-border-thin);
    box-shadow: var(--shadow-sm);
  }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }
</style>
