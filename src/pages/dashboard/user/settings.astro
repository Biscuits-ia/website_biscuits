---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAuth } from '../../../lib/auth';

const result = await requireAuth(Astro);
if (result instanceof Response) return result;

const { user } = result;
const userEmail    = user.email ?? '';
const userName     = user.user_metadata?.full_name ?? userEmail.split('@')[0];
const userPhone    = user.user_metadata?.phone ?? '';
const userOrg      = user.user_metadata?.organization ?? '';
const emailConfirmed = !!user.email_confirmed_at;

// Gestion des messages flash via query param
const saved   = Astro.url.searchParams.get('saved')   === '1';
const pwSaved = Astro.url.searchParams.get('pw')     === '1';
const error   = Astro.url.searchParams.get('error')  ?? '';
const assoc   = Astro.url.searchParams.get('assoc')  ?? '';
const assocMsg = Astro.url.searchParams.get('msg')   ?? '';
---

<DashboardLayout title="ParamÃ¨tres" activePage="settings" userName={userName} userEmail={userEmail} authResult={result}>

  <div class="container w-full mb-6 text-center">
    <h1 class="text-xl font-bold tracking-tight text-primary">
      ParamÃ¨tres du compte
    </h1>
    <p class="text-muted text-lg mt-1">
      GÃ©rez vos informations personnelles et la sÃ©curitÃ© de votre compte.
    </p>
  </div>

  {saved   && <div class="flash flash-ok"  role="alert">âœ“ Profil mis Ã  jour avec succÃ¨s.</div>}
  {pwSaved && <div class="flash flash-ok" role="alert">âœ“ Mot de passe mis Ã  jour.</div>}
  {error   && <div class="flash flash-err" role="alert">âœ— {decodeURIComponent(error)}</div>}
  {assoc === 'ok'  && <div class="flash flash-ok"  role="alert">âœ“ {decodeURIComponent(assocMsg) || 'Profil association crÃ©Ã© avec succÃ¨s.'}</div>}
  {assoc === 'err' && <div class="flash flash-err" role="alert">âœ— {decodeURIComponent(assocMsg) || 'Erreur lors de la crÃ©ation du profil association.'}</div>}

  <div class="flex flex-row gap-5 flex-wrap justify-between">

    <!-- Profil -->
    <div class="card flex-1">
      <div class="card-header">
        <span class="card-title">Informations personnelles</span>
        <span class={`badge ${emailConfirmed ? 'badge-ok' : 'badge-warn'}`}>
          {emailConfirmed ? 'âœ“ Email vÃ©rifiÃ©' : 'âš  Email non vÃ©rifiÃ©'}
        </span>
      </div>

      <form method="POST" action="/auth/update-profile" class="flex flex-col gap-4">

        <div class="field">
          <label for="full_name">Nom complet</label>
          <input
            type="text"
            id="full_name"
            name="full_name"
            value={userName}
            placeholder="Votre nom complet"
            autocomplete="name"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="email">Adresse email</label>
          <input
            type="email"
            id="email"
            name="email"
            value={userEmail}
            placeholder="vous@exemple.com"
            autocomplete="email"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          {!emailConfirmed && (
            <span class="text-xs text-warn mt-1 font-mono">
              âš  VÃ©rifiez votre boÃ®te mail pour confirmer cette adresse.
            </span>
          )}
        </div>

        <div class="field">
          <label for="phone">TÃ©lÃ©phone <span class="text-muted font-normal">(optionnel)</span></label>
          <input
            type="tel"
            id="phone"
            name="phone"
            value={userPhone}
            placeholder="+33 6 00 00 00 00"
            autocomplete="tel"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="organization">Organisation <span class="text-muted font-normal">(optionnel)</span></label>
          <input
            type="text"
            id="organization"
            name="organization"
            value={userOrg}
            placeholder="Nom de votre association / structure"
            autocomplete="organization"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div>
          <button type="submit" class="btn btn-primary">Sauvegarder</button>
        </div>

      </form>
    </div>

    <!-- Association/TPE -->
    <div class="card flex-1">
      <div class="card-header">
        <span class="card-title">Association/TPE</span>
      </div>
      <p class="text-muted text-sm mb-4">
        Configurez votre profil association ou TPE pour accÃ©der aux fonctionnalitÃ©s dÃ©diÃ©es.
      </p>

      <form method="POST" action="/auth/create-association" class="flex flex-col gap-4">
        <div class="field">
          <label for="assoc_structure_name">Nom de la structure</label>
          <input
            type="text"
            id="assoc_structure_name"
            name="structure_name"
            placeholder="Nom de votre association ou TPE"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_siret">NumÃ©ro SIRET <span class="text-muted font-normal">(optionnel)</span></label>
          <input
            type="text"
            id="assoc_siret"
            name="siret"
            placeholder="14 chiffres"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_rna">NumÃ©ro RNA <span class="text-muted font-normal">(optionnel)</span></label>
          <input
            type="text"
            id="assoc_rna"
            name="rna_number"
            placeholder="W123456789"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_address">Adresse postale</label>
          <input
            type="text"
            id="assoc_address"
            name="address"
            placeholder="123 rue Exemple, 75000 Paris"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_phone">NumÃ©ro de tÃ©lÃ©phone</label>
          <input
            type="tel"
            id="assoc_phone"
            name="phone_number"
            placeholder="+33 6 00 00 00 00"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_email">Email de contact</label>
          <input
            type="email"
            id="assoc_email"
            name="contact_email"
            placeholder="contact@votre-structure.fr"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="assoc_description">Description <span class="text-muted font-normal">(optionnel)</span></label>
          <textarea
            id="assoc_description"
            name="description"
            placeholder="PrÃ©sentez briÃ¨vement votre structure..."
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            style="min-height: 80px; resize: vertical;"
          ></textarea>
        </div>

        <div>
          <button type="submit" class="btn btn-primary">CrÃ©er mon profil association</button>
        </div>
      </form>
    </div>

    <!-- Mot de passe -->
    <div class="card flex-1">
      <div class="card-header">
        <span class="card-title">SÃ©curitÃ©</span>
      </div>

      <form method="POST" action="/auth/update-password" class="flex flex-col gap-4">

        <div class="field">
          <label for="current_password">Mot de passe actuel</label>
          <input
            type="password"
            id="current_password"
            name="current_password"
            placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"
            autocomplete="current-password"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div class="field">
          <label for="new_password">Nouveau mot de passe</label>
          <input
            type="password"
            id="new_password"
            name="new_password"
            placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"
            autocomplete="new-password"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
          <span class="text-sm text-muted mt-1 font-mono">
            Minimum 8 caractÃ¨res.
          </span>
        </div>

        <div class="field">
          <label for="confirm_password">Confirmer le nouveau mot de passe</label>
          <input
            type="password"
            id="confirm_password"
            name="confirm_password"
            placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"
            autocomplete="new-password"
            class="border border-border rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <div>
          <button type="submit" class="btn btn-primary">Mettre Ã  jour le mot de passe</button>
        </div>

      </form>
    </div>

  </div>

  <!-- Danger zone -->
  <div class="card border-err mt-5">
    <div class="card-header">
      <span class="card-title text-err">Zone de danger</span>
    </div>
    <p class="text-lg text-secondary mb-4">
      La suppression de votre compte est irrÃ©versible. Toutes vos donnÃ©es seront effacÃ©es dÃ©finitivement.
    </p>
    <form
      id="delete-account-form"
      method="POST"
      action="/auth/delete-account"
      class="inline"
    >
      <button
        type="submit"
        class="btn btn-danger"
        data-confirm-delete="1"
      >
        Supprimer mon compte
      </button>
    </form>
  </div>

  <script>
    /* Helper : intercepte la soumission d'un form en AJAX et redirige vers
       `response.redirect` (ou un fallback) selon le rÃ©sultat. */
    function bindAjaxForm(formSelector: string, fallbackRedirect: string): void {
      const form = document.querySelector(formSelector);
      if (!(form instanceof HTMLFormElement)) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        if (!(btn instanceof HTMLButtonElement)) return;

        btn.disabled = true;
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
          });
          const data = await res.json().catch(() => ({}));
          const redirect =
            (data && typeof data.redirect === 'string' && data.redirect) ||
            (res.ok ? fallbackRedirect : null);
          if (redirect) {
            window.location.href = redirect;
          } else if (data && typeof data.error === 'string') {
            window.location.href =
              `/dashboard/user/settings?error=${encodeURIComponent(data.error)}`;
          } else {
            btn.disabled = false;
          }
        } catch (err) {
          console.error('Form submit failed:', err);
          btn.disabled = false;
        }
      });
    }

    bindAjaxForm('form[action="/auth/update-profile"]',   '/dashboard/user/settings?saved=1');
    bindAjaxForm('form[action="/auth/update-password"]',  '/dashboard/user/settings?pw=1');
    /* Confirmation native avant suppression du compte (defense anti-CSRF) */
    const delForm = document.querySelector('form#delete-account-form');
    if (delForm instanceof HTMLFormElement) {
      delForm.addEventListener('submit', (e) => {
        if (!window.confirm('Supprimer definitivement votre compte ? Cette action est irreversible.')) {
          e.preventDefault();
          return;
        }
        const btn = delForm.querySelector('button[type="submit"]');
        if (btn instanceof HTMLButtonElement) btn.disabled = true;
      });
    }

    /* Formulaire association : pas de redirect serveur, on reste sur la page
       et on affiche un flash via le query param `assoc=ok|err`. */
    const assocForm = document.querySelector('form[action="/auth/create-association"]');
    if (assocForm instanceof HTMLFormElement) {
      assocForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = assocForm.querySelector('button[type="submit"]');
        if (!(btn instanceof HTMLButtonElement)) return;
        btn.disabled = true;
        try {
          const res = await fetch(assocForm.action, {
            method: 'POST',
            body: new FormData(assocForm),
          });
          const data = await res.json().catch(() => ({}));
          const status = res.ok ? 'ok' : 'err';
          const msg    = res.ok
            ? (data.message ?? 'Profil association crÃ©Ã© avec succÃ¨s.')
            : (data.error   ?? 'Erreur lors de la crÃ©ation du profil.');
          window.location.href =
            `/dashboard/user/settings?assoc=${status}&msg=${encodeURIComponent(msg)}`;
        } catch (err) {
          console.error('Association form submit failed:', err);
          btn.disabled = false;
        }
      });
    }
  </script>
</DashboardLayout>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }
  .flash {
    padding: 10px 16px;
    margin-bottom: 16px;
    font-size: 0.83rem;
    font-weight: 600;
    border: var(--brutal-border-thin);
    box-shadow: var(--shadow-sm);
  }
  .flash-ok  { background: var(--ok-bg);  color: var(--ok-fg);  border-color: var(--ok); }
  .flash-err { background: var(--err-bg); color: var(--err-fg); border-color: var(--err); }
</style>
