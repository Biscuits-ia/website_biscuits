---
import BaseLayout from '@layouts/Layout.astro';
import DevisForm from '@/components/svelte/DevisForm.svelte';

---

<BaseLayout
  title="Demande de devis | Biscuits IA"
  description="Obtenez un devis personnalisé pour vos besoins en solutions IA adaptées."
>
  <section class="quote-hero">
    <div class="container">
      <h1>Demande de devis</h1>
      <p>Obtenez une estimation personnalisée pour vos besoins professionnels.</p>
    </div>
  </section>

  <section class="quote-form-section">
    <div class="container">
      <h2>Informations nécessaires</h2>
      <DevisForm client:load />
    </div>
  </section>

  <section class="quote-info">
    <div class="container">
      <h2>Comment ça marche ?</h2>
      <div class="steps">
        <div class="step">
          <span class="icon" aria-hidden="true">📥</span>
          <h3>1. Vous envoyez votre demande</h3>
          <p>Avec les informations nécessaires pour analyser vos besoins.</p>
        </div>

        <div class="step">
          <span class="icon" aria-hidden="true">🧠</span>
          <h3>2. Analyse & estimation</h3>
          <p>Nous évaluons la charge, les outils nécessaires et les délais.</p>
        </div>

        <div class="step">
          <span class="icon" aria-hidden="true">📄</span>
          <h3>3. Envoi du devis</h3>
          <p>Tarifs transparents, modulaires, sans engagement.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <h2>Des questions avant de demander un devis ?</h2>
      <p>Contactez-nous, nous vous guidons gratuitement.</p>
      <div class="cta-buttons">
        <a href="mailto:contact@biscuits-ia.com" id="btn-contact" class="btn-primary">Envoyer un mail</a>
        <a href="/services" class="btn-secondary">Découvrir nos services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quote-hero {
    padding: 6rem var(--spacing-lg);
    text-align: center;
    background: var(--color-bg);
  }

  .quote-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }

  .quote-hero p {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--color-text-light);
    max-width: 700px;
    margin: 0 auto;
  }

  .quote-form-section {
    padding: 4rem var(--spacing-lg);
  }

  .quote-form-section h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--spacing-2xl);
  }

  .quote-info {
    padding: 4rem var(--spacing-lg);
    background: var(--color-bg-alt);
  }

  .quote-info h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--spacing-2xl);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-2xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  .step {
    background: var(--color-bg);
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    text-align: center;
    border: 2px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .step:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .step .icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--spacing-md);
  }

  .step h3 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
  }

  .step p {
    color: var(--color-text-light);
    line-height: 1.6;
  }

  .final-cta {
    padding: 4rem var(--spacing-lg);
    text-align: center;
    background: var(--color-bg);
  }

  .final-cta h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }

  .final-cta p {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--color-text-light);
    margin-bottom: var(--spacing-xl);
  }

  .cta-buttons {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: var(--radius-lg);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .btn-secondary {
    background: var(--color-bg-alt);
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-primary);
  }

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step {
      transition: none;
    }
    
    .step:hover {
      transform: none;
    }
  }
</style>