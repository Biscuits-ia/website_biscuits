---
// src/pages/faq.astro
// FAQ publique avec schema FAQPage (rich snippet Google). 100% statique,
// prétendue `prerender = true` pour la mise en cache CDN.

export const prerender = true;

import BaseLayout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const faq = [
  {
    q: 'Qui peut rejoindre Biscuits IA ?',
    a: "Associations, collectifs, bénévoles et petites structures qui veulent utiliser l'IA de façon utile et responsable. Pas de niveau technique requis, pas de barrière à l'entrée.",
  },
  {
    q: 'Vos ressources sont-elles gratuites ?',
    a: 'Oui. Guides, checklists PDF, ateliers : tout est accessible gratuitement ou à prix libre. Notre objectif est de faciliter l\'accès aux bons outils, sans barrière financière.',
  },
  {
    q: 'Comment demander un accompagnement ?',
    a: "Écrivez-nous via la page Contact en décrivant votre structure et votre besoin. Nous répondons sous 48h ouvrées et vous proposons un échange si le sujet s'y prête.",
  },
  {
    q: 'Vos ateliers sont-ils en ligne ou en présentiel ?',
    a: 'Les deux. Les sessions en ligne accueillent jusqu\'à 15 participants. Les ateliers en présentiel ont lieu à Poitiers et dans les villes partenaires, sur demande.',
  },
  {
    q: 'Vous aidez uniquement les associations ?',
    a: 'Non : nous accompagnons aussi les TPE, les collectivités et les collectifs. Notre cible commune : les structures à but non lucratif ou d\'intérêt général qui n\'ont pas les moyens de se payer un consultant IA.',
  },
  {
    q: 'Vos outils sont-ils open source ?',
    a: 'Oui. Tous les outils que nous développons ou recommandons sont publiés en open source. Vous pouvez les auditer, les adapter, les redéployer.',
  },
  {
    q: 'Combien coûtent vos ateliers ?',
    a: "Nos ateliers sont gratuits ou à prix libre selon le contexte et la structure. Pour les interventions sur mesure en entreprise ou en collectivité, un devis est établi au cas par cas. Écrivez-nous pour en discuter.",
  },
  {
    q: 'Anti Pepins est-il vraiment gratuit ?',
    a: "Oui, entièrement. Anti Pepins analyse vos SMS, e-mails et liens suspects en quelques secondes, sans compte à créer, sur anti-pepins.biscuits-ia.com. C'est un service public de l'association, financé par nos autres activités.",
  },
  {
    q: 'Sous quelle licence sont publiés vos contenus et vos outils ?',
    a: "Nos billets de blog, tutoriels et supports d'atelier sont le plus souvent partagés sous licence Creative Commons BY-SA 4.0 (libre de partage et d'adaptation, à condition de créditer et de repartager sous la même licence). Notre code source est publié en open source sur GitHub.",
  },
  {
    q: "Comment signaler une arnaque ou un contenu suspect que j'ai reçu ?",
    a: "Utilisez Anti Pepins pour une première analyse instantanée. Pour un signalement officiel, adressez-vous à PHAROS (contenus illicites) ou au 3018 (violences numériques envers les mineurs), qui sont les services compétents.",
  },
];

const schema = {
  type: 'FAQPage' as const,
  data: {
    questions: faq.map(({ q, a }) => ({ question: q, answer: a })),
  },
};
---

<BaseLayout
  title="FAQ | Biscuits IA"
  description="Questions fréquentes sur Biscuits IA : ateliers, ressources, accompagnement, Anti Pepins, open source."
  schema={schema}
>
  <Breadcrumb />
  <section class="simple-page">
    <div class="container">
      <header class="faq-header">
        <h1>Questions fréquentes</h1>
        <p class="faq-lead">
          Tout ce que vous devez savoir sur Biscuits IA, nos ateliers, nos ressources et notre accompagnement. Une autre question ? <a href="/contact">Écrivez-nous</a>.
        </p>
      </header>

      <div class="faq-list">
        {faq.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{q}</span>
              <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <p class="faq-answer">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .simple-page {
    padding: 6rem 0 4rem;
  }

  .container {
    width: min(900px, 92vw);
    margin: 0 auto;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--color-text);
  }

  .faq-lead {
    color: var(--color-text-light);
    font-size: 1.1rem;
    margin: 0;
  }

  .faq-lead a { color: var(--color-primary); font-weight: 700; }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 0.25rem 1rem;
  }

  .faq-item[open] {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    margin: 0 0 1rem;
    color: var(--color-text-light);
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron { transition: none; }
  }
</style>