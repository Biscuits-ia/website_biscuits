---
// src/pages/formations/[slug]/inscription.astro
// Page d'inscription a une session d'une formation.
// Gere 3 flux :
//   1. Paiement libre (sliding scale) -> HelloAsso / virement
//   2. Demande d'exoneration (free_request)
//   3. Utilisation d'un code de parrainage (sponsorship)

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { createSupabaseClient, createSupabaseAdminClient } from '@/lib/supabase';
import type { TrainingSessionWithSeats } from '@/types/formations';
import { formatDateLong, formatTimeRange, formatSlidingScale, isFreeTraining } from '@/types/formations';

export const prerender = false;

const supabase = createSupabaseClient({ request: Astro.request, cookies: Astro.cookies });
const admin   = createSupabaseAdminClient(Astro);

const { data: { user } } = await supabase.auth.getUser();
const isLoggedIn = !!user;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/formations');

// Charge la formation
const { data: training, error: trainingError } = await admin
  .from('trainings')
  .select('*')
  .eq('slug', slug)
  .eq('is_published', true)
  .maybeSingle();

if (trainingError || !training) {
  return new Response('Formation introuvable', { status: 404 });
}

// Charge TOUTES les sessions a venir pour le selecteur
const { data: allSessions } = await admin
  .from('training_sessions_with_seats')
  .select('*')
  .eq('training_id', training.id)
  .eq('is_published', true)
  .gte('starts_at', new Date().toISOString())
  .order('starts_at', { ascending: true });

// Session choisie dans l'URL (optionnel)
const urlSessionId = Astro.url.searchParams.get('session') ?? '';

const initialSession = (allSessions ?? []).find((s) => s.id === urlSessionId) ?? null;
const hasSessions    = (allSessions ?? []).length > 0;

const isFree = isFreeTraining(
  training.min_price_cents,
  training.suggested_price_cents,
  training.solidarity_price_cents,
);

const redirectAfterLogin = encodeURIComponent(Astro.url.pathname + Astro.url.search);
---

<Layout
  title={`Inscription - ${training.title} | Formations | Biscuits IA`}
  description="Inscription a une session de formation. Tarif conscient, demande de place gratuite, ou code de parrainage."
>
  <Breadcrumb />

  <section class="inscription-hero">
    <div class="container">
      <h1>Inscription : {training.title}</h1>
      <p class="lead">Choisissez votre session et votre mode de participation.</p>
    </div>
  </section>

  <section class="inscription-body">
    <div class="container">
      {!isLoggedIn && (
        <div class="alert alert-info" role="alert">
          <strong>Connectez-vous</strong> pour vous inscrire a une session.{' '}
          <a href={`/connexion?redirect=${redirectAfterLogin}`}>Se connecter</a>{' '}
          ou <a href={`/inscription?redirect=${redirectAfterLogin}`}>creer un compte</a>.
        </div>
      )}

      {!hasSessions && (
        <div class="alert alert-info">
          Aucune session n'est ouverte a l'inscription pour cette formation pour le moment.
        </div>
      )}

      {hasSessions && isLoggedIn && (
        <div class="inscription-form">
          <form method="POST" action="/api/formations/inscrire">

            <fieldset class="form-block">
              <legend>1. Choisir une session</legend>
              <div class="sessions-picker">
                {(allSessions ?? []).map((s: TrainingSessionWithSeats) => {
                  const seats = s.seats_left > 0
                    ? (s.seats_left === 1 ? '1 place restante' : `${s.seats_left} places`)
                    : 'Complet';
                  const isSelected = (initialSession?.id ?? urlSessionId) === s.id;
                  const isDisabled = s.seats_left <= 0;
                  return (
                    <label class={`session-pick${isSelected ? ' selected' : ''}${isDisabled ? ' disabled' : ''}`}>
                      <input
                        type="radio"
                        name="session_id"
                        value={s.id}
                        required
                        checked={isSelected}
                        disabled={isDisabled}
                      />
                      <span class="pick-main">
                        <span class="pick-date">{formatDateLong(s.starts_at)}</span>
                        <span class="pick-time">{formatTimeRange(s.starts_at, s.ends_at)}</span>
                      </span>
                      <span class="pick-seats">{seats}</span>
                    </label>
                  );
                })}
              </div>
            </fieldset>

            {!isFree && (
              <fieldset class="form-block">
                <legend>2. Choisir votre tarif</legend>
                <p class="form-hint">
                  {formatSlidingScale(
                    training.min_price_cents,
                    training.suggested_price_cents,
                    training.solidarity_price_cents,
                  )}. Vous choisissez librement.
                </p>

                <div class="price-picker">
                  <label class="price-radio">
                    <input type="radio" name="price_preset" value={training.min_price_cents} />
                    <span>Min : <strong>{formatSlidingScale(training.min_price_cents, training.min_price_cents, training.min_price_cents).replace(/^Min /, '')}</strong></span>
                  </label>
                  <label class="price-radio">
                    <input type="radio" name="price_preset" value={training.suggested_price_cents} checked />
                    <span>Suggere : <strong>{formatSlidingScale(training.suggested_price_cents, training.suggested_price_cents, training.suggested_price_cents).replace(/^Suggere /, '')}</strong></span>
                  </label>
                  <label class="price-radio">
                    <input type="radio" name="price_preset" value={training.solidarity_price_cents} />
                    <span>Solidarite : <strong>{formatSlidingScale(training.solidarity_price_cents, training.solidarity_price_cents, training.solidarity_price_cents).replace(/^Solidarite /, '')}</strong></span>
                  </label>
                </div>

                <label class="field">
                  <span>Ou entrez un montant libre (en EUR) :</span>
                  <input
                    type="number"
                    name="amount_eur"
                    min={training.min_price_cents / 100}
                    max={training.solidarity_price_cents / 100}
                    step="1"
                    placeholder={`Entre ${training.min_price_cents / 100} et ${training.solidarity_price_cents / 100} EUR`}
                  />
                </label>
                <input type="hidden" name="amount_cents" value={String(training.suggested_price_cents)} />
              </fieldset>
            )}

            <fieldset class="form-block">
              <legend>{isFree ? '2' : '3'}. Mode de paiement</legend>

              <label class="payment-radio">
                <input type="radio" name="payment_method" value="helloasso" checked />
                <span>Payer en ligne via <strong>HelloAsso</strong> (carte, sans frais)</span>
              </label>
              <label class="payment-radio">
                <input type="radio" name="payment_method" value="transfer" />
                <span>Payer par <strong>virement bancaire</strong> (vous recevrez les coordonnees par email)</span>
              </label>
              {training.is_paying && (
                <label class="payment-radio">
                  <input type="radio" name="payment_method" value="free_request" />
                  <span>Demander une <strong>place offerte</strong> (validation sous 48h)</span>
                </label>
              )}
            </fieldset>

            {training.is_paying && (
              <fieldset class="form-block">
                <legend>{isFree ? '3' : '4'}. Code de parrainage (optionnel)</legend>
                <label class="field">
                  <span>Si vous avez recu un code d'un parrain, entrez-le ici :</span>
                  <input
                    type="text"
                    name="redemption_code"
                    placeholder="Ex : AB23CD45"
                    pattern="[A-Z0-9]{6,12}"
                    style="text-transform: uppercase;"
                  />
                  <small class="form-hint">
                    Si un code est saisi, il remplacera le mode de paiement ci-dessus.
                  </small>
                </label>
              </fieldset>
            )}

            <fieldset class="form-block">
              <legend>Note (optionnel)</legend>
              <label class="field">
                <span>Une precision a nous communiquer (acces, regime, etc.) :</span>
                <textarea name="notes" rows="3" maxlength="500" placeholder=""></textarea>
              </label>
            </fieldset>

            <fieldset class="form-block">
              <label class="cgv-checkbox">
                <input type="checkbox" name="cgv_accepted" value="1" required />
                <span>
                  J\'ai lu et j\'accepte les <a href="/legal/cgv" target="_blank" rel="noopener">Conditions Generales de Vente</a> (CGV v1.0)
                  et la <a href="/legal/politique-de-confidentialite" target="_blank" rel="noopener">Politique de confidentialite</a> de Biscuits IA.
                </span>
              </label>
            </fieldset>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Valider mon inscription</button>
              <a href={`/formations/${slug}`} class="btn btn-ghost">Annuler</a>
            </div>
          </form>
        </div>
      )}

      <aside class="aside-help">
        <h2>Besoin d'aide ?</h2>
        <ul>
          <li><a href="/contact">Nous contacter</a></li>
          <li><a href="/faq">Consulter la FAQ</a></li>
          <li><a href="/formations/parrainer">Parrainer une place</a></li>
        </ul>
      </aside>
    </div>
  </section>
</Layout>

<script is:inline>
  // Si l'utilisateur saisit un montant libre, on met a jour le hidden "amount_cents".
  // Si un code de parrainage est saisi, on bascule le payment_method sur "sponsorship".
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('form');
    if (!form) return;
    const amountEur = form.querySelector('input[name="amount_eur"]');
    const amountCents = form.querySelector('input[name="amount_cents"]');
    const presetRadios = form.querySelectorAll('input[name="price_preset"]');
    const codeInput = form.querySelector('input[name="redemption_code"]');
    const paymentRadios = form.querySelectorAll('input[name="payment_method"]');

    function syncAmountFromEur() {
      if (!amountEur || !amountCents) return;
      const eur = Number(amountEur.value);
      if (Number.isFinite(eur) && eur > 0) {
        amountCents.value = String(Math.round(eur * 100));
        // Desactive les presets
        presetRadios.forEach((r) => { r.checked = false; });
      }
    }
    function syncAmountFromPreset() {
      if (!amountEur || !amountCents) return;
      const checked = Array.from(presetRadios).find((r) => r.checked);
      if (checked) {
        amountCents.value = checked.value;
        amountEur.value = '';
      }
    }
    function syncCode() {
      if (!codeInput) return;
      const v = (codeInput.value || '').trim().toUpperCase();
      codeInput.value = v;
      if (v.length >= 6) {
        // Bascule le payment_method sur sponsorship
        paymentRadios.forEach((r) => { r.checked = r.value === 'sponsorship'; });
      }
    }

    amountEur?.addEventListener('input', syncAmountFromEur);
    presetRadios.forEach((r) => r.addEventListener('change', syncAmountFromPreset));
    codeInput?.addEventListener('input', syncCode);
  });
</script>

<style>
  .inscription-hero {
    padding: 40px 0 24px;
    background: var(--color-bg-alt);
    border-bottom: 4px solid var(--color-border);
  }
  .inscription-hero h1 { font-size: clamp(1.75rem, 3.5vw, 2.4rem); margin-bottom: 8px; color: var(--color-text); }
  .lead { color: var(--color-text-light); }

  .inscription-body { padding: 40px 0; }
  .container { max-width: 880px; margin: 0 auto; padding: 0 24px; }

  .alert { padding: 12px 18px; margin-bottom: 20px; border: var(--brutal-border-thin); }
  .alert-info { background: var(--color-accent-vanilla); }

  .inscription-form { display: flex; flex-direction: column; gap: 24px; }
  .form-block {
    padding: 20px; border: var(--brutal-border); background: var(--color-bg-elevated);
    box-shadow: var(--shadow-sm);
  }
  .form-block legend {
    font-weight: 800; font-size: 1.05rem; padding: 0 8px; color: var(--color-text);
  }
  .form-hint { font-size: 0.9rem; color: var(--color-text-light); margin: 8px 0 12px; line-height: 1.5; }

  .sessions-picker { display: flex; flex-direction: column; gap: 8px; }
  .session-pick {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 16px; border: var(--brutal-border); cursor: pointer;
    background: var(--color-bg);
  }
  .session-pick:hover { background: var(--color-accent-vanilla); }
  .session-pick.selected { background: var(--color-accent-honey); }
  .session-pick.disabled { opacity: 0.5; cursor: not-allowed; }
  .session-pick input[type="radio"] { width: 18px; height: 18px; }
  .pick-main { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .pick-date { font-weight: 700; color: var(--color-text); }
  .pick-time { font-size: 0.85rem; color: var(--color-text-light); }
  .pick-seats { font-size: 0.9rem; font-weight: 700; color: var(--color-text); }

  .price-picker { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
  .price-radio {
    display: flex; align-items: center; gap: 6px; padding: 8px 14px;
    border: var(--brutal-border-thin); cursor: pointer; background: var(--color-bg);
  }
  .price-radio:hover { background: var(--color-accent-vanilla); }

  .field { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }
  .field span { font-size: 0.9rem; color: var(--color-text); font-weight: 600; }
  .field input, .field textarea {
    padding: 10px 14px; font-size: 1rem; font-family: inherit;
  }

  .payment-radio {
    display: flex; align-items: center; gap: 10px; padding: 10px 14px;
    border: var(--brutal-border-thin); cursor: pointer; margin-bottom: 8px;
    background: var(--color-bg);
  }
  .payment-radio:hover { background: var(--color-accent-vanilla); }

  .form-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.cgv-checkbox {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 12px 14px;
  border: 2px solid var(--color-border);
  background: var(--color-bg-alt);
  cursor: pointer;
  font-size: 0.9rem;
  line-height: 1.4;
}
.cgv-checkbox input { margin-top: 4px; width: 18px; height: 18px; flex-shrink: 0; }
.cgv-checkbox a { color: var(--color-primary); text-decoration: underline; }
  .btn { padding: 12px 24px; font-weight: 700; text-decoration: none; display: inline-block; border: var(--brutal-border); cursor: pointer; }
  .btn-primary { background: var(--color-primary); color: white; box-shadow: var(--shadow-md); }
  .btn-primary:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-lg); }
  .btn-ghost { background: var(--color-bg-elevated); color: var(--color-text); }

  .aside-help {
    margin-top: 40px; padding: 20px; border: var(--brutal-border-thin);
    background: var(--color-bg);
  }
  .aside-help h2 { font-size: 1.05rem; margin-bottom: 8px; }
  .aside-help ul { list-style: none; padding: 0; display: flex; gap: 16px; flex-wrap: wrap; }
  .aside-help a { color: var(--color-primary); font-weight: 700; }

  @media (max-width: 600px) {
    .sessions-picker { gap: 6px; }
    .session-pick { flex-direction: column; align-items: flex-start; }
  }

  .cgv-checkbox {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 12px 14px;
    border: 2px solid var(--color-border);
    background: var(--color-bg-alt);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .cgv-checkbox input { margin-top: 4px; width: 18px; height: 18px; flex-shrink: 0; cursor: pointer; }
  .cgv-checkbox a { color: var(--color-primary); text-decoration: underline; }
</style>