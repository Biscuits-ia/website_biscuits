---
// src/pages/formations/parrainer.astro
// Page publique pour qu''un particulier ou une entreprise parraine une place.
// Supporte les 2 modes : pool libre, ou nominatif (email du beneficiaire).

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { createSupabaseAdminClient } from '@/lib/supabase';
import { formatSlidingScale, isFreeTraining } from '@/types/formations';

export const prerender = false;

const admin = createSupabaseAdminClient(Astro);

const { data: trainings } = await admin
  .from('trainings')
  .select('id, title, slug, is_paying, min_price_cents, suggested_price_cents, solidarity_price_cents, training_sessions(id, starts_at, is_published)')
  .eq('is_published', true)
  .order('display_order', { ascending: true });

const saved     = Astro.url.searchParams.get('saved') === '1';
const errorMsg  = Astro.url.searchParams.get('error') ?? '';
const codeShown = Astro.url.searchParams.get('code') ?? '';

// On transforme en liste exploitable : pour chaque formation, on garde la prochaine session.
interface TrainingOption {
  id:               string;
  title:            string;
  priceLabel:       string;
  nextSessionId:    string | null;
  nextSessionLabel: string | null;
  isPaying:         boolean;
}

function nextSessionLabel(startsAt: string): string {
  return new Date(startsAt).toLocaleDateString('fr-FR', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}

const trainingOptions: TrainingOption[] = (trainings ?? [])
  .map((t): TrainingOption => {
    const sessions = (t.training_sessions ?? []) as Array<{ id: string; starts_at: string; is_published: boolean }>;
    const now = new Date().toISOString();
    const next = sessions
      .filter((s) => s.is_published && s.starts_at > now)
      .sort((a, b) => a.starts_at.localeCompare(b.starts_at))[0];
    const isFree = isFreeTraining(t.min_price_cents, t.suggested_price_cents, t.solidarity_price_cents);
    return {
      id:               t.id,
      title:            t.title,
      priceLabel:       isFree
        ? 'Formation gratuite'
        : formatSlidingScale(t.min_price_cents, t.suggested_price_cents, t.solidarity_price_cents),
      nextSessionId:    next?.id ?? null,
      nextSessionLabel: next ? nextSessionLabel(next.starts_at) : null,
      isPaying:         t.is_paying,
    };
  })
  .filter((t) => t.isPaying); // on ne peut parrainer que les formations payantes
---

<Layout
  title="Parrainer une place | Formations | Biscuits IA"
  description="Offrez une place a quelqu''un qui ne pourrait pas se la payer. Tarif conscient, systeme de parrainage, acces pour tous."
>
  <Breadcrumb />

  <section class="parrain-hero">
    <div class="container">
      <h1>Parrainer une place</h1>
      <p class="lead">
        Offrez une place de formation a quelqu''un qui ne pourrait pas se la payer.
        Vous choisissez le montant, et la place est mise a disposition selon le mode que vous preferez.
      </p>
    </div>
  </section>

  <section class="parrain-body">
    <div class="container">
      {saved && codeShown && (
        <div class="alert alert-success" role="alert">
          <strong>Parrainage enregistre.</strong> Voici votre code de redemption :{' '}
          <code class="code-block">{codeShown}</code>
          <br />
          Transmettez-le au beneficiaire : il pourra l''utiliser lors de son inscription pour consommer la place.
        </div>
      )}

      {saved && !codeShown && (
        <div class="alert alert-success" role="alert">
          Votre parrainage a bien ete pris en compte. Vous recevrez le code de redemption par email.
        </div>
      )}

      {errorMsg && (
        <div class="alert alert-error" role="alert">
          {decodeURIComponent(errorMsg)}
        </div>
      )}

      {trainingOptions.length === 0 ? (
        <p class="empty-note">Aucune formation payante n''est ouverte au parrainage pour le moment.</p>
      ) : (
        <form method="POST" action="/api/formations/sponsoriser" class="parrain-form">
          <fieldset class="form-block">
            <legend>1. Choisir une formation</legend>
            <div class="training-picker">
              {trainingOptions.map((t) => (
                <label class="training-pick">
                  <input
                    type="radio"
                    name="target_choice"
                    value={`${t.id}|${t.nextSessionId ?? ''}`}
                    required
                  />
                  <span class="pick-main">
                    <span class="pick-title">{t.title}</span>
                    <span class="pick-price">{t.priceLabel}</span>
                    {t.nextSessionLabel && (
                      <span class="pick-next">Prochaine : {t.nextSessionLabel}</span>
                    )}
                  </span>
                </label>
              ))}
            </div>
            <input type="hidden" name="training_id" value="" />
            <input type="hidden" name="session_id"  value="" />
          </fieldset>

          <fieldset class="form-block">
            <legend>2. Mode de parrainage</legend>
            <label class="mode-radio">
              <input type="radio" name="mode" value="pool" checked />
              <span>
                <strong>Place libre (pool)</strong><br />
                La place sera disponible pour le premier beneficiaire eligible qui en fera la demande.
              </span>
            </label>
            <label class="mode-radio">
              <input type="radio" name="mode" value="nominative" />
              <span>
                <strong>Place nominative</strong><br />
                Vous reservez la place pour une personne en particulier (par email).
              </span>
            </label>
            <label class="field" id="beneficiary-field" style="display: none;">
              <span>Email du beneficiaire :</span>
              <input type="email" name="beneficiary_email" placeholder="beneficiaire@exemple.fr" />
            </label>
          </fieldset>

          <fieldset class="form-block">
            <legend>3. Vos informations</legend>
            <div class="field-grid">
              <label class="field">
                <span>Votre nom :</span>
                <input type="text" name="sponsor_name" required maxlength="120" />
              </label>
              <label class="field">
                <span>Votre email :</span>
                <input type="email" name="sponsor_email" required maxlength="255" />
              </label>
            </div>
            <label class="field">
              <span>Message pour le beneficiaire (optionnel) :</span>
              <textarea name="message" rows="3" maxlength="300" placeholder="Ex : Bonne formation !"></textarea>
            </label>
          </fieldset>

          <fieldset class="form-block">
            <legend>4. Montant et paiement</legend>
            <label class="field">
              <span>Montant de votre don (en EUR) :</span>
              <input type="number" name="amount_eur" min="5" step="1" required placeholder="Ex : 50" />
              <input type="hidden" name="amount_cents" value="0" />
            </label>

            <p class="form-hint">Choisissez votre mode de paiement :</p>
            <label class="payment-radio">
              <input type="radio" name="payment_method" value="helloasso" checked />
              <span>HelloAsso (paiement en ligne, sans frais)</span>
            </label>
            <label class="payment-radio">
              <input type="radio" name="payment_method" value="transfer" />
              <span>Virement bancaire (RIB transmis apres validation)</span>
            </label>
          </fieldset>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Valider le parrainage</button>
            <a href="/formations" class="btn btn-ghost">Annuler</a>
          </div>
        </form>
      )}
    </div>
  </section>
</Layout>

<script is:inline nonce={Astro.locals.nonce}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('form');
    if (!form) return;
    const trainingIdInput  = form.querySelector('input[name="training_id"]');
    const sessionIdInput   = form.querySelector('input[name="session_id"]');
    const trainingRadios   = form.querySelectorAll('input[name="target_choice"]');
    const modeRadios       = form.querySelectorAll('input[name="mode"]');
    const beneficiaryField = form.querySelector('#beneficiary-field');
    const beneficiaryInput = form.querySelector('input[name="beneficiary_email"]');
    const amountEur        = form.querySelector('input[name="amount_eur"]');
    const amountCents      = form.querySelector('input[name="amount_cents"]');

    function syncTarget() {
      const checked = Array.from(trainingRadios).find((r) => r.checked);
      if (!checked) return;
      const [tid, sid] = checked.value.split('|');
      if (trainingIdInput) trainingIdInput.value = tid;
      if (sessionIdInput)  sessionIdInput.value  = sid;
    }
    function syncMode() {
      const checked = Array.from(modeRadios).find((r) => r.checked);
      if (!beneficiaryField) return;
      if (checked && checked.value === 'nominative') {
        beneficiaryField.style.display = '';
        if (beneficiaryInput) beneficiaryInput.required = true;
      } else {
        beneficiaryField.style.display = 'none';
        if (beneficiaryInput) {
          beneficiaryInput.required = false;
          beneficiaryInput.value = '';
        }
      }
    }
    function syncAmount() {
      if (!amountEur || !amountCents) return;
      const eur = Number(amountEur.value);
      amountCents.value = Number.isFinite(eur) && eur > 0 ? String(Math.round(eur * 100)) : '0';
    }

    trainingRadios.forEach((r) => r.addEventListener('change', syncTarget));
    modeRadios.forEach((r) => r.addEventListener('change', syncMode));
    amountEur?.addEventListener('input', syncAmount);

    syncTarget();
    syncMode();
  });
</script>

<style>
  .parrain-hero {
    padding: 50px 0 30px;
    background: var(--color-bg-alt);
    border-bottom: 4px solid var(--color-border);
  }
  .parrain-hero h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 8px; color: var(--color-text); }
  .lead { font-size: 1.1rem; max-width: 720px; color: var(--color-text-light); }

  .parrain-body { padding: 40px 0; }
  .container { max-width: 880px; margin: 0 auto; padding: 0 24px; }

  .alert { padding: 14px 18px; margin-bottom: 20px; border: var(--brutal-border-thin); }
  .alert-success { background: var(--color-success-light); }
  .alert-error   { background: var(--color-danger-light);  }
  .code-block {
    display: inline-block; padding: 4px 10px; margin: 6px 0;
    background: var(--color-bg-alt); border: 2px solid var(--color-border);
    font-family: var(--font-mono); font-weight: 700;
  }
  .empty-note { padding: 24px; border: var(--brutal-border-thin); border-style: dashed; color: var(--color-text-light); }

  .parrain-form { display: flex; flex-direction: column; gap: 24px; }
  .form-block {
    padding: 20px; border: var(--brutal-border); background: var(--color-bg-alt);
    box-shadow: var(--shadow-sm);
  }
  .form-block legend { font-weight: 800; font-size: 1.05rem; padding: 0 8px; color: var(--color-text); }
  .form-hint { font-size: 0.9rem; color: var(--color-text-light); margin: 8px 0 12px; }

  .training-picker { display: flex; flex-direction: column; gap: 8px; }
  .training-pick {
    display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px;
    border: var(--brutal-border); cursor: pointer; background: var(--color-bg);
  }
  .training-pick:hover { background: var(--color-accent-vanilla); }
  .pick-main { display: flex; flex-direction: column; gap: 4px; }
  .pick-title { font-weight: 700; color: var(--color-text); }
  .pick-price { font-size: 0.85rem; color: var(--color-text-light); }
  .pick-next  { font-size: 0.85rem; color: var(--color-text-light); }

  .mode-radio, .payment-radio {
    display: flex; align-items: center; gap: 10px; padding: 12px 14px;
    border: var(--brutal-border-thin); cursor: pointer; margin-bottom: 8px;
    background: var(--color-bg);
  }
  .mode-radio:hover, .payment-radio:hover { background: var(--color-accent-vanilla); }
  .mode-radio span { line-height: 1.4; }

  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .field { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }
  .field span { font-size: 0.9rem; font-weight: 600; color: var(--color-text); }
  .field input, .field textarea {
    padding: 10px 14px; font-size: 1rem; font-family: inherit;
  }

  .form-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { padding: 12px 24px; font-weight: 700; text-decoration: none; display: inline-block; border: var(--brutal-border); cursor: pointer; }
  .btn-primary { background: var(--color-primary); color: white; box-shadow: var(--shadow-md); }
  .btn-primary:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-lg); }
  .btn-ghost { background: var(--color-bg-alt); color: var(--color-text); }

  @media (max-width: 600px) {
    .field-grid { grid-template-columns: 1fr; }
  }
</style>