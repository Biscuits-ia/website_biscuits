---
import BaseLayout from '@layouts/Layout.astro';

export const prerender = true;
export const csr = false;
---

<BaseLayout
  title="Guides & Ressources | Biscuits IA"
  description="Guides, tutoriels et ressources pour aider les associations et TPE/PME à intégrer l'IA dans leurs projets."
>
  <section class="hero-resources">
    <div class="container">
      <div class="hero-content">
        <h1 class="visually-hidden">Guides et Ressources IA</h1>
        <p class="hero-subtitle">
          Accédez à des guides pratiques et documents pour vous aider à intégrer l'IA dans vos projets, à votre rythme.
        </p>
        <div class="search-bar" role="search">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 17A8 8 0 1 0 9 1a8 8 0 0 0 0 16zM19 19l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <input 
            type="search" 
            placeholder="Rechercher une ressource..." 
            aria-label="Rechercher une ressource"
            autocomplete="off"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="resources-section" aria-labelledby="guides-title">
    <div class="container">
      <header class="section-header">
        <h2 id="guides-title">Nos Guides Essentiels</h2>
        <p>Téléchargez gratuitement nos ressources pour démarrer avec l'IA</p>
      </header>
      
      <div class="resources-grid">
        <article class="resource-card type-guide">
          <div class="card-badge" aria-label="Type: Guide PDF">Guide PDF</div>
          <div class="card-icon" aria-hidden="true">
            <span class="icon-wrapper">📚</span>
          </div>
          
          <div class="card-content">
            <h3>Guide IA pour Associations</h3>
            <p>Comprendre les usages, bonnes pratiques et outils accessibles pour vos projets associatifs.</p>
            
            <dl class="resource-meta">
              <div class="meta-item">
                <dt class="visually-hidden">Nombre de pages</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <dd>42 pages</dd>
              </div>
              <div class="meta-item">
                <dt class="visually-hidden">Temps de lecture</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M8 14A6 6 0 1 0 8 2a6 6 0 0 0 0 12z" stroke="currentColor" stroke-width="2"/>
                  <path d="M8 4v4l2 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <dd>30 min lecture</dd>
              </div>
              <div class="meta-item">
                <dt class="visually-hidden">Nombre de téléchargements</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M14 10v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2M4 6l4-4 4 4M8 2v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <dd>2.3k téléchargements</dd>
              </div>
            </dl>

            <ul class="content-list">
              <li>Introduction à l'IA pour associations</li>
              <li>Cas d'usage concrets et templates</li>
              <li>Sélection d'outils gratuits</li>
              <li>Checklist de mise en œuvre</li>
            </ul>
          </div>

          <div class="card-footer">
            <a href="#download-guide-associations" class="btn-download" aria-label="Télécharger le guide IA pour associations (format PDF)">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M17.5 12.5v3.333a1.667 1.667 0 0 1-1.667 1.667H4.167A1.667 1.667 0 0 1 2.5 15.833V12.5M5.833 8.333L10 12.5l4.167-4.167M10 12.5V2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Télécharger (PDF)</span>
            </a>
          </div>
        </article>

        <article class="resource-card type-toolkit">
          <div class="card-badge" aria-label="Type: Toolkit">Toolkit</div>
          <div class="card-icon" aria-hidden="true">
            <span class="icon-wrapper">⚙️</span>
          </div>
          
          <div class="card-content">
            <h3>Workflow & Automatisation</h3>
            <p>Centralisez vos tâches et automatisez les processus répétitifs avec des outils IA.</p>
            
            <dl class="resource-meta">
              <div class="meta-item">
                <dt class="visually-hidden">Nombre de templates</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <dd>15 templates</dd>
              </div>
              <div class="meta-item">
                <dt class="visually-hidden">Temps de configuration</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M8 14A6 6 0 1 0 8 2a6 6 0 0 0 0 12z" stroke="currentColor" stroke-width="2"/>
                  <path d="M8 4v4l2 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <dd>1h configuration</dd>
              </div>
              <div class="meta-item">
                <dt class="visually-hidden">Nombre de téléchargements</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M14 10v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2M4 6l4-4 4 4M8 2v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <dd>1.8k téléchargements</dd>
              </div>
            </dl>

            <ul class="content-list">
              <li>Templates d'automatisation prêts à l'emploi</li>
              <li>Guides pas-à-pas illustrés</li>
              <li>Intégrations avec outils populaires</li>
              <li>Exemples de workflows optimisés</li>
            </ul>
          </div>

          <div class="card-footer">
            <a href="#download-workflow" class="btn-download" aria-label="Télécharger le toolkit workflow et automatisation (format ZIP)">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M17.5 12.5v3.333a1.667 1.667 0 0 1-1.667 1.667H4.167A1.667 1.667 0 0 1 2.5 15.833V12.5M5.833 8.333L10 12.5l4.167-4.167M10 12.5V2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Télécharger (ZIP)</span>
            </a>
          </div>
        </article>

        <article class="resource-card type-code">
          <div class="card-badge" aria-label="Type: Open Source">Open Source</div>
          <div class="card-icon" aria-hidden="true">
            <span class="icon-wrapper">💻</span>
          </div>
          
          <div class="card-content">
            <h3>Ressources Open-Source</h3>
            <p>Starter kits, modèles et outils prêts à l'emploi pour votre association ou TPE/PME.</p>
            
            <dl class="resource-meta">
              <div class="meta-item">
                <dt class="visually-hidden">Nombre de projets</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <dd>8 projets</dd>
              </div>
              <div class="meta-item">
                <dt class="visually-hidden">Temps d'installation</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M8 14A6 6 0 1 0 8 2a6 6 0 0 0 0 12z" stroke="currentColor" stroke-width="2"/>
                  <path d="M8 4v4l2 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <dd>2h installation</dd>
              </div>
              <div class="meta-item">
                <dt class="visually-hidden">Nombre de clones</dt>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                  <path d="M14 10v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2M4 6l4-4 4 4M8 2v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <dd>3.1k clones</dd>
              </div>
            </dl>

            <ul class="content-list">
              <li>Code source commenté et documenté</li>
              <li>Déploiement simplifié en un clic</li>
              <li>Licence MIT - modification libre</li>
              <li>Communauté active de contributeurs</li>
            </ul>
          </div>

          <div class="card-footer">
            <a href="#github" class="btn-download" aria-label="Voir les ressources open-source sur GitHub" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M10 1.667v11.666M6.667 9.167L10 12.5l3.333-3.333M3.333 18.333h13.334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Voir sur GitHub</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="categories-section" aria-labelledby="categories-title">
    <div class="container">
      <h2 id="categories-title">Explorer par catégorie</h2>
      <nav class="categories-grid" aria-label="Catégories de ressources">
        <a href="#demarrage-rapide" class="category-card">
          <div class="category-icon" aria-hidden="true">🎯</div>
          <h3>Démarrage rapide</h3>
          <p>12 ressources</p>
        </a>
        <a href="#outils-templates" class="category-card">
          <div class="category-icon" aria-hidden="true">🛠️</div>
          <h3>Outils & Templates</h3>
          <p>24 ressources</p>
        </a>
        <a href="#tutoriels-video" class="category-card">
          <div class="category-icon" aria-hidden="true">📖</div>
          <h3>Tutoriels vidéo</h3>
          <p>18 ressources</p>
        </a>
        <a href="#formation-avancee" class="category-card">
          <div class="category-icon" aria-hidden="true">🎓</div>
          <h3>Formation avancée</h3>
          <p>8 ressources</p>
        </a>
      </nav>
    </div>
  </section>

  <section class="newsletter-section" aria-labelledby="newsletter-title">
    <div class="container">
      <div class="newsletter-content">
        <div class="newsletter-text">
          <h2 id="newsletter-title">Recevez nos nouvelles ressources</h2>
          <p>Abonnez-vous pour être notifié des nouveaux guides, templates et outils IA.</p>
        </div>
        <form class="newsletter-form" aria-label="Formulaire d'inscription à la newsletter">
          <label for="newsletter-email" class="visually-hidden">Adresse e-mail</label>
          <input 
            type="email" 
            id="newsletter-email" 
            name="email" 
            placeholder="Votre email" 
            required 
            autocomplete="email"
            aria-required="true"
          />
          <button type="submit">S'abonner</button>
        </form>
      </div>
    </div>
  </section>

  <section class="cta-modern" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-content">
        <h2 id="cta-title">Commencez dès maintenant</h2>
        <p>Téléchargez nos guides et mettez l'IA au service de votre association ou entreprise.</p>
        <div class="cta-buttons">
          <a href="/register" class="btn-primary">
            <span>Accéder aux ressources</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Classe utilitaire pour l'accessibilité */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-resources {
    padding: 70px 0 50px;
    background: var(--color-primary);
    position: relative;
    overflow: hidden;
  }

  .hero-resources::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.4;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    color: var(--color-gray-900);
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.6;
    opacity: 0.95;
    max-width: 600px;
    color: var(--color-gray-900);
    margin-inline: auto;
  }

  .search-bar {
    max-width: 500px;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border: 5px solid var(--color-border);
    padding: 4px 8px 4px 20px;
  }

  .search-bar svg {
    flex-shrink: 0;
    color: var(--color-gray-100);
  }

  .search-bar input {
    flex: 1;
    min-width: 0;
    margin-left: 10px;
    outline: none;
    border: none;
    box-shadow: none;
    padding: 12px 16px;
    font-size: 1rem;
    color: var(--color-gray-100);
    background: transparent;
  }

  .search-bar input::placeholder {
    color: var(--color-text);
  }

  .resources-section {
    padding: 80px 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
  }

  .section-header p {
    font-size: 1.1rem;
    color: var(--color-gray-100);
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 32px;
  }

  .resource-card {
    background: var(--color-secondary);
    padding: 32px;
    box-shadow: 0 4px 6px rgb(0 0 0 / 0.05);
    transition: box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 2px solid transparent;
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
  }

  .resource-card:hover,
  .resource-card:focus-within {
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.1);
    transform: translateY(-2px);
  }

  .card-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 4px 12px;
    background: var(--color-accent-honey);
    color: var(--color-gray-200);
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .type-toolkit .card-badge,
  .type-code .card-badge {
    background: var(--color-accent-honey);
    color: var(--color-gray-200);
  }

  .card-icon .icon-wrapper {
    width: 72px;
    height: 72px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    background: var(--color-primary);
    border-radius: 10%;
  }

  .type-toolkit .icon-wrapper,
  .type-code .icon-wrapper {
    background: var(--color-primary);
    border: 3px solid var(--color-border-second);
    border-radius: 10%;
  }

  .card-content h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--color-gray-900);
  }

  .card-content p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-gray-900);
    margin-bottom: 20px;
  }

  .resource-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px 0;
    border-block: 1px solid;
    margin-bottom: 20px;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--color-gray-900);
  }

  .meta-item dt {
    display: contents;
  }

  .meta-item dd {
    margin: 0;
  }

  .meta-item svg {
    stroke: var(--color-gray-900);
    flex-shrink: 0;
  }

  .content-list {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-gray-100);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .content-list li {
    padding-left: 24px;
    position: relative;
    margin-bottom: 0.3rem;
    font-size: 0.9rem;
    color: var(--color-gray-900);
    line-height: 1.5;
  }

  .content-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-gray-100);
    font-weight: 700;
  }

  .card-footer {
    margin-top: auto;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 24px;
    background: var(--color-primary-dark);
    color: var(--color-gray-800);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
  }

  .btn-download:hover,
  .btn-download:focus {
    background-color: var(--color-accent-honey);
    color: var(--color-gray-200);
    transform: translateY(-1px);
  }

  .btn-download:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .btn-download:active {
    transform: translateY(0);
  }

  .categories-section {
    padding: 80px 0;
    background: var(--color-bg);
  }

  .categories-section h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 48px;
    color: var(--color-gray-200);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 24px;
  }

  .category-card {
    background: var(--color-accent-honey);
    padding: 32px 24px;
    text-align: center;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.3s ease;
    border: 2px solid transparent;
  }

  .category-card:hover,
  .category-card:focus {
    background: var(--color-secondary-hover);
    transform: translateY(-4px);
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .category-icon {
    font-size: 48px;
    margin-bottom: 16px;
  }

  .category-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--color-gray-100);
  }

  .category-card p {
    font-size: 0.9rem;
    color: var(--color-gray-100);
    margin: 0;
  }

  .newsletter-section {
    padding: 80px 0;
    background: var(--color-secondary);
    color: var(--color-text);
  }

  .newsletter-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-text h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: 12px;
  }

  .newsletter-text p {
    font-size: 1.1rem;
    color: var(--color-gray-900);
    opacity: 0.9;
    margin-bottom: 32px;
  }

  .newsletter-form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .newsletter-form input {
    flex: 1;
    min-width: 0;
    padding: 14px 20px;
    border: none;
    font-size: 1rem;
    outline: none;
  }

  .newsletter-form input:focus {
    outline: 2px solid var(--color-bg);
    outline-offset: 2px;
  }

  .newsletter-form button {
    padding: 14px 28px;
    background: var(--color-bg);
    color: var(--color-gray-200);
    border: none;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    white-space: nowrap;
  }

  .newsletter-form button:hover,
  .newsletter-form button:focus {
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.2);
  }

  .newsletter-form button:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .cta-modern {
    padding: 80px 0;
    color: var(--color-gray-100);
  }

  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 16px;
  }

  .cta-content p {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 40px;
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    padding: 16px 32px;
    border-radius: 0;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-text);
    box-shadow: 0 8px 16px var(--color-text);
  }

  .btn-primary:hover,
  .btn-primary:focus {
    transform: translateY(-2px);
  }

  .btn-primary:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .btn-secondary {
    background: var(--color-secondary);
    color: var(--color-text);
  }

  .btn-secondary:hover,
  .btn-secondary:focus {
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.5);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Amélioration des focus pour l'accessibilité clavier */
  *:focus-visible {
