---
export const prerender = true;

import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { BLOG_CLUSTERS, type BlogCluster } from '@/lib/blogClusters';

export const getStaticPaths = (() =>
  BLOG_CLUSTERS.map((cluster) => ({
    params: { slug: cluster.slug },
    props: { cluster },
  }))) satisfies GetStaticPaths;

interface Props {
  cluster: BlogCluster;
}

const { cluster } = Astro.props;
const allArticles = await getCollection('blog');
const visibleArticles = import.meta.env.PROD
  ? allArticles.filter((article) => !article.data.draft)
  : allArticles;
const articleById = new Map(visibleArticles.map((article) => [article.id, article]));
const articles = cluster.articleIds
  .map((id) => articleById.get(id))
  .filter((article): article is CollectionEntry<'blog'> => Boolean(article));

const canonical = `/guides/${cluster.slug}`;
const updatedDate = new Date('2026-08-05T00:00:00Z');
---

<Layout
  title={`${cluster.title} | Biscuits IA`}
  description={cluster.description}
  canonical={canonical}
  schema={{
    type: 'WebPage',
    data: {
      name: cluster.title,
      description: cluster.description,
      dateModified: updatedDate.toISOString(),
    },
  }}
>
  <Breadcrumb labels={{ guides: 'Guides', [cluster.slug]: cluster.shortTitle }} />

  <div class="guide-page">
    <header class="guide-hero">
      <span class="guide-eyebrow">{cluster.eyebrow}</span>
      <h1>{cluster.title}</h1>
      <p class="guide-lead">{cluster.introduction}</p>
      <dl class="guide-meta">
        <div>
          <dt>Pour qui ?</dt>
          <dd>{cluster.audience}</dd>
        </div>
        <div>
          <dt>Parcours</dt>
          <dd>{articles.length} guides pratiques</dd>
        </div>
        <div>
          <dt>Dernière vérification</dt>
          <dd><time datetime={updatedDate.toISOString()}>5 août 2026</time></dd>
        </div>
      </dl>
    </header>

    <section class="guide-intro" aria-labelledby="guide-method-title">
      <div>
        <span class="section-kicker">Par où commencer ?</span>
        <h2 id="guide-method-title">Un parcours du général au concret</h2>
      </div>
      <p>
        Commencez par le premier guide pour poser les bases, puis choisissez les procédures adaptées
        à votre situation. Chaque contenu renvoie vers ce dossier et vers les étapes complémentaires
        : vous pouvez donc reprendre le parcours à tout moment sans multiplier les onglets.
      </p>
    </section>

    <section aria-labelledby="guide-articles-title">
      <h2 id="guide-articles-title">Les guides du dossier</h2>
      <ol class="guide-list">
        {
          articles.map((article, index) => (
            <li>
              <article class="guide-card">
                <span class="guide-step" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>
                    <a href={`/blog/${article.id}`}>{article.data.title}</a>
                  </h3>
                  {article.data.description && <p>{article.data.description}</p>}
                  <div class="card-meta">
                    <time datetime={article.data.pubDate.toISOString()}>
                      {article.data.pubDate.toLocaleDateString('fr-FR', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{article.data.author || 'Biscuits IA'}</span>
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sources" aria-labelledby="guide-sources-title">
      <div>
        <span class="section-kicker">Références</span>
        <h2 id="guide-sources-title">Sources de confiance</h2>
        <p>
          Nos guides sont relus à partir de ressources institutionnelles et des documentations
          officielles suivantes. Une source ne remplace pas un conseil juridique ou une assistance
          personnalisée.
        </p>
      </div>
      <ul>
        {
          cluster.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                <strong>{source.name}</strong>
                <span>{source.publisher} ↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <aside class="guide-cta">
      <div>
        <span class="section-kicker">Besoin d'un cas concret ?</span>
        <h2>Parlez-nous de votre structure</h2>
        <p>
          Nous vous aidons à transformer ces recommandations en étapes adaptées à votre contexte.
        </p>
      </div>
      <a href="/contact">Demander un accompagnement</a>
    </aside>
  </div>
</Layout>

<style>
  .guide-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: calc(var(--header-height-desktop) + 2rem) 1rem 5rem;
  }

  .guide-hero {
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl, 1rem);
    background: var(--color-bg-alt);
    box-shadow: var(--shadow-lg, 7px 7px 0 var(--color-border));
  }

  .guide-eyebrow,
  .section-kicker {
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 0.65rem 0 1rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .guide-lead {
    max-width: 820px;
    margin: 0;
    color: var(--color-text-light);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
  }

  .guide-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .guide-meta div {
    min-width: 0;
  }

  dt {
    color: var(--color-text-light);
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  dd {
    margin: 0.25rem 0 0;
    font-weight: 700;
    line-height: 1.4;
  }

  .guide-intro,
  .sources,
  .guide-cta {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    margin: 4rem 0;
  }

  h2 {
    margin: 0.4rem 0 1rem;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  .guide-intro p,
  .sources p,
  .guide-cta p {
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.7;
  }

  .guide-list,
  .sources ul {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .guide-list {
    display: grid;
    gap: 1rem;
  }

  .guide-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.25rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--color-bg-alt);
  }

  .guide-step {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    color: var(--color-bg-alt);
    background: var(--color-primary);
    font-weight: 900;
  }

  .guide-card h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .guide-card h3 a {
    color: var(--color-text);
  }

  .guide-card h3 a:hover {
    color: var(--color-primary);
  }

  .guide-card p {
    margin: 0.55rem 0;
    color: var(--color-text-light);
    line-height: 1.55;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--color-text-light);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .sources {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl, 1rem);
    background: var(--color-bg-alt);
  }

  .sources ul {
    display: grid;
    gap: 0.75rem;
  }

  .sources a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 0.5rem);
    color: var(--color-text);
    background: var(--color-bg);
  }

  .sources a:hover {
    border-color: var(--color-primary);
  }

  .sources span {
    color: var(--color-text-light);
    font-size: 0.82rem;
  }

  .guide-cta {
    align-items: center;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl, 1rem);
    box-shadow: var(--shadow-md, 5px 5px 0 var(--color-border));
  }

  .guide-cta a {
    justify-self: end;
    padding: 0.8rem 1.1rem;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-button, 0.875rem);
    color: var(--color-bg-alt);
    background: var(--color-primary);
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .guide-page {
      padding-top: calc(var(--header-height-mobile) + 1.5rem);
    }

    .guide-meta,
    .guide-intro,
    .sources,
    .guide-cta {
      grid-template-columns: 1fr;
    }

    .guide-cta a {
      justify-self: start;
    }
  }
</style>
