---
// Page d'accueil : hero + features + derniers articles du blog (maillage interne)
export const prerender = true;

import BaseLayout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import AnimatedFeatureGrid from '@/components/AnimatedFeaturesGrid.astro';
import Confidentialite from '@/components/Confidentialite.astro';
import Communaute from '@/components/Communaute.astro';
import AideBenevoleCTA from '@/components/AideBenevoleCTA.astro';
import NewsletterSocial from '@/components/NewsletterSocial.astro';
import LatestArticles from '@/components/LatestArticles.astro';
import { getCollection } from 'astro:content';

const latestArticles = (await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Biscuits IA | Agir pour une Intelligence Artificielle éthique et solidaire"
  description="Association Loi 1901 d'intérêt général. Ateliers IA, accompagnement personnalisé et ressources libres pour associations, collectivités et petites structures."
>

  <Hero />
  <AnimatedFeatureGrid />
  <Confidentialite />
  <Communaute />
  <AideBenevoleCTA />
  <LatestArticles articles={latestArticles} />
  <NewsletterSocial />
</BaseLayout>