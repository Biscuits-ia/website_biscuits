---
// Page d'accueil : hero, 5 piliers, publics, victime, logiciels, anti-pepins, soutien, articles, communaute.
export const prerender = true;

import BaseLayout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import PillarsGrid from '@/components/PillarsGrid.astro';
import PublicsPicker from '@/components/PublicsPicker.astro';
import AntiPepinsShowcase from '@/components/AntiPepinsShowcase.astro';
import SoftwareShowcase from '@/components/SoftwareShowcase.astro';
import LatestArticles from '@/components/LatestArticles.astro';
import SupportCTA from '@/components/SupportCTA.astro';
import Communaute from '@/components/Communaute.astro';
import NewsletterSocial from '@/components/NewsletterSocial.astro';
import { getCollection } from 'astro:content';

const latestArticles = (await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Biscuits IA | IA simple et gratuite pour les associations"
  description="Association Loi 1901. Nous aidons les associations et collectivités à automatiser leurs tâches grâce à des outils IA simples, gratuits et prêts à l'emploi."
  schema={{
    type: 'WebPage',
    data: {
      name: 'Biscuits IA - Association Loi 1901',
      description: 'IA simple et gratuite pour les associations. Automatisez vos tâches administratives avec des outils IA prêts à l\'emploi.',
    },
  }}
>
  <Hero />
  <PillarsGrid
    layout="home"
    title="Quatre piliers, une mission d'interet general"
    intro="Une association Loi 1901 qui agit sur quatre fronts complementaires pour rendre le numerique utile, sur et accessible a tous. Chaque pilier finance et renforce les autres."
  />
  <PublicsPicker />
  <AntiPepinsShowcase />
  <SoftwareShowcase />
  <LatestArticles articles={latestArticles} />
  <SupportCTA />
  <Communaute />
  <NewsletterSocial />
</BaseLayout>
