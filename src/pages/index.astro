---
// Page d'accueil : hero, 4 piliers, publics, victime, logiciels, anti-pepins, soutien, articles, communaute.
export const prerender = true;

import BaseLayout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import PillarsGrid from '@/components/PillarsGrid.astro';
import PublicsPicker from '@/components/PublicsPicker.astro';
import VictimHighlight from '@/components/VictimHighlight.astro';
import AntiPepinsShowcase from '@/components/AntiPepinsShowcase.astro';
import SoftwareShowcase from '@/components/SoftwareShowcase.astro';
import LatestArticles from '@/components/LatestArticles.astro';
import SupportCTA from '@/components/SupportCTA.astro';
import Communaute from '@/components/Communaute.astro';
import NewsletterSocial from '@/components/NewsletterSocial.astro';
import { getCollection } from 'astro:content';

const latestArticles = (await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Biscuits IA | IA accessible, cybercriminalite combattue, logiciels libres et Anti Pepins"
  description="Association Loi 1901. Quatre piliers : accompagnement a l'IA, lutte contre la cybercriminalite et aide aux victimes, logiciels pour associations partenaires, et le service public Anti Pepins."
  schema={{
    type: 'WebPage',
    data: {
      name: 'Biscuits IA - Association Loi 1901',
      description: 'Quatre piliers, une mission d\'interet general : IA accessible, lutte contre la cybercriminalite, logiciels libres pour associations, Anti Pepins.',
    },
  }}
>
  <Hero />
  <PillarsGrid
    layout="home"
    title="Quatre piliers, une mission d'interet general"
    intro="Une association Loi 1901 qui agit sur quatre fronts complementaires pour rendre le numerique utile, sur et accessible a tous. Chaque pilier finance et renforce les autres."
  />
  <PublicsPicker />
  <VictimHighlight />
  <AntiPepinsShowcase />
  <SoftwareShowcase />
  <LatestArticles articles={latestArticles} />
  <SupportCTA />
  <Communaute />
  <NewsletterSocial />
</BaseLayout>
