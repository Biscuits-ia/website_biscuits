---
import BaseLayout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import HorizontalScrollSection from '@/components/HorizontalScrollSection.astro';
import AnimatedFeatureGrid from '@/components/AnimatedFeaturesGrid.astro';
import AnimatedProcessTimeline from '@/components/AnimatedProcessTimeline.astro';

const structuredData = {
"@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Biscuits AI",
  "description": "Solutions IA et Automatisation.",
  "url": "https://biscuits.dev/",
  "publisher": {
    "@type": "Organization",
    "name": "Biscuits AI",
    "url": "https://biscuits.dev",
    "logo": "https://biscuits.dev/logo.webp"
  }
};
---

<BaseLayout
  title="Starterkits, Outils IA et Automatisations pour Vibe coder"
  description="outils IA, starterkits optimisés, prompts et automatisations pour développeurs et vibe coders. Crée plus vite avec des bases propres."
  structuredData={structuredData}
>
  <Hero />
  <HorizontalScrollSection />
  <AnimatedFeatureGrid />
  <AnimatedProcessTimeline />  
</BaseLayout>

<script>
  
  import Lenis from '@studio-freight/lenis';

  const lenis = new Lenis({
    duration: 1.2,
    easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
  });

  function raf(time: number) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);
</script>