---
// src/pages/logiciels.astro
// Catalogue de logiciels libres pour associations partenaires. Pilier 2.

export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const schema = {
  type: 'WebPage' as const,
  data: {
    name: 'Catalogue logiciels - Biscuits IA',
    description: 'Decouvrez nos logiciels libres concus pour les associations : Anti Pepins, suite associative, outils de signalement. Tarification preferentielle pour structures d\'interet general.',
  },
};
---

<Layout
  title="Logiciels pour associations | Biscuits IA"
  description="Catalogue de logiciels libres concus par Biscuits IA pour les associations : Anti Pepins, suite associative, outils de signalement. Tarifs preferentiels pour structures d'interet general."
  schema={schema}
>
  <Breadcrumb />

  <section class="cat-hero">
    <div class="container">
      <p class="eyebrow">Pilier 2 - Logiciels pour associations</p>
      <h1>Des logiciels libres pour les associations engagees</h1>
      <p class="lead">
        Nous concevons des logiciels libres a destination d'autres associations partageant nos combats : lutte contre les arnaques, mediation numerique, accompagnement de publics vulnerables. Les benefices financent nos piliers 1 et 2 (accompagnement IA et sensibilisation).
      </p>
    </div>
  </section>

  <section class="why">
    <div class="container">
      <h2>Pourquoi du libre ?</h2>
      <div class="why-grid">
        <article class="why-card">
          <h3>Souverainete</h3>
          <p>Vos donnees restent votre propriete. Vous pouvez migrer, heberger ailleurs, ou forker si notre mission evolue.</p>
        </article>
        <article class="why-card">
          <h3>Auditabilite</h3>
          <p>Le code source est public. Chaque association peut verifier ce que fait reellement l'outil avant de l'adopter.</p>
        </article>
        <article class="why-card">
          <h3>Tarifs associatifs</h3>
          <p>Tarification prefentielle pour les associations et collectivites. Pas de licence par utilisateur qui explose avec votre croissance.</p>
        </article>
        <article class="why-card">
          <h3>Maintenance incluse</h3>
          <p>On garde les outils a jour, on corrige les failles, on vous previent en cas d'incident. Vous n'etes pas seuls face a la dette technique.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="catalogue">
    <div class="container">
      <h2>Notre catalogue</h2>
      <p class="catalogue-intro">Tous les logiciels ci-dessous sont libres (code public), hebergeables sur votre infrastructure, et maintenu par notre equipe. Demandez-nous un devis adapte a votre structure.</p>

      <div class="product-grid">
        <article class="product-card available">
          <header class="product-head">
            <span class="product-status status-live">Disponible</span>
            <h3>Anti Pepins</h3>
            <p class="product-tag">Service public gratuit + Marque blanche associative</p>
          </header>
          <p class="product-desc">
            Service d'analyse de messages suspects (SMS, mails, liens). Base de signaux mise a jour par la communaute. Accessible gratuitement a tous, integrable en marque blanche pour les associations qui veulent l'embarquer sur leur propre site.
          </p>
          <ul class="product-feats">
            <li>Detection basee sur une base de donnees de signaux</li>
            <li>Mises a jour quotidiennes par l'equipe Biscuits IA</li>
            <li>Deploiement marque blanche (votre domaine, vos couleurs)</li>
            <li>API REST pour integration dans vos outils</li>
          </ul>
          <div class="product-price">
            <strong>Marque blanche :</strong> 1 500 € / an (associations : 500 € / an)
          </div>
          <div class="product-actions">
            <a href="/anti-pepins" class="btn-primary">Voir le service</a>
            <a href="/contact?sujet=devis-logiciel" class="btn-ghost">Devis marque blanche</a>
          </div>
        </article>

        <article class="product-card soon">
          <header class="product-head">
            <span class="product-status status-soon">Beta 2026</span>
            <h3>Suite associative</h3>
            <p class="product-tag">Gestion de benevolat + beneficiaires + rendez-vous</p>
          </header>
          <p class="product-desc">
            Outil modulaire pour les associations : suivi des beneficiaires, gestion du benevolat (plages de disponibilite, competences), prise de rendez-vous integree, base documentaire partagee. Chaque module est activable independamment.
          </p>
          <ul class="product-feats">
            <li>Modules independants : benevolat / beneficiaires / RDV / docs</li>
            <li>Code libre (AGPLv3) ou hebergement gere</li>
            <li>Export RGPD-ready (CSV, JSON)</li>
            <li>Interface accessible (WCAG 2.1 AA)</li>
          </ul>
          <div class="product-price">
            <strong>Hebergement gere :</strong> sur devis (a partir de 50 €/mois pour une petite asso)
          </div>
          <div class="product-actions">
            <a href="/contact?sujet=suite-associative" class="btn-primary">Rejoindre la beta</a>
            <a href="/contact?sujet=devis-logiciel" class="btn-ghost">Devis hebergement</a>
          </div>
        </article>

        <article class="product-card soon">
          <header class="product-head">
            <span class="product-status status-soon">Roadmap 2026</span>
            <h3>Outil de signalement PHAROS</h3>
            <p class="product-tag">Centralisation de signalements pour associations specialisees</p>
          </header>
          <p class="product-desc">
            Plateforme dediee aux associations specialisees dans la lutte contre la cybercriminalite : centralisation multi-utilisateurs, generation de dossiers prets a envoyer a PHAROS / 3018 / pre-plainte, agregation statistique publique pour les rapports annuels.
          </p>
          <ul class="product-feats">
            <li>Multi-utilisateurs avec gestion des roles</li>
            <li>Generation automatique de dossiers de signalement</li>
            <li>Annexe RGPD : separation donnees / metadonnees</li>
            <li>Tableau de bord public pour les rapports</li>
          </ul>
          <div class="product-price">
            <strong>Licence annuelle :</strong> 800 € (associations specialisees : 200 €)
          </div>
          <div class="product-actions">
            <a href="/contact?sujet=signalement-pro" class="btn-primary">Devis licence</a>
            <a href="/contact?sujet=signalement-pro" class="btn-ghost">Programme beta</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="devis">
    <div class="container">
      <div class="devis-card">
        <h2>Un besoin specifique ?</h2>
        <p>
          Vous avez un besoin logiciel que nos produits ne couvrent pas encore ? Decrivez-le nous. On evalue la faisabilite en 1 a 2 semaines, on vous propose un chiffrage transparent, et on lance le developpement en mode agile (livraisons toutes les 2 semaines).
        </p>
        <p>
          Tarification basee sur le temps reel de developpement, pas de packages gonfles. Les associations d'interet general beneficient d'un tarif prefentiel (-30 a -50 %).
        </p>
        <a href="/contact?sujet=devis-logiciel" class="btn-primary">Demander un devis logiciel</a>
      </div>
    </div>
  </section>

  <section class="engagement">
    <div class="container">
      <h2>Notre engagement</h2>
      <ul>
        <li><strong>Code ouvert.</strong> Tout ce qu'on developpe est publie sous licence libre (AGPLv3 ou MIT selon les cas).</li>
        <li><strong>Documentation incluse.</strong> Pas de "RTFM" : on documente pour des humains, pas pour des machines.</li>
        <li><strong>Pas de lock-in.</strong> Si vous voulez quitter, on vous aide a migrer vos donnees. On prefere perdre un client que de le retenir prisonnier.</li>
        <li><strong>Support humain.</strong> Un email, une reponse d'une personne, pas d'un bot.</li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .cat-hero {
    padding: 5rem 1.5rem 3rem;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    text-align: center;
  }

  .cat-hero .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary-dark);
    margin-bottom: 0.75rem;
  }

  .cat-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .lead {
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }

  .why {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .why .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .why h2 {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0 0 2rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1.25rem;
  }

  .why-card {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
  }

  .why-card h3 {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--color-primary-dark);
  }

  .why-card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }

  .catalogue {
    padding: 4rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .catalogue .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .catalogue h2 {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .catalogue-intro {
    text-align: center;
    color: var(--color-text-light);
    max-width: 720px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 1.5rem;
  }

  .product-card {
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }

  .product-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-border);
  }

  .product-status {
    display: inline-block;
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-live {
    background: var(--color-success);
    color: var(--color-text);
  }

  .status-soon {
    background: var(--color-warning);
    color: var(--color-text);
  }

  .product-card h3 {
    font-size: 1.4rem;
    font-weight: 900;
    margin: 0;
    color: var(--color-text);
  }

  .product-tag {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .product-desc {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }

  .product-feats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .product-feats li {
    padding-left: 1.1rem;
    position: relative;
    color: var(--color-text);
    line-height: 1.45;
  }

  .product-feats li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--color-success);
    font-weight: 700;
  }

  .product-price {
    background: var(--color-bg);
    border: 2px dashed var(--color-border);
    padding: 0.85rem 1rem;
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .product-price strong {
    color: var(--color-primary-dark);
  }

  .product-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    background: var(--color-primary);
    color: var(--color-bg-elevated);
    font-weight: 800;
    border: 2px solid var(--color-border);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .btn-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
    color: var(--color-bg-elevated);
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    background: transparent;
    color: var(--color-text);
    font-weight: 700;
    border: 2px solid var(--color-border);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .btn-ghost:hover {
    background: var(--color-bg);
  }

  .devis {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .devis .container {
    max-width: 820px;
    margin: 0 auto;
  }

  .devis-card {
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-primary);
    padding: 2rem;
    text-align: center;
  }

  .devis-card h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .devis-card p {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .devis {
    padding-bottom: 3rem;
  }

  .devis .devis-card p:last-of-type {
    margin-bottom: 1.5rem;
  }

  .devis .btn-primary {
    margin-top: 0.5rem;
  }

  .engagement {
    padding: 4rem 1.5rem 5rem;
    background: var(--color-bg-alt);
  }

  .engagement .container {
    max-width: 820px;
    margin: 0 auto;
  }

  .engagement h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .engagement ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .engagement li {
    color: var(--color-text);
    line-height: 1.55;
    padding: 1rem 1.25rem;
    background: var(--color-bg-elevated);
    border-left: 4px solid var(--color-first);
  }

  .engagement strong {
    color: var(--color-primary-dark);
  }
</style>