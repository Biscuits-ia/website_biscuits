---
// src/pages/piliers/logiciels.astro
// Pilier 2 : conception et vente de logiciels pour associations partenaires.

export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const schema = {
  type: 'Service' as const,
  data: {
    serviceType: 'Edition de logiciels libres pour associations',
    name: 'Logiciels pour associations partenaires',
    description: 'Biscuits IA concoit et vend des logiciels libres a destination d\'autres associations engagees : Anti Pepins, suite collaborative, outils de signalement.',
  },
};
---

<Layout
  title="Logiciels pour associations | Pilier 2 | Biscuits IA"
  description="Decouvrez notre catalogue de logiciels libres pour associations : Anti Pepins, outils internes, suite collaborative. Licences associatives preferentielles."
  schema={schema}
>
  <Breadcrumb />

  <section class="pilier-hero">
    <div class="container">
      <p class="eyebrow eyebrow-logiciels">Pilier 2</p>
      <h1>Concevoir des logiciels libres a but non lucratif</h1>
      <p class="lead">
        Notre deuxieme pilier : nous concevons des logiciels libres pour les associations et les structures publiques, et des sites et applications mobiles pour le grand public sur des enjeux concrets, comme Anti Pepins. Jamais pour des entreprises. Les contributions couvrent les couts et financent les autres piliers.
      </p>
      <div class="hero-cta">
        <a href="/anti-pepins" class="btn-primary">Decouvrir Anti Pepins</a>
        <a href="/contact?sujet=logiciel" class="btn-ghost">Nous contacter</a>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container">
      <h2>Notre catalogue</h2>
      <div class="grid">
        <article class="card">
          <span class="tag">Disponible</span>
          <h3>Anti Pepins</h3>
          <p>Service public d'analyse de messages suspects (SMS, mails, liens). Base de signaux mise a jour par la communaute. Accessible gratuitement sur anti-pepins.biscuits-ia.com et integrable en marque blanche pour les associations partenaires.</p>
          <a href="/anti-pepins">En savoir plus</a>
        </article>
        <article class="card">
          <span class="tag tag-soon">En developpement</span>
          <h3>Suite associative</h3>
          <p>Outils internes pour les associations : suivi des beneficiaires, gestion de benevolat, prise de rendez-vous, base documentaire. Code libre, hebergement souverain, documentation complete.</p>
          <a href="/contact?sujet=suite-associative">Rejoindre la beta</a>
        </article>
        <article class="card">
          <span class="tag tag-soon">En developpement</span>
          <h3>Outils de signalement</h3>
          <p>Plateforme dediee aux associations de lutte contre la cybercriminalite : centralisation des signalements, generation de dossiers PHAROS/3018, statistiques publiques.</p>
          <a href="/contact?sujet=signalement-pro">Nous contacter</a>
        </article>
      </div>
    </div>
  </section>

  <section class="values">
    <div class="container">
      <h2>Pourquoi des logiciels libres ?</h2>
      <ul>
        <li><strong>Souverainete.</strong> Vos donnees restent votre propriete. Pas de lock-in, pas de hausse de prix surprise.</li>
        <li><strong>Transparence.</strong> Le code est public, auditable par vos equipes ou par la communaute.</li>
        <li><strong>Tarifs associatifs.</strong> Tarification prefentielle pour les associations et collectivites, prix libre pour les petites structures.</li>
        <li><strong>Maintenance.</strong> Nous assurons les evolutions et la securite, sans vous laisser seul face a la dette technique.</li>
      </ul>
    </div>
  </section>

  <section class="cta-final">
    <div class="container">
      <h2>Un besoin logiciel pour votre association ?</h2>
      <p>Decrivez-nous votre besoin en quelques lignes. On vous repond sous 48h avec une estimation de charge et de cout.</p>
      <div class="cta-actions">
        <a href="/contact?sujet=devis-logiciel" class="btn-primary">Demander un devis</a>
        <a href="/projects-collaboratif" class="btn-ghost">Voir nos projets open source</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .pilier-hero {
    padding: 5rem 1.5rem 3rem;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    text-align: center;
  }

  .pilier-hero .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .eyebrow-logiciels {
    color: var(--color-primary-dark);
  }

  .pilier-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .lead {
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    font-weight: 800;
    text-decoration: none;
  }

  .btn-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
    color: var(--color-bg-alt);
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
    text-decoration: none;
    font-weight: 700;
  }

  .btn-ghost:hover {
    background: var(--color-bg-alt);
  }

  .content {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .content .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .content h2 {
    text-align: center;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0 0 2rem;
    color: var(--color-text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1.5rem;
  }

  .card {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
    position: relative;
  }

  .tag {
    position: absolute;
    top: -10px;
    right: 1rem;
    background: var(--color-success);
    color: var(--color-text);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag-soon {
    background: var(--color-warning);
  }

  .card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0 0 0.75rem;
  }

  .card a {
    display: inline-block;
    color: var(--color-primary-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .card a:hover {
    text-decoration: underline;
  }

  .values {
    padding: 4rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .values .container {
    max-width: 820px;
    margin: 0 auto;
  }

  .values h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 1.5rem;
    color: var(--color-text);
  }

  .values ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .values li {
    color: var(--color-text);
    line-height: 1.55;
    padding: 0.85rem 1rem;
    background: var(--color-bg-elevated);
    border-left: 4px solid var(--color-first);
  }

  .values strong {
    color: var(--color-primary-dark);
  }

  .cta-final {
    padding: 4rem 1.5rem 5rem;
    background: var(--color-bg);
    text-align: center;
  }

  .cta-final .container {
    max-width: 720px;
    margin: 0 auto;
  }

  .cta-final h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  .cta-final p {
    color: var(--color-text-light);
    margin: 0 0 1.5rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>