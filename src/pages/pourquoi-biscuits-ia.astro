---
import Layout from "../layouts/Layout.astro";

const content = {
  hero: {
    title: "Biscuits IA : Association pour une IA éthique et accessible",
    subtitle:
      "Protéger les citoyens contre les dérives numériques et rendre l'intelligence artificielle accessible à tous.",
  },

  mission: {
    title: "Notre mission",
    text: "Défendre l'intérêt général en rendant l'IA accessible à tous et en luttant contre les dérives numériques. Nous formons, accompagnons et sensibilisons les associations, TPE et collectivités pour ne transition numérique où l'humain reste maître de ses outils et de ses données.",
  },

  activites: [
    {
      titre: "Projets collaboratifs",
      desc: "Co-création et initiatives conjointes entre structures pour mutualiser ressources et bonnes pratiques.",
    },
    {
      titre: "Ateliers IA",
      desc: "Formation et sensibilisation pratique à l'IA pour bénévoles, équipes et petites structures.",
    },
    {
      titre: "Guides & Ressources",
      desc: "Documentation, tutoriels et fiches pratiques pour accompagner vos projets numériques.",
    },
    {
      titre: "Lutte contre les dérives numériques",
      desc: "Prévention et éducation pour protéger vos membres contre les arnaques, la désinformation et les risques en ligne.",
    },
    {
      titre: "IA Accessible",
      desc: "Développement d'outils simples et utilisables par tous, pour lutter contre la fracture numérique.",
    },
    {
      titre: "IA Utile",
      desc: "Simplification du quotidien pour libérer du temps pour le terrain.",
    },
    {
      titre: "Partage de connaissance",
      desc: "Centralisation et diffusion de savoirs entre structures pour favoriser l'autonomie et la lutte contre la désinformation.",
    },
    {
      titre: "Plateformes ouvertes",
      desc: "Solutions transparentes et conformes aux normes RGPD, pour garantir l'éthique et la responsabilité numérique.",
    },
  ],

  publics: [
    {
      titre: "Associations",
      desc: "Libérer du temps pour les bénévoles et renforcer l'impact social des actions, tout en luttant contre les dérives numériques.",
    },
    {
      titre: "TPE / collectivités",
      desc: "Structurer et automatiser les process sans complexifier l'organisation, pour une transition numérique éthique.",
    },
    {
      titre: "Collectivités",
      desc: "Moderniser les flux administratifs tout en respectant les contraintes légales et les standards de sécurité, pour protéger les citoyens.",
    },
  ],

  processus: [
    "Analyse et diagnostic : évaluation des flux, des besoins et des contraintes des structures.",
    "Conception et prototypage : définition d'outils IA adaptés, simples et fiables.",
    "Déploiement et accompagnement : mise en production progressive avec formation des équipes.",
    "Suivi et amélioration continue : ajustement des outils pour garantir impact et pérennité.",
  ],

  engagements: [
    "Accessibilité : outils et ressources compréhensibles par tous, pour lutter contre la fracture numérique.",
    "Responsabilité : respect des données, RGPD et bonnes pratiques numériques, pour protéger les citoyens.",
    "Transparence : solutions ouvertes et communication claire sur le fonctionnement, pour garantir l'éthique.",
    "Autonomie : transfert de compétences pour que chaque structure devienne indépendante et résiliente face aux dérives.",
  ],

  cta: {
    texte: "Nous rejoindre dans notre mission",
    subtexte:
      "Démocratiser la tech : l'IA ne doit pas être un privilège de startup, mais un outil citoyen",
  },
};
---

<Layout
  title="Biscuits IA - Solutions IA pour associations, TPE et collectivités"
  description="Biscuits IA accompagne les petites structures et collectivités dans l'intégration responsable de solutions d'automatisation et d'IA. Efficacité, conformité et impact mesurable."
>
  <main>
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <h1 id="hero-title" class="title">{content.hero.title}</h1>
        <p class="subtitle">{content.hero.subtitle}</p>
      </div>
    </section>

    <div class="container">
      <!-- Mission -->
      <section class="zone-card" aria-labelledby="mission-title">
        <h2 id="mission-title">{content.mission.title}</h2>
        <p>{content.mission.text}</p>
      </section>

      <!-- Activités -->
      <section class="zone-card" aria-labelledby="activites-title">
        <h2 id="activites-title">Nos activités</h2>
        <div class="grid-3">
          {content.activites.map((a) => (
            <div class="feature-badge">
              <h3>{a.titre}</h3>
              <p>{a.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Publics -->
      <section class="zone-card" aria-labelledby="publics-title">
        <h2 id="publics-title">Pour qui nous intervenons</h2>
        <div class="grid-3">
          {content.publics.map((p) => (
            <div class="feature-badge">
              <h3>{p.titre}</h3>
              <p>{p.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Processus -->
      <section class="zone-card" aria-labelledby="process-title">
        <h2 id="process-title">Notre méthodologie</h2>
        <ol class="process-list">
          {content.processus.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <!-- Engagements -->
      <section class="zone-card" aria-labelledby="engagements-title">
        <h2 id="engagements-title">Nos engagements</h2>
        <ul>
          {content.engagements.map((e) => <li>{e}</li>)}
        </ul>
      </section>

      <!-- CTA -->
      <section class="cta-box">
        <a
          href="/contact"
          class="cta-button"
          aria-label="Demander un rendez-vous institutionnel"
        >
          {content.cta.texte}
        </a>
        <p class="subtext">{content.cta.subtexte}</p>
      </section>
    </div>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    background: var(--color-bg, #fff);
  }

  .hero {
    text-align: center;
    margin-top: 8vh;
    padding: 4rem 0 3rem;
    background: var(--color-bg, #fff);
  }
  .hero .title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-text, #000);
    line-height: 1.2;
  }
  .subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    margin-top: 2rem;
    line-height: 1.6;
    color: var(--color-text-light, #666);
    max-width: 800px;
    margin: auto;
    padding: 0 1rem;
  }
  .subtext {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-light, #666);
  }

  .container {
    max-width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0 1rem;
    background: var(--color-bg, #fff);
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: 1.5rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin-bottom: 1rem;
    padding-left: 1rem;
    position: relative;
    line-height: 1.6;
  }
  li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-primary, #000);
    font-weight: bold;
  }

  .process-list {
    padding-left: 2rem;
    list-style: decimal;
    margin: 1.5rem 0;
  }
  .process-list li {
    font-size: clamp(1rem, 2vw, 1.125rem);
    padding-left: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .process-list li::before {
    content: none;
  }

  .zone-card {
    padding: 2rem;
    border: 2px solid currentColor;
    background: var(--color-bg-card, #fff);
    border-radius: 0;
    margin-bottom: 2rem;
    margin-top: 2rem;
  }
  .zone-card h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    margin-top: 0;
  }

  .feature-badge {
    padding: 1.5rem;
    border: 2px solid currentColor;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
    background: var(--color-bg-card, #fff);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    color: var(--color-text, #000);
    display: block;
    visibility: visible;
    opacity: 1;
  }
  .feature-badge:hover {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.15);
  }
  .feature-badge h3 {
    margin-bottom: 0.5rem;
    margin-top: 0;
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
  }
  .feature-badge p {
    margin: 0;
    line-height: 1.6;
  }

  .cta-box {
    text-align: center;
    margin: 4rem 0;
    padding-bottom: 4rem;
  }
  .cta-button {
    padding: 1rem 2rem;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    font-weight: 700;
    background: var(--color-primary, #000);
    color: var(--color-bg, #fff);
    border: 2px solid var(--color-primary, #000);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
  }
  .cta-button:hover,
  .cta-button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
  }
  .cta-button:focus-visible {
    outline: 2px solid var(--color-primary, #000);
    outline-offset: 4px;
  }
  .cta-button:active {
    transform: translateY(0);
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    .hero {
      margin-top: 4vh;
      padding: 2.5rem 0 2rem;
    }
    .grid-3 {
      gap: 1rem;
    }
    .zone-card,
    .feature-badge {
      padding: 1rem;
    }
  }
</style>
