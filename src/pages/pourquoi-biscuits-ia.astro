---

import Layout from "../layouts/Layout.astro";

const content = {
  hero: {
    title: "Pourquoi Biscuits IA existe",
    subtitle:
      "Parce que comprendre l'IA ne devrait pas être un privilège. On est là pour que les petites structures aient les mêmes chances que les grandes.",
  },

  mission: {
    title: "Ce qu'on défend",
    text: "Biscuits IA, c'est une association. Notre mission : rendre l'IA compréhensible et vraiment utile pour les associations, les petites structures, les collectivités. On forme, on accompagne, on partage nos outils librement — et l'humain reste toujours aux commandes.",
  },

  activites: [
    {
      titre: "Projets collaboratifs",
      desc: "On construit des outils ensemble, en open source. Ce qu'une structure crée bénéficie à toutes les autres.",
    },
    {
      titre: "Ateliers",
      desc: "Des sessions pratiques, ouvertes à tous · bénévoles, équipes, curieux · quel que soit le niveau.",
    },
    {
      titre: "Guides & Ressources",
      desc: "Des docs, tutoriels et fiches rédigés en français, sans jargon. À télécharger, adapter et partager librement.",
    },
    {
      titre: "Lutte contre les arnaques",
      desc: "On apprend ensemble à repérer les pièges numériques — deepfakes, phishing, faux outils IA — pour protéger vos membres.",
    },
    {
      titre: "IA accessible",
      desc: "On développe des outils simples, sans formation technique requise. La fracture numérique se réduit à force de pratiquer ensemble.",
    },
    {
      titre: "IA utile",
      desc: "Automatiser ce qui est fastidieux pour libérer du temps — pour le terrain, les gens, et ce qui vous tient vraiment à cœur.",
    },
    {
      titre: "Partage de connaissances",
      desc: "Ce qu'un membre apprend, il le partage. Les savoirs circulent pour que toute la communauté en profite.",
    },
    {
      titre: "Outils ouverts",
      desc: "Nos solutions sont transparentes, open source et conformes au RGPD. Vous savez ce que vous utilisez — et pourquoi.",
    },
  ],

  publics: [
    {
      titre: "Associations",
      desc: "Moins de temps sur l'admin, plus de temps pour vos bénévoles, vos membres et votre mission.",
    },
    {
      titre: "TPE et indépendants",
      desc: "Des outils qui simplifient le quotidien — sans complexifier l'organisation ni exploser le budget.",
    },
    {
      titre: "Collectivités",
      desc: "Moderniser certains flux sans perdre le contrôle des données ni ignorer les contraintes légales.",
    },
  ],

  processus: [
    "On écoute : on prend le temps de comprendre votre structure, vos besoins réels, vos contraintes.",
    "On réfléchit ensemble : on cherche l'outil le plus simple qui répond vraiment au problème.",
    "On accompagne sans vous laisser seul·e : on installe, on forme, on répond à vos questions — à votre rythme.",
    "On s'adapte : si ça ne convient pas, on ajuste. Pas de solution imposée, jamais.",
  ],

  engagements: [
    "Accessibilité : tout doit être compréhensible par quelqu'un qui n'est pas développeur.",
    "Respect des données : on applique le RGPD et on vous explique concrètement pourquoi ça compte.",
    "Transparence : on dit ce qu'on fait, comment ça marche — et ce qu'on ne sait pas encore faire.",
    "Autonomie : notre objectif, c'est que vous n'ayez plus besoin de nous — pas l'inverse.",
  ],

  cta: {
    texte: "Rejoindre la communauté",
    subtexte:
      "L'IA ne devrait pas être un privilège. C'est pour ça qu'on en a fait une association ouverte à toutes et tous.",
  },
};
---

<Layout
  title="Pourquoi Biscuits IA | Une association pour une IA accessible à tous"
  description="Biscuits IA est une association qui aide les petites structures à comprendre et utiliser l'IA — gratuitement, sans jargon, avec une communauté humaine."
>
  <main>
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <h1 id="hero-title" class="title">{content.hero.title}</h1>
        <p class="subtitle">{content.hero.subtitle}</p>
      </div>
    </section>

    <div class="container">
      <!-- Mission -->
      <section class="zone-card" aria-labelledby="mission-title">
        <h2 id="mission-title">{content.mission.title}</h2>
        <p>{content.mission.text}</p>
      </section>

      <!-- Activités -->
      <section class="zone-card" aria-labelledby="activites-title">
        <h2 id="activites-title">Nos activités</h2>
        <div class="grid-3">
          {content.activites.map((a) => (
            <div class="feature-badge">
              <h3>{a.titre}</h3>
              <p>{a.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Publics -->
      <section class="zone-card" aria-labelledby="publics-title">
        <h2 id="publics-title">À qui ça s'adresse</h2>
        <div class="grid-3">
          {content.publics.map((p) => (
            <div class="feature-badge">
              <h3>{p.titre}</h3>
              <p>{p.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Processus -->
      <section class="zone-card" aria-labelledby="process-title">
        <h2 id="process-title">Comment on travaille</h2>
        <ol class="process-list">
          {content.processus.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <!-- Engagements -->
      <section class="zone-card" aria-labelledby="engagements-title">
        <h2 id="engagements-title">Nos engagements</h2>
        <ul>
          {content.engagements.map((e) => <li>{e}</li>)}
        </ul>
      </section>

      <!-- CTA -->
      <section class="cta-box">
        <a
          href="/rejoignez-nous"
          class="cta-button"
          aria-label="Rejoindre l'association Biscuits IA"
        >
          {content.cta.texte}
        </a>
        <p class="subtext">{content.cta.subtexte}</p>
      </section>
    </div>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    background: var(--color-bg, #fff);
  }

  .hero {
    text-align: center;
    margin-top: 8vh;
    padding: 4rem 0 3rem;
    background: var(--color-bg, #fff);
  }
  .hero .title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-text, #000);
    line-height: 1.2;
  }
  .subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    margin-top: 2rem;
    line-height: 1.6;
    color: var(--color-text-light, #666);
    max-width: 800px;
    margin: auto;
    padding: 0 1rem;
  }
  .subtext {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-light, #666);
  }

  .container {
    max-width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0 1rem;
    background: var(--color-bg, #fff);
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: 1.5rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin-bottom: 1rem;
    padding-left: 1rem;
    position: relative;
    line-height: 1.6;
  }
  li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-primary, #000);
    font-weight: bold;
  }

  .process-list {
    padding-left: 2rem;
    list-style: decimal;
    margin: 1.5rem 0;
  }
  .process-list li {
    font-size: clamp(1rem, 2vw, 1.125rem);
    padding-left: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .process-list li::before {
    content: none;
  }

  .zone-card {
    padding: 2rem;
    border: 2px solid currentColor;
    background: var(--color-bg-card, #fff);
    border-radius: 0;
    margin-bottom: 2rem;
    margin-top: 2rem;
  }
  .zone-card h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    margin-top: 0;
  }

  .feature-badge {
    padding: 1.5rem;
    border: 2px solid currentColor;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
    background: var(--color-bg-card, #fff);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    color: var(--color-text, #000);
    display: block;
    visibility: visible;
    opacity: 1;
  }
  .feature-badge:hover {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.15);
  }
  .feature-badge h3 {
    margin-bottom: 0.5rem;
    margin-top: 0;
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
  }
  .feature-badge p {
    margin: 0;
    line-height: 1.6;
  }

  .cta-box {
    text-align: center;
    margin: 4rem 0;
    padding-bottom: 4rem;
  }
  .cta-button {
    padding: 1rem 2rem;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    font-weight: 700;
    background: var(--color-primary, #000);
    color: var(--color-bg, #fff);
    border: 2px solid var(--color-primary, #000);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
  }
  .cta-button:hover,
  .cta-button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
  }
  .cta-button:focus-visible {
    outline: 2px solid var(--color-primary, #000);
    outline-offset: 4px;
  }
  .cta-button:active {
    transform: translateY(0);
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    .hero {
      margin-top: 4vh;
      padding: 2.5rem 0 2rem;
    }
    .grid-3 {
      gap: 1rem;
    }
    .zone-card,
    .feature-badge {
      padding: 1rem;
    }
  }
</style>
