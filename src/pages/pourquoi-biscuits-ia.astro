---
import Layout from "../layouts/Layout.astro";

const content = {
  hero: {
    title: "Biscuits IA : L’IA au service des structures engagées",
    subtitle:
      "Nous accompagnons associations, TPE et collectivités dans l’intégration responsable de solutions d’IA et d’automatisation concrètes, fiables et conformes aux standards réglementaires.",
  },

  mission: {
    title: "Notre mission",
    text: "Rendre l’intelligence artificielle accessible et utile aux structures disposant de ressources limitées. Nous développons des outils pratiques, accompagnons les équipes et assurons un transfert de compétences pour renforcer l’impact social et opérationnel.",
  },

  activites: [
    {
      titre: "Projets collaboratifs",
      desc: "Co-création et initiatives conjointes entre structures pour mutualiser ressources et bonnes pratiques.",
    },
    {
      titre: "Ateliers IA",
      desc: "Formation et sensibilisation pratique à l'IA pour bénévoles, équipes et petites structures.",
    },
    {
      titre: "Guides & Ressources",
      desc: "Documentation, tutoriels et fiches pratiques pour accompagner vos projets numériques.",
    },
    {
      titre: "Dérives numériques",
      desc: "Prévention et éducation pour protéger vos membres contre les fraudes et risques en ligne.",
    },
    {
      titre: "IA Accessible",
      desc: "Développement d'outils simples et utilisables par tous, sans compétences techniques avancées.",
    },
    {
      titre: "IA Utile",
      desc: "Automatisations pragmatiques répondant à de vrais besoins, mesurables et fiables.",
    },
    {
      titre: "Partage de connaissance",
      desc: "Centralisation et diffusion de savoirs entre structures pour favoriser autonomie et montée en compétences.",
    },
    {
      titre: "Plateformes ouvertes",
      desc: "Solutions transparentes et conformes aux normes RGPD et aux bonnes pratiques numériques.",
    },
  ],

  publics: [
    {
      titre: "Associations",
      desc: "Libérer du temps pour les bénévoles et renforcer l'impact social des actions.",
    },
    {
      titre: "TPE / collectivités",
      desc: "Structurer et automatiser les process sans complexifier l'organisation.",
    },
    {
      titre: "Collectivités",
      desc: "Moderniser les flux administratifs tout en respectant les contraintes légales et les standards de sécurité.",
    },
  ],

  processus: [
    "Analyse et diagnostic : évaluation des flux, des besoins et des contraintes des structures.",
    "Conception et prototypage : définition doutils IA adaptés, simples et fiables.",
    "Déploiement et accompagnement : mise en production progressive avec formation des équipes.",
    "Suivi et amélioration continue : ajustement des outils pour garantir impact et pérennité.",
  ],

  engagements: [
    "Accessibilité : outils et ressources compréhensibles par tous, sans jargon technique.",
    "Responsabilité : respect des données, RGPD et bonnes pratiques numériques.",
    "Transparence : solutions ouvertes et communication claire sur le fonctionnement.",
    "Autonomie : transfert de compétences pour que chaque structure devienne indépendante.",
  ],

  cta: {
    texte: "Demander un rendez-vous institutionnel",
    subtexte:
      "Échange préalable pour évaluer les opportunités d'automatisation et l'impact sur votre structure.",
  },
};
---

<Layout
  title="Biscuits IA - Solutions IA pour associations, TPE et collectivités"
  description="Biscuits IA accompagne les petites structures et collectivités dans l'intégration responsable de solutions d'automatisation et d'IA. Efficacité, conformité et impact mesurable."
>
  <main>
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <h1 id="hero-title" class="title">{content.hero.title}</h1>
        <p class="subtitle">{content.hero.subtitle}</p>
      </div>
    </section>

    <div class="container">
      <!-- Mission -->
      <section class="zone-card" aria-labelledby="mission-title">
        <h2 id="mission-title">{content.mission.title}</h2>
        <p>{content.mission.text}</p>
      </section>

      <!-- Activités -->
      <section class="zone-card" aria-labelledby="activites-title">
        <h2 id="activites-title">Nos activités</h2>
        <div class="grid-3">
          {
            content.activites.map((a) => {
              return (
                <div class="feature-badge">
                  <h3>{a.titre}</h3>
                  <p>{a.desc}</p>
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Publics -->
      <section class="zone-card" aria-labelledby="publics-title">
        <h2 id="publics-title">Pour qui nous intervenons</h2>
        <div class="grid-3">
          {
            content.publics.map((p) => {
              return (
                <div class="feature-badge">
                  <h3>{p.titre}</h3>
                  <p>{p.desc}</p>
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Processus -->
      <section class="zone-card" aria-labelledby="process-title">
        <h2 id="process-title">Notre méthodologie</h2>
        <ol class="process-list">
          {content.processus.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <!-- Engagements -->
      <section class="zone-card" aria-labelledby="engagements-title">
        <h2 id="engagements-title">Nos engagements</h2>
        <ul>
          {content.engagements.map((e) => <li>{e}</li>)}
        </ul>
      </section>

      <!-- CTA -->
      <section class="cta-box">
        <a
          href="/contact"
          class="cta-button"
          aria-label="Demander un rendez-vous institutionnel"
        >
          {content.cta.texte}
        </a>
        <p class="subtext">{content.cta.subtexte}</p>
      </section>
    </div>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
  }

  .hero {
    text-align: center;
    margin-top: 8vh;
    padding: 4rem 0 3rem;
    background: var(--color-bg, #fff);
  }
  .hero .title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-text, #000);
    line-height: 1.2;
  }
  .subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    margin-top: 2rem;
    line-height: 1.6;
    color: var(--color-text-light, #666);
    max-width: 800px;
    margin: auto;
    padding: 0 1rem;
  }
  .subtext {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-light, #666);
  }

  .container {
    max-width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0 1rem;
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: 1.5rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin-bottom: 1rem;
    padding-left: 1rem;
    position: relative;
    line-height: 1.6;
  }
  li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-primary, #000);
    font-weight: bold;
  }

  .process-list {
    padding-left: 2rem;
    list-style: decimal;
    margin: 1.5rem 0;
  }
  .process-list li {
    font-size: clamp(1rem, 2vw, 1.125rem);
    padding-left: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .process-list li::before {
    content: none;
  }

  .zone-card {
    padding: 2rem;
    border: 2px solid currentColor;
    background: var(--color-bg-card, #fff);
    border-radius: 0;
    margin-bottom: 2rem;
  }
  .zone-card h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    margin-top: 0;
  }

  .feature-badge {
    padding: 1.5rem;
    border: 2px solid currentColor;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
    background: var(--color-bg-card, #fff);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .feature-badge:hover {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.15);
  }
  .feature-badge h3 {
    margin-bottom: 0.5rem;
    margin-top: 0;
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
  }
  .feature-badge p {
    margin: 0;
    line-height: 1.6;
  }

  .cta-box {
    text-align: center;
    margin: 4rem 0;
    padding-bottom: 4rem;
  }
  .cta-button {
    padding: 1rem 2rem;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    font-weight: 700;
    background: var(--color-primary, #000);
    color: var(--color-bg, #fff);
    border: 2px solid var(--color-primary, #000);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.1);
  }
  .cta-button:hover,
  .cta-button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.2);
  }
  .cta-button:focus-visible {
    outline: 2px solid var(--color-primary, #000);
    outline-offset: 4px;
  }
  .cta-button:active {
    transform: translateY(0);
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    .hero {
      margin-top: 4vh;
      padding: 2.5rem 0 2rem;
    }
    .grid-3 {
      gap: 1rem;
    }
    .zone-card,
    .feature-badge {
      padding: 1rem;
    }
  }
</style>
