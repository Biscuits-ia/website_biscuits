---
// src/pages/public/tpe-pme.astro
// Landing dediee aux tres petites et petites/moyennes entreprises.

export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const schema = {
  type: 'WebPage' as const,
  data: {
    name: 'Biscuits IA pour les TPE et PME',
    description: 'Biscuits IA aide les TPE et PME a automatiser les taches repetitives, choisir les bons outils IA, et se proteger des arnaques. Diagnostics, ateliers, logiciels libres souverains.',
  },
};
---

<Layout
  title="Solutions pour les TPE et PME | Biscuits IA"
  description="TPE, PME, entrepreneur individuel : gagnez du temps sur les taches repetitives grace a l'IA, choisissez les bons outils, et protegez-vous des arnaques. Sans jargon, sans lock-in, sans exploser le budget."
  schema={schema}
>
  <Breadcrumb />

  <section class="lp-hero">
    <div class="container">
      <p class="lp-eyebrow lp-eyebrow-tpe">Vous etes une TPE, une PME, un entrepreneur</p>
      <h1>Vous etes submerges ? L'IA peut vous faire gagner 5 a 10h par semaine</h1>
      <p class="lp-lead">
        Devis, factures, relances, mails-types, comptes-rendus, publications reseaux sociaux : on vous aide a automatiser ce qui est repetitif, a choisir les bons outils pour votre metier, et a proteger votre activite des arnaques qui visent les pros. Sans jargon, sans promesse en l'air, sans lock-in.
      </p>
      <div class="lp-cta">
        <a href="/rdv" class="btn-primary">Diagnostic gratuit 20 min</a>
        <a href="/ateliers" class="btn-ghost">Voir les ateliers</a>
        <a href="/contact?sujet=tpe-pme" class="btn-ghost">Nous contacter</a>
      </div>
    </div>
  </section>

  <section class="lp-context">
    <div class="container">
      <h2>Le quotidien que vous connaissez</h2>
      <div class="context-grid">
        <article class="context-card">
          <h3>3 devis, 4 factures, 2 relances par jour</h3>
          <p>Vous passez 2h par jour sur des taches administratives repetitives. L'IA peut les prendre en charge en 30 minutes, vous gardez la validation.</p>
        </article>
        <article class="context-card">
          <h3>Vous payez 4 outils SaaS en parallele</h3>
          <p>CRM, agenda, mailing, facturation : 50 a 300 EUR/mois cumules, et aucun ne parle a l'autre. Sans deplacer toute votre compta.</p>
        </article>
        <article class="context-card">
          <h3>LinkedIn vous prend le week-end</h3>
          <p>Vous savez qu'il faut publier, mais pas le temps. On peut vous aider a structurer un calendrier de 2h/semaine, pas a devenir community manager.</p>
        </article>
        <article class="context-card">
          <h3>Vous avez failli vous faire avoir</h3>
          <p>Faux client qui demande de changer l'IBAN, faux president, faux support Microsoft : les TPE sont les premieres cibles. Vous voulez eviter de perdre 10 000 EUR.</p>
        </article>
        <article class="context-card">
          <h3>Vous n'avez pas de DSI</h3>
          <p>Vous decidez de tout, y compris des choix techniques que vous n'etes pas sur de maitriser. On peut vous aider a faire les bons choix sans jargon.</p>
        </article>
        <article class="context-card">
          <h3>Vous voulez du sur-mesure, pas du generique</h3>
          <p>Les formations en ligne sont trop generales. Vous voulez un truc adapte a votre metier, pas une formation a ChatGPT de 8h.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="lp-solutions">
    <div class="container">
      <h2>Ce qu'on vous propose</h2>
      <div class="solution-grid">
        <article class="solution-card">
          <h3>Diagnostic express 20 min</h3>
          <p>Un echange rapide : on identifie vos 3 plus grosses pertes de temps et on vous propose 2-3 actions concretes a mettre en place vous-meme cette semaine.</p>
          <p class="solution-price">Gratuit, sans engagement.</p>
          <a href="/rdv" class="solution-cta">Reserver un creneau</a>
        </article>
        <article class="solution-card">
          <h3>Audit IA adapte a votre activite</h3>
          <p>Un audit plus pousse : on regarde vos process, on vous propose 3 outils IA adaptes a votre metier, on vous forme 1h, vous etes autonome ensuite.</p>
          <p class="solution-price">A partir de 600 EUR (forfait).</p>
          <a href="/contact?sujet=audit-tpe" class="solution-cta">Demander un devis</a>
        </article>
        <article class="solution-card">
          <h3>Atelier "IA pour les pros"</h3>
          <p>Une journee pour maitriser 3 outils qui vous changent la vie (assistant IA, automatisation no-code, generation de visuels). Repartez avec vos automatisations deployees.</p>
          <p class="solution-price">Atelier 4h : 350 EUR/participant (installe).</p>
          <a href="/ateliers" class="solution-cta">Voir les ateliers</a>
        </article>
        <article class="solution-card">
          <h3>Sensibilisation anti-arnaques pros</h3>
          <p>Un module de 90 min pour vous et vos equipes : reconnaitre la fraude au president, les faux IBAN, les deepfakes vocaux. Avec les bons reflexes a avoir.</p>
          <p class="solution-price">A partir de 300 EUR la session (jusqu'a 10 personnes).</p>
          <a href="/contact?sujet=sensibilisation-pro" class="solution-cta">Reserver une session</a>
        </article>
        <article class="solution-card">
          <h3>Outils libres souverains</h3>
          <p>On vous aide a migrer vers des alternatives libres hebergees en France : agenda, mails, CRM, hebergement web. Vous gardez le controle de vos donnees.</p>
          <p class="solution-price">Sur devis (a partir de 800 EUR par migration).</p>
          <a href="/contact?sujet=migration" class="solution-cta">Demander un audit</a>
        </article>
        <article class="solution-card">
          <h3>Suite associative / Anti Pepins</h3>
          <p>Vous etes une petite structure ? Profitez de nos logiciels libres : Suite associative pour gerer vos clients/projets, Anti Pepins pour detecter les arnaques dans vos flux.</p>
          <p class="solution-price">Anti Pepins : gratuit. Suite : a partir de 30 EUR/mois.</p>
          <a href="/anti-pepins" class="solution-cta">Decouvrir Anti Pepins</a>
        </article>
      </div>
    </div>
  </section>

  <section class="lp-ressources">
    <div class="container">
      <h2>Pour aller plus loin</h2>
      <ul class="res-list">
        <li><a href="/blog/automatiser-taches-ia-associations">Automatiser ses taches repetitives avec l'IA : methode en 5 etapes</a></li>
        <li><a href="/blog/comparatif-ia-open-source-2026">Comparatif IA open source 2026 : quelle solution pour quel usage</a></li>
        <li><a href="/blog/cybersecurite-associations-2026">Cybersecurite des petites structures en 2026</a></li>
        <li><a href="/blog/rgpd-petites-structures">RGPD : l'essentiel pour les TPE</a></li>
        <li><a href="/blog/faux-investissements-ia-trading">Les arnaques a l'IA qui visent les pros en 2026</a></li>
      </ul>
    </div>
  </section>

  <section class="lp-cta-final">
    <div class="container">
      <h2>Le plus simple : on en parle 20 minutes</h2>
      <p>Vous nous decrivez votre activite, vos 3 plus grosses pertes de temps, on vous dit ce qu'on peut faire (et aussi ce qu'on ne peut pas). C'est gratuit, et on vous envoie un compte-rendu ecrit.</p>
      <div class="lp-cta-buttons">
        <a href="/rdv" class="btn-primary">Reserver le creneau</a>
        <a href="/contact?sujet=tpe-pme" class="btn-ghost">Decrire votre besoin</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .lp-hero {
    padding: 5rem 1.5rem 3rem;
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    text-align: center;
  }

  .lp-hero .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .lp-eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .lp-eyebrow-tpe {
    color: #2e8a4f;
  }

  .lp-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .lp-lead {
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .lp-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg-elevated);
    font-weight: 800;
    border: 2px solid var(--color-border);
    text-decoration: none;
  }

  .btn-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
    color: var(--color-bg-elevated);
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: transparent;
    color: var(--color-text);
    font-weight: 700;
    border: 2px solid var(--color-border);
    text-decoration: none;
  }

  .btn-ghost:hover {
    background: var(--color-bg-elevated);
  }

  .lp-context,
  .lp-solutions,
  .lp-ressources {
    padding: 4rem 1.5rem;
  }

  .lp-context {
    background: var(--color-bg);
  }

  .lp-solutions {
    background: var(--color-bg-alt);
  }

  .lp-ressources {
    background: var(--color-bg);
  }

  .lp-context .container,
  .lp-solutions .container,
  .lp-ressources .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .lp-context h2,
  .lp-solutions h2,
  .lp-ressources h2 {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0 0 2rem;
  }

  .context-grid,
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1.5rem;
  }

  .context-card,
  .solution-card {
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
  }

  .context-card h3,
  .solution-card h3 {
    font-size: 1.1rem;
    font-weight: 800;
    color: #2e8a4f;
    margin: 0 0 0.5rem;
  }

  .context-card p,
  .solution-card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0 0 0.5rem;
  }

  .solution-price {
    font-size: 0.95rem;
    color: var(--color-first);
    font-weight: 700;
  }

  .solution-cta {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.6rem 1.1rem;
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: 700;
    border: 2px solid var(--color-border);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .solution-cta:hover {
    background: var(--color-primary);
    color: var(--color-bg-elevated);
  }

  .res-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 760px;
    margin-inline: auto;
  }

  .res-list li {
    padding: 1rem 1.25rem;
    background: var(--color-bg-elevated);
    border-left: 4px solid #2e8a4f;
  }

  .res-list a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .res-list a:hover {
    text-decoration: underline;
  }

  .lp-cta-final {
    padding: 4rem 1.5rem 5rem;
    background: #2e8a4f;
    color: #fff;
    text-align: center;
  }

  .lp-cta-final .container {
    max-width: 760px;
    margin: 0 auto;
  }

  .lp-cta-final h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 0.75rem;
    color: #fff;
  }

  .lp-cta-final p {
    line-height: 1.6;
    margin: 0 0 1.5rem;
    opacity: 0.95;
  }

  .lp-cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .lp-cta-final .btn-primary {
    background: #fff;
    color: #2e8a4f;
  }

  .lp-cta-final .btn-ghost {
    background: transparent;
    color: #fff;
    border-color: #fff;
  }
</style>