---
import Layout from '@/layouts/Layout.astro';
import { createSupabaseClient } from '@/lib/supabase';
import UserAppointmentBooking from '@/components/UserAppointmentBooking.astro';

const supabase = createSupabaseClient({ request: Astro.request, cookies: Astro.cookies });
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect(`/connexion?redirect=/rdv`);
}
---

<Layout
  title="Prendre rendez-vous | Biscuits IA"
  description="Réservez un créneau de rendez-vous avec l'équipe Biscuits IA pour un accompagnement personnalisé."
>
  <section class="rdv-hero">
    <div class="container">
      <h1>Prendre rendez-vous</h1>
      <p>Choisissez un créneau disponible pour un échange personnalisé avec notre équipe.</p>
    </div>
  </section>

  <section class="rdv-section">
    <div class="container">
      <UserAppointmentBooking />
    </div>
  </section>
</Layout>

<style>
  .rdv-hero {
    padding: 5rem var(--spacing-lg) 3rem;
    text-align: center;
    background: var(--color-bg);
  }

  .rdv-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .rdv-hero p {
    font-size: 1.125rem;
    color: var(--color-text-light);
    max-width: 560px;
    margin: 0 auto;
  }

  .rdv-section {
    padding: 2rem var(--spacing-lg) 5rem;
  }
</style>
