---
// src/pages/rejoignez-nous.astro
// Page éditoriale de présentation du bénévolat. La prise de contact passe par
// /contact : les sessions de recrutement et les candidatures en ligne ont été
// retirées avec les modules correspondants.

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

// Fiche organisation Biscuits IA sur JeVeuxAider : elle mene directement a nos
// missions, contrairement a la page d'accueil de la plateforme.
const JVA_ORGANISATION_URL = 'https://www.jeveuxaider.gouv.fr/organisations/34315-biscuits-ia';

const schema = {
  type: 'WebPage' as const,
  data: {
    name: 'Rejoindre Biscuits IA - Devenir bénévole',
    description:
      'Rejoignez Biscuits IA en bénévole : découvrez nos missions et contactez-nous pour vous engager.',
  },
};
---

<Layout
  title="Rejoindre Biscuits IA | Devenir bénévole"
  description="Rejoignez Biscuits IA en bénévole : mission d'interet general autour de l'IA, de la cybersecurite et des logiciels libres."
  schema={schema}
>
  <Breadcrumb />

  {
    /* Banniere de redirection : le recrutement de benevoles ne se fait plus par
      formulaire ici mais sur JeVeuxAider, la plateforme publique du benevolat.
      Placee avant le hero pour etre vue avant toute autre action. */
  }
  <aside class="jva-banner" aria-labelledby="jva-banner-title">
    <div class="container jva-banner-inner">
      {
        /* width/height explicites : evitent un decalage de mise en page au
          chargement. Le logo est purement illustratif ici, le texte qui suit
          porte deja l'information, d'ou l'alt vide. */
      }
      <img
        src="/logos/jeveuxaider.svg"
        alt=""
        width="227"
        height="37"
        loading="lazy"
        decoding="async"
        class="jva-banner-logo"
      />
      <div class="jva-banner-text">
        <p id="jva-banner-title" class="jva-banner-title">
          Nos recrutements se font sur JeVeuxAider.gouv.fr
        </p>
        <p class="jva-banner-desc">
          La plateforme publique du bénévolat, opérée par l'État. Toutes nos missions y sont
          publiées et les candidatures s'y déposent directement.
        </p>
      </div>
      <a
        href={JVA_ORGANISATION_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="jva-banner-cta"
      >
        Voir nos missions
        <span class="visually-hidden">sur JeVeuxAider.gouv.fr (s'ouvre dans un nouvel onglet)</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </aside>

  <section class="recruit-hero">
    <div class="container">
      <p class="eyebrow">Bénévolat</p>
      <h1>Rejoindre Biscuits IA</h1>
      <p class="lead">
        Biscuits IA est une association loi 1901 qui rend le numérique utile, sûr et accessible.
        Nous avons besoin de bénévoles motivés pour accompagner nos piliers : IA, cybercriminalité,
        logiciels libres, Anti Pepins et recherche participative.
      </p>
      {
        /* Un seul bouton ici : le lien JeVeuxAider est porte par la banniere
          ci-dessus. Les deux canaux restent ainsi distincts — candidater sur
          JeVeuxAider, poser une question par le formulaire de contact. */
      }
      <div class="hero-cta">
        <a href="/contact" class="btn-primary">Nous contacter</a>
      </div>
    </div>
  </section>

  <section class="recruit-why">
    <div class="container">
      <h2>Pourquoi devenir bénévole ?</h2>
      <div class="why-grid">
        <article class="why-card">
          <h3>Une mission concrète</h3>
          <p>
            Votre temps sert directement des projets à impact social : sensibilisation, outils
            libres, recherche utile.
          </p>
        </article>
        <article class="why-card">
          <h3>Du temps, pas des contraintes</h3>
          <p>
            Quelques heures par mois ou un engagement plus régulier : chaque contribution compte.
          </p>
        </article>
        <article class="why-card">
          <h3>Apprendre en faisant</h3>
          <p>
            IA, cybersécurité, design, recherche... Rejoignez une équipe curieuse et bienveillante.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="recruit-faq">
    <div class="container">
      <h2>Questions fréquentes</h2>
      <dl class="faq-list">
        <div class="faq-item">
          <dt>Qui peut nous rejoindre ?</dt>
          <dd>
            Tout le monde : étudiants, professionnels, retraités, curieux. L'envie d'aider compte
            plus que le CV.
          </dd>
        </div>
        <div class="faq-item">
          <dt>Comment se passe le premier contact ?</dt>
          <dd>
            Écrivez-nous via le formulaire de contact. Nous revenons vers vous pour échanger sur vos
            envies et nos besoins du moment.
          </dd>
        </div>
        <div class="faq-item">
          <dt>Dois-je avoir des compétences techniques ?</dt>
          <dd>
            Non. Nous avons besoin de profils variés : communication, animation, recherche, dev,
            design, etc.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>

<style>
  /* Banniere JeVeuxAider : visible sans etre agressive. Elle precede le hero
     parce qu'elle repond a la question que se pose le visiteur en arrivant
     ("comment je candidate ?") avant qu'il ne cherche un formulaire. */
  .jva-banner {
    background: var(--color-bg-alt);
    border-bottom: 2px solid var(--color-border);
    padding: 1.25rem 1.5rem;
  }

  .jva-banner-inner {
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }

  .jva-banner-logo {
    flex-shrink: 0;
    width: 170px;
    height: auto;
    align-self: center;
  }

  .jva-banner-text {
    flex: 1 1 18rem;
  }

  .jva-banner-title {
    margin: 0 0 0.25rem;
    font-weight: 800;
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .jva-banner-desc {
    margin: 0;
    color: var(--color-text-light);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .jva-banner-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.7rem 1.25rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-bg);
    border: 2px solid var(--color-text);
    border-radius: var(--radius-md, 0);
  }

  .jva-banner-cta:hover,
  .jva-banner-cta:focus-visible {
    background: var(--color-primary);
  }

  .recruit-hero {
    padding: 5rem 1.5rem 3rem;
    background: var(--color-bg);
    text-align: center;
  }

  .recruit-hero .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .recruit-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .lead {
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    font-weight: 800;
    text-decoration: none;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
  }

  .recruit-why {
    padding: 4rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .recruit-why .container,
  .recruit-faq .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .recruit-why h2,
  .recruit-faq h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    text-align: center;
    margin: 0 0 1.5rem;
    color: var(--color-text);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1.5rem;
  }

  .why-card {
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
  }

  .why-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .why-card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }

  .recruit-faq {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 1.25rem;
  }

  .faq-item dt {
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .faq-item dd {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary {
      text-align: center;
    }
  }
</style>
