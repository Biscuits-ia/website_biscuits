---
// src/pages/rejoignez-nous.astro
// Page éditoriale de présentation du bénévolat. La prise de contact passe par
// /contact : les sessions de recrutement et les candidatures en ligne ont été
// retirées avec les modules correspondants.

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const schema = {
  type: 'WebPage' as const,
  data: {
    name: 'Rejoindre Biscuits IA - Devenir bénévole',
    description:
      'Rejoignez Biscuits IA en bénévole : découvrez nos missions et contactez-nous pour vous engager.',
  },
};
---

<Layout
  title="Rejoindre Biscuits IA | Devenir bénévole"
  description="Rejoignez Biscuits IA en bénévole : mission d'interet general autour de l'IA, de la cybersecurite et des logiciels libres."
  schema={schema}
>
  <Breadcrumb />

  <section class="recruit-hero">
    <div class="container">
      <p class="eyebrow">Bénévolat</p>
      <h1>Rejoindre Biscuits IA</h1>
      <p class="lead">
        Biscuits IA est une association loi 1901 qui rend le numérique utile, sûr et accessible.
        Nous avons besoin de bénévoles motivés pour accompagner nos piliers : IA, cybercriminalité,
        logiciels libres, Anti Pepins et recherche participative.
      </p>
      <div class="hero-cta">
        <a href="/contact" class="btn-primary">Nous contacter</a>
        <a
          href="https://www.jeveuxaider.gouv.fr/organisations/34315-biscuits-ia"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          Voir sur jeveuxaider.gouv
        </a>
      </div>
    </div>
  </section>

  <section class="recruit-why">
    <div class="container">
      <h2>Pourquoi devenir bénévole ?</h2>
      <div class="why-grid">
        <article class="why-card">
          <h3>Une mission concrète</h3>
          <p>
            Votre temps sert directement des projets à impact social : sensibilisation, outils
            libres, recherche utile.
          </p>
        </article>
        <article class="why-card">
          <h3>Du temps, pas des contraintes</h3>
          <p>
            Quelques heures par mois ou un engagement plus régulier : chaque contribution compte.
          </p>
        </article>
        <article class="why-card">
          <h3>Apprendre en faisant</h3>
          <p>
            IA, cybersécurité, design, recherche... Rejoignez une équipe curieuse et bienveillante.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="recruit-faq">
    <div class="container">
      <h2>Questions fréquentes</h2>
      <dl class="faq-list">
        <div class="faq-item">
          <dt>Qui peut nous rejoindre ?</dt>
          <dd>
            Tout le monde : étudiants, professionnels, retraités, curieux. L'envie d'aider compte
            plus que le CV.
          </dd>
        </div>
        <div class="faq-item">
          <dt>Comment se passe le premier contact ?</dt>
          <dd>
            Écrivez-nous via le formulaire de contact. Nous revenons vers vous pour échanger sur vos
            envies et nos besoins du moment.
          </dd>
        </div>
        <div class="faq-item">
          <dt>Dois-je avoir des compétences techniques ?</dt>
          <dd>
            Non. Nous avons besoin de profils variés : communication, animation, recherche, dev,
            design, etc.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>

<style>
  .recruit-hero {
    padding: 5rem 1.5rem 3rem;
    background: var(--color-bg);
    text-align: center;
  }

  .recruit-hero .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .recruit-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .lead {
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    font-weight: 800;
    text-decoration: none;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
    text-decoration: none;
    font-weight: 700;
  }

  .btn-ghost:hover {
    background: var(--color-bg-alt);
  }

  .recruit-why {
    padding: 4rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .recruit-why .container,
  .recruit-faq .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .recruit-why h2,
  .recruit-faq h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    text-align: center;
    margin: 0 0 1.5rem;
    color: var(--color-text);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1.5rem;
  }

  .why-card {
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
  }

  .why-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .why-card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }

  .recruit-faq {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 1.25rem;
  }

  .faq-item dt {
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .faq-item dd {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-ghost {
      text-align: center;
    }
  }
</style>
