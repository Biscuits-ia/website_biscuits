---
// src/pages/rejoignez-nous.astro
// Page dédiée au recrutement bénévole : sessions ouvertes + candidature par session.

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import RecruitmentForm from '@/components/Recruitmentform.astro';
import { createSupabaseClient } from '@/lib/supabase';

const supabase = Astro.locals.supabase ?? createSupabaseClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

const now = new Date().toISOString();
const { data: sessionsRaw } = await supabase
  .from('recruitment_sessions')
  .select('*')
  .eq('status', 'open')
  .gt('scheduled_at', now)
  .order('scheduled_at', { ascending: true });

const sessions = sessionsRaw ?? [];

const sessionCounts: Record<string, number> = {};
if (sessions.length > 0) {
  const { data: counts } = await supabase
    .from('recruitment_submissions')
    .select('session_id')
    .in('session_id', sessions.map((s) => s.id))
    .neq('status', 'declined');
  for (const row of (counts ?? []) as { session_id: string | null }[]) {
    if (row.session_id) {
      sessionCounts[row.session_id] = (sessionCounts[row.session_id] ?? 0) + 1;
    }
  }
}

const sessionsWithPlaces = sessions.map((s) => {
  const count = sessionCounts[s.id] ?? 0;
  const remaining = Math.max(0, (s.max_candidates ?? 0) - count);
  return { ...s, remaining };
});

const hasSessions = sessionsWithPlaces.length > 0;

const schema = {
  type: 'WebPage' as const,
  data: {
    name: 'Rejoindre Biscuits IA - Devenir bénévole',
    description: 'Candidatez pour rejoindre Biscuits IA en bénévole. Découvrez les sessions de recrutement collectives et envoyez votre candidature.',
  },
};
---

<Layout
  title="Rejoindre Biscuits IA | Devenir bénévole"
  description="Rejoignez Biscuits IA en bénévole : sessions de recrutement collectives, candidature simple, mission d'interet general."
  schema={schema}
>
  <Breadcrumb />

  <section class="recruit-hero">
    <div class="container">
      <p class="eyebrow">Bénévolat</p>
      <h1>Rejoindre Biscuits IA</h1>
      <p class="lead">
        Biscuits IA est une association loi 1901 qui rend le numérique utile, sûr et accessible.
        Nous avons besoin de bénévoles motivés pour accompagner nos piliers : IA, cybercriminalité,
        logiciels libres, Anti Pepins et recherche participative.
      </p>
      <div class="hero-cta">
        <a href="#sessions" class="btn-primary">Voir les sessions</a>
        <a href="https://www.jeveuxaider.gouv.fr/organisations/34315-biscuits-ia" target="_blank" rel="noopener noreferrer" class="btn-ghost">
          Voir sur jeveuxaider.gouv
        </a>
      </div>
    </div>
  </section>

  <section class="recruit-why">
    <div class="container">
      <h2>Pourquoi devenir bénévole ?</h2>
      <div class="why-grid">
        <article class="why-card">
          <h3>Une mission concrète</h3>
          <p>Votre temps sert directement des projets à impact social : sensibilisation, outils libres, recherche utile.</p>
        </article>
        <article class="why-card">
          <h3>Du temps, pas des contraintes</h3>
          <p>Quelques heures par mois ou un engagement plus régulier : chaque contribution compte.</p>
        </article>
        <article class="why-card">
          <h3>Apprendre en faisant</h3>
          <p>IA, cybersécurité, design, recherche... Rejoignez une équipe curieuse et bienveillante.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="recruit-sessions" id="sessions">
    <div class="container">
      <h2>Sessions de recrutement</h2>
      {hasSessions ? (
        <>
          <p class="recruit-sessions__intro">
            Choisissez une session collective. Nous vous présenterons l'association, nos besoins et répondrons à vos questions.
          </p>
          <ul class="recruit-sessions__list">
            {sessionsWithPlaces.map((s) => {
              const scheduled = new Date(s.scheduled_at);
              const full = s.remaining === 0;
              return (
                <li class={`recruit-sessions__card ${full ? 'recruit-sessions__card--full' : ''}`} data-session-id={s.id}>
                  <div class="recruit-sessions__main">
                    <div class="recruit-sessions__title">{s.title}</div>
                    <div class="recruit-sessions__meta">
                      {scheduled.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })}
                      {' · '}{s.duration_minutes ?? 90} min
                      {s.location && ` · ${s.location}`}
                    </div>
                    {s.description && <p class="recruit-sessions__desc">{s.description}</p>}
                  </div>
                  <div class="recruit-sessions__actions">
                    <span class={`recruit-sessions__badge ${full ? 'recruit-sessions__badge--full' : ''}`}>
                      {full ? 'Complet' : `${s.remaining} place${s.remaining > 1 ? 's' : ''}`}
                    </span>
                    <button
                      type="button"
                      class="btn-primary btn-sm js-apply"
                      data-session-id={s.id}
                      data-session-title={s.title}
                      disabled={full}
                    >
                      {full ? 'Complet' : 'Candidater'}
                    </button>
                  </div>
                </li>
              );
            })}
          </ul>
        </>
      ) : (
        <p class="recruit-sessions__empty">
          Aucune session de recrutement n'est ouverte pour le moment. Vous pouvez tout de même nous envoyer une candidature spontanée ci-dessous.
        </p>
      )}
    </div>
  </section>

  <section class="recruit-form" id="formulaire" data-requires-auth={!user}>
    <div class="container">
      {!user && (
        <div class="recruit-form__notice" role="note">
          💡 <strong>Vous n'êtes pas connecté.</strong>
          <a href="/connexion?redirect=/rejoignez-nous&message=candidater">Connectez-vous</a> pour candidater à une session.
          Vous pourrez suivre votre candidature dans votre espace personnel.
        </div>
      )}
      {user && (
        <div class="recruit-form__notice recruit-form__notice--ok" role="note">
          ✅ Sélectionnez une session ci-dessus ou envoyez une candidature spontanée.
        </div>
      )}
      <h2>Ma candidature</h2>
      <div id="recruitment-form-root">
        <RecruitmentForm preselectedSessionId="" />
      </div>
    </div>
  </section>

  <section class="recruit-faq">
    <div class="container">
      <h2>Questions fréquentes</h2>
      <dl class="faq-list">
        <div class="faq-item">
          <dt>Qui peut candidater ?</dt>
          <dd>Tout le monde : étudiants, professionnels, retraités, curieux. L'envie d'aider compte plus que le CV.</dd>
        </div>
        <div class="faq-item">
          <dt>Combien de temps ça prend ?</dt>
          <dd>Une session dure environ 90 minutes. Ensuite, l'engagement est à votre rythme.</dd>
        </div>
        <div class="faq-item">
          <dt>Dois-je avoir des compétences techniques ?</dt>
          <dd>Non. Nous avons besoin de profils variés : communication, animation, recherche, dev, design, etc.</dd>
        </div>
      </dl>
    </div>
  </section>

  <dialog id="apply-modal" class="apply-modal">
    <div class="apply-modal__card">
      <button type="button" class="apply-modal__close js-modal-close" aria-label="Fermer">×</button>
      <h2 class="apply-modal__title" id="apply-modal-title">Candidater à une session</h2>
      <p class="apply-modal__session" id="apply-modal-session"></p>
      <div id="apply-modal-form">
        <RecruitmentForm preselectedSessionId="" />
      </div>
    </div>
  </dialog>
</Layout>

<script nonce={Astro.locals.nonce}>
  const applyButtons = document.querySelectorAll('.js-apply');
  const modal = document.getElementById('apply-modal');
  const modalTitle = document.getElementById('apply-modal-title');
  const modalSession = document.getElementById('apply-modal-session');
  const modalClose = document.querySelector('.js-modal-close');
  const isAuthRequired = document.querySelector('[data-requires-auth="true"]') !== null;

  const AUTH_REDIRECT = '/connexion?redirect=/rejoignez-nous&message=candidater';

  applyButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (isAuthRequired) {
        window.location.href = AUTH_REDIRECT;
        return;
      }

      const sessionId = btn.getAttribute('data-session-id');
      const sessionTitle = btn.getAttribute('data-session-title') || 'Session sélectionnée';
      if (!sessionId || !modal || !modalSession) return;

      if (modalTitle) modalTitle.textContent = 'Candidater à cette session';
      modalSession.textContent = sessionTitle;

      // Met à jour les radios de session dans la modale
      const formRoot = document.getElementById('apply-modal-form');
      if (formRoot) {
        const radios = formRoot.querySelectorAll('input[type="radio"][name="session_id"]');
        radios.forEach((radio) => {
          radio.checked = radio.value === sessionId;
        });
      }

      if (modal instanceof HTMLDialogElement) {
        modal.showModal();
      }
    });
  });

  modalClose?.addEventListener('click', () => {
    if (modal instanceof HTMLDialogElement) modal.close();
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal && modal instanceof HTMLDialogElement) {
      modal.close();
    }
  });
</script>

<style>
  .recruit-hero {
    padding: 5rem 1.5rem 3rem;
    background: var(--color-bg);
    text-align: center;
  }

  .recruit-hero .container {
    max-width: 880px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .recruit-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .lead {
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    font-weight: 800;
    text-decoration: none;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-sm {
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
    text-decoration: none;
    font-weight: 700;
  }

  .btn-ghost:hover {
    background: var(--color-bg-alt);
  }

  .recruit-why {
    padding: 4rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .recruit-why .container,
  .recruit-sessions .container,
  .recruit-form .container,
  .recruit-faq .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .recruit-why h2,
  .recruit-sessions h2,
  .recruit-form h2,
  .recruit-faq h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    text-align: center;
    margin: 0 0 1.5rem;
    color: var(--color-text);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1.5rem;
  }

  .why-card {
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
  }

  .why-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .why-card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }

  .recruit-sessions {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .recruit-sessions__intro {
    text-align: center;
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .recruit-sessions__empty {
    text-align: center;
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
  }

  .recruit-sessions__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .recruit-sessions__card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    justify-content: space-between;
    padding: 1.25rem;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
  }

  .recruit-sessions__card--full {
    opacity: 0.7;
  }

  .recruit-sessions__main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .recruit-sessions__title {
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .recruit-sessions__meta {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .recruit-sessions__desc {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.5;
    margin: 0.25rem 0 0;
  }

  .recruit-sessions__actions {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .recruit-sessions__badge {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 0.65rem;
    border: 2px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .recruit-sessions__badge--full {
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    color: var(--color-danger);
    border-color: var(--color-danger);
  }

  .recruit-form {
    padding: 4rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .recruit-form h2 {
    margin-bottom: 1.5rem;
  }

  .recruit-form__notice {
    padding: 1rem 1.25rem;
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    color: var(--color-text);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .recruit-form__notice a {
    color: var(--color-primary-dark);
    font-weight: 700;
    text-decoration: underline;
  }

  .recruit-form__notice--ok {
    background: color-mix(in srgb, var(--color-success) 10%, transparent);
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .recruit-faq {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 1.25rem;
  }

  .faq-item dt {
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .faq-item dd {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
  }

  .apply-modal {
    border: none;
    padding: 0;
    background: transparent;
    max-width: none;
    max-height: none;
  }

  .apply-modal::backdrop {
    background: rgba(15, 23, 42, 0.35);
  }

  .apply-modal__card {
    width: min(680px, 94vw);
    max-height: 90vh;
    overflow-y: auto;
    border: var(--brutal-border, 2px solid var(--color-border));
    background: var(--color-bg);
    padding: 2rem;
    position: relative;
  }

  .apply-modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 36px;
    height: 36px;
    border: 2px solid var(--color-border);
    background: var(--color-bg-alt);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .apply-modal__title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
    color: var(--color-text);
  }

  .apply-modal__session {
    color: var(--color-text-light);
    margin: 0 0 1.25rem;
  }

  @media (max-width: 640px) {
    .recruit-sessions__card {
      flex-direction: column;
      gap: 0.75rem;
    }

    .recruit-sessions__actions {
      align-items: flex-start;
    }

    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-ghost {
      text-align: center;
    }

    .apply-modal__card {
      width: 100vw;
      max-height: 100vh;
      padding: 1.25rem;
    }
  }
</style>
