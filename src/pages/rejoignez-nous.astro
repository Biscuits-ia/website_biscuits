---export const prerender = true;



import BaseLayout from '@/layouts/Layout.astro';
import RecruitmentForm from '@/components/Recruitmentform.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
---

<BaseLayout
  title="Rejoindre Biscuits IA | Association pour une IA accessible à tous"
  description="Devenez bénévole ou contributeur chez Biscuits IA ! Participez à notre mission d'intérêt général."
>
  <Breadcrumb />
  <!-- H1 de page : le formulaire (Recruitmentform) injecte son propre h1
       dans son DOM, mais ce h1 specifique sert de fallback statique pour
       les lecteurs d'ecran et le plan du document. -->
  <h1 class="visually-hidden">Rejoindre l'association Biscuits IA</h1>
  <RecruitmentForm />
</BaseLayout>
