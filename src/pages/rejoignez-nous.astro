---export const prerender = true;



import BaseLayout from '@/layouts/Layout.astro';
import RecruitmentForm from '@/components/Recruitmentform.astro';
---

<BaseLayout
  title="Rejoindre Biscuits IA | Association pour une IA accessible à tous"
  description="Devenez bénévole ou contributeur chez Biscuits IA ! Participez à notre mission d'intérêt général."
>
  <!-- H1 de page rendu en premier pour respecter la hierarchie WCAG 1.3.1.
       Le formulaire (Recruitmentform) injecte son propre h1 dans son DOM,
       mais ce h1 specifique sert de fallback statique pour les lecteurs
       d'ecran et le plan du document. -->
  <h1 class="visually-hidden">Rejoindre l'association Biscuits IA</h1>
  <RecruitmentForm />
</BaseLayout>
