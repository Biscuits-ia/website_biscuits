---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const ressources = [
  {
    categorie: 'Sécurité & Arnaques',
    icon: '🛡️',
    items: [
      {
        titre: 'Checklist anti-arnaque',
        format: 'PDF',
        url: '/ressources/checklist-anti-arnaque.pdf',
      },
      {
        titre: 'Guide phishing pour associations',
        format: 'PDF',
        url: '/ressources/guide-phishing-associations.pdf',
      },
    ],
  },
  {
    categorie: 'RGPD & Conformité',
    icon: '🔒',
    items: [
      { titre: 'Checklist RGPD complète', format: 'PDF', url: '/ressources/checklist-rgpd.pdf' },
    ],
  },
  /**
   * Note : les ressources IA sont en cours de finalisation, à venir bientôt !
  {
    categorie: "Outils & Numérique",
    icon: "🛠️",
    items: [
      { titre: "Liste outils open source pour associations 2026", format: "PDF", url: "/ressources/outils-open-source-associations-2026.pdf" },
    ]
  }
   */
];
---

<Layout
  title="Guides & Ressources | Biscuits IA"
  description="Téléchargez nos guides, checklists et templates gratuits pour votre association ou petite structure : RGPD, cybersécurité, outils numériques."
>
  <Breadcrumb />
  <section class="ressources-hero">
    <div class="ressources-hero__inner">
      <h1>Guides &amp; Ressources</h1>
      <p>
        Des modèles, checklists et guides pratiques téléchargeables gratuitement pour aider les
        associations et petites structures dans leur transition numérique.
      </p>
    </div>
  </section>

  <section class="ressources-section">
    <div class="ressources-container">
      {
        ressources.map((cat) => (
          <div class="ressources-categorie">
            <h2>
              {cat.icon} {cat.categorie}
            </h2>
            <ul class="ressources-list">
              {cat.items.map((item) => (
                <li class="ressources-item">
                  <a href={item.url} class="ressources-link" download>
                    <span class="ressources-titre">{item.titre}</span>
                    <span class="ressources-format badge">{item.format}</span>
                    <span class="ressources-dl">⬇ Télécharger</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="ressources-cta-section">
    <div class="ressources-cta-inner">
      <h2>Besoin d'un accompagnement personnalisé ?</h2>
      <p>
        Notre équipe peut vous aider à mettre en œuvre ces ressources. Contactez-nous ou rejoignez
        la communauté.
      </p>
      <div class="ressources-cta-btns">
        <a href="/contact" class="cta-button">Nous contacter</a>
        <a href="/rejoignez-nous" class="cta-btn cta-btn--outline">Rejoindre la communauté</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ressources-hero {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: var(--color-bg-elevated);
    padding: 4rem 1rem 3rem;
    text-align: center;
  }
  .ressources-hero__inner {
    max-width: 700px;
    margin: 2rem auto;
  }
  .ressources-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .ressources-section {
    padding: 3rem 1rem;
  }
  .ressources-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .ressources-categorie h2 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-honey);
    padding-bottom: 0.4rem;
  }
  .ressources-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ressources-item {
    background: var(--color-bg-alt);
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border-second);
    transition:
      box-shadow 0.2s,
      transform 0.15s;
  }
  .ressources-item:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .ressources-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    text-decoration: none;
    color: var(--color-text);
  }
  .ressources-titre {
    flex: 1;
    font-weight: 500;
  }
  .badge {
    background: var(--color-accent-honey);
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .ressources-dl {
    color: var(--color-secondary);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .ressources-cta-section {
    background: var(--color-bg-alt);
    padding: 3rem 1rem;
    text-align: center;
  }
  .ressources-cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .ressources-cta-inner h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }
  .ressources-cta-btns {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .cta-btn--outline {
    background: transparent;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
  }
  .cta-btn--outline:hover {
    background: var(--color-primary);
    color: var(--color-bg-alt);
  }
</style>
