---
import '@/styles/global.css'
import BaseLayout from '@layouts/Layout.astro';
import Service from '@/components/Services.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Services Biscuits AI",
  "provider": {
    "@type": "Organization",
    "name": "Biscuits AI"
  },
  "description": "Starterkits Next.js / Astro, outils IA, automatisations, prompts avancés et consulting.",
  "url": "https://biscuits.dev/services"
};
---

<BaseLayout
  title="Tous nos Services IA"
  description="Consultez les services proposer."
  structuredData={structuredData}
>
  <section class="services-hero">
    <div class="container">
      <h1 class="text-center title">Nos Services</h1>
      <p class="lead">
        Solutions complètes pour Vibe coder
      </p>
    </div>
  </section>

  <section class="services-list">
    <div class="container">
      <Service client:load />
    </div>
  </section>
  
  <section class="cta-section">
    <div class="container">
      <h2>Besoin d'un service informatique ?</h2>
      <p>Devis gratuit et sans engagement</p>
      <div class="cta-buttons">
        <a href="/devis" class="btn-primary">Demander un devis</a>
      </div>
    </div>
  </section>
</BaseLayout>