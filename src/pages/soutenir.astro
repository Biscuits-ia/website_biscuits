---
// src/pages/soutenir.astro
// Page Soutenir l'association : don, adhesion, benevolat.
// Le sujet de la page peut etre precise via ?sujet=soutenir-recherche
// (utilise depuis le pilier 5 pour orienter le formulaire contact).
// Le sujet est lu cote client (page prerendered, donc pas de searchParams
// cote serveur sans SSR).

export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const sujetAfficheDefaut = 'Soutenir Biscuits IA';
const HELLOASSO_URL = 'https://www.helloasso.com/associations/biscuits-ia/formulaires/2';

const schema = {
  type: 'WebPage' as const,
  data: {
    name: 'Soutenir Biscuits IA',
    description:
      "Trois facons de soutenir Biscuits IA : faire un don, adherer a l'association, ou donner du temps en benevolat. Association Loi 1901, recu fiscal des 10 EUR.",
  },
};

// Ce que finance concretement un don, aligne sur les 4 piliers reels de
// l'association (cf. PillarsGrid.astro) -- pas de chiffre invente, uniquement
// la description deja etablie ailleurs sur le site.
const financements = [
  {
    icon: '🎓',
    titre: "Ateliers d'accompagnement a l'IA",
    description:
      "Sessions gratuites pour le grand public, les associations et les collectivites qui n'ont pas les moyens de se payer un consultant.",
  },
  {
    icon: '🧩',
    titre: 'Logiciels libres pour associations',
    description:
      "Developpement et maintenance d'outils libres, auditables et gratuits pour les structures d'interet general.",
  },
  {
    icon: '🛡️',
    titre: 'Anti Pepins',
    description:
      "Hebergement et developpement continu du service public d'analyse anti-arnaque, gratuit, anonyme et sans inscription.",
  },
  {
    icon: '🔬',
    titre: 'Recherche participative',
    description:
      "Modeles ouverts pour l'agriculture et la sante : le pilier que le marche ne finance pas, faute de client a facturer.",
  },
];

const facons = [
  {
    icon: '❤',
    titre: 'Faire un don',
    description:
      "Un don ponctuel, quel que soit son montant, part directement dans les quatre piliers ci-dessus. Aucune part ne remunere d'actionnaire : il n'y en a pas.",
    href: HELLOASSO_URL,
    externe: true,
    cta: 'Donner sur HelloAsso',
    feature: true,
  },
  {
    icon: '✍',
    titre: "Adherer a l'association",
    description:
      "A partir de 10 EUR/an, vous soutenez la mission et vous beneficiez des ressources membres en avant-premiere. L'adhesion donne aussi voix au chapitre lors de l'assemblee generale.",
    href: '/rejoignez-nous',
    externe: false,
    cta: 'Adherer',
    feature: false,
  },
  {
    icon: '⚡',
    titre: 'Donner du temps',
    description:
      'Benevolat technique, juridique, communication, evenementiel, terrain (agriculture, sante). Quelques heures par mois suffisent. On vous forme et on vous accompagne.',
    href: '/rejoignez-nous',
    externe: false,
    cta: 'Voir les besoins',
    feature: false,
  },
];

const faq = [
  {
    q: 'Le paiement est-il securise ?',
    r: "Oui. Les dons passent par HelloAsso, plateforme de paiement associative agreee, hors de ce site. Biscuits IA ne stocke ni ne voit jamais vos coordonnees bancaires.",
  },
  {
    q: "J'ai un recu pour mon don ?",
    r: "Un recu fiscal est delivre automatiquement des 10 EUR de don, envoye par email depuis HelloAsso.",
  },
  {
    q: 'Mon don finance quel projet precisement ?',
    r: "Un don libre part dans le budget general, reparti selon les besoins du moment entre les quatre piliers (voir ci-dessus). Pour flecher votre don vers un projet precis (la recherche, par exemple), precisez-le dans le formulaire HelloAsso ou ecrivez-nous avant de donner.",
  },
  {
    q: 'Je represente une entreprise ou une collectivite, comment faire ?',
    r: "Le don individuel via HelloAsso fonctionne aussi pour une structure. Pour un partenariat plus consequent (mecenat de competences, financement d'un projet, convention), ecrivez-nous : on construit ca ensemble.",
  },
];
---

<Layout
  title="Soutenir Biscuits IA | Association Loi 1901"
  description="Trois facons de soutenir Biscuits IA : faire un don, adherer a l'association, ou donner du temps en benevolat. Recu fiscal des 10 EUR."
  schema={schema}
>
  <Breadcrumb />

  <section class="sout-hero">
    <div class="container">
      <p class="eyebrow">Soutenir l'association</p>
      <h1>Une association Loi 1901, financee par ceux qui l'utilisent</h1>
      <p class="lead">
        Biscuits IA ne cherche pas la croissance : elle cherche l'impact. Nos tarifs (logiciels,
        ateliers, accompagnements) sont calcules au plus juste pour financer la mission, jamais
        pour remunerer des actionnaires — il n'y en a pas. Votre don complete ce financement
        pour ce que le marche ne couvre pas : la recherche participative, l'acces gratuit pour
        les publics vulnerables, et les ressources libres.
      </p>
      <div class="hero-cta">
        <a href="#don" class="btn-primary">Faire un don</a>
        <a href="#ou-va-largent" class="btn-ghost">Voir ou va votre don</a>
      </div>
      <p class="trust-strip">
        <span>Association Loi 1901</span>
        <span aria-hidden="true">·</span>
        <span>Pas d'actionnaires, pas de publicite</span>
        <span aria-hidden="true">·</span>
        <span>Recu fiscal des 10 EUR</span>
      </p>
    </div>
  </section>

  <section class="funding" id="ou-va-largent">
    <div class="container">
      <h2>Ou va votre don</h2>
      <p class="funding-intro">
        Quatre piliers, un seul objectif : rendre le numerique utile et sur pour celles et ceux
        que le marche laisse de cote. Voici concretement ce que finance votre don.
      </p>
      <div class="funding-grid">
        {
          financements.map((f) => (
            <article class="funding-card">
              <span class="funding-icon" aria-hidden="true">
                {f.icon}
              </span>
              <h3>{f.titre}</h3>
              <p>{f.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ways">
    <div class="container">
      <h2>Trois facons de nous aider</h2>
      <div class="ways-grid">
        {
          facons.map((f) => (
            <article
              class={`way-card${f.feature ? ' way-card--feature' : ''}`}
              id={f.feature ? 'don' : undefined}
            >
              {f.feature && <span class="way-badge">Le plus direct</span>}
              <span class="way-icon" aria-hidden="true">
                {f.icon}
              </span>
              <h3>{f.titre}</h3>
              <p>{f.description}</p>

              <a
                href={f.href}
                class="way-cta"
                {...(f.externe ? { rel: 'noopener noreferrer', target: '_blank' } : {})}
              >
                {f.cta}
                {f.externe && (
                  <span class="way-ext" aria-hidden="true">
                    ↗
                  </span>
                )}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="why-research">
    <div class="container">
      <p class="eyebrow">Zoom sur le pilier 4</p>
      <h2>Pourquoi la recherche a besoin de vous en particulier</h2>
      <p>
        La recherche participative et les modeles ouverts au service de l'agriculture et de la
        sante, c'est le pilier que le marche finance le moins : pas de SaaS a vendre, pas de
        client direct a facturer. Un modele ouvert, documente en francais, ne rapporte rien a
        court terme — mais il peut aider des milliers de personnes a prendre de meilleures
        decisions.
      </p>
      <ul>
        <li>
          <strong>Co-financer une etude.</strong> Une parcelle pilote, une enquete de terrain, un
          prototype de modele : comptez 500 a 5000 EUR par projet selon l'ampleur.
        </li>
        <li>
          <strong>Financer une these ou un stage.</strong> 6 a 12 mois de travail encadre sur une
          question de recherche concrete, avec livrables libres.
        </li>
        <li>
          <strong>Mettre a disposition une donnee ou un terrain.</strong> Pas d'argent, mais un
          acces a des donnees reelles : c'est parfois plus precieux qu'un cheque.
        </li>
      </ul>
      <p class="why-foot">
        Vous etes une structure (collectivite, fondation, laboratoire, association soeur) ? On
        etablit ensemble un partenariat structure. <a href="/contact?sujet=partenariat"
          >Discutons-en</a
        >.
      </p>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2>Questions frequentes</h2>
      <div class="faq-list">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.r}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="contact-cta">
    <div class="container">
      <h2>Une autre idee ? Un coup de main en nature ?</h2>
      <p>
        Un echange de 20 minutes suffit pour voir ensemble comment contribuer. C'est gratuit, sans
        engagement, et on repond a tout le monde.
      </p>
      <div class="contact-actions">
        <a href="/contact?sujet=soutenir" class="btn-primary" data-contact-sujet>
          Nous ecrire (<span data-sujet-label>{sujetAfficheDefaut}</span>)
        </a>
        <a href="/contact?sujet=partenariat" class="btn-ghost"> Proposer un partenariat </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Adapter dynamiquement le label et le href du bouton contact
  // en fonction de la querystring ?sujet=soutenir-recherche.
  const labels: Record<string, string> = {
    'soutenir-recherche': 'Soutenir la recherche associative',
  };
  const sujet = new URLSearchParams(window.location.search).get('sujet');
  if (sujet && labels[sujet]) {
    const cta = document.querySelector<HTMLAnchorElement>('[data-contact-sujet]');
    const label = document.querySelector<HTMLElement>('[data-sujet-label]');
    if (cta) cta.href = `/contact?sujet=${sujet}`;
    if (label) label.textContent = labels[sujet];
  }
</script>

<style>
  .sout-hero {
    padding: 5rem 1.5rem 3rem;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    text-align: center;
  }

  .sout-hero .container {
    max-width: 820px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .sout-hero h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 900;
    margin: 0 0 1rem;
    color: var(--color-text);
    line-height: 1.15;
  }

  .lead {
    color: var(--color-text-light);
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .trust-strip {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
    color: var(--color-text-light);
    font-size: 0.85rem;
    font-weight: 700;
    margin: 0;
  }

  .funding {
    padding: 4rem 1.5rem;
    background: var(--color-bg-alt);
    scroll-margin-top: 2rem;
  }

  .funding .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .funding h2 {
    text-align: center;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  .funding-intro {
    text-align: center;
    color: var(--color-text-light);
    line-height: 1.6;
    max-width: 640px;
    margin: 0 auto 2.5rem;
  }

  .funding-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1.25rem;
  }

  .funding-card {
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .funding-icon {
    font-size: 1.9rem;
    line-height: 1;
  }

  .funding-card h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
  }

  .funding-card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
    font-size: 0.9rem;
  }

  .ways {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .ways .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .ways h2 {
    text-align: center;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0 0 2rem;
    color: var(--color-text);
  }

  .ways-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1.5rem;
  }

  .way-card {
    position: relative;
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .way-card--feature {
    border-width: 3px;
    background: var(--color-bg-elevated);
    box-shadow: 6px 6px 0 var(--color-border);
    scroll-margin-top: 2rem;
  }

  .way-badge {
    position: absolute;
    top: -0.7rem;
    left: 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg-alt);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border: 2px solid var(--color-border);
  }

  .way-icon {
    font-size: 2.2rem;
    line-height: 1;
  }

  .way-card h3 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
  }

  .way-card p {
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
    font-size: 0.95rem;
  }

  .way-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.7rem 1.25rem;
    background: var(--color-primary);
    color: var(--color-bg-alt);
    font-weight: 800;
    font-size: 0.95rem;
    border: 2px solid var(--color-border);
    text-decoration: none;
    margin-top: auto;
  }

  .way-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
    color: var(--color-bg-alt);
  }

  .way-ext {
    font-size: 0.85em;
  }

  .why-research {
    padding: 4rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .why-research .container {
    max-width: 820px;
    margin: 0 auto;
  }

  .why-research .eyebrow {
    text-align: left;
  }

  .why-research h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .why-research p {
    color: var(--color-text);
    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .why-research ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .why-research li {
    background: var(--color-bg-elevated);
    border-left: 4px solid var(--color-primary);
    padding: 0.85rem 1rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .why-research strong {
    color: var(--color-primary);
  }

  .why-foot {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    color: var(--color-text-light) !important;
  }

  .why-foot a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .why-foot a:hover {
    text-decoration: underline;
  }

  .faq {
    padding: 4rem 1.5rem;
    background: var(--color-bg);
  }

  .faq .container {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq h2 {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 2rem;
    color: var(--color-text);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    padding: 0;
  }

  .faq-item summary {
    cursor: pointer;
    padding: 1.1rem 1.35rem;
    font-weight: 800;
    color: var(--color-text);
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-primary);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    margin: 0;
    padding: 0 1.35rem 1.25rem;
    color: var(--color-text-light);
    line-height: 1.6;
  }

  .contact-cta {
    padding: 4rem 1.5rem 5rem;
    background: var(--color-bg);
    text-align: center;
  }

  .contact-cta .container {
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-cta h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  .contact-cta p {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .contact-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    font-weight: 800;
    text-decoration: none;
  }

  .btn-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-border);
    color: var(--color-bg-alt);
  }

  .btn-ghost {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
    text-decoration: none;
    font-weight: 700;
  }

  .btn-ghost:hover {
    background: var(--color-bg-alt);
  }
</style>
