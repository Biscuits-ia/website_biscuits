---
import BaseLayout from '@layouts/Layout.astro';

---

<BaseLayout
  title="Tarifs & Prix | Biscuits IA"
  description="Tarification claire et transparente pour vos projets IA et automatisations. Étude et devis gratuits."
>
  <section class="tarifs-hero">
    <div class="container">
      <h1>Tarifs & Prix</h1>
      <p class="hero-lead">
        Tarification claire pour vos projets IA. Étude et devis gratuits.
      </p>
      <div class="hero-badges">
        <span class="badge">Aucun frais caché</span>
        <span class="badge">Devis détaillé gratuit</span>
        <span class="badge">100% remote</span>
      </div>
    </div>
  </section>

  <section class="tarifs-main">
    <div class="container">
      
      <div class="pricing-section">
        <div class="pricing-header">
          <h2>Assistants IA personnalisés</h2>
          <p>Conception et déploiement d'agents IA adaptés à vos besoins métiers</p>
        </div>

        <div class="pricing-table">
          <div class="pricing-row header">
            <div class="col-service">Prestation</div>
            <div class="col-price">Tarif HT</div>
            <div class="col-duration">Délai</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Étude & cadrage IA</strong>
              <small>Analyse du besoin, cas d'usage, faisabilité</small>
            </div>
            <div class="col-price highlight">Gratuit</div>
            <div class="col-duration">30-45 min</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Assistant IA simple</strong>
              <small>FAQ, support, agent interne</small>
            </div>
            <div class="col-price">À partir de 900€</div>
            <div class="col-duration">4-7 jours</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Assistant IA avancé</strong>
              <small>Multi-sources, logique métier, API</small>
            </div>
            <div class="col-price">À partir de 2 300€</div>
            <div class="col-duration">2-3 semaines</div>
          </div>
        </div>
      </div>

      <div class="pricing-section">
        <div class="pricing-header">
          <h2>Automatisation de workflows</h2>
          <p>Gagnez du temps en automatisant vos processus avec l'IA</p>
        </div>

        <div class="pricing-packages">
          <div class="package-card">
            <h3>Workflow simple</h3>
            <div class="package-price">
              <span class="amount">600€</span>
              <span class="period">HT</span>
            </div>
            <ul>
              <li>Automatisation d'une tâche</li>
              <li>IA + règles simples</li>
              <li>Tests & mise en production</li>
              <li>Documentation</li>
            </ul>
          </div>

          <div class="package-card featured">
            <div class="package-badge">Populaire</div>
            <h3>Workflow avancé</h3>
            <div class="package-price">
              <span class="amount">1700€</span>
              <span class="period">HT</span>
            </div>
            <ul>
              <li>Multi-étapes</li>
              <li>IA + APIs externes</li>
              <li>Logs & monitoring</li>
              <li>Formation 1h</li>
            </ul>
          </div>

          <div class="package-card">
            <h3>Automatisation sur mesure</h3>
            <div class="package-price">
              <span class="amount">Sur devis</span>
            </div>
            <ul>
              <li>Processus complexes</li>
              <li>Connexion SI / SaaS</li>
              <li>Maintenance optionnelle</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="tarifs-faq">
        <h2>Questions fréquentes</h2>
        
        <details class="faq-item">
          <summary>Comment se déroule un projet Biscuits IA ?</summary>
          <p>
            Chaque projet commence par une phase de cadrage gratuite afin de définir
            précisément vos besoins et la solution IA la plus adaptée.
          </p>
        </details>

        <details class="faq-item">
          <summary>Les tarifs sont-ils fixes ?</summary>
          <p>
            Les tarifs affichés sont indicatifs. Un devis personnalisé est établi
            en fonction de la complexité et des objectifs du projet.
          </p>
        </details>

        <details class="faq-item">
          <summary>Travaillez-vous uniquement à distance ?</summary>
          <p>
            Oui, tous les projets sont réalisés à distance, ce qui permet plus de
            flexibilité et de réactivité.
          </p>
        </details>

        <details class="faq-item">
          <summary>Proposez-vous un accompagnement après livraison ?</summary>
          <p>
            Oui, un accompagnement et des évolutions peuvent être proposés via des
            forfaits ou abonnements adaptés.
          </p>
        </details>

        <details class="faq-item">
          <summary>Mes données sont-elles en sécurité ?</summary>
          <p>
            Oui. La confidentialité et la sécurité des données sont une priorité
            dans tous les projets Biscuits IA.
          </p>
        </details>
      </div>

    </div>
  </section>

  <section class="tarifs-cta">
    <div class="container">
      <h2>Prêt à démarrer votre projet ?</h2>
      <p>Demandez un devis personnalisé, gratuit et sans engagement.</p>
      <div class="cta-actions">
        <a href="/devis" class="btn-primary">Demander un devis</a>
        <a href="/contact" class="btn-secondary">Nous contacter</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tarifs-hero {
    padding: 6rem var(--spacing-lg) 4rem;
    text-align: center;
    background: var(--color-bg);
  }

  .tarifs-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }

  .hero-lead {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--color-text-light);
    margin-bottom: var(--spacing-xl);
  }

  .hero-badges {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .badge {
    background: var(--color-bg-alt);
    padding: var(--spacing-sm) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    border: 2px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .badge:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .tarifs-main {
    padding: 4rem var(--spacing-lg);
    background: var(--color-bg);
  }

  .pricing-section {
    margin-bottom: 6rem;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .pricing-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }

  .pricing-header p {
    color: var(--color-text-light);
    font-size: 1.125rem;
  }

  .pricing-table {
    background: var(--color-bg-alt);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    border: 2px solid var(--color-border);
    max-width: 1000px;
    margin: 0 auto;
  }

  .pricing-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--spacing-lg);
    padding: var(--spacing-xl);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
    transition: all var(--transition-base);
  }

  .pricing-row:last-child {
    border-bottom: none;
  }

  .pricing-row:hover:not(.header) {
    background: var(--color-bg-elevated);
  }

  .pricing-row.header {
    background: var(--color-bg-elevated);
    font-weight: 700;
    color: var(--color-text);
  }

  .col-service strong {
    display: block;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
    font-weight: 700;
  }

  .col-service small {
    color: var(--color-text-light);
    font-size: 0.9rem;
  }

  .col-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    text-align: center;
  }

  .col-price.highlight {
    color: var(--color-first);
    font-size: 1.75rem;
  }

  .col-duration {
    text-align: center;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .pricing-packages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-2xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  .package-card {
    background: var(--color-bg-alt);
    padding: var(--spacing-3xl) var(--spacing-2xl);
    border-radius: var(--radius-2xl);
    border: 2px solid var(--color-border);
    position: relative;
    transition: all var(--transition-base);
  }

  .package-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-xl);
  }

  .package-card.featured {
    border-color: var(--color-primary);
    background: var(--color-bg-elevated);
    border-width: 3px;
  }

  .package-badge {
    position: absolute;
    top: -15px;
    right: 2rem;
    background: var(--color-primary);
    color: var(--color-bg);
    padding: var(--spacing-sm) var(--spacing-lg);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .package-card h3 {
    font-size: 1.75rem;
    text-align: center;
    margin-bottom: var(--spacing-xl);
    color: var(--color-text);
    font-weight: 800;
  }

  .package-price {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-2xl);
    border-bottom: 2px solid var(--color-border);
  }

  .package-price .amount {
    display: block;
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .package-price .period {
    font-size: 0.9rem;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .package-card ul {
    list-style: none;
    padding: 0;
  }

  .package-card li {
    padding: var(--spacing-sm) 0 var(--spacing-sm) var(--spacing-xl);
    line-height: 1.6;
    color: var(--color-text);
    position: relative;
    font-weight: 500;
  }

  .package-card li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-first);
    font-weight: bold;
    font-size: 1.2rem;
  }

  .tarifs-faq {
    max-width: 900px;
    margin: 4rem auto 0;
  }

  .tarifs-faq h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--spacing-2xl);
  }

  .faq-item {
    background: var(--color-bg-alt);
    margin-bottom: var(--spacing-md);
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-border);
    border-left-width: 4px;
    border-left-color: var(--color-primary);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .faq-item:hover {
    background: var(--color-bg-elevated);
    transform: translateX(5px);
  }

  .faq-item summary {
    padding: var(--spacing-lg);
    cursor: pointer;
    font-weight: 700;
    font-size: 1.1rem;
    list-style: none;
    transition: color var(--transition-fast);
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::before {
    content: '▶';
    display: inline-block;
    transition: transform var(--transition-base);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .faq-item[open] summary::before {
    transform: rotate(90deg);
  }

  .faq-item summary:hover {
    color: var(--color-primary);
  }

  .faq-item summary:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .faq-item p {
    padding: 0 var(--spacing-lg) var(--spacing-lg);
    color: var(--color-text-light);
    line-height: 1.7;
    font-weight: 500;
  }

  .tarifs-cta {
    padding: 4rem var(--spacing-lg);
    text-align: center;
    background: var(--color-bg-alt);
    margin-top: 4rem;
  }

  .tarifs-cta h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }

  .tarifs-cta p {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--color-text-light);
    margin-bottom: var(--spacing-xl);
  }

  .cta-actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: var(--radius-lg);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .btn-secondary {
    background: var(--color-bg);
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-primary);
  }

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .pricing-row {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .col-service small {
      display: block;
      margin-top: var(--spacing-sm);
    }

    .pricing-packages {
      grid-template-columns: 1fr;
    }

    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge,
    .pricing-row,
    .package-card,
    .faq-item,
    .btn-primary,
    .btn-secondary {
      transition: none;
    }
    
    .badge:hover,
    .package-card:hover,
    .faq-item:hover,
    .btn-primary:hover {
      transform: none;
    }
  }
</style>