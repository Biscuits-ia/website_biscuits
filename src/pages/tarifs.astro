---
import '@/styles/global.css'
import BaseLayout from '@layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "name": "Tarifs Biscuits AI – Solutions IA",
  "url": "https://biscuits.dev/tarifs",
  "itemListElement": [
    {
      "@type": "Service",
      "name": "Assistant IA personnalisé",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "EUR",
        "price": "900"
      }
    },
    {
      "@type": "Service",
      "name": "Automatisation de workflows IA",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "EUR",
        "price": "800"
      }
    },
    {
      "@type": "Service",
      "name": "Développement SaaS IA",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "EUR",
        "price": "3000"
      }
    }
  ]
};

---


<BaseLayout
  title="Tarifs Solutions IA & Automatisation | Biscuits IA"
  description="Tarifs Biscuits IA : assistants IA, automatisation de workflows et solutions IA sur mesure. Devis gratuit."
  structuredData={structuredData}
>
  <section class="tarifs-hero">
    <div class="container">
      <h1>Nos Tarifs</h1>
      <p class="hero-subtitle">
        Tarification claire pour vos projets IA. Étude et devis gratuits.
      </p>
      <div class="hero-badges">
        <span class="badge">💯 Aucun frais caché</span>
        <span class="badge">📋 Devis détaillé gratuit</span>
        <span class="badge">🌍 100% remote</span>

      </div>
    </div>
  </section>

  <section class="tarifs-main">
    <div class="container">
      <!-- Dépannage -->
      <div class="service-pricing">
        <div class="service-pricing">
  <div class="pricing-header">
    <h2>🤖 Assistants IA personnalisés</h2>
    <p>Conception et déploiement d’agents IA adaptés à vos besoins métiers</p>
  </div>

  <div class="pricing-table">
    <div class="pricing-row header">
      <div class="col-service">Prestation</div>
      <div class="col-price">Tarif HT</div>
      <div class="col-duration">Délai</div>
    </div>

    <div class="pricing-row">
      <div class="col-service">
        <strong>Étude & cadrage IA</strong>
        <small>Analyse du besoin, cas d’usage, faisabilité</small>
      </div>
      <div class="col-price highlight">Gratuit</div>
      <div class="col-duration">30–45 min</div>
    </div>

    <div class="pricing-row">
      <div class="col-service">
        <strong>Assistant IA simple</strong>
        <small>FAQ, support, agent interne</small>
      </div>
      <div class="col-price">À partir de 900€</div>
      <div class="col-duration">4–7 jours</div>
    </div>

    <div class="pricing-row">
      <div class="col-service">
        <strong>Assistant IA avancé</strong>
        <small>Multi-sources, logique métier, API</small>
      </div>
      <div class="col-price">À partir de 2 300€</div>
      <div class="col-duration">2-3 semaines</div>
    </div>
  </div>
</div>


      <!-- Serveur Linux -->
      <div class="service-pricing">
  <div class="pricing-header">
    <h2>⚙️ Automatisation de workflows</h2>
    <p>Gagnez du temps en automatisant vos processus avec l’IA</p>
  </div>

  <div class="pricing-packages">
    <div class="package-card">
      <h3>Workflow simple</h3>
      <div class="package-price">
        <span class="amount">600€</span>
        <span class="period">HT</span>
      </div>
      <ul>
        <li>Automatisation d’une tâche</li>
        <li>IA + règles simples</li>
        <li>Tests & mise en production</li>
        <li>Documentation</li>
      </ul>
    </div>

    <div class="package-card featured">
      <div class="package-badge">Populaire</div>
      <h3>Workflow avancé</h3>
      <div class="package-price">
        <span class="amount">1700€</span>
        <span class="period">HT</span>
      </div>
      <ul>
        <li>Multi-étapes</li>
        <li>IA + APIs externes</li>
        <li>Logs & monitoring</li>
        <li>Formation 1h</li>
      </ul>
    </div>

    <div class="package-card">
      <h3>Automatisation sur mesure</h3>
      <div class="package-price">
        <span class="amount">Sur devis</span>
      </div>
      <ul>
        <li>Processus complexes</li>
        <li>Connexion SI / SaaS</li>
        <li>Maintenance optionnelle</li>
      </ul>
    </div>
  </div>
</div>


      <!-- NAS -->
      <div class="service-pricing">
        <div class="pricing-header">
          <h2>🧩 Outils IA & SaaS</h2>
          <p>Création d’outils intelligents et de solutions SaaS basées sur l’IA</p>
        </div>

        <div class="pricing-packages">
          <div class="package-card">
            <h3>Outil IA simple</h3>
            <div class="package-price">
              <span class="amount">700€</span>
              <span class="period">HT</span>
            </div>
            <ul>
              <li>  Installation Fonctionnalité IA ciblée</li>
              <li>  Interface simple</li>
              <li>  Connexion API</li>
              <li>  Déploiement initial</li>
              <li>  Documentation</li>
            </ul>
            <p class="duration-note">⏱️ Environ 2h</p>
          </div>

          <div class="package-card featured">
            <div class="package-badge">Recommandé</div>
            <h3>SaaS IA</h3>
            <div class="package-price">
              <span class="amount">5000€</span>
              <span class="period">HT</span>
            </div>
            <ul>
              <li>  Backend + IA</li>
              <li>  Authentification</li>
              <li>  API & intégrations</li>
              <li>  Architecture scalable</li>
              <li>  Accompagnement initial</li>
            </ul>
            <p class="duration-note">⏱️ Environ 4-5h</p>
          </div>

          <div class="package-card">
            <h3>Solution IA sur mesure</h3>
            <div class="package-price">
              <span class="amount">Sur devis</span>
            </div>
            <ul>
              <li>  Architecture personnalisée</li>
              <li>  Intégration SI / SaaS</li>
              <li>  Scalabilité avancée</li>
              <li>  Monitoring IA</li>
              <li>  Évolutions continues</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Audit & Conseil -->
      <div class="service-pricing">
        <div class="pricing-header">
          <h2>🔍 Audit & Conseil</h2>
          <p>Analyse et recommandations pour vos projets IA et automatisations</p>
        </div>

        <div class="pricing-table">
          <div class="pricing-row header">
            <div class="col-service">Prestation</div>
            <div class="col-price">Tarif HT</div>
            <div class="col-duration">Durée</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Audit de sécurité</strong>
              <small>Analyse vulnérabilités + rapport</small>
            </div>
            <div class="col-price">À partir de 1200€</div>
            <div class="col-duration">2-3 jours</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Audit IA & automatisation</strong>
              <small>Analyse des usages, données et opportunités IA</small>
            </div>
            <div class="col-price">À partir de 4100€</div>
            <div class="col-duration">5-6 jours</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Conseil technique</strong>
              <small>Accompagnement projet</small>
            </div>
            <div class="col-price">70€/h</div>
            <div class="col-duration">Selon besoin</div>
          </div>
        </div>
      </div>

      <!-- Support & Maintenance -->
      <div class="service-pricing">
        <div class="pricing-header">
          <h2>🛠️ Accompagnement & évolutions IA</h2>
          <p>Suivi, amélioration et évolution de vos solutions IA</p>
        </div>

        <div class="pricing-packages">
          <div class="package-card">
            <h3>Support Ponctuel</h3>
            <div class="package-price">
              <span class="amount">70€/h HT</span>
            </div>
            <ul>
              <li>  Assistance IA à la demande</li>
              <li>  Support à distance</li>
            </ul>
          </div>

          <div class="package-card">
            <h3>Contrat 10h/mois</h3>
            <div class="package-price">
              <span class="amount">780€</span>
              <span class="period">HT/mois</span>
            </div>
            <ul>
              <li>  10h d'intervention/mois</li>
              <li>  Report heures non utilisées</li>
              <li>  Priorité interventions</li>
              <li>  Support email prioritaire</li>
              <li>  Maintenance préventive</li>
            </ul>
          </div>

          <div class="package-card featured">
            <div class="package-badge">Optimal PME</div>
            <h3>Contrat 20h/mois</h3>
            <div class="package-price">
              <span class="amount">1599€</span>
              <span class="period">HT/mois</span>
            </div>
            <ul>
              <li>  20h d'intervention/mois</li>
              <li>  Support prioritaire</li>
              <li>  Optimisation des modèles IA</li>
              <li>  Suivi des performances</li>
              <li>  Améliorations continues</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Notes importantes -->
      <div class="pricing-notes">
  <h2>ℹ️ Informations importantes</h2>
  
  <div class="notes-grid">
    <div class="note-card">
      <h3>🌍 Travail à distance</h3>
      <p>
        Tous les projets Biscuits IA sont réalisés <strong>100 % à distance</strong>,
        sans contrainte géographique.
      </p>
    </div>

    <div class="note-card">
      <h3>🤖 Solutions sur mesure</h3>
      <p>
        Chaque solution IA est conçue spécifiquement selon votre besoin.
        Les tarifs peuvent évoluer en fonction de la complexité du projet.
      </p>
    </div>

    <div class="note-card">
      <h3>⏱️ Délais & planning</h3>
      <p>
        Les délais sont définis dès la phase de cadrage et respectés tout au long
        du projet avec des points d’avancement réguliers.
      </p>
    </div>

    <div class="note-card">
      <h3>💳 Facturation</h3>
      <p>
        Facturation claire et détaillée. Paiement par virement bancaire.
        Possibilité de paiement échelonné selon le projet.
      </p>
    </div>

    <div class="note-card">
      <h3>🔐 Confidentialité</h3>
      <p>
        Vos données et informations sont traitées avec la plus grande confidentialité.
        Des accords de confidentialité (NDA) peuvent être mis en place.
      </p>
    </div>

    <div class="note-card">
      <h3>🚀 Évolutivité</h3>
      <p>
        Les solutions livrées sont pensées pour évoluer dans le temps :
        améliorations, nouvelles fonctionnalités et montée en charge.
      </p>
    </div>
  </div>
</div>

      </div>

      <!-- FAQ Tarifs -->
      <div class="tarifs-faq">
  <h2>Questions fréquentes</h2>
  
  <details class="faq-item">
    <summary>Comment se déroule un projet Biscuits IA ?</summary>
    <p>
      Chaque projet commence par une phase de cadrage gratuite afin de définir
      précisément vos besoins et la solution IA la plus adaptée.
    </p>
  </details>

  <details class="faq-item">
    <summary>Les tarifs sont-ils fixes ?</summary>
    <p>
      Les tarifs affichés sont indicatifs. Un devis personnalisé est établi
      en fonction de la complexité et des objectifs du projet.
    </p>
  </details>

  <details class="faq-item">
    <summary>Travaillez-vous uniquement à distance ?</summary>
    <p>
      Oui, tous les projets sont réalisés à distance, ce qui permet plus de
      flexibilité et de réactivité.
    </p>
  </details>

  <details class="faq-item">
    <summary>Proposez-vous un accompagnement après livraison ?</summary>
    <p>
      Oui, un accompagnement et des évolutions peuvent être proposés via des
      forfaits ou abonnements adaptés.
    </p>
  </details>

  <details class="faq-item">
    <summary>Mes données sont-elles en sécurité ?</summary>
    <p>
      Oui. La confidentialité et la sécurité des données sont une priorité
      dans tous les projets Biscuits IA.
    </p>
  </details>
</div>

    </div>
  </section>
</BaseLayout>

<style>
  .tarifs-hero {
    color: var(--color-bg);
    padding: var(--spacing-4xl) 0;
    text-align: center;
  }

  .tarifs-hero h1 {
    font-size: var(--font-size-5xl);
    margin-bottom: var(--spacing-md);
    color: var(--color-bg);
  }

  .hero-subtitle {
    font-size: var(--font-size-xl);
    opacity: 0.95;
    margin-bottom: var(--spacing-xl);
    color: var(--color-gray-100);
  }

  .hero-badges {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .badge {
    background: rgba(255, 255, 255, 0.2);
    padding: var(--spacing-sm) var(--spacing-lg);
    border-radius: var(--radius-full);
    color: var(--color-gray-100);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    backdrop-filter: blur(10px);
  }

  .tarifs-main {
    padding: var(--spacing-4xl) 0;
  }

  .service-pricing {
    margin-bottom: var(--spacing-4xl);
  }

  .pricing-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .pricing-header h2 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-sm);
  }

  .pricing-header p {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
  }

  .pricing-table {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .pricing-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
  }

  .pricing-row:last-child {
    border-bottom: none;
  }

  .pricing-row.header {
    background: var(--color-bg-alt);
    font-weight: var(--font-weight-bold);
  }

  .col-service strong {
    display: block;
    margin-bottom: var(--spacing-xs);
  }

  .col-service small {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
  }

  .col-price {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-align: center;
  }

  .col-price.highlight {
    color: var(--color-success);
    font-size: var(--font-size-2xl);
  }

  .col-duration {
    text-align: center;
    color: var(--color-text-light);
  }

  .pricing-packages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-xl);
    margin-top: var(--spacing-2xl);
  }

  .package-card {
    background: var(--color-bg-alt);
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-border);
    position: relative;
    transition: all var(--transition-base);
  }

  .package-card.featured {
    border-color: var(--color-primary);
    transform: scale(1.05);
    box-shadow: var(--shadow-xl);
  }

  .package-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  .package-card.featured:hover {
    transform: scale(1.05) translateY(-8px);
  }

  .package-badge {
    position: absolute;
    top: -12px;
    right: var(--spacing-xl);
    background: var(--color-primary);
    color: var(--color-bg);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
  }

  .package-card h3 {
    font-size: var(--font-size-2xl);
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .package-price {
    text-align: center;
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    border-bottom: 2px solid var(--color-border);
  }

  .package-price .amount {
    display: block;
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-primary);
    margin-bottom: var(--spacing-xs);
  }

  .package-price .period {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }

  .package-card ul {
    list-style: none;
    padding: 0;
    margin-bottom: var(--spacing-lg);
  }

  .package-card li {
    padding: var(--spacing-sm) 0;
    line-height: 1.6;
  }

  .duration-note {
    text-align: center;
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }

  .pricing-notes {
    margin: var(--spacing-4xl) 0;
    padding: var(--spacing-4xl) 0;
    background: var(--color-bg-alt);
    border-radius: var(--radius-xl);
  }

  .pricing-notes h2 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-xl);
  }

  .note-card {
    background: var(--color-bg);
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
  }

  .note-card h3 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-md);
  }

  .note-card p {
    line-height: 1.7;
    color: var(--color-text-light);
  }

  .tarifs-faq {
    max-width: 800px;
    margin: var(--spacing-4xl) auto;
  }

  .tarifs-faq h2 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .faq-item {
    background: var(--color-bg-alt);
    margin-bottom: var(--spacing-md);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-primary);
  }

  .faq-item summary {
    padding: var(--spacing-lg);
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-lg);
    list-style: none;
  }

  .faq-item summary::before {
    content: '▶';
    display: inline-block;
    margin-right: var(--spacing-sm);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] summary::before {
    transform: rotate(90deg);
  }
  .faq-item p {
    padding: 0 var(--spacing-lg) var(--spacing-lg);
    color: var(--color-text-light);
    line-height: 1.7;
  }

  .tarifs-cta {
    text-align: center;
    padding: var(--spacing-4xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-bg);
    border-radius: var(--radius-xl);
    margin-top: var(--spacing-4xl);
  }

  .tarifs-cta h2 {
    color: var(--color-bg);
    margin-bottom: var(--spacing-md);
  }

  .tarifs-cta p {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-xl);
    opacity: 0.95;
  }

  .cta-buttons {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .pricing-packages,
    .notes-grid {
      grid-template-columns: 1fr;
    }

    .package-card.featured {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .tarifs-hero h1 {
      font-size: var(--font-size-3xl);
    }

    .pricing-row {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .col-service small {
      display: block;
      margin-top: var(--spacing-xs);
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
    }
  }
</style>