---
import BaseLayout from '@layouts/Layout.astro';

const heroBadges = [
  "100% bénévole",
  "Projets collaboratifs",
  "IA accessible à tous",
  "Participation libre et flexible"
];

const programs = [
  {
    title: "Atelier Découverte IA",
    description: "Initiation pratique aux outils IA et aux bonnes pratiques pour un usage responsable",
    participation: "Gratuit",
    duration: "2h",
    featured: false
  },
  {
    title: "Atelier Avancé IA",
    description: "Création d'assistants IA simples et automatisation de workflows adaptés à votre structure",
    participation: "Participation libre (suggestion : 20€)",
    duration: "4h",
    featured: false
  },
  {
    title: "Projet Collaboratif IA",
    description: "Contribuez à un projet open-source associatif pour développer des solutions IA utiles et inclusives",
    participation: "Adhésion annuelle : 50€",
    duration: "Variable",
    featured: false
  }
];

const processSteps = [
  { 
    number: "1", 
    title: "Rejoindre l'association", 
    description: "Devenir membre ou bénévole et découvrir nos missions", 
  },
  { 
    number: "2", 
    title: "Explorer nos projets", 
    description: "Découvrir ateliers, projets collaboratifs et missions bénévoles" 
  },
  { 
    number: "3", 
    title: "Participer activement", 
    description: "Contribuer selon vos compétences et intérêts", 
  },
  { 
    number: "4", 
    title: "Partager et diffuser", 
    description: "Aider à maximiser l’impact social et éducatif de nos projets" 
  }
];

const faqItems = [
  {
    question: "Comment rejoindre l'association ?",
    answer: "Remplissez le formulaire d'adhésion en ligne, participez à un atelier gratuit ou proposez vos compétences comme bénévole."
  },
  {
    question: "Faut-il payer pour participer aux projets ?",
    answer: "La participation est libre et adaptée à chacun. Certaines activités sont gratuites, d'autres suggèrent une contribution symbolique pour soutenir les projets."
  },
  {
    question: "Je n'ai pas de compétences techniques, puis-je participer ?",
    answer: "Oui ! Vous pouvez contribuer à la coordination, communication, documentation, tests utilisateurs et autres missions utiles à l'association."
  },
  {
    question: "Comment se déroule un atelier IA ?",
    answer: "Chaque atelier commence par une introduction pratique, suivie d’exercices guidés, et se termine par un partage et une discussion autour des réalisations."
  },
  {
    question: "Puis-je proposer un projet ou une idée ?",
    answer: "Absolument ! L'association valorise les propositions de tous. Chaque idée est discutée collectivement pour évaluer son impact et sa faisabilité."
  }
];

const testimonials = [
  { 
    text: "J'ai pu découvrir l'IA et contribuer à un projet concret même sans être développeur.", 
    author: "Claire M.", 
    role: "Bénévole" 
  },
  { 
    text: "Participation flexible, équipe accueillante et impact tangible sur des projets éducatifs.", 
    author: "Alex D.", 
    role: "Membre actif" 
  },
  { 
    text: "Grâce à Biscuits IA, nous avons mis en place un assistant IA open-source pour soutenir d'autres associations.", 
    author: "Sophie L.", 
    role: "Contributrice" 
  }
];
---

<BaseLayout
  title="Participation & Projets | Biscuits IA"
  description="Découvrez nos ateliers IA, projets collaboratifs et modes de participation. Rejoignez l'association gratuitement ou via participation libre."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1>Rejoignez Biscuits IA</h1>
      <p class="hero-lead">Des projets collaboratifs IA au service de la communauté, accessibles à tous.</p>
      <div class="hero-badges">
        {heroBadges.map(badge => (
          <span class="badge">{badge}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Programmes / Ateliers -->
  <section id="programs" class="programs">
    <div class="container">
      <h2>Ateliers & Projets collaboratifs</h2>
      <p class="section-intro">Choisissez votre niveau de participation et contribuez à l'IA citoyenne.</p>

      <div class="program-grid">
        {programs.map(program => (
          <article class={`program-card ${program.featured ? 'featured' : ''}`}>
            <h3>{program.title}</h3>
            <p>{program.description}</p>
            <div class="program-details"> 
              <span class="program-participation">{program.participation}</span>
            </div>
            <a href="#join" class="btn-program">
              {program.featured ? "Rejoindre maintenant" : "Participer"}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Processus -->
  <section id="processus" class="process-section">
    <div class="container">
      <h2>Comment ça marche ?</h2>
      <p class="section-intro">Suivez ces étapes simples pour devenir actif dans nos projets.</p>

      <div class="process-timeline">
        {processSteps.map((step) => (
          <div class="process-step">
            <div class="step-number" aria-label={`Étape ${step.number}`}>{step.number}</div>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  <section class="testimonials">
    <div class="container">
      <h2>Ils participent et partagent</h2>
      <div class="testimonials-grid">
        {testimonials.map(t => (
          <blockquote class="testimonial-card">
            <p>"{t.text}"</p>
            <footer>
              <strong>{t.author}</strong>
              <span>{t.role}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="faq">
    <div class="container">
      <h2>Questions fréquentes</h2>
      {faqItems.map(item => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA Rejoindre -->
  <section id="join" class="cta-join">
    <div class="container">
      <h2>Prêt à contribuer ?</h2>
      <p class="section-intro">Rejoignez Biscuits IA gratuitement ou selon votre participation libre.</p>
      <div class="cta-actions">
        <a href="/register" class="btn-primary">Rejoindre l'association</a>
        <a href="mailto:contact@biscuits-ia.com" class="btn-secondary">Nous contacter</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ========================================
     HERO SECTION
     ======================================== */
  .hero {
    text-align: center;
    padding: var(--spacing-4xl) 0 var(--spacing-3xl);
    margin-top: 8vh;
    background: var(--color-bg);
  }

  .hero h1 { 
    font-size: clamp(var(--font-size-3xl), 6vw, var(--font-size-5xl)); 
    font-weight: var(--font-weight-extrabold);
    margin-bottom: var(--spacing-md);
    color: var(--color-text);
  }

  .hero-lead { 
    font-size: clamp(var(--font-size-lg), 2.5vw, var(--font-size-xl)); 
    margin-bottom: var(--spacing-xl);
    color: var(--color-text-light);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-badges { 
    display: flex; 
    gap: var(--spacing-md);
    justify-content: center; 
    flex-wrap: wrap; 
  }

  .badge { 
    background: var(--color-bg-elevated);
    border: var(--brutal-border-thin);
    box-shadow: var(--shadow-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all var(--transition-fast);
  }

  .badge:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-md);
  }
  
  /* ========================================
     PROGRAMMES SECTION
     ======================================== */
  .programs {
    padding: var(--spacing-3xl) 0;
    background: var(--color-bg);
  }

  .programs h2 {
    text-align: center;
    font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-4xl));
    margin-bottom: var(--spacing-md);
    color: var(--color-text);
  }

  .section-intro {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-2xl);
    font-size: var(--font-size-lg);
  }

  .program-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
    gap: var(--spacing-xl);
  }

  .program-card { 
    background: var(--color-bg-elevated);
    padding: var(--spacing-xl);
    border: var(--brutal-border);
    box-shadow: var(--shadow-lg);
    display: flex; 
    flex-direction: column; 
    gap: var(--spacing-md);
    transition: all var(--transition-fast);
  }

  .program-card:hover {
    transform: translate(var(--brutal-hover-translate), var(--brutal-hover-translate));
    box-shadow: var(--shadow-xl);
  }

  .program-card.featured { 
    background: var(--color-accent-honey);
    border-color: var(--color-border);
  }

  .program-card h3 {
    font-size: var(--font-size-2xl);
    margin: 0;
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .program-card > p {
    color: var(--color-text-light);
    flex-grow: 1;
    line-height: 1.6;
  }

  .program-details { 
    display: flex; 
    flex-direction: column;
    gap: var(--spacing-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    padding: var(--spacing-md);
    background: var(--color-bg);
    border: var(--brutal-border-thin);
  }

  .program-duration::before {
    content: "⏱️ ";
  }

  .program-participation::before {
    content: "💰 ";
  }

  .btn-program { 
    margin-top: auto; 
    padding: var(--spacing-md) var(--spacing-xl);
    background: var(--color-primary);
    color: var(--color-bg);
    border: var(--brutal-border);
    box-shadow: var(--shadow-md);
    text-decoration: none; 
    text-align: center;
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all var(--transition-fast);
  }

  .btn-program:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }

  .btn-program:active {
    transform: translate(2px, 2px);
    box-shadow: var(--shadow-sm);
  }

  /* ========================================
     PROCESSUS SECTION
     ======================================== */
  .process-section { 
    padding: var(--spacing-3xl) 0;
    text-align: center;
    background: var(--color-bg-alt);
  }

  .process-section h2 {
    font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-4xl));
    margin-bottom: var(--spacing-md);
  }

  .process-timeline { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); 
    gap: var(--spacing-2xl);
    margin-top: var(--spacing-2xl);
  }

  .process-step { 
    position: relative;
  }

  .step-number { 
    width: 80px; 
    height: 80px; 
    background: var(--color-primary);
    color: var(--color-bg);
    border: var(--brutal-border);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center; 
    justify-content: center; 
    font-weight: var(--font-weight-extrabold);
    font-size: var(--font-size-3xl);
    margin: 0 auto var(--spacing-lg);
    transition: all var(--transition-fast);
  }

  .process-step:hover .step-number {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-xl);
  }

  .step-content h3 { 
    font-weight: var(--font-weight-extrabold);
    margin-bottom: var(--spacing-sm);
    font-size: var(--font-size-xl);
    text-transform: uppercase;
  }

  .step-content p {
    color: var(--color-text-light);
    line-height: 1.6;
  }

  .step-duration {
    display: inline-block;
    margin-top: var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
    background: var(--color-bg-elevated);
    padding: var(--spacing-xs) var(--spacing-md);
    border: var(--brutal-border-thin);
  }

  /* ========================================
     TÉMOIGNAGES SECTION
     ======================================== */
  .testimonials { 
    background: var(--color-bg);
    padding: var(--spacing-3xl) 0;
    text-align: center;
  }

  .testimonials h2 {
    font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-4xl));
    margin-bottom: var(--spacing-2xl);
  }

  .testimonials-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
    gap: var(--spacing-xl);
  }

  .testimonial-card { 
    background: var(--color-bg-elevated);
    padding: var(--spacing-xl);
    border: var(--brutal-border);
    box-shadow: var(--shadow-lg);
    margin: 0;
    transition: all var(--transition-fast);
    text-align: left;
  }

  .testimonial-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-xl);
  }

  .testimonial-card:nth-child(1) {
    background: var(--color-accent-honey);
  } 

  .testimonial-card:nth-child(2) {
    background: var(--color-accent-caramel);
  }

  .testimonial-card:nth-child(3) {
    background: var(--color-accent-vanilla);
  }

  .testimonial-card p {
    font-style: italic;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  .testimonial-card footer {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding-top: var(--spacing-md);
    border-top: var(--brutal-border-thin);
  }

  .testimonial-card strong {
    color: var(--color-text);
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    font-size: var(--font-size-sm);
  }

  .testimonial-card span {
    font-size: var(--font-size-sm);
    color: var(--color-gray-200);
    font-weight: var(--font-weight-semibold);
  }

  /* ========================================
     FAQ SECTION
     ======================================== */
  .faq { 
    padding: var(--spacing-3xl) 0;
    max-width: var(--container-lg);
    margin: 0 auto;
    background: var(--color-bg-alt);
  }

  .faq h2 {
    text-align: center;
    font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-4xl));
    margin-bottom: var(--spacing-2xl);
  }

  .faq-item { 
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-lg);
    border: var(--brutal-border);
    box-shadow: var(--shadow-md);
    background: var(--color-bg-elevated);
    transition: all var(--transition-fast);
  }

  .faq-item:hover {
    box-shadow: var(--shadow-lg);
  }

  .faq-item[open] {
    background: var(--color-accent-cream);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg);
  }

  .faq-item summary { 
    cursor: pointer; 
    font-weight: var(--font-weight-bold);
    padding: var(--spacing-sm);
    list-style: none;
    font-size: var(--font-size-lg);
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::before {
    content: "▶";
    display: inline-block;
    margin-right: var(--spacing-md);
    transition: transform var(--transition-fast);
    font-weight: var(--font-weight-extrabold);
  }

  .faq-item[open] summary::before {
    transform: rotate(90deg);
  }

  .faq-item p {
    margin-top: var(--spacing-md);
    padding-left: var(--spacing-2xl);
    color: var(--color-gray-900);
    line-height: 1.7;
    font-size: var(--font-size-base);
  }

  /* ========================================
     CTA JOIN SECTION
     ======================================== */
  .cta-join { 
    background: var(--color-primary);
    padding: var(--spacing-3xl) 0;
    text-align: center;
    border-top: var(--brutal-border-thick);
  }

  .cta-join h2 {
    font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-4xl));
    margin-bottom: var(--spacing-md);
    color: var(--color-bg);
  }

  .cta-join .section-intro {
    color: var(--color-bg);
    opacity: 0.9;
  }

  .cta-actions { 
    display: flex; 
    gap: var(--spacing-lg);
    justify-content: center; 
    flex-wrap: wrap;
  }

  .btn-primary {
    background: transparent;
    color: var(--color-bg);
    border: var(--brutal-border);
    border-color: var(--color-bg);
    padding: var(--spacing-lg) var(--spacing-2xl);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all var(--transition-fast);
  }

  .btn-primary:hover {    
    background: var(--color-bg);
    color: var(--color-text);
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-xl);
  }

  .btn-primary:active {
    transform: translate(3px, 3px);
    box-shadow: var(--shadow-sm);
  }

  .btn-secondary { 
    background: transparent;
    color: var(--color-bg);
    border: var(--brutal-border);
    border-color: var(--color-bg);
    padding: var(--spacing-lg) var(--spacing-2xl);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all var(--transition-fast);
  }

  .btn-secondary:hover {
    background: var(--color-bg);
    color: var(--color-text);
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-xl);
  }

  .btn-secondary:active {
    transform: translate(3px, 3px);
    box-shadow: var(--shadow-sm);
  }

  /* ========================================
     RESPONSIVE
     ======================================== */
  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-2xl) 0 var(--spacing-xl);
    }

    .process-timeline {
      grid-template-columns: 1fr;
    }

    .quick-nav .container {
      justify-content: flex-start;
      overflow-x: auto;
      padding: 0 var(--spacing-md);
      scrollbar-width: none;
    }

    .quick-nav .container::-webkit-scrollbar {
      display: none;
    }

    .program-grid,
    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
    }
  }
</style>