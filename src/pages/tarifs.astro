---
import '@/styles/global.css'
import BaseLayout from '@layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "name": "Tarifs Biscuits AI – Solutions IA",
  "url": "https://biscuits.dev/tarifs",
};
---

<BaseLayout
  title="Tarifs Solutions IA & Automatisation | Biscuits IA"
  description="Tarifs Biscuits IA : assistants IA, automatisation de workflows et solutions IA sur mesure. Devis gratuit."
  structuredData={structuredData}
>
  <section class="tarifs-hero">
    <div class="container">
      <h1 data-hero-title>Nos Tarifs</h1>
      <p class="hero-subtitle" data-hero-subtitle>
        Tarification claire pour vos projets IA. Étude et devis gratuits.
      </p>
      <div class="hero-badges" data-hero-badges>
        <span class="badge">💯 Aucun frais caché</span>
        <span class="badge">📋 Devis détaillé gratuit</span>
        <span class="badge">🌍 100% remote</span>
      </div>
    </div>
  </section>

  <section class="tarifs-main">
    <div class="container">
      
      <!-- Assistants IA -->
      <div class="service-pricing" data-pricing-section="0">
        <div class="pricing-header">
          <h2>🤖 Assistants IA personnalisés</h2>
          <p>Conception et déploiement d'agents IA adaptés à vos besoins métiers</p>
        </div>

        <div class="pricing-table">
          <div class="pricing-row header">
            <div class="col-service">Prestation</div>
            <div class="col-price">Tarif HT</div>
            <div class="col-duration">Délai</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Étude & cadrage IA</strong>
              <small>Analyse du besoin, cas d'usage, faisabilité</small>
            </div>
            <div class="col-price highlight">Gratuit</div>
            <div class="col-duration">30–45 min</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Assistant IA simple</strong>
              <small>FAQ, support, agent interne</small>
            </div>
            <div class="col-price">À partir de 900€</div>
            <div class="col-duration">4–7 jours</div>
          </div>

          <div class="pricing-row">
            <div class="col-service">
              <strong>Assistant IA avancé</strong>
              <small>Multi-sources, logique métier, API</small>
            </div>
            <div class="col-price">À partir de 2 300€</div>
            <div class="col-duration">2-3 semaines</div>
          </div>
        </div>
      </div>

      <!-- Automatisation -->
      <div class="service-pricing" data-pricing-section="1">
        <div class="pricing-header">
          <h2>⚙️ Automatisation de workflows</h2>
          <p>Gagnez du temps en automatisant vos processus avec l'IA</p>
        </div>

        <div class="pricing-packages">
          <div class="package-card" data-package="0">
            <h3>Workflow simple</h3>
            <div class="package-price">
              <span class="amount">600€</span>
              <span class="period">HT</span>
            </div>
            <ul>
              <li>Automatisation d'une tâche</li>
              <li>IA + règles simples</li>
              <li>Tests & mise en production</li>
              <li>Documentation</li>
            </ul>
          </div>

          <div class="package-card featured" data-package="1">
            <div class="package-badge">Populaire</div>
            <h3>Workflow avancé</h3>
            <div class="package-price">
              <span class="amount">1700€</span>
              <span class="period">HT</span>
            </div>
            <ul>
              <li>Multi-étapes</li>
              <li>IA + APIs externes</li>
              <li>Logs & monitoring</li>
              <li>Formation 1h</li>
            </ul>
          </div>

          <div class="package-card" data-package="2">
            <h3>Automatisation sur mesure</h3>
            <div class="package-price">
              <span class="amount">Sur devis</span>
            </div>
            <ul>
              <li>Processus complexes</li>
              <li>Connexion SI / SaaS</li>
              <li>Maintenance optionnelle</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div class="tarifs-faq" data-faq-section>
        <h2>Questions fréquentes</h2>
        
        <details class="faq-item" data-faq="0">
          <summary>Comment se déroule un projet Biscuits IA ?</summary>
          <p>
            Chaque projet commence par une phase de cadrage gratuite afin de définir
            précisément vos besoins et la solution IA la plus adaptée.
          </p>
        </details>

        <details class="faq-item" data-faq="1">
          <summary>Les tarifs sont-ils fixes ?</summary>
          <p>
            Les tarifs affichés sont indicatifs. Un devis personnalisé est établi
            en fonction de la complexité et des objectifs du projet.
          </p>
        </details>

        <details class="faq-item" data-faq="2">
          <summary>Travaillez-vous uniquement à distance ?</summary>
          <p>
            Oui, tous les projets sont réalisés à distance, ce qui permet plus de
            flexibilité et de réactivité.
          </p>
        </details>

        <details class="faq-item" data-faq="3">
          <summary>Proposez-vous un accompagnement après livraison ?</summary>
          <p>
            Oui, un accompagnement et des évolutions peuvent être proposés via des
            forfaits ou abonnements adaptés.
          </p>
        </details>

        <details class="faq-item" data-faq="4">
          <summary>Mes données sont-elles en sécurité ?</summary>
          <p>
            Oui. La confidentialité et la sécurité des données sont une priorité
            dans tous les projets Biscuits IA.
          </p>
        </details>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
/* Hero */
.tarifs-hero {
  padding: 6rem 2rem 4rem;
  text-align: center;
  position: relative;
  overflow: hidden;
  background: var(--color-bg);
}

.tarifs-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, var(--color-primary), transparent 70%);
  opacity: 0.1;
}

.tarifs-hero h1 {
  font-size: clamp(2.5rem, 6vw, 5rem);
  margin-bottom: 1.5rem;
  font-weight: 900;
  color: var(--color-text);
}

.hero-subtitle {
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  opacity: 0.9;
  margin-bottom: 2rem;
  color: var(--color-text-light);
}

.hero-badges {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.badge {
  background: var(--glass-bg);
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-full);
  font-size: 0.95rem;
  font-weight: 600;
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  transition: all var(--transition-base);
  box-shadow: var(--shadow-sm);
}

.badge:hover {
  background: var(--color-bg-elevated);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

/* Main */
.tarifs-main {
  padding: 4rem 2rem;
  background: var(--color-bg);
}

.service-pricing {
  margin-bottom: 6rem;
  position: relative;
}

.pricing-header {
  text-align: center;
  margin-bottom: 3rem;
}

.pricing-header h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  margin-bottom: 1rem;
  color: var(--color-text);
  font-weight: 900;
}

.pricing-header p {
  color: var(--color-text-light);
  font-size: 1.1rem;
}

/* Tables */
.pricing-table {
  background: var(--color-bg-alt);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  border: 1px solid var(--color-border);
  backdrop-filter: var(--glass-blur);
  box-shadow: var(--shadow-lg);
}

.pricing-row {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 1.5rem;
  padding: 1.5rem;
  border-bottom: 1px solid var(--color-border);
  align-items: center;
  transition: all var(--transition-base);
}

.pricing-row:hover:not(.header) {
  background: var(--color-bg-elevated);
  transform: translateX(3px);
}

.pricing-row.header {
  background: var(--color-bg-elevated);
  font-weight: 700;
  color: var(--color-text);
}

.col-service strong {
  display: block;
  margin-bottom: 0.5rem;
  color: var(--color-text);
  font-weight: 700;
}

.col-service small {
  color: var(--color-text-light);
  font-size: 0.9rem;
}

.col-price {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--color-primary);
  text-align: center;
}

.col-price.highlight {
  color: var(--color-first);
  font-size: 1.75rem;
}

.col-duration {
  text-align: center;
  color: var(--color-text-light);
  font-weight: 600;
}

/* Packages */
.pricing-packages {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.package-card {
  background: var(--color-bg-alt);
  padding: 2.5rem 2rem;
  border-radius: var(--radius-2xl);
  border: 2px solid var(--color-border);
  position: relative;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  backdrop-filter: var(--glass-blur);
  box-shadow: var(--shadow-lg);
}

.package-card:hover {
  transform: translateY(-10px) scale(1.02);
  border-color: var(--color-primary);
  box-shadow: var(--shadow-xl);
}

.package-card.featured {
  border-color: var(--color-primary);
  background: var(--color-bg-elevated);
  border-width: 3px;
}

.package-badge {
  position: absolute;
  top: -15px;
  right: 2rem;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: var(--color-primary-light);
  padding: 0.5rem 1.5rem;
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 700;
  box-shadow: var(--shadow-glow);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.package-card h3 {
  font-size: 1.75rem;
  text-align: center;
  margin-bottom: 1.5rem;
  color: var(--color-text);
  font-weight: 800;
}

.package-price {
  text-align: center;
  margin-bottom: 2rem;
  padding-bottom: 2rem;
  border-bottom: 2px solid var(--color-border);
}

.package-price .amount {
  display: block;
  font-size: 3rem;
  font-weight: 900;
  color: var(--color-primary);
  margin-bottom: 0.5rem;
}

.package-price .period {
  font-size: 0.9rem;
  color: var(--color-text-light);
  font-weight: 600;
}

.package-card ul {
  list-style: none;
  padding: 0;
}

.package-card li {
  padding: 0.75rem 0;
  line-height: 1.6;
  color: var(--color-text);
  position: relative;
  padding-left: 1.5rem;
  font-weight: 500;
}

.package-card li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--color-first);
  font-weight: bold;
  font-size: 1.2rem;
}

/* FAQ */
.tarifs-faq {
  max-width: 900px;
  margin: 4rem auto;
}

.tarifs-faq h2 {
  text-align: center;
  font-size: clamp(2rem, 4vw, 3rem);
  margin-bottom: 3rem;
  color: var(--color-text);
  font-weight: 900;
}

.faq-item {
  background: var(--color-bg-alt);
  margin-bottom: 1rem;
  border-radius: var(--radius-lg);
  border: 2px solid var(--color-border);
  border-left-width: 4px;
  border-left-color: var(--color-primary);
  backdrop-filter: var(--glass-blur);
  overflow: hidden;
  transition: all var(--transition-base);
  box-shadow: var(--shadow-md);
}

.faq-item:hover {
  background: var(--color-bg-elevated);
  transform: translateX(5px);
  box-shadow: var(--shadow-lg);
}

.faq-item summary {
  padding: 1.5rem;
  cursor: pointer;
  font-weight: 700;
  font-size: 1.1rem;
  list-style: none;
  transition: color var(--transition-fast);
  color: var(--color-text);
}

.faq-item summary:hover {
  color: var(--color-primary);
}

.faq-item summary::before {
  content: '▶';
  display: inline-block;
  margin-right: 1rem;
  transition: transform var(--transition-base);
  color: var(--color-primary);
}

.faq-item[open] summary::before {
  transform: rotate(90deg);
}

.faq-item p {
  padding: 0 1.5rem 1.5rem;
  color: var(--color-text-light);
  line-height: 1.7;
  font-weight: 500;
}

/* Responsive */
@media (max-width: 768px) {
  .pricing-row {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .pricing-packages {
    grid-template-columns: 1fr;
  }

  .col-service small {
    display: block;
    margin-top: 0.5rem;
  }
  
  .package-card {
    padding: 2rem 1.5rem;
  }
}

/* Réduction des mouvements */
@media (prefers-reduced-motion: reduce) {
  .badge,
  .pricing-row,
  .package-card,
  .faq-item {
    transition: none !important;
  }
  
  .package-card:hover {
    transform: none !important;
  }
}
</style>

<script>
  function initPricingAnimations() {
    // Check reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    // Observer avec seuil plus bas
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Hero animations
    const heroTitle = document.querySelector('[data-hero-title]');
    const heroSubtitle = document.querySelector('[data-hero-subtitle]');
    const heroBadges = document.querySelector('[data-hero-badges]');

    if (heroTitle) {
      (heroTitle as HTMLElement).style.opacity = '0';
      (heroTitle as HTMLElement).style.transform = 'translateY(30px)';
      (heroTitle as HTMLElement).style.transition = 'all 0.8s ease 200ms';
      setTimeout(() => heroTitle.classList.add('animate-in'), 100);
    }

    if (heroSubtitle) {
      (heroSubtitle as HTMLElement).style.opacity = '0';
      (heroSubtitle as HTMLElement).style.transform = 'translateY(20px)';
      (heroSubtitle as HTMLElement).style.transition = 'all 0.8s ease 400ms';
      setTimeout(() => heroSubtitle.classList.add('animate-in'), 100);
    }

    if (heroBadges) {
      const badges = heroBadges.querySelectorAll('.badge');
      badges.forEach((badge, i) => {
        (badge as HTMLElement).style.opacity = '0';
        (badge as HTMLElement).style.transform = 'translateY(20px)';
        (badge as HTMLElement).style.transition = `all 0.6s ease ${600 + i * 100}ms`;
        setTimeout(() => badge.classList.add('animate-in'), 100);
      });
    }

    // Pricing sections
    document.querySelectorAll('[data-pricing-section]').forEach((section, index) => {
      (section as HTMLElement).style.opacity = '0';
      (section as HTMLElement).style.transform = 'translateY(50px)';
      (section as HTMLElement).style.transition = `all 0.8s ease ${index * 100}ms`;
      observer.observe(section);
    });

    // Package cards avec scale
    document.querySelectorAll('[data-package]').forEach((card, index) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'scale(0.9) translateY(30px)';
      (card as HTMLElement).style.transition = `all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) ${index * 100}ms`;
      observer.observe(card);
    });

    // FAQ items
    document.querySelectorAll('[data-faq]').forEach((item, index) => {
      (item as HTMLElement).style.opacity = '0';
      (item as HTMLElement).style.transform = 'translateX(-30px)';
      (item as HTMLElement).style.transition = `all 0.6s ease ${index * 80}ms`;
      observer.observe(item);
    });
  }

  // Style pour les animations
  const style = document.createElement('style');
  style.textContent = `
    [data-hero-title].animate-in,
    [data-hero-subtitle].animate-in,
    .badge.animate-in,
    [data-pricing-section].animate-in,
    [data-package].animate-in,
    [data-faq].animate-in {
      opacity: 1 !important;
      transform: translateY(0) translateX(0) scale(1) !important;
    }
  `;
  document.head.appendChild(style);

  // Init
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPricingAnimations);
  } else {
    initPricingAnimations();
  }
</script>