---

import BaseLayout from '@/layouts/Layout.astro';
---

<BaseLayout
  title="Qui utilise Biscuits IA | Témoignages"
  description="Des associations, collectivités et petites structures qui utilisent les ressources de Biscuits IA. Leurs retours, en toute honnêteté."
>
  <main class="utilisateurs-page">
    <!-- Hero Section -->
    <section class="hero">
      <h1>Qui utilise Biscuits IA</h1>
      <p>
          Des associations, collectivités et petites structure qui ont commencé à utiliser l'IA dans leur quotidien avec notre aide ou avec nos ressources libres.
      </p>
    </section>

    <!-- Section: Chiffres clés -->
    <section class="stats-section">
      <h2>Quelques chiffres clés</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-number">3+</span>
          <span class="stat-label">Projets actifs en ce moment</span>
        </div>

        <div class="stat-item">
          <span class="stat-number">6+</span>
          <span class="stat-label">Contributeurs bénévoles</span>
        </div>

        <div class="stat-item">
          <span class="stat-number">100%</span>
          <span class="stat-label">Ressources gratuites</span>
        </div>

      </div>
    </section>

    <!-- Section: CTA -->
    <section class="cta-section">
      <h2>Vous voulez essayer ?</h2>
      <p>
        Pas besoin de budget ni de compétences techniques pour commencer. Parcourez nos ressources, participez à un atelier, ou écrivez-nous directement.
      </p>
      <a href="/rejoignez-nous" class="cta-button">Rejoindre la communauté</a>
    </section>
  </main>
</BaseLayout>

<style>
  .utilisateurs-page {
    padding-top: calc(var(--header-height-desktop) + var(--spacing-2xl));
    min-height: 60vh;
  }

  /* Hero Section */
  .hero {
    text-align: center;
    padding: var(--spacing-3xl) var(--spacing-lg);
    max-width: 800px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: clamp(var(--font-size-3xl), 5vw, var(--font-size-5xl));
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
  }

  /* Testimonials Section */
  .testimonials-section {
    padding: var(--spacing-3xl) var(--spacing-lg);
    background: var(--color-bg-alt);
  }

  .testimonials-section h2 {
    text-align: center;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-2xl);
    color: var(--color-text);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--spacing-xl);
    max-width: var(--container-xl);
    margin: 0 auto;
  }

  .testimonial-card {
    background: var(--color-bg-elevated);
    border: var(--brutal-border);
    box-shadow: var(--shadow-md);
    padding: var(--spacing-xl);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .testimonial-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }

  .testimonial-card blockquote {
    font-size: var(--font-size-lg);
    font-style: italic;
    color: var(--color-text);
    margin-bottom: var(--spacing-lg);
    line-height: 1.6;
  }

  .testimonial-card footer {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .testimonial-card .author {
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .testimonial-card .role {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }

  /* Stats Section */
  .stats-section {
    padding: var(--spacing-3xl) var(--spacing-lg);
    text-align: center;
  }

  .stats-section h2 {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-2xl);
    color: var(--color-text);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-xl);
    max-width: var(--container-lg);
    margin: 0 auto;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    padding: var(--spacing-xl);
    background: var(--color-bg-elevated);
    border: var(--brutal-border);
    box-shadow: var(--shadow-md);
  }

  .stat-number {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-primary);
  }

  .stat-label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* CTA Section */
  .cta-section {
    text-align: center;
    padding: var(--spacing-3xl) var(--spacing-lg);
    background: var(--color-bg-alt);
  }

  .cta-section h2 {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-md);
    color: var(--color-text);
  }

  .cta-section p {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    margin-bottom: var(--spacing-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-md) var(--spacing-xl);
    background: var(--color-primary);
    color: var(--color-bg);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    border: var(--brutal-border);
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .cta-button:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .utilisateurs-page {
      padding-top: calc(var(--header-height-mobile) + var(--spacing-xl));
    }

    .hero {
      padding: var(--spacing-xl) var(--spacing-md);
    }

    .testimonials-section,
    .stats-section,
    .cta-section {
      padding: var(--spacing-xl) var(--spacing-md);
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>