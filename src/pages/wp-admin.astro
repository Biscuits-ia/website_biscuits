---
const ua = (Astro.request.headers.get("user-agent") || "").toLowerCase();

const isBot = /wp|wordpress|xmlrpc|bot|crawler|scan|curl|wget|python|go-http/i.test(ua);

const insultsBot = [
  "Bot detected. WordPress is a lie.",
  "Automated scan neutralized ☢️",
  "This site is not vulnerable.",
  "wp-admin honeypot triggered.",
];

const insultsHuman = [
  "Nice try.",
  "There is no WordPress here.",
  "SUCE 1 Q",
  "Skill issue detected 😈",
];

const insultList = isBot ? insultsBot : insultsHuman;
const insult = insultList[Math.floor(Math.random() * insultList.length)];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>WordPress › Login</title>
  <meta name="robots" content="noindex,nofollow" />
  <style>
    body {
      background: radial-gradient(circle at center, #020617, #000);
      color: #e5e7eb;
      font-family: system-ui, sans-serif;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .wp {
      background: #020617;
      padding: 2.5rem;
      border-radius: 14px;
      width: 360px;
      box-shadow: 0 0 60px rgba(56,189,248,.15);
      border: 1px solid rgba(56,189,248,.2);
    }
    h1 {
      text-align: center;
      margin-bottom: 1rem;
    }
    input {
      width: 100%;
      padding: .7rem;
      margin: .5rem 0;
      background: #020617;
      border: 1px solid #334155;
      color: #e5e7eb;
      border-radius: 6px;
    }
    button {
      width: 100%;
      padding: .7rem;
      margin-top: 1rem;
      background: #38bdf8;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
    }
    .log {
      margin-top: 1rem;
      font-size: .85rem;
      opacity: .6;
      text-align: center;
    }
    .nuke {
      margin-top: 1rem;
      text-align: center;
      color: #f87171;
      font-weight: bold;
      animation: blink 1.5s infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1 }
      50% { opacity: .3 }
    }
  </style>
</head>
<body>
  <div class="wp">
    <h1>WordPress</h1>

    <input placeholder="Username" />
    <input type="password" placeholder="Password" />

    <button id="login">Log In</button>

    <div class="log" id="log">
      Authenticating…
    </div>

    <div class="nuke">
      ☢️ {insult}
    </div>
  </div>

  <script>
  const loginBtn = document.getElementById("login");
  const log = document.getElementById("log");

  console.warn("wp-admin access detected");
  console.warn("CMS not found");
  console.warn("Powered by your mom ✨");

  if (loginBtn && log) {
    loginBtn.addEventListener("click", () => {
      log.innerText = "Validating WordPress core…";

      setTimeout(() => {
        log.innerText = "Downloading plugins (0/20)…";
      }, 800);

      setTimeout(() => {
        log.innerText = "Fatal error: WordPress not installed.";
      }, 2000);

      setTimeout(() => {
        window.location.href =
          "https://www.youtube.com/watch?v=dQw4w9WgXcQ";
      }, 3500);
    });
  }
</script>
